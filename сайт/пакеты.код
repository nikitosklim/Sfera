// пакеты.код — публичный каталог пакетов для сфера_пакеты.
//
// Каталог лежит в данные/пакеты.txt в том же формате, что и сфера.зависимости:
//     имя = git АДРЕС описание="текст"
// Его отдаёт адрес /пакеты/каталог.пакеты (его читает сфера_пакеты), а страница /пакеты показывает
// список людям. Добавляет и убирает пакеты только администратор (по токену) — каталог проверяется вручную.

подключить веб;

// Имя пакета: латиница, кириллица, цифры, «_» и «-», до 64 байт.
функция имя_пакета_допустимо(текст имя): верно
    целое n = длина(имя);
    если (n == 0 или n больше 64)
        вернуть нет;
    конец
    целое i = 0;
    пока (i меньше n)
        целое б = целое(байт_текста(имя, i));
        верно хороший = (б не меньше 97 и б не больше 122) или (б не меньше 65 и б не больше 90) или (б не меньше 48 и б не больше 57) или б == 45 или б == 95 или б не меньше 128;
        если ( не хороший)
            вернуть нет;
        конец
        i = i + 1;
    конец
    вернуть да;
конец

// Имя пакета в строке каталога: всё до первого «=», без пробелов по краям.
функция имя_в_строке_каталога(текст строка): текст
    результат из целого р = найти(строка, "=");
    если ( не р.успешно)
        вернуть "";
    конец
    вернуть обрезать_края(срез(строка, 0, р.значение));
конец

функция прочитать_каталог_пакетов(): текст
    результат из текста файл = прочитать_файл("данные/пакеты.txt");
    если ( не файл.успешно)
        вернуть "";
    конец
    вернуть файл.значение;
конец

// GET /пакеты/каталог.пакеты — каталог для сфера_пакеты и страницы.
функция отдать_каталог_пакетов(целое32 клиент): целое
    текст шапка = "# Каталог пакетов языка Сфера. Формат: имя = git АДРЕС описание=\"текст\"\n";
    вернуть ответ_текстом(клиент, 200, "text/plain; charset=utf-8", шапка + прочитать_каталог_пакетов());
конец

// POST /управление/пакет/добавить: «имя», «адрес», «описание».
функция добавить_пакет(целое32 клиент, Запрос з): целое
    текст имя = обрезать_края(параметр(з.тело, "имя"));
    текст адрес = обрезать_края(параметр(з.тело, "адрес"));
    текст описание = обрезать_до(очистить_поле(обрезать_края(параметр(з.тело, "описание"))), 200);
    описание = заменить(описание, "\"", "'");
    если ( не имя_пакета_допустимо(имя))
        вернуть ответ_ошибка(клиент, 400, "имя пакета: буквы, цифры, «_» и «-», до 64 байт");
    конец
    если ( не адрес_статьи_допустим(адрес))
        вернуть ответ_ошибка(клиент, 400, "нужен адрес git-репозитория (https://…)");
    конец
    текст каталог = прочитать_каталог_пакетов();
    целое всего = длина(каталог);
    целое позиция = 0;
    пока (позиция меньше всего)
        целое до = конец_строки(каталог, позиция);
        текст строка = срез(каталог, позиция, до - позиция);
        позиция = до + 1;
        если (строка_записи(строка) и имя_в_строке_каталога(строка) == имя)
            вернуть ответ_ошибка(клиент, 409, "пакет с таким именем уже есть");
        конец
    конец
    текст новая = имя + " = git " + адрес;
    если (длина(описание) больше 0)
        новая = новая + " описание=\"" + описание + "\"";
    конец
    новая = новая + "\n";
    если (длина(каталог) больше 0 и целое(байт_текста(каталог, длина(каталог) - 1)) != 10)
        новая = "\n" + новая;
    конец
    дописать_в_файл_бинарно("данные/пакеты.txt", новая, длина(новая));
    вернуть ответ_json(клиент, 201, "{\"ok\":true}");
конец

// POST /управление/пакет/удалить: «имя».
функция удалить_пакет(целое32 клиент, Запрос з): целое
    текст имя = обрезать_края(параметр(з.тело, "имя"));
    текст каталог = прочитать_каталог_пакетов();
    если (длина(имя) == 0 или длина(каталог) == 0)
        вернуть ответ_ошибка(клиент, 404, "такого пакета нет");
    конец
    текст новый = "";
    верно нашли = нет;
    целое всего = длина(каталог);
    целое позиция = 0;
    пока (позиция меньше всего)
        целое до = конец_строки(каталог, позиция);
        текст строка = срез(каталог, позиция, до - позиция);
        позиция = до + 1;
        если (строка_записи(строка) и имя_в_строке_каталога(строка) == имя)
            нашли = да;
        иначе
            если (длина(строка) больше 0)
                новый = новый + строка + "\n";
            конец
        конец
    конец
    если ( не нашли)
        вернуть ответ_ошибка(клиент, 404, "такого пакета нет");
    конец
    результат из верного записан = записать_файл("данные/пакеты.txt.new", новый);
    если ( не записан.успешно)
        вернуть ответ_ошибка(клиент, 500, "не удалось записать каталог");
    конец
    результат из верного заменён = переименовать_файл("данные/пакеты.txt.new", "данные/пакеты.txt");
    если ( не заменён.успешно)
        вернуть ответ_ошибка(клиент, 500, "не удалось обновить каталог");
    конец
    вернуть ответ_json(клиент, 200, "{\"ok\":true}");
конец
