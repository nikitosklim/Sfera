// поиск.код — поиск по документации, урокам, примерам и статьям. Работает на сервере: страница /поиск?q=… приходит готовой.
// Индекс (его же отдаёт /поиск-данные): записи, разделённые «\n@@@КОНЕЦ@@@\n», поля записи — «\n@@@ПОЛЕ@@@\n»:
// адрес, название, раздел, текст.

подключить веб;

// Сдвигает позицию к началу символа UTF-8 (не оставляет её посреди двухбайтной буквы).
функция граница_символа(текст источник, целое позиция): целое
    целое всего = длина(источник);
    целое p = позиция;
    если (p меньше 0)
        p = 0;
    конец
    пока (p меньше всего)
        целое б = целое(байт_текста(источник, p));
        если (б >= 128 и б < 192)
            p = p + 1;
        иначе
            вернуть p;
        конец
    конец
    вернуть всего;
конец

// Фрагмент: от start до start+размер (в байтах, с поправкой на границы символов).
функция кусок(текст источник, целое начало, целое размер): текст
    целое от = граница_символа(источник, начало);
    целое до = граница_символа(источник, от + размер);
    если (до > длина(источник))
        до = длина(источник);
    конец
    если (до <= от)
        вернуть "";
    конец
    вернуть срез(источник, от, до - от);
конец

// Убирает из фрагмента разметку Markdown и лишние пробелы.
функция очистить_фрагмент(текст источник): текст
    текст итог = "";
    целое всего = длина(источник);
    целое i = 0;
    верно был_пробел = да;
    пока (i меньше всего)
        целое б = целое(байт_текста(источник, i));
        верно пропустить = нет;
        если (б == 35 или б == 42 или б == 95 или б == 96 или б == 62 или б == 124 или б == 10 или б == 13 или б == 9 или б == 32)
            пропустить = да;
        конец
        если (пропустить)
            если ( не был_пробел)
                итог = итог + " ";
                был_пробел = да;
            конец
            i = i + 1;
        иначе
            целое n = 1;
            если (б >= 240)
                n = 4;
            иначе
                если (б >= 224)
                    n = 3;
                иначе
                    если (б >= 192)
                        n = 2;
                    конец
                конец
            конец
            если (i + n > всего)
                n = всего - i;
            конец
            итог = итог + срез(источник, i, n);
            был_пробел = нет;
            i = i + n;
        конец
    конец
    вернуть обрезать_края(итог);
конец

// Сколько раз слово встречается в тексте (до 10: больше на оценку не влияет).
функция сколько_раз(текст источник, текст слово): целое
    целое счёт = 0;
    текст остаток = источник;
    пока (счёт меньше 10)
        результат из целого п = найти(остаток, слово);
        если ( не п.успешно)
            вернуть счёт;
        конец
        счёт = счёт + 1;
        целое сдвиг = п.значение + длина(слово);
        если (сдвиг >= длина(остаток))
            вернуть счёт;
        конец
        остаток = срез(остаток, сдвиг, длина(остаток) - сдвиг);
    конец
    вернуть счёт;
конец

// Оборачивает в <mark> все вхождения слов в уже экранированный фрагмент (регистр не важен).
функция подсветить(текст фрагмент, Список из текстов слова): текст
    текст нижний = регистр_в_нижний(фрагмент);
    текст итог = "";
    целое позиция = 0;
    целое всего = длина(фрагмент);
    пока (позиция меньше всего)
        целое лучшая = -1;
        целое длина_слова = 0;
        целое k = 0;
        пока (k меньше слова.размер())
            текст слово = слова.получить(k);
            текст хвост = срез(нижний, позиция, всего - позиция);
            результат из целого п = найти(хвост, слово);
            если (п.успешно и (лучшая < 0 или п.значение < лучшая))
                лучшая = п.значение;
                длина_слова = длина(слово);
            конец
            k = k + 1;
        конец
        если (лучшая < 0 или длина_слова == 0)
            итог = итог + срез(фрагмент, позиция, всего - позиция);
            позиция = всего;
        иначе
            итог = итог + срез(фрагмент, позиция, лучшая) + "<mark>" + срез(фрагмент, позиция + лучшая, длина_слова) + "</mark>";
            позиция = позиция + лучшая + длина_слова;
        конец
    конец
    вернуть итог;
конец

// Слова запроса в нижнем регистре.
функция слова_запроса(текст запрос): Список из текстов
    Список из текстов слова = Список из текстов();
    текст нижний = регистр_в_нижний(запрос);
    текст слово = "";
    целое всего = длина(нижний);
    целое i = 0;
    пока (i <= всего)
        целое б = 32;
        если (i меньше всего)
            б = целое(байт_текста(нижний, i));
        конец
        если (б == 32 или б == 9 или б == 10 или б == 13)
            если (длина(слово) больше 0 и слова.размер() меньше 8)
                слова.добавить(слово);
            конец
            слово = "";
        иначе
            слово = слово + срез(нижний, i, 1);
        конец
        i = i + 1;
    конец
    вернуть слова;
конец

// Результаты поиска готовым HTML и строкой-итогом: «итог \n@@@\n html».
функция выполнить_поиск(текст запрос): текст
    Список из текстов слова = слова_запроса(запрос);
    если (слова.размер() == 0)
        слова.освободить();
        вернуть "Введите слово или фразу.\n@@@\n";
    конец
    текст индекс = поисковый_индекс() + индекс_внешних_статей();
    Список из текстов адреса = Список из текстов();
    Список из текстов названия = Список из текстов();
    Список из текстов разделы = Список из текстов();
    Список из текстов фрагменты = Список из текстов();
    Список из текстов оценки = Список из текстов();
    целое всего = длина(индекс);
    целое позиция = 0;
    пока (позиция меньше всего)
        целое до = всего;
        результат из целого конец_записи = найти(срез(индекс, позиция, всего - позиция), "\n@@@КОНЕЦ@@@\n");
        целое следующая = всего;
        если (конец_записи.успешно)
            до = позиция + конец_записи.значение;
            следующая = до + длина("\n@@@КОНЕЦ@@@\n");
        конец
        текст запись = срез(индекс, позиция, до - позиция);
        позиция = следующая;
        Список из текстов поля = Список из текстов();
        текст остаток = запись;
        целое n = 0;
        пока (n меньше 3)
            результат из целого р = найти(остаток, "\n@@@ПОЛЕ@@@\n");
            если (р.успешно)
                поля.добавить(срез(остаток, 0, р.значение));
                целое сдвиг = р.значение + длина("\n@@@ПОЛЕ@@@\n");
                остаток = срез(остаток, сдвиг, длина(остаток) - сдвиг);
                n = n + 1;
            иначе
                n = 3;
            конец
        конец
        если (поля.размер() == 3)
            поля.добавить(остаток);
            текст название = поля.получить(1);
            текст нижний_текст = регистр_в_нижний(остаток);
            текст нижнее_название = регистр_в_нижний(название);
            целое баллы = 0;
            целое первая = -1;
            верно подходит = да;
            целое k = 0;
            пока (k меньше слова.размер() и подходит)
                текст слово = слова.получить(k);
                результат из целого в_тексте = найти(нижний_текст, слово);
                результат из целого в_названии = найти(нижнее_название, слово);
                если ( не в_тексте.успешно и не в_названии.успешно)
                    подходит = нет;
                иначе
                    если (в_названии.успешно)
                        баллы = баллы + 20;
                    конец
                    если (в_тексте.успешно)
                        баллы = баллы + сколько_раз(нижний_текст, слово);
                        если (первая < 0)
                            первая = в_тексте.значение;
                        конец
                    конец
                конец
                k = k + 1;
            конец
            если (подходит)
                целое н = первая - 60;
                если (первая < 0 или н < 0)
                    н = 0;
                конец
                адреса.добавить(поля.получить(0));
                названия.добавить(название);
                разделы.добавить(поля.получить(2));
                фрагменты.добавить(очистить_фрагмент(кусок(остаток, н, 220)));
                оценки.добавить(целое_в_текст(баллы));
            конец
        конец
        поля.освободить();
    конец
    целое найдено = адреса.размер();
    текст итог = "Ничего не найдено. Попробуйте другое слово.";
    если (найдено больше 0)
        итог = "Найдено: " + целое_в_текст(найдено);
    конец
    текст html = "";
    целое выдано = 0;
    текст занято = ",";
    пока (выдано меньше 30 и выдано меньше найдено)
        целое лучший = -1;
        целое лучшие_баллы = -1;
        целое k = 0;
        пока (k меньше найдено)
            результат из целого б = текст_в_целое(оценки.получить(k));
            если (б.успешно и б.значение > лучшие_баллы и не содержит(занято, "," + целое_в_текст(k) + ","))
                лучшие_баллы = б.значение;
                лучший = k;
            конец
            k = k + 1;
        конец
        если (лучший < 0)
            выдано = 30;
        иначе
            занято = занято + целое_в_текст(лучший) + ",";
            текст ф = подсветить(экранировать_html(фрагменты.получить(лучший)), слова);
            html = html + "<a class=\"результат\" href=\"" + экранировать_html(адреса.получить(лучший)) + "\"><em>" + экранировать_html(разделы.получить(лучший)) +
                "</em><b>" + экранировать_html(названия.получить(лучший)) + "</b><span>…" + ф + "…</span></a>";
            выдано = выдано + 1;
        конец
    конец
    слова.освободить();
    адреса.освободить();
    названия.освободить();
    разделы.освободить();
    фрагменты.освободить();
    оценки.освободить();
    вернуть итог + "\n@@@\n" + html;
конец
