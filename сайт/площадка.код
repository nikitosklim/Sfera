// Площадка «Попробовать язык»: сервер собирает код пользователя в WebAssembly,
// а выполняет его браузер посетителя (в песочнице, на сервере чужой код не запускается).
// Путь к компилятору хранится в данные/компилятор.txt (например, /usr/local/bin/запустить).
// Если файла нет, площадка выключена.

подключить веб;

// Счётчик, чтобы папки одновременных запросов не пересекались.
функция имя_папки_сборки(): текст
    вернуть "данные/площадка/" + целое_в_текст(юникс_время()) + "-" + целое_в_текст(юникс_время() % 100000);
конец

// Допустимо ли подключение в строке: только имена модулей, без путей.
функция строка_безопасна(текст строка): верно
    текст с = обрезать_края(строка);
    если (начинается_с_текста(с, "подключить") и (содержит(с, "/") или содержит(с, "\\") или содержит(с, "..")))
        вернуть нет;
    конец
    вернуть да;
конец

функция исходник_безопасен(текст код): верно
    целое всего = длина(код);
    целое позиция = 0;
    пока (позиция меньше всего)
        целое до = конец_строки(код, позиция);
        если ( не строка_безопасна(срез(код, позиция, до - позиция)))
            вернуть нет;
        конец
        позиция = до + 1;
    конец
    вернуть да;
конец

// POST /площадка/собрать: тело — исходный код. Ответ — .wasm или JSON с ошибкой.
функция собрать_для_браузера(целое32 клиент, Запрос з): целое
    результат из текста настройка = прочитать_файл("данные/компилятор.txt");
    если ( не настройка.успешно или длина(обрезать_края(настройка.значение)) == 0)
        вернуть ответ_json(клиент, 503, "{\"ok\":false,\"ошибка\":\"Площадка пока выключена: на сервере не указан компилятор.\"}");
    конец
    текст компилятор = обрезать_края(настройка.значение);
    если (содержит(компилятор, "'") или содержит(компилятор, "\n"))
        вернуть ответ_json(клиент, 503, "{\"ok\":false,\"ошибка\":\"Площадка настроена неверно.\"}");
    конец
    текст код = з.тело;
    если (длина(обрезать_края(код)) == 0)
        вернуть ответ_json(клиент, 400, "{\"ok\":false,\"ошибка\":\"Введите программу.\"}");
    конец
    если (длина(код) больше 20000)
        вернуть ответ_json(клиент, 413, "{\"ok\":false,\"ошибка\":\"Программа длиннее 20 000 байт.\"}");
    конец
    если ( не исходник_безопасен(код))
        вернуть ответ_json(клиент, 400, "{\"ok\":false,\"ошибка\":\"В площадке можно подключать только модули по имени, без путей.\"}");
    конец
    // Одна сборка за раз; замок старше минуты считается забытым.
    выполнить_команду("mkdir -p данные/площадка && find данные/площадка -maxdepth 1 -name замок -mmin +1 -exec rmdir {} +");
    результат из целого замок = выполнить_команду("mkdir данные/площадка/замок 2>/dev/null");
    если ( не замок.успешно или замок.значение != 0)
        вернуть ответ_json(клиент, 429, "{\"ok\":false,\"ошибка\":\"Сервер сейчас собирает чужую программу. Повторите через несколько секунд.\"}");
    конец
    текст папка = имя_папки_сборки();
    выполнить_команду("mkdir -p '" + папка + "'");
    записать_файл(папка + "/программа.код", код);
    результат из целого р = выполнить_команду("cd '" + папка + "' && (ulimit -v 3000000; timeout 20 '" + компилятор + "' программа.код -c --целевая-платформа wasm32-wasi > вывод.txt 2>&1)");
    верно собрано = р.успешно и р.значение == 0;
    если (собрано)
        результат из целого размер = размер_файла(папка + "/программа");
        если ( не размер.успешно)
            собрано = нет;
        конец
    конец
    если (собрано)
        верно отдан = ответ_файлом_для(клиент, з, папка + "/программа", "программа.wasm", нет, "no-store");
        выполнить_команду("rm -rf '" + папка + "'; rmdir данные/площадка/замок");
        если (отдан)
            вернуть 0;
        конец
        вернуть ответ_json(клиент, 500, "{\"ok\":false,\"ошибка\":\"Не удалось отдать результат сборки.\"}");
    конец
    текст сообщение = "Сборка не удалась.";
    результат из текста вывод = прочитать_файл(папка + "/вывод.txt");
    если (вывод.успешно и длина(обрезать_края(вывод.значение)) больше 0)
        сообщение = вывод.значение;
        если (длина(сообщение) больше 3000)
            сообщение = срез(сообщение, 0, 3000);
        конец
    конец
    выполнить_команду("rm -rf '" + папка + "'; rmdir данные/площадка/замок");
    вернуть ответ_json(клиент, 400, "{\"ok\":false,\"ошибка\":" + json_строка(сообщение) + "}");
конец
