// GET /пакеты/реестр.txt
функция отдать_реестр(целое32 клиент): целое
    текст шапка = "# Реестр пакетов Сферы: имя | версия | sha256 | размер | время | автор | описание | отозвана\n";
    // Нежелательные пакеты отдаём как отозванные: новые установки их не выбирают.
    текст реестр = прочитать_реестр();
    текст итог = "";
    целое всего = длина(реестр);
    целое позиция = 0;
    пока (позиция меньше всего)
        целое до = конец_строки(реестр, позиция);
        текст строка = срез(реестр, позиция, до - позиция);
        позиция = до + 1;
        если (строка_записи(строка) и статус_пакета(поле_строки(строка, 0)) == "нежелательный")
            итог = итог + поле_строки(строка, 0) + " | " + поле_строки(строка, 1) + " | " + поле_строки(строка, 2) + " | " + поле_строки(строка, 3) + " | " + поле_строки(строка, 4) + " | " + поле_строки(строка, 5) + " | " + поле_строки(строка, 6) + " | 1\n";
        иначе если (длина(строка) больше 0)
            итог = итог + строка + "\n";
        конец
    конец
    вернуть ответ_текстом(клиент, 200, "text/plain; charset=utf-8", шапка + итог);
конец

// GET /пакеты/архив/<имя>/<версия>.tar.gz
функция отдать_архив_пакета(целое32 клиент, Запрос з, текст остаток): целое
    результат из целого косая = найти(остаток, "/");
    если ( не косая.успешно или не оканчивается_на(остаток, ".tar.gz"))
        вернуть ответ_отказ(клиент, 404, "нет такого архива");
    конец
    текст имя = срез(остаток, 0, косая.значение);
    текст версия = срез(остаток, косая.значение + 1, длина(остаток) - косая.значение - 8);
    если ( не имя_пакета_допустимо(имя) или не версия_пакета_допустима(версия) или не версия_в_реестре(прочитать_реестр(), имя, версия))
        вернуть ответ_отказ(клиент, 404, "нет такого архива");
    конец
    если (з.метод == "GET")
        текст запись = целое_в_текст(юникс_время()) + "\t" + имя + "\t" + версия + "\n";
        дописать_в_файл_бинарно("данные/скачивания.log", запись, длина(запись));
    конец
    если ( не ответ_файлом_для(клиент, з, "данные/пакеты/" + имя + "/" + версия + ".tar.gz", "package-" + версия + ".tar.gz", да, "public, max-age=31536000, immutable"))
        вернуть ответ_отказ(клиент, 404, "нет такого архива");
    конец
    вернуть 0;
конец

// GET /пакеты/описание/<имя> — README последней версии (обычный текст).
функция отдать_описание_пакета(целое32 клиент, текст имя): целое
    если ( не имя_пакета_допустимо(имя))
        вернуть ответ_текстом(клиент, 404, "text/plain; charset=utf-8", "");
    конец
    текст реестр = прочитать_реестр();
    текст последняя = "";
    целое всего = длина(реестр);
    целое позиция = 0;
    пока (позиция меньше всего)
        целое до = конец_строки(реестр, позиция);
        текст строка = срез(реестр, позиция, до - позиция);
        позиция = до + 1;
        если (строка_записи(строка) и поле_строки(строка, 0) == имя)
            последняя = поле_строки(строка, 1);
        конец
    конец
    если (длина(последняя) == 0)
        вернуть ответ_текстом(клиент, 404, "text/plain; charset=utf-8", "");
    конец
    результат из текста файл = прочитать_файл("данные/пакеты/" + имя + "/" + последняя + ".README.md");
    если ( не файл.успешно)
        вернуть ответ_текстом(клиент, 200, "text/plain; charset=utf-8", "");
    конец
    вернуть ответ_текстом(клиент, 200, "text/plain; charset=utf-8", файл.значение);
конец

// Есть ли пакет в реестре (для страницы /пакеты/<имя>).
функция пакет_в_реестре(текст имя): верно
    если ( не имя_пакета_допустимо(имя))
        вернуть нет;
    конец
    вернуть длина(владелец_пакета(прочитать_реестр(), имя)) больше 0;
