// Папка для временных файлов приёма (имена в ней — только цифры, в командную строку попадают безопасно).
функция убрать_приём(текст файл): целое
    выполнить_команду("rm -f '" + файл + "' '" + файл + ".names' '" + файл + ".types' '" + файл + ".size' '" + файл + ".manifest' '" + файл + ".readme'");
    вернуть 0;
конец

// Проверяет архив: только плоский набор допустимых файлов, обычные файлы, разумный размер.
// Пустой текст — всё хорошо, иначе — причина отказа.
функция проверить_архив(текст файл): текст
    результат из целого р1 = выполнить_команду("tar --quoting-style=literal -tzf '" + файл + "' > '" + файл + ".names' 2>/dev/null");
    если ( не р1.успешно или р1.значение != 0)
        вернуть "это не архив .tar.gz";
    конец
    выполнить_команду("tar --quoting-style=literal -tvzf '" + файл + "' 2>/dev/null | cut -c1 > '" + файл + ".types'");
    выполнить_команду("tar -xzOf '" + файл + "' 2>/dev/null | head -c " + целое_в_текст(макс_размер_распакованного() + 1) + " | wc -c > '" + файл + ".size'");
    результат из текста имена = прочитать_файл(файл + ".names");
    результат из текста виды = прочитать_файл(файл + ".types");
    результат из текста размер = прочитать_файл(файл + ".size");
    если ( не имена.успешно или не виды.успешно или не размер.успешно)
        вернуть "не удалось прочитать архив";
    конец
    результат из целого распакованный = текст_в_целое(обрезать_края(размер.значение));
    если ( не распакованный.успешно или распакованный.значение больше макс_размер_распакованного())
        вернуть "в распакованном виде пакет больше 20 МБ";
    конец
    целое файлов = 0;
    верно есть_манифест = нет;
    верно есть_код = нет;
    целое всего = длина(имена.значение);
    целое позиция = 0;
    пока (позиция меньше всего)
        целое до = конец_строки(имена.значение, позиция);
        текст имя = срез(имена.значение, позиция, до - позиция);
        позиция = до + 1;
        если (длина(имя) больше 0)
            файлов = файлов + 1;
            если ( не имя_в_архиве_допустимо(имя))
                вернуть "недопустимый файл в архиве: «" + обрезать_до(имя, 60) + "» (допустимы только файлы в корне: .код, .md, LICENSE, пакет.сфера, сфера.зависимости)";
            конец
            если (имя == "пакет.сфера")
                есть_манифест = да;
            конец
            если (оканчивается_на(имя, ".код"))
                есть_код = да;
            конец
        конец
    конец
    если (файлов == 0 или файлов больше 200)
        вернуть "в архиве должно быть от 1 до 200 файлов";
    конец
    // Виды файлов: каждая строка — первый символ прав доступа; допустим только «-» (обычный файл).
    целое видов_всего = длина(виды.значение);
    целое в_позиция = 0;
    пока (в_позиция меньше видов_всего)
        целое в_до = конец_строки(виды.значение, в_позиция);
        текст вид = срез(виды.значение, в_позиция, в_до - в_позиция);
        в_позиция = в_до + 1;
        если (длина(вид) больше 0 и вид != "-")
            вернуть "в архиве есть ссылки или папки — допустимы только обычные файлы";
        конец
    конец
    если ( не есть_манифест)
        вернуть "в архиве нет файла пакет.сфера";
    конец
    если ( не есть_код)
        вернуть "в архиве нет ни одного файла .код";
    конец
    вернуть "";
конец

// Значение ключа из манифеста «ключ = значение».
функция поле_манифеста(текст манифест, текст ключ): текст
    целое всего = длина(манифест);
    целое позиция = 0;
    пока (позиция меньше всего)
        целое до = конец_строки(манифест, позиция);
        текст строка = срез(манифест, позиция, до - позиция);
        позиция = до + 1;
        результат из целого р = найти(строка, "=");
        если (р.успешно)
            если (обрезать_края(срез(строка, 0, р.значение)) == ключ)
                вернуть обрезать_края(срез(строка, р.значение + 1, длина(строка) - р.значение - 1));
            конец
        конец
    конец
    вернуть "";
конец

// ---------------------------------------------------------------- публикация

функция ответ_отказ(целое32 клиент, целое код, текст сообщение): целое
    вернуть ответ_json(клиент, код, "{\"ok\":false,\"ошибка\":" + json_строка(сообщение) + "}");
конец

// PUT /пакеты/публикация/<имя>/<версия> с телом-архивом. Токен автора — в Authorization: Bearer.
функция принять_пакет(целое32 клиент, Запрос з, текст остаток): целое
    текст автор = автор_по_токену(з);
    если (длина(автор) == 0)
        вернуть ответ_отказ(клиент, 401, "неверный токен автора — войдите на сайте в аккаунт или возьмите токен в профиле и выполните «сфера войти»");
    конец
    результат из целого косая = найти(остаток, "/");
    если ( не косая.успешно)
        вернуть ответ_отказ(клиент, 400, "адрес публикации: /пакеты/публикация/ИМЯ/ВЕРСИЯ");
    конец
    текст имя = срез(остаток, 0, косая.значение);
    текст версия = срез(остаток, косая.значение + 1, длина(остаток) - косая.значение - 1);
    если ( не имя_пакета_допустимо(имя))
        вернуть ответ_отказ(клиент, 400, "имя пакета: буквы, цифры, «_» и «-», до 64 байт");
    конец
    если ( не версия_пакета_допустима(версия))
        вернуть ответ_отказ(клиент, 400, "версия должна быть вида X.Y.Z, например 1.0.0");
    конец
    результат из целого длина_тела = текст_в_целое(заголовок(з, "Content-Length"));
    если ( не длина_тела.успешно или длина_тела.значение меньше 1)
        вернуть ответ_отказ(клиент, 400, "нужен заголовок Content-Length");
    конец
    если (длина_тела.значение больше макс_размер_пакета())
        вернуть ответ_отказ(клиент, 413, "архив больше 5 МБ");
    конец
    текст реестр = прочитать_реестр();
    текст владелец = владелец_пакета(реестр, имя);
    если (длина(владелец) больше 0 и владелец != автор)
        вернуть ответ_отказ(клиент, 403, "пакет «" + имя + "» принадлежит другому автору");
    конец
    если (версия_в_реестре(реестр, имя, версия))
        вернуть ответ_отказ(клиент, 409, "версия " + версия + " уже опубликована — версии не меняются, увеличьте номер");
    конец

    создать_папку("данные/пакеты");
    создать_папку("данные/пакеты/.приём");
    текст файл = "данные/пакеты/.приём/" + целое_в_текст(монотонное_время_нс());
    результат из целого принято = принять_тело_в_файл(клиент, файл, длина_тела.значение);
    если ( не принято.успешно)
        убрать_приём(файл);
        вернуть ответ_отказ(клиент, 400, принято.сообщение);
    конец
    текст причина = проверить_архив(файл);
    если (длина(причина) больше 0)
        убрать_приём(файл);
        вернуть ответ_отказ(клиент, 422, причина);
    конец
    выполнить_команду("tar -xzOf '" + файл + "' 'пакет.сфера' > '" + файл + ".manifest' 2>/dev/null");
    результат из текста манифест = прочитать_файл(файл + ".manifest");
    если ( не манифест.успешно или длина(манифест.значение) больше 16384)
        убрать_приём(файл);
        вернуть ответ_отказ(клиент, 422, "не удалось прочитать пакет.сфера (он должен быть не больше 16 КБ)");
    конец
    если (поле_манифеста(манифест.значение, "имя") != имя)
        убрать_приём(файл);
        вернуть ответ_отказ(клиент, 422, "имя в пакет.сфера не совпадает с «" + имя + "»");
    конец
    если (поле_манифеста(манифест.значение, "версия") != версия)
        убрать_приём(файл);
        вернуть ответ_отказ(клиент, 422, "версия в пакет.сфера не совпадает с " + версия);
    конец
    текст описание = обрезать_до(очистить_поле(поле_манифеста(манифест.значение, "описание")), 200);
    описание = заменить(описание, "\"", "'");
    если (длина(описание) == 0)
        убрать_приём(файл);
        вернуть ответ_отказ(клиент, 422, "в пакет.сфера нужно описание (описание = …)");
    конец

    выполнить_команду("sha256sum '" + файл + "' | cut -d' ' -f1 > '" + файл + ".size'");
    результат из текста сумма_файл = прочитать_файл(файл + ".size");
    текст сумма = обрезать_края(сумма_файл.значение);
    если (длина(сумма) != 64)
        убрать_приём(файл);
        вернуть ответ_отказ(клиент, 500, "не удалось посчитать контрольную сумму");
    конец

    создать_папку("данные/пакеты/" + имя);
    результат из верного перенесён = переименовать_файл(файл, "данные/пакеты/" + имя + "/" + версия + ".tar.gz");
    если ( не перенесён.успешно)
        убрать_приём(файл);
        вернуть ответ_отказ(клиент, 500, "не удалось сохранить пакет");
    конец
    // README.md (если есть) — для страницы пакета; хранится как обычный текст.
    выполнить_команду("tar -xzOf 'данные/пакеты/" + имя + "/" + версия + ".tar.gz' 'README.md' 2>/dev/null | head -c 100000 > 'данные/пакеты/" + имя + "/" + версия + ".README.md'");
    убрать_приём(файл);

    текст строка = имя + " | " + версия + " | " + сумма + " | " + целое_в_текст(длина_тела.значение) + " | " + целое_в_текст(юникс_время()) + " | " + автор + " | " + описание + " | 0\n";
    дописать_в_файл_бинарно("данные/реестр.txt", строка, длина(строка));
    вернуть ответ_json(клиент, 201, "{\"ok\":true,\"имя\":" + json_строка(имя) + ",\"версия\":" + json_строка(версия) + ",\"sha256\":" + json_строка(сумма) + "}");
конец

