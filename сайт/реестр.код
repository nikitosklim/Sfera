// ---------------------------------------------------------------- проверки

// Версия X.Y.Z: три числа из цифр через точки.
функция версия_пакета_допустима(текст в_строка): верно
    целое n = длина(в_строка);
    если (n меньше 5 или n больше 24)
        вернуть нет;
    конец
    целое точки = 0;
    целое цифры_подряд = 0;
    целое i = 0;
    пока (i меньше n)
        целое б = целое(байт_текста(в_строка, i));
        если (б == 46)
            если (цифры_подряд == 0)
                вернуть нет;
            конец
            точки = точки + 1;
            цифры_подряд = 0;
        иначе
            если (б меньше 48 или б больше 57)
                вернуть нет;
            конец
            цифры_подряд = цифры_подряд + 1;
        конец
        i = i + 1;
    конец
    вернуть точки == 2 и цифры_подряд больше 0;
конец

// Допустимое имя файла внутри архива пакета.
функция имя_в_архиве_допустимо(текст имя): верно
    если (длина(имя) == 0 или длина(имя) больше 100)
        вернуть нет;
    конец
    если (содержит(имя, "/") или содержит(имя, "\\") или содержит(имя, "..") или начинается_с(имя, "."))
        вернуть нет;
    конец
    если (имя == "пакет.сфера" или имя == "сфера.зависимости" или имя == "LICENSE")
        вернуть да;
    конец
    вернуть оканчивается_на(имя, ".код") или оканчивается_на(имя, ".md");
конец

// ---------------------------------------------------------------- модерация

// Статус пакета из данные/модерация.txt («имя | статус | кто | время»): проверен, нежелательный;
// пустой текст — не проверен (так выглядит каждый новый пакет).
функция статус_пакета(текст имя): текст
    результат из текста файл = прочитать_файл("данные/модерация.txt");
    если ( не файл.успешно)
        вернуть "";
    конец
    целое всего = длина(файл.значение);
    целое позиция = 0;
    пока (позиция меньше всего)
        целое до = конец_строки(файл.значение, позиция);
        текст строка = срез(файл.значение, позиция, до - позиция);
        позиция = до + 1;
        если (строка_записи(строка) и поле_строки(строка, 0) == имя)
            вернуть поле_строки(строка, 1);
        конец
    конец
    вернуть "";
конец

// Пометка рядом с названием пакета.
функция метка_статуса(текст имя): текст
    текст статус = статус_пакета(имя);
    если (статус == "проверен")
        вернуть "<span class=\"метка-статус статус-проверен\" title=\"Пакет посмотрел модератор\">проверен</span>";
    конец
    если (статус == "нежелательный")
        вернуть "<span class=\"метка-статус статус-нежелательный\" title=\"Пакет признан нежелательным: не устанавливайте его\">нежелательный</span>";
    конец
    вернуть "<span class=\"метка-статус\" title=\"Модератор пока не смотрел этот пакет\">непроверенный</span>";
конец

// ---------------------------------------------------------------- реестр и авторы

функция прочитать_реестр(): текст
    результат из текста файл = прочитать_файл("данные/реестр.txt");
    если ( не файл.успешно)
        вернуть "";
    конец
    вернуть файл.значение;
конец

// Автор пакета (по первой записи); пустой текст, если пакета ещё нет.
функция владелец_пакета(текст реестр, текст имя): текст
    целое всего = длина(реестр);
    целое позиция = 0;
    пока (позиция меньше всего)
        целое до = конец_строки(реестр, позиция);
        текст строка = срез(реестр, позиция, до - позиция);
        позиция = до + 1;
        если (строка_записи(строка) и поле_строки(строка, 0) == имя)
            вернуть поле_строки(строка, 5);
        конец
    конец
    вернуть "";
конец

функция версия_в_реестре(текст реестр, текст имя, текст версия): верно
    целое всего = длина(реестр);
    целое позиция = 0;
    пока (позиция меньше всего)
        целое до = конец_строки(реестр, позиция);
        текст строка = срез(реестр, позиция, до - позиция);
        позиция = до + 1;
        если (строка_записи(строка) и поле_строки(строка, 0) == имя и поле_строки(строка, 1) == версия)
            вернуть да;
        конец
    конец
    вернуть нет;
конец

// Имя автора по токену из заголовка Authorization; пустой текст — токен неверный.
функция автор_по_токену(Запрос з): текст
    текст заявленный = заголовок(з, "Authorization");
    если (длина(заявленный) == 0)
        // Публикация со страницы сайта: вошедший пользователь (cookie сессии + заголовок X-Sfera).
        вернуть пользователь_для_действия(з);
    конец
    если (длина(заявленный) меньше 30 или не начинается_с(заявленный, "Bearer "))
        вернуть "";
    конец
    результат из текста файл = прочитать_файл("данные/авторы.txt");
    если ( не файл.успешно)
        вернуть "";
    конец
    текст найденный = "";
    целое всего = длина(файл.значение);
    целое позиция = 0;
    пока (позиция меньше всего)
        целое до = конец_строки(файл.значение, позиция);
        текст строка = срез(файл.значение, позиция, до - позиция);
        позиция = до + 1;
        если (строка_записи(строка))
            если (равны_постоянно(заявленный, "Bearer " + поле_строки(строка, 1)))
                найденный = поле_строки(строка, 0);
            конец
        конец
    конец
    если (длина(найденный) больше 0 и пользователь_заблокирован(найденный))
        вернуть "";
    конец
    вернуть найденный;
конец

