// POST /управление/автор/создать: «имя». Токен показывается один раз.
функция создать_автора(целое32 клиент, Запрос з): целое
    текст имя = обрезать_края(параметр(з.тело, "имя"));
    если ( не имя_пакета_допустимо(имя))
        вернуть ответ_ошибка(клиент, 400, "имя автора: буквы, цифры, «_» и «-»");
    конец
    если (автор_существует(имя))
        вернуть ответ_ошибка(клиент, 409, "такой автор уже есть (удалите его, чтобы выдать новый токен)");
    конец
    текст временный = "данные/.новый-токен-" + целое_в_текст(монотонное_время_нс());
    выполнить_команду("head -c 32 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 40 > '" + временный + "'");
    результат из текста файл = прочитать_файл(временный);
    удалить_файл(временный);
    текст токен = "";
    если (файл.успешно)
        токен = обрезать_края(файл.значение);
    конец
    если (длина(токен) меньше 30)
        вернуть ответ_ошибка(клиент, 500, "не удалось создать токен");
    конец
    текст строка = имя + " | " + токен + " | " + целое_в_текст(юникс_время()) + "\n";
    дописать_в_файл_бинарно("данные/авторы.txt", строка, длина(строка));
    вернуть ответ_json(клиент, 201, "{\"ok\":true,\"токен\":" + json_строка(токен) + "}");
конец

// POST /управление/автор/удалить: «имя». Его пакеты остаются, токен перестаёт работать.
функция удалить_автора(целое32 клиент, Запрос з): целое
    текст имя = обрезать_края(параметр(з.тело, "имя"));
    результат из текста файл = прочитать_файл("данные/авторы.txt");
    если (длина(имя) == 0 или не файл.успешно)
        вернуть ответ_ошибка(клиент, 404, "такого автора нет");
    конец
    текст новый = "";
    верно нашли = нет;
    целое всего = длина(файл.значение);
    целое позиция = 0;
    пока (позиция меньше всего)
        целое до = конец_строки(файл.значение, позиция);
        текст строка = срез(файл.значение, позиция, до - позиция);
        позиция = до + 1;
        если (строка_записи(строка) и поле_строки(строка, 0) == имя)
            нашли = да;
        иначе
            если (длина(строка) больше 0)
                новый = новый + строка + "\n";
            конец
        конец
    конец
    если ( не нашли)
        вернуть ответ_ошибка(клиент, 404, "такого автора нет");
    конец
    записать_файл("данные/авторы.txt.new", новый);
    переименовать_файл("данные/авторы.txt.new", "данные/авторы.txt");
    вернуть ответ_json(клиент, 200, "{\"ok\":true}");
конец

// POST /управление/автор/список — имена авторов (JSON-массив).
функция список_авторов(целое32 клиент): целое
    результат из текста файл = прочитать_файл("данные/авторы.txt");
    текст итог = "[";
    если (файл.успешно)
        целое всего = длина(файл.значение);
        целое позиция = 0;
        верно первый = да;
        пока (позиция меньше всего)
            целое до = конец_строки(файл.значение, позиция);
            текст строка = срез(файл.значение, позиция, до - позиция);
            позиция = до + 1;
            если (строка_записи(строка))
                если ( не первый)
                    итог = итог + ",";
                конец
                первый = нет;
                итог = итог + json_строка(поле_строки(строка, 0));
            конец
        конец
    конец
    вернуть ответ_json(клиент, 200, итог + "]");
конец

// Переписывает реестр: действие 1 — поставить отметку «отозвана» (значение), 2 — убрать пакет целиком.
функция изменить_реестр(текст имя, текст версия, целое действие, текст значение): верно
    текст реестр = прочитать_реестр();
    текст новый = "";
    верно нашли = нет;
    целое всего = длина(реестр);
    целое позиция = 0;
    пока (позиция меньше всего)
        целое до = конец_строки(реестр, позиция);
        текст строка = срез(реестр, позиция, до - позиция);
        позиция = до + 1;
        если (строка_записи(строка) и поле_строки(строка, 0) == имя)
            если (действие == 1)
                если (поле_строки(строка, 1) == версия)
                    нашли = да;
                    новый = новый + поле_строки(строка, 0) + " | " + поле_строки(строка, 1) + " | " + поле_строки(строка, 2) + " | " + поле_строки(строка, 3) + " | " + поле_строки(строка, 4) + " | " + поле_строки(строка, 5) + " | " + поле_строки(строка, 6) + " | " + значение + "\n";
                иначе
                    новый = новый + строка + "\n";
                конец
            иначе
                нашли = да;
            конец
        иначе
            если (длина(строка) больше 0)
                новый = новый + строка + "\n";
            конец
        конец
    конец
    если ( не нашли)
        вернуть нет;
    конец
    результат из верного записан = записать_файл("данные/реестр.txt.new", новый);
    если ( не записан.успешно)
        вернуть нет;
    конец
    результат из верного заменён = переименовать_файл("данные/реестр.txt.new", "данные/реестр.txt");
    вернуть заменён.успешно;
конец

// POST /управление/реестр/отозвать: «имя», «версия», «значение» (1 — отозвать, 0 — вернуть).
функция отозвать_версию(целое32 клиент, Запрос з): целое
    текст имя = обрезать_края(параметр(з.тело, "имя"));
    текст версия = обрезать_края(параметр(з.тело, "версия"));
    текст значение = "0";
    если (обрезать_края(параметр(з.тело, "значение")) == "1")
        значение = "1";
    конец
    если ( не имя_пакета_допустимо(имя) или не версия_пакета_допустима(версия) или не изменить_реестр(имя, версия, 1, значение))
        вернуть ответ_ошибка(клиент, 404, "такой версии нет");
    конец
    вернуть ответ_json(клиент, 200, "{\"ok\":true}");
конец

// POST /управление/реестр/удалить: «имя» — убирает пакет со всеми версиями.
функция удалить_пакет_из_реестра(целое32 клиент, Запрос з): целое
    текст имя = обрезать_края(параметр(з.тело, "имя"));
    если ( не имя_пакета_допустимо(имя) или не изменить_реестр(имя, "", 2, ""))
        вернуть ответ_ошибка(клиент, 404, "такого пакета нет");
    конец
    выполнить_команду("rm -rf 'данные/пакеты/" + имя + "'");
    вернуть ответ_json(клиент, 200, "{\"ok\":true}");
конец
