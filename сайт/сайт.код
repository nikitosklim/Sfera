// Сравнение без раннего выхода: время не зависит от того, где различие.
функция равны_постоянно(текст а, текст б): верно
    если (длина(а) != длина(б))
        вернуть нет;
    конец
    целое различие = 0;
    целое i = 0;
    пока (i меньше длина(а))
        если (байт_текста(а, i) != байт_текста(б, i))
            различие = различие + 1;
        конец
        i = i + 1;
    конец
    вернуть различие == 0;
