// сайт.код — страницы сайта «Сферы». Разметка лежит в отдельных файлах:
//   pages/layout.html  — общий каркас ({{заголовок}}, {{содержимое}}, {{счётчик}})
//   pages/*.html       — содержимое страниц
//   static/*           — стили и картинки
//   downloads/list.txt — список файлов для загрузки: «имя | название | описание»
//   content/<раздел>/list.txt и *.md — статьи и документация в Markdown
//
// Все пути относительные и ASCII: программу нужно запускать из папки сайта
// (на Windows fopen принимает имена в ANSI, кириллица в пути не откроется).

подключить веб;
подключить разметка;

// Собирает страницу: содержимое файла pages/<файл_страницы> вставляется в
// pages/layout.html. Дополнительные подстановки в содержимое (например {{список}})
// передаются списками имена/значения. Результат — в куче, освобождает вызывающий.
функция страница(текст заголовок, текст файл_страницы, текст счётчик_текст, Список из текст имена_в_содержимом, Список из текст значения_в_содержимом): текст
    результат из текст каркас = прочитать_файл("pages/layout.html");
    результат из текст содержимое = прочитать_файл("pages/" + файл_страницы);
    если ( не каркас.успешно или не содержимое.успешно)
        текст ошибка_текст = выделить_память(256);
        текст сообщение = "<h1>Ошибка</h1><p>Не найдены файлы страниц. Запускайте сервер из папки сайта.</p>";
        скопировать_память(ошибка_текст, сообщение, длина(сообщение) + 1);
        вернуть ошибка_текст;
    конец
    текст тело = подставить(содержимое.значение, имена_в_содержимом, значения_в_содержимом);

    Список из текст имена = Список из текст();
    Список из текст значения = Список из текст();
    имена.добавить("содержимое");
    значения.добавить(тело);
    имена.добавить("заголовок");
    значения.добавить(заголовок);
    имена.добавить("счётчик");
    значения.добавить(счётчик_текст);
    текст итог = подставить(каркас.значение, имена, значения);

    освободить_память(тело);
    имена.освободить();
    значения.освободить();
    вернуть итог;
конец

// ---------------------------------------------------------------- счётчик

// Счётчик без блокировок и гонок: каждое посещение дописывает ОДИН байт в файл
// visits.log, а число посещений — это размер файла. Дозапись в конец файла
// безопасна при одновременных запросах из многих потоков (хранилище с
// индексом из нескольких потоков одновременно открывать нельзя — на этом
// прежняя версия падала под нагрузкой).
функция обновить_и_показать_счётчик(): текст
    дописать_в_файл_бинарно("visits.log", "x", 1);
    результат из целое размер = размер_файла("visits.log");
    если ( не размер.успешно)
        вернуть "посещения не посчитаны";
    конец
    вернуть "посещение №" + целое_в_текст(размер.значение);
конец

// ---------------------------------------------------------------- загрузки

// Часть строки списка: поле номер n (с нуля), поля разделены "|", края обрезаны.
// Работает по индексам байтов, без промежуточных строк (чтобы не плодить мусор).
функция поле_строки(текст строка, целое n): текст
    целое всего = длина(строка);
    целое начало = 0;
    целое номер = 0;
    целое i = 0;
    пока (i меньше всего и номер меньше n)
        если (целое(байт_текста(строка, i)) == 124)
            номер = номер + 1;
            начало = i + 1;
        конец
        i = i + 1;
    конец
    если (номер меньше n)
        вернуть "";
    конец
    целое справа = начало;
    пока (справа меньше всего и целое(байт_текста(строка, справа)) != 124)
        справа = справа + 1;
    конец
    пока (начало меньше справа и целое(байт_текста(строка, начало)) не больше 32)
        начало = начало + 1;
    конец
    пока (справа больше начало и целое(байт_текста(строка, справа - 1)) не больше 32)
        справа = справа - 1;
    конец
    вернуть срез(строка, начало, справа - начало);
конец

// Строка списка — настоящая запись: первый значимый символ есть и это не "#".
функция строка_записи(текст строка): верно
    целое всего = длина(строка);
    целое i = 0;
    пока (i меньше всего и целое(байт_текста(строка, i)) не больше 32)
        i = i + 1;
    конец
    если (i == всего)
        вернуть нет;
    конец
    вернуть целое(байт_текста(строка, i)) != 35;
конец

// Конец строки, начинающейся с позиции «с» (индекс перевода строки или длина текста).
функция конец_строки(текст источник, целое с): целое
    целое всего = длина(источник);
    целое i = с;
    пока (i меньше всего и целое(байт_текста(источник, i)) != 10)
        i = i + 1;
    конец
    вернуть i;
конец

функция размер_текстом(целое размер): текст
    если (размер больше 1048575)
        целое десятые = (размер * 10) / 1048576;
        вернуть целое_в_текст(десятые / 10) + "," + целое_в_текст(десятые % 10) + " МБ";
    конец
    если (размер больше 1023)
        вернуть целое_в_текст(размер / 1024) + " КБ";
    конец
    вернуть целое_в_текст(размер) + " Б";
конец

// Контрольная сумма SHA-256 (64 шестнадцатеричных символа) — только если в списке
// указано корректное значение; иначе ничего не выводится.
функция сумма_html(текст сумма): текст
    если (длина(сумма) != 64)
        вернуть "";
    конец
    целое i = 0;
    пока (i меньше 64)
        целое б = целое(байт_текста(сумма, i));
        если ( не ((б не меньше 48 и б не больше 57) или (б не меньше 97 и б не больше 102)))
            вернуть "";
        конец
        i = i + 1;
    конец
    вернуть "<br><span class=\"muted\">SHA-256:</span> <code class=\"sha\">" + сумма + "</code>";
конец

// Файл допустим для скачивания, только если он указан в downloads/list.txt.
функция файл_в_списке(текст имя): верно
    результат из текст список = прочитать_файл("downloads/list.txt");
    если ( не список.успешно)
        вернуть нет;
    конец
    целое всего = длина(список.значение);
    целое позиция = 0;
    верно найден = нет;
    пока (позиция меньше всего и не найден)
        целое до = конец_строки(список.значение, позиция);
        текст строка = срез(список.значение, позиция, до - позиция);
        если (строка_записи(строка))
            текст первое_поле = поле_строки(строка, 0);
            если (первое_поле == имя)
                найден = да;
            конец
        конец
        позиция = до + 1;
    конец
    вернуть найден;
конец

функция список_загрузок(): текст
    результат из текст список = прочитать_файл("downloads/list.txt");
    если ( не список.успешно)
        вернуть "<p class=\"muted\">Список загрузок пока не настроен.</p>";
    конец
    текст строки_таблицы = "";
    целое всего = длина(список.значение);
    целое позиция = 0;
    пока (позиция меньше всего)
        целое до = конец_строки(список.значение, позиция);
        текст строка = срез(список.значение, позиция, до - позиция);
        позиция = до + 1;
        если (строка_записи(строка))
            текст имя = поле_строки(строка, 0);
            текст название = поле_строки(строка, 1);
            текст описание = поле_строки(строка, 2);
            текст сумма = поле_строки(строка, 3);
            результат из целое размер = размер_файла("downloads/" + имя);
            если (размер.успешно и путь_безопасен("/" + имя) и не содержит(имя, "/"))
                если (длина(название) == 0)
                    название = имя;
                конец
                текст название_html = экранировать_html(название);
                текст описание_html = экранировать_html(описание);
                строки_таблицы = строки_таблицы + "<tr><td><b>" + название_html + "</b><br><span class=\"muted\">" +
                    описание_html + "</span>" + сумма_html(сумма) + "</td><td>" + размер_текстом(размер.значение) +
                    "</td><td><a class=\"button\" href=\"/files/" + имя + "\">Скачать</a></td></tr>";
                освободить_память(название_html);
                освободить_память(описание_html);
            конец
        конец
    конец
    если (длина(строки_таблицы) == 0)
        вернуть "<p class=\"muted\">Файлов для загрузки пока нет.</p>";
    конец
    вернуть "<table><tr><th>Файл</th><th>Размер</th><th></th></tr>" + строки_таблицы + "</table>";
конец

// ---------------------------------------------------------------- материалы (Markdown)

// Имя материала — только латиница, цифры, «-» и «_» (оно же имя файла без .md).
функция имя_допустимо(текст имя): верно
    целое n = длина(имя);
    если (n == 0 или n больше 64)
        вернуть нет;
    конец
    целое i = 0;
    пока (i меньше n)
        целое б = целое(байт_текста(имя, i));
        верно хороший = (б не меньше 97 и б не больше 122) или (б не меньше 48 и б не больше 57) или б == 45 или б == 95;
        если ( не хороший)
            вернуть нет;
        конец
        i = i + 1;
    конец
    вернуть да;
конец

// Список материалов раздела: content/<раздел>/list.txt, строки «имя | название | описание».
// Материалы без файла <имя>.md не показываются.
функция каталог_материалов(текст раздел): текст
    результат из текст список = прочитать_файл("content/" + раздел + "/list.txt");
    если ( не список.успешно)
        вернуть "<p class=\"muted\">Материалов пока нет.</p>";
    конец
    текст пункты = "";
    целое всего = длина(список.значение);
    целое позиция = 0;
    пока (позиция меньше всего)
        целое до = конец_строки(список.значение, позиция);
        текст строка = срез(список.значение, позиция, до - позиция);
        позиция = до + 1;
        если (строка_записи(строка))
            текст имя = поле_строки(строка, 0);
            текст название = поле_строки(строка, 1);
            текст описание = поле_строки(строка, 2);
            результат из целое размер = размер_файла("content/" + раздел + "/" + имя + ".md");
            если (размер.успешно и имя_допустимо(имя))
                если (длина(название) == 0)
                    название = имя;
                конец
                текст название_html = экранировать_html(название);
                текст описание_html = экранировать_html(описание);
                пункты = пункты + "<li><a href=\"/" + раздел + "/" + имя + "\"><b>" + название_html +
                    "</b></a><br><span class=\"muted\">" + описание_html + "</span></li>";
                освободить_память(название_html);
                освободить_память(описание_html);
            конец
        конец
    конец
    если (длина(пункты) == 0)
        вернуть "<p class=\"muted\">Материалов пока нет.</p>";
    конец
    вернуть "<ul class=\"материалы\">" + пункты + "</ul>";
конец

// Готовая страница материала или пустой текст, если такого материала нет.
// Непустой результат освобождает вызывающий.
функция страница_материала(текст раздел, текст имя, текст счётчик_текст): текст
    если ( не имя_допустимо(имя))
        вернуть "";
    конец
    результат из текст файл = прочитать_файл("content/" + раздел + "/" + имя + ".md");
    если ( не файл.успешно)
        вернуть "";
    конец
    текст исходник = файл.значение;
    текст тело = markdown_в_html(исходник);
    текст оглавление = оглавление_html(исходник);
    текст название = заголовок_документа(исходник);
    Список из текст имена = Список из текст();
    Список из текст значения = Список из текст();
    имена.добавить("оглавление");
    значения.добавить(оглавление);
    имена.добавить("текст");
    значения.добавить(тело);
    текст готовая = страница(название, "material.html", счётчик_текст, имена, значения);
    освободить_память(тело);
    освободить_память(оглавление);
    если (длина(название) больше 0)
        освободить_память(название);
    конец
    имена.освободить();
    значения.освободить();
    вернуть готовая;
конец

