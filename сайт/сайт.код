// Принимает файл установщика: PUT /upload/<имя> с телом-файлом.
// Заголовки: Authorization: Bearer <токен>, X-Title, X-Description (оба через encodeURIComponent),
// X-Sha256 (необязательно, 64 символа). Максимальный размер — 2 ГБ.
функция принять_загрузку(целое32 клиент, Запрос з, текст имя): целое
    если ( не авторизован(з))
        вернуть ответ_json(клиент, 401, "{\"ok\":false,\"ошибка\":\"нет доступа: неверный токен или загрузка выключена\"}");
    конец
    если ( не имя_загрузки_допустимо(имя))
        вернуть ответ_json(клиент, 400, "{\"ok\":false,\"ошибка\":\"имя файла: только латиница, цифры, точка, подчёркивание и дефис\"}");
    конец
    результат из целого длина_тела = текст_в_целое(заголовок(з, "Content-Length"));
    если ( не длина_тела.успешно или длина_тела.значение меньше 1)
        вернуть ответ_json(клиент, 400, "{\"ok\":false,\"ошибка\":\"нужен заголовок Content-Length\"}");
    конец
    если (длина_тела.значение больше 2147483648)
        вернуть ответ_json(клиент, 413, "{\"ok\":false,\"ошибка\":\"файл больше 2 ГБ\"}");
    конец
    если (файл_в_списке(имя))
        вернуть ответ_json(клиент, 409, "{\"ok\":false,\"ошибка\":\"такой файл уже есть в списке — загрузите под другим именем (например, с номером версии)\"}");
    конец
    текст время_файл = "downloads/" + имя + ".part";
    результат из целого принято = принять_тело_в_файл(клиент, время_файл, длина_тела.значение);
    если ( не принято.успешно)
        вернуть ответ_json(клиент, 400, "{\"ok\":false,\"ошибка\":" + json_строка(принято.сообщение) + "}");
    конец
    результат из верного переименован = переименовать_файл(время_файл, "downloads/" + имя);
    если ( не переименован.успешно)
        вернуть ответ_json(клиент, 500, "{\"ok\":false,\"ошибка\":\"не удалось сохранить файл\"}");
    конец
    текст название = очистить_поле(декодировать_адрес(заголовок(з, "X-Title")));
    если (длина(название) == 0)
        название = имя;
    конец
    текст описание = очистить_поле(декодировать_адрес(заголовок(з, "X-Description")));
    текст сумма = регистр_в_нижний(заголовок(з, "X-Sha256"));
    если (длина(сумма_html(сумма)) == 0)
        сумма = "";
    конец
    текст строка = имя + " | " + название + " | " + описание + " | " + сумма + "\n";
    дописать_в_файл_бинарно("downloads/list.txt", строка, длина(строка));
    вернуть ответ_json(клиент, 201, "{\"ok\":true,\"имя\":" + json_строка(имя) + ",\"размер\":" + целое_в_текст(принято.значение) + "}");
конец

// Удаляет файл из списка загрузок: DELETE /upload/<имя> с токеном администратора.
// Строка с этим именем убирается из downloads/list.txt, сам файл удаляется с диска.
функция удалить_загрузку(целое32 клиент, Запрос з, текст имя): целое
    если ( не авторизован(з))
        вернуть ответ_json(клиент, 401, "{\"ok\":false,\"ошибка\":\"нет доступа: неверный токен или загрузка выключена\"}");
    конец
    если ( не имя_загрузки_допустимо(имя) или не файл_в_списке(имя))
        вернуть ответ_json(клиент, 404, "{\"ok\":false,\"ошибка\":\"такого файла нет в списке\"}");
    конец
    результат из текста список = прочитать_файл("downloads/list.txt");
    если ( не список.успешно)
        вернуть ответ_json(клиент, 500, "{\"ok\":false,\"ошибка\":\"не удалось прочитать список\"}");
    конец
    текст новый_список = "";
    целое всего = длина(список.значение);
    целое позиция = 0;
    пока (позиция меньше всего)
        целое до = конец_строки(список.значение, позиция);
        текст строка = срез(список.значение, позиция, до - позиция);
        позиция = до + 1;
        верно оставить = да;
        если (строка_записи(строка))
            если (поле_строки(строка, 0) == имя)
                оставить = нет;
            конец
        конец
        если (оставить)
            новый_список = новый_список + строка + "\n";
        конец
    конец
    результат из верного записан = записать_файл("downloads/list.txt.new", новый_список);
    если ( не записан.успешно)
        вернуть ответ_json(клиент, 500, "{\"ok\":false,\"ошибка\":\"не удалось записать список\"}");
    конец
    результат из верного заменён = переименовать_файл("downloads/list.txt.new", "downloads/list.txt");
    если ( не заменён.успешно)
        вернуть ответ_json(клиент, 500, "{\"ok\":false,\"ошибка\":\"не удалось обновить список\"}");
    конец
    удалить_файл("downloads/" + имя);
    вернуть ответ_json(клиент, 200, "{\"ok\":true}");
конец


