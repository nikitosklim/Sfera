// Весь блок страницы «Загрузки»: слева системы, справа таблица файлов, внизу всплывающие облачка.
функция список_загрузок(): текст
    результат из текста список = прочитать_файл("downloads/list.txt");
    текст в_windows = "";
    текст в_macos = "";
    текст в_linux = "";
    текст в_android = "";
    текст в_прочее = "";
    текст в_vscode = "";
    текст облака = "";
    если (список.успешно)
        целое всего = длина(список.значение);
        целое позиция = 0;
        целое номер = 0;
        пока (позиция меньше всего)
            целое до = конец_строки(список.значение, позиция);
            текст строка = срез(список.значение, позиция, до - позиция);
            позиция = до + 1;
            если (строка_записи(строка))
                текст имя = поле_строки(строка, 0);
                текст название = поле_строки(строка, 1);
                текст описание = поле_строки(строка, 2);
                текст сумма = поле_строки(строка, 3);
                результат из целого размер = размер_файла("downloads/" + имя);
                если (размер.успешно и путь_безопасен("/" + имя) и не содержит(имя, "/"))
                    если (длина(название) == 0)
                        название = имя;
                    конец
                    номер = номер + 1;
                    текст платформа = платформа_файла(имя);
                    текст версия = версия_файла(имя);
                    текст строка_таблицы = строка_файла(имя, платформа, номер, размер.значение, название, версия);
                    // новые файлы выше: список дописывается в конец, поэтому добавляем строку в начало
                    если (платформа == "windows")
                        в_windows = строка_таблицы + в_windows;
                    иначе если (платформа == "macos")
                        в_macos = строка_таблицы + в_macos;
                    иначе если (платформа == "linux")
                        в_linux = строка_таблицы + в_linux;
                    иначе если (платформа == "android")
                        в_android = строка_таблицы + в_android;
                    иначе если (платформа == "vscode")
                        в_vscode = строка_таблицы + в_vscode;
                    иначе
                        в_прочее = строка_таблицы + в_прочее;
                    конец
                    текст тело = "<table class=\"о-файле\"><tr><th>Система</th><td>" + название_системы(платформа) + "</td></tr>";
                    если (длина(версия) больше 0)
                        тело = тело + "<tr><th>Версия</th><td>" + экранировать_html(версия) + "</td></tr>";
                    конец
                    тело = тело + "<tr><th>Файл</th><td><code>" + экранировать_html(имя) + "</code></td></tr><tr><th>Размер</th><td>" + размер_текстом(размер.значение) + "</td></tr></table>";
                    если (длина(описание) больше 0)
                        тело = тело + "<p>" + экранировать_html(описание) + "</p>";
                    конец
                    текст проверка = сумма_html(сумма);
                    если (длина(проверка) больше 0)
                        тело = тело + "<h3>Проверить файл</h3><p>Контрольная сумма SHA-256 должна совпасть с вашей:</p><p><code class=\"sha\">" + сумма + "</code></p><p class=\"muted\">Windows: <code>certutil -hashfile файл SHA256</code>. macOS и Linux: <code>shasum -a 256 файл</code>.</p>";
                    конец
                    тело = тело + "<p><a class=\"button\" href=\"/файлы/" + имя + "\">Скачать</a> <a class=\"button secondary\" href=\"#о-как-" + платформа + "\">Как установить</a></p>";
                    облака = облака + облако_html("о-файл-" + целое_в_текст(номер), экранировать_html(название), тело);
                конец
            конец
        конец
    конец
    текст радио = "";
    текст метки = "";
    текст панели = "";
    Список из текстов системы = Список из текстов();
    системы.добавить("windows");
    системы.добавить("macos");
    системы.добавить("linux");
    системы.добавить("android");
    если (длина(в_прочее) больше 0)
        системы.добавить("прочее");
    конец
    целое k = 0;
    пока (k меньше системы.размер())
        текст платформа = системы.получить(k);
        текст отмечено = "";
        если (k == 0)
            отмечено = " checked";
        конец
        текст строки = в_windows;
        если (платформа == "macos")
            строки = в_macos;
        иначе если (платформа == "linux")
            строки = в_linux;
        иначе если (платформа == "android")
            строки = в_android;
        иначе если (платформа == "прочее")
            строки = в_прочее;
        конец
        радио = радио + "<input type=\"radio\" name=\"система\" id=\"зп-" + платформа + "\" class=\"пл-радио\"" + отмечено + ">";
        метки = метки + "<label for=\"зп-" + платформа + "\" class=\"пл-метка\">" + название_системы(платформа) + "</label>";
        панели = панели + панель_системы(платформа, строки, в_vscode);
        облака = облака + облако_html("о-как-" + платформа, "Как установить на " + название_системы(платформа),
            инструкция_системы(платформа) + "<h3>Расширение для VS Code</h3>" + инструкция_системы("vscode"));
        k = k + 1;
    конец
    облака = облака + облако_html("о-как-vscode", "Как установить расширение для VS Code", инструкция_системы("vscode"));
    системы.освободить();
    вернуть радио + "<div class=\"вкладки-бок\"><div class=\"вкладки-список\" aria-label=\"Системы\">" + метки + "</div><div>" + панели + "</div></div>" + облака;
конец

// ---------------------------------------------------------------- материалы (Markdown)

// Имя материала — только латиница, цифры, «-» и «_» (оно же имя файла без .md).
функция имя_допустимо(текст имя): верно
    целое n = длина(имя);
    если (n == 0 или n больше 64)
        вернуть нет;
    конец
    целое i = 0;
    пока (i меньше n)
        целое б = целое(байт_текста(имя, i));
        верно хороший = (б не меньше 97 и б не больше 122) или (б не меньше 48 и б не больше 57) или б == 45 или б == 95;
        если ( не хороший)
            вернуть нет;
        конец
        i = i + 1;
    конец
    вернуть да;
конец

// Список материалов раздела: content/<раздел>/list.txt, строки «имя | название | описание | метка».
// Материалы без файла <имя>.md не показываются. Результат — плитки; если «по_группам»,
// метка (четвёртое поле) становится заголовком группы, иначе — значком на плитке.
функция каталог_материалов(текст раздел, верно по_группам): текст
    результат из текста список = прочитать_файл("content/" + раздел + "/list.txt");
    если ( не список.успешно)
        вернуть "<p class=\"muted\">Материалов пока нет.</p>";
    конец
    текст пункты = "";
    текст группа = "";
    целое всего = длина(список.значение);
    целое позиция = 0;
    целое штук = 0;
    пока (позиция меньше всего)
        целое до = конец_строки(список.значение, позиция);
        текст строка = срез(список.значение, позиция, до - позиция);
        позиция = до + 1;
        если (строка_записи(строка))
            текст имя = поле_строки(строка, 0);
            текст название = поле_строки(строка, 1);
            текст описание = поле_строки(строка, 2);
            текст метка = поле_строки(строка, 3);
            результат из целого размер = размер_файла("content/" + раздел + "/" + имя + ".md");
            если (размер.успешно и имя_допустимо(имя))
                если (длина(название) == 0)
                    название = имя;
                конец
                текст название_html = экранировать_html(название);
                текст описание_html = экранировать_html(описание);
                текст метка_html = экранировать_html(метка);
                если (по_группам)
                    если (штук == 0 или метка != группа)
                        если (штук больше 0)
                            пункты = пункты + "</div>";
                        конец
                        пункты = пункты + "<h2>" + метка_html + "</h2><div class=\"плитки\">";
                        группа = метка;
                    конец
                    пункты = пункты + "<a class=\"плитка\" href=\"" + адрес_материала(раздел, имя) + "\"><b>" +
                        название_html + "</b><span>" + описание_html + "</span></a>";
                иначе
                    если (штук == 0)
                        пункты = пункты + "<div class=\"плитки\">";
                    конец
                    пункты = пункты + "<a class=\"плитка\" href=\"" + адрес_материала(раздел, имя) + "\">";
                    если (длина(метка) больше 0)
                        пункты = пункты + "<em>" + метка_html + "</em>";
                    конец
                    пункты = пункты + "<b>" + название_html + "</b><span>" + описание_html + "</span></a>";
                конец
                штук = штук + 1;
                освободить_память(название_html);
                освободить_память(описание_html);
                освободить_память(метка_html);
            конец
        конец
    конец
    если (штук == 0)
        вернуть "<p class=\"muted\">Материалов пока нет.</p>";
    конец
    вернуть пункты + "</div>";
конец

// ---------------------------------------------------------------- уроки и курс

// Читает content/lessons/list.txt. Записи с меткой «Курс N» — уроки курса (плейлист), остальные — обычные уроки (плитки).
// для_курса = да: плейлист курса (блок с фоном, описанием, списком и кнопкой); нет: плитки обычных уроков.
функция уроки_html(верно для_курса): текст
    результат из текста список = прочитать_файл("content/lessons/list.txt");
    если ( не список.успешно)
        вернуть "";
    конец
    текст пункты = "";
    текст первый_адрес = "";
    целое всего = длина(список.значение);
    целое позиция = 0;
    целое штук = 0;
    пока (позиция меньше всего)
        целое до = конец_строки(список.значение, позиция);
        текст строка = срез(список.значение, позиция, до - позиция);
        позиция = до + 1;
        если (строка_записи(строка))
            текст имя = поле_строки(строка, 0);
            текст название = экранировать_html(поле_строки(строка, 1));
            текст описание = экранировать_html(поле_строки(строка, 2));
            текст метка = поле_строки(строка, 3);
            верно из_курса = начинается_с_текста(метка, "Курс");
            результат из целого размер = размер_файла("content/lessons/" + имя + ".md");
            если (размер.успешно и имя_допустимо(имя) и из_курса == для_курса)
                текст адрес = адрес_материала("lessons", имя);
                штук = штук + 1;
                если (для_курса)
                    если (штук == 1)
                        первый_адрес = адрес;
                    конец
                    пункты = пункты + "<li><a href=\"" + адрес + "\"><i>" + целое_в_текст(штук) + "</i><span><b>" + название +
                        "</b><small>" + описание + "</small></span></a></li>";
                иначе
                    пункты = пункты + "<a class=\"плитка\" href=\"" + адрес + "\"><em>" + экранировать_html(метка) + "</em><b>" +
                        название + "</b><span>" + описание + "</span></a>";
                конец
            конец
        конец
    конец
    если (штук == 0)
        вернуть "";
    конец
    если ( не для_курса)
        вернуть "<div class=\"плитки\">" + пункты + "</div>";
    конец
    вернуть "<section class=\"курс\" aria-labelledby=\"курс-заголовок\"><div class=\"курс-фон\" aria-hidden=\"true\"></div><div class=\"курс-внутри\">" +
        "<p class=\"курс-метка\">Бесплатный курс · " + целое_в_текст(штук) + " уроков</p>" +
        "<h3 id=\"курс-заголовок\">Для обучения программированию</h3>" +
        "<p class=\"курс-описание\">Основы и практика с нуля: от первой программы до собственной игры. Подходит для школ, колледжей и вузов, а также для самостоятельного обучения.</p>" +
        "<ol class=\"плейлист\">" + пункты + "</ol>" +
        "<a class=\"button big\" href=\"" + первый_адрес + "\">Начать курс</a></div></section>";
конец

// Поисковый индекс: все материалы одним текстом. Запись: «адрес, название, раздел, текст»;
// поля разделяет строка ПОЛЕ, записи — строка КОНЕЦ (экранировать ничего не нужно).
функция индекс_раздела(текст раздел, текст название_раздела): текст
    результат из текста список = прочитать_файл("content/" + раздел + "/list.txt");
    если ( не список.успешно)
        вернуть "";
    конец
    текст итог = "";
    целое всего = длина(список.значение);
    целое позиция = 0;
    пока (позиция меньше всего)
        целое до = конец_строки(список.значение, позиция);
        текст строка = срез(список.значение, позиция, до - позиция);
        позиция = до + 1;
        если (строка_записи(строка))
            текст имя = поле_строки(строка, 0);
            текст название = поле_строки(строка, 1);
            если (имя_допустимо(имя))
                результат из текста файл = прочитать_файл("content/" + раздел + "/" + имя + ".md");
                если (файл.успешно)
                    итог = итог + адрес_материала(раздел, имя) + "\n@@@ПОЛЕ@@@\n" + название + "\n@@@ПОЛЕ@@@\n" +
                        название_раздела + "\n@@@ПОЛЕ@@@\n" + файл.значение + "\n@@@КОНЕЦ@@@\n";
                конец
            конец
        конец
    конец
    вернуть итог;
конец

функция поисковый_индекс(): текст
    текст итог = индекс_раздела("docs", "Документация");
    итог = итог + индекс_раздела("lessons", "Уроки");
    итог = итог + индекс_раздела("examples", "Примеры");
    итог = итог + индекс_раздела("articles", "Статьи");
    вернуть итог;
конец

