// Адрес для заголовка Location и карты сайта: всё, кроме латиницы, цифр и «-_.~/», становится %XX.
функция кодировать_адрес(текст источник): текст
    целое n = длина(источник);
    текст буфер = выделить_память(n * 3 + 8);
    целое выход = 0;
    целое i = 0;
    пока (i меньше n)
        целое б = целое(байт_текста(источник, i));
        верно простой = (б не меньше 97 и б не больше 122) или (б не меньше 65 и б не больше 90) или (б не меньше 48 и б не больше 57) или б == 45 или б == 95 или б == 46 или б == 126 или б == 47;
        если (простой)
            записать_целое32(буфер, выход, целое32(б));
            выход = выход + 1;
        иначе
            целое старший = б / 16;
            целое младший = б - старший * 16;
            записать_целое32(буфер, выход, целое32(37));
            записать_целое32(буфер, выход + 1, целое32(цифра_адреса(старший)));
            записать_целое32(буфер, выход + 2, целое32(цифра_адреса(младший)));
            выход = выход + 3;
        конец
        i = i + 1;
    конец
    записать_целое32(буфер, выход, целое32(0));
    вернуть буфер;
конец

