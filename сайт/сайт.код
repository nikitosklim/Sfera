// Токен администратора лежит в файле admin-token.txt (его создаёт make-token.ps1 / make-token.sh).
// Нет файла — загрузка выключена. Файл не должен попадать в git.
функция прочитать_токен(): текст
    результат из текст файл = прочитать_файл("admin-token.txt");
    если ( не файл.успешно)
        вернуть "";
    конец
    вернуть обрезать_края(файл.значение);
конец

// Сравнение без раннего выхода: время не зависит от того, где различие.
функция равны_постоянно(текст а, текст б): верно
    если (длина(а) != длина(б))
        вернуть нет;
    конец
    целое различие = 0;
    целое i = 0;
    пока (i меньше длина(а))
        если (байт_текста(а, i) != байт_текста(б, i))
            различие = различие + 1;
        конец
        i = i + 1;
    конец
    вернуть различие == 0;
конец

// Запрос с верным заголовком «Authorization: Bearer <токен>»?
функция авторизован(Запрос з): верно
    текст токен = прочитать_токен();
    если (длина(токен) меньше 16)
        вернуть нет;
    конец
    вернуть равны_постоянно(заголовок(з, "Authorization"), "Bearer " + токен);
конец

// Имя файла для загрузки: латиница, цифры, «.», «_», «-»; не начинается с точки.
функция имя_загрузки_допустимо(текст имя): верно
    целое n = длина(имя);
    если (n == 0 или n больше 100 или целое(байт_текста(имя, 0)) == 46 или содержит(имя, ".."))
        вернуть нет;
    конец
    целое i = 0;
    пока (i меньше n)
        целое б = целое(байт_текста(имя, i));
        верно хороший = (б не меньше 97 и б не больше 122) или (б не меньше 65 и б не больше 90) или (б не меньше 48 и б не больше 57) или б == 45 или б == 95 или б == 46;
        если ( не хороший)
            вернуть нет;
        конец
        i = i + 1;
    конец
    вернуть да;
конец

// Поле списка не должно ломать формат «имя | название | описание | сумма».
функция очистить_поле(текст значение): текст
    текст а = заменить(значение, "|", "/");
    текст б = заменить(а, "\r", " ");
    вернуть заменить(б, "\n", " ");
конец

// Принимает файл установщика: PUT /upload/<имя> с телом-файлом.
// Заголовки: Authorization: Bearer <токен>, X-Title, X-Description (оба через encodeURIComponent),
// X-Sha256 (необязательно, 64 символа). Максимальный размер — 2 ГБ.
функция принять_загрузку(целое32 клиент, Запрос з, текст имя): целое
    если ( не авторизован(з))
        вернуть ответ_json(клиент, 401, "{\"ok\":false,\"ошибка\":\"нет доступа: неверный токен или загрузка выключена\"}");
    конец
    если ( не имя_загрузки_допустимо(имя))
        вернуть ответ_json(клиент, 400, "{\"ok\":false,\"ошибка\":\"имя файла: только латиница, цифры, точка, подчёркивание и дефис\"}");
    конец
    результат из целое длина_тела = текст_в_целое(заголовок(з, "Content-Length"));
    если ( не длина_тела.успешно или длина_тела.значение меньше 1)
        вернуть ответ_json(клиент, 400, "{\"ok\":false,\"ошибка\":\"нужен заголовок Content-Length\"}");
    конец
    если (длина_тела.значение больше 2147483648)
        вернуть ответ_json(клиент, 413, "{\"ok\":false,\"ошибка\":\"файл больше 2 ГБ\"}");
    конец
    если (файл_в_списке(имя))
        вернуть ответ_json(клиент, 409, "{\"ok\":false,\"ошибка\":\"такой файл уже есть в списке — загрузите под другим именем (например, с номером версии)\"}");
    конец
    текст время_файл = "downloads/" + имя + ".part";
    результат из целое принято = принять_тело_в_файл(клиент, время_файл, длина_тела.значение);
    если ( не принято.успешно)
        вернуть ответ_json(клиент, 400, "{\"ok\":false,\"ошибка\":" + json_строка(принято.сообщение) + "}");
    конец
    результат из верно переименован = переименовать_файл(время_файл, "downloads/" + имя);
    если ( не переименован.успешно)
        вернуть ответ_json(клиент, 500, "{\"ok\":false,\"ошибка\":\"не удалось сохранить файл\"}");
    конец
    текст название = очистить_поле(декодировать_адрес(заголовок(з, "X-Title")));
    если (длина(название) == 0)
        название = имя;
    конец
    текст описание = очистить_поле(декодировать_адрес(заголовок(з, "X-Description")));
    текст сумма = регистр_в_нижний(заголовок(з, "X-Sha256"));
    если (длина(сумма_html(сумма)) == 0)
        сумма = "";
    конец
    текст строка = имя + " | " + название + " | " + описание + " | " + сумма + "\n";
    дописать_в_файл_бинарно("downloads/list.txt", строка, длина(строка));
    вернуть ответ_json(клиент, 201, "{\"ok\":true,\"имя\":" + json_строка(имя) + ",\"размер\":" + целое_в_текст(принято.значение) + "}");
