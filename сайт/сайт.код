// Адрес по-русски у материала из list.txt (пятое поле); нет его — по имени файла.
функция слаг_материала(текст раздел, текст имя): текст
    результат из текста список = прочитать_файл("content/" + раздел + "/list.txt");
    если ( не список.успешно)
        вернуть имя;
    конец
    целое всего = длина(список.значение);
    целое позиция = 0;
    пока (позиция меньше всего)
        целое до = конец_строки(список.значение, позиция);
        текст строка = срез(список.значение, позиция, до - позиция);
        позиция = до + 1;
        если (строка_записи(строка) и поле_строки(строка, 0) == имя)
            текст слаг = поле_строки(строка, 4);
            если (длина(слаг) больше 0)
                вернуть слаг;
            конец
            вернуть имя;
        конец
    конец
    вернуть имя;
конец

функция адрес_материала(текст раздел, текст имя): текст
    вернуть "/" + раздел_в_адрес(раздел) + "/" + слаг_материала(раздел, имя);
конец

