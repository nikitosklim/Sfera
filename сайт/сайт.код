// Имя файла материала по адресу: подходит и русский адрес, и прежнее латинское имя.
// Нет такого материала — пустой текст.
функция найти_материал(текст раздел, текст адрес): текст
    если (длина(адрес) == 0 или содержит(адрес, "/"))
        вернуть "";
    конец
    результат из текста список = прочитать_файл("content/" + раздел + "/list.txt");
    если ( не список.успешно)
        вернуть "";
    конец
    целое всего = длина(список.значение);
    целое позиция = 0;
    пока (позиция меньше всего)
        целое до = конец_строки(список.значение, позиция);
        текст строка = срез(список.значение, позиция, до - позиция);
        позиция = до + 1;
        если (строка_записи(строка))
            текст имя = поле_строки(строка, 0);
            текст слаг = поле_строки(строка, 4);
            если (длина(слаг) == 0)
                слаг = имя;
            конец
            если (имя_допустимо(имя) и (адрес == слаг или адрес == имя))
                вернуть имя;
            конец
        конец
    конец
    вернуть "";
конец
