// сайт.код — первый сайт языка "Сфера", написанный полностью на самой
// "Сфере" — поверх стандартная_библиотека/сеть.код (HTTP-сервер,
// маршрутизация, параллельная обработка) и стандартная_библиотека/
// хранилище.код (счётчик посещений — собственное, без единой внешней
// библиотеки хранилище данных, о котором рассказывает сама страница).
//
// Это ровно та цель, с которой начиналась вся веб-тема: сайт языка,
// работающий на нём же — лучшее доказательство зрелости, какое только
// можно предъявить.

подключить сеть;
подключить хранилище;

// ---------------------------------------------------------------------
// Оформление — общий CSS, встроенный в каждую страницу (пока нет
// отдельного сервера статических файлов — одностраничные приложения
// на "Сфере" ещё впереди, для v1 проще держать всё в одном ответе).
// ---------------------------------------------------------------------
функция общий_стиль() -> текст {
    вернуть "body{font-family:-apple-system,Segoe UI,Roboto,sans-serif;max-width:760px;" +
        "margin:0 auto;padding:32px 20px;line-height:1.6;color:#1a1a1a;background:#fdfdfd}" +
        "h1{font-size:2em;margin-bottom:4px}" +
        "h2{margin-top:2em;border-bottom:2px solid #eee;padding-bottom:6px}" +
        ".tagline{color:#666;margin-top:0;margin-bottom:28px}" +
        "nav{margin-bottom:32px;padding-bottom:16px;border-bottom:1px solid #eee}" +
        "nav a{margin-right:20px;color:#2c5ff0;text-decoration:none;font-weight:500}" +
        "nav a:hover{text-decoration:underline}" +
        "pre{background:#282c34;color:#e6e6e6;padding:16px 20px;border-radius:8px;" +
        "overflow-x:auto;font-size:0.92em}" +
        "code{font-family:'SF Mono',Consolas,monospace}" +
        "p code{background:#f0f0f0;padding:2px 6px;border-radius:4px;color:#c0392b}" +
        ".card{background:#f7f8fa;border-radius:10px;padding:18px 22px;margin:16px 0}" +
        ".footer{margin-top:48px;padding-top:20px;border-top:1px solid #eee;color:#888;font-size:0.9em}" +
        "a{color:#2c5ff0}";
}

// Общий каркас (<html><head>...) вокруг содержимого конкретной страницы —
// убирает дублирование <head>/nav/footer в каждой отдельной странице.
функция обернуть_страницу(текст заголовок, текст содержимое, текст счётчик_html) -> текст {
    вернуть "<!DOCTYPE html><html lang=\"ru\"><head><meta charset=\"utf-8\">" +
        "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">" +
        "<title>" + заголовок + " — Сфера</title><style>" + общий_стиль() + "</style></head><body>" +
        "<nav><a href=\"/\">главная</a><a href=\"/about\">о языке</a><a href=\"/docs\">примеры кода</a>" +
        "<a href=\"https://github.com/nikitosklim/Sfera\">GitHub</a></nav>" +
        содержимое +
        "<div class=\"footer\">" + счётчик_html +
        " · Компилятор и сайт написаны на самой «Сфере», без единой внешней веб-библиотеки — " +
        "<a href=\"https://github.com/nikitosklim/Sfera\">исходники открыты</a>.</div>" +
        "</body></html>";
}

// ---------------------------------------------------------------------
// Страницы
// ---------------------------------------------------------------------

функция страница_главная(текст счётчик_html) -> текст {
    текст содержимое = "<h1>Сфера</h1>" +
        "<p class=\"tagline\">Компилируемый язык программирования, полностью на кириллице.</p>" +
        "<p>Весь синтаксис, все ключевые слова, вся стандартная библиотека — на русском языке. " +
        "Компилятор написан на Rust, генерирует машинный код напрямую через LLVM — " +
        "та же технология, на которой держится Clang и добрая половина современных языков.</p>" +
        "<div class=\"card\"><pre><code>функция главная() -> целое {\n" +
        "    вывести(\"Привет, мир!\");\n    вернуть 0;\n}</code></pre></div>" +
        "<p>Эта страница — часть сайта, который работает на настоящем HTTP-сервере, " +
        "написанном на самой «Сфере»: с маршрутизацией, параллельной обработкой подключений " +
        "и собственным, независимым хранилищем данных (им же посчитаны " + счётчик_html + ").</p>" +
        "<p>Смотри <a href=\"/about\">о языке</a> и <a href=\"/docs\">примеры кода</a>.</p>";
    вернуть обернуть_страницу("Сфера", содержимое, счётчик_html);
}

функция страница_о_языке(текст счётчик_html) -> текст {
    текст содержимое = "<h1>О языке</h1>" +
        "<p>«Сфера» — независимый, компилируемый язык программирования с полностью " +
        "русским синтаксисом. Не транслитерация и не игрушка поверх чужого интерпретатора — " +
        "настоящий, строго типизированный компилятор, доводящий код до машинных инструкций.</p>" +

        "<h2>Что уже умеет</h2>" +
        "<div class=\"card\">" +
        "<p><b>Автоматическое управление памятью</b> через подсчёт ссылок (ARC) — тот же " +
        "принцип, что в Swift, без пауз сборщика мусора.</p>" +
        "<p><b>Контракты и полиморфизм</b> — функция может вернуть «что-то, реализующее " +
        "контракт», не зная заранее конкретный тип.</p>" +
        "<p><b>Обобщённые типы</b> — <code>Список&lt;T&gt;</code>, <code>Словарь&lt;Ключ, Значение&gt;</code>, " +
        "в том числе как поля собственных структур.</p>" +
        "<p><b>Настоящая многопоточность</b> — <code>параллельно</code> и каналы для " +
        "обмена данными между потоками.</p>" +
        "<p><b>Графический интерфейс</b> — кнопки, панели, поля ввода поверх SDL2.</p>" +
        "<p><b>Собственное хранилище данных</b> — без единой внешней библиотеки: " +
        "именно оно считает посещения этой страницы.</p>" +
        "</div>" +

        "<h2>Честно о том, что ещё в работе</h2>" +
        "<div class=\"card\">" +
        "<p>Соло-проект одного разработчика — скорость развития такая, какая есть.</p>" +
        "<p>Нет пакетного менеджера — подключение стороннего кода пока через файлы модулей.</p>" +
        "<p>Диагностика ошибок компилятора активно дорабатывается — номера строк и " +
        "подсказки по опечаткам уже есть, но до отточенности Rust или TypeScript ещё далеко.</p>" +
        "</div>" +

        "<p>Весь код открыт: <a href=\"https://github.com/nikitosklim/Sfera\">github.com/nikitosklim/Sfera</a></p>";
    вернуть обернуть_страницу("О языке", содержимое, счётчик_html);
}

функция страница_документация(текст счётчик_html) -> текст {
    текст содержимое = "<h1>Примеры кода</h1>" +
        "<p>Несколько небольших фрагментов, показывающих, как выглядит «Сфера» на практике.</p>" +

        "<h2>Структуры и полиморфизм</h2>" +
        "<pre><code>контракт Печатаемый {\n" +
        "    функция напечатать() -> текст;\n}\n\n" +
        "структура Кот : Печатаемый {\n" +
        "    функция напечатать() -> текст {\n" +
        "        вернуть \"Мяу\";\n    }\n}</code></pre>" +

        "<h2>Обработка ошибок без исключений</h2>" +
        "<pre><code>результат&lt;целое&gt; итог = текст_в_целое(\"42\");\n" +
        "если (итог.успешно) {\n" +
        "    вывести(целое_в_текст(итог.значение));\n}</code></pre>" +

        "<h2>Многопоточность</h2>" +
        "<pre><code>параллельно {\n" +
        "    вывести(\"работает в отдельном потоке\");\n}\n" +
        "дождаться_все_потоки();</code></pre>" +

        "<h2>Собственное хранилище данных</h2>" +
        "<pre><code>подключить хранилище;\n\n" +
        "сохранить(\"данные.db\", \"имя\", \"Никита\");\n" +
        "результат&lt;текст&gt; итог = получить(\"данные.db\", \"имя\");</code></pre>" +
        "<p>Именно эта библиотека считает посещения текущей страницы.</p>" +

        "<p>Больше примеров и полная документация — в репозитории на " +
        "<a href=\"https://github.com/nikitosklim/Sfera\">GitHub</a>.</p>";
    вернуть обернуть_страницу("Примеры кода", содержимое, счётчик_html);
}

функция страница_404(текст счётчик_html) -> текст {
    текст содержимое = "<h1>404</h1><p>Такой страницы нет.</p><p><a href=\"/\">на главную</a></p>";
    вернуть обернуть_страницу("Страница не найдена", содержимое, счётчик_html);
}
