// сайт.код — страницы сайта «Сферы». Разметка лежит в отдельных файлах:
//   pages/layout.html  — общий каркас ({{заголовок}}, {{содержимое}}, {{счётчик}})
//   pages/*.html       — содержимое страниц
//   static/*           — стили и картинки
//   downloads/list.txt — список файлов для загрузки: «имя | название | описание»
//   content/<раздел>/list.txt и *.md — статьи и документация в Markdown
//
// Все пути относительные и ASCII: программу нужно запускать из папки сайта
// (на Windows fopen принимает имена в ANSI, кириллица в пути не откроется).

подключить веб;
подключить разметка;
подключить файлы;

// Собирает страницу: содержимое файла pages/<файл_страницы> вставляется в
// pages/layout.html. Дополнительные подстановки в содержимое (например {{список}})
// передаются списками имена/значения. Результат — в куче, освобождает вызывающий.
функция страница(текст заголовок, текст файл_страницы, текст счётчик_текст, Список из текстов имена_в_содержимом, Список из текстов значения_в_содержимом): текст
    результат из текста каркас = прочитать_файл("pages/layout.html");
    результат из текста содержимое = прочитать_файл("pages/" + файл_страницы);
    если ( не каркас.успешно или не содержимое.успешно)
        текст ошибка_текст = выделить_память(256);
        текст сообщение = "<h1>Ошибка</h1><p>Не найдены файлы страниц. Запускайте сервер из папки сайта.</p>";
        скопировать_память(ошибка_текст, сообщение, длина(сообщение) + 1);
        вернуть ошибка_текст;
    конец
    текст тело = подставить(содержимое.значение, имена_в_содержимом, значения_в_содержимом);

    Список из текстов имена = Список из текстов();
    Список из текстов значения = Список из текстов();
    имена.добавить("содержимое");
    значения.добавить(тело);
    имена.добавить("заголовок");
    значения.добавить(заголовок);
    имена.добавить("счётчик");
    значения.добавить(счётчик_текст);
    текст полный_заголовок = заголовок + " — язык программирования Сфера";
    текст описание = "Сфера — компилируемый язык программирования на русском: компилятор на LLVM, документация, уроки и загрузки для Windows, macOS, Linux и Android. Открытый код, лицензия MIT.";
    если (файл_страницы == "home.html")
        полный_заголовок = "Сфера — язык программирования на русском";
    иначе если (файл_страницы == "about.html")
        полный_заголовок = "О языке Сфера: программирование полностью на русском";
        описание = "О языке Сфера: зачем нужен язык программирования на русском, какие задачи он решает, чем удобен новичкам и опытным разработчикам и как устроен компилятор на Rust и LLVM.";
    иначе если (файл_страницы == "packages.html")
        полный_заголовок = "Пакеты Сферы: библиотеки для языка на русском";
        описание = "Каталог пакетов языка Сфера: библиотеки, которые ставятся одной командой сфера установить. Поиск по названию и описанию, версии и контрольные суммы.";
    иначе если (файл_страницы == "package.html")
        полный_заголовок = заголовок + " — пакет языка Сфера";
        описание = заголовок + ": пакет для языка программирования Сфера. Описание, версии и команда установки.";
    иначе если (файл_страницы == "downloads.html")
        полный_заголовок = "Скачать Сферу: компилятор для Windows, macOS, Linux и Android";
        описание = "Скачать язык программирования Сфера: установщики и панель разработчика для Windows, macOS, Linux, приложение для Android и расширение для VS Code, с контрольными суммами SHA-256.";
    иначе если (файл_страницы == "support.html")
        полный_заголовок = "Поддержать Сферу: развитие языка программирования на русском";
        описание = "Поддержать развитие языка программирования Сфера: проект с открытым кодом, который мы делаем командой. Куда идут деньги, лицензия и сотрудничество для компаний.";
    иначе если (файл_страницы == "search.html")
        полный_заголовок = "Поиск по сайту языка программирования Сфера";
    иначе если (файл_страницы == "material.html")
        полный_заголовок = заголовок + " — язык программирования Сфера";
        описание = заголовок + ": материал на сайте языка программирования Сфера — документация, уроки и примеры на русском.";
    иначе если (файл_страницы == "catalog.html")
        описание = заголовок + " — язык программирования Сфера: полный список материалов раздела с описаниями.";
        если (заголовок == "Уроки")
            полный_заголовок = "Уроки Сферы: учимся программировать на русском";
            описание = "Бесплатные уроки по языку Сфера: от первой программы до собственного веб-сервера. Пошагово, с примерами кода на русском.";
        конец
        если (заголовок == "Документация")
            полный_заголовок = "Документация Сферы: справочник языка на русском";
            описание = "Справочник по языку программирования Сфера: типы, функции, структуры, контракты, память, сеть и инструменты. Каждая тема с примерами кода.";
        конец
        если (заголовок == "Примеры")
            полный_заголовок = "Примеры программ на Сфере: готовый код на русском";
            описание = "Готовые примеры программ на языке Сфера: веб-сервер, базы данных, потоки, игры. Запускайте, меняйте и учитесь на них.";
        конец
        если (заголовок == "Статьи")
            полный_заголовок = "Статьи о Сфере: как устроен язык программирования на русском";
            описание = "Статьи о языке программирования Сфера: разборы, новости и истории разработки на Хабре и других площадках.";
        конец
    конец
    имена.добавить("полный_заголовок");
    значения.добавить(полный_заголовок);
    имена.добавить("описание");
    значения.добавить(экранировать_html(описание));
    результат из текста проверка = прочитать_файл("verification.txt");
    имена.добавить("проверка");
    если (проверка.успешно)
        значения.добавить(проверка.значение);
    иначе
        значения.добавить("");
    конец
    текст итог = подставить(каркас.значение, имена, значения);

    освободить_память(тело);
    имена.освободить();
    значения.освободить();
    вернуть итог;
конец

// ---------------------------------------------------------------- счётчик

// Счётчик без блокировок и гонок: каждое посещение дописывает ОДИН байт в файл
// visits.log, а число посещений — это размер файла. Дозапись в конец файла
// безопасна при одновременных запросах из многих потоков (хранилище с
// индексом из нескольких потоков одновременно открывать нельзя — на этом
// прежняя версия падала под нагрузкой).
функция обновить_и_показать_счётчик(): текст
    дописать_в_файл_бинарно("данные/visits.log", "x", 1);
    результат из целого размер = размер_файла("данные/visits.log");
    если ( не размер.успешно)
        вернуть "посещения не посчитаны";
    конец
    вернуть "посещение №" + целое_в_текст(размер.значение);
конец

// ---------------------------------------------------------------- загрузки

// Часть строки списка: поле номер n (с нуля), поля разделены "|", края обрезаны.
// Работает по индексам байтов, без промежуточных строк (чтобы не плодить мусор).
функция поле_строки(текст строка, целое n): текст
    целое всего = длина(строка);
    целое начало = 0;
    целое номер = 0;
    целое i = 0;
    пока (i меньше всего и номер меньше n)
        если (целое(байт_текста(строка, i)) == 124)
            номер = номер + 1;
            начало = i + 1;
        конец
        i = i + 1;
    конец
    если (номер меньше n)
        вернуть "";
    конец
    целое справа = начало;
    пока (справа меньше всего и целое(байт_текста(строка, справа)) != 124)
        справа = справа + 1;
    конец
    пока (начало меньше справа и целое(байт_текста(строка, начало)) не больше 32)
        начало = начало + 1;
    конец
    пока (справа больше начало и целое(байт_текста(строка, справа - 1)) не больше 32)
        справа = справа - 1;
    конец
    вернуть срез(строка, начало, справа - начало);
конец

// Строка списка — настоящая запись: первый значимый символ есть и это не "#".
функция строка_записи(текст строка): верно
    целое всего = длина(строка);
    целое i = 0;
    пока (i меньше всего и целое(байт_текста(строка, i)) не больше 32)
        i = i + 1;
    конец
    если (i == всего)
        вернуть нет;
    конец
    вернуть целое(байт_текста(строка, i)) != 35;
конец

// Конец строки, начинающейся с позиции «с» (индекс перевода строки или длина текста).
функция конец_строки(текст источник, целое с): целое
    целое всего = длина(источник);
    целое i = с;
    пока (i меньше всего и целое(байт_текста(источник, i)) != 10)
        i = i + 1;
    конец
    вернуть i;
конец

функция размер_текстом(целое размер): текст
    если (размер больше 1048575)
        целое десятые = (размер * 10) / 1048576;
        вернуть целое_в_текст(десятые / 10) + "," + целое_в_текст(десятые % 10) + " МБ";
    конец
    если (размер больше 1023)
        вернуть целое_в_текст(размер / 1024) + " КБ";
    конец
    вернуть целое_в_текст(размер) + " Б";
конец

// Контрольная сумма SHA-256 (64 шестнадцатеричных символа) — только если в списке
// указано корректное значение; иначе ничего не выводится.
функция сумма_html(текст сумма): текст
    если (длина(сумма) != 64)
        вернуть "";
    конец
    целое i = 0;
    пока (i меньше 64)
        целое б = целое(байт_текста(сумма, i));
        если ( не ((б не меньше 48 и б не больше 57) или (б не меньше 97 и б не больше 102)))
            вернуть "";
        конец
        i = i + 1;
    конец
    вернуть "<details class=\"сумма\"><summary>Контрольная сумма (SHA-256)</summary><code class=\"sha\">" + сумма + "</code></details>";
конец

// Файл допустим для скачивания, только если он указан в downloads/list.txt.
функция файл_в_списке(текст имя): верно
    результат из текста список = прочитать_файл("downloads/list.txt");
    если ( не список.успешно)
        вернуть нет;
    конец
    целое всего = длина(список.значение);
    целое позиция = 0;
    верно найден = нет;
    пока (позиция меньше всего и не найден)
        целое до = конец_строки(список.значение, позиция);
        текст строка = срез(список.значение, позиция, до - позиция);
        если (строка_записи(строка))
            текст первое_поле = поле_строки(строка, 0);
            если (первое_поле == имя)
                найден = да;
            конец
        конец
        позиция = до + 1;
    конец
    вернуть найден;
конец

функция список_загрузок(): текст
    результат из текста список = прочитать_файл("downloads/list.txt");
    если ( не список.успешно)
        вернуть "<p class=\"muted\">Список загрузок пока не настроен.</p>";
    конец
    текст строки_таблицы = "";
    целое всего = длина(список.значение);
    целое позиция = 0;
    пока (позиция меньше всего)
        целое до = конец_строки(список.значение, позиция);
        текст строка = срез(список.значение, позиция, до - позиция);
        позиция = до + 1;
        если (строка_записи(строка))
            текст имя = поле_строки(строка, 0);
            текст название = поле_строки(строка, 1);
            текст описание = поле_строки(строка, 2);
            текст сумма = поле_строки(строка, 3);
            результат из целого размер = размер_файла("downloads/" + имя);
            если (размер.успешно и путь_безопасен("/" + имя) и не содержит(имя, "/"))
                если (длина(название) == 0)
                    название = имя;
                конец
                текст название_html = экранировать_html(название);
                текст описание_html = экранировать_html(описание);
                строки_таблицы = строки_таблицы + "<tr><td><b>" + название_html + "</b><br><span class=\"muted\">" +
                    описание_html + "</span>" + сумма_html(сумма) + "</td><td>" + размер_текстом(размер.значение) +
                    "</td><td><a class=\"button\" href=\"/файлы/" + имя + "\">Скачать</a></td></tr>";
                освободить_память(название_html);
                освободить_память(описание_html);
            конец
        конец
    конец
    если (длина(строки_таблицы) == 0)
        вернуть "<p class=\"muted\">Файлов для загрузки пока нет.</p>";
    конец
    вернуть "<table><tr><th>Файл</th><th>Размер</th><th></th></tr>" + строки_таблицы + "</table>";
конец

// ---------------------------------------------------------------- материалы (Markdown)

// Имя материала — только латиница, цифры, «-» и «_» (оно же имя файла без .md).
функция имя_допустимо(текст имя): верно
    целое n = длина(имя);
    если (n == 0 или n больше 64)
        вернуть нет;
    конец
    целое i = 0;
    пока (i меньше n)
        целое б = целое(байт_текста(имя, i));
        верно хороший = (б не меньше 97 и б не больше 122) или (б не меньше 48 и б не больше 57) или б == 45 или б == 95;
        если ( не хороший)
            вернуть нет;
        конец
        i = i + 1;
    конец
    вернуть да;
конец

// Список материалов раздела: content/<раздел>/list.txt, строки «имя | название | описание | метка».
// Материалы без файла <имя>.md не показываются. Результат — плитки; если «по_группам»,
// метка (четвёртое поле) становится заголовком группы, иначе — значком на плитке.
функция каталог_материалов(текст раздел, верно по_группам): текст
    результат из текста список = прочитать_файл("content/" + раздел + "/list.txt");
    если ( не список.успешно)
        вернуть "<p class=\"muted\">Материалов пока нет.</p>";
    конец
    текст пункты = "";
    текст группа = "";
    целое всего = длина(список.значение);
    целое позиция = 0;
    целое штук = 0;
    пока (позиция меньше всего)
        целое до = конец_строки(список.значение, позиция);
        текст строка = срез(список.значение, позиция, до - позиция);
        позиция = до + 1;
        если (строка_записи(строка))
            текст имя = поле_строки(строка, 0);
            текст название = поле_строки(строка, 1);
            текст описание = поле_строки(строка, 2);
            текст метка = поле_строки(строка, 3);
            результат из целого размер = размер_файла("content/" + раздел + "/" + имя + ".md");
            если (размер.успешно и имя_допустимо(имя))
                если (длина(название) == 0)
                    название = имя;
                конец
                текст название_html = экранировать_html(название);
                текст описание_html = экранировать_html(описание);
                текст метка_html = экранировать_html(метка);
                если (по_группам)
                    если (штук == 0 или метка != группа)
                        если (штук больше 0)
                            пункты = пункты + "</div>";
                        конец
                        пункты = пункты + "<h2>" + метка_html + "</h2><div class=\"плитки\">";
                        группа = метка;
                    конец
                    пункты = пункты + "<a class=\"плитка\" href=\"" + адрес_материала(раздел, имя) + "\"><b>" +
                        название_html + "</b><span>" + описание_html + "</span></a>";
                иначе
                    если (штук == 0)
                        пункты = пункты + "<div class=\"плитки\">";
                    конец
                    пункты = пункты + "<a class=\"плитка\" href=\"" + адрес_материала(раздел, имя) + "\">";
                    если (длина(метка) больше 0)
                        пункты = пункты + "<em>" + метка_html + "</em>";
                    конец
                    пункты = пункты + "<b>" + название_html + "</b><span>" + описание_html + "</span></a>";
                конец
                штук = штук + 1;
                освободить_память(название_html);
                освободить_память(описание_html);
                освободить_память(метка_html);
            конец
        конец
    конец
    если (штук == 0)
        вернуть "<p class=\"muted\">Материалов пока нет.</p>";
    конец
    вернуть пункты + "</div>";
конец

// Поисковый индекс: все материалы одним текстом. Запись: «адрес, название, раздел, текст»;
// поля разделяет строка ПОЛЕ, записи — строка КОНЕЦ (экранировать ничего не нужно).
функция индекс_раздела(текст раздел, текст название_раздела): текст
    результат из текста список = прочитать_файл("content/" + раздел + "/list.txt");
    если ( не список.успешно)
        вернуть "";
    конец
    текст итог = "";
    целое всего = длина(список.значение);
    целое позиция = 0;
    пока (позиция меньше всего)
        целое до = конец_строки(список.значение, позиция);
        текст строка = срез(список.значение, позиция, до - позиция);
        позиция = до + 1;
        если (строка_записи(строка))
            текст имя = поле_строки(строка, 0);
            текст название = поле_строки(строка, 1);
