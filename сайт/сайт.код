// Система определяется по имени файла: windows / macos / linux / android / vscode / прочее.
функция платформа_файла(текст имя): текст
    текст м = регистр_в_нижний(имя);
    если (содержит(м, ".vsix"))
        вернуть "vscode";
    конец
    если (содержит(м, "android") или содержит(м, ".apk"))
        вернуть "android";
    конец
    если (содержит(м, "mac") или содержит(м, "darwin") или содержит(м, ".dmg") или содержит(м, ".pkg"))
        вернуть "macos";
    конец
    если (содержит(м, "win") или содержит(м, ".exe") или содержит(м, ".msi") или содержит(м, ".nsi"))
        вернуть "windows";
    конец
    если (содержит(м, "linux") или содержит(м, ".deb") или содержит(м, ".rpm") или содержит(м, "appimage"))
        вернуть "linux";
    конец
    вернуть "прочее";
конец

функция цифра_на(текст имя, целое позиция): верно
    если (позиция меньше 0 или позиция не меньше длина(имя))
        вернуть нет;
    конец
    целое б = целое(байт_текста(имя, позиция));
    вернуть б не меньше 48 и б не больше 57;
конец

// Первая версия вида X.Y или X.Y.Z в имени файла («sfera-0.3.3-windows.zip» → «0.3.3»), иначе пусто.
функция версия_файла(текст имя): текст
    целое n = длина(имя);
    целое i = 0;
    пока (i меньше n)
        если (цифра_на(имя, i))
            целое j = i;
            целое точек = 0;
            верно идём = да;
            пока (идём)
                если (цифра_на(имя, j))
                    j = j + 1;
                иначе
                    если (j меньше n и цифра_на(имя, j + 1))
                        если (целое(байт_текста(имя, j)) == 46)
                            точек = точек + 1;
                            j = j + 1;
                        иначе
                            идём = нет;
                        конец
                    иначе
                        идём = нет;
                    конец
                конец
            конец
            если (точек больше 0)
                вернуть срез(имя, i, j - i);
            конец
            i = j;
        иначе
            i = i + 1;
        конец
    конец
    вернуть "";
конец

