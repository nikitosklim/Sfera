// Имя файла для загрузки: латиница, цифры, «.», «_», «-»; не начинается с точки.
функция имя_загрузки_допустимо(текст имя): верно
    целое n = длина(имя);
    если (n == 0 или n больше 100 или целое(байт_текста(имя, 0)) == 46 или содержит(имя, ".."))
        вернуть нет;
    конец
    целое i = 0;
    пока (i меньше n)
        целое б = целое(байт_текста(имя, i));
        верно хороший = (б не меньше 97 и б не больше 122) или (б не меньше 65 и б не больше 90) или (б не меньше 48 и б не больше 57) или б == 45 или б == 95 или б == 46;
        если ( не хороший)
            вернуть нет;
        конец
        i = i + 1;
    конец
    вернуть да;
конец

// Поле списка не должно ломать формат «имя | название | описание | сумма».
функция очистить_поле(текст значение): текст
    текст а = заменить(значение, "|", "/");
    текст б = заменить(а, "\r", " ");
    вернуть заменить(б, "\n", " ");
