// проводник.код — API для программы-проводника: список файлов на сервере,
// сведения о сервере и скачивание. Всё только по токену администратора
// (тому же, что и загрузка файлов: admin-token.txt, заголовок Authorization: Bearer …).
//
//   GET /api/файлы?путь=папка/вложенная   — список: {"путь":"…","записи":[{"имя","папка","размер","изменён"},…]}
//   GET /api/сервер                      — параметры компьютера (память, процессор, ОС, диск, время работы…)
//   PUT /api/загрузить?путь=папка/файл.zip — принять файл в тело запроса (409, если такой уже есть)
//   GET /api/скачать?путь=папка/файл.zip  — отдать файл (с докачкой Range, как обычные загрузки)
//   GET /api/поиск?путь=папка&q=текст      — найти по части имени в папке и глубже (до 250 совпадений)
//   POST /api/удалить?путь=…[&рекурсивно=1] — удалить файл или папку (непустую — только с рекурсивно=1)
//   POST /api/переместить?путь=…&в=…        — переименовать или перенести (в — новый путь целиком; 409, если занято)
//   POST /api/папка?путь=…                  — создать папку
//   /api/файлы понимает ещё «сорт» (0 имя↑, 1 имя↓, 2 размер↓, 3 размер↑, 4 дата↓, 5 дата↑; папки всегда сверху).
//   PUT /api/загрузить с «перезаписать=1» заменяет существующий файл (так сохраняет правка в окне).
//
// Корень проводника — папка, указанная первой строкой в файле проводник-корень.txt
// рядом с сервером; нет файла — папка downloads. Выйти за пределы корня нельзя: пути с
// «..», обратной косой чертой, двоеточием и двойным слэшем отклоняются.
//
// Обычный режим: скрытые файлы (имя с точки) и недокачанные «.part» не показываются.
// Полный доступ: в проводник-корень.txt написан «/» — виден весь диск сервера, включая
// скрытые файлы и системные папки, и ровно столько прав, сколько у процесса сервера
// (под root — вообще всё). Токен администратора тогда равен доступу к компьютеру.

подключить веб;
подключить система;
подключить зос;
подключить сайт;

неизменно целое ПРОВОДНИК_НА_СТРАНИЦЕ = 250;

// Цифры с нулями слева до нужной ширины.
функция проводник_нули(целое число, целое ширина): текст
    текст т = целое_в_текст(число);
    пока (длина(т) меньше ширина)
        т = "0" + т;
    конец
    вернуть т;
конец

функция проводник_корень(): текст
    результат из текста файл = прочитать_файл("проводник-корень.txt");
    если (файл.успешно)
        текст строка = обрезать_края(файл.значение);
        если (длина(строка) больше 0 и не содержит(строка, ".."))
            вернуть строка;
        конец
    конец
    вернуть "downloads";
конец

// Путь внутри корня: без «..», «\», «:», «//»; ведущий «/» допускается и отбрасывается.
функция проводник_путь_допустим(текст путь): верно
    если (содержит(путь, "..") или содержит(путь, "\\") или содержит(путь, ":") или содержит(путь, "//"))
        вернуть нет;
    конец
    вернуть да;
конец

функция проводник_без_слэшей_по_краям(текст путь): текст
    текст итог = путь;
    пока (длина(итог) больше 0 и целое(байт_текста(итог, 0)) == 47)
        итог = срез(итог, 1, длина(итог) - 1);
    конец
    пока (длина(итог) больше 0 и целое(байт_текста(итог, длина(итог) - 1)) == 47)
        итог = срез(итог, 0, длина(итог) - 1);
    конец
    вернуть итог;
конец

// Режим полного доступа: корень — вся файловая система.
функция проводник_полный_доступ(текст корень): верно
    вернуть корень == "/";
конец

// Путь на диске: корень + «/» + путь (для корня «/» без двойного слэша).
функция проводник_на_диске(текст корень, текст путь): текст
    если (проводник_полный_доступ(корень))
        вернуть "/" + путь;
    конец
    если (длина(путь) == 0)
        вернуть корень;
    конец
    вернуть корень + "/" + путь;
конец

функция проводник_скрыто(текст имя, текст корень): верно
    если (длина(имя) == 0 или имя == "." или имя == "..")
        вернуть да;
    конец
    если (проводник_полный_доступ(корень))
        вернуть нет;
    конец
    если (целое(байт_текста(имя, 0)) == 46)
        вернуть да;
    конец
    вернуть оканчивается_на(имя, ".part");
конец

// Устройства и счётчики ядра отдаются потоком без конца: их скачивать нельзя.
функция проводник_не_скачивать(текст путь): верно
    вернуть проводник_в_папке(путь, "dev") или проводник_в_папке(путь, "proc") или проводник_в_папке(путь, "sys");
конец

// Путь лежит в папке с таким именем (или это она сама).
функция проводник_в_папке(текст путь, текст папка): верно
    если (путь == папка)
        вернуть да;
    конец
    если (длина(путь) больше длина(папка))
        вернуть срез(путь, 0, длина(папка) + 1) == папка + "/";
    конец
    вернуть нет;
конец

// ---------- сортировка и поиск ----------
// Порядок записей: папки сверху, затем по режиму (0 имя↑, 1 имя↓, 2 размер↓, 3 размер↑, 4 дата↓, 5 дата↑).
функция проводник_раньше(Список из ЗаписьПапки з, Список из текстов низ, целое а, целое б, целое режим): верно
    ЗаписьПапки а1 = з.получить(а);
    ЗаписьПапки б1 = з.получить(б);
    если (а1.папка и не б1.папка)
        вернуть да;
    конец
    если (б1.папка и не а1.папка)
        вернуть нет;
    конец
    целое итог = 0;
    если (режим == 2 или режим == 3)
        если (а1.размер != б1.размер)
            итог = 1;
            если (а1.размер больше б1.размер)
                итог = 0 - 1;
            конец
            если (режим == 3)
                итог = 0 - итог;
            конец
        конец
    иначе если (режим == 4 или режим == 5)
        если (а1.изменён != б1.изменён)
            итог = 1;
            если (а1.изменён больше б1.изменён)
                итог = 0 - 1;
            конец
            если (режим == 5)
                итог = 0 - итог;
            конец
        конец
    иначе
        итог = система_сравнить(низ.получить(а), низ.получить(б));
        если (режим == 1)
            итог = 0 - итог;
        конец
    конец
    если (итог == 0)
        итог = система_сравнить(а1.имя, б1.имя);
    конец
    вернуть итог меньше 0;
конец

// Устойчивая сортировка слиянием списка номеров.
функция проводник_сортировать(Список из ЗаписьПапки з, Список из текстов низ, Список из целых порядок, целое режим): целое
    целое н = порядок.размер();
    Список из целых буфер = Список из целых();
    целое i = 0;
    пока (i меньше н)
        буфер.добавить(0);
        i = i + 1;
    конец
    целое ширина = 1;
    пока (ширина меньше н)
        целое левый = 0;
        пока (левый меньше н)
            целое середина = левый + ширина;
            если (середина больше н)
                середина = н;
            конец
            целое правый = левый + ширина * 2;
            если (правый больше н)
                правый = н;
            конец
            целое а = левый;
            целое б = середина;
            целое к = левый;
            пока (а меньше середина или б меньше правый)
                верно берём_б = нет;
                если (а не меньше середина)
                    берём_б = да;
                иначе если (б меньше правый)
                    берём_б = проводник_раньше(з, низ, порядок.получить(б), порядок.получить(а), режим);
                конец
                если (берём_б)
                    буфер.установить(к, порядок.получить(б));
                    б = б + 1;
                иначе
                    буфер.установить(к, порядок.получить(а));
                    а = а + 1;
                конец
                к = к + 1;
            конец
            целое м = левый;
            пока (м меньше правый)
                порядок.установить(м, буфер.получить(м));
                м = м + 1;
            конец
            левый = левый + ширина * 2;
        конец
        ширина = ширина * 2;
    конец
    вернуть 0;
конец

// Поиск по части имени, сначала вширь (ближние папки раньше дальних). Результат: относительные пути
// в «имена» и по три числа на каждый (папка, размер, дата) в «числа».
функция проводник_искать(текст корень, текст начало, текст запрос, Список из текстов имена, Список из целых числа): целое
    Список из текстов очередь = Список из текстов();
    Список из целых глубины = Список из целых();
    очередь.добавить(начало);
    глубины.добавить(0);
    целое просмотрено = 0;
    целое й = 0;
    пока (й меньше очередь.размер() и имена.размер() меньше ПРОВОДНИК_НА_СТРАНИЦЕ и просмотрено меньше 200000)
        текст папка = срез(очередь.получить(й), 0, длина(очередь.получить(й)));
        целое глубина = глубины.получить(й);
        результат из Список из ЗаписьПапки список = список_папки(проводник_на_диске(корень, папка));
        если (список.успешно)
            Список из ЗаписьПапки записи = список.значение;
            целое i = 0;
            пока (i меньше записи.размер() и имена.размер() меньше ПРОВОДНИК_НА_СТРАНИЦЕ)
                ЗаписьПапки е = записи.получить(i);
                просмотрено = просмотрено + 1;
                если ( не проводник_скрыто(е.имя, корень))
                    текст путь_е = срез(е.имя, 0, длина(е.имя));
                    если (длина(папка) больше 0)
                        путь_е = папка + "/" + е.имя;
                    конец
                    если (содержит(регистр_в_нижний(е.имя), запрос) и длина(путь_е) меньше 900)
                        имена.добавить(путь_е);
                        если (е.папка)
                            числа.добавить(1);
                        иначе
                            числа.добавить(0);
                        конец
                        числа.добавить(е.размер);
                        числа.добавить(е.изменён);
                    конец
                    если (е.папка и глубина меньше 12 и не (проводник_полный_доступ(корень) и глубина == 0 и проводник_не_скачивать(е.имя)))
                        очередь.добавить(путь_е);
                        глубины.добавить(глубина + 1);
                    конец
                конец
                i = i + 1;
            конец
        конец
        й = й + 1;
    конец
    вернуть 0;
конец

// Кавычки для оболочки: ' → '\''.
функция проводник_в_кавычках(текст с): текст
    текст итог = "";
    целое п = 0;
    пока (п меньше длина(с))
        результат из текста один = подстрока(с, п, 1);
        если (один.успешно и один.значение == "'")
            итог = итог + "'\\''";
        иначе если (один.успешно)
            итог = итог + один.значение;
        конец
        п = п + 1;
    конец
    вернуть "'" + итог + "'";
конец

// Последняя часть пути.
функция проводник_имя(текст путь): текст
    целое k = длина(путь) - 1;
    пока (k не меньше 0 и целое(байт_текста(путь, k)) != 47)
        k = k - 1;
    конец
    если (k меньше 0)
        вернуть срез(путь, 0, длина(путь));
    конец
    вернуть срез(путь, k + 1, длина(путь) - k - 1);
конец

// Папка, в которой лежит путь («» — корень).
функция проводник_родитель(текст путь): текст
    целое k = длина(путь) - 1;
    пока (k не меньше 0 и целое(байт_текста(путь, k)) != 47)
        k = k - 1;
    конец
    если (k меньше 0)
        вернуть "";
    конец
    вернуть срез(путь, 0, k);
конец

функция проводник_отказ(целое32 клиент, целое код, текст причина): целое
    вернуть ответ_зос(клиент, код, "{\"ok\":false,\"ошибка\":" + зос_в_кавычках(причина) + "}");
конец

// POST /api/удалить, /api/переместить, /api/папка
функция изменить_в_проводнике(целое32 клиент, Запрос з, текст остаток): целое
    если ( не авторизован(з))
        вернуть проводник_отказ(клиент, 401, "нет доступа: неверный токен");
    конец
    текст корень = проводник_корень();
    текст путь = проводник_без_слэшей_по_краям(параметр(з.параметры, "путь"));
    если (длина(путь) == 0 или не проводник_путь_допустим(путь))
        вернуть проводник_отказ(клиент, 400, "недопустимый путь");
    конец
    // Верхний уровень системы (/etc, /usr, /home…) не удаляем и не переименовываем.
    если (проводник_полный_доступ(корень) и не содержит(путь, "/") и (остаток == "удалить" или остаток == "переместить"))
        вернуть проводник_отказ(клиент, 403, "папки верхнего уровня системы защищены");
    конец
    текст имя = проводник_имя(путь);
    если (проводник_скрыто(имя, корень))
        вернуть проводник_отказ(клиент, 400, "недопустимое имя");
    конец
    текст полный = проводник_на_диске(корень, путь);

    если (остаток == "папка")
        если (длина(имя) больше 200)
            вернуть проводник_отказ(клиент, 400, "слишком длинное имя");
        конец
        если ( не это_папка(проводник_на_диске(корень, проводник_родитель(путь))))
            вернуть проводник_отказ(клиент, 404, "папка, где создаём, не найдена");
        конец
        результат из целого есть = размер_файла(полный);
        если (есть.успешно или это_папка(полный))
            вернуть проводник_отказ(клиент, 409, "такое имя уже занято");
        конец
        результат из верного готово = создать_папку(полный);
        если ( не готово.успешно)
            вернуть проводник_отказ(клиент, 500, "не удалось создать папку");
        конец
        вернуть ответ_зос(клиент, 200, "{\"ok\":true}");
    конец

    если (остаток == "удалить")
        верно папка = это_папка(полный);
        результат из целого есть = размер_файла(полный);
        если ( не папка и не есть.успешно)
            вернуть проводник_отказ(клиент, 404, "не найдено");
        конец
        если (папка и параметр(з.параметры, "рекурсивно") == "1")
            выполнить_команду("rm -rf -- " + проводник_в_кавычках(полный));
        иначе
            результат из верного готово = удалить_файл(полный);
            если ( не готово.успешно)
                если (папка)
                    вернуть проводник_отказ(клиент, 409, "папка не пуста");
                конец
                вернуть проводник_отказ(клиент, 500, "не удалось удалить");
            конец
        конец
        результат из целого осталось = размер_файла(полный);
        если (осталось.успешно или это_папка(полный))
            вернуть проводник_отказ(клиент, 500, "не удалось удалить");
        конец
        вернуть ответ_зос(клиент, 200, "{\"ok\":true}");
    конец

    если (остаток == "переместить")
        текст куда = проводник_без_слэшей_по_краям(параметр(з.параметры, "в"));
        если (длина(куда) == 0 или не проводник_путь_допустим(куда))
            вернуть проводник_отказ(клиент, 400, "недопустимый новый путь");
        конец
        если (проводник_полный_доступ(корень) и не содержит(куда, "/"))
            вернуть проводник_отказ(клиент, 403, "в верхний уровень системы переносить нельзя");
        конец
        текст имя_нового = проводник_имя(куда);
        если (проводник_скрыто(имя_нового, корень) или длина(имя_нового) больше 200)
            вернуть проводник_отказ(клиент, 400, "недопустимое новое имя");
        конец
        если (куда == путь)
            вернуть проводник_отказ(клиент, 400, "новый путь совпадает со старым");
        конец
        если (длина(куда) больше длина(путь) и срез(куда, 0, длина(путь) + 1) == путь + "/")
            вернуть проводник_отказ(клиент, 400, "нельзя перенести папку внутрь самой себя");
        конец
        результат из целого есть_откуда = размер_файла(полный);
        если ( не есть_откуда.успешно и не это_папка(полный))
            вернуть проводник_отказ(клиент, 404, "не найдено");
        конец
        текст полный_куда = проводник_на_диске(корень, куда);
        если ( не это_папка(проводник_на_диске(корень, проводник_родитель(куда))))
            вернуть проводник_отказ(клиент, 404, "папка назначения не найдена");
        конец
        результат из целого занято = размер_файла(полный_куда);
        если (занято.успешно или это_папка(полный_куда))
            вернуть проводник_отказ(клиент, 409, "такое имя уже занято");
        конец
        результат из верного перенесено = переименовать_файл(полный, полный_куда);
        если ( не перенесено.успешно)
            // Другой раздел диска: rename не справится, mv умеет копировать.
            выполнить_команду("mv -n -- " + проводник_в_кавычках(полный) + " " + проводник_в_кавычках(полный_куда));
        конец
        результат из целого проверка = размер_файла(полный_куда);
        если ( не проверка.успешно и не это_папка(полный_куда))
            вернуть проводник_отказ(клиент, 500, "не удалось переместить");
        конец
        вернуть ответ_зос(клиент, 200, "{\"ok\":true}");
    конец

    вернуть проводник_отказ(клиент, 404, "неизвестный запрос");
конец

функция обработать_проводник(целое32 клиент, Запрос з, текст остаток): целое
    если ( не авторизован(з))
        вернуть ответ_зос(клиент, 401, "{\"ok\":false,\"ошибка\":\"нет доступа: неверный токен\"}");
    конец
    текст корень = проводник_корень();
    текст путь = проводник_без_слэшей_по_краям(параметр(з.параметры, "путь"));
    если ( не проводник_путь_допустим(путь))
        вернуть ответ_зос(клиент, 400, "{\"ok\":false,\"ошибка\":\"недопустимый путь\"}");
    конец
    текст полный = проводник_на_диске(корень, путь);

    если (остаток == "сервер")
        вернуть ответ_зос(клиент, 200, сведения_о_системе(корень));
    конец

    если (остаток == "файлы")
        результат из Список из ЗаписьПапки список = список_папки(полный);
        если ( не список.успешно)
            вернуть ответ_зос(клиент, 404, "{\"ok\":false,\"ошибка\":\"папка не найдена\"}");
        конец
        Список из ЗаписьПапки записи = список.значение;
        // Большие папки (/usr/bin, /proc…) отдаём страницами по 250 записей: параметр «стр» (с нуля).
        целое страница = 0;
        результат из целого стр = текст_в_целое(параметр(з.параметры, "стр"));
        если (стр.успешно и стр.значение больше 0)
            страница = стр.значение;
        конец
        целое режим = 0;
        результат из целого сорт = текст_в_целое(параметр(з.параметры, "сорт"));
        если (сорт.успешно и сорт.значение больше 0 и сорт.значение меньше 6)
            режим = сорт.значение;
        конец
        целое с_номера = страница * ПРОВОДНИК_НА_СТРАНИЦЕ;
        верно компакт = параметр(з.параметры, "формат") == "2";
        Список из текстов низ = Список из текстов();
        Список из целых порядок = Список из целых();
        целое n0 = 0;
        пока (n0 меньше записи.размер())
            ЗаписьПапки з0 = записи.получить(n0);
            низ.добавить(регистр_в_нижний(з0.имя));
            если ( не проводник_скрыто(з0.имя, корень))
                порядок.добавить(n0);
            конец
            n0 = n0 + 1;
        конец
        проводник_сортировать(записи, низ, порядок, режим);
        целое всего = порядок.размер();
        текст элементы = "";
        целое показано = 0;
        целое i = с_номера;
        пока (i меньше всего и показано меньше ПРОВОДНИК_НА_СТРАНИЦЕ)
            ЗаписьПапки з1 = записи.получить(порядок.получить(i));
            если (компакт)
                // Запись фиксированной ширины: папка(1) размер(12) изменён(12) длина имени(3) имя.
                целое признак = 0;
                если (з1.папка)
                    признак = 1;
                конец
                целое размер_з = з1.размер;
                если (размер_з меньше 0)
                    размер_з = 0;
                конец
                целое дата_з = з1.изменён;
                если (дата_з меньше 0)
                    дата_з = 0;
                конец
                элементы = элементы + целое_в_текст(признак) + проводник_нули(размер_з, 12) + проводник_нули(дата_з, 12) + проводник_нули(длина(з1.имя), 3) + з1.имя;
            иначе
                текст пары = зос_пара_текст("имя", з1.имя) + "," + зос_пара_логическое("папка", з1.папка);
                пары = пары + "," + зос_пара_целое("размер", з1.размер) + "," + зос_пара_целое("изменён", з1.изменён);
                если (показано больше 0)
                    элементы = элементы + ",";
                конец
                элементы = элементы + зос_объект(пары);
            конец
            показано = показано + 1;
            i = i + 1;
        конец
        если (компакт)
            вернуть ответ_зос(клиент, 200, "СПИСОК1" + проводник_нули(всего, 10) + проводник_нули(показано, 10) + элементы);
        конец
        текст тело = зос_объект(зос_пара_текст("путь", путь) + "," + зос_пара_целое("всего", всего) + "," + зос_пара("записи", зос_массив(элементы)));
        вернуть ответ_зос(клиент, 200, тело);
    конец

    если (остаток == "поиск")
        текст запрос = регистр_в_нижний(обрезать_края(параметр(з.параметры, "q")));
        если (длина(запрос) == 0)
            вернуть ответ_зос(клиент, 400, "{\"ok\":false,\"ошибка\":\"пустой запрос\"}");
        конец
        если ( не это_папка(полный))
            вернуть ответ_зос(клиент, 404, "{\"ok\":false,\"ошибка\":\"папка не найдена\"}");
        конец
        Список из текстов найдено = Список из текстов();
        Список из целых числа = Список из целых();
        проводник_искать(корень, путь, запрос, найдено, числа);
        // Пути в ответе — относительно папки, где искали.
        целое срезать = 0;
        если (длина(путь) больше 0)
            срезать = длина(путь) + 1;
        конец
        текст записи_п = "";
        целое й = 0;
        пока (й меньше найдено.размер())
            текст от_папки = срез(найдено.получить(й), срезать, длина(найдено.получить(й)) - срезать);
            целое размер_п = числа.получить(й * 3 + 1);
            если (размер_п меньше 0)
                размер_п = 0;
            конец
            целое дата_п = числа.получить(й * 3 + 2);
            если (дата_п меньше 0)
                дата_п = 0;
            конец
            записи_п = записи_п + целое_в_текст(числа.получить(й * 3)) + проводник_нули(размер_п, 12) + проводник_нули(дата_п, 12) + проводник_нули(длина(от_папки), 3) + от_папки;
            й = й + 1;
        конец
        вернуть ответ_зос(клиент, 200, "СПИСОК1" + проводник_нули(найдено.размер(), 10) + проводник_нули(найдено.размер(), 10) + записи_п);
    конец

    если (остаток == "скачать")
        если (длина(путь) == 0)
            вернуть ответ_зос(клиент, 400, "{\"ok\":false,\"ошибка\":\"не указан файл\"}");
        конец
        если (это_папка(полный))
            вернуть ответ_зос(клиент, 400, "{\"ok\":false,\"ошибка\":\"это папка, а не файл\"}");
        конец
        если (проводник_полный_доступ(корень) и проводник_не_скачивать(путь))
            вернуть ответ_зос(клиент, 400, "{\"ok\":false,\"ошибка\":\"системный файл ядра скачать нельзя\"}");
        конец
        результат из целого размер = размер_файла(полный);
        если ( не размер.успешно)
            вернуть ответ_зос(клиент, 404, "{\"ok\":false,\"ошибка\":\"файл не найден\"}");
        конец
        текст имя = путь;
        целое k = длина(путь) - 1;
        пока (k не меньше 0 и целое(байт_текста(путь, k)) != 47)
            k = k - 1;
        конец
        если (k не меньше 0)
            имя = срез(путь, k + 1, длина(путь) - k - 1);
        конец
        ответ_файлом_для(клиент, з, полный, имя, да, "no-store");
        вернуть 0;
    конец

    вернуть ответ_зос(клиент, 404, "{\"ok\":false,\"ошибка\":\"неизвестный запрос\"}");
конец

// PUT /api/загрузить?путь=папка/имя — кладёт тело запроса в файл. Существующий файл не перезаписывает (409),
// родительская папка должна быть. Пишет во временный «.part» и переименовывает, поэтому недокачанный файл не виден.
функция загрузить_в_проводник(целое32 клиент, Запрос з): целое
    если ( не авторизован(з))
        вернуть ответ_зос(клиент, 401, "{\"ok\":false,\"ошибка\":\"нет доступа: неверный токен\"}");
    конец
    текст путь = проводник_без_слэшей_по_краям(параметр(з.параметры, "путь"));
    если (длина(путь) == 0 или не проводник_путь_допустим(путь))
        вернуть ответ_зос(клиент, 400, "{\"ok\":false,\"ошибка\":\"недопустимый путь\"}");
    конец
    текст имя = путь;
    текст папка = "";
    целое k = длина(путь) - 1;
    пока (k не меньше 0 и целое(байт_текста(путь, k)) != 47)
        k = k - 1;
    конец
    если (k не меньше 0)
        имя = срез(путь, k + 1, длина(путь) - k - 1);
        папка = срез(путь, 0, k);
    конец
    текст корень = проводник_корень();
    если (проводник_скрыто(имя, корень) или оканчивается_на(имя, ".part") или длина(имя) больше 200)
        вернуть ответ_зос(клиент, 400, "{\"ok\":false,\"ошибка\":\"недопустимое имя файла\"}");
    конец
    текст полная_папка = проводник_на_диске(корень, папка);
    если ( не это_папка(полная_папка))
        вернуть ответ_зос(клиент, 404, "{\"ok\":false,\"ошибка\":\"папка не найдена\"}");
    конец
    текст полный = проводник_на_диске(корень, путь);
    результат из целого есть = размер_файла(полный);
    верно заменять = параметр(з.параметры, "перезаписать") == "1";
    если (это_папка(полный) или (есть.успешно и не заменять))
        вернуть ответ_зос(клиент, 409, "{\"ok\":false,\"ошибка\":\"такой файл уже есть\"}");
    конец
    результат из целого длина_тела = текст_в_целое(заголовок(з, "Content-Length"));
    если ( не длина_тела.успешно или длина_тела.значение меньше 0)
        вернуть ответ_зос(клиент, 400, "{\"ok\":false,\"ошибка\":\"нужен заголовок Content-Length\"}");
    конец
    если (длина_тела.значение больше 2147483648)
        вернуть ответ_зос(клиент, 413, "{\"ok\":false,\"ошибка\":\"файл больше 2 ГБ\"}");
    конец
    текст временный = полный + ".part";
    результат из целого принято = принять_тело_в_файл(клиент, временный, длина_тела.значение);
    если ( не принято.успешно)
        вернуть ответ_зос(клиент, 400, "{\"ok\":false,\"ошибка\":" + зос_в_кавычках(принято.сообщение) + "}");
    конец
    результат из верного готово = переименовать_файл(временный, полный);
    если ( не готово.успешно)
        вернуть ответ_зос(клиент, 500, "{\"ok\":false,\"ошибка\":\"не удалось сохранить файл\"}");
    конец
    вернуть ответ_зос(клиент, 201, "{\"ok\":true,\"имя\":" + зос_в_кавычках(имя) + ",\"размер\":" + целое_в_текст(длина_тела.значение) + "}");
конец
