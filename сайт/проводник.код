// проводник.код — API для программы-проводника: список файлов на сервере,
// сведения о сервере и скачивание. Всё только по токену администратора
// (тому же, что и загрузка файлов: admin-token.txt, заголовок Authorization: Bearer …).
//
//   GET /api/файлы?путь=папка/вложенная   — список: {"путь":"…","записи":[{"имя","папка","размер","изменён"},…]}
//   GET /api/сервер                      — параметры компьютера (память, процессор, ОС, диск, время работы…)
//   PUT /api/загрузить?путь=папка/файл.zip — принять файл в тело запроса (409, если такой уже есть)
//   GET /api/скачать?путь=папка/файл.zip  — отдать файл (с докачкой Range, как обычные загрузки)
//
// Корень проводника — папка, указанная первой строкой в файле проводник-корень.txt
// рядом с сервером; нет файла — папка downloads. Выйти за пределы корня нельзя: пути с
// «..», обратной косой чертой, двоеточием и двойным слэшем отклоняются.
//
// Обычный режим: скрытые файлы (имя с точки) и недокачанные «.part» не показываются.
// Полный доступ: в проводник-корень.txt написан «/» — виден весь диск сервера, включая
// скрытые файлы и системные папки, и ровно столько прав, сколько у процесса сервера
// (под root — вообще всё). Токен администратора тогда равен доступу к компьютеру.

подключить веб;
подключить система;
подключить зос;
подключить сайт;

неизменно целое ПРОВОДНИК_НА_СТРАНИЦЕ = 250;

// Цифры с нулями слева до нужной ширины.
функция проводник_нули(целое число, целое ширина): текст
    текст т = целое_в_текст(число);
    пока (длина(т) меньше ширина)
        т = "0" + т;
    конец
    вернуть т;
конец

функция проводник_корень(): текст
    результат из текста файл = прочитать_файл("проводник-корень.txt");
    если (файл.успешно)
        текст строка = обрезать_края(файл.значение);
        если (длина(строка) больше 0 и не содержит(строка, ".."))
            вернуть строка;
        конец
    конец
    вернуть "downloads";
конец

// Путь внутри корня: без «..», «\», «:», «//»; ведущий «/» допускается и отбрасывается.
функция проводник_путь_допустим(текст путь): верно
    если (содержит(путь, "..") или содержит(путь, "\\") или содержит(путь, ":") или содержит(путь, "//"))
        вернуть нет;
    конец
    вернуть да;
конец

функция проводник_без_слэшей_по_краям(текст путь): текст
    текст итог = путь;
    пока (длина(итог) больше 0 и целое(байт_текста(итог, 0)) == 47)
        итог = срез(итог, 1, длина(итог) - 1);
    конец
    пока (длина(итог) больше 0 и целое(байт_текста(итог, длина(итог) - 1)) == 47)
        итог = срез(итог, 0, длина(итог) - 1);
    конец
    вернуть итог;
конец

// Режим полного доступа: корень — вся файловая система.
функция проводник_полный_доступ(текст корень): верно
    вернуть корень == "/";
конец

// Путь на диске: корень + «/» + путь (для корня «/» без двойного слэша).
функция проводник_на_диске(текст корень, текст путь): текст
    если (проводник_полный_доступ(корень))
        вернуть "/" + путь;
    конец
    если (длина(путь) == 0)
        вернуть корень;
    конец
    вернуть корень + "/" + путь;
конец

функция проводник_скрыто(текст имя, текст корень): верно
    если (длина(имя) == 0 или имя == "." или имя == "..")
        вернуть да;
    конец
    если (проводник_полный_доступ(корень))
        вернуть нет;
    конец
    если (целое(байт_текста(имя, 0)) == 46)
        вернуть да;
    конец
    вернуть оканчивается_на(имя, ".part");
конец

// Устройства и счётчики ядра отдаются потоком без конца: их скачивать нельзя.
функция проводник_не_скачивать(текст путь): верно
    вернуть проводник_в_папке(путь, "dev") или проводник_в_папке(путь, "proc") или проводник_в_папке(путь, "sys");
конец

// Путь лежит в папке с таким именем (или это она сама).
функция проводник_в_папке(текст путь, текст папка): верно
    если (путь == папка)
        вернуть да;
    конец
    если (длина(путь) больше длина(папка))
        вернуть срез(путь, 0, длина(папка) + 1) == папка + "/";
    конец
    вернуть нет;
конец

функция обработать_проводник(целое32 клиент, Запрос з, текст остаток): целое
    если ( не авторизован(з))
        вернуть ответ_зос(клиент, 401, "{\"ok\":false,\"ошибка\":\"нет доступа: неверный токен\"}");
    конец
    текст корень = проводник_корень();
    текст путь = проводник_без_слэшей_по_краям(параметр(з.параметры, "путь"));
    если ( не проводник_путь_допустим(путь))
        вернуть ответ_зос(клиент, 400, "{\"ok\":false,\"ошибка\":\"недопустимый путь\"}");
    конец
    текст полный = проводник_на_диске(корень, путь);

    если (остаток == "сервер")
        вернуть ответ_зос(клиент, 200, сведения_о_системе(корень));
    конец

    если (остаток == "файлы")
        результат из Список из ЗаписьПапки список = список_папки(полный);
        если ( не список.успешно)
            вернуть ответ_зос(клиент, 404, "{\"ok\":false,\"ошибка\":\"папка не найдена\"}");
        конец
        Список из ЗаписьПапки записи = список.значение;
        // Большие папки (/usr/bin, /proc…) отдаём страницами по 250 записей: параметр «стр» (с нуля).
        целое страница = 0;
        результат из целого стр = текст_в_целое(параметр(з.параметры, "стр"));
        если (стр.успешно и стр.значение больше 0)
            страница = стр.значение;
        конец
        целое с_номера = страница * ПРОВОДНИК_НА_СТРАНИЦЕ;
        верно компакт = параметр(з.параметры, "формат") == "2";
        текст элементы = "";
        целое i = 0;
        целое показано = 0;
        целое всего = 0;
        пока (i меньше записи.размер())
            ЗаписьПапки з1 = записи.получить(i);
            если ( не проводник_скрыто(з1.имя, корень))
                всего = всего + 1;
            конец
            если ( не проводник_скрыто(з1.имя, корень) и всего больше с_номера и показано меньше ПРОВОДНИК_НА_СТРАНИЦЕ)
                если (компакт)
                    // Запись фиксированной ширины: папка(1) размер(12) изменён(12) длина имени(3) имя.
                    целое признак = 0;
                    если (з1.папка)
                        признак = 1;
                    конец
                    целое размер_з = з1.размер;
                    если (размер_з меньше 0)
                        размер_з = 0;
                    конец
                    целое дата_з = з1.изменён;
                    если (дата_з меньше 0)
                        дата_з = 0;
                    конец
                    элементы = элементы + целое_в_текст(признак) + проводник_нули(размер_з, 12) + проводник_нули(дата_з, 12) + проводник_нули(длина(з1.имя), 3) + з1.имя;
                иначе
                    текст пары = зос_пара_текст("имя", з1.имя) + "," + зос_пара_логическое("папка", з1.папка);
                    пары = пары + "," + зос_пара_целое("размер", з1.размер) + "," + зос_пара_целое("изменён", з1.изменён);
                    если (показано больше 0)
                        элементы = элементы + ",";
                    конец
                    элементы = элементы + зос_объект(пары);
                конец
                показано = показано + 1;
            конец
            i = i + 1;
        конец
        если (компакт)
            вернуть ответ_зос(клиент, 200, "СПИСОК1" + проводник_нули(всего, 10) + проводник_нули(показано, 10) + элементы);
        конец
        текст тело = зос_объект(зос_пара_текст("путь", путь) + "," + зос_пара_целое("всего", всего) + "," + зос_пара("записи", зос_массив(элементы)));
        вернуть ответ_зос(клиент, 200, тело);
    конец

    если (остаток == "скачать")
        если (длина(путь) == 0)
            вернуть ответ_зос(клиент, 400, "{\"ok\":false,\"ошибка\":\"не указан файл\"}");
        конец
        если (это_папка(полный))
            вернуть ответ_зос(клиент, 400, "{\"ok\":false,\"ошибка\":\"это папка, а не файл\"}");
        конец
        если (проводник_полный_доступ(корень) и проводник_не_скачивать(путь))
            вернуть ответ_зос(клиент, 400, "{\"ok\":false,\"ошибка\":\"системный файл ядра скачать нельзя\"}");
        конец
        результат из целого размер = размер_файла(полный);
        если ( не размер.успешно)
            вернуть ответ_зос(клиент, 404, "{\"ok\":false,\"ошибка\":\"файл не найден\"}");
        конец
        текст имя = путь;
        целое k = длина(путь) - 1;
        пока (k не меньше 0 и целое(байт_текста(путь, k)) != 47)
            k = k - 1;
        конец
        если (k не меньше 0)
            имя = срез(путь, k + 1, длина(путь) - k - 1);
        конец
        ответ_файлом_для(клиент, з, полный, имя, да, "no-store");
        вернуть 0;
    конец

    вернуть ответ_зос(клиент, 404, "{\"ok\":false,\"ошибка\":\"неизвестный запрос\"}");
конец

// PUT /api/загрузить?путь=папка/имя — кладёт тело запроса в файл. Существующий файл не перезаписывает (409),
// родительская папка должна быть. Пишет во временный «.part» и переименовывает, поэтому недокачанный файл не виден.
функция загрузить_в_проводник(целое32 клиент, Запрос з): целое
    если ( не авторизован(з))
        вернуть ответ_зос(клиент, 401, "{\"ok\":false,\"ошибка\":\"нет доступа: неверный токен\"}");
    конец
    текст путь = проводник_без_слэшей_по_краям(параметр(з.параметры, "путь"));
    если (длина(путь) == 0 или не проводник_путь_допустим(путь))
        вернуть ответ_зос(клиент, 400, "{\"ok\":false,\"ошибка\":\"недопустимый путь\"}");
    конец
    текст имя = путь;
    текст папка = "";
    целое k = длина(путь) - 1;
    пока (k не меньше 0 и целое(байт_текста(путь, k)) != 47)
        k = k - 1;
    конец
    если (k не меньше 0)
        имя = срез(путь, k + 1, длина(путь) - k - 1);
        папка = срез(путь, 0, k);
    конец
    текст корень = проводник_корень();
    если (проводник_скрыто(имя, корень) или оканчивается_на(имя, ".part") или длина(имя) больше 200)
        вернуть ответ_зос(клиент, 400, "{\"ok\":false,\"ошибка\":\"недопустимое имя файла\"}");
    конец
    текст полная_папка = проводник_на_диске(корень, папка);
    если ( не это_папка(полная_папка))
        вернуть ответ_зос(клиент, 404, "{\"ok\":false,\"ошибка\":\"папка не найдена\"}");
    конец
    текст полный = проводник_на_диске(корень, путь);
    результат из целого есть = размер_файла(полный);
    если (есть.успешно или это_папка(полный))
        вернуть ответ_зос(клиент, 409, "{\"ok\":false,\"ошибка\":\"такой файл уже есть\"}");
    конец
    результат из целого длина_тела = текст_в_целое(заголовок(з, "Content-Length"));
    если ( не длина_тела.успешно или длина_тела.значение меньше 0)
        вернуть ответ_зос(клиент, 400, "{\"ok\":false,\"ошибка\":\"нужен заголовок Content-Length\"}");
    конец
    если (длина_тела.значение больше 2147483648)
        вернуть ответ_зос(клиент, 413, "{\"ok\":false,\"ошибка\":\"файл больше 2 ГБ\"}");
    конец
    текст временный = полный + ".part";
    результат из целого принято = принять_тело_в_файл(клиент, временный, длина_тела.значение);
    если ( не принято.успешно)
        вернуть ответ_зос(клиент, 400, "{\"ok\":false,\"ошибка\":" + зос_в_кавычках(принято.сообщение) + "}");
    конец
    результат из верного готово = переименовать_файл(временный, полный);
    если ( не готово.успешно)
        вернуть ответ_зос(клиент, 500, "{\"ok\":false,\"ошибка\":\"не удалось сохранить файл\"}");
    конец
    вернуть ответ_зос(клиент, 201, "{\"ok\":true,\"имя\":" + зос_в_кавычках(имя) + ",\"размер\":" + целое_в_текст(длина_тела.значение) + "}");
конец
