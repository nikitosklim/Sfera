// статистика.код — учёт посещений сайта без cookie и без IP-адресов.
//
// Два журнала в папке данные/ (строки с табуляцией):
//   просмотры.log: время, путь, бот (0/1), откуда пришли (хост), поисковый запрос
//   время.log:     время, путь, секунд на странице, глубина прокрутки (%), сессия, разделы
// Просмотр пишет сервер, когда отдаёт страницу. Время, глубину и разделы присылает
// маленький скрипт статика/stat.js при закрытии вкладки. Страница управления забирает
// журналы целиком и рисует графики у себя в браузере.

подключить веб;

// Для журнала: без табуляции и переводов строк, не длиннее макс байт.
функция для_журнала(текст т, целое макс): текст
    текст а = заменить(т, "\t", " ");
    а = заменить(а, "\n", " ");
    а = заменить(а, "\r", " ");
    если (длина(а) больше макс)
        вернуть срез(а, 0, макс);
    конец
    вернуть а;
конец

// По User-Agent: похож ли посетитель на робота (поисковик, проверка ссылок, curl).
функция это_бот(текст агент): верно
    если (длина(агент) == 0)
        вернуть да;
    конец
    текст а = регистр_в_нижний(агент);
    Список из текстов признаки = Список из текстов();
    признаки.добавить("bot");
    признаки.добавить("spider");
    признаки.добавить("crawl");
    признаки.добавить("slurp");
    признаки.добавить("curl");
    признаки.добавить("wget");
    признаки.добавить("python");
    признаки.добавить("go-http");
    признаки.добавить("headless");
    признаки.добавить("preview");
    признаки.добавить("monitor");
    признаки.добавить("yandex");
    признаки.добавить("facebookexternalhit");
    признаки.добавить("telegram");
    целое н = 0;
    пока (н меньше признаки.размер())
        если (содержит(а, признаки.получить(н)))
            вернуть да;
        конец
        н = н + 1;
    конец
    вернуть нет;
конец

// «https://habr.com/ru/articles/1/» -> «habr.com». Свои страницы сайта дают пустой текст.
функция хост_из_ссылки(текст адрес): текст
    результат из целого схема = найти(адрес, "://");
    если ( не схема.успешно)
        вернуть "";
    конец
    текст после = срез(адрес, схема.значение + 3, длина(адрес) - схема.значение - 3);
    текст хост = после;
    результат из целого к = найти(после, "/");
    если (к.успешно)
        хост = срез(после, 0, к.значение);
    конец
    результат из целого д = найти(хост, ":");
    если (д.успешно)
        хост = срез(хост, 0, д.значение);
    конец
    хост = регистр_в_нижний(хост);
    если (содержит(хост, "xn--80ajfm5aev7c8a") или содержит(хост, "языксфера") или хост == "localhost" или хост == "127.0.0.1")
        вернуть "";
    конец
    вернуть для_журнала(хост, 80);
конец

// Страница показана: дописывает строку в данные/просмотры.log.
функция записать_просмотр(Запрос з, текст путь): целое
    если (з.метод != "GET")
        вернуть 0;
    конец
    текст бот = "0";
    если (это_бот(заголовок(з, "User-Agent")))
        бот = "1";
    конец
    текст запрос = "";
    если (путь == "/поиск")
        запрос = для_журнала(регистр_в_нижний(обрезать_края(параметр(з.параметры, "q"))), 80);
    конец
    текст строка = целое_в_текст(юникс_время()) + "\t" + для_журнала(путь, 200) + "\t" + бот + "\t" +
        хост_из_ссылки(заголовок(з, "Referer")) + "\t" + запрос + "\n";
    дописать_в_файл_бинарно("данные/просмотры.log", строка, длина(строка));
    вернуть 0;
конец

// Только цифры, не больше макс; иначе 0.
функция число_в_пределах(текст т, целое макс): целое
    результат из целого р = текст_в_целое(обрезать_края(т));
    если ( не р.успешно или р.значение меньше 0)
        вернуть 0;
    конец
    если (р.значение больше макс)
        вернуть макс;
    конец
    вернуть р.значение;
конец

// POST /статистика/время: тело «п=/путь&с=сессия&т=секунд&г=глубина&р=раздел:секунд,…».
// Открытый путь, поэтому всё проверяется и обрезается.
функция принять_время(целое32 клиент, Запрос з): целое
    текст путь = параметр(з.тело, "п");
    если (длина(путь) меньше 1 или длина(путь) больше 200 или целое(байт_текста(путь, 0)) != 47)
        вернуть ответ_текстом(клиент, 400, "text/plain; charset=utf-8", "bad");
    конец
    целое секунд = число_в_пределах(параметр(з.тело, "т"), 7200);
    если (секунд меньше 1)
        вернуть ответ_текстом(клиент, 204, "text/plain; charset=utf-8", "");
    конец
    целое глубина = число_в_пределах(параметр(з.тело, "г"), 100);
    текст сессия = для_журнала(параметр(з.тело, "с"), 24);
    текст разделы = для_журнала(параметр(з.тело, "р"), 400);
    текст строка = целое_в_текст(юникс_время()) + "\t" + для_журнала(путь, 200) + "\t" + целое_в_текст(секунд) + "\t" +
        целое_в_текст(глубина) + "\t" + сессия + "\t" + разделы + "\n";
    дописать_в_файл_бинарно("данные/время.log", строка, длина(строка));
    вернуть ответ_текстом(клиент, 204, "text/plain; charset=utf-8", "");
конец

// Последние байты файла (журнал растёт; для графиков хватает свежей части).
// Первая строка может оказаться обрезанной — страница управления её отбрасывает.
функция хвост_файла(текст путь, целое макс): текст
    результат из целого размер = размер_файла(путь);
    если ( не размер.успешно или размер.значение == 0)
        вернуть "";
    конец
    целое начало = 0;
    если (размер.значение больше макс)
        начало = размер.значение - макс;
    конец
    результат из текста часть = прочитать_часть_файла(путь, начало, размер.значение - начало);
    если ( не часть.успешно)
        вернуть "";
    конец
    вернуть часть.значение;
конец

// GET /управление/статистика/просмотры | /время — только с токеном.
функция отдать_статистику(целое32 клиент, Запрос з, текст что): целое
    если ( не авторизован(з))
        вернуть ответ_json(клиент, 401, "{\"ok\":false}");
    конец
    текст файл = "данные/просмотры.log";
    если (что == "время")
        файл = "данные/время.log";
    конец
    текст данные = хвост_файла(файл, 1500000);
    ответ_с_заголовками(клиент, з, 200, "text/plain; charset=utf-8", данные, "Cache-Control: no-store\r\n");
    вернуть 0;
конец
