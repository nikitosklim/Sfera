// внешние_статьи.код — статьи на других площадках (Хабр, блоги), которые сайт показывает карточками.
//
// Администратор вставляет адрес статьи, сервер сам скачивает страницу (через curl), достаёт название,
// описание и картинку из метатегов (Open Graph), а обложку сохраняет у себя. Теги админ пишет вручную.
// Список лежит в данные/статьи.txt: «номер | название | описание | теги | адрес | картинка | время».
// Картинки — данные/обложки/<номер>.<jpg|png|gif|webp>, отдаются по адресу /обложки/<файл>.

подключить веб;

// ---------------------------------------------------------------- текст и HTML

// Не длиннее макс байт (срез за границей текста даёт пустой текст, поэтому проверяем длину).
функция обрезать_до(текст т, целое макс): текст
    если (длина(т) больше макс)
        // Не режем посреди многобайтового символа: иначе в файле окажется битый UTF-8.
        целое до = макс;
        пока (до больше 0 и целое(байт_текста(т, до)) не меньше 128 и целое(байт_текста(т, до)) не больше 191)
            до = до - 1;
        конец
        вернуть срез(т, 0, до);
    конец
    вернуть т;
конец

// Позиция первого вхождения «что» в «т», начиная с «от»; -1, если нет.
функция найти_с(текст т, текст что, целое от): целое
    целое n = длина(т);
    целое м = длина(что);
    если (м == 0)
        вернуть -1;
    конец
    целое i = от;
    пока (i + м не больше n)
        если (байт_текста(т, i) == байт_текста(что, 0))
            целое j = 1;
            верно совпало = да;
            пока (j меньше м)
                если (байт_текста(т, i + j) != байт_текста(что, j))
                    совпало = нет;
                    прервать;
                конец
                j = j + 1;
            конец
            если (совпало)
                вернуть i;
            конец
        конец
        i = i + 1;
    конец
    вернуть -1;
конец

// Значение атрибута в тексте тега: имя="значение" или имя='значение'.
функция атрибут(текст тег, текст имя): текст
    текст кавычка = "\"";
    целое п = найти_с(тег, " " + имя + "=\"", 0);
    если (п меньше 0)
        п = найти_с(тег, " " + имя + "='", 0);
        кавычка = "'";
    конец
    если (п меньше 0)
        вернуть "";
    конец
    целое начало = п + длина(имя) + 3;
    целое конец_значения = найти_с(тег, кавычка, начало);
    если (конец_значения меньше 0)
        вернуть "";
    конец
    вернуть срез(тег, начало, конец_значения - начало);
конец

// Записывает код символа в буфер как UTF-8, возвращает новую позицию.
функция записать_символ(текст буфер, целое выход, целое код): целое
    если (код меньше 128)
        записать_целое32(буфер, выход, целое32(код));
        вернуть выход + 1;
    конец
    если (код меньше 2048)
        записать_целое32(буфер, выход, целое32(192 + код / 64));
        записать_целое32(буфер, выход + 1, целое32(128 + код - (код / 64) * 64));
        вернуть выход + 2;
    конец
    если (код меньше 65536)
        записать_целое32(буфер, выход, целое32(224 + код / 4096));
        записать_целое32(буфер, выход + 1, целое32(128 + (код / 64) - (код / 4096) * 64));
        записать_целое32(буфер, выход + 2, целое32(128 + код - (код / 64) * 64));
        вернуть выход + 3;
    конец
    записать_целое32(буфер, выход, целое32(240 + код / 262144));
    записать_целое32(буфер, выход + 1, целое32(128 + (код / 4096) - (код / 262144) * 64));
    записать_целое32(буфер, выход + 2, целое32(128 + (код / 64) - (код / 4096) * 64));
    записать_целое32(буфер, выход + 3, целое32(128 + код - (код / 64) * 64));
    вернуть выход + 4;
конец

// Код символа по имени сущности («amp», «quot»…) или -1.
функция код_сущности(текст имя): целое
    если (имя == "amp")
        вернуть 38;
    конец
    если (имя == "lt")
        вернуть 60;
    конец
    если (имя == "gt")
        вернуть 62;
    конец
    если (имя == "quot")
        вернуть 34;
    конец
    если (имя == "apos")
        вернуть 39;
    конец
    если (имя == "nbsp")
        вернуть 32;
    конец
    если (имя == "mdash")
        вернуть 8212;
    конец
    если (имя == "ndash")
        вернуть 8211;
    конец
    если (имя == "laquo")
        вернуть 171;
    конец
    если (имя == "raquo")
        вернуть 187;
    конец
    если (имя == "hellip")
        вернуть 8230;
    конец
    вернуть -1;
конец

// «&quot;», «&#39;», «&#x27;» -> обычные символы; лишние переводы строк и табуляции -> пробелы.
функция убрать_сущности(текст источник): текст
    целое n = длина(источник);
    текст буфер = выделить_память(n * 2 + 16);
    целое выход = 0;
    целое i = 0;
    пока (i меньше n)
        целое б = целое(байт_текста(источник, i));
        верно заменено = нет;
        если (б == 38)
            целое конец_сущности = найти_с(источник, ";", i);
            если (конец_сущности больше i и конец_сущности - i меньше 12)
                текст имя = срез(источник, i + 1, конец_сущности - i - 1);
                целое код = -1;
                если (длина(имя) больше 1 и целое(байт_текста(имя, 0)) == 35)
                    если (целое(байт_текста(имя, 1)) == 120 или целое(байт_текста(имя, 1)) == 88)
                        целое значение = 0;
                        целое к = 2;
                        верно верные_цифры = длина(имя) больше 2;
                        пока (к меньше длина(имя))
                            целое ц = цифра_16(целое(байт_текста(имя, к)));
                            если (ц меньше 0)
                                верные_цифры = нет;
                                прервать;
                            конец
                            значение = значение * 16 + ц;
                            к = к + 1;
                        конец
                        если (верные_цифры)
                            код = значение;
                        конец
                    иначе
                        результат из целого число = текст_в_целое(срез(имя, 1, длина(имя) - 1));
                        если (число.успешно)
                            код = число.значение;
                        конец
                    конец
                иначе
                    код = код_сущности(имя);
                конец
                если (код больше 0 и код меньше 1114112)
                    выход = записать_символ(буфер, выход, код);
                    i = конец_сущности + 1;
                    заменено = да;
                конец
            конец
        конец
        если ( не заменено)
            если (б == 9 или б == 10 или б == 13)
                б = 32;
            конец
            записать_целое32(буфер, выход, целое32(б));
            выход = выход + 1;
            i = i + 1;
        конец
    конец
    записать_целое32(буфер, выход, целое32(0));
    вернуть обрезать_края(буфер);
конец

// ---------------------------------------------------------------- проверка адреса

функция хост_адреса(текст адрес): текст
    результат из целого схема = найти(адрес, "://");
    если ( не схема.успешно)
        вернуть "";
    конец
    текст после = срез(адрес, схема.значение + 3, длина(адрес) - схема.значение - 3);
    текст хост = после;
    результат из целого к = найти(после, "/");
    если (к.успешно)
        хост = срез(после, 0, к.значение);
    конец
    результат из целого вопрос = найти(хост, "?");
    если (вопрос.успешно)
        хост = срез(хост, 0, вопрос.значение);
    конец
    результат из целого д = найти(хост, ":");
    если (д.успешно)
        хост = срез(хост, 0, д.значение);
    конец
    вернуть регистр_в_нижний(хост);
конец

// «https://habr.com/ru/x» -> «https://habr.com» (схема и хост, для относительных адресов).
функция основа_адреса(текст адрес): текст
    результат из целого схема = найти(адрес, "://");
    если ( не схема.успешно)
        вернуть "";
    конец
    вернуть срез(адрес, 0, схема.значение + 3) + хост_адреса(адрес);
конец

// Адрес статьи годится: http(s), без пробелов и кавычек, не внутренний хост.
// Адрес попадает в команду curl, поэтому проверка строгая.
функция адрес_статьи_допустим(текст адрес): верно
    целое n = длина(адрес);
    если (n меньше 10 или n больше 500)
        вернуть нет;
    конец
    если (срез(адрес, 0, 7) != "http://" и срез(адрес, 0, 8) != "https://")
        вернуть нет;
    конец
    целое i = 0;
    пока (i меньше n)
        целое б = целое(байт_текста(адрес, i));
        если (б не больше 32 или б == 34 или б == 39 или б == 96 или б == 92 или б == 127 или б == 36)
            вернуть нет;
        конец
        i = i + 1;
    конец
    текст хост = хост_адреса(адрес);
    если (длина(хост) меньше 3 или не содержит(хост, "."))
        вернуть нет;
    конец
    если (содержит(хост, "@") или содержит(хост, "[") или хост == "localhost" или оканчивается_на(хост, ".local") или оканчивается_на(хост, ".internal"))
        вернуть нет;
    конец
    если (срез(хост, 0, 4) == "127." или срез(хост, 0, 3) == "10." или срез(хост, 0, 8) == "192.168." или срез(хост, 0, 8) == "169.254." или срез(хост, 0, 2) == "0.")
        вернуть нет;
    конец
    если (срез(хост, 0, 4) == "172.")
        результат из целого второе = текст_в_целое(срез(хост, 4, 2));
        если (второе.успешно и второе.значение не меньше 16 и второе.значение не больше 31)
            вернуть нет;
        конец
    конец
    вернуть да;
конец

