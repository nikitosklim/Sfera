// POST /управление/ссылка/проверить: тело «адрес=…». Ответ: название, описание, картинка (для предпросмотра).
функция проверить_ссылку(целое32 клиент, Запрос з): целое
    текст адрес = обрезать_края(параметр(з.тело, "адрес"));
    если ( не адрес_статьи_допустим(адрес))
        вернуть ответ_ошибка(клиент, 400, "адрес должен начинаться с http:// или https:// и вести на внешний сайт");
    конец
    текст временный = "данные/страница-" + целое_в_текст(монотонное_время_нс()) + ".tmp";
    если ( не скачать(адрес, временный, 3000000))
        удалить_файл(временный);
        вернуть ответ_ошибка(клиент, 502, "не удалось скачать страницу (сайт не отвечает или файл слишком большой)");
    конец
    результат из текста страница = прочитать_файл(временный);
    удалить_файл(временный);
    если ( не страница.успешно)
        вернуть ответ_ошибка(клиент, 502, "страница пустая");
    конец
    Карточка к = разобрать_страницу(страница.значение, основа_адреса(адрес));
    вернуть ответ_json(клиент, 200, "{\"ok\":true,\"название\":" + json_строка(к.название) + ",\"описание\":" +
        json_строка(к.описание) + ",\"картинка\":" + json_строка(к.картинка) + ",\"хост\":" + json_строка(хост_адреса(адрес)) + "}");
конец

// POST /управление/ссылка/добавить: «адрес», «название», «описание», «теги», «картинка».
функция добавить_ссылку(целое32 клиент, Запрос з): целое
    текст адрес = обрезать_края(параметр(з.тело, "адрес"));
    текст название = обрезать_до(очистить_поле(обрезать_края(параметр(з.тело, "название"))), 200);
    текст описание = обрезать_до(очистить_поле(обрезать_края(параметр(з.тело, "описание"))), 400);
    текст теги = очистить_теги(параметр(з.тело, "теги"));
    текст картинка = обрезать_края(параметр(з.тело, "картинка"));
    если ( не адрес_статьи_допустим(адрес) или длина(название) == 0)
        вернуть ответ_ошибка(клиент, 400, "нужны адрес статьи и название");
    конец
    создать_папку("данные/обложки");
    текст номер = следующий_номер();
    текст имя_картинки = "";
    если (длина(картинка) больше 0 и адрес_статьи_допустим(картинка))
        текст временная = "данные/обложки/" + номер + ".tmp";
        если (скачать(картинка, временная, 5000000))
            текст расширение = тип_картинки(временная);
            если (длина(расширение) больше 0)
                текст итог_файл = "данные/обложки/" + номер + "." + расширение;
                результат из верного перенесён = переименовать_файл(временная, итог_файл);
                если (перенесён.успешно)
                    имя_картинки = номер + "." + расширение;
                иначе
                    удалить_файл(временная);
                конец
            иначе
                удалить_файл(временная);
            конец
        иначе
            удалить_файл(временная);
        конец
    конец
    текст строка = номер + " | " + название + " | " + описание + " | " + теги + " | " + очистить_поле(адрес) + " | " +
        имя_картинки + " | " + целое_в_текст(юникс_время()) + "\n";
    дописать_в_файл_бинарно("данные/статьи.txt", строка, длина(строка));
    вернуть ответ_json(клиент, 201, "{\"ok\":true,\"номер\":" + json_строка(номер) + ",\"картинка\":" + json_строка(имя_картинки) + "}");
конец

// POST /управление/ссылка/удалить: «номер».
функция удалить_ссылку(целое32 клиент, Запрос з): целое
    текст номер = обрезать_края(параметр(з.тело, "номер"));
    результат из текста список = прочитать_файл("данные/статьи.txt");
    если (длина(номер) == 0 или не список.успешно)
        вернуть ответ_ошибка(клиент, 404, "такой статьи нет");
    конец
    текст новый_список = "";
    текст картинка = "";
    верно нашли = нет;
    целое всего = длина(список.значение);
    целое позиция = 0;
    пока (позиция меньше всего)
        целое до = конец_строки(список.значение, позиция);
        текст строка = срез(список.значение, позиция, до - позиция);
        позиция = до + 1;
        верно оставить = да;
        если (строка_записи(строка) и поле_строки(строка, 0) == номер)
            оставить = нет;
            нашли = да;
            картинка = поле_строки(строка, 5);
        конец
        если (оставить и длина(строка) больше 0)
            новый_список = новый_список + строка + "\n";
        конец
    конец
    если ( не нашли)
        вернуть ответ_ошибка(клиент, 404, "такой статьи нет");
    конец
    результат из верного записан = записать_файл("данные/статьи.txt.new", новый_список);
    если ( не записан.успешно)
        вернуть ответ_ошибка(клиент, 500, "не удалось записать список");
    конец
    результат из верного заменён = переименовать_файл("данные/статьи.txt.new", "данные/статьи.txt");
    если ( не заменён.успешно)
        вернуть ответ_ошибка(клиент, 500, "не удалось обновить список");
    конец
    если (имя_загрузки_допустимо(картинка) и длина(картинка) больше 0)
        удалить_файл("данные/обложки/" + картинка);
    конец
    вернуть ответ_json(клиент, 200, "{\"ok\":true}");
конец

// GET /управление/ссылки: список для страницы управления (JSON).
функция список_ссылок_json(целое32 клиент, Запрос з): целое
    результат из текста список = прочитать_файл("данные/статьи.txt");
    текст итог = "[";
    если (список.успешно)
        целое всего = длина(список.значение);
        целое позиция = 0;
        целое штук = 0;
        пока (позиция меньше всего)
            целое до = конец_строки(список.значение, позиция);
            текст строка = срез(список.значение, позиция, до - позиция);
            позиция = до + 1;
            если (строка_записи(строка))
                если (штук больше 0)
                    итог = итог + ",";
                конец
                итог = итог + "{\"номер\":" + json_строка(поле_строки(строка, 0)) + ",\"название\":" + json_строка(поле_строки(строка, 1)) +
                    ",\"теги\":" + json_строка(поле_строки(строка, 3)) + ",\"адрес\":" + json_строка(поле_строки(строка, 4)) +
                    ",\"описание\":" + json_строка(поле_строки(строка, 2)) + ",\"картинка\":" + json_строка(поле_строки(строка, 5)) + "}";
                штук = штук + 1;
            конец
        конец
    конец
    итог = итог + "]";
    вернуть ответ_с_заголовками(клиент, з, 200, "application/json; charset=utf-8", итог, "Cache-Control: no-store\r\n");
конец

// Все запросы управления статьями: проверка токена и выбор действия.
функция обработать_ссылки(целое32 клиент, Запрос з, текст действие): целое
    если ( не авторизован(з))
        вернуть ответ_json(клиент, 401, "{\"ok\":false,\"ошибка\":\"нет доступа: неверный токен\"}");
    конец
    если (з.метод == "GET" и действие == "ссылки")
        вернуть список_ссылок_json(клиент, з);
    конец
    если (з.метод == "GET" и действие == "пользователи")
        вернуть список_пользователей(клиент);
    конец
    если (з.метод == "POST" и действие == "пользователь/роль")
        вернуть задать_роль(клиент, з);
    конец
    если (з.метод == "POST" и действие == "пользователь/блок")
        вернуть задать_блок(клиент, з);
    конец
    если (з.метод == "POST" и действие == "ссылка/проверить")
        вернуть проверить_ссылку(клиент, з);
    конец
    если (з.метод == "POST" и действие == "ссылка/добавить")
        вернуть добавить_ссылку(клиент, з);
    конец
    если (з.метод == "POST" и действие == "ссылка/удалить")
        вернуть удалить_ссылку(клиент, з);
    конец
    если (з.метод == "POST" и действие == "донаты/обновить")
        целое сделано = обновить_донатеров();
        если (сделано больше -1)
            вернуть ответ_json(клиент, 200, "{\"ok\":true}");
        конец
        вернуть ответ_json(клиент, 502, "{\"ok\":false,\"ошибка\":\"не удалось получить донаты: проверьте токен DonationAlerts\"}");
    конец
    если (з.метод == "POST" и действие == "ссылка/изменить")
        вернуть изменить_ссылку(клиент, з);
    конец
    если (з.метод == "POST" и действие == "картинка/убрать")
        вернуть убрать_обложку(клиент, з);
    конец
    если (з.метод == "POST" и действие == "аватар/убрать")
        вернуть убрать_аватар(клиент);
    конец
    если (з.метод == "GET" и действие == "файлы")
        вернуть список_файлов_json(клиент, з);
    конец
    если (з.метод == "GET" и действие == "аватар/состояние")
        если (есть_свой_аватар())
            вернуть ответ_json(клиент, 200, "{\"ok\":true,\"свой\":true}");
        конец
        вернуть ответ_json(клиент, 200, "{\"ok\":true,\"свой\":false}");
    конец
    если (з.метод == "POST" и действие == "автор/создать")
        вернуть создать_автора(клиент, з);
    конец
    если (з.метод == "POST" и действие == "автор/удалить")
        вернуть удалить_автора(клиент, з);
    конец
    если (з.метод == "POST" и действие == "автор/список")
        вернуть список_авторов(клиент);
    конец
    если (з.метод == "POST" и действие == "реестр/отозвать")
        вернуть отозвать_версию(клиент, з);
    конец
    если (з.метод == "POST" и действие == "реестр/удалить")
        вернуть удалить_пакет_из_реестра(клиент, з);
    конец
    если (з.метод == "POST" и действие == "пакет/добавить")
        вернуть добавить_пакет(клиент, з);
    конец
    если (з.метод == "POST" и действие == "пакет/удалить")
        вернуть удалить_пакет(клиент, з);
    конец
    вернуть ответ_ошибка(клиент, 404, "неизвестное действие");
конец

