// Карточки статей с других площадок и фильтр по тегам (для раздела «Статьи»).
функция каталог_внешних_статей(): текст
    вернуть карточки_статей(0, да);
конец

// Карточки собственных статей (content/articles) — запасной вариант для главной, пока чужих мало.
функция карточки_своих_статей(целое сколько): текст
    результат из текста список = прочитать_файл("content/articles/list.txt");
    текст карточки = "";
    если ( не список.успешно)
        вернуть "";
    конец
    целое всего = длина(список.значение);
    целое позиция = 0;
    целое выдано = 0;
    пока (позиция меньше всего и выдано меньше сколько)
        целое до = конец_строки(список.значение, позиция);
        текст строка = срез(список.значение, позиция, до - позиция);
        позиция = до + 1;
        если (строка_записи(строка))
            текст название = экранировать_html(поле_строки(строка, 1));
            текст описание = экранировать_html(поле_строки(строка, 2));
            текст метка = экранировать_html(поле_строки(строка, 3));
            текст адрес_слага = поле_строки(строка, 4);
            карточки = карточки + "<a class=\"статья\" href=\"/статьи/" + кодировать_адрес(адрес_слага) +
                "\"><div class=\"обложка пустая\" aria-hidden=\"true\"></div><div class=\"статья-текст\"><em>" + метка +
                "</em><b>" + название + "</b><span>" + описание + "</span></div></a>";
            выдано = выдано + 1;
        конец
    конец
    вернуть карточки;
конец

// макс = 0 — все статьи; с_фильтром = нет — без кнопок тегов (для главной), недостающее добирается своими статьями.
функция карточки_статей(целое макс, верно с_фильтром): текст
    результат из текста список = прочитать_файл("данные/статьи.txt");
    верно файл_пуст = да;
    если (список.успешно)
        файл_пуст = длина(список.значение) == 0;
    конец
    если (файл_пуст)
        если (макс больше 0)
            вернуть "<div class=\"статьи-сетка\">" + карточки_своих_статей(макс) + "</div>";
        конец
        вернуть "";
    конец
    // Новые сверху: сначала собираем строки, потом выводим с конца.
    Список из текстов строки = Список из текстов();
    целое всего = длина(список.значение);
    целое позиция = 0;
    пока (позиция меньше всего)
        целое до = конец_строки(список.значение, позиция);
        текст строка = срез(список.значение, позиция, до - позиция);
        позиция = до + 1;
        если (строка_записи(строка))
            строки.добавить(строка);
        конец
    конец
    Список из текстов все_теги = Список из текстов();
    текст карточки = "";
    целое выдано_карточек = 0;
    целое н = строки.размер() - 1;
    пока (н не меньше 0 и (макс == 0 или выдано_карточек меньше макс))
        текст строка = строки.получить(н);
        текст название = экранировать_html(поле_строки(строка, 1));
        текст описание = экранировать_html(поле_строки(строка, 2));
        текст теги = поле_строки(строка, 3);
        текст адрес = экранировать_html(поле_строки(строка, 4));
        текст картинка = поле_строки(строка, 5);
        текст хост = экранировать_html(хост_адреса(поле_строки(строка, 4)));
        текст теги_html = "";
        целое п = 0;
        целое длина_тегов = длина(теги);
        пока (п меньше длина_тегов)
            результат из целого к = найти(срез(теги, п, длина_тегов - п), ",");
            целое до_тега = длина_тегов;
            если (к.успешно)
                до_тега = п + к.значение;
            конец
            текст тег = срез(теги, п, до_тега - п);
            п = до_тега + 1;
            если (длина(тег) больше 0)
                текст тег_html = экранировать_html(тег);
                теги_html = теги_html + "<span class=\"тег\">" + тег_html + "</span>";
                верно есть = нет;
                целое м = 0;
                пока (м меньше все_теги.размер())
                    если (все_теги.получить(м) == тег)
                        есть = да;
                    конец
                    м = м + 1;
                конец
                если ( не есть)
                    все_теги.добавить(тег);
                конец
            конец
        конец
        текст обложка = "<div class=\"обложка пустая\" aria-hidden=\"true\"></div>";
        если (длина(картинка) больше 0 и имя_загрузки_допустимо(картинка))
            обложка = "<img class=\"обложка\" src=\"/обложки/" + картинка + "\" alt=\"\" loading=\"lazy\">";
        конец
        карточки = карточки + "<a class=\"статья\" href=\"" + адрес + "\" target=\"_blank\" rel=\"noopener\" data-теги=\"," +
            экранировать_html(теги) + ",\">" + обложка + "<div class=\"статья-текст\"><em>" + хост + "</em><b>" + название +
            "</b><span>" + описание + "</span><div class=\"теги\">" + теги_html + "</div></div></a>";
        выдано_карточек = выдано_карточек + 1;
        н = н - 1;
    конец
    если (макс больше 0 и выдано_карточек меньше макс)
        карточки = карточки + карточки_своих_статей(макс - выдано_карточек);
    конец
    текст фильтр = "";
    если (с_фильтром и все_теги.размер() больше 0)
        фильтр = "<div class=\"фильтр-тегов\" role=\"group\" aria-label=\"Фильтр по тегам\"><button type=\"button\" class=\"тег активный\" data-тег=\"\">Все</button>";
        целое м = 0;
        пока (м меньше все_теги.размер())
            текст т = экранировать_html(все_теги.получить(м));
            фильтр = фильтр + "<button type=\"button\" class=\"тег\" data-тег=\"" + т + "\">" + т + "</button>";
            м = м + 1;
        конец
        фильтр = фильтр + "</div>";
    конец
    строки.освободить();
    все_теги.освободить();
    если ( не с_фильтром)
        вернуть "<div class=\"статьи-сетка\">" + карточки + "</div>";
    конец
    вернуть фильтр + "<div class=\"статьи-сетка\">" + карточки + "</div><script src=\"/статика/статьи.js\" defer></script>";
конец

