// GET /обложки/<файл>: картинка статьи.
функция отдать_обложку(целое32 клиент, Запрос з, текст имя): целое
    если ( не имя_загрузки_допустимо(имя))
        вернуть ответ_текстом(клиент, 404, "text/plain; charset=utf-8", "Не найдено");
    конец
    если ( не ответ_файлом_для(клиент, з, "данные/обложки/" + имя, имя, нет, "public, max-age=86400"))
        вернуть ответ_текстом(клиент, 404, "text/plain; charset=utf-8", "Не найдено");
