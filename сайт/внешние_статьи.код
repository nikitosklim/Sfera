функция очистить_теги(текст источник): текст
    текст а = регистр_в_нижний(очистить_поле(убрать_сущности(источник)));
    а = заменить(а, ";", ",");
    текст итог = "";
    Список из текстов уже = Список из текстов();
    целое позиция = 0;
    целое всего = длина(а);
    пока (позиция меньше всего и уже.размер() меньше 10)
        результат из целого к = найти(срез(а, позиция, всего - позиция), ",");
        целое до = всего;
        если (к.успешно)
            до = позиция + к.значение;
        конец
        текст тег = обрезать_края(срез(а, позиция, до - позиция));
        позиция = до + 1;
        если (длина(тег) больше 0 и длина(тег) меньше 40)
            верно есть = нет;
            целое н = 0;
            пока (н меньше уже.размер())
                если (уже.получить(н) == тег)
                    есть = да;
                конец
                н = н + 1;
            конец
            если ( не есть)
                уже.добавить(тег);
                если (длина(итог) больше 0)
                    итог = итог + ",";
                конец
                итог = итог + тег;
            конец
        конец
    конец
    уже.освободить();
    вернуть итог;
конец

