функция скачать(текст адрес, текст файл, целое макс_байт): верно
    текст команда = "curl -sL --max-time 20 --max-filesize " + целое_в_текст(макс_байт) +
        " --proto '=http,https' --proto-redir '=http,https' --max-redirs 5" +
        " -A 'Mozilla/5.0 (compatible; SferaSite/1.0)' -o '" + файл + "' '" + адрес + "'";
    результат из целого р = выполнить_команду(команда);
    вернуть р.успешно и р.значение == 0;
конец

// ---------------------------------------------------------------- разбор страницы

структура Карточка
    текст название;
    текст описание;
    текст картинка;
конец

// Достаёт название, описание и картинку из метатегов (og:, twitter:) и <title>.
функция разобрать_страницу(текст страница, текст основа): Карточка
    текст html = обрезать_до(страница, 400000);
    текст название = "";
    текст описание = "";
    текст картинка = "";
    текст название_запасное = "";
    текст описание_запасное = "";
    целое п = найти_с(html, "<meta", 0);
    пока (п не меньше 0)
        целое к = найти_с(html, ">", п);
        если (к меньше 0)
            прервать;
        конец
        текст тег = срез(html, п, к - п);
        текст ключ_тега = атрибут(тег, "property");
        если (длина(ключ_тега) == 0)
            ключ_тега = атрибут(тег, "name");
        конец
        текст зн = атрибут(тег, "content");
        если (длина(зн) больше 0)
            если (ключ_тега == "og:title")
                название = зн;
            конец
            если (ключ_тега == "twitter:title" и длина(название_запасное) == 0)
                название_запасное = зн;
            конец
            если (ключ_тега == "og:description")
                описание = зн;
            конец
            если ((ключ_тега == "description" или ключ_тега == "twitter:description") и длина(описание_запасное) == 0)
                описание_запасное = зн;
            конец
            если ((ключ_тега == "og:image" или ключ_тега == "twitter:image") и длина(картинка) == 0)
                картинка = зн;
            конец
        конец
        п = найти_с(html, "<meta", к);
    конец
    если (длина(название) == 0)
        название = название_запасное;
    конец
    если (длина(название) == 0)
        целое т1 = найти_с(html, "<title", 0);
        если (т1 больше -1)
            целое т2 = найти_с(html, ">", т1);
            целое т3 = найти_с(html, "</title>", т1);
            если (т2 больше 0 и т3 больше т2)
                название = срез(html, т2 + 1, т3 - т2 - 1);
            конец
        конец
    конец
    если (длина(описание) == 0)
        описание = описание_запасное;
    конец
    // Относительный адрес картинки -> полный.
    если (длина(картинка) больше 1 и срез(картинка, 0, 2) == "//")
        картинка = "https:" + картинка;
    иначе если (длина(картинка) больше 0 и целое(байт_текста(картинка, 0)) == 47)
        картинка = основа + картинка;
    конец
    картинка = убрать_сущности(картинка);
    Карточка итог = Карточка(обрезать_до(убрать_сущности(название), 200), обрезать_до(убрать_сущности(описание), 400), картинка);
    вернуть итог;
конец

// Расширение по первым байтам файла-картинки; пустой текст — это не поддерживаемая картинка.
функция тип_картинки(текст файл): текст
    результат из текста начало = прочитать_часть_файла(файл, 0, 4);
    если ( не начало.успешно или длина(начало.значение) меньше 3)
        вернуть "";
    конец
    целое б1 = целое(байт_текста(начало.значение, 0));
    целое б2 = целое(байт_текста(начало.значение, 1));
    целое б3 = целое(байт_текста(начало.значение, 2));
    если (б1 == 255 и б2 == 216 и б3 == 255)
        вернуть "jpg";
    конец
    если (б1 == 137 и б2 == 80 и б3 == 78)
        вернуть "png";
    конец
    если (б1 == 71 и б2 == 73 и б3 == 70)
        вернуть "gif";
    конец
    если (б1 == 82 и б2 == 73 и б3 == 70)
        вернуть "webp";
    конец
    вернуть "";
конец

