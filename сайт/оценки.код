// оценки.код — звёзды, комментарии и модерация пакетов.
//
// Данные (папка данные/):
//   звёзды.txt        «пакет | пользователь»
//   комментарии.txt   «номер | пакет | пользователь | время | текст»
//   модерация.txt     «пакет | статус | кто | время» — статус: проверен, нежелательный (нет записи = непроверенный)
//
// Кто что может:
//   вошедший пользователь — ставит и снимает звезду, пишет комментарии, удаляет свои;
//   модератор             — ещё удаляет любые комментарии и помечает пакеты («проверен», «нежелательный», «непроверенный»);
//   администратор         — ещё удаляет пакеты целиком (администратором считается и тот, кто пришёл с админ-токеном).
//
// Адреса (POST требуют заголовок X-Sfera: 1):
//   GET  /оценки/пакет/<имя>        — звёзды, комментарии, статус, роль смотрящего
//   POST /оценки/звезда             — имя
//   POST /оценки/комментарий        — имя, текст
//   POST /оценки/комментарий/удалить — номер
//   POST /оценки/статус             — имя, статус         (модератор)
//   POST /оценки/пакет/удалить      — имя                 (администратор)
//   GET  /оценки/модерация          — все пакеты для таблицы модерации (модератор)

подключить веб;

// ---------------------------------------------------------------- роли

// Роль того, кто прислал запрос: «админ» — по админ-токену или роли; иначе роль вошедшего пользователя; пустой текст — аноним.
функция роль_запроса(Запрос з): текст
    если (авторизован(з))
        вернуть "админ";
    конец
    текст имя = пользователь_для_действия(з);
    если (длина(имя) == 0)
        вернуть "";
    конец
    вернуть роль_пользователя(имя);
конец

функция модератор_ли(текст роль): верно
    вернуть роль == "модератор" или роль == "админ";
конец

// Имя для подписи действия: админ-токен подписывается как «админ».
функция имя_действующего(Запрос з): текст
    если (авторизован(з))
        вернуть "админ";
    конец
    вернуть пользователь_для_действия(з);
конец

// ---------------------------------------------------------------- звёзды

функция число_звёзд(текст пакет): целое
    результат из текста файл = прочитать_файл("данные/звёзды.txt");
    если ( не файл.успешно)
        вернуть 0;
    конец
    целое счёт = 0;
    целое всего = длина(файл.значение);
    целое позиция = 0;
    пока (позиция меньше всего)
        целое до = конец_строки(файл.значение, позиция);
        текст строка = срез(файл.значение, позиция, до - позиция);
        позиция = до + 1;
        если (строка_записи(строка) и поле_строки(строка, 0) == пакет)
            счёт = счёт + 1;
        конец
    конец
    вернуть счёт;
конец

функция звезда_есть(текст пакет, текст пользователь): верно
    результат из текста файл = прочитать_файл("данные/звёзды.txt");
    если ( не файл.успешно или длина(пользователь) == 0)
        вернуть нет;
    конец
    целое всего = длина(файл.значение);
    целое позиция = 0;
    пока (позиция меньше всего)
        целое до = конец_строки(файл.значение, позиция);
        текст строка = срез(файл.значение, позиция, до - позиция);
        позиция = до + 1;
        если (строка_записи(строка) и поле_строки(строка, 0) == пакет и поле_строки(строка, 1) == пользователь)
            вернуть да;
        конец
    конец
    вернуть нет;
конец

// Убирает из файла строки, которые «подходят» (первое поле = ключ, а если задан пользователь — и второе).
функция убрать_строки_файла(текст файл_имя, текст ключ, целое поле_пользователя, текст пользователь): целое
    результат из текста файл = прочитать_файл(файл_имя);
    если ( не файл.успешно)
        вернуть 0;
    конец
    текст итог = "";
    целое всего = длина(файл.значение);
    целое позиция = 0;
    пока (позиция меньше всего)
        целое до = конец_строки(файл.значение, позиция);
        текст строка = срез(файл.значение, позиция, до - позиция);
        позиция = до + 1;
        верно убрать = нет;
        если (строка_записи(строка) и поле_строки(строка, 0) == ключ)
            если (поле_пользователя < 0 или поле_строки(строка, поле_пользователя) == пользователь)
                убрать = да;
            конец
        конец
        если ( не убрать и длина(строка) больше 0)
            итог = итог + строка + "\n";
        конец
    конец
    записать_файл(файл_имя + ".new", итог);
    переименовать_файл(файл_имя + ".new", файл_имя);
    вернуть 0;
конец

// POST /оценки/звезда: «имя». Повторный запрос снимает звезду.
функция переключить_звезду(целое32 клиент, Запрос з): целое
    текст кто = пользователь_для_действия(з);
    если (длина(кто) == 0)
        вернуть ответ_ошибка(клиент, 401, "войдите в аккаунт, чтобы ставить звёзды");
    конец
    текст имя = обрезать_края(параметр(з.тело, "имя"));
    если ( не имя_пакета_допустимо(имя) или не пакет_в_реестре(имя))
        вернуть ответ_ошибка(клиент, 404, "такого пакета нет");
    конец
    верно поставлена = звезда_есть(имя, кто);
    если (поставлена)
        убрать_строки_файла("данные/звёзды.txt", имя, 1, кто);
    иначе
        текст строка = имя + " | " + кто + "\n";
        дописать_в_файл_бинарно("данные/звёзды.txt", строка, длина(строка));
    конец
    текст моя = "true";
    если (поставлена)
        моя = "false";
    конец
    вернуть ответ_json(клиент, 200, "{\"ok\":true,\"звёзды\":" + целое_в_текст(число_звёзд(имя)) + ",\"моя\":" + моя + "}");
конец

// ---------------------------------------------------------------- комментарии

// Строка комментария по номеру.
функция строка_комментария(текст номер): текст
    результат из текста файл = прочитать_файл("данные/комментарии.txt");
    если ( не файл.успешно)
        вернуть "";
    конец
    целое всего = длина(файл.значение);
    целое позиция = 0;
    пока (позиция меньше всего)
        целое до = конец_строки(файл.значение, позиция);
        текст строка = срез(файл.значение, позиция, до - позиция);
        позиция = до + 1;
        если (строка_записи(строка) и поле_строки(строка, 0) == номер)
            вернуть строка;
        конец
    конец
    вернуть "";
конец

// Когда этот пользователь писал последний раз (юникс-время), 0 — никогда.
функция последний_комментарий(текст кто): целое
    результат из текста файл = прочитать_файл("данные/комментарии.txt");
    если ( не файл.успешно)
        вернуть 0;
    конец
    целое последний = 0;
    целое всего = длина(файл.значение);
    целое позиция = 0;
    пока (позиция меньше всего)
        целое до = конец_строки(файл.значение, позиция);
        текст строка = срез(файл.значение, позиция, до - позиция);
        позиция = до + 1;
        если (строка_записи(строка) и поле_строки(строка, 2) == кто)
            результат из целого время = текст_в_целое(поле_строки(строка, 3));
            если (время.успешно и время.значение больше последний)
                последний = время.значение;
            конец
        конец
    конец
    вернуть последний;
конец

// POST /оценки/комментарий: «имя», «текст».
функция добавить_комментарий(целое32 клиент, Запрос з): целое
    текст кто = пользователь_для_действия(з);
    если (длина(кто) == 0)
        вернуть ответ_ошибка(клиент, 401, "войдите в аккаунт, чтобы писать комментарии");
    конец
    текст имя = обрезать_края(параметр(з.тело, "имя"));
    если ( не имя_пакета_допустимо(имя) или не пакет_в_реестре(имя))
        вернуть ответ_ошибка(клиент, 404, "такого пакета нет");
    конец
    текст тело = обрезать_края(очистить_поле(параметр(з.тело, "текст")));
    если (длина(тело) == 0)
        вернуть ответ_ошибка(клиент, 400, "комментарий пустой");
    конец
    если (длина(тело) больше 1000)
        вернуть ответ_ошибка(клиент, 400, "комментарий длиннее 1000 знаков");
    конец
    целое сейчас = юникс_время();
    если (сейчас - последний_комментарий(кто) меньше 15)
        вернуть ответ_ошибка(клиент, 429, "не так часто: подождите несколько секунд");
    конец
    текст номер = целое_в_текст(монотонное_время_нс());
    текст строка = номер + " | " + имя + " | " + кто + " | " + целое_в_текст(сейчас) + " | " + тело + "\n";
    дописать_в_файл_бинарно("данные/комментарии.txt", строка, длина(строка));
    вернуть ответ_json(клиент, 201, "{\"ok\":true}");
конец

// POST /оценки/комментарий/удалить: «номер». Свой — любой пользователь, чужой — модератор и администратор.
функция удалить_комментарий(целое32 клиент, Запрос з): целое
    текст кто = имя_действующего(з);
    если (длина(кто) == 0)
        вернуть ответ_ошибка(клиент, 401, "войдите в аккаунт");
    конец
    текст номер = обрезать_края(параметр(з.тело, "номер"));
    текст строка = строка_комментария(номер);
    если (длина(строка) == 0)
        вернуть ответ_ошибка(клиент, 404, "такого комментария нет");
    конец
    если (поле_строки(строка, 2) != кто и не модератор_ли(роль_запроса(з)))
        вернуть ответ_ошибка(клиент, 403, "удалять чужие комментарии могут только модераторы");
    конец
    убрать_строки_файла("данные/комментарии.txt", номер, -1, "");
    вернуть ответ_json(клиент, 200, "{\"ok\":true}");
конец

// ---------------------------------------------------------------- модерация

функция записать_статус(текст имя, текст статус, текст кто): целое
    убрать_строки_файла("данные/модерация.txt", имя, -1, "");
    если (статус == "проверен" или статус == "нежелательный")
        текст строка = имя + " | " + статус + " | " + кто + " | " + целое_в_текст(юникс_время()) + "\n";
        дописать_в_файл_бинарно("данные/модерация.txt", строка, длина(строка));
    конец
    вернуть 0;
конец

// POST /оценки/статус: «имя», «статус» (проверен | нежелательный | непроверен).
функция задать_статус(целое32 клиент, Запрос з): целое
    если ( не модератор_ли(роль_запроса(з)))
        вернуть ответ_ошибка(клиент, 403, "помечать пакеты могут только модераторы");
    конец
    текст имя = обрезать_края(параметр(з.тело, "имя"));
    текст статус = обрезать_края(параметр(з.тело, "статус"));
    если ( не имя_пакета_допустимо(имя) или не пакет_в_реестре(имя))
        вернуть ответ_ошибка(клиент, 404, "такого пакета нет");
    конец
    если (статус != "проверен" и статус != "нежелательный" и статус != "непроверен")
        вернуть ответ_ошибка(клиент, 400, "статус: проверен, нежелательный или непроверен");
    конец
    записать_статус(имя, статус, имя_действующего(з));
    вернуть ответ_json(клиент, 200, "{\"ok\":true}");
конец

// POST /оценки/пакет/удалить: «имя». Только администратор. Убирает пакет со всеми версиями, звёздами и комментариями.
функция удалить_пакет_модерацией(целое32 клиент, Запрос з): целое
    если (роль_запроса(з) != "админ")
        вернуть ответ_ошибка(клиент, 403, "удалять пакеты может только администратор");
    конец
    текст имя = обрезать_края(параметр(з.тело, "имя"));
    если ( не имя_пакета_допустимо(имя) или не изменить_реестр(имя, "", 2, ""))
        вернуть ответ_ошибка(клиент, 404, "такого пакета нет");
    конец
    выполнить_команду("rm -rf 'данные/пакеты/" + имя + "'");
    убрать_строки_файла("данные/звёзды.txt", имя, -1, "");
    убрать_строки_файла("данные/комментарии.txt", имя, -1, "");
    убрать_строки_файла("данные/модерация.txt", имя, -1, "");
    вернуть ответ_json(клиент, 200, "{\"ok\":true}");
конец

// ---------------------------------------------------------------- выдача

// Комментарии пакета (JSON-массив).
функция комментарии_json(текст пакет): текст
    результат из текста файл = прочитать_файл("данные/комментарии.txt");
    текст итог = "[";
    если (файл.успешно)
        верно первый = да;
        целое всего = длина(файл.значение);
        целое позиция = 0;
        пока (позиция меньше всего)
            целое до = конец_строки(файл.значение, позиция);
            текст строка = срез(файл.значение, позиция, до - позиция);
            позиция = до + 1;
            если (строка_записи(строка) и поле_строки(строка, 1) == пакет)
                если ( не первый)
                    итог = итог + ",";
                конец
                первый = нет;
                итог = итог + "{\"номер\":" + json_строка(поле_строки(строка, 0)) + ",\"автор\":" + json_строка(поле_строки(строка, 2)) +
                    ",\"время\":" + json_строка(поле_строки(строка, 3)) + ",\"текст\":" + json_строка(поле_строки(строка, 4)) + "}";
            конец
        конец
    конец
    вернуть итог + "]";
конец

// Сколько комментариев у пакета.
функция число_комментариев(текст пакет): целое
    результат из текста файл = прочитать_файл("данные/комментарии.txt");
    если ( не файл.успешно)
        вернуть 0;
    конец
    целое счёт = 0;
    целое всего = длина(файл.значение);
    целое позиция = 0;
    пока (позиция меньше всего)
        целое до = конец_строки(файл.значение, позиция);
        текст строка = срез(файл.значение, позиция, до - позиция);
        позиция = до + 1;
        если (строка_записи(строка) и поле_строки(строка, 1) == пакет)
            счёт = счёт + 1;
        конец
    конец
    вернуть счёт;
конец

// GET /оценки/пакет/<имя>
функция оценки_пакета(целое32 клиент, Запрос з, текст имя): целое
    если ( не имя_пакета_допустимо(имя) или не пакет_в_реестре(имя))
        вернуть ответ_ошибка(клиент, 404, "такого пакета нет");
    конец
    текст кто = пользователь_по_сессии(з);
    текст роль = роль_запроса(з);
    если (длина(кто) больше 0 и длина(роль) == 0)
        роль = роль_пользователя(кто);
    конец
    текст моя = "false";
    если (длина(кто) больше 0 и звезда_есть(имя, кто))
        моя = "true";
    конец
    текст статус = статус_пакета(имя);
    если (длина(статус) == 0)
        статус = "непроверен";
    конец
    вернуть ответ_json(клиент, 200, "{\"ok\":true,\"звёзды\":" + целое_в_текст(число_звёзд(имя)) + ",\"моя\":" + моя + ",\"статус\":" + json_строка(статус) +
        ",\"вошёл\":" + json_строка(кто) + ",\"роль\":" + json_строка(роль) + ",\"комментарии\":" + комментарии_json(имя) + "}");
конец

// GET /оценки/модерация: все пакеты с последней версией, автором, статусом, звёздами и числом комментариев.
функция список_для_модерации(целое32 клиент, Запрос з): целое
    если ( не модератор_ли(роль_запроса(з)))
        вернуть ответ_ошибка(клиент, 403, "только для модераторов");
    конец
    текст реестр = прочитать_реестр();
    Список из текстов имена = имена_в_реестре(реестр);
    текст итог = "[";
    целое k = 0;
    пока (k меньше имена.размер())
        текст имя = имена.получить(k);
        текст запись = лучшая_запись(реестр, имя);
        текст статус = статус_пакета(имя);
        если (длина(статус) == 0)
            статус = "непроверен";
        конец
        если (k больше 0)
            итог = итог + ",";
        конец
        итог = итог + "{\"имя\":" + json_строка(имя) + ",\"версия\":" + json_строка(поле_строки(запись, 1)) + ",\"автор\":" + json_строка(поле_строки(запись, 5)) +
            ",\"описание\":" + json_строка(поле_строки(запись, 6)) + ",\"время\":" + json_строка(поле_строки(запись, 4)) + ",\"версий\":" + целое_в_текст(версий_в_реестре(реестр, имя)) +
            ",\"статус\":" + json_строка(статус) + ",\"звёзды\":" + целое_в_текст(число_звёзд(имя)) + ",\"комментарии\":" + целое_в_текст(число_комментариев(имя)) + "}";
        k = k + 1;
    конец
    имена.освободить();
    вернуть ответ_json(клиент, 200, итог + "]");
конец

функция обработать_оценки(целое32 клиент, Запрос з, текст действие): целое
    если (з.метод == "GET" и начинается_с(действие, "пакет/"))
        вернуть оценки_пакета(клиент, з, срез(действие, 11, длина(действие) - 11));
    конец
    если (з.метод == "GET" и действие == "модерация")
        вернуть список_для_модерации(клиент, з);
    конец
    если (з.метод != "POST")
        вернуть ответ_ошибка(клиент, 405, "метод не поддерживается");
    конец
    если (заголовок(з, "X-Sfera") != "1" и не авторизован(з))
        вернуть ответ_ошибка(клиент, 400, "нужен заголовок X-Sfera: 1");
    конец
    если (действие == "звезда")
        вернуть переключить_звезду(клиент, з);
    конец
    если (действие == "комментарий")
        вернуть добавить_комментарий(клиент, з);
    конец
    если (действие == "комментарий/удалить")
        вернуть удалить_комментарий(клиент, з);
    конец
    если (действие == "статус")
        вернуть задать_статус(клиент, з);
    конец
    если (действие == "пакет/удалить")
        вернуть удалить_пакет_модерацией(клиент, з);
    конец
    вернуть ответ_ошибка(клиент, 404, "такого действия нет");
конец
