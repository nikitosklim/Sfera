// сервер.код — точка входа сайта «Сферы».
//
// Запуск (из папки сайта — пути к страницам относительные):
//   запустить сервер.код        — собрать и запустить на порту 8080
//   ./сервер [порт]             — повторный запуск без пересборки
//
// Устройство: фиксированный пул из 16 рабочих потоков, каждый в бесконечном цикле
// принимает подключения с общего слушающего сокета и обрабатывает их. Поэтому
// сервер работает неограниченно долго (прежняя версия обслуживала 40 запросов
// и завершалась), а долгая загрузка большого файла занимает только один поток.

подключить веб;
подключить сайт;
подключить статистика;

функция главная(): целое
    целое порт = 8080;
    Список из текстов аргументы = аргументы_командной_строки();
    если (аргументы.размер() больше 0)
        результат из целого разобран = текст_в_целое(аргументы.получить(0));
        если (разобран.успешно и разобран.значение больше 0)
            порт = разобран.значение;
        конец
    конец

    создать_папку("данные");
    результат из целого открыт = открыть_порт(порт);
    если ( не открыт.успешно)
        вывести(открыт.сообщение);
        вернуть 1;
    конец
    целое32 слушающий = целое32(открыт.значение);
    вывести("сайт «Сфера» слушает на http://0.0.0.0:%порт%");

    канал из целое32 канал_сокета = создать_канал();
    целое рабочий = 0;
    пока (рабочий меньше 16)
        канал_сокета.отправить(слушающий);
        параллельно
            целое32 сокет_приёма = канал_сокета.получить();
            пока (да)
                целое32 клиент = принять_подключение(сокет_приёма, нулевой_указатель_сети(), нулевой_указатель_сети());
                если (клиент не меньше целое32(0))
                    обработать_подключение(клиент);
                конец
            конец
        конец
        рабочий = рабочий + 1;
    конец

    дождаться_все_потоки();
    вернуть 0;
конец

функция обработать_подключение(целое32 клиент): целое
    результат из Запрос запрос = прочитать_запрос(клиент);
    если ( не запрос.успешно)
        ответ_текстом(клиент, 400, "text/plain; charset=utf-8", "Некорректный запрос");
        закрыть_сокет(клиент);
        вернуть 0;
    конец
    Запрос з = запрос.значение;
    вывести("запрос: " + з.метод + " " + з.путь);
    текст запись_журнала = целое_в_текст(юникс_время()) + " " + з.метод + " " + з.путь + "\n";
    дописать_в_файл_бинарно("данные/access.log", запись_журнала, длина(запись_журнала));
    маршрутизировать(клиент, з);
    закрыть_сокет(клиент);
    вернуть 0;
конец

функция маршрутизировать(целое32 клиент, Запрос з): целое
    // Адрес приходит уже раскодированным (%D0%BF… -> «п…»). Русские адреса — основные,
    // прежние латинские (/docs, /static, /upload…) работают как запасные: страницы
    // перенаправляются на русский адрес (301), служебные пути отвечают сразу.
    текст сегмент = первый_сегмент(з.путь);
    текст остаток = остаток_пути(з.путь);

    если (з.метод == "PUT" и (сегмент == "загрузить" или сегмент == "upload"))
        вернуть принять_загрузку(клиент, з, остаток);
    конец
    если (з.метод == "DELETE" и (сегмент == "загрузить" или сегмент == "upload"))
        вернуть удалить_загрузку(клиент, з, остаток);
    конец
    если (з.метод == "GET" и (сегмент == "проверка-токена" или сегмент == "upload-check"))
        если (авторизован(з))
            вернуть ответ_json(клиент, 200, "{\"ok\":true}");
        конец
        вернуть ответ_json(клиент, 401, "{\"ok\":false}");
    конец
    если (з.метод == "POST" и з.путь == "/статистика/время")
        вернуть принять_время(клиент, з);
    конец
    если (з.метод != "GET" и з.метод != "HEAD")
        ответ_текстом(клиент, 405, "text/plain; charset=utf-8", "Метод не поддерживается");
        вернуть 0;
    конец
    текст путь = з.путь;

    если (путь == "/robots.txt")
        вернуть ответ_текстом(клиент, 200, "text/plain; charset=utf-8", текст_robots());
    конец
    если (путь == "/sitemap.xml")
        вернуть ответ_текстом(клиент, 200, "application/xml; charset=utf-8", карта_сайта());
    конец
    если ((начинается_с(путь, "/yandex_") или начинается_с(путь, "/google")) и путь_безопасен(путь) и не содержит(срез(путь, 1, длина(путь) - 1), "/"))
        текст имя_проверки = срез(путь, 1, длина(путь) - 1);
        если (ответ_файлом_для(клиент, з, "verify/" + имя_проверки, имя_проверки, нет, "public, max-age=300"))
            вернуть 0;
        конец
    конец

    если (путь == "/")
        записать_просмотр(з, "/");
        вернуть показать_страницу(клиент, "Главная", "home.html");
    конец

    если (сегмент == "статика" или сегмент == "static")
        вернуть отдать_статику(клиент, з, остаток);
    конец
    если (сегмент == "файлы" или сегмент == "files")
        вернуть отдать_загрузку(клиент, з, остаток);
    конец

    если (сегмент == "управление" и (остаток == "статистика/просмотры" или остаток == "статистика/время"))
        текст что_отдать = "время";
        если (остаток == "статистика/просмотры")
            что_отдать = "просмотры";
        конец
        вернуть отдать_статистику(клиент, з, что_отдать);
    конец

    текст страница_имя = страница_по_сегменту(сегмент);
    если (длина(страница_имя) больше 0 и длина(остаток) == 0)
        если (сегмент != страница_имя)
            вернуть на_русский_адрес(клиент, з, "/" + страница_имя);
        конец
        вернуть показать_служебную_страницу(клиент, з, страница_имя);
    конец

    текст раздел = раздел_по_сегменту(сегмент);
    если (длина(раздел) больше 0)
        текст русский_раздел = раздел_в_адрес(раздел);
        если (длина(остаток) == 0)
            если (сегмент != русский_раздел)
                вернуть на_русский_адрес(клиент, з, "/" + русский_раздел);
            конец
            записать_просмотр(з, "/" + русский_раздел);
            вернуть показать_каталог(клиент, раздел);
        конец
        текст имя_материала = найти_материал(раздел, остаток);
        если (длина(имя_материала) == 0)
            вернуть показать_страницу_с_кодом(клиент, 404, "Не найдено", "notfound.html");
        конец
        текст слаг = слаг_материала(раздел, имя_материала);
        если (сегмент != русский_раздел или остаток != слаг)
            вернуть на_русский_адрес(клиент, з, "/" + русский_раздел + "/" + слаг);
        конец
        записать_просмотр(з, "/" + русский_раздел + "/" + слаг);
        вернуть показать_материал(клиент, раздел, имя_материала);
    конец

    вернуть показать_страницу_с_кодом(клиент, 404, "Не найдено", "notfound.html");
конец

// 301 на русский адрес с сохранением параметров (?q=…).
функция на_русский_адрес(целое32 клиент, Запрос з, текст адрес): целое
    текст куда = кодировать_адрес(адрес);
    если (длина(з.параметры) больше 0)
        куда = куда + "?" + з.параметры;
    конец
    вернуть перенаправить_навсегда(клиент, куда);
конец

функция показать_служебную_страницу(целое32 клиент, Запрос з, текст имя): целое
    если (имя != "управление" и имя != "поиск-данные")
        записать_просмотр(з, "/" + имя);
    конец
    если (имя == "о-языке")
        вернуть показать_страницу(клиент, "О языке", "about.html");
    конец
    если (имя == "управление")
        вернуть показать_страницу(клиент, "Управление сайтом", "admin.html");
    конец
    если (имя == "поиск")
        вернуть показать_страницу(клиент, "Поиск", "search.html");
    конец
    если (имя == "поиск-данные")
        текст индекс = поисковый_индекс();
        ответ_текстом(клиент, 200, "text/plain; charset=utf-8", индекс);
        освободить_память(индекс);
        вернуть 0;
    конец
    если (имя == "поддержать")
        Список из текстов имена_п = Список из текстов();
        Список из текстов значения_п = Список из текстов();
        имена_п.добавить("способы");
        текст способы = способы_поддержки();
        значения_п.добавить(способы);
        текст счётчик_п = обновить_и_показать_счётчик();
        текст готовая_п = страница("Поддержать проект", "support.html", счётчик_п, имена_п, значения_п);
        ответ_html(клиент, 200, готовая_п);
        освободить_память(готовая_п);
        имена_п.освободить();
        значения_п.освободить();
        вернуть 0;
    конец
    Список из текстов имена = Список из текстов();
    Список из текстов значения = Список из текстов();
    имена.добавить("список");
    текст таблица = список_загрузок();
    значения.добавить(таблица);
    текст счётчик_текст = обновить_и_показать_счётчик();
    текст готовая = страница("Загрузки", "downloads.html", счётчик_текст, имена, значения);
    ответ_html(клиент, 200, готовая);
    освободить_память(готовая);
    имена.освободить();
    значения.освободить();
    вернуть 0;
конец

функция начинается_с(текст источник, текст начало): верно
    вернуть срез(источник, 0, длина(начало)) == начало;
конец

функция показать_страницу(целое32 клиент, текст заголовок, текст файл): целое
    вернуть показать_страницу_с_кодом(клиент, 200, заголовок, файл);
конец

функция показать_страницу_с_кодом(целое32 клиент, целое код, текст заголовок, текст файл): целое
    Список из текстов имена = Список из текстов();
    Список из текстов значения = Список из текстов();
    текст счётчик_текст = обновить_и_показать_счётчик();
    текст готовая = страница(заголовок, файл, счётчик_текст, имена, значения);
    ответ_html(клиент, код, готовая);
    освободить_память(готовая);
    имена.освободить();
    значения.освободить();
    вернуть 0;
конец

функция отдать_статику(целое32 клиент, Запрос з, текст имя): целое
    если (длина(имя) == 0 или не путь_безопасен("/" + имя))
        вернуть ответ_текстом(клиент, 403, "text/plain; charset=utf-8", "Доступ запрещён");
    конец
    если ( не ответ_файлом_для(клиент, з, "static/" + имя, имя, нет, "public, max-age=300"))
        вернуть показать_страницу_с_кодом(клиент, 404, "Не найдено", "notfound.html");
    конец
    вернуть 0;
конец

функция отдать_загрузку(целое32 клиент, Запрос з, текст имя): целое
    если (длина(имя) == 0 или не путь_безопасен("/" + имя))
        вернуть ответ_текстом(клиент, 403, "text/plain; charset=utf-8", "Доступ запрещён");
    конец
    если (содержит(имя, "/") или не файл_в_списке(имя))
        вернуть показать_страницу_с_кодом(клиент, 404, "Не найдено", "notfound.html");
    конец
    если ( не ответ_файлом_для(клиент, з, "downloads/" + имя, имя, да, "public, max-age=3600"))
        вернуть показать_страницу_с_кодом(клиент, 404, "Не найдено", "notfound.html");
    конец
    вернуть 0;
конец

функция показать_каталог(целое32 клиент, текст раздел): целое
    Список из текстов имена = Список из текстов();
    Список из текстов значения = Список из текстов();
    текст название_раздела = "Статьи";
    текст введение = "Новости, заметки о разработке и разборы решений.";
    верно по_группам = нет;
    если (раздел == "docs")
        название_раздела = "Документация";
        введение = "Справочник по языку: каждая тема отдельно, с примерами кода. Если вы только начинаете, откройте «Уроки».";
        по_группам = да;
    конец
    если (раздел == "lessons")
        название_раздела = "Уроки";
        введение = "Пошаговый курс: от первой программы до собственного веб-сервера. Проходите по порядку.";
    конец
    если (раздел == "examples")
        название_раздела = "Примеры";
        введение = "Готовые программы с объяснением: запускайте, меняйте и учитесь на них. Скоро здесь появятся проекты сообщества.";
        по_группам = да;
    конец
    имена.добавить("список");
    текст список = каталог_материалов(раздел, по_группам);
    значения.добавить(список);
    имена.добавить("раздел");
    значения.добавить(название_раздела);
    имена.добавить("введение");
    значения.добавить(введение);
    текст счётчик_текст = обновить_и_показать_счётчик();
    текст готовая = страница(название_раздела, "catalog.html", счётчик_текст, имена, значения);
    ответ_html(клиент, 200, готовая);
    освободить_память(готовая);
    имена.освободить();
    значения.освободить();
    вернуть 0;
конец

функция показать_материал(целое32 клиент, текст раздел, текст имя): целое
    текст счётчик_текст = обновить_и_показать_счётчик();
    текст готовая = страница_материала(раздел, имя, счётчик_текст);
    если (длина(готовая) == 0)
        вернуть показать_страницу_с_кодом(клиент, 404, "Не найдено", "notfound.html");
    конец
    ответ_html(клиент, 200, готовая);
    освободить_память(готовая);
    вернуть 0;
конец
