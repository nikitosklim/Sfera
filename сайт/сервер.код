// сервер.код — точка входа сайта языка "Сфера". Соединяет вместе:
// стандартная_библиотека/сеть.код (HTTP-сервер, маршрутизация,
// параллельная обработка подключений), сайт.код (страницы, оформление)
// и стандартная_библиотека/хранилище.код (счётчик посещений — то самое,
// собственное хранилище данных, о котором рассказывает сама страница).

подключить сеть;
подключить сайт;
подключить хранилище;

// AF_INET = 2, SOCK_STREAM = 1 (TCP), SOL_SOCKET = 1, SO_REUSEADDR = 2.
функция главная() -> целое {
    целое32 слушающий_сокет = создать_сокет(целое32(2), целое32(1), целое32(0));
    если (слушающий_сокет < целое32(0)) {
        вывести("не удалось создать сокет");
        вернуть 1;
    }

    текст включено = выделить_память(4);
    записать_целое32(включено, 0, целое32(1));
    настроить_сокет(слушающий_сокет, целое32(1), целое32(2), включено, целое32(4));

    текст адрес = построить_адрес_сервера("0.0.0.0", целое32(8080));
    целое32 итог_привязки = привязать_сокет(слушающий_сокет, адрес, целое32(16));
    если (итог_привязки < целое32(0)) {
        вывести("не удалось занять порт 8080 — возможно, уже занят");
        вернуть 1;
    }

    слушать_сокет(слушающий_сокет, целое32(10));
    вывести("сайт «Сфера» слушает на http://0.0.0.0:8080");

    целое кадр = 0;
    пока (кадр < 40) {
        целое32 клиент = принять_подключение(слушающий_сокет, нулевой_указатель_сети(), нулевой_указатель_сети());
        если (клиент >= целое32(0)) {
            канал<целое32> канал_клиента = создать_канал();
            канал_клиента.отправить(клиент);

            параллельно {
                целое32 сокет_клиента = канал_клиента.получить();
                обработать_подключение(сокет_клиента);
            }
        }
        кадр = кадр + 1;
    }

    дождаться_все_потоки();
    закрыть_сокет(слушающий_сокет);
    вернуть 0;
}

функция обработать_подключение(целое32 клиент) -> целое {
    текст буфер_запроса = выделить_память(2048);
    получить_данные(клиент, буфер_запроса, 2047, целое32(0));

    текст путь = извлечь_путь(буфер_запроса);
    вывести("запрос: " + путь);

    текст ответ = обработать_запрос(путь);
    отправить_данные(клиент, ответ, длина(ответ), целое32(0));

    закрыть_сокет(клиент);
    освободить_память(буфер_запроса);
    вернуть 0;
}

// Маршрутизация — какую страницу сайта показать для какого пути. Перед
// формированием страницы обновляет счётчик посещений (через собственное
// хранилище) и передаёт его готовый HTML-фрагмент каждой странице.
функция обработать_запрос(текст путь) -> текст {
    текст счётчик_html = обновить_и_показать_счётчик();

    если (путь == "/") {
        вернуть сформировать_ответ(целое32(200), "OK", страница_главная(счётчик_html));
    }
    если (путь == "/about") {
        вернуть сформировать_ответ(целое32(200), "OK", страница_о_языке(счётчик_html));
    }
    если (путь == "/docs") {
        вернуть сформировать_ответ(целое32(200), "OK", страница_документация(счётчик_html));
    }
    вернуть сформировать_ответ(целое32(404), "Not Found", страница_404(счётчик_html));
}

функция сформировать_ответ(целое32 код, текст статус, текст тело) -> текст {
    вернуть "HTTP/1.1 " + целое_в_текст(целое(код)) + " " + статус +
        "\r\nContent-Type: text/html; charset=utf-8\r\nContent-Length: " +
        целое_в_текст(длина(тело)) + "\r\nConnection: close\r\n\r\n" + тело;
}

функция извлечь_путь(текст запрос) -> текст {
    результат<целое> первый_пробел = найти(запрос, " ");
    если (!первый_пробел.успешно) {
        вернуть "/";
    }
    целое начало_пути = первый_пробел.значение + 1;

    результат<текст> остаток_результат = подстрока(запрос, начало_пути, длина(запрос) - начало_пути);
    если (!остаток_результат.успешно) {
        вернуть "/";
    }
    текст остаток = остаток_результат.значение;

    результат<целое> второй_пробел = найти(остаток, " ");
    если (!второй_пробел.успешно) {
        вернуть "/";
    }

    результат<текст> путь_результат = подстрока(остаток, 0, второй_пробел.значение);
    если (путь_результат.успешно) {
        вернуть путь_результат.значение;
    }
    вернуть "/";
}

// ---------------------------------------------------------------------
// Счётчик посещений — маленькая, наглядная демонстрация того, что
// собственное хранилище данных (стандартная_библиотека/хранилище.код)
// реально работает внутри настоящего, живого HTTP-сервера, не только
// в изолированных примерах.
//
// ⚠️ Честно: каждый параллельный поток-обработчик независимо открывает
// и закрывает файл счётчика — при НАСТОЯЩЕЙ одновременной нагрузке
// (два запроса приходят практически синхронно) возможна гонка за
// запись, из-за которой один инкремент может потеряться. Для
// демонстрационного сайта это приемлемо; честный, правильный способ
// исправить — держать одно, общее открытое Хранилище и разграничивать
// доступ к нему (например, через мьютекс) — отдельная, следующая задача,
// не решённая сейчас.
// ---------------------------------------------------------------------
функция обновить_и_показать_счётчик() -> текст {
    результат<Хранилище> хр_результат = открыть_хранилище("посещения.db");
    если (!хр_результат.успешно) {
        вернуть "посещение не удалось посчитать";
    }
    Хранилище хр = хр_результат.значение;

    целое текущее_число = 0;
    результат<текст> прочитанное = хр.получить("количество");
    если (прочитанное.успешно) {
        результат<целое> разобранное = текст_в_целое(прочитанное.значение);
        если (разобранное.успешно) {
            текущее_число = разобранное.значение;
        }
        освободить_память(прочитанное.значение);
    }

    целое новое_число = текущее_число + 1;
    текст новое_число_текст = целое_в_текст(новое_число);
    хр.сохранить("количество", новое_число_текст);

    закрыть_хранилище(хр);

    вернуть "посещение №" + новое_число_текст;
}
