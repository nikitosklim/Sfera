// сервер.код — точка входа сайта «Сферы».
//
// Запуск (из папки сайта — пути к страницам относительные):
//   запустить сервер.код        — собрать и запустить на порту 8080
//   ./сервер [порт]             — повторный запуск без пересборки
//
// Устройство: фиксированный пул из 16 рабочих потоков, каждый в бесконечном цикле
// принимает подключения с общего слушающего сокета и обрабатывает их. Поэтому
// сервер работает неограниченно долго (прежняя версия обслуживала 40 запросов
// и завершалась), а долгая загрузка большого файла занимает только один поток.

подключить веб;
подключить сайт;
подключить статистика;
подключить внешние_статьи;
подключить пакеты;
подключить реестр;
подключить аккаунты;
подключить оценки;
подключить обновления;
подключить клиентские_модули;
подключить поиск;
подключить донаты;
подключить каталог_пакетов;
подключить управление;
подключить площадка;

функция главная(): целое
    целое порт = 8080;
    Список из текстов аргументы = аргументы_командной_строки();
    если (аргументы.размер() больше 0)
        результат из целого разобран = текст_в_целое(аргументы.получить(0));
        если (разобран.успешно и разобран.значение больше 0)
            порт = разобран.значение;
        конец
    конец

    создать_папку("данные");
    результат из целого открыт = открыть_порт(порт);
    если ( не открыт.успешно)
        вывести(открыт.сообщение);
        вернуть 1;
    конец
    целое32 слушающий = целое32(открыт.значение);
    вывести("сайт «Сфера» слушает на http://0.0.0.0:%порт%");

    канал из целое32 канал_сокета = создать_канал();
    целое рабочий = 0;
    пока (рабочий меньше 16)
        канал_сокета.отправить(слушающий);
        параллельно
            целое32 сокет_приёма = канал_сокета.получить();
            пока (да)
                целое32 клиент = принять_подключение(сокет_приёма, нулевой_указатель_сети(), нулевой_указатель_сети());
                если (клиент не меньше целое32(0))
                    обработать_подключение(клиент);
                конец
            конец
        конец
        рабочий = рабочий + 1;
    конец

    дождаться_все_потоки();
    вернуть 0;
конец

функция обработать_подключение(целое32 клиент): целое
    результат из Запрос запрос = прочитать_запрос(клиент);
    если ( не запрос.успешно)
        ответ_текстом(клиент, 400, "text/plain; charset=utf-8", "Некорректный запрос");
        закрыть_сокет(клиент);
        вернуть 0;
    конец
    Запрос з = запрос.значение;
    вывести("запрос: " + з.метод + " " + з.путь);
    текст запись_журнала = целое_в_текст(юникс_время()) + " " + з.метод + " " + з.путь + "\n";
    дописать_в_файл_бинарно("данные/access.log", запись_журнала, длина(запись_журнала));
    маршрутизировать(клиент, з);
    закрыть_сокет(клиент);
    вернуть 0;
конец

функция маршрутизировать(целое32 клиент, Запрос з): целое
    // Адрес приходит уже раскодированным (%D0%BF… -> «п…»). Русские адреса — основные,
    // прежние латинские (/docs, /static, /upload…) работают как запасные: страницы
    // перенаправляются на русский адрес (301), служебные пути отвечают сразу.
    текст сегмент = первый_сегмент(з.путь);
    текст остаток = остаток_пути(з.путь);

    если (з.метод == "PUT" и сегмент == "пакеты" и начинается_с(остаток, "публикация/"))
        вернуть принять_пакет(клиент, з, срез(остаток, 21, длина(остаток) - 21));
    конец
    если ((з.метод == "POST" или з.метод == "GET") и (сегмент == "аккаунт" или сегмент == "account") и длина(остаток) больше 0)
        вернуть обработать_аккаунт(клиент, з, остаток);
    конец
    если (з.метод == "GET" и сегмент == "материалы" и остаток == "список.txt")
        вернуть ответ_текстом(клиент, 200, "text/plain; charset=utf-8", материалы_для_панели());
    конец
    если (з.метод == "GET" и (сегмент == "обновления" или сегмент == "updates") и длина(остаток) больше 0)
        вернуть обработать_обновления(клиент, з, остаток);
    конец
    если ((з.метод == "POST" или з.метод == "GET") и сегмент == "оценки" и длина(остаток) больше 0)
        вернуть обработать_оценки(клиент, з, остаток);
    конец
    если (з.метод == "PUT" и (сегмент == "загрузить" или сегмент == "upload"))
        вернуть принять_загрузку(клиент, з, остаток);
    конец
    если (з.метод == "DELETE" и (сегмент == "загрузить" или сегмент == "upload"))
        вернуть удалить_загрузку(клиент, з, остаток);
    конец
    если (з.метод == "GET" и (сегмент == "проверка-токена" или сегмент == "upload-check"))
        если (авторизован(з))
            вернуть ответ_json(клиент, 200, "{\"ok\":true}");
        конец
        вернуть ответ_json(клиент, 401, "{\"ok\":false}");
    конец
    если (з.метод == "POST" и з.путь == "/статистика/время")
        вернуть принять_время(клиент, з);
    конец
    если (з.метод == "POST" и сегмент == "площадка")
        вернуть собрать_для_браузера(клиент, з);
    конец
    если (з.метод == "PUT" и сегмент == "управление")
        вернуть обработать_правки(клиент, з, остаток);
    конец
    если (з.метод == "POST" и сегмент == "управление")
        вернуть обработать_ссылки(клиент, з, остаток);
    конец
    если (з.метод != "GET" и з.метод != "HEAD")
        ответ_текстом(клиент, 405, "text/plain; charset=utf-8", "Метод не поддерживается");
        вернуть 0;
    конец
    текст путь = з.путь;

    если (путь == "/robots.txt")
        вернуть ответ_текстом(клиент, 200, "text/plain; charset=utf-8", текст_robots());
    конец
    если (путь == "/favicon.ico")
        если (ответ_файлом_для(клиент, з, "static/favicon.ico", "favicon.ico", нет, "public, max-age=86400"))
            вернуть 0;
        конец
    конец
    если (путь == "/sitemap.xml")
        вернуть ответ_текстом(клиент, 200, "application/xml; charset=utf-8", карта_сайта());
    конец
    если ((начинается_с(путь, "/yandex_") или начинается_с(путь, "/google")) и путь_безопасен(путь) и не содержит(срез(путь, 1, длина(путь) - 1), "/"))
        текст имя_проверки = срез(путь, 1, длина(путь) - 1);
        если (ответ_файлом_для(клиент, з, "verify/" + имя_проверки, имя_проверки, нет, "public, max-age=300"))
            вернуть 0;
        конец
    конец

    если (путь == "/")
        записать_просмотр(з, "/");
        вернуть показать_главную(клиент);
    конец

    если (сегмент == "статика" и начинается_с(остаток, "клиент/"))
        вернуть отдать_клиентский_модуль(клиент, з, срез(остаток, 13, длина(остаток) - 13));
    конец
    если (сегмент == "статика" или сегмент == "static")
        вернуть отдать_статику(клиент, з, остаток);
    конец
    если (сегмент == "файлы" или сегмент == "files")
        вернуть отдать_загрузку(клиент, з, остаток);
    конец

    если (сегмент == "управление" и (остаток == "статистика/просмотры" или остаток == "статистика/время"))
        текст что_отдать = "время";
        если (остаток == "статистика/просмотры")
            что_отдать = "просмотры";
        конец
        вернуть отдать_статистику(клиент, з, что_отдать);
    конец

    если (сегмент == "управление" и (остаток == "ссылки" или остаток == "файлы" или остаток == "аватар/состояние" или остаток == "пользователи"))
        вернуть обработать_ссылки(клиент, з, остаток);
    конец
    если ((сегмент == "пакеты" или сегмент == "packages") и остаток == "каталог.пакеты")
        вернуть отдать_каталог_пакетов(клиент);
    конец
    если (сегмент == "пакеты" и остаток == "реестр.txt")
        вернуть отдать_реестр(клиент);
    конец
    если (сегмент == "пакеты" и начинается_с(остаток, "архив/"))
        вернуть отдать_архив_пакета(клиент, з, срез(остаток, 11, длина(остаток) - 11));
    конец
    если (сегмент == "пакеты" и начинается_с(остаток, "описание/"))
        вернуть отдать_описание_пакета(клиент, срез(остаток, 17, длина(остаток) - 17));
    конец
    если (сегмент == "пакеты" и остаток == "модерация")
        вернуть показать_страницу(клиент, "Модерация пакетов", "moderation.html");
    конец
    если (сегмент == "пакеты" и остаток == "загрузить")
        вернуть показать_страницу(клиент, "Загрузить пакет", "publish.html");
    конец
    если (сегмент == "пакеты" и длина(остаток) больше 0 и пакет_в_реестре(остаток))
        Список из текстов имена_п = Список из текстов();
        Список из текстов значения_п = Список из текстов();
        имена_п.добавить("пакет");
        значения_п.добавить(страница_пакета_html(остаток));
        текст счётчик_п = обновить_и_показать_счётчик();
        текст готовая_п = страница(остаток, "package.html", счётчик_п, имена_п, значения_п);
        ответ_html(клиент, 200, готовая_п);
        освободить_память(готовая_п);
        имена_п.освободить();
        значения_п.освободить();
        вернуть 0;
    конец
    если (сегмент == "обложки")
        вернуть отдать_обложку(клиент, з, остаток);
    конец

    текст страница_имя = страница_по_сегменту(сегмент);
    если (длина(страница_имя) больше 0 и длина(остаток) == 0)
        если (сегмент != страница_имя)
            вернуть на_русский_адрес(клиент, з, "/" + страница_имя);
        конец
        вернуть показать_служебную_страницу(клиент, з, страница_имя);
    конец

    текст раздел = раздел_по_сегменту(сегмент);
    если (длина(раздел) больше 0)
        текст русский_раздел = раздел_в_адрес(раздел);
        если (длина(остаток) == 0)
            если (сегмент != русский_раздел)
                вернуть на_русский_адрес(клиент, з, "/" + русский_раздел);
            конец
            если (раздел == "lessons" или раздел == "examples")
                // Уроки и примеры теперь блоки страницы «Обучение».
                вернуть на_русский_адрес(клиент, з, "/обучение");
            конец
            записать_просмотр(з, "/" + русский_раздел);
            вернуть показать_каталог(клиент, раздел);
        конец
        текст имя_материала = найти_материал(раздел, остаток);
        если (длина(имя_материала) == 0)
            вернуть показать_страницу_с_кодом(клиент, 404, "Не найдено", "notfound.html");
        конец
        текст слаг = слаг_материала(раздел, имя_материала);
        если (сегмент != русский_раздел или остаток != слаг)
            вернуть на_русский_адрес(клиент, з, "/" + русский_раздел + "/" + слаг);
        конец
        записать_просмотр(з, "/" + русский_раздел + "/" + слаг);
        вернуть показать_материал(клиент, раздел, имя_материала);
    конец

    вернуть показать_страницу_с_кодом(клиент, 404, "Не найдено", "notfound.html");
конец

// 301 на русский адрес с сохранением параметров (?q=…).
функция на_русский_адрес(целое32 клиент, Запрос з, текст адрес): целое
    текст куда = кодировать_адрес(адрес);
    если (длина(з.параметры) больше 0)
        куда = куда + "?" + з.параметры;
    конец
    вернуть перенаправить_навсегда(клиент, куда);
конец

функция показать_служебную_страницу(целое32 клиент, Запрос з, текст имя): целое
    если (имя != "управление" и имя != "поиск-данные" и имя != "аккаунт")
        записать_просмотр(з, "/" + имя);
    конец
    если (имя == "о-языке")
        вернуть показать_страницу(клиент, "О языке", "about.html");
    конец
    если (имя == "попробовать")
        вернуть показать_страницу(клиент, "Попробовать", "try.html");
    конец
    если (имя == "обучение")
        вернуть показать_обучение(клиент);
    конец
    если (имя == "дизайн")
        вернуть показать_страницу(клиент, "Лаборатория дизайна", "design.html");
    конец
    если (имя == "вопросы")
        вернуть показать_страницу(клиент, "Вопросы", "faq.html");
    конец
    если (имя == "управление")
        вернуть показать_страницу(клиент, "Управление сайтом", "admin.html");
    конец
    если (имя == "аккаунт" или имя == "account")
        вернуть показать_страницу(клиент, "Аккаунт", "account.html");
    конец
    если (имя == "поиск")
        текст запрос_п = обрезать_края(параметр(з.параметры, "q"));
        текст выдача = выполнить_поиск(запрос_п);
        результат из целого разделитель = найти(выдача, "\n@@@\n");
        текст итог_п = выдача;
        текст html_п = "";
        если (разделитель.успешно)
            итог_п = срез(выдача, 0, разделитель.значение);
            html_п = срез(выдача, разделитель.значение + 5, длина(выдача) - разделитель.значение - 5);
        конец
        Список из текстов имена_п = Список из текстов();
        Список из текстов значения_п = Список из текстов();
        имена_п.добавить("запрос");
        значения_п.добавить(экранировать_html(запрос_п));
        имена_п.добавить("итог");
        значения_п.добавить(экранировать_html(итог_п));
        имена_п.добавить("результаты");
        значения_п.добавить(html_п);
        текст счётчик_п = обновить_и_показать_счётчик();
        текст готовая_п = страница("Поиск", "search.html", счётчик_п, имена_п, значения_п);
        ответ_html(клиент, 200, готовая_п);
        освободить_память(готовая_п);
        имена_п.освободить();
        значения_п.освободить();
        вернуть 0;
    конец
    если (имя == "пакеты")
        Список из текстов имена_к = Список из текстов();
        Список из текстов значения_к = Список из текстов();
        имена_к.добавить("каталог");
        значения_к.добавить(каталог_пакетов_html(обрезать_края(параметр(з.параметры, "q"))));
        имена_к.добавить("запрос");
        значения_к.добавить(экранировать_html(обрезать_края(параметр(з.параметры, "q"))));
        текст счётчик_к = обновить_и_показать_счётчик();
        текст готовая_к = страница("Пакеты", "packages.html", счётчик_к, имена_к, значения_к);
        ответ_html(клиент, 200, готовая_к);
        освободить_память(готовая_к);
        имена_к.освободить();
        значения_к.освободить();
        вернуть 0;
    конец
    если (имя == "поиск-данные")
        текст свой_индекс = поисковый_индекс();
        текст внешний_индекс = индекс_внешних_статей();
        текст весь_индекс = свой_индекс + внешний_индекс;
        ответ_текстом(клиент, 200, "text/plain; charset=utf-8", весь_индекс);
        вернуть 0;
    конец
    если (имя == "поддержать")
        Список из текстов имена_п = Список из текстов();
        Список из текстов значения_п = Список из текстов();
        имена_п.добавить("способы");
        текст способы = способы_поддержки();
        значения_п.добавить(способы);
        имена_п.добавить("донатеры");
        значения_п.добавить(топ_донатеров_html());
        имена_п.добавить("адрес_доната");
        текст адрес_доната = адрес_пожертвования();
        если (длина(адрес_доната) == 0)
            адрес_доната = "#о-способы";
        конец
        значения_п.добавить(экранировать_html(адрес_доната));
        текст счётчик_п = обновить_и_показать_счётчик();
        текст готовая_п = страница("Поддержать проект", "support.html", счётчик_п, имена_п, значения_п);
        ответ_html(клиент, 200, готовая_п);
        освободить_память(готовая_п);
        имена_п.освободить();
        значения_п.освободить();
        вернуть 0;
    конец
    Список из текстов имена = Список из текстов();
    Список из текстов значения = Список из текстов();
    имена.добавить("список");
    текст таблица = список_загрузок();
    значения.добавить(таблица);
    текст счётчик_текст = обновить_и_показать_счётчик();
    текст готовая = страница("Загрузки", "downloads.html", счётчик_текст, имена, значения);
    ответ_html(клиент, 200, готовая);
    освободить_память(готовая);
    имена.освободить();
    значения.освободить();
    вернуть 0;
конец

функция показать_главную(целое32 клиент): целое
    Список из текстов имена = Список из текстов();
    Список из текстов значения = Список из текстов();
    имена.добавить("статьи");
    значения.добавить(карточки_статей(3, нет));
    имена.добавить("курс");
    значения.добавить(уроки_html("курс", нет));
    имена.добавить("уроки");
    значения.добавить(уроки_html("плитки", да));
    текст счётчик_текст = обновить_и_показать_счётчик();
