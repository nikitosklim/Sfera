функция прочитать_в_словарь(текст путь, Словарь из текста и целого суммы): целое
    результат из текста файл = прочитать_файл(путь);
    если ( не файл.успешно)
        вернуть 0;
    конец
    целое всего = длина(файл.значение);
    целое позиция = 0;
    пока (позиция меньше всего)
        целое до = конец_строки(файл.значение, позиция);
        текст строка = срез(файл.значение, позиция, до - позиция);
        позиция = до + 1;
        если (строка_записи(строка))
            текст имя = поле_строки(строка, 0);
            результат из целого сумма = текст_в_целое(поле_строки(строка, 1));
            если (длина(имя) больше 0 и сумма.успешно)
                результат из целого было = суммы.получить(имя);
                если (было.успешно)
                    суммы.положить(имя, было.значение + сумма.значение);
                иначе
                    суммы.положить(имя, сумма.значение);
                конец
            конец
        конец
    конец
    вернуть 0;
конец

// 15700 → «15 700 ₽» (тонкие неразрывные пробелы).
функция рубли_текстом(целое сумма): текст
    текст цифры = целое_в_текст(сумма);
    текст итог = "";
    целое n = длина(цифры);
    целое i = 0;
    пока (i меньше n)
        итог = итог + срез(цифры, i, 1);
        целое осталось = n - i - 1;
        если (осталось больше 0 и осталось % 3 == 0)
            итог = итог + " ";
        конец
        i = i + 1;
    конец
    вернуть итог + " ₽";
конец

// Обновление в фоне, не чаще раза в полчаса и только если настроен токен.
функция обновить_при_необходимости(): целое
    результат из целого токен_размер = размер_файла("данные/donationalerts-token.txt");
    если ( не токен_размер.успешно или токен_размер.значение меньше 8)
        вернуть 0;
    конец
    результат из текста время = прочитать_файл("данные/донатеры.время");
    целое сейчас = юникс_время();
    если (время.успешно)
        результат из целого было = текст_в_целое(обрезать_края(время.значение));
        если (было.успешно и сейчас - было.значение меньше 1800)
            вернуть 0;
        конец
    конец
    записать_файл("данные/донатеры.время", целое_в_текст(сейчас));
    параллельно
        обновить_донатеров();
    конец
    вернуть 1;
конец

функция топ_донатеров_html(): текст
    обновить_при_необходимости();
    Словарь из текста и целого суммы = Словарь из текста и целого();
    прочитать_в_словарь("данные/донатеры.txt", суммы);
    прочитать_в_словарь("данные/донатеры-вручную.txt", суммы);
    текст пункты = "";
    целое выдано = 0;
    Список из целых занято = Список из целых();
    пока (выдано меньше 5 и выдано меньше суммы.размер())
        целое лучший = -1;
        целое лучшая_сумма = -1;
        целое i = 0;
        пока (i меньше суммы.размер())
            верно уже = нет;
            целое k = 0;
            пока (k меньше занято.размер())
                если (занято.получить(k) == i)
                    уже = да;
                конец
                k = k + 1;
            конец
            если ( не уже и суммы.значение_по_индексу(i) больше лучшая_сумма)
                лучшая_сумма = суммы.значение_по_индексу(i);
                лучший = i;
            конец
            i = i + 1;
        конец
        если (лучший меньше 0)
            выдано = 100;
        иначе
            занято.добавить(лучший);
            выдано = выдано + 1;
            текст имя = экранировать_html(суммы.ключ_по_индексу(лучший));
            пункты = пункты + "<li><i>" + целое_в_текст(выдано) + "</i><span>" + имя + "</span><b>" + рубли_текстом(лучшая_сумма) + "</b></li>";
        конец
    конец
    занято.освободить();
    суммы.освободить();
    если (длина(пункты) == 0)
        вернуть "<p class=\"лучшие-пусто\">Список пока пуст. Поддержите проект, и ваше имя появится здесь первым.</p>";
    конец
    вернуть "<ol class=\"лучшие-список\">" + пункты + "</ol>";
конец
