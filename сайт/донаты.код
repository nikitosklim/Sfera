// Поддержка проекта: адрес кнопки «Поддержать» и список лучших поддержавших.
//
// Данные списка:
//   данные/донатеры.txt           — «имя | сумма в рублях»; заполняется автоматически из DonationAlerts
//   данные/донатеры-вручную.txt   — тот же формат, для тех, кто поддержал не через DonationAlerts (необязательно)
//   данные/donationalerts-token.txt — OAuth-токен с правом oauth-donation-index (кладёт владелец сайта на сервере сам)
//   данные/donationalerts-адрес.txt — необязательно: другой адрес API (для проверки), по умолчанию боевой
//
// Токен нигде не показывается и в командную строку не попадает: он читается оболочкой из файла и подаётся curl через stdin.

функция адрес_api_донатов(): текст
    результат из текста файл = прочитать_файл("данные/donationalerts-адрес.txt");
    если (файл.успешно)
        текст адрес = обрезать_края(файл.значение);
        если (начинается_с_текста(адрес, "http://") или начинается_с_текста(адрес, "https://"))
            вернуть адрес;
        конец
    конец
    вернуть "https://www.donationalerts.com/api/v1/alerts/donations";
конец

// Ссылка кнопки «Поддержать»: первая ссылка из support-links.txt с donationalerts, иначе первая https-ссылка.
функция адрес_пожертвования(): текст
    результат из текста список = прочитать_файл("support-links.txt");
    текст первая = "";
    если (список.успешно)
        целое всего = длина(список.значение);
        целое позиция = 0;
        пока (позиция меньше всего)
            целое до = конец_строки(список.значение, позиция);
            текст строка = срез(список.значение, позиция, до - позиция);
            позиция = до + 1;
            если (строка_записи(строка))
                текст адрес = поле_строки(строка, 1);
                если (начинается_с_текста(адрес, "https://") или начинается_с_текста(адрес, "http://"))
                    если (содержит(регистр_в_нижний(адрес), "donationalerts"))
                        вернуть адрес;
                    конец
                    если (длина(первая) == 0)
                        первая = адрес;
                    конец
                конец
            конец
        конец
    конец
    вернуть первая;
конец

// ------------------------------------------------------------ разбор JSON ответа DonationAlerts

функция шестнадцатеричная_цифра(целое б): целое
    если (б не меньше 48 и б не больше 57)
        вернуть б - 48;
    конец
    если (б не меньше 97 и б не больше 102)
        вернуть б - 87;
    конец
    если (б не меньше 65 и б не больше 70)
        вернуть б - 55;
    конец
    вернуть -1;
конец

функция ascii_таблица(): текст
    вернуть " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~";
конец

функция кириллица_таблица(): текст
    вернуть "АБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯабвгдежзийклмнопрстуфхцчшщъыьэюя";
конец

// Символ по коду Юникода: ASCII и русские буквы, остальное — «?» (суррогаты пропускаются).
функция символ_по_коду(целое код): текст
    если (код не меньше 32 и код не больше 126)
        вернуть срез(ascii_таблица(), код - 32, 1);
    конец
    если (код не меньше 1040 и код не больше 1103)
        вернуть срез(кириллица_таблица(), (код - 1040) * 2, 2);
    конец
    если (код == 1025)
        вернуть "Ё";
    конец
    если (код == 1105)
        вернуть "ё";
    конец
    если (код не меньше 55296 и код не больше 57343)
        вернуть "";
    конец
    если (код == 9 или код == 10 или код == 13)
        вернуть " ";
    конец
    вернуть "?";
конец

// Читает строку JSON, начиная сразу после открывающей кавычки; пишет в «следующая» позицию после закрывающей.
функция прочитать_json_строку(текст json, целое старт, Список из целых следующая): текст
    текст итог = "";
    целое n = длина(json);
    целое i = старт;
    верно идём = да;
    пока (идём и i меньше n)
        целое б = целое(байт_текста(json, i));
        если (б == 34)
            идём = нет;
            i = i + 1;
        иначе если (б == 92 и i + 1 меньше n)
            целое после_косой = целое(байт_текста(json, i + 1));
            если (после_косой == 117 и i + 5 меньше n)
                целое код = шестнадцатеричная_цифра(целое(байт_текста(json, i + 2))) * 4096 + шестнадцатеричная_цифра(целое(байт_текста(json, i + 3))) * 256 + шестнадцатеричная_цифра(целое(байт_текста(json, i + 4))) * 16 + шестнадцатеричная_цифра(целое(байт_текста(json, i + 5)));
                итог = итог + символ_по_коду(код);
                i = i + 6;
            иначе
                если (после_косой == 34)
                    итог = итог + "\"";
                иначе если (после_косой == 92)
                    итог = итог + "\\";
                иначе если (после_косой == 47)
                    итог = итог + "/";
                иначе
                    итог = итог + " ";
                конец
                i = i + 2;
            конец
        иначе
            // обычный байт копируем как есть вместе со следующими байтами многобайтового символа
            итог = итог + срез(json, i, 1);
            i = i + 1;
        конец
    конец
    следующая.добавить(i);
    вернуть итог;
конец

// Целая часть числа после «"amount":».
функция прочитать_сумму(текст json, целое старт): целое
    целое n = длина(json);
    целое i = старт;
    пока (i меньше n и целое(байт_текста(json, i)) == 34)
        i = i + 1;
    конец
    целое сумма = 0;
    верно идём = да;
    пока (идём и i меньше n)
        целое б = целое(байт_текста(json, i));
        если (б не меньше 48 и б не больше 57)
            сумма = сумма * 10 + (б - 48);
            i = i + 1;
        иначе
            идём = нет;
        конец
    конец
    вернуть сумма;
конец

функция безопасное_имя(текст имя): текст
    текст чистое = обрезать_края(имя);
    если (длина(чистое) == 0)
        вернуть "Аноним";
    конец
    если (длина(чистое) больше 60)
        чистое = срез(чистое, 0, 60);
    конец
    вернуть чистое;
конец

// Позиция значения ключа: ищет «"ключ"» начиная с «от», пропускает «:» и пробелы. -1, если ключа нет.
функция значение_ключа(текст json, текст ключ, целое от): целое
    результат из целого п = найти(срез(json, от, длина(json) - от), "\"" + ключ + "\"");
    если ( не п.успешно)
        вернуть -1;
    конец
    целое i = от + п.значение + длина(ключ) + 2;
    целое n = длина(json);
    пока (i меньше n и (целое(байт_текста(json, i)) == 58 или целое(байт_текста(json, i)) == 32))
        i = i + 1;
    конец
    вернуть i;
конец

// Добавляет в словарь суммы из одной страницы ответа API (только рубли). Возвращает, сколько донатов найдено.
функция учесть_страницу(текст json, Словарь из текста и целого суммы): целое
    целое найдено = 0;
    целое позиция = 0;
    верно идём = да;
    пока (идём)
        целое имя_от = значение_ключа(json, "username", позиция);
        если (имя_от меньше 0)
            идём = нет;
        иначе
            целое начало_имени = имя_от;
            если (начало_имени меньше длина(json) и целое(байт_текста(json, начало_имени)) == 34)
                начало_имени = начало_имени + 1;
            конец
            Список из целых после = Список из целых();
            текст имя = безопасное_имя(прочитать_json_строку(json, начало_имени, после));
            целое конец_имени = после.получить(0);
            после.освободить();
            целое сумма_от = значение_ключа(json, "amount", конец_имени);
            целое валюта_от = значение_ключа(json, "currency", конец_имени);
            целое следующий = значение_ключа(json, "username", конец_имени);
            позиция = конец_имени;
            если (сумма_от не меньше 0 и валюта_от не меньше 0)
                // сумма и валюта должны принадлежать этому же донату, то есть стоять раньше следующего имени
                верно в_этом_донате = да;
                если (следующий не меньше 0)
                    в_этом_донате = сумма_от меньше следующий и валюта_от меньше следующий;
                конец
                если (в_этом_донате)
                    целое сумма = прочитать_сумму(json, сумма_от);
                    целое от_валюты = валюта_от;
                    если (от_валюты меньше длина(json) и целое(байт_текста(json, от_валюты)) == 34)
                        от_валюты = от_валюты + 1;
                    конец
                    текст валюта = срез(json, от_валюты, 3);
                    найдено = найдено + 1;
                    если (валюта == "RUB")
                        результат из целого было = суммы.получить(имя);
                        если (было.успешно)
                            суммы.положить(имя, было.значение + сумма);
                        иначе
                            суммы.положить(имя, сумма);
                        конец
                    конец
                конец
            конец
        конец
    конец
    вернуть найдено;
конец

