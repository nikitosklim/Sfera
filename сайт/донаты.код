функция без_черты(текст имя): текст
    текст итог = "";
    целое i = 0;
    пока (i меньше длина(имя))
        если (целое(байт_текста(имя, i)) == 124)
            итог = итог + "/";
        иначе
            итог = итог + срез(имя, i, 1);
        конец
        i = i + 1;
    конец
    вернуть итог;
конец

функция записать_список_донатеров(Словарь из текста и целого суммы): целое
    текст содержимое = "# Автоматически собрано из DonationAlerts. Формат: имя | сумма в рублях\n";
    целое i = 0;
    пока (i меньше суммы.размер())
        текст имя = суммы.ключ_по_индексу(i);
        целое сумма = суммы.значение_по_индексу(i);
        текст чистое = без_черты(имя);
        содержимое = содержимое + чистое + " | " + целое_в_текст(сумма) + "\n";
        i = i + 1;
    конец
    записать_файл("данные/донатеры.txt.new", содержимое);
    переименовать_файл("данные/донатеры.txt.new", "данные/донатеры.txt");
    вернуть суммы.размер();
конец

// Скачивает донаты постранично и пересобирает данные/донатеры.txt. Возвращает число записей или -1 при ошибке.
функция обновить_донатеров(): целое
    результат из целого токен_размер = размер_файла("данные/donationalerts-token.txt");
    если ( не токен_размер.успешно или токен_размер.значение меньше 8)
        вернуть -1;
    конец
    текст адрес = адрес_api_донатов();
    Словарь из текста и целого суммы = Словарь из текста и целого();
    целое страница = 1;
    верно идём = да;
    верно сбой = нет;
    пока (идём и страница не больше 20)
        текст файл = "данные/da-страница.json";
        выполнить_команду("rm -f '" + файл + "'");
        текст команда = "printf 'header = \"Authorization: Bearer %s\"\\n' \"$(tr -d '\\r\\n ' < 'данные/donationalerts-token.txt')\" | curl -sS -m 20 -K - -H 'Accept: application/json' -o '" + файл + "' '" + адрес + "?page=" + целое_в_текст(страница) + "' 2>/dev/null";
        результат из целого р = выполнить_команду(команда);
        результат из текста ответ = прочитать_файл(файл);
        если ( не р.успешно или р.значение != 0 или не ответ.успешно)
            сбой = да;
            идём = нет;
        иначе
            целое найдено = учесть_страницу(ответ.значение, суммы);
            если (найдено == 0)
                идём = нет;
            конец
            страница = страница + 1;
        конец
    конец
    выполнить_команду("rm -f 'данные/da-страница.json'");
    записать_файл("данные/донатеры.время", целое_в_текст(юникс_время()));
    если (сбой и суммы.размер() == 0)
        суммы.освободить();
        вернуть -1;
    конец
    целое итого = записать_список_донатеров(суммы);
    суммы.освободить();
    вернуть итого;
конец

