// хранилище.код — первый, скромный шаг к собственной, полностью
// независимой системе хранения данных, написанной на самом языке
// "Сфера" — без единой внешней библиотеки (в отличие от
// стандартная_библиотека/база_данных.код, которая обёртывает SQLite
// через FFI — временное, стартовое решение, о котором сказано честно
// прямо в её собственных комментариях).
//
// ⚠️ Честно, узко: это НЕ замена SQLite и не претендует на это —
// простое хранилище "ключ → значение", не полноценная реляционная база
// с SQL-запросами, индексами, транзакциями. Формат — append-only лог
// (тот же принцип, что лежит в основе Bitcask и многих других простых,
// надёжных хранилищ): каждое изменение просто ДОПИСЫВАЕТСЯ в конец
// файла, ничего не перезаписывается на месте. Поиск значения по ключу
// сканирует файл целиком (O(n) на каждый запрос) — простое, понятное
// первое решение, не самое быстрое. Ускорение (индекс в памяти,
// компактификация старых записей) — честно оставлено для следующего,
// отдельного шага, не сделано сейчас.
//
// Формат одной записи в файле (всё — обычные байты, без выравнивания):
//   [4 байта: длина ключа]   [ключ]
//   [4 байта: длина значения][значение]
//   [4 байта: флаг удаления] — 0 = обычная запись, 1 = "ключ удалён"
//   (⚠️ 4 байта, не 1 — потому что читается/пишется теми же 4-байтными
//   прочитать_целое32/записать_целое32, что и остальные числа в записи;
//   использование 1 байта тут при 4-байтном чтении/записи было реальной,
//   найденной ошибкой — переполнением буфера на 3 байта, см. подробности
//   в ИСТОРИЯ_РАЗРАБОТКИ.md).
//
// Каждая запись самодостаточна — размер следующей записи всегда можно
// вычислить, зная только её начало, что и позволяет сканировать файл
// последовательно от начала до конца без отдельного индекса.

подключить память;

// НОВОЕ: флаг "ключ найден, но эта конкретная запись — tombstone
// (удаление)" нужен ВНУТРИ сканирования — обычный результат<текст>
// не различает "ключа никогда не было" и "ключ был, но удалён", а нам
// это различие важно (иначе после удаления get() снова находил бы уже
// неактуальное, самое старое значение того же ключа).
структура НайденнаяЗапись {
    верно найдена;
    верно удалена;
    текст значение;
    целое размер_значения;
}

// Сохраняет пару ключ-значение — дописывает новую запись в конец файла.
// Если ключ уже существовал раньше — старое значение НЕ удаляется и не
// перезаписывается физически (append-only), просто при следующем
// получить() найдётся именно эта, самая свежая запись (сканирование
// идёт от начала, и совпадения по ключу перезатирают предыдущий
// найденный результат).
функция сохранить(текст путь_к_файлу, текст ключ, текст значение) -> результат<верно> {
    целое длина_ключа = длина(ключ);
    целое длина_значения = длина(значение);
    целое размер_записи = 4 + длина_ключа + 4 + длина_значения + 4;

    текст запись = выделить_память(размер_записи);
    записать_целое32(запись, 0, целое32(длина_ключа));
    // НОВОЕ: "скопировать_память" копирует НАЧИНАЯ РОВНО с переданного
    // адреса назначения — если передать сам "запись" (начало буфера), она
    // затёрла бы только что записанные 4 байта длины ключа. Нужен адрес
    // СО СМЕЩЕНИЕМ — "прочитать_текст_по_смещению" именно ВЫЧИСЛЯЕТ такой
    // адрес (буфер + смещение), не читая память по нему — ровно то, что
    // нужно здесь как "указатель, куда копировать".
    текст адрес_ключа = прочитать_текст_по_смещению(запись, 4);
    скопировать_память(адрес_ключа, ключ, длина_ключа);

    целое смещение_длины_значения = 4 + длина_ключа;
    записать_целое32(запись, смещение_длины_значения, целое32(длина_значения));

    целое смещение_значения = смещение_длины_значения + 4;
    текст адрес_значения = прочитать_текст_по_смещению(запись, смещение_значения);
    скопировать_память(адрес_значения, значение, длина_значения);

    целое смещение_флага = смещение_значения + длина_значения;
    записать_целое32(запись, смещение_флага, целое32(0));

    результат<верно> итог = дописать_в_файл_бинарно(путь_к_файлу, запись, размер_записи);
    освободить_память(запись);
    вернуть итог;
}

// Ищет значение по ключу — сканирует файл от начала до конца, запоминая
// ПОСЛЕДНЮЮ найденную запись с совпадающим ключом (более поздняя запись
// того же ключа "перекрывает" более раннюю — так append-only лог
// реализует обновление значения без перезаписи файла на месте).
//
// ⚠️ Возвращённое при успехе значение (.значение) — свежий, отдельный
// malloc-буфер (копия найденных данных, не ссылка внутрь файла) — тот
// же принцип, что и у прочитать_файл(): вызывающая сторона сама решает,
// когда он больше не нужен, и освобождает его через освободить_память(...),
// если собирается работать дальше и не хочет копить память. Внутренний,
// временный буфер самого файла (то, что физически прочитано с диска)
// компилятор освобождает автоматически при выходе из этой функции —
// проверено отдельно, по каждому пути возврата, через valgrind.
функция получить(текст путь_к_файлу, текст ключ) -> результат<текст> {
    результат<текст> файл_результат = прочитать_файл(путь_к_файлу);
    если (!файл_результат.успешно) {
        вернуть ошибка("файл хранилища не найден или не читается");
    }
    текст содержимое = файл_результат.значение;

    результат<целое> размер_результат = размер_файла(путь_к_файлу);
    если (!размер_результат.успешно) {
        вернуть ошибка("не удалось узнать размер файла хранилища");
    }
    целое размер_файла_байт = размер_результат.значение;
    целое длина_искомого_ключа = длина(ключ);

    верно найдена = нет;
    верно последняя_запись_удалена = нет;
    текст последнее_значение = "";
    целое последний_размер_значения = 0;

    целое смещение = 0;
    пока (смещение < размер_файла_байт) {
        целое32 длина_ключа32 = прочитать_целое32(содержимое, смещение);
        целое длина_ключа_записи = целое(длина_ключа32);
        текст адрес_ключа = прочитать_текст_по_смещению(содержимое, смещение + 4);

        целое смещение_длины_значения = смещение + 4 + длина_ключа_записи;
        целое32 длина_значения32 = прочитать_целое32(содержимое, смещение_длины_значения);
        целое длина_значения_записи = целое(длина_значения32);
        целое смещение_значения = смещение_длины_значения + 4;
        текст адрес_значения = прочитать_текст_по_смещению(содержимое, смещение_значения);

        целое смещение_флага = смещение_значения + длина_значения_записи;
        целое32 флаг = прочитать_целое32(содержимое, смещение_флага);

        если (длина_ключа_записи == длина_искомого_ключа) {
            целое32 совпадение = сравнить_память(адрес_ключа, ключ, длина_искомого_ключа);
            если (совпадение == целое32(0)) {
                найдена = да;
                последняя_запись_удалена = (флаг == целое32(1));
                последнее_значение = адрес_значения;
                последний_размер_значения = длина_значения_записи;
            }
        }

        смещение = смещение_флага + 4;
    }

    если (!найдена || последняя_запись_удалена) {
        вернуть ошибка("ключ не найден");
    }

    результат<текст> копия_результат = подстрока(последнее_значение, 0, последний_размер_значения);
    если (копия_результат.успешно) {
        вернуть успех(копия_результат.значение);
    }
    вернуть ошибка("не удалось скопировать найденное значение");
}

// Удаляет ключ — дописывает "запись-надгробие" (tombstone) с флагом 1 и
// пустым значением. Сама запись физически не стирается из файла (то же
// правило append-only, что и в "сохранить") — просто при следующем
// получить() эта, самая свежая запись будет распознана как удаление.
функция удалить(текст путь_к_файлу, текст ключ) -> результат<верно> {
    целое длина_ключа = длина(ключ);
    целое размер_записи = 4 + длина_ключа + 4 + 4;

    текст запись = выделить_память(размер_записи);
    записать_целое32(запись, 0, целое32(длина_ключа));
    текст адрес_ключа = прочитать_текст_по_смещению(запись, 4);
    скопировать_память(адрес_ключа, ключ, длина_ключа);

    целое смещение_длины_значения = 4 + длина_ключа;
    записать_целое32(запись, смещение_длины_значения, целое32(0));

    целое смещение_флага = смещение_длины_значения + 4;
    записать_целое32(запись, смещение_флага, целое32(1));

    результат<верно> итог = дописать_в_файл_бинарно(путь_к_файлу, запись, размер_записи);
    освободить_память(запись);
    вернуть итог;
}

// НОВОЕ: "Хранилище" — та же модель данных, что и свободные функции выше
// (сохранить/получить/удалить), но с индексом "ключ → позиция в файле",
// который держится В ПАМЯТИ, пока хранилище открыто — вместо сканирования
// ВСЕГО файла при каждом запросе (как делают свободные функции), поиск
// значения становится мгновенным (прямое обращение к Словарю), а с диска
// читается только сама нужная запись, через прочитать_часть_файла.
// ⚠️ Компромисс: индекс живёт только в памяти текущего процесса — при
// каждом открыть_хранилище(путь) он строится заново, сканированием файла
// один раз целиком (это по-прежнему O(n), но однократно, не на каждый
// запрос).
структура Хранилище {
    текст путь;
    // Смещение начала записи в файле для каждого ключа; -1 — ключ был
    // удалён (запись-tombstone существует в файле, но искать её незачем).
    Словарь<текст, целое> индекс_смещений;
    // Полная длина записи (для точного, однократного чтения нужного
    // диапазона байт — без этого пришлось бы либо гадать, сколько
    // читать, либо читать в два прохода).
    Словарь<текст, целое> индекс_длин;

    // Ищет значение по ключу — без единого сканирования файла: прямое
    // обращение к индексу в памяти, затем ровно одно точечное чтение с
    // диска (через прочитать_часть_файла) вместо чтения всего файла.
    функция получить(текст ключ) -> результат<текст> {
        результат<целое> смещение_результат = это.индекс_смещений.получить(ключ);
        если (!смещение_результат.успешно) {
            вернуть ошибка("ключ не найден");
        }
        целое смещение = смещение_результат.значение;
        если (смещение == 0 - 1) {
            вернуть ошибка("ключ не найден");
        }

        результат<целое> размер_результат = это.индекс_длин.получить(ключ);
        если (!размер_результат.успешно) {
            вернуть ошибка("повреждён внутренний индекс хранилища");
        }
        целое размер_записи = размер_результат.значение;

        результат<текст> часть_результат = прочитать_часть_файла(это.путь, смещение, размер_записи);
        если (!часть_результат.успешно) {
            вернуть ошибка("не удалось прочитать запись из файла хранилища");
        }
        текст запись = часть_результат.значение;

        целое32 длина_ключа32 = прочитать_целое32(запись, 0);
        целое длина_ключа_записи = целое(длина_ключа32);
        целое смещение_длины_значения = 4 + длина_ключа_записи;
        целое32 длина_значения32 = прочитать_целое32(запись, смещение_длины_значения);
        целое длина_значения_записи = целое(длина_значения32);
        целое смещение_значения = смещение_длины_значения + 4;
        текст адрес_значения = прочитать_текст_по_смещению(запись, смещение_значения);

        результат<текст> копия_результат = подстрока(адрес_значения, 0, длина_значения_записи);
        освободить_память(запись);
        если (копия_результат.успешно) {
            вернуть успех(копия_результат.значение);
        }
        вернуть ошибка("не удалось скопировать найденное значение");
    }

    // Сохраняет пару ключ-значение — дописывает запись в файл (как и
    // свободная функция "сохранить" выше), но дополнительно сразу
    // обновляет индекс в памяти, чтобы следующий получить() для этого
    // же ключа нашёл именно её, без повторного сканирования файла.
    функция сохранить(текст ключ, текст значение) -> результат<верно> {
        результат<целое> текущий_размер = размер_файла(это.путь);
        целое смещение_новой_записи = 0;
        если (текущий_размер.успешно) {
            смещение_новой_записи = текущий_размер.значение;
        }

        целое длина_ключа = длина(ключ);
        целое длина_значения = длина(значение);
        целое размер_записи = 4 + длина_ключа + 4 + длина_значения + 4;

        текст запись = выделить_память(размер_записи);
        записать_целое32(запись, 0, целое32(длина_ключа));
        текст адрес_ключа = прочитать_текст_по_смещению(запись, 4);
        скопировать_память(адрес_ключа, ключ, длина_ключа);

        целое смещение_длины_значения = 4 + длина_ключа;
        записать_целое32(запись, смещение_длины_значения, целое32(длина_значения));
        целое смещение_значения = смещение_длины_значения + 4;
        текст адрес_значения = прочитать_текст_по_смещению(запись, смещение_значения);
        скопировать_память(адрес_значения, значение, длина_значения);

        целое смещение_флага = смещение_значения + длина_значения;
        записать_целое32(запись, смещение_флага, целое32(0));

        результат<верно> итог = дописать_в_файл_бинарно(это.путь, запись, размер_записи);
        освободить_память(запись);
        если (!итог.успешно) {
            вернуть итог;
        }

        это.индекс_смещений.положить(ключ, смещение_новой_записи);
        это.индекс_длин.положить(ключ, размер_записи);
        вернуть успех(да);
    }

    // Удаляет ключ — дописывает tombstone-запись в файл (как и свободная
    // функция "удалить" выше), помечает ключ в индексе смещением -1,
    // чтобы получить() отвечал "не найден" мгновенно, не читая диск.
    функция удалить(текст ключ) -> результат<верно> {
        целое длина_ключа = длина(ключ);
        целое размер_записи = 4 + длина_ключа + 4 + 4;

        текст запись = выделить_память(размер_записи);
        записать_целое32(запись, 0, целое32(длина_ключа));
        текст адрес_ключа = прочитать_текст_по_смещению(запись, 4);
        скопировать_память(адрес_ключа, ключ, длина_ключа);

        целое смещение_длины_значения = 4 + длина_ключа;
        записать_целое32(запись, смещение_длины_значения, целое32(0));

        целое смещение_флага = смещение_длины_значения + 4;
        записать_целое32(запись, смещение_флага, целое32(1));

        результат<верно> итог = дописать_в_файл_бинарно(это.путь, запись, размер_записи);
        освободить_память(запись);
        если (!итог.успешно) {
            вернуть итог;
        }

        это.индекс_смещений.положить(ключ, 0 - 1);
        вернуть успех(да);
    }
}

// Открывает хранилище — строит индекс "ключ → позиция в файле" одним
// проходом по файлу (если он уже существует; если нет — начинает с
// пустого индекса, это не ошибка, а просто новая, ещё пустая база).
функция открыть_хранилище(текст путь) -> результат<Хранилище> {
    Хранилище хр = Хранилище(путь, Словарь<текст, целое>(), Словарь<текст, целое>());

    результат<текст> файл_результат = прочитать_файл(путь);
    если (!файл_результат.успешно) {
        вернуть успех(хр);
    }
    текст содержимое = файл_результат.значение;

    результат<целое> размер_результат = размер_файла(путь);
    если (!размер_результат.успешно) {
        вернуть ошибка("не удалось узнать размер файла хранилища");
    }
    целое размер_файла_байт = размер_результат.значение;

    целое смещение = 0;
    пока (смещение < размер_файла_байт) {
        целое смещение_начала_записи = смещение;

        целое32 длина_ключа32 = прочитать_целое32(содержимое, смещение);
        целое длина_ключа_записи = целое(длина_ключа32);
        текст адрес_ключа = прочитать_текст_по_смещению(содержимое, смещение + 4);

        целое смещение_длины_значения = смещение + 4 + длина_ключа_записи;
        целое32 длина_значения32 = прочитать_целое32(содержимое, смещение_длины_значения);
        целое длина_значения_записи = целое(длина_значения32);
        целое смещение_значения = смещение_длины_значения + 4;

        целое смещение_флага = смещение_значения + длина_значения_записи;
        целое32 флаг = прочитать_целое32(содержимое, смещение_флага);

        целое размер_этой_записи = смещение_флага + 4 - смещение_начала_записи;

        результат<текст> ключ_копия = подстрока(адрес_ключа, 0, длина_ключа_записи);
        если (ключ_копия.успешно) {
            если (флаг == целое32(1)) {
                хр.индекс_смещений.положить(ключ_копия.значение, 0 - 1);
            } иначе {
                хр.индекс_смещений.положить(ключ_копия.значение, смещение_начала_записи);
                хр.индекс_длин.положить(ключ_копия.значение, размер_этой_записи);
            }
        }

        смещение = смещение_флага + 4;
    }

    вернуть успех(хр);
}

// Закрывает хранилище — освобождает оба внутренних индекса (Словарь),
// которые сами никогда не освобождаются автоматически (см. подробное
// объяснение у метода Словарь<...>.освободить()). Вызывать, когда
// хранилище больше не нужно и программа продолжает работать дальше —
// если процесс сразу завершается, вызывать необязательно (ОС забирает
// всю память процесса при выходе в любом случае).
функция закрыть_хранилище(Хранилище хр) -> целое {
    хр.индекс_смещений.освободить();
    хр.индекс_длин.освободить();
    вернуть 0;
}

// Компактификация — переписывает файл, оставляя только самые свежие
// записи (по одной на ключ), выбрасывая устаревшие, перезаписанные
// значения и записи-tombstone от удалённых ключей. Со временем
// append-only лог растёт даже для небольшого количества ключей (каждое
// обновление добавляет новую запись, не заменяет старую) — эта функция
// периодически возвращает файл к минимальному, актуальному размеру.
//
// ⚠️ Не требует перебора самого Словаря (язык этого пока не умеет) —
// вместо этого пересканирует файл (та же логика, что и открыть_хранилище)
// и для каждой встреченной записи проверяет: совпадает ли ЕЁ смещение с
// тем, что прямо сейчас хранится в индексе для этого ключа. Совпадает —
// значит это и есть самая свежая версия (записи-tombstone никогда не
// совпадают: их собственное смещение в индексе всегда -1, не совпадает
// ни с одним реальным смещением в файле) — сохраняем её в новый файл.
функция сжать_хранилище(Хранилище хр) -> результат<Хранилище> {
    результат<текст> файл_результат = прочитать_файл(хр.путь);
    если (!файл_результат.успешно) {
        // Нечего сжимать — файла ещё нет.
        вернуть успех(хр);
    }
    текст содержимое = файл_результат.значение;

    результат<целое> размер_результат = размер_файла(хр.путь);
    если (!размер_результат.успешно) {
        вернуть ошибка("не удалось узнать размер файла хранилища");
    }
    целое размер_файла_байт = размер_результат.значение;

    текст временный_путь = хр.путь + ".временный_сжатый";
    // Гарантированно пустое начало — если этот файл случайно остался от
    // предыдущего, прерванного посередине сжатия запуска, дописывание
    // (append) добавило бы к его старому содержимому, а не заменило его.
    записать_файл(временный_путь, "");

    Словарь<текст, целое> новый_индекс_смещений = Словарь<текст, целое>();
    Словарь<текст, целое> новый_индекс_длин = Словарь<текст, целое>();

    целое смещение = 0;
    пока (смещение < размер_файла_байт) {
        целое смещение_начала_записи = смещение;

        целое32 длина_ключа32 = прочитать_целое32(содержимое, смещение);
        целое длина_ключа_записи = целое(длина_ключа32);
        текст адрес_ключа = прочитать_текст_по_смещению(содержимое, смещение + 4);

        целое смещение_длины_значения = смещение + 4 + длина_ключа_записи;
        целое32 длина_значения32 = прочитать_целое32(содержимое, смещение_длины_значения);
        целое длина_значения_записи = целое(длина_значения32);
        целое смещение_значения = смещение_длины_значения + 4;

        целое смещение_флага = смещение_значения + длина_значения_записи;
        целое размер_этой_записи = смещение_флага + 4 - смещение_начала_записи;

        результат<текст> ключ_копия = подстрока(адрес_ключа, 0, длина_ключа_записи);
        если (ключ_копия.успешно) {
            результат<целое> смещение_в_индексе = хр.индекс_смещений.получить(ключ_копия.значение);
            если (смещение_в_индексе.успешно && смещение_в_индексе.значение == смещение_начала_записи) {
                // Это самая свежая версия ключа — переносим запись как
                // есть, целиком (включая флаг), в конец нового файла.
                результат<целое> текущий_размер_нового = размер_файла(временный_путь);
                целое новое_смещение = 0;
                если (текущий_размер_нового.успешно) {
                    новое_смещение = текущий_размер_нового.значение;
                }

                текст адрес_записи = прочитать_текст_по_смещению(содержимое, смещение_начала_записи);
                дописать_в_файл_бинарно(временный_путь, адрес_записи, размер_этой_записи);

                новый_индекс_смещений.положить(ключ_копия.значение, новое_смещение);
                новый_индекс_длин.положить(ключ_копия.значение, размер_этой_записи);
                // "ключ_копия.значение" теперь принадлежит новому индексу
                // (тот же принцип, что и в открыть_хранилище) — не
                // освобождаем.
            } иначе {
                // Устаревшая запись или запись уже удалённого ключа —
                // пропускаем. "ключ_копия" — result<текст> переменная,
                // владеющая своим значением (создана через подстрока) —
                // компилятор освободит её сам при выходе из этой итерации
                // цикла (ARC для result<текст>); ручное освобождение здесь
                // было бы избыточным, повторным (double free) — та же
                // ошибка, что уже была найдена и исправлена в получить().
            }
        }

        смещение = смещение_флага + 4;
    }

    результат<верно> итог_замены = переименовать_файл(временный_путь, хр.путь);
    если (!итог_замены.успешно) {
        новый_индекс_смещений.освободить();
        новый_индекс_длин.освободить();
        вернуть ошибка("не удалось заменить файл хранилища сжатой версией");
    }

    хр.индекс_смещений.освободить();
    хр.индекс_длин.освободить();

    Хранилище новое_хр = Хранилище(хр.путь, новый_индекс_смещений, новый_индекс_длин);
    вернуть успех(новое_хр);
}
