// клиентские_модули.код — программы на Сфере для страниц сайта.
// Исходники лежат в сайт/клиент/<имя>.код, сервер собирает их в WebAssembly (с режимом --wasm-хост)
// и отдаёт по адресу /статика/клиент/<имя>.wasm; на странице их запускает static/сфера-хост.js.
// Готовая сборка хранится в данные/клиент/ и пересобирается, когда исходник новее. Нужна та же настройка,
// что и для площадки: путь к компилятору в данные/компилятор.txt. Если сборка недоступна, загрузчик
// включает запасной JS-скрипт страницы.

подключить веб;

// Допустимое имя модуля: буквы, цифры и «_», без путей.
функция имя_модуля_допустимо(текст имя): верно
    если (длина(имя) == 0 или длина(имя) больше 40)
        вернуть нет;
    конец
    если (содержит(имя, "/") или содержит(имя, "\\") или содержит(имя, "..") или содержит(имя, "'") или содержит(имя, " "))
        вернуть нет;
    конец
    вернуть да;
конец

// GET /статика/клиент/<имя>.wasm
функция отдать_клиентский_модуль(целое32 клиент, Запрос з, текст файл): целое
    если (длина(файл) меньше 6 или срез(файл, длина(файл) - 5, 5) != ".wasm")
        вернуть ответ_ошибка(клиент, 404, "не найдено");
    конец
    текст имя = срез(файл, 0, длина(файл) - 5);
    если ( не имя_модуля_допустимо(имя))
        вернуть ответ_ошибка(клиент, 404, "не найдено");
    конец
    текст исходник = "клиент/" + имя + ".код";
    текст готовый = "данные/клиент/" + имя + ".wasm";
    результат из целого есть_исходник = размер_файла(исходник);
    если ( не есть_исходник.успешно)
        вернуть ответ_ошибка(клиент, 404, "не найдено");
    конец
    результат из целого устарел = выполнить_команду("[ -f '" + готовый + "' ] && [ ! '" + исходник + "' -nt '" + готовый + "' ]");
    если ( не устарел.успешно или устарел.значение != 0)
        результат из текста настройка = прочитать_файл("данные/компилятор.txt");
        если ( не настройка.успешно или длина(обрезать_края(настройка.значение)) == 0)
            вернуть ответ_ошибка(клиент, 503, "компилятор для клиентских модулей не настроен");
        конец
        текст компилятор = обрезать_края(настройка.значение);
        если (содержит(компилятор, "'") или содержит(компилятор, "\n"))
            вернуть ответ_ошибка(клиент, 503, "компилятор настроен неверно");
        конец
        текст папка = "данные/клиент/сборка-" + целое_в_текст(монотонное_время_нс());
        выполнить_команду("mkdir -p '" + папка + "' && cp '" + исходник + "' '" + папка + "/'");
        результат из целого р = выполнить_команду("cd '" + папка + "' && (ulimit -v 3000000; timeout 60 '" + компилятор + "' '" + имя + ".код' -c --целевая-платформа wasm32-wasi --wasm-хост > вывод.txt 2>&1) && mv '" + имя + "' ../'" + имя + ".wasm'");
        текст сообщение_сборки = "";
        если ( не р.успешно или р.значение != 0)
            результат из текста вывод = прочитать_файл(папка + "/вывод.txt");
            если (вывод.успешно)
                сообщение_сборки = вывод.значение;
            конец
        конец
        выполнить_команду("rm -rf '" + папка + "'");
        если (длина(сообщение_сборки) больше 0 или не р.успешно или р.значение != 0)
            вернуть ответ_ошибка(клиент, 500, "не удалось собрать модуль");
        конец
    конец
    если (ответ_файлом_для(клиент, з, готовый, имя + ".wasm", нет, "no-cache"))
        вернуть 0;
    конец
    вернуть ответ_ошибка(клиент, 500, "не удалось отдать модуль");
конец
