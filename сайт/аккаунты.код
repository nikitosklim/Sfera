// аккаунты.код — пользователи сайта: регистрация, вход, сессии, роли и блокировка.
//
// Пароль хешируется в браузере (PBKDF2, 150 000 кругов), на сервер приходит только 64 hex-символа.
// Сервер дополнительно хранит sha256(соль + присланный хеш). Сам пароль до сервера не доходит.
//
// Данные (папка данные/):
//   пользователи.txt  «имя | соль | хеш | роль | время | заблокирован(0/1)»
//   сессии.txt        «сессия | имя | истекает»
//   авторы.txt        «автор | токен | время» — при регистрации пользователь сразу становится автором
//                     пакетов: этот токен нужен команде «сфера войти» (публикация из терминала).
// Роли: пользователь, модератор, админ. Роли и блокировку выдаёт администратор на странице управления.
//
// Адреса (все POST требуют заголовок X-Sfera: 1 — так запрос нельзя подделать с чужого сайта):
//   POST /аккаунт/регистрация  имя, пароль     POST /аккаунт/вход  имя, пароль
//   POST /аккаунт/выход        GET  /аккаунт/я
//   GET  /аккаунт/токен        POST /аккаунт/токен/новый
//   GET  /аккаунт/мои-пакеты   (панель Сферы) строки «имя | версия | статус | описание» по всем версиям автора;
//                              статус: проверен, нежелательный или пусто (не проверен)

подключить веб;

// ---------------------------------------------------------------- вспомогательное

функция только_буквы_и_цифры(текст т): верно
    целое n = длина(т);
    если (n == 0)
        вернуть нет;
    конец
    целое i = 0;
    пока (i меньше n)
        целое б = целое(байт_текста(т, i));
        верно хороший = (б не меньше 97 и б не больше 122) или (б не меньше 65 и б не больше 90) или (б не меньше 48 и б не больше 57);
        если ( не хороший)
            вернуть нет;
        конец
        i = i + 1;
    конец
    вернуть да;
конец

// 64 строчных шестнадцатеричных символа (хеш пароля из браузера).
функция это_хеш(текст т): верно
    если (длина(т) != 64)
        вернуть нет;
    конец
    целое i = 0;
    пока (i меньше 64)
        целое б = целое(байт_текста(т, i));
        верно хороший = (б не меньше 97 и б не больше 102) или (б не меньше 48 и б не больше 57);
        если ( не хороший)
            вернуть нет;
        конец
        i = i + 1;
    конец
    вернуть да;
конец

// Случайная строка из латиницы и цифр.
функция случайная_строка(целое сколько): текст
    текст временный = "данные/.случайное-" + целое_в_текст(монотонное_время_нс());
    выполнить_команду("head -c 96 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c " + целое_в_текст(сколько) + " > '" + временный + "'");
    результат из текста файл = прочитать_файл(временный);
    удалить_файл(временный);
    если ( не файл.успешно)
        вернуть "";
    конец
    вернуть обрезать_края(файл.значение);
конец

// sha256 от текста из латиницы и цифр (другое в командную строку не пускаем).
функция хеш_sha256(текст вход): текст
    если ( не только_буквы_и_цифры(вход))
        вернуть "";
    конец
    текст временный = "данные/.хеш-" + целое_в_текст(монотонное_время_нс());
    выполнить_команду("printf '%s' '" + вход + "' | sha256sum | cut -d' ' -f1 > '" + временный + "'");
    результат из текста файл = прочитать_файл(временный);
    удалить_файл(временный);
    если ( не файл.успешно)
        вернуть "";
    конец
    текст итог = обрезать_края(файл.значение);
    если (длина(итог) != 64)
        вернуть "";
    конец
    вернуть итог;
конец

функция роль_допустима(текст роль): верно
    вернуть роль == "пользователь" или роль == "модератор" или роль == "админ";
конец

// ---------------------------------------------------------------- пользователи

функция строка_пользователя(текст имя): текст
    результат из текста файл = прочитать_файл("данные/пользователи.txt");
    если ( не файл.успешно или длина(имя) == 0)
        вернуть "";
    конец
    целое всего = длина(файл.значение);
    целое позиция = 0;
    пока (позиция меньше всего)
        целое до = конец_строки(файл.значение, позиция);
        текст строка = срез(файл.значение, позиция, до - позиция);
        позиция = до + 1;
        если (строка_записи(строка) и поле_строки(строка, 0) == имя)
            вернуть строка;
        конец
    конец
    вернуть "";
конец

функция роль_пользователя(текст имя): текст
    текст строка = строка_пользователя(имя);
    если (длина(строка) == 0)
        вернуть "";
    конец
    вернуть поле_строки(строка, 3);
конец

функция пользователь_заблокирован(текст имя): верно
    текст строка = строка_пользователя(имя);
    вернуть длина(строка) больше 0 и поле_строки(строка, 5) == "1";
конец

// Заменяет строку пользователя; пустая новая строка удаляет запись.
функция записать_строку_пользователя(текст имя, текст новая): верно
    результат из текста файл = прочитать_файл("данные/пользователи.txt");
    если ( не файл.успешно)
        вернуть нет;
    конец
    текст итог = "";
    верно нашли = нет;
    целое всего = длина(файл.значение);
    целое позиция = 0;
    пока (позиция меньше всего)
        целое до = конец_строки(файл.значение, позиция);
        текст строка = срез(файл.значение, позиция, до - позиция);
        позиция = до + 1;
        если (строка_записи(строка) и поле_строки(строка, 0) == имя)
            нашли = да;
            если (длина(новая) больше 0)
                итог = итог + новая + "\n";
            конец
        иначе если (длина(строка) больше 0)
            итог = итог + строка + "\n";
        конец
    конец
    если ( не нашли)
        вернуть нет;
    конец
    результат из верного записан = записать_файл("данные/пользователи.txt.new", итог);
    если ( не записан.успешно)
        вернуть нет;
    конец
    результат из верного заменён = переименовать_файл("данные/пользователи.txt.new", "данные/пользователи.txt");
    вернуть заменён.успешно;
конец

функция собрать_строку_пользователя(текст имя, текст соль, текст хеш, текст роль, текст время, текст блок): текст
    вернуть имя + " | " + соль + " | " + хеш + " | " + роль + " | " + время + " | " + блок;
конец

// ---------------------------------------------------------------- сессии

// Создаёт сессию на 30 дней и возвращает её номер.
функция создать_сессию(текст имя): текст
    текст сессия = случайная_строка(40);
    если (длина(сессия) != 40)
        вернуть "";
    конец
    текст строка = сессия + " | " + имя + " | " + целое_в_текст(юникс_время() + 2592000) + "\n";
    дописать_в_файл_бинарно("данные/сессии.txt", строка, длина(строка));
    вернуть сессия;
конец

// Имя пользователя по сессии из cookie; пустой текст — не вошёл, сессия устарела или аккаунт заблокирован.
функция пользователь_по_сессии(Запрос з): текст
    текст сессия = значение_cookie(з, "sfera_sid");
    если (длина(сессия) != 40 или не только_буквы_и_цифры(сессия))
        вернуть "";
    конец
    результат из текста файл = прочитать_файл("данные/сессии.txt");
    если ( не файл.успешно)
        вернуть "";
    конец
    целое сейчас = юникс_время();
    целое всего = длина(файл.значение);
    целое позиция = 0;
    пока (позиция меньше всего)
        целое до = конец_строки(файл.значение, позиция);
        текст строка = срез(файл.значение, позиция, до - позиция);
        позиция = до + 1;
        если (строка_записи(строка) и равны_постоянно(поле_строки(строка, 0), сессия))
            результат из целого истекает = текст_в_целое(поле_строки(строка, 2));
            если ( не истекает.успешно или истекает.значение меньше сейчас)
                вернуть "";
            конец
            текст имя = поле_строки(строка, 1);
            если (пользователь_заблокирован(имя) или длина(строка_пользователя(имя)) == 0)
                вернуть "";
            конец
            вернуть имя;
        конец
    конец
    вернуть "";
конец

// Пользователь для действий, меняющих данные: ещё и заголовок X-Sfera: 1 (защита от подделки запросов).
функция пользователь_для_действия(Запрос з): текст
    если (заголовок(з, "X-Sfera") != "1")
        вернуть "";
    конец
    вернуть пользователь_по_сессии(з);
конец

функция убрать_сессию(текст сессия): целое
    результат из текста файл = прочитать_файл("данные/сессии.txt");
    если ( не файл.успешно)
        вернуть 0;
    конец
    текст итог = "";
    целое сейчас = юникс_время();
    целое всего = длина(файл.значение);
    целое позиция = 0;
    пока (позиция меньше всего)
        целое до = конец_строки(файл.значение, позиция);
        текст строка = срез(файл.значение, позиция, до - позиция);
        позиция = до + 1;
        если (строка_записи(строка))
            результат из целого истекает = текст_в_целое(поле_строки(строка, 2));
            верно живая = истекает.успешно и истекает.значение не меньше сейчас;
            если (живая и поле_строки(строка, 0) != сессия)
                итог = итог + строка + "\n";
            конец
        конец
    конец
    записать_файл("данные/сессии.txt.new", итог);
    переименовать_файл("данные/сессии.txt.new", "данные/сессии.txt");
    вернуть 0;
конец

