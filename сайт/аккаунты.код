// Убирает автора из авторы.txt (если он там есть).
функция убрать_автора_из_файла(текст имя): целое
    результат из текста файл = прочитать_файл("данные/авторы.txt");
    если ( не файл.успешно)
        вернуть 0;
    конец
    текст итог = "";
    целое всего = длина(файл.значение);
