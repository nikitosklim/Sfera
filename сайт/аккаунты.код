// Выдаёт автору новый токен. Пустой текст — не вышло.
функция выдать_токен_автора(текст имя): текст
    убрать_автора_из_файла(имя);
    текст токен = случайная_строка(40);
    если (длина(токен) меньше 30)
        вернуть "";
