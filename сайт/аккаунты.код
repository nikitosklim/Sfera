// GET /управление/пользователи
функция список_пользователей(целое32 клиент): целое
    результат из текста файл = прочитать_файл("данные/пользователи.txt");
    текст итог = "[";
    если (файл.успешно)
        целое всего = длина(файл.значение);
        целое позиция = 0;
        верно первый = да;
        пока (позиция меньше всего)
            целое до = конец_строки(файл.значение, позиция);
            текст строка = срез(файл.значение, позиция, до - позиция);
            позиция = до + 1;
            если (строка_записи(строка))
                если ( не первый)
                    итог = итог + ",";
                конец
                первый = нет;
                итог = итог + "{\"имя\":" + json_строка(поле_строки(строка, 0)) + ",\"роль\":" + json_строка(поле_строки(строка, 3)) + ",\"время\":" +
                    json_строка(поле_строки(строка, 4)) + ",\"блок\":" + json_строка(поле_строки(строка, 5)) + "}";
            конец
        конец
    конец
    вернуть ответ_json(клиент, 200, итог + "]");
конец

// POST /управление/пользователь/роль: «имя», «роль».
функция задать_роль(целое32 клиент, Запрос з): целое
    текст имя = обрезать_края(параметр(з.тело, "имя"));
    текст роль = обрезать_края(параметр(з.тело, "роль"));
    текст строка = строка_пользователя(имя);
    если (длина(строка) == 0)
        вернуть ответ_ошибка(клиент, 404, "такого пользователя нет");
    конец
    если ( не роль_допустима(роль))
        вернуть ответ_ошибка(клиент, 400, "роль: пользователь, модератор или админ");
    конец
    записать_строку_пользователя(имя, собрать_строку_пользователя(имя, поле_строки(строка, 1), поле_строки(строка, 2), роль, поле_строки(строка, 4), поле_строки(строка, 5)));
    вернуть ответ_json(клиент, 200, "{\"ok\":true}");
конец

// POST /управление/пользователь/блок: «имя», «значение» (1 — заблокировать, 0 — разблокировать).
функция задать_блок(целое32 клиент, Запрос з): целое
    текст имя = обрезать_края(параметр(з.тело, "имя"));
    текст значение = "0";
    если (обрезать_края(параметр(з.тело, "значение")) == "1")
        значение = "1";
    конец
    текст строка = строка_пользователя(имя);
    если (длина(строка) == 0)
        вернуть ответ_ошибка(клиент, 404, "такого пользователя нет");
    конец
    записать_строку_пользователя(имя, собрать_строку_пользователя(имя, поле_строки(строка, 1), поле_строки(строка, 2), поле_строки(строка, 3), поле_строки(строка, 4), значение));
    вернуть ответ_json(клиент, 200, "{\"ok\":true}");
конец
