// ---------------------------------------------------------------- запросы

функция сессия_в_ответ(целое32 клиент, Запрос з, целое код, текст имя, текст сессия): целое
    текст тело = "{\"ok\":true,\"имя\":" + json_строка(имя) + ",\"роль\":" + json_строка(роль_пользователя(имя)) + "}";
    текст доп = "";
    если (длина(сессия) больше 0)
        доп = заголовок_cookie("sfera_sid", сессия, 2592000);
    конец
    вернуть ответ_с_заголовками(клиент, з, код, "application/json; charset=utf-8", тело, доп);
конец

функция зарегистрировать(целое32 клиент, Запрос з): целое
    текст имя = обрезать_края(параметр(з.тело, "имя"));
    текст пароль = параметр(з.тело, "пароль");
    если ( не имя_пакета_допустимо(имя) или длина(имя) меньше 3 или длина(имя) больше 32)
        вернуть ответ_ошибка(клиент, 400, "имя: от 3 до 32 знаков, буквы, цифры, «_» и «-»");
    конец
    если ( не это_хеш(пароль))
        вернуть ответ_ошибка(клиент, 400, "пароль не принят: обновите страницу и попробуйте ещё раз");
    конец
    если (длина(строка_пользователя(имя)) больше 0 или длина(токен_автора(имя)) больше 0)
        вернуть ответ_ошибка(клиент, 409, "это имя уже занято, выберите другое");
    конец
    текст соль = случайная_строка(16);
    текст хеш = хеш_sha256(соль + пароль);
    если (длина(соль) != 16 или длина(хеш) != 64)
        вернуть ответ_ошибка(клиент, 500, "не удалось создать аккаунт");
    конец
    текст токен = выдать_токен_автора(имя);
    если (длина(токен) меньше 30)
        вернуть ответ_ошибка(клиент, 500, "не удалось создать токен автора");
    конец
    текст строка = собрать_строку_пользователя(имя, соль, хеш, "пользователь", целое_в_текст(юникс_время()), "0") + "\n";
    дописать_в_файл_бинарно("данные/пользователи.txt", строка, длина(строка));
    текст сессия = создать_сессию(имя);
    вернуть сессия_в_ответ(клиент, з, 201, имя, сессия);
конец

// Неудачные входы: «имя | время». Пять ошибок за 10 минут — подождать (защита от подбора пароля).
функция неудачных_входов(текст имя): целое
    результат из текста файл = прочитать_файл("данные/попытки.txt");
    если ( не файл.успешно)
        вернуть 0;
    конец
    целое порог = юникс_время() - 600;
    целое счёт = 0;
    целое всего = длина(файл.значение);
    целое позиция = 0;
    пока (позиция меньше всего)
        целое до = конец_строки(файл.значение, позиция);
        текст строка = срез(файл.значение, позиция, до - позиция);
        позиция = до + 1;
        если (строка_записи(строка) и поле_строки(строка, 0) == имя)
            результат из целого время = текст_в_целое(поле_строки(строка, 1));
            если (время.успешно и время.значение больше порог)
                счёт = счёт + 1;
            конец
        конец
    конец
    вернуть счёт;
конец

функция отметить_неудачный_вход(текст имя): целое
    текст строка = имя + " | " + целое_в_текст(юникс_время()) + "\n";
    дописать_в_файл_бинарно("данные/попытки.txt", строка, длина(строка));
    вернуть 0;
конец

функция войти(целое32 клиент, Запрос з): целое
    текст имя = обрезать_края(параметр(з.тело, "имя"));
    текст пароль = параметр(з.тело, "пароль");
    если (неудачных_входов(имя) больше 4)
        вернуть ответ_ошибка(клиент, 429, "слишком много неверных попыток: подождите 10 минут");
    конец
    текст строка = строка_пользователя(имя);
    если (длина(строка) == 0 или не это_хеш(пароль))
        отметить_неудачный_вход(имя);
        вернуть ответ_ошибка(клиент, 401, "неверное имя или пароль");
    конец
    текст хеш = хеш_sha256(поле_строки(строка, 1) + пароль);
    если (длина(хеш) != 64 или не равны_постоянно(хеш, поле_строки(строка, 2)))
        отметить_неудачный_вход(имя);
        вернуть ответ_ошибка(клиент, 401, "неверное имя или пароль");
    конец
    если (поле_строки(строка, 5) == "1")
        вернуть ответ_ошибка(клиент, 403, "аккаунт заблокирован");
    конец
    текст сессия = создать_сессию(имя);
    если (длина(сессия) == 0)
        вернуть ответ_ошибка(клиент, 500, "не удалось начать сессию");
    конец
    вернуть сессия_в_ответ(клиент, з, 200, имя, сессия);
конец

функция выйти(целое32 клиент, Запрос з): целое
    текст сессия = значение_cookie(з, "sfera_sid");
    если (длина(сессия) == 40 и только_буквы_и_цифры(сессия))
        убрать_сессию(сессия);
    конец
    вернуть ответ_с_заголовками(клиент, з, 200, "application/json; charset=utf-8", "{\"ok\":true}", заголовок_cookie("sfera_sid", "", 0));
конец

// GET /аккаунт/я
функция кто_я(целое32 клиент, Запрос з): целое
    текст имя = пользователь_по_сессии(з);
    если (длина(имя) == 0)
        вернуть ответ_json(клиент, 200, "{\"вошёл\":false}");
    конец
    вернуть ответ_json(клиент, 200, "{\"вошёл\":true,\"имя\":" + json_строка(имя) + ",\"роль\":" + json_строка(роль_пользователя(имя)) + "}");
конец

// GET /аккаунт/мои-пакеты — пакеты, опубликованные этим пользователем (для панели Сферы).
функция мои_пакеты(целое32 клиент, Запрос з, текст имя): целое
    текст реестр = прочитать_реестр();
    текст итог = "";
    целое всего = длина(реестр);
    целое позиция = 0;
    пока (позиция меньше всего)
        целое до = конец_строки(реестр, позиция);
        текст строка = срез(реестр, позиция, до - позиция);
        позиция = до + 1;
        если (строка_записи(строка) и поле_строки(строка, 5) == имя)
            итог = итог + поле_строки(строка, 0) + " | " + поле_строки(строка, 1) + " | " + статус_пакета(поле_строки(строка, 0)) + " | " + поле_строки(строка, 6) + "\n";
        конец
    конец
    вернуть ответ_текстом(клиент, 200, "text/plain; charset=utf-8", итог);
конец

функция обработать_аккаунт(целое32 клиент, Запрос з, текст действие): целое
    если (з.метод == "GET" и действие == "я")
        вернуть кто_я(клиент, з);
    конец
    если (з.метод != "POST" и з.метод != "GET")
        вернуть ответ_ошибка(клиент, 405, "метод не поддерживается");
    конец
    если (заголовок(з, "X-Sfera") != "1")
        вернуть ответ_ошибка(клиент, 400, "нужен заголовок X-Sfera: 1");
    конец
    если (з.метод == "POST" и действие == "регистрация")
        вернуть зарегистрировать(клиент, з);
    конец
    если (з.метод == "POST" и действие == "вход")
        вернуть войти(клиент, з);
    конец
    если (з.метод == "POST" и действие == "выход")
        вернуть выйти(клиент, з);
    конец
    текст имя = пользователь_по_сессии(з);
    если (длина(имя) == 0)
        вернуть ответ_ошибка(клиент, 401, "сначала войдите в аккаунт");
    конец
    если (з.метод == "GET" и действие == "мои-пакеты")
        вернуть мои_пакеты(клиент, з, имя);
    конец
    если (з.метод == "GET" и действие == "токен")
        вернуть ответ_json(клиент, 200, "{\"ok\":true,\"токен\":" + json_строка(токен_автора(имя)) + "}");
    конец
    если (з.метод == "POST" и действие == "токен/новый")
        текст токен = выдать_токен_автора(имя);
        если (длина(токен) меньше 30)
            вернуть ответ_ошибка(клиент, 500, "не удалось создать токен");
        конец
        вернуть ответ_json(клиент, 200, "{\"ok\":true,\"токен\":" + json_строка(токен) + "}");
    конец
    вернуть ответ_ошибка(клиент, 404, "такого действия нет");
конец

