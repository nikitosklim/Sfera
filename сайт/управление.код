// Расширенное управление сайтом: правка статей, обложки, файлы для скачивания, аватар языка.
// Все запросы только с токеном администратора. Страница — pages/admin.html.

подключить веб;

// Строка статьи из данные/статьи.txt по номеру (или пустой текст).
функция строка_статьи(текст номер): текст
    результат из текста список = прочитать_файл("данные/статьи.txt");
    если ( не список.успешно)
        вернуть "";
    конец
    целое всего = длина(список.значение);
    целое позиция = 0;
    пока (позиция меньше всего)
        целое до = конец_строки(список.значение, позиция);
        текст строка = срез(список.значение, позиция, до - позиция);
        позиция = до + 1;
        если (строка_записи(строка) и поле_строки(строка, 0) == номер)
            вернуть строка;
        конец
    конец
    вернуть "";
конец

// Заменяет строку статьи с этим номером на новую. Возвращает да, если статья нашлась.
функция заменить_строку_статьи(текст номер, текст новая): верно
    результат из текста список = прочитать_файл("данные/статьи.txt");
    если ( не список.успешно)
        вернуть нет;
    конец
    текст итог = "";
    верно нашли = нет;
    целое всего = длина(список.значение);
    целое позиция = 0;
    пока (позиция меньше всего)
        целое до = конец_строки(список.значение, позиция);
        текст строка = срез(список.значение, позиция, до - позиция);
        позиция = до + 1;
        если (строка_записи(строка) и поле_строки(строка, 0) == номер)
            итог = итог + новая + "\n";
            нашли = да;
        иначе если (длина(строка) больше 0)
            итог = итог + строка + "\n";
        конец
    конец
    если ( не нашли)
        вернуть нет;
    конец
    результат из верного записан = записать_файл("данные/статьи.txt.new", итог);
    если ( не записан.успешно)
        вернуть нет;
    конец
    результат из верного заменён = переименовать_файл("данные/статьи.txt.new", "данные/статьи.txt");
    вернуть заменён.успешно;
конец

// Собирает строку статьи с новыми названием, описанием, тегами и картинкой; адрес и время остаются прежними.
функция собрать_строку_статьи(текст старая, текст название, текст описание, текст теги, текст картинка): текст
    вернуть поле_строки(старая, 0) + " | " + название + " | " + описание + " | " + теги + " | " + поле_строки(старая, 4) + " | " + картинка + " | " + поле_строки(старая, 6);
конец

// POST /управление/ссылка/изменить: номер, название, описание, теги.
функция изменить_ссылку(целое32 клиент, Запрос з): целое
    текст номер = обрезать_края(параметр(з.тело, "номер"));
    текст старая = строка_статьи(номер);
    если (длина(старая) == 0)
        вернуть ответ_ошибка(клиент, 404, "такой статьи нет");
    конец
    текст название = обрезать_до(очистить_поле(обрезать_края(параметр(з.тело, "название"))), 200);
    текст описание = обрезать_до(очистить_поле(обрезать_края(параметр(з.тело, "описание"))), 400);
    текст теги = очистить_теги(параметр(з.тело, "теги"));
    если (длина(название) == 0)
        вернуть ответ_ошибка(клиент, 400, "название не может быть пустым");
    конец
    если ( не заменить_строку_статьи(номер, собрать_строку_статьи(старая, название, описание, теги, поле_строки(старая, 5))))
        вернуть ответ_ошибка(клиент, 500, "не удалось сохранить статью");
    конец
    вернуть ответ_json(клиент, 200, "{\"ok\":true}");
конец

// PUT /управление/картинка/<номер>: новая обложка статьи (png, jpg, gif, webp, до 3 МБ) телом запроса.
функция заменить_обложку(целое32 клиент, Запрос з, текст номер): целое
    текст старая = строка_статьи(номер);
    если (длина(старая) == 0 или не имя_загрузки_допустимо(номер))
        вернуть ответ_ошибка(клиент, 404, "такой статьи нет");
    конец
    результат из целого длина_тела = текст_в_целое(заголовок(з, "Content-Length"));
    если ( не длина_тела.успешно или длина_тела.значение меньше 1)
        вернуть ответ_ошибка(клиент, 400, "нужен заголовок Content-Length");
    конец
    если (длина_тела.значение больше 3000000)
        вернуть ответ_ошибка(клиент, 413, "картинка больше 3 МБ");
    конец
    создать_папку("данные/обложки");
    текст временная = "данные/обложки/" + номер + ".tmp";
    результат из целого принято = принять_тело_в_файл(клиент, временная, длина_тела.значение);
    если ( не принято.успешно)
        удалить_файл(временная);
        вернуть ответ_ошибка(клиент, 400, принято.сообщение);
    конец
    текст расширение = тип_картинки(временная);
    если (длина(расширение) == 0)
        удалить_файл(временная);
        вернуть ответ_ошибка(клиент, 415, "нужна картинка png, jpg, gif или webp");
    конец
    текст имя = номер + "." + расширение;
    текст прежняя = поле_строки(старая, 5);
    результат из верного перенесена = переименовать_файл(временная, "данные/обложки/" + имя);
    если ( не перенесена.успешно)
        удалить_файл(временная);
        вернуть ответ_ошибка(клиент, 500, "не удалось сохранить картинку");
    конец
    если (длина(прежняя) больше 0 и прежняя != имя и имя_загрузки_допустимо(прежняя))
        удалить_файл("данные/обложки/" + прежняя);
    конец
    заменить_строку_статьи(номер, собрать_строку_статьи(старая, поле_строки(старая, 1), поле_строки(старая, 2), поле_строки(старая, 3), имя));
    вернуть ответ_json(клиент, 200, "{\"ok\":true,\"картинка\":" + json_строка(имя) + "}");
конец

// POST /управление/картинка/убрать: номер. Обложка удаляется, статья остаётся.
функция убрать_обложку(целое32 клиент, Запрос з): целое
    текст номер = обрезать_края(параметр(з.тело, "номер"));
    текст старая = строка_статьи(номер);
    если (длина(старая) == 0)
        вернуть ответ_ошибка(клиент, 404, "такой статьи нет");
    конец
    текст прежняя = поле_строки(старая, 5);
    если (длина(прежняя) больше 0 и имя_загрузки_допустимо(прежняя))
        удалить_файл("данные/обложки/" + прежняя);
    конец
    заменить_строку_статьи(номер, собрать_строку_статьи(старая, поле_строки(старая, 1), поле_строки(старая, 2), поле_строки(старая, 3), ""));
    вернуть ответ_json(клиент, 200, "{\"ok\":true}");
конец

// GET /управление/файлы: загруженные файлы для скачивания (имя, название, размер, сумма).
функция список_файлов_json(целое32 клиент, Запрос з): целое
    результат из текста список = прочитать_файл("downloads/list.txt");
    текст итог = "[";
    если (список.успешно)
        целое всего = длина(список.значение);
        целое позиция = 0;
        целое штук = 0;
        пока (позиция меньше всего)
            целое до = конец_строки(список.значение, позиция);
            текст строка = срез(список.значение, позиция, до - позиция);
            позиция = до + 1;
            если (строка_записи(строка) и имя_загрузки_допустимо(поле_строки(строка, 0)))
                текст имя = поле_строки(строка, 0);
                целое размер = 0;
                результат из целого р = размер_файла("downloads/" + имя);
                если (р.успешно)
                    размер = р.значение;
                конец
                текст есть_текст = "false";
                если (р.успешно)
                    есть_текст = "true";
                конец
                если (штук больше 0)
                    итог = итог + ",";
                конец
                итог = итог + "{\"имя\":" + json_строка(имя) + ",\"название\":" + json_строка(поле_строки(строка, 1)) + ",\"размер\":" + json_строка(размер_текстом(размер)) +
                    ",\"есть\":" + есть_текст + "}";
                штук = штук + 1;
            конец
        конец
    конец
    итог = итог + "]";
    вернуть ответ_с_заголовками(клиент, з, 200, "application/json; charset=utf-8", итог, "Cache-Control: no-store\r\n");
конец

// Есть ли загруженный аватар языка.
функция есть_свой_аватар(): верно
    результат из целого р = размер_файла("данные/аватар.png");
    вернуть р.успешно и р.значение больше 0;
конец

// Имена файлов сайта, которые заменяются аватаром.
функция имя_аватара(текст имя): верно
    вернуть имя == "logo.png" или имя == "icon-192.png" или имя == "icon-512.png" или имя == "apple-touch-icon.png" или имя == "favicon.ico";
конец

// PUT /управление/аватар: PNG до 2 МБ. Заменяет логотип, иконки сайта и значок вкладки.
функция принять_аватар(целое32 клиент, Запрос з): целое
    результат из целого длина_тела = текст_в_целое(заголовок(з, "Content-Length"));
    если ( не длина_тела.успешно или длина_тела.значение меньше 1)
        вернуть ответ_ошибка(клиент, 400, "нужен заголовок Content-Length");
    конец
    если (длина_тела.значение больше 2000000)
        вернуть ответ_ошибка(клиент, 413, "аватар больше 2 МБ");
    конец
    результат из целого принято = принять_тело_в_файл(клиент, "данные/аватар.новый", длина_тела.значение);
    если ( не принято.успешно)
        удалить_файл("данные/аватар.новый");
        вернуть ответ_ошибка(клиент, 400, принято.сообщение);
    конец
    если (тип_картинки("данные/аватар.новый") != "png")
        удалить_файл("данные/аватар.новый");
        вернуть ответ_ошибка(клиент, 415, "нужен файл PNG (лучше квадратный, от 512×512)");
    конец
    результат из верного заменён = переименовать_файл("данные/аватар.новый", "данные/аватар.png");
    если ( не заменён.успешно)
        вернуть ответ_ошибка(клиент, 500, "не удалось сохранить аватар");
    конец
    вернуть ответ_json(клиент, 200, "{\"ok\":true}");
конец

// POST /управление/аватар/убрать: вернуть прежний аватар из набора сайта.
функция убрать_аватар(целое32 клиент): целое
    удалить_файл("данные/аватар.png");
    вернуть ответ_json(клиент, 200, "{\"ok\":true}");
конец

// PUT-запросы управления: аватар и обложки.
функция обработать_правки(целое32 клиент, Запрос з, текст действие): целое
    если ( не авторизован(з))
        вернуть ответ_json(клиент, 401, "{\"ok\":false,\"ошибка\":\"нет доступа: неверный токен\"}");
    конец
    если (действие == "аватар")
        вернуть принять_аватар(клиент, з);
    конец
    если (начинается_с_текста(действие, "картинка/"))
        вернуть заменить_обложку(клиент, з, срез(действие, 17, длина(действие) - 17));
    конец
    вернуть ответ_json(клиент, 404, "{\"ok\":false,\"ошибка\":\"нет такого действия\"}");
конец
