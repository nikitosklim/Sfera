// обновления.код — «какая версия Сферы самая новая» для панели разработчика.
//
//   GET /обновления/<метка> (или /updates/<метка>)   метка: macOS-ARM, macOS-Intel, Windows, Linux (латиница, цифры, «-»)
//
// Ответ — обычный текст, по строке «поле=значение»; всё, что после строки «изменения=», — описание версии:
//   версия=0.3.3
//   файл=Sfera-Panel-macOS-ARM-0.3.3.zip
//   адрес=/файлы/Sfera-Panel-macOS-ARM-0.3.3.zip
//   сумма=<SHA-256 или пусто>
//   изменения=
//   (текст из downloads/изменения.txt, если файл есть)
//
// Самая новая версия определяется по именам файлов в downloads/list.txt:
// «Sfera-Panel-<метка>-<версия>.<расширение>». Новую версию достаточно выложить на сайт — панели увидят её сами.

подключить веб;
подключить сайт;

// Версия «0.3.3» → число 3003 (части по 1000): так версии сравниваются как числа.
функция номер_версии(текст запись): целое
    целое итог = 0;
    целое часть = 0;
    целое частей = 0;
    целое позиция = 0;
    целое всего = длина(запись);
    пока (позиция меньше всего)
        целое32 б = байт_текста(запись, позиция);
        если (б >= целое32(48) и б <= целое32(57))
            часть = часть * 10 + целое(б - целое32(48));
        иначе
            итог = итог * 1000 + часть;
            часть = 0;
            частей = частей + 1;
        конец
        позиция = позиция + 1;
    конец
    итог = итог * 1000 + часть;
    вернуть итог;
конец

// Из «Sfera-Panel-Windows-0.3.3.zip» с префиксом «Sfera-Panel-Windows-» достаёт «0.3.3»; пусто, если имя чужое.
функция версия_из_имени(текст имя, текст префикс): текст
    если ( не начинается_с_текста(имя, префикс))
        вернуть "";
    конец
    текст хвост = срез(имя, длина(префикс), длина(имя) - длина(префикс));
    целое конец_версии = 0;
    целое всего = длина(хвост);
    пока (конец_версии меньше всего)
        целое32 б = байт_текста(хвост, конец_версии);
        если ((б >= целое32(48) и б <= целое32(57)) или б == целое32(46))
            конец_версии = конец_версии + 1;
        иначе
            всего = конец_версии;
        конец
    конец
    // «0.3.3.zip» → точка перед расширением не часть версии
    текст версия = срез(хвост, 0, конец_версии);
    если (конец_версии больше 0 и байт_текста(версия, конец_версии - 1) == целое32(46))
        версия = срез(версия, 0, конец_версии - 1);
    конец
    вернуть версия;
конец

функция метка_допустима(текст метка): верно
    целое всего = длина(метка);
    если (всего == 0 или всего больше 24)
        вернуть нет;
    конец
    целое позиция = 0;
    пока (позиция меньше всего)
        целое32 б = байт_текста(метка, позиция);
        если ( не ((б >= целое32(48) и б <= целое32(57)) или (б >= целое32(65) и б <= целое32(90)) или (б >= целое32(97) и б <= целое32(122)) или б == целое32(45)))
            вернуть нет;
        конец
        позиция = позиция + 1;
    конец
    вернуть да;
конец

функция обработать_обновления(целое32 клиент, Запрос з, текст метка): целое
    если ( не метка_допустима(метка))
        вернуть ответ_текстом(клиент, 400, "text/plain; charset=utf-8", "ошибка=неверная метка платформы\n");
    конец
    текст префикс = "Sfera-Panel-" + метка + "-";
    результат из текст список = прочитать_файл("downloads/list.txt");
    текст лучшая_версия = "";
    текст лучший_файл = "";
    текст лучшая_сумма = "";
    целое лучший_номер = 0 - 1;
    если (список.успешно)
        целое всего = длина(список.значение);
        целое позиция = 0;
        пока (позиция меньше всего)
            целое до = конец_строки(список.значение, позиция);
            текст строка = срез(список.значение, позиция, до - позиция);
            позиция = до + 1;
            если (строка_записи(строка))
                текст имя = поле_строки(строка, 0);
                текст версия = версия_из_имени(имя, префикс);
                если (длина(версия) больше 0 и имя_загрузки_допустимо(имя))
                    целое номер = номер_версии(версия);
                    если (номер больше лучший_номер)
                        лучший_номер = номер;
                        лучшая_версия = версия;
                        лучший_файл = имя;
                        лучшая_сумма = поле_строки(строка, 3);
                    конец
                конец
            конец
        конец
    конец
    если (лучший_номер меньше 0)
        вернуть ответ_текстом(клиент, 404, "text/plain; charset=utf-8", "ошибка=для этой платформы сборок нет\n");
    конец
    текст ответ = "версия=" + лучшая_версия + "\nфайл=" + лучший_файл + "\nадрес=/файлы/" + лучший_файл + "\nсумма=" + лучшая_сумма + "\nизменения=\n";
    результат из текст изменения = прочитать_файл("downloads/изменения.txt");
    если (изменения.успешно)
        ответ = ответ + изменения.значение;
    конец
    вернуть ответ_текстом(клиент, 200, "text/plain; charset=utf-8", ответ);
конец
