// Страница «Пакеты» и страница пакета: каталог собирается на сервере из реестра (данные/реестр.txt)
// и git-каталога (данные/пакеты.txt). Скриптов в браузере не нужно: поиск — обычная форма, подробности — всплывающие облачка.

подключить веб;
подключить реестр;

// Часть версии «X.Y.Z» по номеру 0..2 (нет — ноль).
функция часть_версии(текст версия, целое номер): целое
    текст остаток = версия;
    целое k = 0;
    пока (k меньше номер)
        результат из целого т = найти(остаток, ".");
        если ( не т.успешно)
            вернуть 0;
        конец
        остаток = срез(остаток, т.значение + 1, длина(остаток) - т.значение - 1);
        k = k + 1;
    конец
    результат из целого т2 = найти(остаток, ".");
    текст число = остаток;
    если (т2.успешно)
        число = срез(остаток, 0, т2.значение);
    конец
    результат из целого р = текст_в_целое(число);
    если (р.успешно)
        вернуть р.значение;
    конец
    вернуть 0;
конец

функция ключ_версии(текст версия): целое
    вернуть часть_версии(версия, 0) * 1000000 + часть_версии(версия, 1) * 1000 + часть_версии(версия, 2);
конец

// Текст между «описание="» и закрывающей кавычкой в строке git-каталога.
функция описание_в_каталоге(текст строка): текст
    результат из целого п = найти(строка, "описание=\"");
    если ( не п.успешно)
        вернуть "";
    конец
    целое от = п.значение + длина("описание=\"");
    текст остаток = срез(строка, от, длина(строка) - от);
    результат из целого к = найти(остаток, "\"");
    если ( не к.успешно)
        вернуть остаток;
    конец
    вернуть срез(остаток, 0, к.значение);
конец

// Адрес репозитория в строке git-каталога: слово после «git».
функция адрес_в_каталоге(текст строка): текст
    результат из целого п = найти(строка, "git ");
    если ( не п.успешно)
        вернуть "";
    конец
    целое от = п.значение + 4;
    текст остаток = срез(строка, от, длина(строка) - от);
    результат из целого к = найти(остаток, " ");
    если (к.успешно)
        остаток = срез(остаток, 0, к.значение);
    конец
    вернуть обрезать_края(остаток);
конец

функция версий_в_реестре(текст реестр, текст имя): целое
    целое штук = 0;
    целое всего = длина(реестр);
    целое позиция = 0;
    пока (позиция меньше всего)
        целое до = конец_строки(реестр, позиция);
        текст строка = срез(реестр, позиция, до - позиция);
        позиция = до + 1;
        если (строка_записи(строка) и поле_строки(строка, 0) == имя)
            штук = штук + 1;
        конец
    конец
    вернуть штук;
конец

// Строка реестра с самой новой не отозванной версией пакета (если все отозваны — самая новая из отозванных).
функция лучшая_запись(текст реестр, текст имя): текст
    текст лучшая = "";
    целое лучший_ключ = -1;
    верно лучшая_отозвана = да;
    целое всего = длина(реестр);
    целое позиция = 0;
    пока (позиция меньше всего)
        целое до = конец_строки(реестр, позиция);
        текст строка = срез(реестр, позиция, до - позиция);
        позиция = до + 1;
        если (строка_записи(строка) и поле_строки(строка, 0) == имя)
            верно отозвана = поле_строки(строка, 7) == "1";
            целое ключ = ключ_версии(поле_строки(строка, 1));
            верно лучше = нет;
            если (длина(лучшая) == 0)
                лучше = да;
            иначе если (лучшая_отозвана и не отозвана)
                лучше = да;
            иначе если (лучшая_отозвана == отозвана и ключ больше лучший_ключ)
                лучше = да;
            конец
            если (лучше)
                лучшая = строка;
                лучший_ключ = ключ;
                лучшая_отозвана = отозвана;
            конец
        конец
    конец
    вернуть лучшая;
конец

функция имена_в_реестре(текст реестр): Список из текстов
    Список из текстов имена = Список из текстов();
    целое всего = длина(реестр);
    целое позиция = 0;
    пока (позиция меньше всего)
        целое до = конец_строки(реестр, позиция);
        текст строка = срез(реестр, позиция, до - позиция);
        позиция = до + 1;
        если (строка_записи(строка))
            текст имя = поле_строки(строка, 0);
            верно есть = нет;
            целое k = 0;
            пока (k меньше имена.размер())
                если (имена.получить(k) == имя)
                    есть = да;
                конец
                k = k + 1;
            конец
            если ( не есть)
                имена.добавить(имя);
            конец
        конец
    конец
    вернуть имена;
конец

функция пакет_совпадает(текст имя, текст описание, текст запрос): верно
    если (длина(запрос) == 0)
        вернуть да;
    конец
    текст стог = регистр_в_нижний(имя + " " + описание);
    вернуть содержит(стог, регистр_в_нижний(запрос));
конец

функция адрес_пакета(текст имя): текст
    вернуть "/пакеты/" + кодировать_адрес(имя);
конец

// Подробности пакета из реестра: описание, автор, установка, версии, README. Для облачка и страницы пакета.
функция подробности_пакета(текст имя): текст
    текст реестр = прочитать_реестр();
    текст запись = лучшая_запись(реестр, имя);
    если (длина(запись) == 0)
        вернуть "<p>Такого пакета нет в реестре.</p>";
    конец
    текст версия = поле_строки(запись, 1);
    текст автор = экранировать_html(поле_строки(запись, 5));
    текст описание = экранировать_html(поле_строки(запись, 6));
    текст имя_html = экранировать_html(имя);
    текст итог = "<p>" + метка_статуса(имя) + "</p><p>" + описание + "</p><p class=\"muted\">Автор: <b>" + автор + "</b> · последняя версия <b>" + экранировать_html(версия) + "</b></p>";
    итог = итог + "<h3>Установка</h3><pre><code>сфера установить " + имя_html + "\nсфера установить " + имя_html + "@" + экранировать_html(версия) + "</code></pre>";
    итог = итог + "<h3>Как подключить в программе</h3><pre><code>подключить " + имя_html + ".файл;</code></pre><p class=\"muted\">Вместо «файл» укажите имя файла <code>.код</code> из пакета, без расширения.</p>";
    итог = итог + "<h3>Версии</h3><div class=\"таблица-прокрутка\"><table class=\"загрузки-таблица\">";
    целое всего = длина(реестр);
    целое позиция = 0;
    текст строки_версий = "";
    пока (позиция меньше всего)
        целое до = конец_строки(реестр, позиция);
        текст строка = срез(реестр, позиция, до - позиция);
        позиция = до + 1;
        если (строка_записи(строка) и поле_строки(строка, 0) == имя)
            текст вер = экранировать_html(поле_строки(строка, 1));
            текст пометка = "";
            если (поле_строки(строка, 7) == "1")
                пометка = " <span class=\"muted\">(отозвана)</span>";
            конец
            результат из целого размер = текст_в_целое(поле_строки(строка, 3));
            текст размер_текст = "";
            если (размер.успешно)
                размер_текст = размер_текстом(размер.значение);
            конец
            строки_версий = "<tr><td><span class=\"версия\">" + вер + "</span>" + пометка + "<br><span class=\"muted\">sha256 " + срез(поле_строки(строка, 2), 0, 16) +
                "…</span></td><td>" + размер_текст + "</td><td class=\"действия\"><a class=\"button small secondary\" href=\"/пакеты/архив/" + кодировать_адрес(имя) + "/" + вер + ".tar.gz\">Скачать</a></td></tr>" + строки_версий;
        конец
    конец
    итог = итог + строки_версий + "</table></div>";
    результат из текста справка = прочитать_файл("данные/пакеты/" + имя + "/" + поле_строки(запись, 1) + ".README.md");
    если (справка.успешно и длина(справка.значение) больше 0)
        текст кусок = справка.значение;
        если (длина(кусок) больше 4000)
            кусок = срез(кусок, 0, 4000) + "\n…";
        конец
        итог = итог + "<h3>Описание и примеры</h3><pre>" + экранировать_html(кусок) + "</pre>";
    конец
    вернуть итог;
конец

функция страница_пакета_html(текст имя): текст
    вернуть "<h1>" + экранировать_html(имя) + "</h1>" + подробности_пакета(имя) + "<section id=\"оценки\" class=\"оценки\" data-пакет=\"" + экранировать_html(имя) + "\"></section>";
конец

функция карточка_пакета(текст кнопка, текст имя, текст версия, текст описание, текст источник, текст автор, целое версий): текст
    текст метка = "в реестре";
    если (источник == "git")
        метка = "git";
    конец
    текст мета = "";
    если (длина(автор) больше 0)
        мета = "Автор: " + экранировать_html(автор);
    конец
    если (версий больше 1)
        если (длина(мета) больше 0)
            мета = мета + " · ";
        конец
        мета = мета + целое_в_текст(версий) + " версий";
    конец
    текст статус_в_карточке = "";
    если (источник != "git")
        статус_в_карточке = метка_статуса(имя);
        целое звёзд = число_звёзд(имя);
        если (звёзд больше 0)
            если (длина(мета) больше 0)
                мета = мета + " · ";
            конец
            мета = мета + "★ " + целое_в_текст(звёзд);
        конец
    конец
    текст в_версия = "";
    если (длина(версия) больше 0)
        в_версия = "<span class=\"версия\">" + экранировать_html(версия) + "</span>";
    конец
    вернуть "<article class=\"пакет\"><div class=\"пакет-шапка\"><h3>" + экранировать_html(имя) + "</h3>" + в_версия + "<span class=\"метка-источник\">" + метка +
        "</span>" + статус_в_карточке + "</div><p>" + экранировать_html(описание) + "</p><p class=\"muted малый\">" + мета + "</p>" + кнопка + "</article>";
конец

// Каталог карточек и облачка. «запрос» — строка поиска из формы (может быть пустой).
функция каталог_пакетов_html(текст запрос): текст
    текст реестр = прочитать_реестр();
    Список из текстов имена = имена_в_реестре(реестр);
    текст карточки = "";
    целое номер = 0;
    целое k = 0;
    пока (k меньше имена.размер())
        текст имя = имена.получить(k);
        текст запись = лучшая_запись(реестр, имя);
        текст описание = поле_строки(запись, 6);
        если (пакет_совпадает(имя, описание, запрос))
            номер = номер + 1;
            карточки = карточки + карточка_пакета("<a class=\"button small\" href=\"" + адрес_пакета(имя) + "\">Подробнее</a>", имя, поле_строки(запись, 1), описание, "реестр", поле_строки(запись, 5), версий_в_реестре(реестр, имя));
        конец
        k = k + 1;
    конец
    имена.освободить();
    результат из текста каталог = прочитать_файл("данные/пакеты.txt");
    если (каталог.успешно)
        целое всего = длина(каталог.значение);
        целое позиция = 0;
        пока (позиция меньше всего)
            целое до = конец_строки(каталог.значение, позиция);
            текст строка = срез(каталог.значение, позиция, до - позиция);
            позиция = до + 1;
            текст имя = имя_в_строке_каталога(строка);
            если (длина(имя) больше 0 и не начинается_с_текста(обрезать_края(строка), "#"))
                текст описание = описание_в_каталоге(строка);
                если (пакет_совпадает(имя, описание, запрос) и длина(владелец_пакета(реестр, имя)) == 0)
                    номер = номер + 1;
                    текст репозиторий = адрес_в_каталоге(строка);
                    текст ссылка_git = "";
                    если (начинается_с_текста(репозиторий, "https://") или начинается_с_текста(репозиторий, "http://"))
                        ссылка_git = "<a class=\"button small\" href=\"" + экранировать_html(репозиторий) + "\" rel=\"noopener\">Подробнее</a>";
                    конец
                    карточки = карточки + карточка_пакета(ссылка_git, имя, "", описание, "git", "", 0);
                конец
            конец
        конец
    конец
    если (номер == 0)
        если (длина(запрос) больше 0)
            вернуть "<p class=\"muted\">По запросу «" + экранировать_html(запрос) + "» пакетов не нашлось. <a href=\"/пакеты#каталог\">Показать все</a></p>";
        конец
        вернуть "<p class=\"muted\">Пакетов пока нет. Станьте первым автором: нажмите «Как стать автором» вверху страницы.</p>";
    конец
    вернуть "<p class=\"muted\" id=\"итог\">Найдено пакетов: " + целое_в_текст(номер) + "</p><div class=\"пакеты-сетка\">" + карточки + "</div>";
конец
