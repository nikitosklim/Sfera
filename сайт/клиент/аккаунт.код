// аккаунт.код — якорь в шапке сайта, вход, регистрация и профиль (раньше static/аккаунт.js).
// Пароль хешируется в браузере и на сервер не уходит; сервер хранит соль и хеш от хеша.

подключить браузер;

функция название_роли(текст роль): текст
    если (роль == "админ")
        вернуть "администратор";
    конец
    вернуть роль;
конец

функция скрыть(целое32 э, дробное да_или_нет): целое
    если (есть(э))
        задать(э, "hidden", в_объект_число(да_или_нет));
    конец
    вернуть 0;
конец

функция сказать(текст где, текст сообщение, дробное хорошо): целое
    целое32 э = элемент(где);
    если ( не есть(э))
        вернуть 0;
    конец
    задать(э, "textContent", в_объект_текст(сообщение));
    если (хорошо > 0.5)
        задать(э, "className", в_объект_текст("акк-сообщение хорошо"));
    иначе
        задать(э, "className", в_объект_текст("акк-сообщение"));
    конец
    вернуть 0;
конец

функция значение_поля(текст идентификатор): текст
    вернуть объект_в_текст(свойство(элемент(идентификатор), "value"));
конец

// Запомнить, что «кто я» мог измениться: следующий запрос спросит сервер заново.
функция забыть_кто(): целое
    целое32 с = свойство(окно(), "Сфера");
    если (есть(с))
        задать(с, "_кто", 0);
    конец
    вернуть 0;
конец

// Контекст между шагами входа (сообщения и адрес запроса): объект window.__акк.
функция контекст(): целое32
    целое32 к = свойство(окно(), "__акк");
    если (есть(к))
        вернуть к;
    конец
    целое32 новый = вызвать1(свойство(окно(), "JSON"), "parse", в_объект_текст("{}"));
    задать(окно(), "__акк", новый);
    вернуть новый;
конец

// ---- якорь в шапке

функция шапка_готова(): целое
    целое32 м = метка();
    целое32 я = результат_запроса();
    если (есть(я) и объект_истина(свойство(я, "вошёл")))
        целое32 шапка = элемент("шапка-аккаунт");
        текст роль = объект_в_текст(свойство(я, "роль"));
        задать(шапка, "textContent", свойство(я, "имя"));
        задать(шапка, "title", в_объект_текст("Профиль: " + название_роли(роль)));
        если (роль == "модератор" или роль == "админ")
            целое32 документ = свойство(окно(), "document");
            целое32 якорь = вызвать1(документ, "createElement", в_объект_текст("a"));
            задать(якорь, "className", свойство(шапка, "className"));
            задать(якорь, "href", в_объект_текст("/пакеты/модерация"));
            задать(якорь, "textContent", в_объект_текст("Модерация"));
            вызвать2(свойство(шапка, "parentNode"), "insertBefore", якорь, шапка);
        конец
    конец
    сбросить(м);
    вернуть 0;
конец

// ---- профиль

функция токен_пришёл(): целое
    целое32 р = результат_запроса();
    если (есть(р) и объект_истина(свойство(р, "ok")))
        задать(элемент("акк-токен"), "value", свойство(р, "токен"));
    конец
    вернуть 0;
конец

// Строка реестра «имя | версия | sha256 | размер | время | автор | …»: автор — шестое поле (номер 5).
функция реестр_пришёл(): целое
    целое32 м = метка();
    текст т = объект_в_текст(результат_запроса());
    текст автор = объект_в_текст(свойство(элемент("акк-имя"), "textContent"));
    Список из текстов строки = Список из текстов();
    целое всего = длина(т);
    целое позиция = 0;
    пока (позиция меньше всего)
        целое до = позиция;
        пока (до меньше всего и целое(байт_текста(т, до)) != 10)
            до = до + 1;
        конец
        текст строка = подстрока_или_пусто(т, позиция, до - позиция);
        позиция = до + 1;
        текст чистая = убрать_края(строка);
        если (длина(чистая) больше 0 и целое(байт_текста(чистая, 0)) != 35 и поле_через(строка, 124, 5) == автор)
            строки.добавить(строка);
        конец
    конец
    целое32 список = элемент("акк-пакеты");
    задать(список, "textContent", в_объект_текст(""));
    если (строки.размер() == 0)
        задать(список, "innerHTML", в_объект_текст("<li class=\"muted\">Вы пока ничего не публиковали.</li>"));
    иначе
        целое32 документ = свойство(окно(), "document");
        текст выдано = "\n";
        целое k = 0;
        пока (k меньше строки.размер())
            текст имя = поле_через(строки.получить(k), 124, 0);
            если ( не содержит(выдано, "\n" + имя + "\n"))
                выдано = выдано + имя + "\n";
                текст версии = "";
                целое j = 0;
                пока (j меньше строки.размер())
                    если (поле_через(строки.получить(j), 124, 0) == имя)
                        если (длина(версии) больше 0)
                            версии = версии + ", ";
                        конец
                        версии = версии + поле_через(строки.получить(j), 124, 1);
                    конец
                    j = j + 1;
                конец
                целое32 пункт = вызвать1(документ, "createElement", в_объект_текст("li"));
                целое32 якорь = вызвать1(документ, "createElement", в_объект_текст("a"));
                задать(якорь, "href", в_объект_текст("/пакеты/" + кодировать(имя)));
                задать(якорь, "textContent", в_объект_текст(имя));
                вызвать1(пункт, "appendChild", якорь);
                вызвать1(пункт, "appendChild", вызвать1(документ, "createTextNode", в_объект_текст(" — версии: " + версии)));
                вызвать1(список, "appendChild", пункт);
            конец
            k = k + 1;
        конец
    конец
    строки.освободить();
    сбросить(м);
    вернуть 0;
конец

функция страница_я(): целое
    целое32 м = метка();
    целое32 я = результат_запроса();
    если (есть(я) и объект_истина(свойство(я, "вошёл")))
        текст роль = объект_в_текст(свойство(я, "роль"));
        скрыть(элемент("акк-гость"), 1.0);
        скрыть(элемент("акк-профиль"), 0.0);
        задать(элемент("акк-имя"), "textContent", свойство(я, "имя"));
        задать(элемент("акк-роль"), "textContent", в_объект_текст(название_роли(роль)));
        задать(элемент("акк-роль"), "className", в_объект_текст("роль-метка роль-" + роль));
        получить_json("/аккаунт/токен", "токен_пришёл");
        получить_текстом("/пакеты/реестр.txt", "реестр_пришёл");
    иначе
        скрыть(элемент("акк-гость"), 0.0);
        скрыть(элемент("акк-профиль"), 1.0);
    конец
    сбросить(м);
    вернуть 0;
конец

// ---- вход и регистрация

// Первый шаг: проверить поля и посчитать хеш; дальше работают хеш_готов и вход_ответ.
функция войти_или_зарегистрироваться(текст путь, текст поле_имени, текст поле_пароля, текст где): целое
    текст имя = убрать_края(значение_поля(поле_имени));
    текст пароль = значение_поля(поле_пароля);
    если (знаков(имя) меньше 3)
        сказать(где, "Имя: не короче трёх знаков.", 0.0);
        вернуть 0;
    конец
    если (знаков(пароль) меньше 8)
        сказать(где, "Пароль: не короче восьми знаков.", 0.0);
        вернуть 0;
    конец
    если (путь == "/аккаунт/регистрация" и пароль != значение_поля("рег-пароль2"))
        сказать(где, "Пароли не совпадают.", 0.0);
        вернуть 0;
    конец
    сказать(где, "Проверяю…", 1.0);
    целое32 к = контекст();
    задать(к, "путь", в_объект_текст(путь));
    задать(к, "где", в_объект_текст(где));
    задать(к, "имя", в_объект_текст(имя));
    хеш_пароля(имя, пароль, "хеш_готов");
    вернуть 0;
конец

функция хеш_готов(): целое
    целое32 м = метка();
    целое32 р = результат_запроса();
    целое32 к = контекст();
    текст где = объект_в_текст(свойство(к, "где"));
    если ( не объект_истина(свойство(р, "ok")))
        сказать(где, объект_в_текст(свойство(р, "ошибка")), 0.0);
    иначе
        текст тело = "имя=" + кодировать(объект_в_текст(свойство(к, "имя"))) + "&пароль=" + кодировать(объект_в_текст(свойство(р, "хеш")));
        отправить_форму(объект_в_текст(свойство(к, "путь")), тело, "вход_ответ");
    конец
    сбросить(м);
    вернуть 0;
конец

функция вход_ответ(): целое
    целое32 м = метка();
    целое32 р = результат_запроса();
    если (есть(р) и объект_истина(свойство(р, "ok")))
        забыть_кто();
        вызвать0(свойство(окно(), "location"), "reload");
    иначе
        текст сообщение = "Не получилось.";
        если (есть(р) и объект_истина(свойство(р, "ошибка")))
            сообщение = объект_в_текст(свойство(р, "ошибка"));
        конец
        сказать(объект_в_текст(свойство(контекст(), "где")), сообщение, 0.0);
    конец
    сбросить(м);
    вернуть 0;
конец

функция отправка_входа(): целое
    вызвать0(событие(), "preventDefault");
    войти_или_зарегистрироваться("/аккаунт/вход", "вход-имя", "вход-пароль", "вход-сообщение");
    вернуть 0;
конец

функция отправка_регистрации(): целое
    вызвать0(событие(), "preventDefault");
    войти_или_зарегистрироваться("/аккаунт/регистрация", "рег-имя", "рег-пароль", "рег-сообщение");
    вернуть 0;
конец

// ---- выход, токен, вкладки

функция после_выхода(): целое
    забыть_кто();
    задать(свойство(окно(), "location"), "href", в_объект_текст("/аккаунт"));
    вернуть 0;
конец

функция выйти(): целое
    отправить_форму("/аккаунт/выход", "", "после_выхода");
    вернуть 0;
конец

функция токен_показать(): целое
    целое32 поле = элемент("акк-токен");
    целое32 кнопка = свойство(событие(), "currentTarget");
    если (объект_в_текст(свойство(поле, "type")) == "password")
        задать(поле, "type", в_объект_текст("text"));
        задать(кнопка, "textContent", в_объект_текст("Скрыть"));
    иначе
        задать(поле, "type", в_объект_текст("password"));
        задать(кнопка, "textContent", в_объект_текст("Показать"));
    конец
    вернуть 0;
конец

функция скопировано(): целое
    сказать("токен-сообщение", "Скопировано.", 1.0);
    вернуть 0;
конец

функция токен_копия(): целое
    целое32 буфер = свойство(свойство(окно(), "navigator"), "clipboard");
    если (есть(буфер))
        когда_готово(вызвать1(буфер, "writeText", свойство(элемент("акк-токен"), "value")), "скопировано");
    конец
    вернуть 0;
конец

функция токен_новый_ответ(): целое
    целое32 м = метка();
    целое32 р = результат_запроса();
    если (есть(р) и объект_истина(свойство(р, "ok")))
        задать(элемент("акк-токен"), "value", свойство(р, "токен"));
        сказать("токен-сообщение", "Выдан новый токен.", 1.0);
    иначе
        сказать("токен-сообщение", "Не получилось.", 0.0);
    конец
    сбросить(м);
    вернуть 0;
конец

функция токен_новый(): целое
    если (объект_истина(вызвать1(окно(), "confirm", в_объект_текст("Выдать новый токен? Старый перестанет работать, в терминале придётся снова выполнить «сфера войти»."))))
        отправить_форму("/аккаунт/токен/новый", "", "токен_новый_ответ");
    конец
    вернуть 0;
конец

функция вкладка(): целое
    целое32 м = метка();
    целое32 нажатая = свойство(событие(), "currentTarget");
    текст цель = объект_в_текст(вызвать1(нажатая, "getAttribute", в_объект_текст("data-вкладка")));
    дробное вход_скрыт = 1.0;
    дробное рег_скрыта = 1.0;
    если (цель == "вход")
        вход_скрыт = 0.0;
    конец
    если (цель == "рег")
        рег_скрыта = 0.0;
    конец
    скрыть(элемент("вход-форма"), вход_скрыт);
    скрыть(элемент("рег-форма"), рег_скрыта);
    целое32 кнопки = вызвать1(свойство(окно(), "document"), "querySelectorAll", в_объект_текст("[data-вкладка]"));
    целое число = целое(объект_в_число(свойство(кнопки, "length")));
    целое i = 0;
    пока (i меньше число)
        целое32 к = свойство(кнопки, целое_в_текст(i));
        дробное притушить = 1.0;
        если (объект_в_текст(вызвать1(к, "getAttribute", в_объект_текст("data-вкладка"))) == цель)
            притушить = 0.0;
        конец
        вызвать2(свойство(к, "classList"), "toggle", в_объект_текст("secondary"), в_объект_число(притушить));
        i = i + 1;
    конец
    сбросить(м);
    вернуть 0;
конец

функция подписать(текст идентификатор, текст событие_имя, текст обработчик): целое
    целое32 э = элемент(идентификатор);
    если (есть(э))
        слушать(э, событие_имя, обработчик);
    конец
    вернуть 0;
конец

функция главная(): целое
    если (есть(элемент("шапка-аккаунт")))
        получить_json("/аккаунт/я", "шапка_готова");
    конец
    если ( не есть(элемент("акк-гость")) или не есть(элемент("акк-профиль")))
        вернуть 0;
    конец
    получить_json("/аккаунт/я", "страница_я");
    подписать("вход-форма", "submit", "отправка_входа");
    подписать("рег-форма", "submit", "отправка_регистрации");
    подписать("акк-выход", "click", "выйти");
    подписать("токен-показать", "click", "токен_показать");
    подписать("токен-копия", "click", "токен_копия");
    подписать("токен-новый", "click", "токен_новый");
    целое32 кнопки = вызвать1(свойство(окно(), "document"), "querySelectorAll", в_объект_текст("[data-вкладка]"));
    целое число = целое(объект_в_число(свойство(кнопки, "length")));
    целое i = 0;
    пока (i меньше число)
        слушать(свойство(кнопки, целое_в_текст(i)), "click", "вкладка");
        i = i + 1;
    конец
    вернуть 0;
конец
