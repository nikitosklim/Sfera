// стат.код — счётчик времени на странице (раньше static/stat.js).
// Без cookie и без адресов: шлёт активные секунды, глубину прокрутки и время по разделам
// при закрытии или сворачивании вкладки. Уважает «Не отслеживать» (Do Not Track).
// Состояние живёт в объекте window.__sfera_stat: у программы нет глобальных переменных.

подключить браузер;

функция начинается(текст источник, текст префикс): верно
    целое н = длина(префикс);
    если (длина(источник) меньше н)
        вернуть нет;
    конец
    результат из текста часть = подстрока(источник, 0, н);
    вернуть часть.успешно и часть.значение == префикс;
конец

функция состояние(): целое32
    вернуть свойство(окно(), "__sfera_stat");
конец

функция число_у(целое32 объект, текст имя): целое
    вернуть целое(объект_в_число(свойство(объект, имя)));
конец

функция кодировать(текст значение): текст
    вернуть объект_в_текст(вызвать1(окно(), "encodeURIComponent", в_объект_текст(значение)));
конец

функция новый_объект(): целое32
    вернуть вызвать1(свойство(окно(), "JSON"), "parse", в_объект_текст("{}"));
конец

// Название раздела, в котором сейчас читатель: последний заголовок h2/h3 с id выше 40% окна.
функция раздел(): текст
    целое32 м = метка();
    целое32 окно_ = окно();
    целое32 документ = свойство(окно_, "document");
    целое32 заголовки = вызвать1(документ, "querySelectorAll", в_объект_текст("h2[id], h3[id]"));
    целое всего = целое(объект_в_число(свойство(заголовки, "length")));
    дробное граница = объект_в_число(свойство(окно_, "innerHeight")) * 0.4;
    текст текущий = "начало";
    целое i = 0;
    пока (i меньше всего)
        целое32 э = свойство(заголовки, целое_в_текст(i));
        целое32 рамка = вызвать0(э, "getBoundingClientRect");
        если (объект_в_число(свойство(рамка, "top")) больше граница)
            i = всего;
        иначе
            целое32 чистый = вызвать2(в_объект_текст(объект_в_текст(свойство(э, "textContent"))), "replace", вызвать2(окно_, "RegExp", в_объект_текст("[:,&=%+\\s]+"), в_объект_текст("g")), в_объект_текст(" "));
            текст название = объект_в_текст(вызвать3(вызвать0(чистый, "trim"), "slice", в_объект_число(0.0), в_объект_число(40.0), 0));
            если (длина(название) больше 0)
                текущий = название;
            иначе
                текущий = "начало";
            конец
            i = i + 1;
        конец
    конец
    сбросить(м);
    вернуть текущий;
конец

функция глубина_сейчас(): целое
    целое32 окно_ = окно();
    целое32 ст = состояние();
    дробное высота_страницы = объект_в_число(свойство(свойство(свойство(окно_, "document"), "documentElement"), "scrollHeight"));
    если (высота_страницы меньше 1.0)
        высота_страницы = 1.0;
    конец
    дробное сделано = (объект_в_число(свойство(окно_, "scrollY")) + объект_в_число(свойство(окно_, "innerHeight"))) * 100.0 / высота_страницы;
    целое г = целое(объект_в_число(вызвать1(свойство(окно_, "Math"), "round", в_объект_число(сделано))));
    если (г больше число_у(ст, "глубина"))
        если (г больше 100)
            г = 100;
        конец
        задать(ст, "глубина", в_объект_число(дробное(г)));
    конец
    вернуть 0;
конец

функция прокрутка(): целое
    глубина_сейчас();
    вернуть 0;
конец

функция тик(): целое
    целое32 окно_ = окно();
    целое32 документ = свойство(окно_, "document");
    целое32 ст = состояние();
    если (объект_в_текст(свойство(документ, "visibilityState")) != "visible")
        вернуть 0;
    конец
    если ( не объект_истина(вызвать0(документ, "hasFocus")))
        вернуть 0;
    конец
    целое секунд = число_у(ст, "секунд");
    если (секунд >= 7200)
        вернуть 0;
    конец
    задать(ст, "секунд", в_объект_число(дробное(секунд + 1)));
    глубина_сейчас();
    текст р = раздел();
    целое32 разделы = свойство(ст, "разделы");
    целое32 ключи = вызвать1(свойство(окно_, "Object"), "keys", разделы);
    целое число_разделов = целое(объект_в_число(свойство(ключи, "length")));
    целое было = число_у(разделы, р);
    если (было > 0 или число_разделов меньше 12)
        задать(разделы, р, в_объект_число(дробное(было + 1)));
    конец
    вернуть 0;
конец

функция отправить_время(): целое
    целое32 м = метка();
    целое32 ст = состояние();
    целое секунд = число_у(ст, "секунд");
    если (секунд меньше 1)
        вернуть 0;
    конец
    глубина_сейчас();
    целое32 разделы = свойство(ст, "разделы");
    целое32 ключи = вызвать1(свойство(окно(), "Object"), "keys", разделы);
    целое число_ключей = целое(объект_в_число(свойство(ключи, "length")));
    текст список = "";
    целое взято = 0;
    пока (взято меньше 8 и взято меньше число_ключей)
        целое лучший = -1;
        целое лучшее_значение = 0;
        целое k = 0;
        пока (k меньше число_ключей)
            целое32 ключ = свойство(ключи, целое_в_текст(k));
            целое значение = целое(объект_в_число(свойство(разделы, объект_в_текст(ключ))));
            если (значение > лучшее_значение)
                лучшее_значение = значение;
                лучший = k;
            конец
            k = k + 1;
        конец
        если (лучший < 0)
            взято = 8;
        иначе
            текст имя = объект_в_текст(свойство(ключи, целое_в_текст(лучший)));
            если (длина(список) больше 0)
                список = список + ",";
            конец
            список = список + имя + ":" + целое_в_текст(лучшее_значение);
            задать(разделы, имя, в_объект_число(0.0));
            взято = взято + 1;
        конец
    конец
    текст тело = "п=" + кодировать(объект_в_текст(свойство(ст, "путь"))) + "&с=" + кодировать(объект_в_текст(свойство(ст, "сессия"))) +
        "&т=" + целое_в_текст(секунд) + "&г=" + целое_в_текст(число_у(ст, "глубина")) + "&р=" + кодировать(список);
    отправить_маяк("/статистика/время", тело);
    задать(ст, "секунд", в_объект_число(0.0));
    задать(ст, "разделы", новый_объект());
    сбросить(м);
    вернуть 0;
конец

функция скрыли(): целое
    целое32 документ = свойство(окно(), "document");
    если (объект_в_текст(свойство(документ, "visibilityState")) == "hidden")
        отправить_время();
    конец
    вернуть 0;
конец

функция главная(): целое
    целое32 окно_ = окно();
    целое32 документ = свойство(окно_, "document");
    если (объект_в_текст(свойство(свойство(окно_, "navigator"), "doNotTrack")) == "1" или объект_в_текст(свойство(окно_, "doNotTrack")) == "1")
        вернуть 0;
    конец
    если (содержит(объект_в_текст(свойство(документ, "cookie")), "sfera_own=1"))
        вернуть 0;
    конец
    текст путь = объект_в_текст(вызвать1(окно_, "decodeURIComponent", свойство(свойство(окно_, "location"), "pathname")));
    если (начинается(путь, "/управление") или начинается(путь, "/admin"))
        вернуть 0;
    конец
    целое32 хранилище = свойство(окно_, "sessionStorage");
    текст сессия = объект_в_текст(вызвать1(хранилище, "getItem", в_объект_текст("sfera-s")));
    если (длина(сессия) == 0)
        целое32 случайное = вызвать0(свойство(окно_, "Math"), "random");
        сессия = объект_в_текст(вызвать2(вызвать1(случайное, "toString", в_объект_число(36.0)), "slice", в_объект_число(2.0), в_объект_число(12.0)));
        вызвать2(хранилище, "setItem", в_объект_текст("sfera-s"), в_объект_текст(сессия));
    конец
    целое32 ст = новый_объект();
    задать(ст, "путь", в_объект_текст(путь));
    задать(ст, "сессия", в_объект_текст(сессия));
    задать(ст, "секунд", в_объект_число(0.0));
    задать(ст, "глубина", в_объект_число(0.0));
    задать(ст, "разделы", новый_объект());
    задать(окно_, "__sfera_stat", ст);
    каждые_мс(1000, "тик");
    слушать(окно_, "scroll", "прокрутка");
    слушать(документ, "visibilitychange", "скрыли");
    слушать(окно_, "pagehide", "отправить_время");
    вернуть 0;
конец
