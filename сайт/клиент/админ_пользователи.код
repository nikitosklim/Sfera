// админ_пользователи.код — блок «Пользователи» в /управление: роли и блокировка (раньше inline-скрипт в admin.html).
// Токен администратора берётся из поля #токен вверху страницы.

подключить браузер;

функция токен(): текст
    вернуть убрать_края(объект_в_текст(свойство(элемент("токен"), "value")));
конец

функция сказать(текст сообщение): целое
    задать(элемент("пол-статус"), "textContent", в_объект_текст(сообщение));
    вернуть 0;
конец

функция создать(текст тег, текст содержимое): целое32
    целое32 э = вызвать1(свойство(окно(), "document"), "createElement", в_объект_текст(тег));
    если (длина(содержимое) больше 0)
        задать(э, "textContent", в_объект_текст(содержимое));
    конец
    вернуть э;
конец

функция строка_имени(целое32 э): текст
    вернуть объект_в_текст(вызвать1(вызвать1(э, "closest", в_объект_текст("tr")), "getAttribute", в_объект_текст("data-имя")));
конец

функция дата_русская(текст секунды): текст
    если (длина(секунды) == 0)
        вернуть "";
    конец
    целое32 окно_ = окно();
    целое32 массив = вызвать1(свойство(окно_, "JSON"), "parse", в_объект_текст("[" + секунды + "000]"));
    целое32 дата = вызвать2(свойство(окно_, "Reflect"), "construct", свойство(окно_, "Date"), массив);
    вернуть объект_в_текст(вызвать1(дата, "toLocaleDateString", в_объект_текст("ru-RU")));
конец

функция название_роли(текст роль): текст
    если (роль == "админ")
        вернуть "администратор";
    конец
    вернуть роль;
конец

функция обновить_список(): целое
    целое32 таблица = элемент("пол-таблица");
    если (длина(токен()) == 0)
        задать(таблица, "innerHTML", в_объект_текст("<tr><td class=\"muted\">Введите токен вверху страницы</td></tr>"));
        вернуть 0;
    конец
    получить_json_с_токеном("/управление/пользователи", токен(), "список_пришёл");
    вернуть 0;
конец

функция список_пришёл(): целое
    целое32 м = метка();
    целое32 а = результат_запроса();
    целое32 таблица = элемент("пол-таблица");
    задать(таблица, "textContent", в_объект_текст(""));
    целое число = 0;
    если (есть(а) и объект_истина(вызвать1(свойство(окно(), "Array"), "isArray", а)))
        число = целое(объект_в_число(свойство(а, "length")));
    конец
    если (число == 0 и есть(а) и объект_истина(свойство(а, "ошибка")))
        сказать("Не удалось получить список: " + объект_в_текст(свойство(а, "ошибка")) + ". Проверьте токен.");
        задать(таблица, "innerHTML", в_объект_текст("<tr><td class=\"muted\">Не удалось получить список</td></tr>"));
        сбросить(м);
        вернуть 0;
    конец
    если (число == 0)
        задать(таблица, "innerHTML", в_объект_текст("<tr><td class=\"muted\">Пока никто не зарегистрировался</td></tr>"));
        сбросить(м);
        вернуть 0;
    конец
    целое i = 0;
    пока (i меньше число)
        целое32 п = свойство(а, целое_в_текст(i));
        текст имя = объект_в_текст(свойство(п, "имя"));
        текст роль = объект_в_текст(свойство(п, "роль"));
        верно заблокирован = объект_в_текст(свойство(п, "блок")) == "1";
        целое32 строка = создать("tr", "");
        вызвать2(строка, "setAttribute", в_объект_текст("data-имя"), в_объект_текст(имя));

        целое32 ячейка1 = создать("td", "");
        добавить_в(ячейка1, создать("b", имя));
        если (заблокирован)
            целое32 метка_блока = создать("span", "заблокирован");
            задать(метка_блока, "className", в_объект_текст("роль-метка роль-блок"));
            добавить_в(ячейка1, вызвать1(свойство(окно(), "document"), "createTextNode", в_объект_текст(" ")));
            добавить_в(ячейка1, метка_блока);
        конец
        добавить_в(ячейка1, создать("br", ""));
        целое32 дата = создать("span", "с " + дата_русская(объект_в_текст(свойство(п, "время"))));
        задать(дата, "className", в_объект_текст("muted"));
        добавить_в(ячейка1, дата);
        добавить_в(строка, ячейка1);

        целое32 ячейка2 = создать("td", "");
        целое32 выбор = создать("select", "");
        вызвать2(выбор, "setAttribute", в_объект_текст("aria-label"), в_объект_текст("Роль"));
        Список из текстов роли = Список из текстов();
        роли.добавить("пользователь");
        роли.добавить("модератор");
        роли.добавить("админ");
        целое k = 0;
        пока (k меньше роли.размер())
            целое32 вариант = создать("option", название_роли(роли.получить(k)));
            задать(вариант, "value", в_объект_текст(роли.получить(k)));
            если (роли.получить(k) == роль)
                задать(вариант, "selected", в_объект_число(1.0));
            конец
            добавить_в(выбор, вариант);
            k = k + 1;
        конец
        роли.освободить();
        слушать(выбор, "change", "роль_изменена");
        добавить_в(ячейка2, выбор);
        добавить_в(строка, ячейка2);

        целое32 ячейка3 = создать("td", "");
        вызвать2(ячейка3, "setAttribute", в_объект_текст("style"), в_объект_текст("text-align:right"));
        текст надпись = "Заблокировать";
        текст значение = "1";
        если (заблокирован)
            надпись = "Разблокировать";
            значение = "0";
        конец
        целое32 кнопка_блока = создать("button", надпись);
        задать(кнопка_блока, "className", в_объект_текст("button small secondary"));
        вызвать2(кнопка_блока, "setAttribute", в_объект_текст("data-значение"), в_объект_текст(значение));
        слушать(кнопка_блока, "click", "блок_нажат");
        добавить_в(ячейка3, кнопка_блока);
        добавить_в(строка, ячейка3);
        добавить_в(таблица, строка);
        i = i + 1;
    конец
    сбросить(м);
    вернуть 0;
конец

функция добавить_в(целое32 родитель, целое32 ребёнок): целое
    вызвать1(родитель, "appendChild", ребёнок);
    вернуть 0;
конец

функция роль_сохранена(): целое
    целое32 м = метка();
    целое32 р = результат_запроса();
    если (есть(р) и объект_истина(свойство(р, "ok")))
        сказать("Роль изменена: " + объект_в_текст(свойство(окно(), "__пол_имя")));
    иначе
        сказать("Ошибка: " + объект_в_текст(свойство(р, "ошибка")));
        обновить_список();
    конец
    сбросить(м);
    вернуть 0;
конец

функция роль_изменена(): целое
    целое32 м = метка();
    целое32 выбор = свойство(событие(), "currentTarget");
    текст имя = строка_имени(выбор);
    задать(окно(), "__пол_имя", в_объект_текст(имя));
    отправить_форму_с_токеном("/управление/пользователь/роль", "имя=" + кодировать(имя) + "&роль=" + кодировать(объект_в_текст(свойство(выбор, "value"))), токен(), "роль_сохранена");
    сбросить(м);
    вернуть 0;
конец

функция блок_сохранён(): целое
    целое32 м = метка();
    целое32 р = результат_запроса();
    если (есть(р) и объект_истина(свойство(р, "ok")))
        обновить_список();
    иначе
        сказать("Ошибка: " + объект_в_текст(свойство(р, "ошибка")));
    конец
    сбросить(м);
    вернуть 0;
конец

функция блок_нажат(): целое
    целое32 м = метка();
    целое32 кнопка = свойство(событие(), "currentTarget");
    текст имя = строка_имени(кнопка);
    текст значение = объект_в_текст(вызвать1(кнопка, "getAttribute", в_объект_текст("data-значение")));
    если (значение == "1" и не объект_истина(вызвать1(окно(), "confirm", в_объект_текст("Заблокировать «" + имя + "»? Он не сможет входить и публиковать."))))
        сбросить(м);
        вернуть 0;
    конец
    отправить_форму_с_токеном("/управление/пользователь/блок", "имя=" + кодировать(имя) + "&значение=" + кодировать(значение), токен(), "блок_сохранён");
    сбросить(м);
    вернуть 0;
конец

функция главная(): целое
    если ( не есть(элемент("пол-таблица")))
        вернуть 0;
    конец
    слушать(элемент("пол-обновить"), "click", "обновить_список");
    слушать(элемент("токен"), "change", "обновить_список");
    обновить_список();
    вернуть 0;
конец
