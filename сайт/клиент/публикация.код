функция манифест_прочитан(): целое
    целое32 м = метка();
    текст т = объект_в_текст(результат_запроса());
    целое32 имя = элемент("пуб-имя");
    если (длина(значение_ключа(т, "имя")) больше 0 и длина(значение("пуб-имя")) == 0)
        задать(имя, "value", в_объект_текст(значение_ключа(т, "имя")));
    конец
    если (длина(значение_ключа(т, "версия")) больше 0)
        задать(элемент("пуб-версия"), "value", в_объект_текст(значение_ключа(т, "версия")));
    конец
    если (длина(значение_ключа(т, "описание")) больше 0 и длина(значение("пуб-описание")) == 0)
        задать(элемент("пуб-описание"), "value", в_объект_текст(значение_ключа(т, "описание")));
    конец
    если (длина(значение_ключа(т, "лицензия")) больше 0)
        задать(элемент("пуб-лицензия"), "value", в_объект_текст(значение_ключа(т, "лицензия")));
    конец
    сбросить(м);
    вернуть 0;
конец

функция показать_файлы(): целое
    целое32 м = метка();
    целое32 файлы = свойство(состояние(), "файлы");
    целое число = целое(объект_в_число(свойство(файлы, "length")));
    целое32 список = элемент("пуб-список");
    задать(список, "textContent", в_объект_текст(""));
    целое32 документ = свойство(окно(), "document");
    целое32 манифест = ничего();
    целое i = 0;
    пока (i меньше число)
        целое32 ф = свойство(файлы, целое_в_текст(i));
        текст имя = объект_в_текст(свойство(ф, "name"));
        целое кб = целое(объект_в_число(свойство(ф, "size")) / 1024.0 + 0.5);
        если (кб < 1)
            кб = 1;
        конец
        текст подпись = имя + " (" + целое_в_текст(кб) + " КБ)";
        если ( не допустимо_в_архиве(имя) и не заканчивается(имя, ".tar.gz"))
            подпись = подпись + " — такой файл в пакет не входит, он будет пропущен";
        конец
        целое32 пункт = вызвать1(документ, "createElement", в_объект_текст("li"));
        задать(пункт, "textContent", в_объект_текст(подпись));
        вызвать1(список, "appendChild", пункт);
        если (имя == "пакет.сфера")
            манифест = ф;
        конец
        i = i + 1;
    конец
    если (число > 0)
        задать(элемент("пуб-дроп-текст"), "textContent", в_объект_текст("Выбрано файлов: " + целое_в_текст(число)));
    иначе
        задать(элемент("пуб-дроп-текст"), "textContent", в_объект_текст("Перетащите файлы сюда или нажмите, чтобы выбрать"));
    конец
    если (есть(манифест))
        когда_готово(вызвать0(манифест, "text"), "манифест_прочитан");
    конец
    сбросить(м);
    вернуть 0;
конец

функция запомнить_файлы(целое32 файлы): целое
    задать(состояние(), "файлы", вызвать1(свойство(окно(), "Array"), "from", файлы));
    показать_файлы();
    вернуть 0;
конец

функция файлы_выбраны(): целое
    целое32 м = метка();
    запомнить_файлы(свойство(свойство(событие(), "currentTarget"), "files"));
    сбросить(м);
    вернуть 0;
конец

