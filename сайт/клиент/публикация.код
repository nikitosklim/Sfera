функция сброшено(): целое
    целое32 м = метка();
    целое32 файлы = свойство(свойство(событие(), "dataTransfer"), "files");
    если (есть(файлы) и целое(объект_в_число(свойство(файлы, "length"))) > 0)
        запомнить_файлы(файлы);
    конец
    сбросить(м);
    вернуть 0;
конец

// ---- публикация

функция опубликовано(): целое
    целое32 м = метка();
    целое32 р = результат_запроса();
    целое32 с = состояние();
    если (есть(р) и объект_истина(свойство(р, "ok")))
        текст имя = объект_в_текст(свойство(с, "имя"));
        сообщить("Готово: «" + имя + "» " + объект_в_текст(свойство(с, "версия")) + " опубликован. Пока он «непроверенный». Он появится в каталоге: /пакеты/" + имя, 1.0);
    иначе
        если (есть(р) и объект_истина(свойство(р, "ошибка")))
            сообщить(объект_в_текст(свойство(р, "ошибка")), 0.0);
        иначе
            сообщить("Не получилось опубликовать.", 0.0);
        конец
    конец
    сбросить(м);
    вернуть 0;
конец

функция архив_готов(): целое
    целое32 м = метка();
    целое32 р = результат_запроса();
    целое32 с = состояние();
    если (есть(р) и объект_истина(свойство(р, "ok")))
        сообщить("Отправляю…", 1.0);
        опубликовать_архив(объект_в_текст(свойство(с, "имя")), объект_в_текст(свойство(с, "версия")), свойство(р, "данные"), "опубликовано");
    иначе
        если (есть(р) и объект_истина(свойство(р, "ошибка")))
            сообщить(объект_в_текст(свойство(р, "ошибка")), 0.0);
        иначе
            сообщить("Не получилось собрать архив.", 0.0);
        конец
    конец
    сбросить(м);
    вернуть 0;
конец

// Готовый .tar.gz пришёл как ArrayBuffer: сразу отправляем.
функция готовый_прочитан(): целое
    целое32 м = метка();
    целое32 с = состояние();
    сообщить("Отправляю…", 1.0);
    опубликовать_архив(объект_в_текст(свойство(с, "имя")), объект_в_текст(свойство(с, "версия")), результат_запроса(), "опубликовано");
    сбросить(м);
    вернуть 0;
конец

функция опубликовать_нажато(): целое
    целое32 м = метка();
    целое32 с = состояние();
    текст имя = значение("пуб-имя");
    текст версия = значение("пуб-версия");
    текст описание = значение("пуб-описание");
    текст лицензия = значение("пуб-лицензия");
    целое32 файлы = свойство(с, "файлы");
    целое число = целое(объект_в_число(свойство(файлы, "length")));
    если (число == 0)
        сообщить("Выберите файлы пакета.", 0.0);
        сбросить(м);
        вернуть 0;
    конец
    если (длина(имя) == 0)
        сообщить("Укажите название пакета.", 0.0);
        сбросить(м);
        вернуть 0;
    конец
    если ( не версия_верна(версия))
        сообщить("Версия должна быть вида 1.0.0.", 0.0);
        сбросить(м);
        вернуть 0;
    конец
    задать(с, "имя", в_объект_текст(имя));
    задать(с, "версия", в_объект_текст(версия));
    целое32 готовый = ничего();
    целое32 нужные = вызвать1(свойство(окно(), "JSON"), "parse", в_объект_текст("[]"));
    целое есть_код = 0;
    целое i = 0;
    пока (i меньше число)
        целое32 ф = свойство(файлы, целое_в_текст(i));
        текст название = объект_в_текст(свойство(ф, "name"));
        если (заканчивается(название, ".tar.gz") и не есть(готовый))
            готовый = ф;
        конец
        если (название != "пакет.сфера" и допустимо_в_архиве(название))
            вызвать1(нужные, "push", ф);
            если (заканчивается(название, ".код"))
                есть_код = есть_код + 1;
            конец
        конец
        i = i + 1;
    конец
    сообщить("Готовлю архив…", 1.0);
    если (есть(готовый))
        если (объект_в_число(свойство(готовый, "size")) > 5242880.0)
            сообщить("Архив больше 5 МБ.", 0.0);
        иначе
            когда_готово(вызвать0(готовый, "arrayBuffer"), "готовый_прочитан");
        конец
        сбросить(м);
        вернуть 0;
    конец
    если (длина(описание) == 0)
        сообщить("Напишите описание пакета.", 0.0);
        сбросить(м);
        вернуть 0;
    конец
    если (есть_код == 0)
        сообщить("В пакете нужен хотя бы один файл .код.", 0.0);
        сбросить(м);
        вернуть 0;
    конец
    если (длина(лицензия) == 0)
        лицензия = "MIT";
    конец
    текст манифест = "имя = " + имя + "\nверсия = " + версия + "\nописание = " + описание + "\nлицензия = " + лицензия + "\n";
    собрать_архив(нужные, манифест, "архив_готов");
    сбросить(м);
    вернуть 0;
конец

функция кто_пришёл(): целое
    целое32 м = метка();
    целое32 я = результат_запроса();
    если (есть(я) и объект_истина(свойство(я, "вошёл")))
        задать(элемент("пуб-форма-блок"), "hidden", в_объект_число(0.0));
    иначе
        задать(элемент("пуб-гость"), "hidden", в_объект_число(0.0));
    конец
    сбросить(м);
    вернуть 0;
конец

функция главная(): целое
    если ( не есть(элемент("пуб-форма")))
        вернуть 0;
    конец
    состояние();
    слушать(элемент("пуб-файлы"), "change", "файлы_выбраны");
    целое32 дроп = элемент("пуб-дроп");
    слушать(дроп, "dragenter", "над_вошёл");
    слушать(дроп, "dragover", "над_вошёл");
    слушать(дроп, "dragleave", "над_ушёл");
    слушать(дроп, "drop", "над_ушёл");
    слушать(дроп, "drop", "сброшено");
    слушать(элемент("пуб-кнопка"), "click", "опубликовать_нажато");
    получить_json("/аккаунт/я", "кто_пришёл");
    вернуть 0;
конец
