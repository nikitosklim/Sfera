// публикация.код — публикация пакета со страницы сайта (раньше static/публикация.js).
// Файлы выбираются на странице, архив .tar.gz собирает браузер (мост сфера-хост.js), проверки и сообщения — здесь.

подключить браузер;

функция состояние(): целое32
    целое32 с = свойство(окно(), "__пуб");
    если (есть(с))
        вернуть с;
    конец
    целое32 новый = вызвать1(свойство(окно(), "JSON"), "parse", в_объект_текст("{\"файлы\":[]}"));
    задать(окно(), "__пуб", новый);
    вернуть новый;
конец

функция сообщить(текст сообщение, дробное хорошо): целое
    целое32 э = элемент("пуб-сообщение");
    задать(э, "textContent", в_объект_текст(сообщение));
    если (хорошо > 0.5)
        задать(э, "className", в_объект_текст("акк-сообщение хорошо"));
    иначе
        задать(э, "className", в_объект_текст("акк-сообщение"));
    конец
    вернуть 0;
конец

функция значение(текст идентификатор): текст
    вернуть убрать_края(объект_в_текст(свойство(элемент(идентификатор), "value")));
конец

// В архив входят: пакет.сфера, сфера.зависимости, LICENSE, *.код и *.md в корне, без путей.
функция допустимо_в_архиве(текст имя): верно
    если (содержит(имя, "/") или содержит(имя, "\\") или содержит(имя, "..") или длина(имя) == 0 или целое(байт_текста(имя, 0)) == 46)
        вернуть нет;
    конец
    если (имя == "пакет.сфера" или имя == "сфера.зависимости" или имя == "LICENSE")
        вернуть да;
    конец
    вернуть заканчивается(имя, ".код") или заканчивается(имя, ".md");
конец

// Версия вида X.Y.Z, где X, Y и Z — числа.
функция версия_верна(текст версия): верно
    целое точек = 0;
    верно есть_цифра = нет;
    целое i = 0;
    пока (i меньше длина(версия))
        целое б = целое(байт_текста(версия, i));
        если (б == 46)
            если ( не есть_цифра)
                вернуть нет;
            конец
            точек = точек + 1;
            есть_цифра = нет;
        иначе
            если (б < 48 или б > 57)
                вернуть нет;
            конец
            есть_цифра = да;
        конец
        i = i + 1;
    конец
    вернуть точек == 2 и есть_цифра;
конец

// Значение ключа из текста вида «ключ = значение» построчно (как в пакет.сфера).
функция значение_ключа(текст т, текст ключ): текст
    целое всего = длина(т);
    целое позиция = 0;
    пока (позиция меньше всего)
        целое до = позиция;
        пока (до меньше всего и целое(байт_текста(т, до)) != 10)
            до = до + 1;
        конец
        текст строка = подстрока_или_пусто(т, позиция, до - позиция);
        позиция = до + 1;
        целое равно = 0;
        пока (равно меньше длина(строка) и целое(байт_текста(строка, равно)) != 61)
            равно = равно + 1;
        конец
        если (равно меньше длина(строка) и убрать_края(подстрока_или_пусто(строка, 0, равно)) == ключ)
            вернуть убрать_края(подстрока_или_пусто(строка, равно + 1, длина(строка) - равно - 1));
        конец
    конец
    вернуть "";
конец

