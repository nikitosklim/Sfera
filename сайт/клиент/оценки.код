// оценки.код — звёзды, комментарии и модерация пакетов (раньше static/оценки.js).
// Страница пакета (/пакеты/<имя>): блок #оценки. Страница модерации (/пакеты/модерация): таблица #мод-таблица.

подключить браузер;

// ---- общее

функция создать(текст тег, текст класс, текст содержимое): целое32
    целое32 э = вызвать1(свойство(окно(), "document"), "createElement", в_объект_текст(тег));
    если (длина(класс) больше 0)
        задать(э, "className", в_объект_текст(класс));
    конец
    если (длина(содержимое) больше 0)
        задать(э, "textContent", в_объект_текст(содержимое));
    конец
    вернуть э;
конец

функция добавить(целое32 родитель, целое32 ребёнок): целое
    вызвать1(родитель, "appendChild", ребёнок);
    вернуть 0;
конец

функция очистить(целое32 э): целое
    задать(э, "textContent", в_объект_текст(""));
    вернуть 0;
конец

функция метка_статуса(текст статус): текст
    если (статус == "непроверен")
        вернуть "непроверенный";
    конец
    вернуть статус;
конец

// Дата из юникс-времени в секундах, как её пишут по-русски.
функция дата_текстом(текст секунды): текст
    если (длина(секунды) == 0)
        вернуть "";
    конец
    целое32 окно_ = окно();
    целое32 массив = вызвать1(свойство(окно_, "JSON"), "parse", в_объект_текст("[" + секунды + "000]"));
    целое32 дата = вызвать2(свойство(окно_, "Reflect"), "construct", свойство(окно_, "Date"), массив);
    вернуть объект_в_текст(вызвать1(дата, "toLocaleString", в_объект_текст("ru-RU")));
конец

функция атрибут(целое32 э, текст имя): текст
    вернуть объект_в_текст(вызвать1(э, "getAttribute", в_объект_текст(имя)));
конец

функция сообщить(текст сообщение): целое
    целое32 э = элемент("оценки-сообщение");
    если (есть(э))
        задать(э, "textContent", в_объект_текст(сообщение));
    конец
    вернуть 0;
конец

функция сообщить_мод(текст сообщение): целое
    целое32 э = элемент("мод-сообщение");
    если (есть(э))
        задать(э, "textContent", в_объект_текст(сообщение));
    конец
    вернуть 0;
конец

функция текст_ошибки(целое32 р): текст
    если (есть(р) и объект_истина(свойство(р, "ошибка")))
        вернуть объект_в_текст(свойство(р, "ошибка"));
    конец
    вернуть "Не получилось.";
конец

// ---- страница пакета

функция имя_пакета(): текст
    вернуть атрибут(элемент("оценки"), "data-пакет");
конец

функция загрузить_оценки(): целое
    получить_json("/оценки/пакет/" + кодировать(имя_пакета()), "оценки_пришли");
    вернуть 0;
конец

// Ответ на действие: при успехе перерисовать блок, при ошибке показать причину.
функция действие_выполнено(): целое
    целое32 м = метка();
    целое32 р = результат_запроса();
    если (есть(р) и объект_истина(свойство(р, "ok")))
        загрузить_оценки();
    иначе
        сообщить(текст_ошибки(р));
    конец
    сбросить(м);
    вернуть 0;
конец

функция звезда_нажата(): целое
    целое32 д = свойство(элемент("оценки"), "__д");
    если ( не объект_истина(свойство(д, "вошёл")))
        задать(свойство(окно(), "location"), "href", в_объект_текст("/аккаунт"));
        вернуть 0;
    конец
    отправить_форму("/оценки/звезда", "имя=" + кодировать(имя_пакета()), "действие_выполнено");
    вернуть 0;
конец

функция статус_нажат(): целое
    целое32 м = метка();
    текст статус = атрибут(свойство(событие(), "currentTarget"), "data-статус");
    отправить_форму("/оценки/статус", "имя=" + кодировать(имя_пакета()) + "&статус=" + кодировать(статус), "действие_выполнено");
    сбросить(м);
    вернуть 0;
конец

функция пакет_удалён(): целое
    целое32 м = метка();
    целое32 р = результат_запроса();
    если (есть(р) и объект_истина(свойство(р, "ok")))
        задать(свойство(окно(), "location"), "href", в_объект_текст("/пакеты"));
    иначе
        сообщить(текст_ошибки(р));
    конец
    сбросить(м);
    вернуть 0;
конец

функция удалить_пакет_нажато(): целое
    текст имя = имя_пакета();
    если (объект_истина(вызвать1(окно(), "confirm", в_объект_текст("Удалить пакет «" + имя + "» со всеми версиями и комментариями? Это нельзя отменить."))))
        отправить_форму("/оценки/пакет/удалить", "имя=" + кодировать(имя), "пакет_удалён");
    конец
    вернуть 0;
конец

функция комментарий_удалить_нажато(): целое
    целое32 м = метка();
    текст номер = атрибут(свойство(событие(), "currentTarget"), "data-номер");
    отправить_форму("/оценки/комментарий/удалить", "номер=" + кодировать(номер), "действие_выполнено");
    сбросить(м);
    вернуть 0;
конец

функция форма_отправлена(): целое
    целое32 м = метка();
    вызвать0(событие(), "preventDefault");
    текст т = объект_в_текст(свойство(элемент("оценки-текст"), "value"));
    если (длина(убрать_края(т)) больше 0)
        отправить_форму("/оценки/комментарий", "имя=" + кодировать(имя_пакета()) + "&текст=" + кодировать(т), "действие_выполнено");
    конец
    сбросить(м);
    вернуть 0;
конец

функция кнопка(текст класс, текст надпись): целое32
    целое32 к = создать("button", класс, надпись);
    задать(к, "type", в_объект_текст("button"));
    вернуть к;
конец

функция оценки_пришли(): целое
    целое32 м = метка();
    целое32 д = результат_запроса();
    целое32 корень = элемент("оценки");
    очистить(корень);
    если ( не есть(д) или не объект_истина(свойство(д, "ok")))
        сбросить(м);
        вернуть 0;
    конец
    задать(корень, "__д", д);
    текст роль = объект_в_текст(свойство(д, "роль"));
    верно модератор = роль == "модератор" или роль == "админ";
    верно вошёл = объект_истина(свойство(д, "вошёл"));
    текст статус = объект_в_текст(свойство(д, "статус"));
    добавить(корень, создать("h3", "", "Оценки и комментарии"));

    целое32 строка = создать("p", "оценки-строка", "");
    текст знак = "☆ ";
    текст класс_звезды = "button small secondary";
    если (объект_истина(свойство(д, "моя")))
        знак = "★ ";
        класс_звезды = "button small";
    конец
    целое32 звезда = кнопка(класс_звезды, знак + объект_в_текст(свойство(д, "звёзды")));
    если (вошёл)
        задать(звезда, "title", в_объект_текст("Поставить или снять звезду"));
    иначе
        задать(звезда, "title", в_объект_текст("Войдите, чтобы поставить звезду"));
    конец
    слушать(звезда, "click", "звезда_нажата");
    добавить(строка, звезда);
    добавить(строка, создать("span", "метка-статуса статус-" + статус, метка_статуса(статус)));
    добавить(корень, строка);

    если (модератор)
        целое32 мод = создать("p", "оценки-мод", "");
        добавить(мод, создать("span", "muted", "Модерация: "));
        Список из текстов значения = Список из текстов();
        Список из текстов надписи = Список из текстов();
        значения.добавить("проверен");
        надписи.добавить("Проверен");
        значения.добавить("нежелательный");
        надписи.добавить("Нежелательный");
        значения.добавить("непроверен");
        надписи.добавить("Непроверенный");
        целое k = 0;
        пока (k меньше значения.размер())
            целое32 б = кнопка("button small secondary", надписи.получить(k));
            вызвать2(б, "setAttribute", в_объект_текст("data-статус"), в_объект_текст(значения.получить(k)));
            слушать(б, "click", "статус_нажат");
            добавить(мод, б);
            k = k + 1;
        конец
        значения.освободить();
        надписи.освободить();
        если (роль == "админ")
            целое32 у = кнопка("button small опасно", "Удалить пакет");
            слушать(у, "click", "удалить_пакет_нажато");
            добавить(мод, у);
        конец
        добавить(корень, мод);
    конец

    целое32 список = создать("div", "комментарии", "");
    целое32 комментарии = свойство(д, "комментарии");
    целое число = целое(объект_в_число(свойство(комментарии, "length")));
    если (число == 0)
        добавить(список, создать("p", "muted", "Комментариев пока нет. Если вы пробовали пакет, расскажите, как он работает."));
    конец
    текст я = объект_в_текст(свойство(д, "вошёл"));
    целое i = 0;
    пока (i меньше число)
        целое32 к = свойство(комментарии, целое_в_текст(i));
        текст автор = объект_в_текст(свойство(к, "автор"));
        целое32 блок = создать("div", "комментарий", "");
        целое32 шапка = создать("div", "комментарий-шапка", "");
        добавить(шапка, создать("b", "", автор));
        добавить(шапка, создать("span", "muted", " " + дата_текстом(объект_в_текст(свойство(к, "время")))));
        если (вошёл и (автор == я или модератор))
            целое32 х = кнопка("комментарий-удалить", "удалить");
            вызвать2(х, "setAttribute", в_объект_текст("data-номер"), свойство(к, "номер"));
            слушать(х, "click", "комментарий_удалить_нажато");
            добавить(шапка, х);
        конец
        добавить(блок, шапка);
        добавить(блок, создать("p", "", объект_в_текст(свойство(к, "текст"))));
        добавить(список, блок);
        i = i + 1;
    конец
    добавить(корень, список);

    если (вошёл)
        целое32 форма = создать("form", "комментарий-форма", "");
        целое32 поле = создать("textarea", "", "");
        задать(поле, "id", в_объект_текст("оценки-текст"));
        задать(поле, "maxLength", в_объект_число(1000.0));
        задать(поле, "rows", в_объект_число(3.0));
        задать(поле, "placeholder", в_объект_текст("Ваш комментарий (до 1000 знаков). Если пакет опасен или ведёт себя странно, напишите об этом."));
        целое32 отправить = создать("button", "button small", "Отправить");
        задать(отправить, "type", в_объект_текст("submit"));
        добавить(форма, поле);
        добавить(форма, отправить);
        слушать(форма, "submit", "форма_отправлена");
        добавить(корень, форма);
    иначе
        целое32 подсказка = создать("p", "muted", "Чтобы ставить звёзды и писать комментарии, ");
        целое32 вход = создать("a", "", "войдите в аккаунт");
        задать(вход, "href", в_объект_текст("/аккаунт"));
        добавить(подсказка, вход);
        добавить(подсказка, вызвать1(свойство(окно(), "document"), "createTextNode", в_объект_текст(".")));
        добавить(корень, подсказка);
    конец
    целое32 сообщение = создать("p", "акк-сообщение", "");
    задать(сообщение, "id", в_объект_текст("оценки-сообщение"));
    добавить(корень, сообщение);
    сбросить(м);
    вернуть 0;
конец

// ---- страница модерации

функция состояние_мод(): целое32
    целое32 с = свойство(окно(), "__мод");
    если (есть(с))
        вернуть с;
    конец
    целое32 новый = вызвать1(свойство(окно(), "JSON"), "parse", в_объект_текст("{\"фильтр\":\"все\",\"роль\":\"\"}"));
    задать(окно(), "__мод", новый);
    вернуть новый;
конец

функция мод_действие_выполнено(): целое
    целое32 м = метка();
    целое32 р = результат_запроса();
    если (есть(р) и объект_истина(свойство(р, "ok")))
        получить_json("/оценки/модерация", "мод_список_пришёл");
    иначе
        сообщить_мод(текст_ошибки(р));
    конец
    сбросить(м);
    вернуть 0;
конец

функция мод_статус_нажат(): целое
    целое32 м = метка();
    целое32 к = свойство(событие(), "currentTarget");
    отправить_форму("/оценки/статус", "имя=" + кодировать(атрибут(к, "data-имя")) + "&статус=" + кодировать(атрибут(к, "data-статус")), "мод_действие_выполнено");
    сбросить(м);
    вернуть 0;
конец

функция мод_удалить_нажато(): целое
    целое32 м = метка();
    текст имя = атрибут(свойство(событие(), "currentTarget"), "data-имя");
    если (объект_истина(вызвать1(окно(), "confirm", в_объект_текст("Удалить пакет «" + имя + "» совсем?"))))
        отправить_форму("/оценки/пакет/удалить", "имя=" + кодировать(имя), "мод_действие_выполнено");
    конец
    сбросить(м);
    вернуть 0;
конец

функция фильтр_нажат(): целое
    целое32 м = метка();
    задать(состояние_мод(), "фильтр", в_объект_текст(атрибут(свойство(событие(), "currentTarget"), "data-фильтр")));
    рисовать_таблицу();
    сбросить(м);
    вернуть 0;
конец

функция ячейка(целое32 строка, текст класс, текст содержимое): целое32
    целое32 я = создать("td", класс, содержимое);
    добавить(строка, я);
    вернуть я;
конец

функция кнопка_мод(целое32 куда, текст надпись, текст подсказка, текст имя, текст статус): целое
    целое32 к = кнопка("button small secondary", надпись);
    задать(к, "title", в_объект_текст(подсказка));
    вызвать2(к, "setAttribute", в_объект_текст("data-имя"), в_объект_текст(имя));
    вызвать2(к, "setAttribute", в_объект_текст("data-статус"), в_объект_текст(статус));
    слушать(к, "click", "мод_статус_нажат");
    добавить(куда, к);
    вернуть 0;
конец

функция рисовать_таблицу(): целое
    целое32 с = состояние_мод();
    целое32 таблица = элемент("мод-таблица");
    очистить(таблица);
    текст фильтр = объект_в_текст(свойство(с, "фильтр"));
    текст роль = объект_в_текст(свойство(с, "роль"));
    целое32 данные = свойство(с, "данные");
    целое32 шапка = создать("tr", "", "");
    Список из текстов заголовки = Список из текстов();
    заголовки.добавить("Пакет");
    заголовки.добавить("Автор");
    заголовки.добавить("Статус");
    заголовки.добавить("★");
    заголовки.добавить("💬");
    заголовки.добавить("");
    целое h = 0;
    пока (h меньше заголовки.размер())
        добавить(шапка, создать("th", "", заголовки.получить(h)));
        h = h + 1;
    конец
    заголовки.освободить();
    добавить(таблица, шапка);
    целое число = 0;
    если (есть(данные))
        число = целое(объект_в_число(свойство(данные, "length")));
    конец
    целое показано = 0;
    целое i = 0;
    пока (i меньше число)
        целое32 п = свойство(данные, целое_в_текст(i));
        текст статус = объект_в_текст(свойство(п, "статус"));
        если (фильтр == "все" или фильтр == статус)
            показано = показано + 1;
            текст имя = объект_в_текст(свойство(п, "имя"));
            целое32 строка = создать("tr", "", "");
            целое32 я1 = ячейка(строка, "", "");
            целое32 а = создать("a", "", имя);
            задать(а, "href", в_объект_текст("/пакеты/" + кодировать(имя)));
            добавить(я1, а);
            добавить(я1, создать("br", "", ""));
            добавить(я1, создать("span", "muted", объект_в_текст(свойство(п, "версия")) + " · " + дата_текстом(объект_в_текст(свойство(п, "время"))) ));
            ячейка(строка, "", объект_в_текст(свойство(п, "автор")));
            целое32 я3 = ячейка(строка, "", "");
            добавить(я3, создать("span", "метка-статуса статус-" + статус, метка_статуса(статус)));
            ячейка(строка, "", объект_в_текст(свойство(п, "звёзды")));
            ячейка(строка, "", объект_в_текст(свойство(п, "комментарии")));
            целое32 я6 = ячейка(строка, "действия", "");
            кнопка_мод(я6, "✓", "Отметить «проверен»", имя, "проверен");
            кнопка_мод(я6, "⚠", "Отметить «нежелательный»", имя, "нежелательный");
            кнопка_мод(я6, "↺", "Вернуть «непроверенный»", имя, "непроверен");
            если (роль == "админ")
                целое32 у = кнопка("button small опасно", "🗑");
                задать(у, "title", в_объект_текст("Удалить пакет"));
                вызвать2(у, "setAttribute", в_объект_текст("data-имя"), в_объект_текст(имя));
                слушать(у, "click", "мод_удалить_нажато");
                добавить(я6, у);
            конец
            добавить(таблица, строка);
        конец
        i = i + 1;
    конец
    если (показано == 0)
        целое32 пустая = создать("tr", "", "");
        целое32 я = ячейка(пустая, "muted", "Здесь пока пусто.");
        задать(я, "colSpan", в_объект_число(6.0));
        добавить(таблица, пустая);
    конец
    вернуть 0;
конец

