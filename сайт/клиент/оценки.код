    если (есть(элемент("оценки")))
        загрузить_оценки();
    конец
    если (есть(элемент("мод-таблица")))
        целое32 кнопки = вызвать1(свойство(окно(), "document"), "querySelectorAll", в_объект_текст("[data-фильтр]"));
        целое число = целое(объект_в_число(свойство(кнопки, "length")));
        целое i = 0;
        пока (i меньше число)
            слушать(свойство(кнопки, целое_в_текст(i)), "click", "фильтр_нажат");
            i = i + 1;
        конец
        получить_json("/аккаунт/я", "мод_кто_пришёл");
    конец
    вернуть 0;
