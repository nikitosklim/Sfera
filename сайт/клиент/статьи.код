// статьи.код — фильтр карточек статей по тегам (раньше static/статьи.js).

подключить браузер;

функция документ_страницы(): целое32
    вернуть свойство(окно(), "document");
конец

функция нажата(): целое
    целое32 м = метка();
    целое32 документ = документ_страницы();
    целое32 кнопка_нажата = свойство(событие(), "currentTarget");
    текст тег = объект_в_текст(вызвать1(кнопка_нажата, "getAttribute", в_объект_текст("data-тег")));
    целое32 кнопки = вызвать1(документ, "querySelectorAll", в_объект_текст(".фильтр-тегов button"));
    целое число_кнопок = целое(объект_в_число(свойство(кнопки, "length")));
    целое i = 0;
    пока (i меньше число_кнопок)
        целое32 б = свойство(кнопки, целое_в_текст(i));
        текст её_тег = объект_в_текст(вызвать1(б, "getAttribute", в_объект_текст("data-тег")));
        дробное включить = 0.0;
        если (её_тег == тег)
            включить = 1.0;
        конец
        вызвать2(свойство(б, "classList"), "toggle", в_объект_текст("активный"), в_объект_число(включить));
        i = i + 1;
    конец
    целое32 карточки = вызвать1(документ, "querySelectorAll", в_объект_текст(".статья"));
    целое число_карточек = целое(объект_в_число(свойство(карточки, "length")));
    целое k = 0;
    пока (k меньше число_карточек)
        целое32 с = свойство(карточки, целое_в_текст(k));
        текст теги = объект_в_текст(вызвать1(с, "getAttribute", в_объект_текст("data-теги")));
        дробное скрыть = 0.0;
        если (длина(тег) больше 0 и не содержит(теги, "," + тег + ","))
            скрыть = 1.0;
        конец
        задать(с, "hidden", в_объект_число(скрыть));
        k = k + 1;
    конец
    сбросить(м);
    вернуть 0;
конец

функция главная(): целое
    целое32 кнопки = вызвать1(документ_страницы(), "querySelectorAll", в_объект_текст(".фильтр-тегов button"));
    целое число_кнопок = целое(объект_в_число(свойство(кнопки, "length")));
    целое i = 0;
    пока (i меньше число_кнопок)
        слушать(свойство(кнопки, целое_в_текст(i)), "click", "нажата");
        i = i + 1;
    конец
    вернуть 0;
конец
