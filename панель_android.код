    вернуть "«Сфера» — независимый, компилируемый язык\n"
        + "программирования с полностью русским синтаксисом.\n"
        + "Компилятор написан на Rust, генерирует машинный\n"
        + "код напрямую через LLVM.\n\n"
        + "Возможности: автоматическое управление памятью\n"
        + "(ARC), контракты и полиморфизм, обобщённые типы,\n"
        + "настоящая многопоточность, графический интерфейс,\n"
        + "собственное хранилище данных.\n\n"
        + "Честные ограничения: соло-проект одного\n"
        + "разработчика. Нет полноценного пакетного\n"
        + "менеджера с публикацией и версиями. Диагностика\n"
        + "ошибок компилятора активно дорабатывается.";
}

функция пример_синтаксиса() -> текст {
    вернуть "функция главная() -> целое {\n"
        + "    вывести(\"Привет, мир!\");\n"
        + "    вернуть 0;\n"
        + "}\n\n"
        + "структура Кот {\n"
        + "    текст кличка;\n"
        + "    функция мяукнуть() -> текст {\n"
        + "        вернуть это.кличка + \": Мяу!\";\n"
        + "    }\n"
        + "}\n\n"
        + "результат<целое> итог = текст_в_целое(\"42\");\n"
        + "если (итог.успешно) {\n"
        + "    вывести(целое_в_текст(итог.значение));\n"
        + "}";
}

функция заглушка_установки() -> текст {
    вернуть "Установка компилятора на устройство здесь\n"
        + "пока недоступна.\n\n"
        + "Причина честно, подробно объяснена: Android не\n"
        + "даёт обычным приложениям свободно запускать\n"
        + "скачанные во время работы программы (политика\n"
        + "безопасности W^X) и не даёт прямого доступа к\n"
        + "системной оболочке, на которой построена версия\n"
        + "этой панели для macOS.\n\n"
        + "Настоящий путь вперёд — собрать сам компилятор\n"
        + "заранее, под Android, и зашить его в сборку\n"
        + "приложения целиком — большая, отдельная задача.";
}

// Многострочный текст постоянного цвета — тот же приём, что и в
// панели для macOS, скопирован сюда напрямую (не вынесен в общий
// графика.код), чтобы не менять уже отработанный API для той панели.
функция нарисовать_многострочный_текст(текст холст, текст шрифт, текст содержимое, целое32 х, целое32 начальный_у, беззнак32 цвет) -> целое {
    текст остаток = содержимое;
    целое32 текущий_у = начальный_у;
    целое строк_нарисовано = 0;

    пока (строк_нарисовано < 30) {
        результат<целое> позиция_переноса = найти(остаток, "\n");
        если (позиция_переноса.успешно) {
            результат<текст> строка = подстрока(остаток, 0, позиция_переноса.значение);
            если (строка.успешно) {
                нарисовать_текст(холст, шрифт, строка.значение, х, текущий_у, цвет);
            }
            целое следующая_позиция = позиция_переноса.значение + 1;
            целое длина_остатка = длина(остаток) - следующая_позиция;
            результат<текст> остаток_после = подстрока(остаток, следующая_позиция, длина_остатка);
            если (остаток_после.успешно) {
                остаток = остаток_после.значение;
            } иначе {
                вернуть строк_нарисовано;
            }
        } иначе {
            если (длина(остаток) > 0) {
                нарисовать_текст(холст, шрифт, остаток, х, текущий_у, цвет);
                строк_нарисовано = строк_нарисовано + 1;
            }
            вернуть строк_нарисовано;
        }
        текущий_у = текущий_у + целое32(22);
        строк_нарисовано = строк_нарисовано + 1;
    }

    вернуть строк_нарисовано;
}

функция главная() -> целое {
    инициализировать(беззнак32(32));
    инициализировать_шрифты();

    текст окно = создать_окно("Сфера — среда разработки", целое32(0), целое32(0), целое32(400), целое32(700), беззнак32(0));
    текст рендерер = создать_холст(окно, целое32(-1), беззнак32(2));
    текст шрифт = открыть_шрифт("шрифт.ttf", целое32(16));
    текст буфер_события = выделить_память(56);

    РазмерЭкрана размер = размер_окна(окно);
    android_лог(целое32(4), "SferaPanel", "размер окна: " + целое_в_текст(целое(размер.ширина)) + "x" + целое_в_текст(целое(размер.высота)));

    // Вкладки сверху (не сбоку, как в macOS-версии) — на узком экране
    // телефона боковая колонка отъедала бы слишком много ширины у
    // содержимого; горизонтальные вкладки — привычнее для мобильного UI.
    Кнопка вкладка_обзор = Кнопка(целое32(0), целое32(0), целое32(0), целое32(60), беззнак8(40), беззнак8(45), беззнак8(60), "Обзор");
    Кнопка вкладка_документация = Кнопка(целое32(0), целое32(0), целое32(0), целое32(60), беззнак8(40), беззнак8(45), беззнак8(60), "Документация");
    Кнопка вкладка_установка = Кнопка(целое32(0), целое32(0), целое32(0), целое32(60), беззнак8(40), беззнак8(45), беззнак8(60), "Установка");
    Список<Кнопка> вкладки_список = Список<Кнопка>();
    вкладки_список.добавить(вкладка_обзор);
    вкладки_список.добавить(вкладка_документация);
    вкладки_список.добавить(вкладка_установка);
    Панель панель_вкладок = Панель(целое32(0), целое32(0), целое32(400), целое32(60), беззнак8(25), беззнак8(28), беззнак8(38), вкладки_список);
    // НОВОЕ (якоря): ширина панели и позиции трёх вкладок внутри нее
    // должны подстраиваться под реальную ширину экрана устройства, а не
    // угаданную заранее — растягиваем панель, затем расставляем вкладки
    // равными долями по её новой, настоящей ширине.
    панель_вкладок.растянуть_по_ширине(размер);
    целое32 ширина_вкладки = размер.ширина / целое32(3);
    Список<Кнопка> вкладки_для_позиций = панель_вкладок.кнопки;
    Кнопка вкладка0 = вкладки_для_позиций.получить(0);
    вкладка0.х = целое32(0);
    вкладка0.ширина = ширина_вкладки;
    Кнопка вкладка1 = вкладки_для_позиций.получить(1);
    вкладка1.х = ширина_вкладки;
    вкладка1.ширина = ширина_вкладки;
    Кнопка вкладка2 = вкладки_для_позиций.получить(2);
    вкладка2.х = ширина_вкладки + ширина_вкладки;
    вкладка2.ширина = размер.ширина - вкладка2.х;

    целое текущая_вкладка = 0;
    верно работает = да;

    пока (работает) {
        целое32 итог_события = опросить_событие(буфер_события);
        пока (итог_события != целое32(0)) {
            целое32 тип_события = прочитать_целое32(буфер_события, 0);
            если (тип_события == целое32(1025)) {
                целое32 х_клика = прочитать_целое32(буфер_события, 20);
                целое32 у_клика = прочитать_целое32(буфер_события, 24);
                целое32 индекс_вкладки = панель_вкладок.кнопка_под_точкой(х_клика, у_клика);
                если (индекс_вкладки >= целое32(0)) {
                    текущая_вкладка = целое(индекс_вкладки);
                }
            }
            если (тип_события == целое32(256)) {
                работает = нет;
            }
            итог_события = опросить_событие(буфер_события);
        }

        задать_цвет(рендерер, беззнак8(20), беззнак8(20), беззнак8(24), беззнак8(255));
        очистить_холст(рендерер);

        панель_вкладок.нарисовать(рендерер, шрифт);

        если (текущая_вкладка == 0) {
            нарисовать_текст(рендерер, шрифт, "Версия: " + текущая_версия(), целое32(20), целое32(80), беззнак32(4294967295));
            нарисовать_многострочный_текст(рендерер, шрифт, описание_языка(), целое32(20), целое32(115), беззнак32(4294967295));
        } иначе если (текущая_вкладка == 1) {
            нарисовать_текст(рендерер, шрифт, "Пример синтаксиса:", целое32(20), целое32(80), беззнак32(4294967295));
            нарисовать_многострочный_текст(рендерер, шрифт, пример_синтаксиса(), целое32(20), целое32(115), беззнак32(4288716692));
        } иначе {
            нарисовать_многострочный_текст(рендерер, шрифт, заглушка_установки(), целое32(20), целое32(80), беззнак32(4294967295));
        }

        показать_холст(рендерер);
        подождать(беззнак32(30));
    }

    закрыть_окно(окно);
    завершить();
    вернуть 0;
}
