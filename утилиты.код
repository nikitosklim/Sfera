// Вспомогательный модуль — подключается через "подключить утилиты;"
// из основного файла (см. тест_подключения.код).
//
// Этот файл специально НЕ содержит "главная" — значит его теперь можно
// собрать и НАПРЯМУЮ, отдельно, как библиотеку (объектный файл, а не
// исполняемая программа): "cargo run -- утилиты.код --библиотека".
// Без флага --библиотека попытка собрать этот файл сама по себе (не через
// подключение) дала бы понятную ошибку "в программе нет функции 'главная'".

функция удвоить(целое х) -> целое {
    вернуть х * 2;
}

структура Точка {
    целое х;
    целое у;

    функция сумма_координат() -> целое {
        вернуть это.х + это.у;
    }
}
