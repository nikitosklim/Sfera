// плата_cortex_m_mps2.код — «плата» для QEMU mps2 (ARM Cortex-M): вывод символов в последовательный порт UART0 (по адресу 0x40004000).
//
// Подключение:  подключить плата_cortex_m_mps2;  (вместе с  подключить голое_железо;)

функция sfera_плата_старт()
    аппаратная_запись32(0x40004010, беззнак32(16));  // делитель скорости (не ноль)
    аппаратная_запись32(0x40004008, беззнак32(1));   // передатчик включён
конец

функция sfera_вывод_символа(целое32 символ)
    // ждём, пока в передатчике освободится место (бит 0 регистра состояния)
    пока (наложить_маску(аппаратное_чтение32(0x40004004), беззнак32(1)) != беззнак32(0))
        машинная_команда("nop");
    конец
    аппаратная_запись32(0x40004000, беззнак32(символ));
конец
