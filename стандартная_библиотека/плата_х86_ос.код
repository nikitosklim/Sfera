// плата_х86_ос.код — «плата» для мини-ОС на x86: каждый выведенный символ уходит и в последовательный порт COM1, и на экран.
//
// Подключение:  подключить голое_железо;  подключить экран_х86;  подключить плата_х86_ос;

подключить железо_х86;

функция sfera_плата_старт()
    порт_вывод8(0x3F9, беззнак8(0));
    порт_вывод8(0x3FB, беззнак8(0x80));
    порт_вывод8(0x3F8, беззнак8(1));
    порт_вывод8(0x3F9, беззнак8(0));
    порт_вывод8(0x3FB, беззнак8(3));
    порт_вывод8(0x3FA, беззнак8(0xC7));
    порт_вывод8(0x3FC, беззнак8(0x0B));
    экран_настроить();
конец

функция sfera_вывод_символа(целое32 символ)
    пока (наложить_маску(порт_ввод8(0x3FD), беззнак8(0x20)) == беззнак8(0))
        машинная_команда("nop");
    конец
    порт_вывод8(0x3F8, беззнак8(символ));
    экран_байт(наложить_маску(целое(беззнак8(символ)), 255));
конец
