// пользователь_х86.код — запуск программ в пользовательском режиме (кольцо 3) на x86-64.
//
// Подключение (после  память_х86,  задачи_х86  и  диск_х86):  подключить пользователь_х86;
// Стартовый код: examples/ос/запуск_ос.s (TSS, int 0x80, возврат из программы), образ программы — examples/ос/пользователь/.
//
// Программа живёт в страницах 0x40400000…0x407FFFFF с признаком «доступно пользователю»; первый гигабайт (ядро,
// устройства) пользователю недоступен: любое обращение туда — ошибка страницы, и ядро завершает программу.
// Системные вызовы (int 0x80, номер в rax; параметры в rdi, rsi, rdx):
//   1 — писать_символ(байт)   2 — выход(код)   3 — тики()   4 — аргумент()
// Состояние (по адресу 0x300E00): +8 «программа завершена», +16 код завершения, +24 аргумент программы.

внешняя функция войти_в_пользователя(целое вход, целое вершина_стека): целое как "sfera_войти_в_пользователя";
внешняя функция образ_начало(): целое как "sfera_образ_пользователя_начало";
внешняя функция образ_размер(): целое как "sfera_образ_пользователя_размер";

// Системные вызовы (зовёт стартовый код).
функция sfera_сисвызов_ядро(целое номер, целое а, целое б, целое третий): целое
    если (номер == 1)
        sfera_вывод_символа(целое32(наложить_маску(а, 255)));
        вернуть 0;
    конец
    если (номер == 2)
        писать64(0x300E08, 1);
        писать64(0x300E10, а);
        вернуть 0;
    конец
    если (номер == 3)
        вернуть целое(аппаратное_чтение32(0x300000));
    конец
    если (номер == 4)
        вернуть читать64(0x300E18);
    конец
    вернуть 0 - 1;
конец

функция пользователь_подготовить()
    // страницы верхних уровней должны разрешать доступ пользователю (первый гигабайт остаётся закрытым)
    целое п4 = наложить_маску(регистр_cr3(), 0x000FFFFFFFFFF000);
    писать64(п4, включить_биты(читать64(п4), 4));
конец

// Стек, запуск, уборка страниц. Возвращает код завершения (-1 — программа нарушила защиту памяти).
функция пользователь_выполнить(целое страниц, целое аргумент): целое
    // стек: две страницы под самым верхом области
    отобразить(0x407FE000, выделить_кадр_обнулённый(), 7);
    отобразить(0x407FF000, выделить_кадр_обнулённый(), 7);
    писать64(0x300E08, 0);
    писать64(0x300E10, 0);
    писать64(0x300E18, аргумент);
    целое код = войти_в_пользователя(0x40400000, 0x40800000);
    // убираем страницы программы и возвращаем кадры
    целое i = 0;
    пока (i < страниц)
        освободить_кадр(снять_отображение(0x40400000 + i * 4096));
        i = i + 1;
    конец
    освободить_кадр(снять_отображение(0x407FE000));
    освободить_кадр(снять_отображение(0x407FF000));
    вернуть код;
конец

// Запускает программу, вшитую в ядро.
функция пользователь_запустить(целое аргумент): целое
    пользователь_подготовить();
    целое размер = образ_размер();
    целое откуда = образ_начало();
    целое страниц = (размер + 4095) / 4096;
    целое i = 0;
    пока (i < страниц)
        целое кадр = выделить_кадр_обнулённый();
        целое байт = 0;
        пока (байт < 4096 и i * 4096 + байт < размер)
            писать64(кадр + байт, читать64(откуда + i * 4096 + байт));
            байт = байт + 8;
        конец
        отобразить(0x40400000 + i * 4096, кадр, 7);
        i = i + 1;
    конец
    вернуть пользователь_выполнить(страниц, аргумент);
конец

// Запускает программу с диска (требуется  диск_х86): файл начинается с сектора «сектор», длина «размер» байт.
// Возвращает код завершения или -2, если диск не читается.
функция пользователь_запустить_с_диска(целое сектор, целое размер, целое аргумент): целое
    пользователь_подготовить();
    целое страниц = (размер + 4095) / 4096;
    целое i = 0;
    пока (i < страниц)
        целое кадр = выделить_кадр_обнулённый();
        целое с = 0;
        пока (с < 8 и i * 4096 + с * 512 < размер)
            если (диск_читать_сектор(сектор + i * 8 + с, кадр + с * 512) != 0)
                освободить_кадр(кадр);
                // уже отображённые страницы убираем
                целое j = 0;
                пока (j < i)
                    освободить_кадр(снять_отображение(0x40400000 + j * 4096));
                    j = j + 1;
                конец
                вернуть 0 - 2;
            конец
            с = с + 1;
        конец
        отобразить(0x40400000 + i * 4096, кадр, 7);
        i = i + 1;
    конец
    вернуть пользователь_выполнить(страниц, аргумент);
конец

функция выделить_кадр_обнулённый(): целое
    целое кадр = выделить_кадр();
    кадр_обнулить(кадр);
    вернуть кадр;
конец
