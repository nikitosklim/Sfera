// железо_х86.код — команды процессора x86 и x86-64 для программ без операционной системы.
//
// Подключение:  подключить железо_х86;
//
// Всё здесь собрано на встроенных функциях языка:
//   машинная_команда("…")              — вставляет одну команду процессора;
//   аппаратное_чтениеN / аппаратная_записьN — доступ к регистрам устройств по адресу;
//   порт_вводN / порт_выводN           — порты ввода-вывода.

функция запретить_прерывания()
    машинная_команда("cli");
конец

функция разрешить_прерывания()
    машинная_команда("sti");
конец

// Усыпляет процессор до ближайшего прерывания.
функция ждать_прерывание()
    машинная_команда("hlt");
конец

// Останавливает процессор навсегда: прерывания запрещены, процессор спит.
функция остановиться_навсегда()
    пока (да)
        машинная_команда("cli");
        машинная_команда("hlt");
    конец
конец

функция пустая_команда()
    машинная_команда("nop");
конец

// Короткая задержка после обращения к медленному устройству.
функция задержка_порта()
    порт_вывод8(0x80, беззнак8(0));
конец
