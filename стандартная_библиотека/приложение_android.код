// приложение_android.код — готовое «приложение с окном» для Android (и для компьютера).
//
// Прячет весь шаблонный код SDL: окно на весь экран, холст, шрифт, касания пальцем.
// Работает поверх графика.код. Подключается так: "подключить приложение_android;".
//
//   Приложение п = начать_приложение(24);
//   пока (п.работает)
//       целое ев = ждать_событие(п);          // 0 — событий нет, 1 — нажали, 2 — ведут палец, 3 — отпустили
//       ...
//       начать_кадр(п, 20, 24, 40);
//       написать(п, "Привет!", 40, 80, 255, 255, 255);
//       показать_кадр(п);
//   конец
//   закончить_приложение(п);
//
// Координаты — в пикселях экрана, начало (0, 0) — левый верхний угол. Шрифты font.ttf и mono.ttf
// лежат внутри шаблона приложения (assets), поэтому открываются по имени.
//
// Сборка в приложение для телефона: сфера собрать-android программа.код --имя "Моя игра"

подключить графика;

// Указатели SDL хранятся в структуре как числа: поле типа «текст» язык копирует как строку,
// и настоящий указатель терялся бы (тот же приём, что в панели Android).
внешняя функция указатель_в_число(текст р): целое64 как "llabs";
внешняя функция число_в_указатель(целое64 н): текст как "labs";

структура Приложение
    целое64 окно_;
    целое64 холст_;
    целое64 буфер_;
    целое64 шрифт_;
    целое ширина;
    целое высота;
    верно работает;
    // последнее касание
    верно нажато;
    целое х;
    целое у;
    // целое число кадров с запуска
    целое кадр;
конец

функция окно_п(Приложение п): текст
    вернуть число_в_указатель(п.окно_);
конец
функция холст_п(Приложение п): текст
    вернуть число_в_указатель(п.холст_);
конец
функция буфер_п(Приложение п): текст
    вернуть число_в_указатель(п.буфер_);
конец
функция шрифт_п(Приложение п): текст
    вернуть число_в_указатель(п.шрифт_);
конец

// Открывает окно на весь экран и загружает шрифт указанного размера (в пикселях; для телефона 28–40).
функция начать_приложение(целое размер_шрифта): Приложение
    инициализировать(беззнак32(32));
    инициализировать_шрифты();
    текст окно = создать_окно("Сфера", целое32(0), целое32(0), целое32(1080), целое32(1920), беззнак32(0));
    текст холст = создать_холст(окно, целое32(-1), беззнак32(2));
    // Если ускоренного рисования нет (редко: эмулятор, удалённый экран) — программное.
    если (указатель_в_число(холст) == целое64(0))
        холст = создать_холст(окно, целое32(-1), беззнак32(1));
    конец
    РазмерЭкрана р = размер_окна(окно);
    текст шрифт = открыть_шрифт("font.ttf", целое32(размер_шрифта));
    текст буфер = выделить_память(56);
    вернуть Приложение(указатель_в_число(окно), указатель_в_число(холст), указатель_в_число(буфер), указатель_в_число(шрифт), целое(р.ширина), целое(р.высота), да, нет, 0, 0, 0);
конец

// Берёт одно событие из очереди. Возвращает:
//   0 — событий нет;  1 — палец коснулся (х, у в п.х, п.у);  2 — палец движется;  3 — палец убран;
//   4 — окно закрывается (п.работает станет «нет»);  5 — другое событие (можно пропустить).
// Вызывать нужно в цикле, пока не вернётся 0, иначе события копятся.
функция ждать_событие(Приложение п): целое
    целое32 итог = опросить_событие(буфер_п(п));
    если (итог == целое32(0))
        вернуть 0;
    конец
    целое32 тип = прочитать_целое32(буфер_п(п), 0);
    если (тип == целое32(256))
        п.работает = нет;
        вернуть 4;
    конец
    если (тип == целое32(1025))
        п.нажато = да;
        п.х = целое(прочитать_целое32(буфер_п(п), 20));
        п.у = целое(прочитать_целое32(буфер_п(п), 24));
        вернуть 1;
    конец
    если (тип == целое32(1024) и п.нажато)
        п.х = целое(прочитать_целое32(буфер_п(п), 20));
        п.у = целое(прочитать_целое32(буфер_п(п), 24));
        вернуть 2;
    конец
    если (тип == целое32(1026))
        п.нажато = нет;
        п.х = целое(прочитать_целое32(буфер_п(п), 20));
        п.у = целое(прочитать_целое32(буфер_п(п), 24));
        вернуть 3;
    конец
    вернуть 5;
конец

// Заливает весь экран цветом (красный, зелёный, синий — от 0 до 255) — так начинается каждый кадр.
функция начать_кадр(Приложение п, целое к, целое з, целое с): целое
    задать_цвет(холст_п(п), беззнак8(к), беззнак8(з), беззнак8(с), беззнак8(255));
    очистить_холст(холст_п(п));
    вернуть 0;
конец

// Выводит нарисованное на экран и ждёт до следующего кадра (около 60 кадров в секунду).
функция показать_кадр(Приложение п): целое
    показать_холст(холст_п(п));
    подождать(беззнак32(16));
    п.кадр = п.кадр + 1;
    вернуть 0;
конец

// Закрашенный прямоугольник.
функция прямоугольник(Приложение п, целое х, целое у, целое ширина, целое высота, целое к, целое з, целое с): целое
    задать_цвет(холст_п(п), беззнак8(к), беззнак8(з), беззнак8(с), беззнак8(255));
    нарисовать_прямоугольник(холст_п(п), целое32(х), целое32(у), целое32(ширина), целое32(высота));
    вернуть 0;
конец

// Прямоугольник со скруглёнными углами (радиус — в пикселях).
функция плитка(Приложение п, целое х, целое у, целое ширина, целое высота, целое радиус, целое к, целое з, целое с): целое
    задать_цвет(холст_п(п), беззнак8(к), беззнак8(з), беззнак8(с), беззнак8(255));
    нарисовать_скруглённый_прямоугольник(холст_п(п), целое32(х), целое32(у), целое32(ширина), целое32(высота), целое32(радиус));
    вернуть 0;
конец

// Закрашенный круг с центром (х, у).
функция круг(Приложение п, целое х, целое у, целое радиус, целое к, целое з, целое с): целое
    задать_цвет(холст_п(п), беззнак8(к), беззнак8(з), беззнак8(с), беззнак8(255));
    дробное р = дробное(радиус);
    целое строка = 0 - радиус;
    пока (строка не больше радиус)
        дробное д = дробное(строка);
        дробное под = р * р - д * д;
        если (под меньше 0.0)
            под = 0.0;
        конец
        целое полуширина = целое(квадратный_корень(под));
        нарисовать_прямоугольник(холст_п(п), целое32(х - полуширина), целое32(у + строка), целое32(полуширина * 2 + 1), целое32(1));
        строка = строка + 1;
    конец
    вернуть 0;
конец

// Линия толщиной в один пиксель.
функция линия(Приложение п, целое х1, целое у1, целое х2, целое у2, целое к, целое з, целое с): целое
    задать_цвет(холст_п(п), беззнак8(к), беззнак8(з), беззнак8(с), беззнак8(255));
    нарисовать_линию(холст_п(п), целое32(х1), целое32(у1), целое32(х2), целое32(у2));
    вернуть 0;
конец

// Надпись с левым верхним углом в (х, у). Кириллица работает.
функция написать(Приложение п, текст строка, целое х, целое у, целое к, целое з, целое с): целое
    если (длина(строка) == 0)
        вернуть 0;
    конец
    беззнак32 цвет = беззнак32(к) + беззнак32(з) * беззнак32(256) + беззнак32(с) * беззнак32(65536) + беззнак32(4278190080);
    нарисовать_текст(холст_п(п), шрифт_п(п), строка, целое32(х), целое32(у), цвет);
    вернуть 0;
конец

// Попадает ли точка (х, у) в прямоугольник — для кнопок и нажатий.
функция внутри_прямоугольника(целое х, целое у, целое пх, целое пу, целое ширина, целое высота): верно
    вернуть х не меньше пх и х меньше пх + ширина и у не меньше пу и у меньше пу + высота;
конец

// Закрывает окно.
функция закончить_приложение(Приложение п): целое
    закрыть_окно(окно_п(п));
    завершить();
    вернуть 0;
конец
