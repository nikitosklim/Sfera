// хеш.код — контрольные суммы и кодирование: бах1, бах256, основание64.
//
// Подключается как `подключить хеш;` (сам подключает `память`).
//
//   бах1(текст): Список из целых          — БАХ-1 (SHA-1), 20 байт
//   бах256(текст): Список из целых        — БАХ-256 (SHA-256), 32 байта
//   бах1_текстом(текст): текст            — то же, строкой из 40 шестнадцатеричных цифр
//   бах256_текстом(текст): текст          — то же, строкой из 64 цифр
//   основание64(Список из целых): текст   — кодирование Base64
//   шестнадцатеричная_строка(Список из целых): текст — байты в виде «ba7816bf…»
//
// БАХ — «Безопасный Алгоритм Хеширования» (по-английски SHA).
// ⚠️ БАХ-1 устарел для защиты: он нужен для рукопожатия WebSocket и совместимости.
// Для паролей и подписей берите БАХ-256 (а пароли — только вместе с «солью»).

подключить память;

неизменно текст АЛФАВИТ_ОСНОВАНИЯ64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
неизменно целое ХЕШ_МАСКА32 = 4294967295;

функция хеш_вращать_влево(целое х, целое н): целое
    вернуть ((х << н) | (х >> (32 - н))) & ХЕШ_МАСКА32;
конец

// БАХ-1 от текста; возвращает 20 байт списком.
функция бах1(текст данные): Список из целых
    целое n = длина(данные);
    Список из целых байты = Список из целых();
    целое i = 0;
    пока (i меньше n)
        байты.добавить(целое(байт_текста(данные, i)));
        i = i + 1;
    конец
    байты.добавить(128);
    пока (байты.размер() % 64 != 56)
        байты.добавить(0);
    конец
    целое биты = n * 8;
    целое k = 7;
    пока (k не меньше 0)
        байты.добавить((биты >> (k * 8)) & 255);
        k = k - 1;
    конец

    целое h0 = 1732584193;
    целое h1 = 4023233417;
    целое h2 = 2562383102;
    целое h3 = 271733878;
    целое h4 = 3285377520;

    целое блок = 0;
    пока (блок меньше байты.размер())
        Список из целых w = Список из целых();
        целое t = 0;
        пока (t меньше 16)
            целое п = блок + t * 4;
            w.добавить((байты.получить(п) << 24) | (байты.получить(п + 1) << 16) | (байты.получить(п + 2) << 8) | байты.получить(п + 3));
            t = t + 1;
        конец
        пока (t меньше 80)
            w.добавить(хеш_вращать_влево(w.получить(t - 3) ^ w.получить(t - 8) ^ w.получить(t - 14) ^ w.получить(t - 16), 1));
            t = t + 1;
        конец
        целое а = h0;
        целое б = h1;
        целое с = h2;
        целое д = h3;
        целое е = h4;
        t = 0;
        пока (t меньше 80)
            целое ф = 0;
            целое к = 0;
            если (t меньше 20)
                ф = (б & с) | ((б ^ ХЕШ_МАСКА32) & д);
                к = 1518500249;
            иначе если (t меньше 40)
                ф = б ^ с ^ д;
                к = 1859775393;
            иначе если (t меньше 60)
                ф = (б & с) | (б & д) | (с & д);
                к = 2400959708;
            иначе
                ф = б ^ с ^ д;
                к = 3395469782;
            конец
            целое врем = (хеш_вращать_влево(а, 5) + ф + е + к + w.получить(t)) & ХЕШ_МАСКА32;
            е = д;
            д = с;
            с = хеш_вращать_влево(б, 30);
            б = а;
            а = врем;
            t = t + 1;
        конец
        h0 = (h0 + а) & ХЕШ_МАСКА32;
        h1 = (h1 + б) & ХЕШ_МАСКА32;
        h2 = (h2 + с) & ХЕШ_МАСКА32;
        h3 = (h3 + д) & ХЕШ_МАСКА32;
        h4 = (h4 + е) & ХЕШ_МАСКА32;
        w.освободить();
        блок = блок + 64;
    конец
    байты.освободить();

    Список из целых итог = Список из целых();
    Список из целых слова = Список из целых();
    слова.добавить(h0);
    слова.добавить(h1);
    слова.добавить(h2);
    слова.добавить(h3);
    слова.добавить(h4);
    i = 0;
    пока (i меньше 5)
        целое слово = слова.получить(i);
        итог.добавить((слово >> 24) & 255);
        итог.добавить((слово >> 16) & 255);
        итог.добавить((слово >> 8) & 255);
        итог.добавить(слово & 255);
        i = i + 1;
    конец
    слова.освободить();
    вернуть итог;
конец

// основание64 от списка байт.
функция основание64(Список из целых байты): текст
    текст итог = "";
    целое i = 0;
    целое всего = байты.размер();
    пока (i меньше всего)
        целое а = байты.получить(i);
        целое б = 0;
        целое с = 0;
        если (i + 1 меньше всего)
            б = байты.получить(i + 1);
        конец
        если (i + 2 меньше всего)
            с = байты.получить(i + 2);
        конец
        целое слово = (а << 16) | (б << 8) | с;
        итог = итог + хеш_кусок(АЛФАВИТ_ОСНОВАНИЯ64, (слово >> 18) & 63, 1) + хеш_кусок(АЛФАВИТ_ОСНОВАНИЯ64, (слово >> 12) & 63, 1);
        если (i + 1 меньше всего)
            итог = итог + хеш_кусок(АЛФАВИТ_ОСНОВАНИЯ64, (слово >> 6) & 63, 1);
        иначе
            итог = итог + "=";
        конец
        если (i + 2 меньше всего)
            итог = итог + хеш_кусок(АЛФАВИТ_ОСНОВАНИЯ64, слово & 63, 1);
        иначе
            итог = итог + "=";
        конец
        i = i + 3;
    конец
    вернуть итог;
конец

// Безопасная подстрока: при любой ошибке пустой текст.
функция хеш_кусок(текст источник, целое начало, целое сколько): текст
    результат из текста часть = подстрока(источник, начало, сколько);
    если (часть.успешно)
        вернуть часть.значение;
    конец
    вернуть "";
конец

// ---- БАХ-256

// Первые 32 бита дробных частей кубических корней первых 64 простых чисел.
неизменно текст ХЕШ_БАХ256_К = "428a2f98 71374491 b5c0fbcf e9b5dba5 3956c25b 59f111f1 923f82a4 ab1c5ed5 d807aa98 12835b01 243185be 550c7dc3 72be5d74 80deb1fe 9bdc06a7 c19bf174 e49b69c1 efbe4786 0fc19dc6 240ca1cc 2de92c6f 4a7484aa 5cb0a9dc 76f988da 983e5152 a831c66d b00327c8 bf597fc7 c6e00bf3 d5a79147 06ca6351 14292967 27b70a85 2e1b2138 4d2c6dfc 53380d13 650a7354 766a0abb 81c2c92e 92722c85 a2bfe8a1 a81a664b c24b8b70 c76c51a3 d192e819 d6990624 f40e3585 106aa070 19a4c116 1e376c08 2748774c 34b0bcb5 391c0cb3 4ed8aa4a 5b9cca4f 682e6ff3 748f82ee 78a5636f 84c87814 8cc70208 90befffa a4506ceb bef9a3f7 c67178f2";

функция хеш_цифра(текст источник, целое п): целое
    целое б = целое(байт_текста(источник, п));
    если (б не меньше 97)
        вернуть б - 87;
    конец
    вернуть б - 48;
конец

функция хеш_вращать_вправо(целое х, целое н): целое
    вернуть ((х >> н) | (х << (32 - н))) & ХЕШ_МАСКА32;
конец

// Разбирает таблицу констант в список из 64 чисел.
функция хеш_константы_бах256(): Список из целых
    Список из целых к = Список из целых();
    целое i = 0;
    пока (i меньше 64)
        целое п = i * 9;
        целое значение = 0;
        целое j = 0;
        пока (j меньше 8)
            значение = значение * 16 + хеш_цифра(ХЕШ_БАХ256_К, п + j);
            j = j + 1;
        конец
        к.добавить(значение);
        i = i + 1;
    конец
    вернуть к;
конец

// БАХ-256 от текста; возвращает 32 байта списком.
функция бах256(текст данные): Список из целых
    целое n = длина(данные);
    Список из целых байты = Список из целых();
    целое i = 0;
    пока (i меньше n)
        байты.добавить(целое(байт_текста(данные, i)));
        i = i + 1;
    конец
    байты.добавить(128);
    пока (байты.размер() % 64 != 56)
        байты.добавить(0);
    конец
    целое биты = n * 8;
    целое k = 7;
    пока (k не меньше 0)
        байты.добавить((биты >> (k * 8)) & 255);
        k = k - 1;
    конец

    Список из целых к_табл = хеш_константы_бах256();
    целое h0 = 1779033703;
    целое h1 = 3144134277;
    целое h2 = 1013904242;
    целое h3 = 2773480762;
    целое h4 = 1359893119;
    целое h5 = 2600822924;
    целое h6 = 528734635;
    целое h7 = 1541459225;

    целое блок = 0;
    пока (блок меньше байты.размер())
        Список из целых w = Список из целых();
        целое t = 0;
        пока (t меньше 16)
            целое п = блок + t * 4;
            w.добавить((байты.получить(п) << 24) | (байты.получить(п + 1) << 16) | (байты.получить(п + 2) << 8) | байты.получить(п + 3));
            t = t + 1;
        конец
        пока (t меньше 64)
            целое в15 = w.получить(t - 15);
            целое в2 = w.получить(t - 2);
            целое с0 = хеш_вращать_вправо(в15, 7) ^ хеш_вращать_вправо(в15, 18) ^ (в15 >> 3);
            целое с1 = хеш_вращать_вправо(в2, 17) ^ хеш_вращать_вправо(в2, 19) ^ (в2 >> 10);
            w.добавить((w.получить(t - 16) + с0 + w.получить(t - 7) + с1) & ХЕШ_МАСКА32);
            t = t + 1;
        конец
        целое а = h0;
        целое б = h1;
        целое с = h2;
        целое д = h3;
        целое е = h4;
        целое ф = h5;
        целое г = h6;
        целое х = h7;
        t = 0;
        пока (t меньше 64)
            целое сигма1 = хеш_вращать_вправо(е, 6) ^ хеш_вращать_вправо(е, 11) ^ хеш_вращать_вправо(е, 25);
            целое выбор = (е & ф) ^ ((е ^ ХЕШ_МАСКА32) & г);
            целое врем1 = (х + сигма1 + выбор + к_табл.получить(t) + w.получить(t)) & ХЕШ_МАСКА32;
            целое сигма0 = хеш_вращать_вправо(а, 2) ^ хеш_вращать_вправо(а, 13) ^ хеш_вращать_вправо(а, 22);
            целое большинство = (а & б) ^ (а & с) ^ (б & с);
            целое врем2 = (сигма0 + большинство) & ХЕШ_МАСКА32;
            х = г;
            г = ф;
            ф = е;
            е = (д + врем1) & ХЕШ_МАСКА32;
            д = с;
            с = б;
            б = а;
            а = (врем1 + врем2) & ХЕШ_МАСКА32;
            t = t + 1;
        конец
        h0 = (h0 + а) & ХЕШ_МАСКА32;
        h1 = (h1 + б) & ХЕШ_МАСКА32;
        h2 = (h2 + с) & ХЕШ_МАСКА32;
        h3 = (h3 + д) & ХЕШ_МАСКА32;
        h4 = (h4 + е) & ХЕШ_МАСКА32;
        h5 = (h5 + ф) & ХЕШ_МАСКА32;
        h6 = (h6 + г) & ХЕШ_МАСКА32;
        h7 = (h7 + х) & ХЕШ_МАСКА32;
        w.освободить();
        блок = блок + 64;
    конец
    байты.освободить();
    к_табл.освободить();

    Список из целых итог = Список из целых();
    Список из целых слова = Список из целых();
    слова.добавить(h0);
    слова.добавить(h1);
    слова.добавить(h2);
    слова.добавить(h3);
    слова.добавить(h4);
    слова.добавить(h5);
    слова.добавить(h6);
    слова.добавить(h7);
    i = 0;
    пока (i меньше 8)
        целое слово = слова.получить(i);
        итог.добавить((слово >> 24) & 255);
        итог.добавить((слово >> 16) & 255);
        итог.добавить((слово >> 8) & 255);
        итог.добавить(слово & 255);
        i = i + 1;
    конец
    слова.освободить();
    вернуть итог;
конец

// ---- строки

неизменно текст ХЕШ_ЦИФРЫ = "0123456789abcdef";

// Байты списком → «ba7816bf…» (строчные шестнадцатеричные цифры).
функция шестнадцатеричная_строка(Список из целых байты): текст
    текст итог = "";
    целое i = 0;
    пока (i меньше байты.размер())
        целое б = байты.получить(i);
        итог = итог + хеш_кусок(ХЕШ_ЦИФРЫ, (б >> 4) & 15, 1) + хеш_кусок(ХЕШ_ЦИФРЫ, б & 15, 1);
        i = i + 1;
    конец
    вернуть итог;
конец

функция бах1_текстом(текст данные): текст
    Список из целых х = бах1(данные);
    текст итог = шестнадцатеричная_строка(х);
    х.освободить();
    вернуть итог;
конец

функция бах256_текстом(текст данные): текст
    Список из целых х = бах256(данные);
    текст итог = шестнадцатеричная_строка(х);
    х.освободить();
    вернуть итог;
конец
