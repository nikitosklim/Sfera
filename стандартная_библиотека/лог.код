// лог.код — структурированное логирование: уровни, метка времени,
// вывод в консоль и/или дозапись в файл.
//
// Первый кирпич системы наблюдаемости языка ("логи, метрики,
// трейсинг") — метрики и трейсинг задуманы отдельными, следующими
// модулями поверх той же идеи (см. ИСТОРИЯ_РАЗРАБОТКИ.md).
//
// Формат одной строки:
//   [ГГГГ-ММ-ДД ЧЧ:ММ:СС] УРОВЕНЬ: сообщение
//
// Метка времени — СОБСТВЕННАЯ реализация, без вызова C strftime/
// localtime (тот же принцип "без внешней зависимости", что и у
// хранилище.код): по unix-времени (юникс_время() — новый компиляторный
// builtin, см. ИСТОРИЯ_РАЗРАБОТКИ.md) год/месяц/день/час/минута/
// секунда считаются напрямую, алгоритмом Говарда Хиннанта
// "civil_from_days" (http://howardhinnant.github.io/date_algorithms.html —
// тот же алгоритм, что лежит в основе <chrono> из C++20).
//
// ⚠️ Честно, узко:
// - Время всегда UTC, не местный часовой пояс — учёт часового пояса и
//   перехода на летнее/зимнее время конкретного региона отдельная,
//   более сложная задача, сознательно отложенная.
// - Поддержаны только даты ПОСЛЕ 1970-01-01 (неотрицательные unix-
//   времена) — целочисленное деление ниже рассчитано на них; для дат
//   до 1970-го понадобилась бы отдельная, симметричная ветка (никакой
//   реальной программе, которую логирует сама себя прямо сейчас, это
//   не нужно).
// - Пока НЕТ структурированных полей (ключ=значение) сверх самого
//   текста сообщения — честно оставлено на следующий шаг: сначала
//   нужна была рабочая метка времени и уровни, это уже покрывает
//   большинство практических случаев логирования.

подключить память;

структура Логгер {
    целое минимальный_уровень;
    верно в_консоль;
    текст путь_к_файлу; // "" — не писать в файл, только в консоль
}

// Уровни — обычные целые числа по возрастанию серьёзности (как и везде
// в устоявшейся практике логирования — syslog, Python logging и т.п.);
// именованные функции ниже нужны, чтобы не разбрасывать магические
// числа 0..4 по коду вызывающей программы.
функция уровень_отладка() -> целое { вернуть 0; }
функция уровень_инфо() -> целое { вернуть 1; }
функция уровень_предупреждение() -> целое { вернуть 2; }
функция уровень_ошибка() -> целое { вернуть 3; }
функция уровень_критическая() -> целое { вернуть 4; }

функция уровень_в_текст(целое уровень) -> текст {
    если (уровень <= 0) {
        вернуть "ОТЛАДКА";
    }
    если (уровень == 1) {
        вернуть "ИНФО";
    }
    если (уровень == 2) {
        вернуть "ПРЕДУПРЕЖДЕНИЕ";
    }
    если (уровень == 3) {
        вернуть "ОШИБКА";
    }
    вернуть "КРИТИЧЕСКАЯ";
}

// минимальный_уровень — сообщения строже (лог_отладка/лог_инфо/...)
// НИЖЕ этого уровня молча отбрасываются, ещё до форматирования строки
// (см. лог_записать) — то же самое разделение "что видно в проде" и
// "что видно при отладке", что и в любой взрослой системе логирования.
// путь_к_файлу == "" отключает запись в файл (логгер пишет только в
// консоль через вывести(...)).
функция создать_логгер(целое минимальный_уровень, верно в_консоль, текст путь_к_файлу) -> Логгер {
    вернуть Логгер(минимальный_уровень, в_консоль, путь_к_файлу);
}

// Дополняет число ведущим нулём до двух цифр ("5" -> "05") — без этого
// "ЧЧ:ММ:СС" для однозначных значений выглядело бы вразнобой ("9:5:3"
// вместо "09:05:03").
функция дополнить_нулём(целое число) -> текст {
    если (число < 10) {
        вернуть "0" + целое_в_текст(число);
    }
    вернуть целое_в_текст(число);
}

структура ДатаВремя {
    целое год;
    целое месяц;
    целое день;
    целое час;
    целое минута;
    целое секунда;
}

// Раскладывает unix-время (целые секунды с 1970-01-01 UTC) на
// год/месяц/день/час/минуту/секунду. См. честные ограничения и ссылку
// на алгоритм в комментарии в начале файла.
функция время_из_unix(целое юникс_секунды) -> ДатаВремя {
    целое дни = юникс_секунды / 86400;
    целое секунды_дня = юникс_секунды % 86400;

    целое час = секунды_дня / 3600;
    целое минута = (секунды_дня % 3600) / 60;
    целое секунда = секунды_дня % 60;

    // civil_from_days (Хиннант): дни, отсчитанные от 1970-01-01, в
    // год/месяц/день григорианского календаря, без обращения к
    // системным localtime/strftime.
    целое z = дни + 719468;
    целое эра = z / 146097;
    целое день_эры = z - эра * 146097;
    целое год_эры = (день_эры - день_эры / 1460 + день_эры / 36524 - день_эры / 146096) / 365;
    целое год = год_эры + эра * 400;
    целое день_года = день_эры - (365 * год_эры + год_эры / 4 - год_эры / 100);
    целое мр = (5 * день_года + 2) / 153;
    целое день = день_года - (153 * мр + 2) / 5 + 1;
    целое месяц = мр + 3;
    если (мр >= 10) {
        месяц = мр - 9;
    }
    если (месяц <= 2) {
        год = год + 1;
    }

    вернуть ДатаВремя(год, месяц, день, час, минута, секунда);
}

функция дата_время_в_текст(ДатаВремя дв) -> текст {
    вернуть целое_в_текст(дв.год) + "-" + дополнить_нулём(дв.месяц) + "-" + дополнить_нулём(дв.день)
        + " " + дополнить_нулём(дв.час) + ":" + дополнить_нулём(дв.минута) + ":" + дополнить_нулём(дв.секунда);
}

функция текущее_время_текст() -> текст {
    вернуть дата_время_в_текст(время_из_unix(юникс_время()));
}

// Общая точка записи — лог_отладка/лог_инфо/... (ниже) — просто тонкие
// обёртки с фиксированным уровнем, чтобы вызывающему коду не нужно
// было помнить магические числа.
функция лог_записать(Логгер логгер, целое уровень, текст сообщение) {
    если (уровень < логгер.минимальный_уровень) {
        вернуть;
    }

    текст строка = "[" + текущее_время_текст() + "] " + уровень_в_текст(уровень) + ": " + сообщение;

    если (логгер.в_консоль) {
        вывести(строка);
    }
    если (длина(логгер.путь_к_файлу) > 0) {
        текст строка_с_переводом = строка + "\n";
        дописать_в_файл_бинарно(логгер.путь_к_файлу, строка_с_переводом, длина(строка_с_переводом));
    }
}

функция лог_отладка(Логгер логгер, текст сообщение) {
    лог_записать(логгер, уровень_отладка(), сообщение);
}

функция лог_инфо(Логгер логгер, текст сообщение) {
    лог_записать(логгер, уровень_инфо(), сообщение);
}

функция лог_предупреждение(Логгер логгер, текст сообщение) {
    лог_записать(логгер, уровень_предупреждение(), сообщение);
}

функция лог_ошибка(Логгер логгер, текст сообщение) {
    лог_записать(логгер, уровень_ошибка(), сообщение);
}

функция лог_критическая(Логгер логгер, текст сообщение) {
    лог_записать(логгер, уровень_критическая(), сообщение);
}
