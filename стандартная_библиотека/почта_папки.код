// почта_папки.код — папки почтового ящика: список, выбор, перемещение, создание, добавление письма,
// очистка и проверка новых писем. Всё по-русски, латиница только в строках протокола.
//
// Подключается как "подключить почта_папки;" (вместе с ним подключаются почта_получение и почта_имена).
// Имена папок с русскими буквами на сервере хранятся в «изменённой UTF-7» (&BBAEQAQ…-) — модуль
// переводит их туда и обратно сам: наружу выходят обычные русские названия.

подключить почта_получение;
подключить почта_имена;

структура Папка
    текст имя;           // как папка называется на сервере (кодировка протокола)
    текст разделитель;   // знак между уровнями вложенности
    текст показ;         // как показывать человеку: «Входящие», «Корзина», «Работа»
    целое вид;           // 0 обычная, 1 входящие, 2 отправленные, 3 корзина, 4 черновики, 5 спам
конец

// ---------------------------------------------------------------- имена папок

функция папка_заменить_знак(текст т, целое код, текст на_что): текст
    текст итог = "";
    целое п = 0;
    пока (п < длина(т))
        если (целое(байт_текста(т, п)) == код)
            итог = итог + на_что;
        иначе
            итог = итог + часть(т, п, 1);
        конец
        п = п + 1;
    конец
    вернуть итог;
конец

// «Работа» -> «&BCIEQAQwBDEEPgRCBDA-»
функция папка_закодировать(текст имя): текст
    Список из целых точки = Список из целых();
    пуни_кодовые_точки(имя, точки);
    текст итог = "";
    целое ин = 0;
    пока (ин < точки.размер())
        целое ц = точки.получить(ин);
        если (ц >= 32 и ц <= 126)
            если (ц == 38)
                итог = итог + "&-";
            иначе
                итог = итог + пуни_символ(ц);
            конец
            ин = ин + 1;
        иначе
            целое до = ин;
            пока (до < точки.размер() и (точки.получить(до) < 32 или точки.получить(до) > 126))
                до = до + 1;
            конец
            текст буфер = выделить_память((до - ин) * 4 + 8);
            целое n = 0;
            целое й = ин;
            пока (й < до)
                целое ц2 = точки.получить(й);
                если (ц2 >= 65536)
                    целое сдвинутое = ц2 - 65536;
                    целое верх = 55296 + сдвинутое / 1024;
                    целое низ = 56320 + сдвинутое % 1024;
                    записать_байт(буфер, n, верх / 256);
                    записать_байт(буфер, n + 1, верх % 256);
                    записать_байт(буфер, n + 2, низ / 256);
                    записать_байт(буфер, n + 3, низ % 256);
                    n = n + 4;
                иначе
                    записать_байт(буфер, n, ц2 / 256);
                    записать_байт(буфер, n + 1, ц2 % 256);
                    n = n + 2;
                конец
                й = й + 1;
            конец
            текст основание = кодировать_б64_байты(адрес_текста(буфер), n, 100000);
            освободить_память(буфер);
            основание = папка_заменить_знак(основание, 61, "");
            основание = папка_заменить_знак(основание, 47, ",");
            основание = папка_заменить_знак(основание, 10, "");
            основание = папка_заменить_знак(основание, 13, "");
            итог = итог + "&" + основание + "-";
            ин = до;
        конец
    конец
    вернуть итог;
конец

// «&BCIEQAQwBDEEPgRCBDA-» -> «Работа»
функция папка_раскодировать(текст имя): текст
    текст итог = "";
    целое п = 0;
    пока (п < длина(имя))
        целое б = целое(байт_текста(имя, п));
        если (б == 38)
            целое до = найти_от(имя, "-", п + 1);
            если (до < 0)
                вернуть итог + часть(имя, п, длина(имя));
            конец
            текст кусок = часть(имя, п + 1, до - п - 1);
            если (длина(кусок) == 0)
                итог = итог + "&";
            иначе
                кусок = папка_заменить_знак(кусок, 44, "/");
                пока (длина(кусок) % 4 != 0)
                    кусок = кусок + "=";
                конец
                Данные д = декодировать_б64(кусок);
                текст буф = выделить_память(д.размер * 2 + 16);
                целое выход = 0;
                целое k = 0;
                пока (k + 1 < д.размер)
                    целое ед = целое(байт_текста(указатель_по_адресу(д.адрес + k), 0)) * 256 + целое(байт_текста(указатель_по_адресу(д.адрес + k + 1), 0));
                    k = k + 2;
                    если (ед >= 55296 и ед < 56320 и k + 1 < д.размер)
                        целое ед2 = целое(байт_текста(указатель_по_адресу(д.адрес + k), 0)) * 256 + целое(байт_текста(указатель_по_адресу(д.адрес + k + 1), 0));
                        k = k + 2;
                        целое ц = 65536 + (ед - 55296) * 1024 + (ед2 - 56320);
                        записать_байт(буф, выход, 240 + ц / 262144);
                        записать_байт(буф, выход + 1, 128 + ц / 4096 % 64);
                        записать_байт(буф, выход + 2, 128 + ц / 64 % 64);
                        записать_байт(буф, выход + 3, 128 + ц % 64);
                        выход = выход + 4;
                    иначе
                        выход = писать_знак(буф, выход, ед);
                    конец
                конец
                итог = итог + текст_из_буфера(буф, выход);
                освободить_данные(д);
            конец
            п = до + 1;
        иначе
            итог = итог + часть(имя, п, 1);
            п = п + 1;
        конец
    конец
    вернуть итог;
конец

// ---------------------------------------------------------------- список папок

функция папка_название_по_виду(целое вид, текст запасное): текст
    если (вид == 1)
        вернуть "Входящие";
    конец
    если (вид == 2)
        вернуть "Отправленные";
    конец
    если (вид == 3)
        вернуть "Корзина";
    конец
    если (вид == 4)
        вернуть "Черновики";
    конец
    если (вид == 5)
        вернуть "Спам";
    конец
    вернуть запасное;
конец

// Разбирает строку «* LIST (\HasNoChildren \Sent) "." "Sent"». Если папку выбрать нельзя — имя пустое.
функция папка_разобрать(текст строка): Папка
    Папка п = Папка("", "", "", 0);
    целое от = найти_от(строка, "(", 0);
    целое до = найти_от(строка, ")", 0);
    если (от < 0 или до < от)
        вернуть п;
    конец
    текст признаки = регистр_в_нижний(часть(строка, от + 1, до - от - 1));
    если (найти_от(признаки, "\\noselect", 0) >= 0 или найти_от(признаки, "\\nonexistent", 0) >= 0)
        вернуть п;
    конец
    целое т = до + 1;
    пока (т < длина(строка) и целое(байт_текста(строка, т)) == 32)
        т = т + 1;
    конец
    // разделитель
    если (т < длина(строка) и целое(байт_текста(строка, т)) == 34)
        целое з = найти_от(строка, "\"", т + 1);
        если (з < 0)
            вернуть п;
        конец
        п.разделитель = часть(строка, т + 1, з - т - 1);
        т = з + 1;
    иначе
        пока (т < длина(строка) и целое(байт_текста(строка, т)) != 32)
            т = т + 1;
        конец
    конец
    пока (т < длина(строка) и целое(байт_текста(строка, т)) == 32)
        т = т + 1;
    конец
    // имя: в кавычках или просто слово
    текст имя = "";
    если (т < длина(строка) и целое(байт_текста(строка, т)) == 34)
        т = т + 1;
        пока (т < длина(строка) и целое(байт_текста(строка, т)) != 34)
            если (целое(байт_текста(строка, т)) == 92 и т + 1 < длина(строка))
                т = т + 1;
            конец
            имя = имя + часть(строка, т, 1);
            т = т + 1;
        конец
    иначе
        имя = часть(строка, т, длина(строка) - т);
    конец
    п.имя = имя;
    если (регистр_в_нижний(имя) == "inbox")
        п.вид = 1;
    конец
    если (найти_от(признаки, "\\sent", 0) >= 0)
        п.вид = 2;
    иначе если (найти_от(признаки, "\\trash", 0) >= 0)
        п.вид = 3;
    иначе если (найти_от(признаки, "\\drafts", 0) >= 0)
        п.вид = 4;
    иначе если (найти_от(признаки, "\\junk", 0) >= 0)
        п.вид = 5;
    конец
    // запасной путь для серверов без «особых» признаков: по названию
    если (п.вид == 0)
        текст н = регистр_в_нижний(имя);
        если (н == "sent" или н == "sent messages" или н == "sent items")
            п.вид = 2;
        иначе если (н == "trash" или н == "deleted items" или н == "deleted messages")
            п.вид = 3;
        иначе если (н == "drafts")
            п.вид = 4;
        иначе если (н == "junk" или н == "spam")
            п.вид = 5;
        конец
    конец
    п.показ = папка_название_по_виду(п.вид, папка_раскодировать(имя));
    вернуть п;
конец

// Все папки ящика. Входящие всегда первыми, дальше по порядку: отправленные, черновики, спам, корзина, остальные.
функция ящик_папки(Ящик я): Список из Папка
    Список из Папка найденные = Список из Папка();
    Ответ о = ящик_команда(я, "LIST \"\" \"*\"");
    если ( не о.успешно)
        я.сбой = "не удалось получить список папок: " + о.сообщение;
        вернуть найденные;
    конец
    для каждого строка в о.строки
        если (начинается_с(строка, "* LIST "))
            Папка п = папка_разобрать(строка);
            если (длина(п.имя) > 0)
                найденные.добавить(п);
            конец
        конец
    конец
    Список из Папка итог = Список из Папка();
    Список из целых порядок = Список из целых();
    порядок.добавить(1);
    порядок.добавить(2);
    порядок.добавить(4);
    порядок.добавить(5);
    порядок.добавить(3);
    порядок.добавить(0);
    целое ш = 0;
    пока (ш < порядок.размер())
        для каждого п2 в найденные
            если (п2.вид == порядок.получить(ш))
                итог.добавить(п2);
            конец
        конец
        ш = ш + 1;
    конец
    вернуть итог;
конец

// ---------------------------------------------------------------- работа с папкой

// Выбирает папку (по имени на сервере) и узнаёт, сколько в ней писем.
функция ящик_выбрать(Ящик я, текст имя_на_сервере): верно
    Ответ о = ящик_команда(я, "SELECT " + в_кавычки(имя_на_сервере));
    если ( не о.успешно)
        я.сбой = "не удалось открыть папку: " + о.сообщение;
        вернуть нет;
    конец
    я.писем = 0;
    для каждого с в о.строки
        если (начинается_с(с, "* ") и найти_от(с, " EXISTS", 0) > 0)
            я.писем = число_после(с, "* ");
        конец
    конец
    вернуть да;
конец

// Переносит письмо (по коду) из выбранной папки в другую.
функция ящик_переместить(Ящик я, целое код, текст куда): верно
    Ответ о = ящик_команда(я, "UID MOVE " + целое_в_текст(код) + " " + в_кавычки(куда));
    если (о.успешно)
        вернуть да;
    конец
    Ответ копия = ящик_команда(я, "UID COPY " + целое_в_текст(код) + " " + в_кавычки(куда));
    если ( не копия.успешно)
        я.сбой = "не удалось перенести письмо: " + копия.сообщение;
        вернуть нет;
    конец
    ящик_удалить(я, код);
    вернуть да;
конец

// Создаёт папку и подписывается на неё, чтобы другие программы тоже её видели.
функция ящик_создать_папку(Ящик я, текст имя): верно
    текст на_сервере = папка_закодировать(имя);
    Ответ о = ящик_команда(я, "CREATE " + в_кавычки(на_сервере));
    если ( не о.успешно)
        я.сбой = "не удалось создать папку: " + о.сообщение;
        вернуть нет;
    конец
    ящик_команда(я, "SUBSCRIBE " + в_кавычки(на_сервере));
    вернуть да;
конец

// Кладёт готовое письмо (текст целиком, с заголовками) в папку, помеченным прочитанным.
функция ящик_добавить(Ящик я, текст папка, текст письмо): верно
    я.счётчик = я.счётчик + 1;
    текст метка = "a" + целое_в_текст(я.счётчик);
    если (защита_отправить(я.дескриптор, метка + " APPEND " + в_кавычки(папка) + " (\\Seen) {" + целое_в_текст(длина(письмо)) + "}\r\n") < 1)
        я.сбой = "не удалось отправить команду";
        вернуть нет;
    конец
    текст ответ = защита_прочитать_строку(я.дескриптор);
    если (начинается_с(ответ, метка + " "))
        я.сбой = "сервер не принял письмо: " + ответ;
        вернуть нет;
    конец
    если ( не начинается_с(ответ, "+"))
        я.сбой = "сервер не ответил на добавление письма";
        вернуть нет;
    конец
    защита_отправить(я.дескриптор, письмо + "\r\n");
    пока (да)
        текст строка = защита_прочитать_строку(я.дескриптор);
        если (длина(строка) == 0)
            я.сбой = "соединение прервано";
            вернуть нет;
        конец
        если (начинается_с(строка, метка + " "))
            если (начинается_с(строка, метка + " OK"))
                вернуть да;
            конец
            я.сбой = "не удалось сохранить письмо: " + строка;
            вернуть нет;
        конец
    конец
    вернуть нет;
конец

// Удаляет все письма выбранной папки без возврата (для «Очистить корзину»).
функция ящик_очистить_папку(Ящик я): верно
    если (я.писем < 1)
        вернуть да;
    конец
    Ответ о = ящик_команда(я, "STORE 1:* +FLAGS (\\Deleted)");
    если ( не о.успешно)
        я.сбой = "не удалось очистить папку: " + о.сообщение;
        вернуть нет;
    конец
    ящик_команда(я, "EXPUNGE");
    я.писем = 0;
    вернуть да;
конец

// Спрашивает сервер, не появилось ли новое. 1 — в папке что-то изменилось, 0 — нет, -1 — связи нет.
функция ящик_проверка(Ящик я): целое
    Ответ о = ящик_команда(я, "NOOP");
    если ( не о.успешно)
        я.сбой = "нет связи: " + о.сообщение;
        вернуть -1;
    конец
    целое итог = 0;
    для каждого с в о.строки
        если (начинается_с(с, "* ") и найти_от(с, " EXISTS", 0) > 0)
            если (число_после(с, "* ") != я.писем)
                итог = 1;
            конец
        конец
        если (начинается_с(с, "* ") и найти_от(с, " EXPUNGE", 0) > 0)
            итог = 1;
        конец
    конец
    вернуть итог;
конец

// Сколько в папке всего писем и сколько непрочитанных, не открывая её. Пара «всего, новых»; при сбое -1.
функция ящик_статус(Ящик я, текст имя_на_сервере): Список из целых
    Список из целых итог = Список из целых();
    Ответ о = ящик_команда(я, "STATUS " + в_кавычки(имя_на_сервере) + " (MESSAGES UNSEEN)");
    если ( не о.успешно)
        итог.добавить(-1);
        итог.добавить(-1);
        вернуть итог;
    конец
    целое всего = 0;
    целое новых = 0;
    для каждого с в о.строки
        если (начинается_с(с, "* STATUS "))
            всего = число_после(с, "MESSAGES ");
            новых = число_после(с, "UNSEEN ");
        конец
    конец
    итог.добавить(всего);
    итог.добавить(новых);
    вернуть итог;
конец
