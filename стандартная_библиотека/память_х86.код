// память_х86.код — менеджер физической и виртуальной памяти для x86-64.
//
// Подключение (после  подключить голое_железо;):  подключить память_х86;
// Стартовый код должен дать: sfera_инфо_загрузчика, sfera_cr3, sfera_сбросить_страницу (см. examples/ос/запуск_ос.s).
//
// Физическая память делится на кадры по 4 КБ. Учёт — битовая карта по адресу 0x500000 (1 бит на кадр:
// 1 — занят). Всё ниже 6 МБ занято ядром и его данными; управляется память от 6 МБ до конца ОЗУ (не больше 1 ГБ).
//
// Виртуальная память: первый гигабайт отображён «как есть» (страницы по 2 МБ). Область 1–2 ГБ
// (0x40000000…0x7FFFFFFF) свободна: страницы по 4 КБ создаются функцией отобразить(), а область
// 0x40000000…0x4FFFFFFF ещё и подкачивается по требованию — при первом обращении ошибка страницы
// обрабатывается выделением кадра.
//
// Состояние менеджера (по адресу 0x300A00): +0 всего кадров, +8 свободно кадров,
// +16 с какого байта карты искать свободное, +24 обработано ошибок страниц, +32 конец памяти (адрес)

// инфо_загрузчика() объявлена в экран_х86 (подключите её раньше).
внешняя функция регистр_cr3(): целое как "sfera_cr3";
внешняя функция сбросить_страницу(целое адрес) как "sfera_сбросить_страницу";

функция память_состояние(целое поле): целое
    вернуть читать64(0x300A00 + поле);
конец

функция память_задать(целое поле, целое значение)
    писать64(0x300A00 + поле, значение);
конец

функция вывести_шестн(целое число)
    sfera_вывод_символа(целое32(48));
    sfera_вывод_символа(целое32(120));
    целое сдвиг = 60;
    целое начато = 0;
    пока (сдвиг >= 0)
        целое цифра = наложить_маску(сдвинуть_вправо(число, сдвиг), 15);
        если (цифра != 0 или начато == 1 или сдвиг == 0)
            начато = 1;
            если (цифра < 10)
                sfera_вывод_символа(целое32(48 + цифра));
            иначе
                sfera_вывод_символа(целое32(87 + цифра));
            конец
        конец
        сдвиг = сдвиг - 4;
    конец
конец

// Остановка ядра с сообщением. Сюда приходят при неисправимой ошибке.
функция паника(текст сообщение)
    запретить_прерывания();
    вывести("");
    вывести("ПАНИКА: " + сообщение);
    пока (да)
        машинная_команда("hlt");
    конец
конец

// ---------- физические кадры ----------

функция кадр_занят(целое номер): целое
    целое байт = целое(аппаратное_чтение8(0x500000 + номер / 8));
    вернуть наложить_маску(сдвинуть_вправо(байт, номер % 8), 1);
конец

функция кадр_пометить(целое номер, целое занят)
    целое адрес = 0x500000 + номер / 8;
    целое маска = сдвинуть_влево(1, номер % 8);
    целое байт = целое(аппаратное_чтение8(адрес));
    если (занят == 1)
        аппаратная_запись8(адрес, беззнак8(включить_биты(байт, маска)));
    иначе
        аппаратная_запись8(адрес, беззнак8(наложить_маску(байт, 255 - маска)));
    конец
конец

// Подготавливает менеджер: узнаёт объём ОЗУ у загрузчика (Multiboot) и строит карту кадров.
функция память_подготовить()
    целое сведения = инфо_загрузчика();
    целое верхняя = целое(аппаратное_чтение32(сведения + 8));      // КБ выше первого мегабайта
    целое конец_памяти = 0x100000 + верхняя * 1024;
    конец_памяти = (конец_памяти + 524288) / 1048576 * 1048576;
    если (конец_памяти > 0x40000000)
        конец_памяти = 0x40000000;
    конец
    целое всего = конец_памяти / 4096;
    целое номер = 0;
    целое свободно = 0;
    пока (номер < всего)
        если (номер < 1536)
            кадр_пометить(номер, 1);
        иначе
            кадр_пометить(номер, 0);
            свободно = свободно + 1;
        конец
        номер = номер + 1;
    конец
    память_задать(0, всего);
    память_задать(8, свободно);
    память_задать(16, 192);
    память_задать(24, 0);
    память_задать(32, конец_памяти);
конец

// Выделяет один кадр. Возвращает его физический адрес или 0, если память кончилась.
функция выделить_кадр(): целое
    целое всего = память_состояние(0);
    целое байтов = (всего + 7) / 8;
    целое байт = память_состояние(16);
    целое просмотрено = 0;
    пока (просмотрено < байтов)
        если (байт >= байтов)
            байт = 0;
        конец
        если (целое(аппаратное_чтение8(0x500000 + байт)) != 255)
            целое бит = 0;
            пока (бит < 8)
                целое номер = байт * 8 + бит;
                если (номер < всего и кадр_занят(номер) == 0)
                    кадр_пометить(номер, 1);
                    память_задать(8, память_состояние(8) - 1);
                    память_задать(16, байт);
                    вернуть номер * 4096;
                конец
                бит = бит + 1;
            конец
        конец
        байт = байт + 1;
        просмотрено = просмотрено + 1;
    конец
    вернуть 0;
конец

функция освободить_кадр(целое адрес)
    кадр_пометить(адрес / 4096, 0);
    память_задать(8, память_состояние(8) + 1);
конец

// Обнуляет кадр.
функция кадр_обнулить(целое адрес)
    целое смещение = 0;
    пока (смещение < 4096)
        писать64(адрес + смещение, 0);
        смещение = смещение + 8;
    конец
конец

// ---------- страничные таблицы ----------

// Следующая таблица по записи: если её нет, создаёт (кадр берётся из менеджера).
функция таблица_ниже(целое таблица, целое номер): целое
    целое запись = читать64(таблица + номер * 8);
    если (наложить_маску(запись, 1) == 0)
        целое кадр = выделить_кадр();
        если (кадр == 0)
            паника("нет памяти для таблицы страниц");
        конец
        кадр_обнулить(кадр);
        писать64(таблица + номер * 8, включить_биты(кадр, 7));   // 7: есть, запись, доступно пользователю (доступ решает нижний уровень)
        вернуть кадр;
    конец
    вернуть наложить_маску(запись, 0x000FFFFFFFFFF000);
конец

// Отображает виртуальную страницу на кадр. Флаги: 1 — есть, 2 — запись (обычно 3).
функция отобразить(целое виртуальный, целое физический, целое флаги)
    если (виртуальный < 0x40000000)
        паника("нельзя менять отображение первого гигабайта");
    конец
    целое п4 = наложить_маску(регистр_cr3(), 0x000FFFFFFFFFF000);
    целое п3 = таблица_ниже(п4, наложить_маску(сдвинуть_вправо(виртуальный, 39), 511));
    целое п2 = таблица_ниже(п3, наложить_маску(сдвинуть_вправо(виртуальный, 30), 511));
    целое п1 = таблица_ниже(п2, наложить_маску(сдвинуть_вправо(виртуальный, 21), 511));
    писать64(п1 + наложить_маску(сдвинуть_вправо(виртуальный, 12), 511) * 8, включить_биты(физический, флаги));
    сбросить_страницу(виртуальный);
конец

// Убирает отображение страницы. Возвращает физический адрес кадра (0, если страница не была отображена).
функция снять_отображение(целое виртуальный): целое
    целое п4 = наложить_маску(регистр_cr3(), 0x000FFFFFFFFFF000);
    целое запись = читать64(п4 + наложить_маску(сдвинуть_вправо(виртуальный, 39), 511) * 8);
    если (наложить_маску(запись, 1) == 0)
        вернуть 0;
    конец
    запись = читать64(наложить_маску(запись, 0x000FFFFFFFFFF000) + наложить_маску(сдвинуть_вправо(виртуальный, 30), 511) * 8);
    если (наложить_маску(запись, 1) == 0)
        вернуть 0;
    конец
    запись = читать64(наложить_маску(запись, 0x000FFFFFFFFFF000) + наложить_маску(сдвинуть_вправо(виртуальный, 21), 511) * 8);
    если (наложить_маску(запись, 1) == 0)
        вернуть 0;
    конец
    целое адрес_записи = наложить_маску(запись, 0x000FFFFFFFFFF000) + наложить_маску(сдвинуть_вправо(виртуальный, 12), 511) * 8;
    запись = читать64(адрес_записи);
    если (наложить_маску(запись, 1) == 0)
        вернуть 0;
    конец
    писать64(адрес_записи, 0);
    сбросить_страницу(виртуальный);
    вернуть наложить_маску(запись, 0x000FFFFFFFFFF000);
конец

// Ошибка страницы (её вызывает стартовый код). В области 0x40000000…0x4FFFFFFF страница
// создаётся по требованию, любое другое обращение — паника.
функция sfera_pf(целое код_ошибки, целое адрес)
    // ошибка в программе пользователя (бит 2 кода ошибки): завершаем программу, ядро живёт дальше
    если (наложить_маску(код_ошибки, 4) != 0)
        вывести_текст("программа нарушила защиту памяти: адрес ");
        вывести_шестн(адрес);
        вывести("");
        писать64(0x300E08, 1);
        писать64(0x300E10, 0 - 1);
        вернуть;
    конец
    если (адрес >= 0x40000000 и адрес < 0x50000000 и наложить_маску(код_ошибки, 1) == 0)
        целое кадр = выделить_кадр();
        если (кадр == 0)
            паника("нет свободной памяти");
        конец
        кадр_обнулить(кадр);
        отобразить(наложить_маску(адрес, 0x7FFFFFFFFFFFF000), кадр, 3);
        память_задать(24, память_состояние(24) + 1);
        вернуть;
    конец
    запретить_прерывания();
    вывести("");
    вывести_текст("ПАНИКА: ошибка страницы по адресу ");
    вывести_шестн(адрес);
    вывести("");
    пока (да)
        машинная_команда("hlt");
    конец
конец
