// игра.код — простая игровая библиотека для браузера (холст, клавиши, мышь, звук, рекорды).
//
// Программа собирается в WebAssembly (--целевая-платформа wasm32-wasi --wasm-хост) и работает
// на странице с загрузчиком static/игра-хост.js. Такую страницу можно загрузить на itch.io как веб-игру.
//
// Пример:
//   подключить игра;
//   целое х = 10;
//   функция кадр()
//       очистить(0, 0, 40);
//       цвет(255, 200, 0);
//       круг(х, 100, 20);
//       х = х + 2;
//   конец
//   функция главная()
//       холст(640, 360);
//       запустить_игру("кадр");
//   конец

внешняя функция и_холст(целое32 ширина, целое32 высота): целое32 как "и_холст";
внешняя функция и_цвет(целое32 к, целое32 з, целое32 с): целое32 как "и_цвет";
внешняя функция и_очистить(целое32 к, целое32 з, целое32 с): целое32 как "и_очистить";
внешняя функция и_прямоугольник(целое32 х, целое32 у, целое32 ш, целое32 выс): целое32 как "и_прямоугольник";
внешняя функция и_круг(целое32 х, целое32 у, целое32 р): целое32 как "и_круг";
внешняя функция и_линия(целое32 х1, целое32 у1, целое32 х2, целое32 у2, целое32 толщина): целое32 как "и_линия";
внешняя функция и_надпись(текст что, целое32 х, целое32 у, целое32 размер): целое32 как "и_надпись";
внешняя функция и_клавиша(текст имя): целое32 как "и_клавиша";
внешняя функция и_клавиша_нажата(текст имя): целое32 как "и_клавиша_нажата";
внешняя функция и_мышь_х(): целое32 как "и_мышь_х";
внешняя функция и_мышь_у(): целое32 как "и_мышь_у";
внешняя функция и_мышь_кнопка(): целое32 как "и_мышь_кнопка";
внешняя функция и_мышь_нажата(): целое32 как "и_мышь_нажата";
внешняя функция и_запустить(текст обработчик): целое32 как "и_запустить";
внешняя функция и_случайное(целое32 до): целое32 как "и_случайное";
внешняя функция и_звук(целое32 частота, целое32 мс): целое32 как "и_звук";
внешняя функция и_сохранить(текст имя, целое32 значение): целое32 как "и_сохранить";
внешняя функция и_взять(текст имя): целое32 как "и_взять";
внешняя функция и_время(): целое32 как "и_время";
внешняя функция и_сокет_открыть(текст адрес): целое32 как "и_сокет_открыть";
внешняя функция и_сокет_состояние(): целое32 как "и_сокет_состояние";
внешняя функция и_сокет_отправить(текст сообщение): целое32 как "и_сокет_отправить";
внешняя функция и_сокет_есть(): целое32 как "и_сокет_есть";
внешняя функция и_сокет_взять(): текст как "и_сокет_взять";
внешняя функция и_сокет_закрыть(): целое32 как "и_сокет_закрыть";

// ---- окно и рисование

// Задаёт размер игрового поля в пикселях. Вызывается один раз в начале.
функция холст(целое ширина, целое высота)
    и_холст(целое32(ширина), целое32(высота));
конец

// Цвет для следующих фигур и надписей: красный, зелёный, синий от 0 до 255.
функция цвет(целое красный, целое зелёный, целое синий)
    и_цвет(целое32(красный), целое32(зелёный), целое32(синий));
конец

// Закрашивает всё поле одним цветом. Обычно вызывается первой в каждом кадре.
функция очистить(целое красный, целое зелёный, целое синий)
    и_очистить(целое32(красный), целое32(зелёный), целое32(синий));
конец

функция прямоугольник(целое х, целое у, целое ширина, целое высота)
    и_прямоугольник(целое32(х), целое32(у), целое32(ширина), целое32(высота));
конец

// Круг с центром (х, у) и радиусом р.
функция круг(целое х, целое у, целое р)
    и_круг(целое32(х), целое32(у), целое32(р));
конец

функция линия(целое х1, целое у1, целое х2, целое у2, целое толщина)
    и_линия(целое32(х1), целое32(у1), целое32(х2), целое32(у2), целое32(толщина));
конец

// Текст с левым верхним углом в (х, у); размер — высота букв в пикселях.
функция надпись(текст что, целое х, целое у, целое размер)
    и_надпись(что, целое32(х), целое32(у), целое32(размер));
конец

// ---- ввод

// Зажата ли клавиша сейчас. Имена: "влево", "вправо", "вверх", "вниз", "пробел", "ввод",
// "escape", а также буквы и цифры: "a", "w", "1" (латинские клавиши, как на клавиатуре).
функция клавиша(текст имя): верно
    вернуть целое(и_клавиша(имя)) != 0;
конец

// Была ли клавиша нажата с прошлого кадра (срабатывает один раз на нажатие).
функция клавиша_нажата(текст имя): верно
    вернуть целое(и_клавиша_нажата(имя)) != 0;
конец

функция мышь_х(): целое
    вернуть целое(и_мышь_х());
конец

функция мышь_у(): целое
    вернуть целое(и_мышь_у());
конец

// Зажата ли левая кнопка мыши (или касание пальцем).
функция мышь_зажата(): верно
    вернуть целое(и_мышь_кнопка()) != 0;
конец

// Был ли клик с прошлого кадра.
функция мышь_нажата(): верно
    вернуть целое(и_мышь_нажата()) != 0;
конец

// ---- ход игры

// Начинает игру: браузер будет вызывать вашу функцию примерно 60 раз в секунду.
// Функция не должна принимать параметров и ничего не возвращает.
функция запустить_игру(текст имя_функции_кадра)
    и_запустить(имя_функции_кадра);
конец

// Случайное число от 0 до (до - 1).
функция случайное(целое до): целое
    вернуть целое(и_случайное(целое32(до)));
конец

// Прошедшее время в миллисекундах с начала игры (хватает на 24 дня).
функция время_мс(): целое
    вернуть целое(и_время());
конец

// Короткий звук: частота в герцах (например, 440) и длительность в миллисекундах.
функция звук(целое частота, целое мс)
    и_звук(целое32(частота), целое32(мс));
конец

// Сохранение числа в браузере (например, рекорда) и чтение. Нет значения — вернёт 0.
функция сохранить(текст имя, целое значение)
    и_сохранить(имя, целое32(значение));
конец

функция взять_сохранённое(текст имя): целое
    вернуть целое(и_взять(имя));
конец

// ---- сеть: связь игры с сервером на Сфере (WebSocket)

// Начинает подключение к серверу, например соединиться("ws://localhost:9001").
// Подключение идёт в фоне: проверяйте соединено() в каждом кадре.
функция соединиться(текст адрес)
    и_сокет_открыть(адрес);
конец

// Открыто ли соединение с сервером и можно ли отправлять сообщения.
функция соединено(): верно
    вернуть целое(и_сокет_состояние()) == 2;
конец

// Закрыто ли соединение (сервер выключился или адрес неверный).
функция соединение_закрыто(): верно
    вернуть целое(и_сокет_состояние()) == 3;
конец

// Отправляет серверу текстовое сообщение. Если соединения нет, ничего не делает.
функция отправить_серверу(текст сообщение)
    и_сокет_отправить(сообщение);
конец

// Пришло ли от сервера ещё не прочитанное сообщение.
функция есть_сообщение(): верно
    вернуть целое(и_сокет_есть()) > 0;
конец

// Берёт следующее сообщение от сервера (по порядку получения). Нет сообщений — пустой текст.
функция прочитать_сообщение(): текст
    текст т = "" + и_сокет_взять();
    вернуть т;
конец

функция разорвать_соединение()
    и_сокет_закрыть();
конец
