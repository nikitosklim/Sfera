// метрики.код — второй кирпич системы наблюдаемости языка (после
// стандартная_библиотека/лог.код) — счётчики и измерители, экспорт в
// текстовом формате, который умеет читать Prometheus (тот же формат,
// который отдаёт любой "/metrics" эндпоинт в реальной инфраструктуре) —
// см. ИСТОРИЯ_РАЗРАБОТКИ.md для того, почему выбран именно он, а не
// собственный формат.
//
// Два вида метрик — та же модель, что и в Prometheus/StatsD/большинстве
// промышленных систем:
//   - СЧЁТЧИК (counter) — только растёт (запросы обработано, ошибок
//     случилось). Сбрасывается в ноль только перезапуском программы.
//   - ИЗМЕРИТЕЛЬ (gauge) — текущее значение, может расти и падать
//     (открытых соединений сейчас, занято памяти, температура датчика).
//
// ⚠️ Честно, узко (v1): нет ГИСТОГРАММ (распределение величины —
// например, "сколько запросов уложилось в 10мс, сколько в 100мс, сколько
// дольше" — нужно для процентилей задержки) — задумано отдельным,
// следующим шагом, гистограмма это по сути несколько счётчиков-бакетов
// сразу и его проще делать, когда счётчики уже обкатаны. Нет "меток"
// (labels — Prometheus умеет "запросы{путь=\"/логин\", код=\"200\"}",
// здесь только плоское имя метрики).
//
// ⚠️ Словарь<Ключ, Значение> в этом языке НЕ поддерживает перечисление ключей
// (нет .ключи() или "для каждого" по словарю — см. ДОКУМЕНТАЦИЯ_ЯЗЫКА.md)
// — поэтому регистр хранит имена ДВАЖДЫ: в Словаре (быстрый доступ по
// имени при каждом увеличении/установке) и параллельно в Списке (порядок
// регистрации — нужен только для перебора при экспорте снимка). Не самое
// изящное решение, но простое и рабочее, пока в языке не появится
// перечисление словаря как отдельная возможность.

подключить память;

структура Метрики {
    Словарь<текст, целое> счётчики;
    Список<текст> имена_счётчиков;
    Словарь<текст, дробное> измерители;
    Список<текст> имена_измерителей;
}

функция создать_метрики() -> Метрики {
    вернуть Метрики(
        Словарь<текст, целое>(),
        Список<текст>(),
        Словарь<текст, дробное>(),
        Список<текст>()
    );
}

// Увеличивает счётчик "имя" на "на" (обычно 1) — заводит его с нуля при
// первом обращении, дальше просто прибавляет. Счётчик НЕ может убывать —
// если нужно значение, которое иногда падает (открытые соединения,
// занятая память) — это измеритель_установить/измеритель_увеличить ниже,
// не счётчик.
функция счётчик_увеличить(Метрики м, текст имя, целое на) {
    результат<целое> текущее = м.счётчики.получить(имя);
    если (текущее.успешно) {
        м.счётчики.положить(имя, текущее.значение + на);
    } иначе {
        м.счётчики.положить(имя, на);
        м.имена_счётчиков.добавить(имя);
    }
}

// Самый частый случай — увеличить на единицу ("ещё один запрос",
// "ещё одна ошибка").
функция счётчик_увеличить_на_единицу(Метрики м, текст имя) {
    счётчик_увеличить(м, имя, 1);
}

функция счётчик_значение(Метрики м, текст имя) -> целое {
    результат<целое> текущее = м.счётчики.получить(имя);
    если (текущее.успешно) {
        вернуть текущее.значение;
    }
    вернуть 0;
}

// Устанавливает измеритель "имя" РОВНО в "значение" (не прибавляет —
// для этого ниже есть измеритель_увеличить/измеритель_уменьшить).
функция измеритель_установить(Метрики м, текст имя, дробное значение) {
    результат<дробное> текущее = м.измерители.получить(имя);
    если (!текущее.успешно) {
        м.имена_измерителей.добавить(имя);
    }
    м.измерители.положить(имя, значение);
}

функция измеритель_увеличить(Метрики м, текст имя, дробное на) {
    результат<дробное> текущее = м.измерители.получить(имя);
    если (текущее.успешно) {
        измеритель_установить(м, имя, текущее.значение + на);
    } иначе {
        измеритель_установить(м, имя, на);
    }
}

функция измеритель_уменьшить(Метрики м, текст имя, дробное на) {
    измеритель_увеличить(м, имя, -на);
}

функция измеритель_значение(Метрики м, текст имя) -> дробное {
    результат<дробное> текущее = м.измерители.получить(имя);
    если (текущее.успешно) {
        вернуть текущее.значение;
    }
    вернуть 0.0;
}

// Снимок ВСЕХ метрик в текстовом Prometheus exposition format — можно
// дописать в файл, вывести в консоль, или (следующий естественный шаг,
// не сделанный в этой версии) отдать по HTTP из стандартная_библиотека/
// сеть.код на "/metrics", как настоящий эндпоинт для реального
// Prometheus-сервера. Строки метрик собираются в порядке РЕГИСТРАЦИИ
// (см. комментарий про имена_счётчиков/имена_измерителей в начале файла).
функция метрики_снимок(Метрики м) -> текст {
    текст снимок = "";

    целое i = 0;
    пока (i < м.имена_счётчиков.размер()) {
        текст имя = м.имена_счётчиков.получить(i);
        снимок = снимок + "# TYPE " + имя + " counter\n" + имя + " " + целое_в_текст(счётчик_значение(м, имя)) + "\n";
        i = i + 1;
    }

    i = 0;
    пока (i < м.имена_измерителей.размер()) {
        текст имя = м.имена_измерителей.получить(i);
        снимок = снимок + "# TYPE " + имя + " gauge\n" + имя + " " + дробное_в_текст(измеритель_значение(м, имя)) + "\n";
        i = i + 1;
    }

    вернуть снимок;
}

функция метрики_напечатать(Метрики м) {
    вывести(метрики_снимок(м));
}

// Перезаписывает файл целиком (не дописывает, в отличие от лог.код) —
// снимок метрик это ТЕКУЩЕЕ состояние на момент вызова, а не история
// событий; каждый новый снимок делает предыдущий неактуальным, поэтому
// накапливать их дозаписью в один файл было бы неправильной моделью
// (записать_файл, не дописать_в_файл_бинарно).
функция метрики_записать_файл(Метрики м, текст путь_к_файлу) -> результат<верно> {
    вернуть записать_файл(путь_к_файлу, метрики_снимок(м));
}
