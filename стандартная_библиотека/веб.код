// веб.код — основа для сайтов на «Сфере»: открытие порта, чтение HTTP-запроса,
// разбор адреса и параметров, отдача страниц и файлов (в том числе больших и
// бинарных — установщиков), шаблоны с подстановкой {{имя}}.
//
// Подключается как `подключить веб;` (сам подключает `сеть` и `память`).
//
// Что здесь есть:
//   открыть_порт(порт)                      — сокет, слушающий порт, или ошибка
//   прочитать_запрос(клиент)                — метод, путь, параметры, заголовки, тело
//   параметр(строка_параметров, имя)        — значение из "а=1&б=2" (с декодированием)
//   заголовок(запрос, имя)                  — значение заголовка запроса
//   декодировать_адрес(текст)               — %D0%BF… → «п…», "+" → пробел
//   путь_безопасен(путь)                    — защита от выхода из папки (".." и т.п.)
//   тип_содержимого(путь)                   — MIME-тип по расширению файла
//   ответ_текстом(клиент, код, тип, тело)   — отправить страницу
//   ответ_файлом(клиент, путь, скачать)     — отправить файл частями по 64 КБ
//   перенаправить(клиент, адрес)            — ответ 302
//   заменить(текст, что, чем)               — замена подстроки во всём тексте
//   заполнить(шаблон, имя, значение)        — подстановка {{имя}} в шаблон
//   прочитать_шаблон(путь)                  — читает файл-шаблон или даёт пустой текст
//   ответ_файлом_для(клиент, запрос, путь, имя, скачать, кеш) — файл с докачкой (Range), ETag/304, HEAD
//   ответ_json(клиент, код, тело), json_строка(текст) — JSON-ответы
//   ответ_с_заголовками(клиент, запрос, код, тип, тело, доп) — ответ с Set-Cookie и т.п.
//   значение_cookie(запрос, имя), заголовок_cookie(имя, значение, секунд)
//   принять_тело_в_файл(клиент, путь, байт) — тело PUT/POST потоком в файл (установщики, гигабайты)
//   POST-формы: тело запроса (до 64 КБ) доступно в запрос.тело, поля — параметр(запрос.тело, "имя")
//
// Честные ограничения (версия 1):
//   - заголовки читаются целиком (до 64 КБ), тело POST — до 64 КБ; тело PUT не читается
//     (его принимает обработчик потоком — принять_тело_в_файл);
//   - один запрос — одно соединение (без keep-alive);
//   - HTTPS нет — ставьте перед сервером обратный прокси (nginx, Caddy);
//   - текстовые строки, созданные в обработчике, освобождаются не автоматически —
//     для долгоживущего сервера на тысячи запросов это небольшая утечка памяти.

подключить сеть;
подключить память;

структура Запрос
    текст метод;
    текст путь;
    текст параметры;
    текст заголовки;
    текст тело;
конец

// ---------------------------------------------------------------- текст

// Безопасная подстрока: при любой ошибке возвращает пустой текст.
функция срез(текст источник, целое начало, целое сколько): текст
    если (начало меньше 0 или сколько меньше 0)
        вернуть "";
    конец
    результат из текста часть = подстрока(источник, начало, сколько);
    если (часть.успешно)
        вернуть часть.значение;
    конец
    вернуть "";
конец

// Заменяет все вхождения «что» на «чем». Пустое «что» не заменяется.
функция заменить(текст источник, текст что, текст чем): текст
    целое длина_что = длина(что);
    если (длина_что == 0)
        вернуть источник;
    конец
    текст итог = "";
    текст остаток = источник;
    пока (да)
        результат из целого позиция = найти(остаток, что);
        если ( не позиция.успешно)
            вернуть итог + остаток;
        конец
        итог = итог + срез(остаток, 0, позиция.значение) + чем;
        остаток = срез(остаток, позиция.значение + длина_что, длина(остаток) - позиция.значение - длина_что);
    конец
    вернуть итог;
конец

// Подставляет значение вместо {{имя}} в шаблоне. Удобно, но для горячего пути
// (каждый запрос) лучше подставить(): она делает один проход и один буфер.
функция заполнить(текст шаблон, текст имя, текст значение): текст
    вернуть заменить(шаблон, "{{" + имя + "}}", значение);
конец

// Один проход по шаблону: считает длину результата (писать = 0) или записывает его
// в буфер (писать = 1). Возвращает длину. Неизвестные {{имена}} остаются как есть.
функция обойти_шаблон(текст шаблон, Список из текстов имена, Список из текстов значения, текст буфер, целое писать): целое
    целое n = длина(шаблон);
    целое i = 0;
    целое выход = 0;
    пока (i меньше n)
        целое б = целое(байт_текста(шаблон, i));
        целое подставлено = 0;
        если (б == 123 и i + 1 меньше n)
            если (целое(байт_текста(шаблон, i + 1)) == 123)
                // ищем закрывающие "}}"
                целое j = i + 2;
                целое закрыто = -1;
                пока (j + 1 меньше n и закрыто меньше 0)
                    если (целое(байт_текста(шаблон, j)) == 125 и целое(байт_текста(шаблон, j + 1)) == 125)
                        закрыто = j;
                    конец
                    j = j + 1;
                конец
                если (закрыто больше 0)
                    текст имя = срез(шаблон, i + 2, закрыто - i - 2);
                    целое k = 0;
                    пока (k меньше имена.размер() и подставлено == 0)
                        если (имена.получить(k) == имя)
                            текст значение = значения.получить(k);
                            целое m = длина(значение);
                            целое q = 0;
                            пока (q меньше m)
                                если (писать == 1)
                                    записать_целое32(буфер, выход, целое32(целое(байт_текста(значение, q))));
                                конец
                                выход = выход + 1;
                                q = q + 1;
                            конец
                            подставлено = 1;
                        конец
                        k = k + 1;
                    конец
                    освободить_память(имя);
                    если (подставлено == 1)
                        i = закрыто + 2;
                    конец
                конец
            конец
        конец
        если (подставлено == 0)
            если (писать == 1)
                записать_целое32(буфер, выход, целое32(б));
            конец
            выход = выход + 1;
            i = i + 1;
        конец
    конец
    вернуть выход;
конец

// Подставляет сразу несколько значений: имена[k] → значения[k]. Результат
// выделен в куче — вызывающая сторона освобождает его освободить_память().
функция подставить(текст шаблон, Список из текстов имена, Список из текстов значения): текст
    целое размер = обойти_шаблон(шаблон, имена, значения, "", 0);
    текст буфер = выделить_память(размер + 8);
    обойти_шаблон(шаблон, имена, значения, буфер, 1);
    записать_целое32(буфер, размер, целое32(0));
    вернуть буфер;
конец

// Убирает пробелы, табуляции и переводы строк по краям.
функция обрезать_края(текст источник): текст
    целое слева = 0;
    целое справа = длина(источник);
    пока (слева меньше справа и целое(байт_текста(источник, слева)) не больше 32)
        слева = слева + 1;
    конец
    пока (справа больше слева и целое(байт_текста(источник, справа - 1)) не больше 32)
        справа = справа - 1;
    конец
    вернуть срез(источник, слева, справа - слева);
конец

// Читает файл-шаблон; если файла нет — пустой текст.
функция прочитать_шаблон(текст путь): текст
    результат из текста файл = прочитать_файл(путь);
    если (файл.успешно)
        вернуть файл.значение;
    конец
    вернуть "";
конец

// Экранирует <, >, & и кавычки — для вставки пользовательского текста в HTML.
// Результат выделен в куче — вызывающая сторона освобождает его освободить_память().
функция экранировать_html(текст источник): текст
    целое n = длина(источник);
    текст буфер = выделить_память(n * 6 + 8);
    целое выход = 0;
    целое i = 0;
    пока (i меньше n)
        целое б = целое(байт_текста(источник, i));
        текст замена = "";
        если (б == 38)
            замена = "&amp;";
        иначе если (б == 60)
            замена = "&lt;";
        иначе если (б == 62)
            замена = "&gt;";
        иначе если (б == 34)
            замена = "&quot;";
        конец
        целое k = длина(замена);
        если (k == 0)
            записать_целое32(буфер, выход, целое32(б));
            выход = выход + 1;
        иначе
            целое q = 0;
            пока (q меньше k)
                записать_целое32(буфер, выход, целое32(целое(байт_текста(замена, q))));
                выход = выход + 1;
                q = q + 1;
            конец
        конец
        i = i + 1;
    конец
    записать_целое32(буфер, выход, целое32(0));
    вернуть буфер;
конец

// ------------------------------------------------------ декодирование адреса

функция цифра_16(целое б): целое
    если (б не меньше 48 и б не больше 57)
        вернуть б - 48;
    конец
    если (б не меньше 65 и б не больше 70)
        вернуть б - 55;
    конец
    если (б не меньше 97 и б не больше 102)
        вернуть б - 87;
    конец
    вернуть -1;
конец

// "%D0%BF%D1%80" → «пр», "+" → пробел. Неверные последовательности остаются как есть.
функция декодировать_адрес(текст источник): текст
    целое n = длина(источник);
    текст буфер = выделить_память(n + 8);
    целое выход = 0;
    целое i = 0;
    пока (i меньше n)
        целое б = целое(байт_текста(источник, i));
        если (б == 43)
            записать_целое32(буфер, выход, целое32(32));
            выход = выход + 1;
            i = i + 1;
        иначе если (б == 37 и i + 2 меньше n)
            целое старший = цифра_16(целое(байт_текста(источник, i + 1)));
            целое младший = цифра_16(целое(байт_текста(источник, i + 2)));
            если (старший не меньше 0 и младший не меньше 0)
                записать_целое32(буфер, выход, целое32(старший * 16 + младший));
                выход = выход + 1;
                i = i + 3;
            иначе
                записать_целое32(буфер, выход, целое32(б));
                выход = выход + 1;
                i = i + 1;
            конец
        иначе
            записать_целое32(буфер, выход, целое32(б));
            выход = выход + 1;
            i = i + 1;
        конец
    конец
    записать_целое32(буфер, выход, целое32(0));
    вернуть буфер;
конец

// Значение параметра из строки вида "а=1&б=2" (строка после "?" или тело формы).
// Если параметра нет — пустой текст.
функция параметр(текст строка_параметров, текст имя): текст
    текст остаток = строка_параметров;
    пока (длина(остаток) больше 0)
        текст пара = остаток;
        текст дальше = "";
        результат из целого амп = найти(остаток, "&");
        если (амп.успешно)
            пара = срез(остаток, 0, амп.значение);
            дальше = срез(остаток, амп.значение + 1, длина(остаток) - амп.значение - 1);
        конец
        результат из целого равно = найти(пара, "=");
        если (равно.успешно)
            текст ключ = срез(пара, 0, равно.значение);
            если (декодировать_адрес(ключ) == имя)
                вернуть декодировать_адрес(срез(пара, равно.значение + 1, длина(пара) - равно.значение - 1));
            конец
        иначе
            если (декодировать_адрес(пара) == имя)
                вернуть "";
            конец
        конец
        остаток = дальше;
    конец
    вернуть "";
конец

// ------------------------------------------------------------- безопасность

// Путь допустим для отдачи файла: начинается с "/", без "..", обратных слэшей,
// двоеточий (диски Windows) и нулевых байтов.
функция путь_безопасен(текст путь): верно
    если (длина(путь) == 0)
        вернуть нет;
    конец
    если (целое(байт_текста(путь, 0)) != 47)
        вернуть нет;
    конец
    если (содержит(путь, ".."))
        вернуть нет;
    конец
    если (содержит(путь, "\\"))
        вернуть нет;
    конец
    если (содержит(путь, ":"))
        вернуть нет;
    конец
    если (содержит(путь, "//"))
        вернуть нет;
    конец
    вернуть да;
конец

// ------------------------------------------------------------- тип содержимого

функция оканчивается_на(текст источник, текст окончание): верно
    целое a = длина(источник);
    целое b = длина(окончание);
    если (b больше a)
        вернуть нет;
    конец
    вернуть срез(источник, a - b, b) == окончание;
конец

функция тип_содержимого(текст путь): текст
    текст п = регистр_в_нижний(путь);
    если (оканчивается_на(п, ".html") или оканчивается_на(п, ".htm"))
        вернуть "text/html; charset=utf-8";
    конец
    если (оканчивается_на(п, ".css"))
        вернуть "text/css; charset=utf-8";
    конец
    если (оканчивается_на(п, ".js"))
        вернуть "text/javascript; charset=utf-8";
    конец
    если (оканчивается_на(п, ".json"))
        вернуть "application/json; charset=utf-8";
    конец
    если (оканчивается_на(п, ".txt") или оканчивается_на(п, ".код") или оканчивается_на(п, ".md"))
        вернуть "text/plain; charset=utf-8";
    конец
    если (оканчивается_на(п, ".svg"))
        вернуть "image/svg+xml";
    конец
    если (оканчивается_на(п, ".png"))
        вернуть "image/png";
    конец
    если (оканчивается_на(п, ".jpg") или оканчивается_на(п, ".jpeg"))
        вернуть "image/jpeg";
    конец
    если (оканчивается_на(п, ".gif"))
        вернуть "image/gif";
    конец
    если (оканчивается_на(п, ".ico"))
        вернуть "image/x-icon";
    конец
    если (оканчивается_на(п, ".webp"))
        вернуть "image/webp";
    конец
    если (оканчивается_на(п, ".woff2"))
        вернуть "font/woff2";
    конец
    если (оканчивается_на(п, ".pdf"))
        вернуть "application/pdf";
    конец
    если (оканчивается_на(п, ".zip"))
        вернуть "application/zip";
    конец
    вернуть "application/octet-stream";
конец

// ------------------------------------------------------------------- порт

// Открывает сокет и начинает слушать порт на всех интерфейсах.
функция открыть_порт(целое порт): результат из целого
    целое32 сокет = создать_сокет(целое32(2), целое32(1), целое32(0));
    если (сокет меньше целое32(0))
        вернуть ошибка("не удалось создать сокет");
    конец
    текст включено = выделить_память(8);
    записать_целое32(включено, 0, целое32(1));
    настроить_сокет(сокет, целое32(1), целое32(2), включено, целое32(4));
    освободить_память(включено);

    текст адрес = построить_адрес_сервера("0.0.0.0", целое32(порт));
    целое32 привязка = привязать_сокет(сокет, адрес, целое32(16));
    освободить_память(адрес);
    если (привязка меньше целое32(0))
        вернуть ошибка("не удалось занять порт " + целое_в_текст(порт) + " — возможно, он уже занят");
    конец
    если (слушать_сокет(сокет, целое32(128)) меньше целое32(0))
        вернуть ошибка("не удалось начать слушать порт");
    конец
    вернуть успех(целое(сокет));
конец

// ---------------------------------------------------------------- запрос

// Читает одну порцию данных (до 4096 байт) и возвращает её текстом. Пустой текст — конец данных.
функция прочитать_порцию(целое32 клиент): текст
    текст порция = выделить_память(4104);
    целое получено = получить_данные(клиент, порция, 4096, целое32(0));
    если (получено больше 4096)
        получено = 0;
    конец
    если (получено меньше 1)
        записать_целое32(порция, 0, целое32(0));
        вернуть порция;
    конец
    записать_целое32(порция, получено, целое32(0));
    вернуть порция;
конец

// Значение заголовка запроса (без учёта регистра имени). Нет заголовка — пустой текст.
функция заголовок(Запрос з, текст имя): текст
    текст все = "\r\n" + регистр_в_нижний(з.заголовки);
    текст ищем = "\r\n" + регистр_в_нижний(имя) + ":";
    результат из целого позиция = найти(все, ищем);
    если ( не позиция.успешно)
        вернуть "";
    конец
    целое начало = позиция.значение + длина(ищем);
    текст после = срез(з.заголовки, начало - 2, длина(з.заголовки) - начало + 2);
    результат из целого конец_строки = найти(после, "\r\n");
    текст значение = после;
    если (конец_строки.успешно)
        значение = срез(после, 0, конец_строки.значение);
    конец
    вернуть обрезать_края(значение);
конец

// Читает и разбирает запрос. Ошибка — если соединение оборвалось или запрос не HTTP.
функция прочитать_запрос(целое32 клиент): результат из Запрос
    текст накоплено = "";
    целое всего = 0;
    целое конец_заголовков = -1;
    пока (конец_заголовков меньше 0 и всего меньше 65536)
        текст порция = подсмотреть_порцию(клиент);
        целое размер_порции = длина(порция);
        если (размер_порции == 0)
            освободить_память(порция);
            вернуть ошибка("соединение закрыто до конца запроса");
        конец
        целое было = длина(накоплено);
        накоплено = накоплено + порция;
        освободить_память(порция);
        результат из целого граница = найти(накоплено, "\r\n\r\n");
        целое потребить = размер_порции;
        если (граница.успешно)
            конец_заголовков = граница.значение;
            потребить = граница.значение + 4 - было;
        конец
        // Из сокета забираем ровно заголовки: тело (возможно, бинарное) остаётся нетронутым.
        потребить_байты(клиент, потребить);
        всего = длина(накоплено);
    конец
    если (конец_заголовков меньше 0)
        вернуть ошибка("слишком длинные заголовки");
    конец

    текст голова = срез(накоплено, 0, конец_заголовков);
    результат из целого конец_первой = найти(голова, "\r\n");
    текст первая_строка = голова;
    текст блок_заголовков = "";
    если (конец_первой.успешно)
        первая_строка = срез(голова, 0, конец_первой.значение);
        блок_заголовков = срез(голова, конец_первой.значение, длина(голова) - конец_первой.значение);
    конец

    результат из целого пробел_1 = найти(первая_строка, " ");
    если ( не пробел_1.успешно)
        вернуть ошибка("не HTTP-запрос");
    конец
    текст метод = срез(первая_строка, 0, пробел_1.значение);
    текст после_метода = срез(первая_строка, пробел_1.значение + 1, длина(первая_строка) - пробел_1.значение - 1);
    текст цель = после_метода;
    результат из целого пробел_2 = найти(после_метода, " ");
    если (пробел_2.успешно)
        цель = срез(после_метода, 0, пробел_2.значение);
    конец

    текст путь = цель;
    текст параметры_строка = "";
    результат из целого вопрос = найти(цель, "?");
    если (вопрос.успешно)
        путь = срез(цель, 0, вопрос.значение);
        параметры_строка = срез(цель, вопрос.значение + 1, длина(цель) - вопрос.значение - 1);
    конец

    текст тело = "";
    Запрос черновик = Запрос(метод, декодировать_адрес(путь), параметры_строка, блок_заголовков, тело);

    // Тело: дочитываем по Content-Length (не больше 64 КБ всего). У PUT тело не читается —
    // его принимает обработчик потоком в файл (см. принять_тело_в_файл).
    текст длина_тела_текст = заголовок(черновик, "Content-Length");
    если (длина(длина_тела_текст) больше 0 и метод != "PUT")
        результат из целого нужно = текст_в_целое(длина_тела_текст);
        если (нужно.успешно)
            целое хочу = нужно.значение;
            если (хочу больше 65536)
                хочу = 65536;
            конец
            текст полное_тело = тело;
            пока (длина(полное_тело) меньше хочу)
                текст порция2 = прочитать_порцию(клиент);
                если (длина(порция2) == 0)
                    освободить_память(порция2);
                    прервать;
                конец
                полное_тело = полное_тело + порция2;
                освободить_память(порция2);
            конец
            вернуть успех(Запрос(метод, декодировать_адрес(путь), параметры_строка, блок_заголовков, полное_тело));
        конец
    конец
    вернуть успех(черновик);
конец


// Смотрит на пришедшие байты, не забирая их из сокета (MSG_PEEK). Возвращает текст
// до первого нулевого байта; пустой текст — соединение закрыто или данных нет.
функция подсмотреть_порцию(целое32 клиент): текст
    текст порция = выделить_память(4104);
    целое получено = получить_данные(клиент, порция, 4096, целое32(2));
    если (получено больше 4096)
        получено = 0;
    конец
    если (получено меньше 1)
        получено = 0;
    конец
    записать_целое32(порция, получено, целое32(0));
    вернуть порция;
конец

// Забирает из сокета ровно n байт и выбрасывает их.
функция потребить_байты(целое32 клиент, целое n): целое
    текст мусор = выделить_память(4104);
    целое осталось = n;
    пока (осталось больше 0)
        целое хочу = осталось;
        если (хочу больше 4096)
            хочу = 4096;
        конец
        целое получено = получить_данные(клиент, мусор, хочу, целое32(0));
        если (получено меньше 1)
            освободить_память(мусор);
            вернуть n - осталось;
        конец
        осталось = осталось - получено;
    конец
    освободить_память(мусор);
    вернуть n;
конец

// Принимает ровно «всего» байт тела запроса прямо в файл (бинарно, кусками по 64 КБ).
// Подходит для загрузки установщиков в сотни мегабайт. Возвращает число принятых байт.
функция принять_тело_в_файл(целое32 клиент, текст путь, целое всего): результат из целого
    результат из верного создан = записать_файл(путь, "");
    если ( не создан.успешно)
        вернуть ошибка("не удалось создать файл");
    конец
    текст буфер = выделить_память(65544);
    целое принято = 0;
    пока (принято меньше всего)
        целое хочу = всего - принято;
        если (хочу больше 65536)
            хочу = 65536;
        конец
        целое получено = получить_данные(клиент, буфер, хочу, целое32(0));
        если (получено меньше 1)
            освободить_память(буфер);
            вернуть ошибка("соединение оборвалось, принято " + целое_в_текст(принято) + " из " + целое_в_текст(всего));
        конец
        дописать_в_файл_бинарно(путь, буфер, получено);
        принято = принято + получено;
    конец
    освободить_память(буфер);
    вернуть успех(принято);
конец

// Значение cookie из заголовка Cookie запроса. Нет такой cookie — пустой текст.
функция значение_cookie(Запрос з, текст имя): текст
    текст все = "; " + заголовок(з, "Cookie");
    текст ищем = "; " + имя + "=";
    результат из целого позиция = найти(все, ищем);
    если ( не позиция.успешно)
        вернуть "";
    конец
    целое начало = позиция.значение + длина(ищем);
    целое конец_значения = начало;
    пока (конец_значения меньше длина(все) и целое(байт_текста(все, конец_значения)) != 59)
        конец_значения = конец_значения + 1;
    конец
    вернуть срез(все, начало, конец_значения - начало);
конец

// Строка заголовка Set-Cookie (значение — только безопасные символы: латиница, цифры, -_.).
функция заголовок_cookie(текст имя, текст значение, целое секунд): текст
    вернуть "Set-Cookie: " + имя + "=" + значение + "; Path=/; Max-Age=" + целое_в_текст(секунд) +
        "; HttpOnly; SameSite=Lax\r\n";
конец

// Строка в виде JSON-строки (в кавычках, с экранированием).
функция json_строка(текст источник): текст
    текст итог = "\"";
    целое n = длина(источник);
    целое i = 0;
    пока (i меньше n)
        целое б = целое(байт_текста(источник, i));
        если (б == 34)
            итог = итог + "\\\"";
        иначе если (б == 92)
            итог = итог + "\\\\";
        иначе если (б == 10)
            итог = итог + "\\n";
        иначе если (б == 13)
            итог = итог + "\\r";
        иначе если (б == 9)
            итог = итог + "\\t";
        иначе если (б меньше 32)
            итог = итог + " ";
        иначе
            итог = итог + срез(источник, i, 1);
        конец
        i = i + 1;
    конец
    вернуть итог + "\"";
конец

// ---------------------------------------------------------------- ответы

функция описание_статуса(целое код): текст
    если (код == 200)
        вернуть "OK";
    конец
    если (код == 201)
        вернуть "Created";
    конец
    если (код == 206)
        вернуть "Partial Content";
    конец
    если (код == 304)
        вернуть "Not Modified";
    конец
    если (код == 401)
        вернуть "Unauthorized";
    конец
    если (код == 409)
        вернуть "Conflict";
    конец
    если (код == 413)
        вернуть "Payload Too Large";
    конец
    если (код == 416)
        вернуть "Range Not Satisfiable";
    конец
    если (код == 302)
        вернуть "Found";
    конец
    если (код == 400)
        вернуть "Bad Request";
    конец
    если (код == 403)
        вернуть "Forbidden";
    конец
    если (код == 404)
        вернуть "Not Found";
    конец
    если (код == 405)
        вернуть "Method Not Allowed";
    конец
    если (код == 500)
        вернуть "Internal Server Error";
    конец
    вернуть "OK";
конец

функция заголовки_ответа(целое код, текст тип, целое размер, текст дополнительно): текст
    вернуть "HTTP/1.1 " + целое_в_текст(код) + " " + описание_статуса(код) +
        "\r\nContent-Type: " + тип +
        "\r\nContent-Length: " + целое_в_текст(размер) +
        "\r\nConnection: close\r\nX-Content-Type-Options: nosniff\r\n" + дополнительно + "\r\n";
конец

// Отправляет страницу (текст) с заданным кодом и типом содержимого.
функция ответ_текстом(целое32 клиент, целое код, текст тип, текст тело): целое
    текст целиком = заголовки_ответа(код, тип, длина(тело), "") + тело;
    отправить_данные(клиент, целиком, длина(целиком), целое32(0));
    вернуть 0;
конец

функция ответ_html(целое32 клиент, целое код, текст тело): целое
    вернуть ответ_текстом(клиент, код, "text/html; charset=utf-8", тело);
конец

функция перенаправить(целое32 клиент, текст адрес): целое
    текст шапка = заголовки_ответа(302, "text/plain; charset=utf-8", 0, "Location: " + адрес + "\r\n");
    отправить_данные(клиент, шапка, длина(шапка), целое32(0));
    вернуть 0;
конец

// Ответ с дополнительными заголовками (например, Set-Cookie или Cache-Control).
функция ответ_с_заголовками(целое32 клиент, Запрос з, целое код, текст тип, текст тело, текст дополнительно): целое
    текст шапка = заголовки_ответа(код, тип, длина(тело), дополнительно);
    если (з.метод == "HEAD")
        отправить_данные(клиент, шапка, длина(шапка), целое32(0));
    иначе
        текст целиком = шапка + тело;
        отправить_данные(клиент, целиком, длина(целиком), целое32(0));
    конец
    вернуть 0;
конец

функция ответ_json(целое32 клиент, целое код, текст тело): целое
    вернуть ответ_текстом(клиент, код, "application/json; charset=utf-8", тело);
конец

// Разбор «Range: bytes=a-b». Возвращает «начало,конец» (включительно) или "" — если
// заголовка нет/он непонятен, или "bad" — диапазон за пределами файла.
функция разобрать_диапазон(текст значение, целое всего): текст
    если (длина(значение) меньше 7 или срез(значение, 0, 6) != "bytes=")
        вернуть "";
    конец
    текст часть = срез(значение, 6, длина(значение) - 6);
    если (содержит(часть, ","))
        вернуть "";
    конец
    результат из целого тире = найти(часть, "-");
    если ( не тире.успешно)
        вернуть "";
    конец
    текст слева = срез(часть, 0, тире.значение);
    текст справа = срез(часть, тире.значение + 1, длина(часть) - тире.значение - 1);
    целое начало = 0;
    целое конец_включительно = всего - 1;
    если (длина(слева) == 0)
        результат из целого хвост = текст_в_целое(справа);
        если ( не хвост.успешно или хвост.значение меньше 1)
            вернуть "";
        конец
        начало = всего - хвост.значение;
        если (начало меньше 0)
            начало = 0;
        конец
    иначе
        результат из целого а = текст_в_целое(слева);
        если ( не а.успешно или а.значение меньше 0)
            вернуть "";
        конец
        начало = а.значение;
        если (длина(справа) больше 0)
            результат из целого б = текст_в_целое(справа);
            если ( не б.успешно)
                вернуть "";
            конец
            конец_включительно = б.значение;
            если (конец_включительно больше всего - 1)
                конец_включительно = всего - 1;
            конец
        конец
    конец
    если (начало больше конец_включительно или начало не меньше всего)
        вернуть "bad";
    конец
    вернуть целое_в_текст(начало) + "," + целое_в_текст(конец_включительно);
конец

// Отдача файла с поддержкой докачки (Range), ETag/304 и HEAD.
// кеш — значение Cache-Control (например "public, max-age=300") или "" — без него.
// ETag строится по размеру файла: меняя файл, меняйте и его имя/размер.
функция ответ_файлом_для(целое32 клиент, Запрос з, текст путь_к_файлу, текст имя_для_скачивания, верно скачать, текст кеш): верно
    результат из целого размер_результат = размер_файла(путь_к_файлу);
    если ( не размер_результат.успешно)
        вернуть нет;
    конец
    целое всего = размер_результат.значение;
    текст etag = "\"" + целое_в_текст(всего) + "\"";
    текст дополнительно = "Accept-Ranges: bytes\r\nETag: " + etag + "\r\n";
    если (длина(кеш) больше 0)
        дополнительно = дополнительно + "Cache-Control: " + кеш + "\r\n";
    конец
    если (скачать)
        дополнительно = дополнительно + "Content-Disposition: attachment; filename=\"" + имя_для_скачивания + "\"\r\n";
    конец
    текст тип = тип_содержимого(имя_для_скачивания);

    если (заголовок(з, "If-None-Match") == etag)
        текст шапка304 = заголовки_ответа(304, тип, 0, дополнительно);
        отправить_данные(клиент, шапка304, длина(шапка304), целое32(0));
        вернуть да;
    конец

    целое начало = 0;
    целое конец_включительно = всего - 1;
    целое код = 200;
    текст если_диапазон = заголовок(з, "If-Range");
    если (длина(если_диапазон) == 0 или если_диапазон == etag)
        текст диапазон = разобрать_диапазон(заголовок(з, "Range"), всего);
        если (диапазон == "bad")
            текст шапка416 = заголовки_ответа(416, "text/plain; charset=utf-8", 0, "Content-Range: bytes */" + целое_в_текст(всего) + "\r\n");
            отправить_данные(клиент, шапка416, длина(шапка416), целое32(0));
            вернуть да;
        конец
        если (длина(диапазон) больше 0)
            результат из целого запятая = найти(диапазон, ",");
            результат из целого а = текст_в_целое(срез(диапазон, 0, запятая.значение));
            результат из целого б = текст_в_целое(срез(диапазон, запятая.значение + 1, длина(диапазон) - запятая.значение - 1));
            начало = а.значение;
            конец_включительно = б.значение;
            код = 206;
            дополнительно = дополнительно + "Content-Range: bytes " + целое_в_текст(начало) + "-" +
                целое_в_текст(конец_включительно) + "/" + целое_в_текст(всего) + "\r\n";
        конец
    конец

    целое длина_ответа = конец_включительно - начало + 1;
    текст шапка = заголовки_ответа(код, тип, длина_ответа, дополнительно);
    отправить_данные(клиент, шапка, длина(шапка), целое32(0));
    если (з.метод == "HEAD")
        вернуть да;
    конец

    целое отправлено = 0;
    пока (отправлено меньше длина_ответа)
        целое порция = длина_ответа - отправлено;
        если (порция больше 65536)
            порция = 65536;
        конец
        результат из текста кусок = прочитать_часть_файла(путь_к_файлу, начало + отправлено, порция);
        если ( не кусок.успешно)
            вернуть да;
        конец
        целое ушло = отправить_данные(клиент, кусок.значение, порция, целое32(0));
        освободить_память(кусок.значение);
        если (ушло меньше 1)
            вернуть да;
        конец
        отправлено = отправлено + порция;
    конец
    вернуть да;
конец

// Отдаёт файл частями по 64 КБ — подходит и для маленьких страниц, и для
// установщиков в сотни мегабайт (в памяти держится только одна часть).
// скачать = да — браузер предложит сохранить файл, а не открывать его.
// Возвращает да, если файл найден и отправлен.
функция ответ_файлом(целое32 клиент, текст путь_к_файлу, текст имя_для_скачивания, верно скачать): верно
    результат из целого размер_файла_результат = размер_файла(путь_к_файлу);
    если ( не размер_файла_результат.успешно)
        вернуть нет;
    конец
    целое всего = размер_файла_результат.значение;

    текст дополнительно = "";
    если (скачать)
        дополнительно = "Content-Disposition: attachment; filename=\"" + имя_для_скачивания + "\"\r\n";
    конец
    текст шапка = заголовки_ответа(200, тип_содержимого(имя_для_скачивания), всего, дополнительно);
    отправить_данные(клиент, шапка, длина(шапка), целое32(0));

    целое отправлено = 0;
    пока (отправлено меньше всего)
        целое порция = всего - отправлено;
        если (порция больше 65536)
            порция = 65536;
        конец
