функция описание_статуса(целое код): текст
    если (код == 200)
        вернуть "OK";
    конец
    если (код == 206)
        вернуть "Partial Content";
    конец
    если (код == 302)
        вернуть "Found";
    конец
    если (код == 400)
        вернуть "Bad Request";
    конец
    если (код == 403)
        вернуть "Forbidden";
    конец
    если (код == 404)
        вернуть "Not Found";
    конец
    если (код == 405)
        вернуть "Method Not Allowed";
    конец
    если (код == 500)
        вернуть "Internal Server Error";
    конец
    вернуть "OK";
конец

функция заголовки_ответа(целое код, текст тип, целое размер, текст дополнительно): текст
    вернуть "HTTP/1.1 " + целое_в_текст(код) + " " + описание_статуса(код) +
        "\r\nContent-Type: " + тип +
        "\r\nContent-Length: " + целое_в_текст(размер) +
        "\r\nConnection: close\r\nX-Content-Type-Options: nosniff\r\n" + дополнительно + "\r\n";
конец

// Отправляет страницу (текст) с заданным кодом и типом содержимого.
функция ответ_текстом(целое32 клиент, целое код, текст тип, текст тело): целое
    текст целиком = заголовки_ответа(код, тип, длина(тело), "") + тело;
    отправить_данные(клиент, целиком, длина(целиком), целое32(0));
    вернуть 0;
конец

функция ответ_html(целое32 клиент, целое код, текст тело): целое
    вернуть ответ_текстом(клиент, код, "text/html; charset=utf-8", тело);
конец

функция перенаправить(целое32 клиент, текст адрес): целое
    текст шапка = заголовки_ответа(302, "text/plain; charset=utf-8", 0, "Location: " + адрес + "\r\n");
    отправить_данные(клиент, шапка, длина(шапка), целое32(0));
    вернуть 0;
конец

// Отдаёт файл частями по 64 КБ — подходит и для маленьких страниц, и для
// установщиков в сотни мегабайт (в памяти держится только одна часть).
// скачать = да — браузер предложит сохранить файл, а не открывать его.
// Возвращает да, если файл найден и отправлен.
функция ответ_файлом(целое32 клиент, текст путь_к_файлу, текст имя_для_скачивания, верно скачать): верно
    результат из целое размер_файла_результат = размер_файла(путь_к_файлу);
    если ( не размер_файла_результат.успешно)
        вернуть нет;
    конец
    целое всего = размер_файла_результат.значение;

    текст дополнительно = "";
    если (скачать)
        дополнительно = "Content-Disposition: attachment; filename=\"" + имя_для_скачивания + "\"\r\n";
    конец
    текст шапка = заголовки_ответа(200, тип_содержимого(имя_для_скачивания), всего, дополнительно);
    отправить_данные(клиент, шапка, длина(шапка), целое32(0));

    целое отправлено = 0;
    пока (отправлено меньше всего)
        целое порция = всего - отправлено;
        если (порция больше 65536)
            порция = 65536;
        конец
        результат из текст кусок = прочитать_часть_файла(путь_к_файлу, отправлено, порция);
        если ( не кусок.успешно)
            вернуть да;
        конец
        целое ушло = отправить_данные(клиент, кусок.значение, порция, целое32(0));
        освободить_память(кусок.значение);
        если (ушло меньше 1)
            вернуть да;
        конец
        отправлено = отправлено + порция;
    конец
    вернуть да;
конец
