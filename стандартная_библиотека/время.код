// время.код — даты и время: разбор, форматирование, дни недели, часовые пояса.
//
// Подключается как `подключить время;`.
//
// Время в языке хранится как «юникс-секунды»: целое число секунд,
// прошедших с 1970-01-01 00:00:00 по Гринвичу (UTC). Его даёт `юникс_время()`.
// Из такого числа модуль собирает календарную дату (ДатаВремя), и обратно.
//
// Календарь считается напрямую, алгоритмами Говарда Хиннанта
// (http://howardhinnant.github.io/date_algorithms.html, они лежат в основе
// <chrono> из C++20), без вызова C strftime/localtime. Даты до 1970 года
// поддерживаются (отрицательные юникс-секунды).
//
// ⚠️ Честно, узко:
// - Часовой пояс — только фиксированное смещение в минутах от UTC
//   (Москва = 180, без перехода на летнее время: в России его нет).
//   Базы часовых поясов с переходами (как у Европы или США) в модуле нет.
// - Григорианский календарь продлён и на даты до его введения.
// - Високосные секунды не учитываются (как и в юникс-времени).

структура ДатаВремя
    целое год;
    целое месяц;
    целое день;
    целое час;
    целое минута;
    целое секунда;
конец

// ------------------------------------------------------------ вспомогательное

// Деление, округляющее вниз (для отрицательных чисел обычное деление округляет к нулю).
функция время_деление_вниз(целое а, целое б): целое
    целое ч = а / б;
    // б всегда положительное: при остатке у отрицательного числа округляем вниз
    если (а % б != 0 и а меньше 0)
        ч = ч - 1;
    конец
    вернуть ч;
конец

// Дополняет число ведущим нулём до двух цифр ("5" -> "05").
функция дополнить_нулём(целое число): текст
    если (число меньше 10)
        вернуть "0" + целое_в_текст(число);
    конец
    вернуть целое_в_текст(число);
конец

функция високосный_год(целое год): верно
    если (год % 400 == 0)
        вернуть да;
    конец
    если (год % 100 == 0)
        вернуть нет;
    конец
    вернуть год % 4 == 0;
конец

// Сколько дней в месяце (1..12) данного года; для неверного месяца 0.
функция дней_в_месяце(целое год, целое месяц): целое
    если (месяц меньше 1 или месяц больше 12)
        вернуть 0;
    конец
    если (месяц == 2)
        если (високосный_год(год))
            вернуть 29;
        конец
        вернуть 28;
    конец
    если (месяц == 4 или месяц == 6 или месяц == 9 или месяц == 11)
        вернуть 30;
    конец
    вернуть 31;
конец

// ------------------------------------------------------------ юникс <-> дата

// Раскладывает юникс-секунды (UTC) на год/месяц/день/час/минуту/секунду.
функция время_из_юникса(целое юникс_секунды): ДатаВремя
    целое дни = время_деление_вниз(юникс_секунды, 86400);
    целое секунды_дня = юникс_секунды - дни * 86400;

    целое час = секунды_дня / 3600;
    целое минута = (секунды_дня % 3600) / 60;
    целое секунда = секунды_дня % 60;

    // civil_from_days (Хиннант)
    целое z = дни + 719468;
    целое эра = время_деление_вниз(z, 146097);
    целое день_эры = z - эра * 146097;
    целое год_эры = (день_эры - день_эры / 1460 + день_эры / 36524 - день_эры / 146096) / 365;
    целое год = год_эры + эра * 400;
    целое день_года = день_эры - (365 * год_эры + год_эры / 4 - год_эры / 100);
    целое мр = (5 * день_года + 2) / 153;
    целое день = день_года - (153 * мр + 2) / 5 + 1;
    целое месяц = мр + 3;
    если (мр не меньше 10)
        месяц = мр - 9;
    конец
    если (месяц не больше 2)
        год = год + 1;
    конец

    вернуть ДатаВремя(год, месяц, день, час, минута, секунда);
конец

// Обратное преобразование: дата (считается как UTC) в юникс-секунды.
// Значения не проверяются: проверку делает разобрать_дату_время.
функция юникс_из_времени(ДатаВремя дв): целое
    целое г = дв.год;
    если (дв.месяц не больше 2)
        г = г - 1;
    конец
    целое эра = время_деление_вниз(г, 400);
    целое год_эры = г - эра * 400;
    целое м = дв.месяц - 3;
    если (дв.месяц не больше 2)
        м = дв.месяц + 9;
    конец
    целое день_года = (153 * м + 2) / 5 + дв.день - 1;
    целое день_эры = год_эры * 365 + год_эры / 4 - год_эры / 100 + день_года;
    целое дни = эра * 146097 + день_эры - 719468;
    вернуть дни * 86400 + дв.час * 3600 + дв.минута * 60 + дв.секунда;
конец

// Дата в часовом поясе со смещением от UTC в минутах (Москва: 180).
функция время_из_юникса_со_смещением(целое юникс_секунды, целое смещение_минут): ДатаВремя
    вернуть время_из_юникса(юникс_секунды + смещение_минут * 60);
конец

функция смещение_москвы(): целое
    вернуть 180;
конец

// Текущее время по Гринвичу и по Москве.
функция сейчас(): ДатаВремя
    вернуть время_из_юникса(юникс_время());
конец

функция сейчас_в_москве(): ДатаВремя
    вернуть время_из_юникса_со_смещением(юникс_время(), 180);
конец

// ------------------------------------------------------------ календарь

// День недели: 1 — понедельник … 7 — воскресенье (по юникс-секундам, UTC).
функция день_недели(целое юникс_секунды): целое
    целое дни = время_деление_вниз(юникс_секунды, 86400);
    // 1970-01-01 был четвергом (4)
    целое н = (дни + 3) % 7;
    если (н меньше 0)
        н = н + 7;
    конец
    вернуть н + 1;
конец

