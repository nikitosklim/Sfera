// "ГГГГ-ММ-ДД ЧЧ:ММ:СС"
функция дата_время_в_текст(ДатаВремя дв): текст
    вернуть дата_в_текст(дв) + " " + время_в_текст(дв);
конец

// "ГГГГ-ММ-ДД"
функция дата_в_текст(ДатаВремя дв): текст
    вернуть целое_в_текст(дв.год) + "-" + дополнить_нулём(дв.месяц) + "-" + дополнить_нулём(дв.день);
конец

// "ЧЧ:ММ:СС"
функция время_в_текст(ДатаВремя дв): текст
    вернуть дополнить_нулём(дв.час) + ":" + дополнить_нулём(дв.минута) + ":" + дополнить_нулём(дв.секунда);
конец

// "23 ноября 2026, 14:36"
функция дата_по_русски(ДатаВремя дв): текст
    вернуть целое_в_текст(дв.день) + " " + название_месяца_в_дате(дв.месяц) + " " + целое_в_текст(дв.год)
        + ", " + дополнить_нулём(дв.час) + ":" + дополнить_нулём(дв.минута);
конец

// Метка времени в UTC для логов: "ГГГГ-ММ-ДД ЧЧ:ММ:СС".
функция текущее_время_текст(): текст
    вернуть дата_время_в_текст(сейчас());
конец

// ------------------------------------------------------------ разбор

// Читает n цифр подряд с позиции п; если это не цифры — -1.
функция время_цифры(текст с, целое п, целое n): целое
    если (п + n больше длина(с))
        вернуть -1;
    конец
    целое значение = 0;
    целое i = 0;
    пока (i меньше n)
        целое б = целое(байт_текста(с, п + i));
        если (б меньше 48 или б больше 57)
            вернуть -1;
        конец
        значение = значение * 10 + (б - 48);
        i = i + 1;
    конец
    вернуть значение;
конец

функция время_знак(текст с, целое п): целое
    если (п не меньше длина(с))
        вернуть -1;
    конец
    вернуть целое(байт_текста(с, п));
конец

// Разбирает «ГГГГ-ММ-ДД», «ГГГГ-ММ-ДД ЧЧ:ММ:СС» и ISO 8601
// «ГГГГ-ММ-ДДTЧЧ:ММ:СС» (допускается завершающая Z). Время считается UTC.
// Лишние символы и несуществующие даты (30 февраля, 25-й час) — ошибка.
функция разобрать_дату_время(текст с): результат из ДатаВремя
    целое n = длина(с);
    если (n != 10 и n != 19 и n != 20)
        вернуть ошибка("дата должна выглядеть как ГГГГ-ММ-ДД или ГГГГ-ММ-ДД ЧЧ:ММ:СС");
    конец
    целое год = время_цифры(с, 0, 4);
    целое месяц = время_цифры(с, 5, 2);
    целое день = время_цифры(с, 8, 2);
    если (год меньше 0 или месяц меньше 0 или день меньше 0 или время_знак(с, 4) != 45 или время_знак(с, 7) != 45)
        вернуть ошибка("дата должна выглядеть как ГГГГ-ММ-ДД");
    конец
    если (месяц меньше 1 или месяц больше 12 или день меньше 1 или день больше дней_в_месяце(год, месяц))
        вернуть ошибка("такой даты не существует");
    конец
    целое час = 0;
    целое минута = 0;
    целое секунда = 0;
    если (n != 10)
        целое разделитель = время_знак(с, 10);
        если (разделитель != 32 и разделитель != 84)
            вернуть ошибка("между датой и временем нужен пробел или буква T");
        конец
        час = время_цифры(с, 11, 2);
        минута = время_цифры(с, 14, 2);
        секунда = время_цифры(с, 17, 2);
        если (час меньше 0 или минута меньше 0 или секунда меньше 0 или время_знак(с, 13) != 58 или время_знак(с, 16) != 58)
            вернуть ошибка("время должно выглядеть как ЧЧ:ММ:СС");
        конец
        если (n == 20 и время_знак(с, 19) != 90)
            вернуть ошибка("после секунд допускается только буква Z");
        конец
        если (час больше 23 или минута больше 59 или секунда больше 59)
            вернуть ошибка("такого времени не существует");
        конец
    конец
    вернуть успех(ДатаВремя(год, месяц, день, час, минута, секунда));
конец
