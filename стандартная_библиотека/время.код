// Целых суток между двумя моментами (вниз): дней_между(начало, конец).
функция дней_между(целое юникс_начала, целое юникс_конца): целое
    вернуть время_деление_вниз(юникс_конца - юникс_начала, 86400);
конец

// Сдвиг момента на n суток (n может быть отрицательным).
функция прибавить_дни(целое юникс_секунды, целое дней): целое
    вернуть юникс_секунды + дней * 86400;
конец

