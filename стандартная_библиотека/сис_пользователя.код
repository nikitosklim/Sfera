// сис_пользователя.код — системные вызовы для программ, которые работают в пользовательском режиме (кольцо 3).
//
// Подключение:  подключить сис_пользователя;   Сборка программы: examples/ос/собрать_ядро.sh
// Вызовы ядра (int 0x80): 1 — вывод символа, 2 — выход, 3 — тики таймера, 4 — аргумент программы.
// Стартовый код (examples/ос/пользователь/старт.s) даёт «sfera_сисвызов».

внешняя функция сисвызов(целое номер, целое а, целое б): целое как "sfera_сисвызов";

функция писать_символ(целое байт)
    сисвызов(1, байт, 0);
конец

функция писать_текст(текст т)
    целое i = 0;
    пока (целое(байт_текста(т, i)) != 0)
        писать_символ(целое(байт_текста(т, i)));
        i = i + 1;
    конец
конец

функция писать_число(целое ч)
    если (ч >= 10)
        писать_число(ч / 10);
    конец
    писать_символ(48 + ч % 10);
конец

функция аргумент_программы(): целое
    вернуть сисвызов(4, 0, 0);
конец

функция тики(): целое
    вернуть сисвызов(3, 0, 0);
конец
