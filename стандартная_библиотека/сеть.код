// сеть.код — минимальная библиотека для работы с TCP-сокетами напрямую
// через системные вызовы операционной системы (POSIX), тем же способом,
// каким графика.код обёрнута вокруг SDL2 — прямой FFI, без магии.

внешняя функция выделить_память(целое размер) -> текст как "malloc";
внешняя функция освободить_память(текст указатель) -> целое32 как "free";

// AF_INET = 2, SOCK_STREAM = 1 — используются как обычные числа при вызове,
// системе всё равно, как мы их называем у себя.
внешняя функция создать_сокет(целое32 домен, целое32 тип, целое32 протокол) -> целое32 как "socket";
внешняя функция подключиться(целое32 сокет, текст адрес, целое32 размер_адреса) -> целое32 как "connect";
внешняя функция отправить_данные(целое32 сокет, текст буфер, целое размер, целое32 флаги) -> целое как "send";
внешняя функция получить_данные(целое32 сокет, текст буфер, целое размер, целое32 флаги) -> целое как "recv";
внешняя функция закрыть_сокет(целое32 сокет) -> целое32 как "close";

// Преобразование в сетевой порядок байт — нужно системе, чтобы верно
// понять номер порта независимо от архитектуры процессора.
внешняя функция сетевой_порядок_16(целое32 значение) -> целое32 как "htons";
// Разбор текстового IP-адреса ("127.0.0.1") в числовой вид, ожидаемый
// системой — без этого пришлось бы делать DNS-резолвинг вручную (отдельная,
// более сложная задача, не нужная для подключения по готовому IP).
внешняя функция текст_в_ip(текст адрес) -> целое32 как "inet_addr";

// Строит структуру "sockaddr_in" (16 байт, стандартный, фиксированный
// формат POSIX для адреса подключения) вручную, по байтам — тем же самым
// приёмом, что уже использовался для SDL_Event в графика.код: нет
// настоящего маршалинга структур через FFI, поэтому собираем байты сами.
//   байты 0-1:  семейство адреса (AF_INET = 2)
//   байты 2-3:  порт, в сетевом порядке байт
//   байты 4-7:  IP-адрес, в сетевом порядке байт
//   байты 8-15: заполнение нулями (обязательно по стандарту, не используется)
функция построить_адрес_сервера(текст ip, целое32 порт) -> текст {
    текст буфер = выделить_память(16);

    целое32 семейство = целое32(2);
    целое32 порт_сетевой = сетевой_порядок_16(порт);
    // Семейство (младшие 2 байта) и порт (следующие 2 байта) идут подряд —
    // объединяем их в одно 32-битное число арифметикой вместо побитовых
    // операций (которых в языке пока нет): умножение на 65536 сдвигает
    // порт ровно на 16 бит влево, что для этой пары полей эквивалентно.
    целое32 семейство_и_порт = семейство + порт_сетевой * целое32(65536);
    записать_целое32(буфер, 0, семейство_и_порт);

    целое32 ip_число = текст_в_ip(ip);
    записать_целое32(буфер, 4, ip_число);

    записать_целое32(буфер, 8, целое32(0));
    записать_целое32(буфер, 12, целое32(0));

    вернуть буфер;
}
