// почта_имена.код — перевод кириллических имён узлов («языксфера.рф») в «xn--…» (алгоритм RFC 3492),
// потому что защищённое соединение и сертификат работают с латинской формой имени.
//
// Подключается как "подключить почта_имена;". Главная функция — хост_в_пуникод.
// Части имени без русских букв остаются как есть.

// «языксфера.рф» → «xn--80ajfm5aev7c8a.xn--p1ai»: каждая часть имени с русскими буквами переводится отдельно.
функция пуни_цифра(целое д): текст
    текст алфавит = "abcdefghijklmnopqrstuvwxyz0123456789";
    результат из текста р = подстрока(алфавит, д, 1);
    если (р.успешно)
        вернуть р.значение;
    конец
    вернуть "";
конец

функция пуни_адаптация(целое дельта_вход, целое число_точек, целое первый): целое
    целое дельта = дельта_вход / 2;
    если (первый == 1)
        дельта = дельта_вход / 700;
    конец
    дельта = дельта + дельта / число_точек;
    целое к = 0;
    пока (дельта больше 455)
        дельта = дельта / 35;
        к = к + 36;
    конец
    вернуть к + 36 * дельта / (дельта + 38);
конец

// UTF-8 -> кодовые точки
функция пуни_кодовые_точки(текст с, Список из целых т): целое
    целое п = 0;
    пока (п меньше длина(с))
        целое б = целое(байт_текста(с, п));
        если (б меньше 128)
            т.добавить(б);
            п = п + 1;
        иначе если (б меньше 224)
            т.добавить((б % 32) * 64 + целое(байт_текста(с, п + 1)) % 64);
            п = п + 2;
        иначе если (б меньше 240)
            т.добавить((б % 16) * 4096 + (целое(байт_текста(с, п + 1)) % 64) * 64 + целое(байт_текста(с, п + 2)) % 64);
            п = п + 3;
        иначе
            т.добавить((б % 8) * 262144 + (целое(байт_текста(с, п + 1)) % 64) * 4096 + (целое(байт_текста(с, п + 2)) % 64) * 64 + целое(байт_текста(с, п + 3)) % 64);
            п = п + 4;
        конец
    конец
    вернуть т.размер();
конец

функция пуникод(текст метка): текст
    Список из целых т = Список из целых();
    пуни_кодовые_точки(метка, т);
    текст вывод = "";
    целое базовых = 0;
    целое ин = 0;
    пока (ин меньше т.размер())
        если (т.получить(ин) меньше 128)
            вывод = вывод + пуни_символ(т.получить(ин));
            базовых = базовых + 1;
        конец
        ин = ин + 1;
    конец
    если (базовых больше 0)
        вывод = вывод + "-";
    конец
    целое н = 128;
    целое дельта = 0;
    целое сдвиг = 72;
    целое сделано = базовых;
    пока (сделано меньше т.размер())
        целое м = 2147483647;
        ин = 0;
        пока (ин меньше т.размер())
            если (т.получить(ин) не меньше н и т.получить(ин) меньше м)
                м = т.получить(ин);
            конец
            ин = ин + 1;
        конец
        дельта = дельта + (м - н) * (сделано + 1);
        н = м;
        ин = 0;
        пока (ин меньше т.размер())
            целое с = т.получить(ин);
            если (с меньше н)
                дельта = дельта + 1;
            конец
            если (с == н)
                целое частное = дельта;
                целое к = 36;
                целое идти = 1;
                пока (идти == 1)
                    целое порог = к - сдвиг;
                    если (к не больше сдвиг)
                        порог = 1;
                    иначе если (к не меньше сдвиг + 26)
                        порог = 26;
                    конец
                    если (частное меньше порог)
                        идти = 0;
                    иначе
                        вывод = вывод + пуни_цифра(порог + (частное - порог) % (36 - порог));
                        частное = (частное - порог) / (36 - порог);
                        к = к + 36;
                    конец
                конец
                вывод = вывод + пуни_цифра(частное);
                целое первый = 0;
                если (сделано == базовых)
                    первый = 1;
                конец
                сдвиг = пуни_адаптация(дельта, сделано + 1, первый);
                дельта = 0;
                сделано = сделано + 1;
            конец
            ин = ин + 1;
        конец
        дельта = дельта + 1;
        н = н + 1;
    конец
    вернуть вывод;
конец

функция пуни_символ(целое к): текст
    текст таблица = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~";
    результат из текста р = подстрока(таблица, к - 32, 1);
    если (р.успешно и к не меньше 32 и к меньше 127)
        вернуть р.значение;
    конец
    вернуть "";
конец

функция пуни_есть_русские(текст с): верно
    целое п = 0;
    пока (п меньше длина(с))
        если (целое(байт_текста(с, п)) не меньше 128)
            вернуть да;
        конец
        п = п + 1;
    конец
    вернуть нет;
конец

// «языксфера.рф» -> «xn--80ajfm5aev7c8a.xn--p1ai»; части без русских букв остаются как есть.
функция хост_в_пуникод(текст хост): текст
    текст итог = "";
    целое начало = 0;
    целое п = 0;
    пока (п не больше длина(хост))
        если (п == длина(хост) или целое(байт_текста(хост, п)) == 46)
            текст метка = "";
            результат из текста м = подстрока(хост, начало, п - начало);
            если (м.успешно)
                метка = м.значение;
            конец
            если (пуни_есть_русские(метка))
                итог = итог + "xn--" + пуникод(регистр_в_нижний(метка));
            иначе
                итог = итог + метка;
            конец
            если (п меньше длина(хост))
                итог = итог + ".";
            конец
            начало = п + 1;
        конец
        п = п + 1;
    конец
    вернуть итог;
конец
