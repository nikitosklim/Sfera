// файлы.код — файловые операции, которых нет среди встроенных функций.
//
// Подключается как `подключить файлы;`.
//
//   удалить_файл(путь): результат из верно     — удаляет файл (или пустую папку)
//   создать_папку(путь): результат из верно    — создаёт одну папку (родительская должна существовать)
//   файл_существует(путь): верно               — файл можно открыть для чтения
//
// Пути — в UTF-8. На Windows они переводятся в UTF-16 (обёртки из
// рантайм_windows/pthread_win.c), поэтому кириллица в путях работает.
// Если вы обновили компилятор, пересоберите pthread_win.o:
//   clang -c рантайм_windows\pthread_win.c -o "%LOCALAPPDATA%\Сфера\lib\sfera\pthread_win.o"

внешняя функция удалить_файл_сырой(текст путь): целое32 как "remove", "sfera_win_remove";
внешняя функция создать_папку_сырая(текст путь, целое32 права): целое32 как "mkdir", "sfera_win_mkdir";

функция удалить_файл(текст путь): результат из верно
    если (удалить_файл_сырой(путь) == целое32(0))
        вернуть успех(да);
    конец
    вернуть ошибка("не удалось удалить: " + путь);
конец

функция создать_папку(текст путь): результат из верно
    если (создать_папку_сырая(путь, целое32(493)) == целое32(0))
        вернуть успех(да);
    конец
    вернуть ошибка("не удалось создать папку: " + путь);
конец

функция файл_существует(текст путь): верно
    результат из целое размер = размер_файла(путь);
    вернуть размер.успешно;
конец
