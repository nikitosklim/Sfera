// задачи_х86.код — вытесняющая многозадачность для x86-64: задачи переключаются по таймеру.
//
// Подключение (после  подключить память_х86;):  подключить задачи_х86;
// Стартовый код — examples/ос/запуск_ос.s: в прерывании таймера он сохраняет всё состояние процессора
// на стеке задачи и вызывает  sfera_irq_timer(кадр): целое  — эта функция возвращает кадр той задачи,
// которая будет работать дальше. Её нужно определить в программе и вызвать в ней  задачи_переключить(кадр).
//
// Задача — обычная функция без параметров:  целое номер = задача_создать(адрес_функции(моя_задача));
// В конце задача обязана вызвать  задача_завершить();  — возвращаться из неё некуда.
// Основной поток (тот, что вызвал главную) — задача 0, она не завершается.
//
// Таблица (по адресу 0x300C00): +0 сколько мест занято, +8 номер текущей задачи;
// далее по 24 байта на задачу (всего 8): +0 сохранённый кадр, +8 состояние (0 — место свободно,
// 1 — работает, 2 — завершена), +16 адрес кадра памяти со стеком.
// Стек каждой задачи — один кадр памяти (4 КБ), поэтому глубокая рекурсия в задачах недопустима.

функция задачи_подготовить()
    писать64(0x300C00, 1);
    писать64(0x300C08, 0);
    писать64(0x300C10 + 8, 1);   // основной поток — задача 0
    целое i = 1;
    пока (i < 8)
        писать64(0x300C10 + i * 24 + 8, 0);
        i = i + 1;
    конец
конец

// Создаёт задачу, которая начнёт с функции по адресу «вход». Возвращает номер задачи или -1, если мест нет.
функция задача_создать(целое вход): целое
    целое номер = 1;
    пока (номер < 8 и читать64(0x300C10 + номер * 24 + 8) != 0)
        номер = номер + 1;
    конец
    если (номер == 8)
        вернуть 0 - 1;
    конец
    целое стек = выделить_кадр();
    если (стек == 0)
        вернуть 0 - 1;
    конец
    кадр_обнулить(стек);
    целое верх = стек + 4096;
    целое кадр = верх - 640;
    аппаратная_запись16(кадр, беззнак16(0x037F));             // управляющее слово сопроцессора
    аппаратная_запись32(кадр + 24, беззнак32(0x1F80));        // MXCSR: исключения замаскированы
    писать64(кадр + 600, вход);                               // rip
    писать64(кадр + 608, 8);                                  // cs: код ядра
    писать64(кадр + 616, 0x202);                              // rflags: прерывания разрешены
    писать64(кадр + 624, верх - 8);                           // rsp задачи
    писать64(кадр + 632, 16);                                 // ss
    писать64(0x300C10 + номер * 24, кадр);
    писать64(0x300C10 + номер * 24 + 16, стек);
    писать64(0x300C10 + номер * 24 + 8, 1);                   // последней: задача готова
    если (номер >= читать64(0x300C00))
        писать64(0x300C00, номер + 1);
    конец
    вернуть номер;
конец

// Вызывается из sfera_irq_timer: запоминает кадр текущей задачи и возвращает кадр следующей.
функция задачи_переключить(целое кадр): целое
    целое текущая = читать64(0x300C08);
    писать64(0x300C10 + текущая * 24, кадр);
    целое число = читать64(0x300C00);
    целое следующая = текущая;
    целое проверено = 0;
    пока (проверено < число)
        следующая = следующая + 1;
        если (следующая >= число)
            следующая = 0;
        конец
        если (читать64(0x300C10 + следующая * 24 + 8) == 1)
            писать64(0x300C08, следующая);
            вернуть читать64(0x300C10 + следующая * 24);
        конец
        проверено = проверено + 1;
    конец
    вернуть кадр;
конец

// Задача сообщает, что закончила. Эта функция не возвращается.
функция задача_завершить()
    разрешить_прерывания();
    писать64(0x300C10 + читать64(0x300C08) * 24 + 8, 2);
    пока (да)
        ждать_прерывание();
    конец
конец

// Состояние задачи: 0 — нет, 1 — работает, 2 — завершена.
функция задача_состояние(целое номер): целое
    вернуть читать64(0x300C10 + номер * 24 + 8);
конец

// Освобождает место и стек завершённой задачи.
функция задача_убрать(целое номер)
    если (читать64(0x300C10 + номер * 24 + 8) == 2)
        освободить_кадр(читать64(0x300C10 + номер * 24 + 16));
        писать64(0x300C10 + номер * 24 + 8, 0);
    конец
конец
