// плата_rp2040.код — «плата» Raspberry Pi Pico (RP2040): вывод символов в UART0 (GP0 — передача, GP1 — приём), 115200 бод.
//
// Подключение:  подключить плата_rp2040;  (вместе с  подключить голое_железо;)
//
// ВНИМАНИЕ: написано по описанию микросхемы, на настоящей плате НЕ ПРОВЕРЯЛОСЬ (проверяется только сборка).
// sfera_плата_старт() запускает кварцевый генератор 12 МГц, переводит на него тактирование,
// снимает со сброса GPIO и UART0 и настраивает скорость.

функция снять_сброс(целое биты)
    аппаратная_запись32(0x4000F000, беззнак32(биты));   // псевдоним «очистить биты» регистра RESETS
    пока (наложить_маску(аппаратное_чтение32(0x4000C008), беззнак32(биты)) != беззнак32(биты))
        машинная_команда("nop");
    конец
конец

функция sfera_плата_старт()
    // кварц 12 МГц
    аппаратная_запись32(0x40024000, беззнак32(0xAA0));      // XOSC CTRL: диапазон частот 1–15 МГц
    аппаратная_запись32(0x4002400C, беззнак32(47));         // время запуска
    аппаратная_запись32(0x40026000, беззнак32(0xFAB000));   // включить (псевдоним «установить биты»)
    пока (наложить_маску(аппаратное_чтение32(0x40024004), беззнак32(0x80000000)) == беззнак32(0))
        машинная_команда("nop");
    конец
    аппаратная_запись32(0x40008030, беззнак32(2));          // clk_ref ← кварц
    аппаратная_запись32(0x4000803C, беззнак32(0));          // clk_sys ← clk_ref
    аппаратная_запись32(0x40008048, беззнак32(0x800));      // clk_peri включён (от clk_sys)
    // GPIO, площадки и UART0 — со сброса
    снять_сброс(0x20 + 0x100 + 0x400000);
    аппаратная_запись32(0x40014004, беззнак32(2));          // GP0 → UART0 TX
    аппаратная_запись32(0x4001400C, беззнак32(2));          // GP1 → UART0 RX
    // 12 МГц / (16 × 115200) = 6,5104 → целая часть 6, дробная 33/64
    аппаратная_запись32(0x40034024, беззнак32(6));
    аппаратная_запись32(0x40034028, беззнак32(33));
    аппаратная_запись32(0x4003402C, беззнак32(0x70));       // 8 бит, очередь включена
    аппаратная_запись32(0x40034030, беззнак32(0x301));      // UART, передатчик и приёмник включены
конец

функция sfera_вывод_символа(целое32 символ)
    // ждём, пока в очереди передатчика появится место (бит 5 регистра флагов — «очередь полна»)
    пока (наложить_маску(аппаратное_чтение32(0x40034018), беззнак32(0x20)) != беззнак32(0))
        машинная_команда("nop");
    конец
    аппаратная_запись32(0x40034000, беззнак32(символ));
конец
