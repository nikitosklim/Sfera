// браузер.код — мост между программой на Сфере и страницей в браузере.
//
// Программа собирается в WebAssembly (--целевая-платформа wasm32-wasi --wasm-хост), а страницу
// ей даёт маленький загрузчик static/сфера-хост.js. Всё, что живёт на странице (окно, документ,
// элементы, события), программа держит как «объекты-ручки»: целое число, которое выдал загрузчик.
// Ручка 0 значит «ничего» (нет такого объекта или свойства).
//
// Пример:
//   подключить браузер;
//   функция главная(): целое
//       целое32 документ = свойство(окно(), "document");
//       целое32 заголовок = вызвать1(документ, "querySelector", в_объект_текст("h1"));
//       задать(заголовок, "textContent", в_объект_текст("Привет из Сферы"));
//       вернуть 0;
//   конец
//
// Ручки живут, пока их не сбросят: перед серией вызовов запомните метку() и по окончании
// вызовите сбросить(метка), чтобы не копить ненужные ручки в долго работающей странице.

внешняя функция х_глобал(): целое32 как "х_глобал";
внешняя функция х_св(целое32 о, текст имя): целое32 как "х_св";
внешняя функция х_уст(целое32 о, текст имя, целое32 значение): целое32 как "х_уст";
внешняя функция х_вызов(целое32 о, текст имя, целое32 первый, целое32 второй, целое32 третий): целое32 как "х_вызов";
внешняя функция х_текст(текст значение): целое32 как "х_текст";
внешняя функция х_число(дробное значение): целое32 как "х_число";
внешняя функция х_в_текст(целое32 о): текст как "х_в_текст";
внешняя функция х_в_число(целое32 о): дробное как "х_в_число";
внешняя функция х_истина(целое32 о): целое32 как "х_истина";
внешняя функция х_слушать(целое32 о, текст имя_события, текст обработчик): целое32 как "х_слушать";
внешняя функция х_каждые(целое32 мс, текст обработчик): целое32 как "х_каждые";
внешняя функция х_событие(): целое32 как "х_событие";
внешняя функция х_маяк(текст адрес, текст тело): целое32 как "х_маяк";
внешняя функция х_метка(): целое32 как "х_метка";
внешняя функция х_сбросить(целое32 метка): целое32 как "х_сбросить";

// ---- объекты страницы

функция окно(): целое32
    вернуть х_глобал();
конец

функция свойство(целое32 объект, текст имя): целое32
    вернуть х_св(объект, имя);
конец

функция задать(целое32 объект, текст имя, целое32 значение): целое
    х_уст(объект, имя, значение);
    вернуть 0;
конец

// Вызов метода объекта: вызвать0 — без аргументов, вызвать1 — с одним и так далее. Аргументы тоже ручки.
функция вызвать0(целое32 объект, текст имя): целое32
    вернуть х_вызов(объект, имя, 0, 0, 0);
конец

функция вызвать1(целое32 объект, текст имя, целое32 первый): целое32
    вернуть х_вызов(объект, имя, первый, 0, 0);
конец

функция вызвать2(целое32 объект, текст имя, целое32 первый, целое32 второй): целое32
    вернуть х_вызов(объект, имя, первый, второй, 0);
конец

функция вызвать3(целое32 объект, текст имя, целое32 первый, целое32 второй, целое32 третий): целое32
    вернуть х_вызов(объект, имя, первый, второй, третий);
конец

// ---- значения

функция в_объект_текст(текст значение): целое32
    вернуть х_текст(значение);
конец

функция в_объект_число(дробное значение): целое32
    вернуть х_число(значение);
конец

функция объект_в_текст(целое32 объект): текст
    вернуть х_в_текст(объект);
конец

функция объект_в_число(целое32 объект): дробное
    вернуть х_в_число(объект);
конец

// Истина ли значение с точки зрения страницы (не пусто, не 0, не пустая строка, не false).
функция объект_истина(целое32 объект): верно
    вернуть целое(х_истина(объект)) != 0;
конец

// ---- события и таймеры

// Подписка: при событии браузер вызовет функцию программы с таким именем (без параметров).
// Объект самого события доступен из обработчика через событие().
функция слушать(целое32 объект, текст имя_события, текст обработчик): целое
    х_слушать(объект, имя_события, обработчик);
    вернуть 0;
конец

функция каждые_мс(целое32 мс, текст обработчик): целое
    х_каждые(мс, обработчик);
    вернуть 0;
конец

функция событие(): целое32
    вернуть х_событие();
конец

// Фоновая отправка данных на сервер при закрытии страницы (navigator.sendBeacon), форма application/x-www-form-urlencoded.
функция отправить_маяк(текст адрес, текст тело): целое
    х_маяк(адрес, тело);
    вернуть 0;
конец

// ---- уборка ручек

функция метка(): целое32
    вернуть х_метка();
конец

функция сбросить(целое32 метка): целое
    х_сбросить(метка);
    вернуть 0;
конец
