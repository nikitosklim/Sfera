// браузер.код — мост между программой на Сфере и страницей в браузере.
//
// Программа собирается в WebAssembly (--целевая-платформа wasm32-wasi --wasm-хост), а страницу
// ей даёт маленький загрузчик static/сфера-хост.js. Всё, что живёт на странице (окно, документ,
// элементы, события), программа держит как «объекты-ручки»: целое число, которое выдал загрузчик.
// Ручка 0 значит «ничего» (нет такого объекта или свойства).
//
// Пример:
//   подключить браузер;
//   функция главная(): целое
//       целое32 документ = свойство(окно(), "document");
//       целое32 заголовок = вызвать1(документ, "querySelector", в_объект_текст("h1"));
//       задать(заголовок, "textContent", в_объект_текст("Привет из Сферы"));
//       вернуть 0;
//   конец
//
// Ручки живут, пока их не сбросят: перед серией вызовов запомните метку() и по окончании
// вызовите сбросить(метка), чтобы не копить ненужные ручки в долго работающей странице.

внешняя функция х_глобал(): целое32 как "х_глобал";
внешняя функция х_св(целое32 о, текст имя): целое32 как "х_св";
внешняя функция х_уст(целое32 о, текст имя, целое32 значение): целое32 как "х_уст";
внешняя функция х_вызов(целое32 о, текст имя, целое32 первый, целое32 второй, целое32 третий): целое32 как "х_вызов";
внешняя функция х_текст(текст значение): целое32 как "х_текст";
внешняя функция х_число(дробное значение): целое32 как "х_число";
внешняя функция х_в_текст(целое32 о): текст как "х_в_текст";
внешняя функция х_в_число(целое32 о): дробное как "х_в_число";
внешняя функция х_истина(целое32 о): целое32 как "х_истина";
внешняя функция х_слушать(целое32 о, текст имя_события, текст обработчик): целое32 как "х_слушать";
внешняя функция х_каждые(целое32 мс, текст обработчик): целое32 как "х_каждые";
внешняя функция х_событие(): целое32 как "х_событие";
внешняя функция х_маяк(текст адрес, текст тело): целое32 как "х_маяк";
внешняя функция х_получить(текст адрес, текст обработчик): целое32 как "х_получить";
внешняя функция х_отправить(текст адрес, текст тело, текст обработчик): целое32 как "х_отправить";
внешняя функция х_текстом(текст адрес, текст обработчик): целое32 как "х_текстом";
внешняя функция х_хеш(текст имя, текст пароль, текст обработчик): целое32 как "х_хеш";
внешняя функция х_архив(целое32 файлы, текст манифест, текст обработчик): целое32 как "х_архив";
внешняя функция х_опубликовать(текст имя, текст версия, целое32 данные, текст обработчик): целое32 как "х_опубликовать";
внешняя функция х_результат(): целое32 как "х_результат";
внешняя функция х_когда(целое32 обещание, текст обработчик): целое32 как "х_когда";
внешняя функция х_метка(): целое32 как "х_метка";
внешняя функция х_сбросить(целое32 метка): целое32 как "х_сбросить";

// ---- объекты страницы

функция окно(): целое32
    вернуть х_глобал();
конец

функция свойство(целое32 объект, текст имя): целое32
    вернуть х_св(объект, имя);
конец

функция задать(целое32 объект, текст имя, целое32 значение): целое
    х_уст(объект, имя, значение);
    вернуть 0;
конец

// Вызов метода объекта: вызвать0 — без аргументов, вызвать1 — с одним и так далее. Аргументы тоже ручки.
функция вызвать0(целое32 объект, текст имя): целое32
    вернуть х_вызов(объект, имя, 0, 0, 0);
конец

функция вызвать1(целое32 объект, текст имя, целое32 первый): целое32
    вернуть х_вызов(объект, имя, первый, 0, 0);
конец

функция вызвать2(целое32 объект, текст имя, целое32 первый, целое32 второй): целое32
    вернуть х_вызов(объект, имя, первый, второй, 0);
конец

функция вызвать3(целое32 объект, текст имя, целое32 первый, целое32 второй, целое32 третий): целое32
    вернуть х_вызов(объект, имя, первый, второй, третий);
конец

// ---- значения

функция в_объект_текст(текст значение): целое32
    вернуть х_текст(значение);
конец

функция в_объект_число(дробное значение): целое32
    вернуть х_число(значение);
конец

функция объект_в_текст(целое32 объект): текст
    вернуть х_в_текст(объект);
конец

функция объект_в_число(целое32 объект): дробное
    вернуть х_в_число(объект);
конец

// Истина ли значение с точки зрения страницы (не пусто, не 0, не пустая строка, не false).
функция объект_истина(целое32 объект): верно
    вернуть целое(х_истина(объект)) != 0;
конец

// ---- события и таймеры

// Подписка: при событии браузер вызовет функцию программы с таким именем (без параметров).
// Объект самого события доступен из обработчика через событие().
функция слушать(целое32 объект, текст имя_события, текст обработчик): целое
    х_слушать(объект, имя_события, обработчик);
    вернуть 0;
конец

функция каждые_мс(целое32 мс, текст обработчик): целое
    х_каждые(мс, обработчик);
    вернуть 0;
конец

функция событие(): целое32
    вернуть х_событие();
конец

// Фоновая отправка данных на сервер при закрытии страницы (navigator.sendBeacon), форма application/x-www-form-urlencoded.
функция отправить_маяк(текст адрес, текст тело): целое
    х_маяк(адрес, тело);
    вернуть 0;
конец

// ---- уборка ручек

функция метка(): целое32
    вернуть х_метка();
конец

функция сбросить(целое32 метка): целое
    х_сбросить(метка);
    вернуть 0;
конец

// ---- запросы к серверу
// Ответ приходит не сразу: после запроса программа продолжается в функции-обработчике (её имя передаётся
// вторым аргументом), а сам ответ там доступен через результат_запроса().

// GET адреса, ответ — разобранный JSON ({ok:false}, если сервер ответил не JSON). Заголовок X-Sfera добавляется сам.
функция получить_json(текст адрес, текст обработчик): целое
    х_получить(адрес, обработчик);
    вернуть 0;
конец

// POST с телом вида «поле=значение&…» (значения должны быть закодированы: см. кодировать()). Ответ — JSON.
функция отправить_форму(текст адрес, текст тело, текст обработчик): целое
    х_отправить(адрес, тело, обработчик);
    вернуть 0;
конец

// GET адреса, ответ — просто текст.
функция получить_текстом(текст адрес, текст обработчик): целое
    х_текстом(адрес, обработчик);
    вернуть 0;
конец

// Хеш пароля для входа: пароль не уходит на сервер. В ответе {ok, хеш} или {ok:false, ошибка}.
функция хеш_пароля(текст имя, текст пароль, текст обработчик): целое
    х_хеш(имя, пароль, обработчик);
    вернуть 0;
конец

// Когда обещание страницы (Promise) выполнится, вызвать обработчик; значение будет в результат_запроса().
функция когда_готово(целое32 обещание, текст обработчик): целое
    х_когда(обещание, обработчик);
    вернуть 0;
конец

// Собрать из выбранных файлов (массив File) архив пакета .tar.gz с манифестом пакет.сфера. В ответе {ok, данные} или {ok:false, ошибка}.
функция собрать_архив(целое32 файлы, текст манифест, текст обработчик): целое
    х_архив(файлы, манифест, обработчик);
    вернуть 0;
конец

// Опубликовать готовый архив (ArrayBuffer) пакета имя версии. В ответе JSON сервера.
функция опубликовать_архив(текст имя, текст версия, целое32 данные, текст обработчик): целое
    х_опубликовать(имя, версия, данные, обработчик);
    вернуть 0;
конец

функция результат_запроса(): целое32
    вернуть х_результат();
конец

// ---- мелочи для работы с объектами и текстом

// Пустая ручка: «ничего», чтобы позже подставить в неё найденный объект.
функция ничего(): целое32
    вернуть х_св(0, "");
конец

// Есть ли объект (ручка не нулевая).
функция есть(целое32 объект): верно
    вернуть целое(объект) != 0;
конец

// Кодирует текст для адреса и формы (encodeURIComponent).
функция кодировать(текст значение): текст
    вернуть объект_в_текст(вызвать1(окно(), "encodeURIComponent", в_объект_текст(значение)));
конец

// Элемент страницы по id (ручка 0, если такого нет).
функция элемент(текст идентификатор): целое32
    вернуть вызвать1(свойство(окно(), "document"), "getElementById", в_объект_текст(идентификатор));
конец

// Число знаков (букв), а не байтов: русская буква в UTF-8 занимает два байта.
функция знаков(текст источник): целое
    целое счёт = 0;
    целое i = 0;
    целое всего = длина(источник);
    пока (i меньше всего)
        целое б = целое(байт_текста(источник, i));
        если (б < 128 или б >= 192)
            счёт = счёт + 1;
        конец
        i = i + 1;
    конец
    вернуть счёт;
конец

// Текст без пробелов и переводов строк по краям.
функция убрать_края(текст источник): текст
    целое от = 0;
    целое до = длина(источник);
    пока (от < до и (целое(байт_текста(источник, от)) <= 32))
        от = от + 1;
    конец
    пока (до > от и (целое(байт_текста(источник, до - 1)) <= 32))
        до = до - 1;
    конец
    если (до <= от)
        вернуть "";
    конец
    вернуть подстрока_или_пусто(источник, от, до - от);
конец

функция подстрока_или_пусто(текст источник, целое от, целое размер): текст
    результат из текста часть = подстрока(источник, от, размер);
    если (часть.успешно)
        вернуть часть.значение;
    конец
    вернуть "";
конец

// Поле строки, разделённой символом (код байта): поле_через(строка, 124, 2) — третье поле при разделителе «|».
функция поле_через(текст строка, целое разделитель, целое номер): текст
    целое всего = длина(строка);
    целое k = 0;
    целое начало = 0;
    целое i = 0;
    пока (i <= всего)
        верно граница = да;
        если (i меньше всего)
            граница = целое(байт_текста(строка, i)) == разделитель;
        конец
        если (граница)
            если (k == номер)
                вернуть убрать_края(подстрока_или_пусто(строка, начало, i - начало));
            конец
            k = k + 1;
            начало = i + 1;
        конец
        i = i + 1;
    конец
    вернуть "";
конец

// Оканчивается ли текст хвостом.
функция заканчивается(текст источник, текст хвост): верно
    целое а = длина(источник);
    целое б = длина(хвост);
    если (б > а)
        вернуть нет;
    конец
    вернуть подстрока_или_пусто(источник, а - б, б) == хвост;
конец
