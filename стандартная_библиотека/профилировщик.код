// профилировщик.код — "ручной" (не автоматический) профилировщик:
// в отличие от стандартная_библиотека/трейсинг.код (который печатает
// ДЕРЕВО одного прохода выполнения, каждый спан — отдельная строка),
// профилировщик АГРЕГИРУЕТ: сколько раз был вызван именованный участок
// кода и сколько суммарно/в среднем времени он занял, за ВЕСЬ прогон
// программы — тот самый вопрос "куда уходит время", на который трейс
// одного запроса не отвечает (там десятки вызовов "прочитать_бд" дали
// бы десятки отдельных строк, а не одну с "вызовов=50, всего=120 мс").
//
// API — ровно та пара, что обсуждалась: "начать_замер(п, имя)" /
// "закончить_замер(п, имя)" (вручную расставляются вокруг измеряемого
// кода), плюс "профиль_отчёт()"/"профиль_напечатать()" для сводки.
// Выбран РУЧНОЙ вариант, а не автоматическая инструментация каждой
// функции компилятором — тот путь на порядок сложнее (нужна поддержка
// в кодогенераторе, накладные расходы на каждый вызов каждой функции
// программы) и его отдельный, гораздо больший шаг на будущее.
//
// ⚠️ Честно, узко (v1):
// - "начать_замер"/"закончить_замер" для ОДНОГО И ТОГО ЖЕ имени не
//   поддерживают ВЛОЖЕННОСТЬ/рекурсию — "начать_замер(п, "а")" дважды
//   подряд (без закончить между ними) просто молча перезапишет время
//   начала, и первый вызов "потеряется" (засчитается только внешний
//   интервал). Для вложенных по РАЗНЫМ именам участков всё работает
//   нормально — разные ключи словаря не мешают друг другу. Если нужна
//   трассировка вложенности как таковой — см. трейсинг.код (спаны),
//   он именно для этого и существует, их имеет смысл использовать
//   вместе: трейсинг — "что происходило в этом запросе и в каком
//   порядке", профилировщик — "куда суммарно ушло время за всю
//   программу".
// - "закончить_замер" без предшествующего "начать_замер" с тем же
//   именем не крашит программу — молча ничего не делает (в духе
//   "спан_завершить() без спан_начать()" из трейсинг.код, только без
//   предупреждения в журнал — тут просто некуда его писать без
//   отдельного текстового лога; если нужна диагностика таких ошибок,
//   используйте лог.код рядом).
// - Та же причина, что и в метрики.код/трейсинг.код: Словарь<Ключ,
//   Значение> не поддерживает перечисление ключей, поэтому имена
//   измеряемых участков хранятся ДВАЖДЫ — в Словаре (быстрый доступ) и
//   параллельно в Списке (порядок первого измерения — нужен только для
//   перебора при отчёте).
// - Не потокобезопасен — как и Список/Словарь/Метрики/Трейсер, один
//   Профилировщик на один поток "параллельно".

подключить трейсинг; // переиспользуем длительность_в_текст(целое) -> текст

структура Профилировщик {
    Словарь<текст, целое> времена_начала_нс;
    Словарь<текст, целое> суммарное_время_нс;
    Словарь<текст, целое> количество_вызовов;
    Список<текст> имена;
}

функция создать_профилировщик() -> Профилировщик {
    вернуть Профилировщик(
        Словарь<текст, целое>(),
        Словарь<текст, целое>(),
        Словарь<текст, целое>(),
        Список<текст>()
    );
}

// Отмечает начало измеряемого участка "имя". Можно вызывать для одного
// и того же имени многократно за всю программу (каждый новый вызов
// "начать_замер" + "закончить_замер" добавляет ещё одно измерение к
// уже накопленной статистике этого имени) — см. честные ограничения про
// вложенность/рекурсию в начале файла.
функция начать_замер(Профилировщик п, текст имя) {
    п.времена_начала_нс.положить(имя, монотонное_время_нс());
}

// Отмечает конец измеряемого участка "имя" и прибавляет прошедшее время
// к накопленной статистике. Без if-выражений в языке (только if-
// ОПЕРАТОР, не оператор-значение) накопление приходится писать через
// промежуточную переменную с значением по умолчанию, а не одной строкой.
функция закончить_замер(Профилировщик п, текст имя) {
    результат<целое> начало = п.времена_начала_нс.получить(имя);
    если (!начало.успешно) {
        вернуть; // закончить_замер() без начать_замер() — молча пропускаем
    }
    целое длительность = монотонное_время_нс() - начало.значение;

    целое новая_сумма = длительность;
    результат<целое> текущая_сумма = п.суммарное_время_нс.получить(имя);
    если (текущая_сумма.успешно) {
        новая_сумма = текущая_сумма.значение + длительность;
    }
    п.суммарное_время_нс.положить(имя, новая_сумма);

    целое новый_счёт = 1;
    результат<целое> текущий_счёт = п.количество_вызовов.получить(имя);
    если (текущий_счёт.успешно) {
        новый_счёт = текущий_счёт.значение + 1;
    } иначе {
        // первое измерение этого имени — только сейчас заводим его
        // в списке порядка перебора (см. честные ограничения выше)
        п.имена.добавить(имя);
    }
    п.количество_вызовов.положить(имя, новый_счёт);
}

функция замер_вызовов(Профилировщик п, текст имя) -> целое {
    результат<целое> счёт = п.количество_вызовов.получить(имя);
    если (счёт.успешно) {
        вернуть счёт.значение;
    }
    вернуть 0;
}

функция замер_всего_нс(Профилировщик п, текст имя) -> целое {
    результат<целое> сумма = п.суммарное_время_нс.получить(имя);
    если (сумма.успешно) {
        вернуть сумма.значение;
    }
    вернуть 0;
}

// Сводный текстовый отчёт по всем измеренным участкам, в порядке их
// ПЕРВОГО измерения (не по убыванию времени — сортировки в языке пока
// нет; самый затратный участок приходится искать глазами по колонке
// "всего", как в первом черновике metrics-снимка).
функция профиль_отчёт(Профилировщик п) -> текст {
    текст отчёт = "";
    целое i = 0;
    пока (i < п.имена.размер()) {
        текст имя = п.имена.получить(i);
        целое счёт = замер_вызовов(п, имя);
        целое сумма = замер_всего_нс(п, имя);
        целое среднее = сумма / счёт;
        отчёт = отчёт + имя + ": вызовов=" + целое_в_текст(счёт)
            + ", всего=" + длительность_в_текст(сумма)
            + ", среднее=" + длительность_в_текст(среднее) + "\n";
        i = i + 1;
    }
    вернуть отчёт;
}

функция профиль_напечатать(Профилировщик п) {
    вывести(профиль_отчёт(п));
}
