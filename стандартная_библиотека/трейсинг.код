// трейсинг.код — третий (и последний из первоначально задуманных) кирпич
// системы наблюдаемости языка, после стандартная_библиотека/лог.код и
// стандартная_библиотека/метрики.код — "спаны" (span, размеченные по
// времени участки выполнения, вложенные друг в друга, как скобки), с
// человекочитаемым деревом-снимком длительностей.
//
// Модель — та же, что в реальных системах трассировки (OpenTelemetry,
// Jaeger, Zipkin, "flame graph"): "спан_начать(имя)" отмечает вход в
// именованный участок кода, "спан_завершить()" — выход из него;
// длительность и вложенность считаются автоматически.
//
// ⚠️ Честно, узко (v1):
// - Спаны ОБЯЗАНЫ закрываться в строго обратном порядке открытия — как
//   скобки ("(а(б)в)" законно, "(а(б)в" или перекрёстное "(а[б)в]" — нет).
//   "спан_завершить()" не принимает имя и не проверяет, ЧТО именно
//   закрывается — только "самый последний из открытых". Для честной,
//   надёжной трассировки произвольных (в том числе асинхронных,
//   параллельных или неправильно вложенных) участков понадобился бы
//   отдельный span_id/родитель, как в OpenTelemetry — сознательно
//   отложено, вместе с настоящим трейсингом между потоками "параллельно"
//   и между процессами по сети (у OpenTelemetry для этого есть отдельный
//   протокол передачи контекста — здесь его пока нет).
// - Один "Трейсер" — это один линейный, синхронный поток выполнения
//   (call stack). Для трассировки нескольких потоков "параллельно"
//   заводите отдельный "Трейсер" на поток — общий на все потоки был бы
//   гонкой данных (Трейсер, как и Список/Словарь, не потокобезопасен,
//   тот же принцип, что и везде в языке).
// - Нет отправки данных куда-либо по сети (тот самый настоящий
//   "распределённый" трейсинг между сервисами) — только локальный,
//   человекочитаемый текстовый снимок одного процесса. Естественный
//   следующий шаг — как и с метрики_снимок(), отдать этот же текст по
//   HTTP поверх стандартная_библиотека/сеть.код.
// - "спан_завершить()" без соответствующего "спан_начать()" не крашит
//   программу (в духе честного лога ошибок, а не тихого отказа) —
//   вместо этого в журнал попадает явная строка-предупреждение, чтобы
//   ошибку было видно в самом снимке, а не только гадать по коду.

// Раскладывает наносекунды на целые миллисекунды и дробную часть, гораздо
// точнее секунды (которую даёт юникс_время() из лог.код) — почти любой
// спан короче секунды, секундной точности для трассировки не хватило бы
// вообще ни на что.
функция дополнить_нулями_три(целое число) -> текст {
    если (число < 10) {
        вернуть "00" + целое_в_текст(число);
    }
    если (число < 100) {
        вернуть "0" + целое_в_текст(число);
    }
    вернуть целое_в_текст(число);
}

// "12345678" наносекунд -> "12.345 мс" — целочисленная арифметика,
// намеренно без перевода в дробное число (в языке нет прямого способа
// привести целое к дробному одним выражением — арифметика допускает
// смешивание типов только через полностью одинаковый тип у обеих
// сторон, см. ДОКУМЕНТАЦИЯ_ЯЗЫКА.md), да и незачем: результат всё равно
// печатается текстом, а не используется дальше как число.
функция длительность_в_текст(целое наносекунды) -> текст {
    целое мс_целых = наносекунды / 1000000;
    целое остаток_нс = наносекунды % 1000000;
    целое мс_дробь = остаток_нс / 1000;
    вернуть целое_в_текст(мс_целых) + "." + дополнить_нулями_три(мс_дробь) + " мс";
}

функция отступ(целое глубина) -> текст {
    текст итог = "";
    целое i = 0;
    пока (i < глубина) {
        итог = итог + "  ";
        i = i + 1;
    }
    вернуть итог;
}

структура Трейсер {
    // Стек ОТКРЫТЫХ (ещё не завершённых) спанов — параллельные списки
    // вместо Список<Спан> из структур: тот же приём, что уже применён в
    // метрики.код для "имена_счётчиков"/"имена_измерителей" (там —
    // из-за отсутствия перечисления ключей Словаря, здесь — просто
    // самый простой рабочий вариант, без структуры-элемента списка).
    Список<текст> активные_имена;
    Список<целое> активные_начала_нс;
    // Уже ЗАВЕРШЁННЫЕ спаны, отформатированные в дерево по мере закрытия
    // — не Список<Спан>, а сразу готовый, накопленный текст: снимок это
    // и есть журнал целиком, отдельный шаг "собрать снимок из списка"
    // просто не нужен.
    текст журнал;
}

функция создать_трейсер() -> Трейсер {
    вернуть Трейсер(Список<текст>(), Список<целое>(), "");
}

// Отмечает вход в именованный участок кода — обязательно должен быть
// закрыт РОВНО одним последующим спан_завершить() (см. честные
// ограничения в начале файла про порядок скобок).
функция спан_начать(Трейсер т, текст имя) {
    т.активные_имена.добавить(имя);
    т.активные_начала_нс.добавить(монотонное_время_нс());
}

// Закрывает САМЫЙ ПОСЛЕДНИЙ из открытых спанов (не обязательно указывать
// его имя — как и закрывающая скобка не говорит, какая открывающая ей
// соответствует, порядок сам это определяет).
функция спан_завершить(Трейсер т) {
    целое открыто = т.активные_имена.размер();
    если (открыто == 0) {
        т.журнал = т.журнал + "⚠️ спан_завершить() без соответствующего спан_начать()\n";
        вернуть;
    }

    целое глубина = открыто - 1;
    текст имя = т.активные_имена.получить(глубина);
    целое начало = т.активные_начала_нс.получить(глубина);
    целое длительность = монотонное_время_нс() - начало;

    т.активные_имена.удалить(глубина);
    т.активные_начала_нс.удалить(глубина);

    т.журнал = т.журнал + отступ(глубина) + имя + ": " + длительность_в_текст(длительность) + "\n";
}

// Текстовый снимок ВСЕХ уже завершённых спанов, деревом, в порядке
// закрытия (вложенные спаны печатаются с отступом от родителя — тем же
// способом, каким flame graph показывает "что вызывало что"). Спаны,
// которые ещё ОТКРЫТЫ на момент вызова (ещё не дошли до
// спан_завершить()), в снимок не попадают — снимок это история уже
// случившегося, а не то, что происходит прямо сейчас.
функция трейс_снимок(Трейсер т) -> текст {
    вернуть т.журнал;
}

функция трейс_напечатать(Трейсер т) {
    вывести(трейс_снимок(т));
}

// Сбрасывает накопленный журнал завершённых спанов (например, между
// запросами HTTP-сервера, чтобы каждый снимок показывал только один
// запрос, а не растущую историю всех подряд). Намеренно НЕ трогает
// список ещё ОТКРЫТЫХ спанов — если на момент вызова что-то ещё не
// закрыто, это остаётся открытым и допишется в журнал при закрытии как
// обычно, уже после сброса.
функция трейс_очистить(Трейсер т) {
    т.журнал = "";
}

// Перезаписывает файл целиком уже накопленным журналом — та же причина
// и то же честное объяснение, что и у метрики_записать_файл: вызывающий
// код сам решает, КОГДА считать снимок завершённым (обычно — вызовом
// трейс_очистить() сразу после записи), поэтому дозапись без разбора
// привела бы либо к дублированию, либо к путанице о том, что уже
// записано, а что нет.
функция трейс_записать_файл(Трейсер т, текст путь_к_файлу) -> результат<верно> {
    вернуть записать_файл(путь_к_файлу, трейс_снимок(т));
}
