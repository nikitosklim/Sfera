// почта_отправка.код — сборка и отправка писем (протокол «SMTP», по-русски «отправка»).
//
// Подключается как "подключить почта_отправка;". Нужна сборка с
//   --линковать ssl --линковать crypto
//
//   собрать_письмо(от_имя, от_адрес, кому, тема, тело, вложения): текст
//   отправить_письмо(узел, порт, файл_доверия, имя, пароль, от_адрес, кому, письмо): результат из верного
//
// «кому» — адреса через запятую: «a@b.ru, Борис <boris@c.ru>». Русские буквы в теме,
// имени отправителя, теле и именах вложений кодируются автоматически. Тело письма —
// всегда UTF-8. Адреса с русскими буквами (почта@языксфера.рф) допустимы: серверу
// сообщается о расширении «SMTPUTF8». Порт защищённой отправки — 465 (соединение
// защищено с первого байта). Латинские слова протокола (EHLO, AUTH) живут только
// внутри строк этого файла.

подключить почта_защита;
подключить почта_письмо;
подключить почта_файлы;
подключить время;

// ---------------------------------------------------------------- заголовки

функция только_латиница(текст т): верно
    целое n = длина(т)
    целое i = 0
    пока (i < n)
        если (целое(байт_текста(т, i)) >= 128)
            вернуть нет
        конец
        i = i + 1
    конец
    вернуть да
конец

// Кодирует значение заголовка с русскими буквами в «слова» =?UTF-8?B?…?= (по ≤ 42 байта, не разрывая буквы).
функция закодировать_заголовок(текст т): текст
    если (только_латиница(т))
        вернуть т
    конец
    текст итог = ""
    целое n = длина(т)
    целое от = 0
    пока (от < n)
        целое до = от + 42
        если (до >= n)
            до = n
        иначе
            // не разрывать букву: байты продолжения имеют вид 10xxxxxx (128…191)
            пока (до > от и целое(байт_текста(т, до)) >= 128 и целое(байт_текста(т, до)) < 192)
                до = до - 1
            конец
        конец
        текст кусок = часть(т, от, до - от)
        если (длина(итог) > 0)
            итог = итог + "\r\n "
        конец
        итог = итог + "=?UTF-8?B?" + кодировать_б64(кусок) + "?="
        от = до
    конец
    вернуть итог
конец

// «Имя <адрес>» с закодированным именем. Пустое имя — просто адрес.
функция адрес_с_именем(текст имя, текст адрес): текст
    если (длина(обрезать(имя)) == 0)
        вернуть адрес
    конец
    вернуть закодировать_заголовок(обрезать(имя)) + " <" + адрес + ">"
конец

// Поле «Кому»: имена с русскими буквами кодируются, адреса остаются как есть.
функция заголовок_адресов(текст кому): текст
    текст итог = ""
    целое n = длина(кому)
    целое от = 0
    целое i = 0
    пока (i <= n)
        верно конец_слова = i == n
        если ( не конец_слова)
            целое б = целое(байт_текста(кому, i))
            конец_слова = б == 44 или б == 59
        конец
        если (конец_слова)
            текст кусок = обрезать(часть(кому, от, i - от))
            если (длина(кусок) > 0)
                целое л = найти_от(кусок, "<", 0)
                текст запись = кусок
                если (л > 0)
                    текст имя = обрезать(часть(кусок, 0, л))
                    запись = закодировать_заголовок(имя) + " " + часть(кусок, л, длина(кусок))
                конец
                если (длина(итог) > 0)
                    итог = итог + ", "
                конец
                итог = итог + запись
            конец
            от = i + 1
        конец
        i = i + 1
    конец
    вернуть итог
конец

функция слово_из_списка(текст т, текст список, целое номер): текст
    вернуть часть(список, номер * 3, 3)
конец

// Дата для заголовка Date: «Wed, 25 Nov 2026 17:12:31 +0000» (всегда по всемирному времени).
функция дата_письма(): текст
    целое сек = юникс_время()
    ДатаВремя дв = время_из_юникса(сек)
    текст дни = "MonTueWedThuFriSatSun"
    текст месяцы = "JanFebMarAprMayJunJulAugSepOctNovDec"
    вернуть слово_из_списка("", дни, день_недели(сек) - 1) + ", " + целое_в_текст(дв.день) + " " + слово_из_списка("", месяцы, дв.месяц - 1) + " " + целое_в_текст(дв.год) + " " + дополнить_нулём(дв.час) + ":" + дополнить_нулём(дв.минута) + ":" + дополнить_нулём(дв.секунда) + " +0000"
конец

целое счётчик_писем = 0

функция уникальная_метка(): текст
    счётчик_писем = счётчик_писем + 1
    вернуть целое_в_текст(юникс_время()) + "." + целое_в_текст(счётчик_писем)
конец

// Часть адреса после «@» (для Message-ID). Нет «@» — «localhost».
функция домен_адреса(текст адрес): текст
    целое п = найти_от(адрес, "@", 0)
    если (п < 0)
        вернуть "sfera.invalid"
    конец
    текст домен = часть(адрес, п + 1, длина(адрес))
    если ( не только_латиница(домен))
        вернуть "sfera.invalid"
    конец
    вернуть домен
конец

// Имя вложения по RFC 2231: байты UTF-8 в виде %XX.
функция процентами(текст т): текст
    текст цифры = "0123456789ABCDEF"
    текст итог = ""
    целое n = длина(т)
    целое i = 0
    пока (i < n)
        целое б = целое(байт_текста(т, i))
        если ((б >= 48 и б <= 57) или (б >= 65 и б <= 90) или (б >= 97 и б <= 122) или б == 46 или б == 45 или б == 95)
            итог = итог + часть(т, i, 1)
        иначе
            итог = итог + "%" + часть(цифры, б / 16, 1) + часть(цифры, б % 16, 1)
        конец
        i = i + 1
    конец
    вернуть итог
конец

// ---------------------------------------------------------------- сборка письма

// Собирает полный текст письма. вложения — список «Вложение» (имя, тип, адрес данных, размер).
функция собрать_письмо(текст от_имя, текст от_адрес, текст кому, текст тема, текст тело, Список из Вложение вложения): текст
    текст п = "From: " + адрес_с_именем(от_имя, от_адрес) + "\r\n"
    п = п + "To: " + заголовок_адресов(кому) + "\r\n"
    п = п + "Subject: " + закодировать_заголовок(тема) + "\r\n"
    п = п + "Date: " + дата_письма() + "\r\n"
    п = п + "Message-ID: <" + уникальная_метка() + "@" + домен_адреса(от_адрес) + ">\r\n"
    п = п + "MIME-Version: 1.0\r\n"
    текст тело_закодировано = кодировать_б64_байты(адрес_текста(тело), длина(тело), 76)
    если (вложения.размер() == 0)
        п = п + "Content-Type: text/plain; charset=utf-8\r\n"
        п = п + "Content-Transfer-Encoding: base64\r\n\r\n"
        п = п + тело_закодировано + "\r\n"
        вернуть п
    конец
    текст граница = "sfera-" + уникальная_метка()
    п = п + "Content-Type: multipart/mixed; boundary=\"" + граница + "\"\r\n\r\n"
    п = п + "--" + граница + "\r\n"
    п = п + "Content-Type: text/plain; charset=utf-8\r\n"
    п = п + "Content-Transfer-Encoding: base64\r\n\r\n"
    п = п + тело_закодировано + "\r\n"
    для каждого вл в вложения
        текст тип = вл.тип
        если (длина(тип) == 0)
            тип = "application/octet-stream"
        конец
        если (начинается_с(тип, "text/") и найти_от(тип, "charset", 0) < 0)
            тип = тип + "; charset=utf-8"
        конец
        текст поле_имени = "name=\"" + вл.имя + "\""
        текст поле_файла = "filename=\"" + вл.имя + "\""
        если ( не только_латиница(вл.имя))
            поле_имени = "name*=UTF-8''" + процентами(вл.имя)
            поле_файла = "filename*=UTF-8''" + процентами(вл.имя)
        конец
        п = п + "--" + граница + "\r\n"
        п = п + "Content-Type: " + тип + "; " + поле_имени + "\r\n"
        п = п + "Content-Disposition: attachment; " + поле_файла + "\r\n"
        п = п + "Content-Transfer-Encoding: base64\r\n\r\n"
        п = п + кодировать_б64_байты(вл.адрес, вл.размер, 76) + "\r\n"
    конец
    п = п + "--" + граница + "--\r\n"
    вернуть п
конец

// ---------------------------------------------------------------- отправка

// Адреса из строки «a@b.ru, Борис <boris@c.ru>; d@e.ru» → список чистых адресов.
функция разобрать_адреса(текст т): Список из текстов
    Список из текстов итог = Список из текстов()
    целое n = длина(т)
    целое от = 0
    целое i = 0
    пока (i <= n)
        верно конец_слова = i == n
        если ( не конец_слова)
            целое б = целое(байт_текста(т, i))
            конец_слова = б == 44 или б == 59
        конец
        если (конец_слова)
            текст кусок = обрезать(часть(т, от, i - от))
            целое л = найти_от(кусок, "<", 0)
            целое пр = найти_от(кусок, ">", 0)
            если (л >= 0 и пр > л)
                кусок = обрезать(часть(кусок, л + 1, пр - л - 1))
            конец
            если (длина(кусок) > 0)
                итог.добавить(кусок)
            конец
            от = i + 1
        конец
        i = i + 1
    конец
    вернуть итог
конец

// Читает ответ сервера целиком (строки вида «250-…» продолжаются) и возвращает последнюю строку.
функция ответ_сервера(целое д): текст
    пока (да)
        текст строка = защита_прочитать_строку(д)
        если (длина(строка) < 4)
            вернуть строка
        конец
        если (целое(байт_текста(строка, 3)) != 45)
            вернуть строка
        конец
    конец
    вернуть ""
конец

// Отправляет команду и проверяет, что ответ начинается с нужного кода.
функция команда_отправки(целое д, текст команда, текст код): результат из верного
    если (защита_отправить(д, команда + "\r\n") < 1)
        вернуть ошибка("не удалось отправить данные серверу")
    конец
    текст ответ = ответ_сервера(д)
    если ( не начинается_с(ответ, код))
        вернуть ошибка("сервер ответил: " + ответ)
    конец
    вернуть успех(да)
конец

// Экранирует строки, начинающиеся с точки (правило протокола: «.» → «..»).
функция экранировать_точки(текст т): текст
    текст итог = т
    если (начинается_с(итог, "."))
        итог = "." + итог
    конец
    целое позиция = найти_от(итог, "\r\n.", 0)
    пока (позиция >= 0)
        итог = часть(итог, 0, позиция + 3) + "." + часть(итог, позиция + 3, длина(итог))
        позиция = найти_от(итог, "\r\n.", позиция + 4)
    конец
    вернуть итог
конец

функция отправить_письмо(текст узел, целое порт, текст файл_доверия, текст имя, текст пароль, текст от_адрес, текст кому, текст письмо): результат из верного
    Список из текстов получатели = разобрать_адреса(кому)
    если (получатели.размер() == 0)
        вернуть ошибка("не указан получатель")
    конец
    целое д = защита_открыть(узел, порт, файл_доверия)
    если (д == 0)
        вернуть ошибка("не удалось установить защищённое соединение с сервером отправки")
    конец
    текст приветствие = ответ_сервера(д)
    если ( не начинается_с(приветствие, "220"))
        защита_закрыть(д)
        вернуть ошибка("сервер не ответил приветствием: " + приветствие)
    конец
    результат из верного р = команда_отправки(д, "EHLO sfera-client", "250")
    если ( не р.успешно)
        защита_закрыть(д)
        вернуть р
    конец
    // вход: имя и пароль, разделённые нулевыми байтами, в основании 64
    целое ни = длина(имя)
    целое нп = длина(пароль)
    текст буфер = выделить_память(ни + нп + 16)
    записать_байт(буфер, 0, 0)
    скопировать_память(указатель_по_адресу(адрес_текста(буфер) + 1), имя, ни)
    записать_байт(буфер, 1 + ни, 0)
    скопировать_память(указатель_по_адресу(адрес_текста(буфер) + 2 + ни), пароль, нп)
    текст учётные_данные = кодировать_б64_байты(адрес_текста(буфер), ни + нп + 2, 0)
    освободить_память(буфер)
    р = команда_отправки(д, "AUTH PLAIN " + учётные_данные, "235")
    если ( не р.успешно)
        защита_закрыть(д)
        вернуть ошибка("вход не удался: " + р.сообщение)
    конец
    текст расширение = ""
    если ( не только_латиница(от_адрес))
        расширение = " SMTPUTF8"
    конец
    р = команда_отправки(д, "MAIL FROM:<" + от_адрес + ">" + расширение, "250")
    если ( не р.успешно)
        защита_закрыть(д)
        вернуть р
    конец
    для каждого адр в получатели
        р = команда_отправки(д, "RCPT TO:<" + адр + ">", "25")
        если ( не р.успешно)
            защита_закрыть(д)
            вернуть ошибка("получатель " + адр + " отклонён: " + р.сообщение)
        конец
    конец
    р = команда_отправки(д, "DATA", "354")
    если ( не р.успешно)
        защита_закрыть(д)
        вернуть р
    конец
    если (защита_отправить(д, экранировать_точки(письмо) + "\r\n.\r\n") < 1)
        защита_закрыть(д)
        вернуть ошибка("не удалось передать письмо")
    конец
    текст итог = ответ_сервера(д)
    если ( не начинается_с(итог, "250"))
        защита_закрыть(д)
        вернуть ошибка("сервер не принял письмо: " + итог)
    конец
    защита_отправить(д, "QUIT\r\n")
    защита_закрыть(д)
    вернуть успех(да)
конец
