// дробные_программно.код — программная арифметика для процессоров без сопроцессора (RISC-V rv32im, ARM Cortex-M0/M0+/M3, …).
//
// Когда в программе есть дробные числа (дробное, 64 бита), а у процессора нет команд для них,
// компилятор вызывает вспомогательные функции с «служебными» именами (__adddf3, __muldf3, …).
// Здесь они написаны на самой Сфере: числа обрабатываются как набор битов (знак, порядок, мантисса).
//
// Подключение:  подключить дробные_программно;
//
// Что есть: сложение, вычитание, умножение, деление, сравнения, перевод целых (32 и 64 бита) в дробные
// и обратно; 64-битное целочисленное умножение, деление и остаток для 32-битных процессоров.
// Округление — к ближайшему чётному, как в IEEE 754.
//
// ⚠️ Честные ограничения: денормализованные числа (меньше примерно 2.2e-308) приравниваются к нулю;
// содержимое «нечисла» (NaN) не сохраняется — результат всегда один и тот же «тихий» NaN;
// исключения и режимы округления не поддержаны.

функция мд_нечисло(): беззнак64
    вернуть беззнак64(0x7FF8000000000000);
конец

функция мд_бесконечность(беззнак64 знак): беззнак64
    вернуть (знак << беззнак64(63)) | беззнак64(0x7FF0000000000000);
конец

// Собирает число из знака (0 или 1), порядка и мантиссы. Мантисса приходит с тремя лишними младшими
// битами (охранный, округляющий, «липкий»), старший бит стоит на позиции 55. Округляет к ближайшему чётному.
функция мд_собрать(беззнак64 знак, целое порядок, беззнак64 мантисса): беззнак64
    беззнак64 один = беззнак64(1);
    беззнак64 ноль = беззнак64(0);
    беззнак64 лишние = мантисса & беззнак64(7);
    беззнак64 м = мантисса >> беззнак64(3);
    целое п = порядок;
    если (лишние > беззнак64(4) или (лишние == беззнак64(4) и (м & один) == один))
        м = м + один;
        если ((м >> беззнак64(53)) != ноль)
            м = м >> один;
            п = п + 1;
        конец
    конец
    если (п >= 2047)
        вернуть мд_бесконечность(знак);
    конец
    если (п <= 0)
        вернуть знак << беззнак64(63);
    конец
    вернуть (знак << беззнак64(63)) | (беззнак64(п) << беззнак64(52)) | (м & ((один << беззнак64(52)) - один));
конец

функция мд_порядок(беззнак64 х): целое
    вернуть целое((х >> беззнак64(52)) & беззнак64(2047));
конец

функция мд_дробная_часть(беззнак64 х): беззнак64
    вернуть х & ((беззнак64(1) << беззнак64(52)) - беззнак64(1));
конец

// ---------- сложение ----------

функция мд_сложить(беззнак64 а, беззнак64 б): беззнак64
    беззнак64 ноль = беззнак64(0);
    беззнак64 один = беззнак64(1);
    целое еа = мд_порядок(а);
    целое еб = мд_порядок(б);
    беззнак64 ма = мд_дробная_часть(а);
    беззнак64 мб = мд_дробная_часть(б);
    беззнак64 знак_а = а >> беззнак64(63);
    беззнак64 знак_б = б >> беззнак64(63);
    если (еа == 2047)
        если (ма != ноль)
            вернуть мд_нечисло();
        конец
        если (еб == 2047 и (мб != ноль или знак_а != знак_б))
            вернуть мд_нечисло();
        конец
        вернуть а;
    конец
    если (еб == 2047)
        если (мб != ноль)
            вернуть мд_нечисло();
        конец
        вернуть б;
    конец
    если (еа == 0 и еб == 0)
        вернуть (знак_а & знак_б) << беззнак64(63);
    конец
    если (еа == 0)
        вернуть б;
    конец
    если (еб == 0)
        вернуть а;
    конец
    ма = (ма | (один << беззнак64(52))) << беззнак64(3);
    мб = (мб | (один << беззнак64(52))) << беззнак64(3);
    // слева — число с большим модулем
    если (еб > еа или (еб == еа и мб > ма))
        беззнак64 т = ма;
        ма = мб;
        мб = т;
        целое те = еа;
        еа = еб;
        еб = те;
        беззнак64 тз = знак_а;
        знак_а = знак_б;
        знак_б = тз;
    конец
    целое разница = еа - еб;
    если (разница >= 64)
        если (мб != ноль)
            мб = один;
        конец
    иначе
        если (разница > 0)
            беззнак64 потеряно = мб & ((один << беззнак64(разница)) - один);
            мб = мб >> беззнак64(разница);
            если (потеряно != ноль)
                мб = мб | один;
            конец
        конец
    конец
    целое е = еа;
    беззнак64 м = ноль;
    если (знак_а == знак_б)
        м = ма + мб;
    иначе
        м = ма - мб;
    конец
    если (м == ноль)
        вернуть ноль;
    конец
    если ((м >> беззнак64(56)) != ноль)
        беззнак64 хвост = м & один;
        м = (м >> один) | хвост;
        е = е + 1;
    иначе
        пока ((м >> беззнак64(55)) == ноль)
            м = м << один;
            е = е - 1;
        конец
    конец
    вернуть мд_собрать(знак_а, е, м);
конец

функция __adddf3(беззнак64 а, беззнак64 б): беззнак64
    вернуть мд_сложить(а, б);
конец

функция __subdf3(беззнак64 а, беззнак64 б): беззнак64
    вернуть мд_сложить(а, б ^ (беззнак64(1) << беззнак64(63)));
конец

// ---------- умножение ----------

функция мд_умножить(беззнак64 а, беззнак64 б): беззнак64
    беззнак64 ноль = беззнак64(0);
    беззнак64 один = беззнак64(1);
    целое еа = мд_порядок(а);
    целое еб = мд_порядок(б);
    беззнак64 ма = мд_дробная_часть(а);
    беззнак64 мб = мд_дробная_часть(б);
    беззнак64 знак = (а ^ б) >> беззнак64(63);
    если (еа == 2047 или еб == 2047)
        если ((еа == 2047 и ма != ноль) или (еб == 2047 и мб != ноль))
            вернуть мд_нечисло();
        конец
        если (еа == 0 или еб == 0)
            вернуть мд_нечисло();
        конец
        вернуть мд_бесконечность(знак);
    конец
    если (еа == 0 или еб == 0)
        вернуть знак << беззнак64(63);
    конец
    ма = ма | (один << беззнак64(52));
    мб = мб | (один << беззнак64(52));
    беззнак64 маска32 = беззнак64(0xFFFFFFFF);
    беззнак64 а_низ = ма & маска32;
    беззнак64 а_верх = ма >> беззнак64(32);
    беззнак64 б_низ = мб & маска32;
    беззнак64 б_верх = мб >> беззнак64(32);
    беззнак64 п0 = а_низ * б_низ;
    беззнак64 п1 = а_верх * б_низ;
    беззнак64 п2 = а_низ * б_верх;
    беззнак64 п3 = а_верх * б_верх;
    беззнак64 середина = п1 + п2;
    беззнак64 нижняя = п0 + (середина << беззнак64(32));
    беззнак64 перенос = ноль;
    если (нижняя < п0)
        перенос = один;
    конец
    беззнак64 верхняя = п3 + (середина >> беззнак64(32)) + перенос;
    беззнак64 м = (верхняя << беззнак64(15)) | (нижняя >> беззнак64(49));
    если ((нижняя & ((один << беззнак64(49)) - один)) != ноль)
        м = м | один;
    конец
    целое е = еа + еб - 1023;
    если ((м >> беззнак64(56)) != ноль)
        м = (м >> один) | (м & один);
        е = е + 1;
    конец
    вернуть мд_собрать(знак, е, м);
конец

функция __muldf3(беззнак64 а, беззнак64 б): беззнак64
    вернуть мд_умножить(а, б);
конец

// ---------- деление ----------

функция мд_разделить(беззнак64 а, беззнак64 б): беззнак64
    беззнак64 ноль = беззнак64(0);
    беззнак64 один = беззнак64(1);
    целое еа = мд_порядок(а);
    целое еб = мд_порядок(б);
    беззнак64 ма = мд_дробная_часть(а);
    беззнак64 мб = мд_дробная_часть(б);
    беззнак64 знак = (а ^ б) >> беззнак64(63);
    если ((еа == 2047 и ма != ноль) или (еб == 2047 и мб != ноль))
        вернуть мд_нечисло();
    конец
    если (еа == 2047)
        если (еб == 2047)
            вернуть мд_нечисло();
        конец
        вернуть мд_бесконечность(знак);
    конец
    если (еб == 2047)
        вернуть знак << беззнак64(63);
    конец
    если (еб == 0)
        если (еа == 0)
            вернуть мд_нечисло();
        конец
        вернуть мд_бесконечность(знак);
    конец
    если (еа == 0)
        вернуть знак << беззнак64(63);
    конец
    ма = ма | (один << беззнак64(52));
    мб = мб | (один << беззнак64(52));
    целое е = еа - еб + 1023;
    беззнак64 остаток = ма;
    если (ма < мб)
        остаток = ма << один;
        е = е - 1;
    конец
    беззнак64 частное = ноль;
    целое шаг = 0;
    пока (шаг < 56)
        частное = частное << один;
        если (остаток >= мб)
            остаток = остаток - мб;
            частное = частное | один;
        конец
        остаток = остаток << один;
        шаг = шаг + 1;
    конец
    если (остаток != ноль)
        частное = частное | один;
    конец
    вернуть мд_собрать(знак, е, частное);
конец

функция __divdf3(беззнак64 а, беззнак64 б): беззнак64
    вернуть мд_разделить(а, б);
конец

// ---------- сравнения ----------

// -1 (а меньше), 0 (равны), 1 (а больше), 2 (сравнить нельзя: есть NaN)
функция мд_сравнить(беззнак64 а, беззнак64 б): целое
    беззнак64 ноль = беззнак64(0);
    беззнак64 один = беззнак64(1);
    если ((мд_порядок(а) == 2047 и мд_дробная_часть(а) != ноль) или (мд_порядок(б) == 2047 и мд_дробная_часть(б) != ноль))
        вернуть 2;
    конец
    если ((а << один) == ноль и (б << один) == ноль)
        вернуть 0;
    конец
    беззнак64 бит_знака = один << беззнак64(63);
    беззнак64 ка = а | бит_знака;
    беззнак64 кб = б | бит_знака;
    если ((а >> беззнак64(63)) == один)
        ка = а ^ (ноль - один);
    конец
    если ((б >> беззнак64(63)) == один)
        кб = б ^ (ноль - один);
    конец
    если (ка < кб)
        вернуть 0 - 1;
    конец
    если (ка > кб)
        вернуть 1;
    конец
    вернуть 0;
конец

функция __eqdf2(беззнак64 а, беззнак64 б): целое32
    если (мд_сравнить(а, б) == 0)
        вернуть целое32(0);
    конец
    вернуть целое32(1);
конец

функция __nedf2(беззнак64 а, беззнак64 б): целое32
    вернуть __eqdf2(а, б);
конец

функция __ltdf2(беззнак64 а, беззнак64 б): целое32
    если (мд_сравнить(а, б) == 0 - 1)
        вернуть целое32(0) - целое32(1);
    конец
    вернуть целое32(1);
конец

функция __ledf2(беззнак64 а, беззнак64 б): целое32
    целое р = мд_сравнить(а, б);
    если (р == 0 - 1)
        вернуть целое32(0) - целое32(1);
    конец
    если (р == 0)
        вернуть целое32(0);
    конец
    вернуть целое32(1);
конец

функция __gtdf2(беззнак64 а, беззнак64 б): целое32
    если (мд_сравнить(а, б) == 1)
        вернуть целое32(1);
    конец
    вернуть целое32(0) - целое32(1);
конец

функция __gedf2(беззнак64 а, беззнак64 б): целое32
    целое р = мд_сравнить(а, б);
    если (р == 1)
        вернуть целое32(1);
    конец
    если (р == 0)
        вернуть целое32(0);
    конец
    вернуть целое32(0) - целое32(1);
конец

функция __unorddf2(беззнак64 а, беззнак64 б): целое32
    если (мд_сравнить(а, б) == 2)
        вернуть целое32(1);
    конец
    вернуть целое32(0);
конец

// ---------- целые ↔ дробные ----------

// модуль m со знаком → число
функция мд_из_модуля(беззнак64 знак, беззнак64 модуль): беззнак64
    беззнак64 ноль = беззнак64(0);
    беззнак64 один = беззнак64(1);
    если (модуль == ноль)
        вернуть ноль;
    конец
    целое п = 63;
    пока (((модуль >> беззнак64(п)) & один) == ноль)
        п = п - 1;
    конец
    беззнак64 м = модуль;
    если (п > 55)
        беззнак64 потеряно = м & ((один << беззнак64(п - 55)) - один);
        м = м >> беззнак64(п - 55);
        если (потеряно != ноль)
            м = м | один;
        конец
    иначе
        м = м << беззнак64(55 - п);
    конец
    вернуть мд_собрать(знак, п + 1023, м);
конец

функция __floatdidf(целое х): беззнак64
    если (х < 0)
        вернуть мд_из_модуля(беззнак64(1), беззнак64(0) - беззнак64(х));
    конец
    вернуть мд_из_модуля(беззнак64(0), беззнак64(х));
конец

функция __floatundidf(беззнак64 х): беззнак64
    вернуть мд_из_модуля(беззнак64(0), х);
конец

функция __floatsidf(целое32 х): беззнак64
    вернуть __floatdidf(целое(х));
конец

функция __floatunsidf(беззнак32 х): беззнак64
    вернуть мд_из_модуля(беззнак64(0), беззнак64(х));
конец

// модуль числа, округлённый к нулю; 0, если число меньше 1; 2^64−1, если не помещается
функция мд_в_модуль(беззнак64 а): беззнак64
    беззнак64 один = беззнак64(1);
    целое е = мд_порядок(а);
    если (е < 1023)
        вернуть беззнак64(0);
    конец
    целое п = е - 1023;
    если (п >= 64)
        вернуть беззнак64(0) - один;
    конец
    беззнак64 м = мд_дробная_часть(а) | (один << беззнак64(52));
    если (п >= 52)
        вернуть м << беззнак64(п - 52);
    конец
    вернуть м >> беззнак64(52 - п);
конец

функция __fixdfdi(беззнак64 а): целое
    беззнак64 один = беззнак64(1);
    беззнак64 м = мд_в_модуль(а);
    если (мд_порядок(а) == 2047 и мд_дробная_часть(а) != беззнак64(0))
        вернуть 0;
    конец
    если ((а >> беззнак64(63)) == один)
        если ((м >> беззнак64(63)) != беззнак64(0))
            вернуть целое(один << беззнак64(63));
        конец
        вернуть целое(беззнак64(0) - м);
    конец
    если ((м >> беззнак64(63)) != беззнак64(0))
        вернуть целое((один << беззнак64(63)) - один);
    конец
    вернуть целое(м);
конец

функция __fixunsdfdi(беззнак64 а): беззнак64
    если ((а >> беззнак64(63)) == беззнак64(1))
        вернуть беззнак64(0);
    конец
    вернуть мд_в_модуль(а);
конец

функция __fixdfsi(беззнак64 а): целое32
    целое х = __fixdfdi(а);
    если (х > 2147483647)
        вернуть целое32(2147483647);
    конец
    если (х < 0 - 2147483647 - 1)
        вернуть целое32(0) - целое32(2147483647) - целое32(1);
    конец
    вернуть целое32(х);
конец

функция __fixunsdfsi(беззнак64 а): беззнак32
    беззнак64 х = __fixunsdfdi(а);
    если (х > беззнак64(4294967295))
        вернуть беззнак32(4294967295);
    конец
    вернуть беззнак32(х);
конец

// ---------- 64-битные целые для 32-битных процессоров ----------

// 32×32 → 64 бита, только через 32-битные умножения
функция мд_умножить32(беззнак32 х, беззнак32 у): беззнак64
    беззнак32 хн = х & беззнак32(65535);
    беззнак32 хв = х >> беззнак32(16);
    беззнак32 ун = у & беззнак32(65535);
    беззнак32 ув = у >> беззнак32(16);
    беззнак32 нн = хн * ун;
    беззнак32 нв = хн * ув;
    беззнак32 вн = хв * ун;
    беззнак32 вв = хв * ув;
    беззнак64 середина = беззнак64(нв) + беззнак64(вн);
    вернуть беззнак64(нн) + (середина << беззнак64(16)) + (беззнак64(вв) << беззнак64(32));
конец

функция __muldi3(беззнак64 а, беззнак64 б): беззнак64
    беззнак32 а_низ = беззнак32(а);
    беззнак32 а_верх = беззнак32(а >> беззнак64(32));
    беззнак32 б_низ = беззнак32(б);
    беззнак32 б_верх = беззнак32(б >> беззнак64(32));
    беззнак32 перекрёстное = а_верх * б_низ + а_низ * б_верх;
    вернуть мд_умножить32(а_низ, б_низ) + (беззнак64(перекрёстное) << беззнак64(32));
конец

// режим 0 — частное, 1 — остаток; деление на ноль даёт все единицы
функция мд_деление(беззнак64 а, беззнак64 б, целое режим): беззнак64
    беззнак64 ноль = беззнак64(0);
    беззнак64 один = беззнак64(1);
    если (б == ноль)
        вернуть ноль - один;
    конец
    беззнак64 частное = ноль;
    беззнак64 остаток = ноль;
    целое номер = 63;
    пока (номер >= 0)
        остаток = (остаток << один) | ((а >> беззнак64(номер)) & один);
        если (остаток >= б)
            остаток = остаток - б;
            частное = частное | (один << беззнак64(номер));
        конец
        номер = номер - 1;
    конец
    если (режим == 1)
        вернуть остаток;
    конец
    вернуть частное;
конец

функция __udivdi3(беззнак64 а, беззнак64 б): беззнак64
    вернуть мд_деление(а, б, 0);
конец

функция __umoddi3(беззнак64 а, беззнак64 б): беззнак64
    вернуть мд_деление(а, б, 1);
конец

функция мд_модуль(целое х): беззнак64
    если (х < 0)
        вернуть беззнак64(0) - беззнак64(х);
    конец
    вернуть беззнак64(х);
конец

функция __divdi3(целое а, целое б): целое
    беззнак64 ч = мд_деление(мд_модуль(а), мд_модуль(б), 0);
    если ((а < 0) != (б < 0))
        вернуть целое(беззнак64(0) - ч);
    конец
    вернуть целое(ч);
конец

функция __moddi3(целое а, целое б): целое
    беззнак64 ч = мд_деление(мд_модуль(а), мд_модуль(б), 1);
    если (а < 0)
        вернуть целое(беззнак64(0) - ч);
    конец
    вернуть целое(ч);
конец

// ---------- 64-битные сдвиги на переменное число разрядов (нужны процессорам Cortex-M0) ----------

функция __ashldi3(беззнак64 а, целое32 сдвиг): беззнак64
    целое32 н = сдвиг & целое32(63);
    если (н == целое32(0))
        вернуть а;
    конец
    беззнак32 низ = беззнак32(а);
    беззнак32 верх = беззнак32(а >> беззнак64(32));
    если (н >= целое32(32))
        вернуть беззнак64(низ << беззнак32(н - целое32(32))) << беззнак64(32);
    конец
    верх = (верх << беззнак32(н)) | (низ >> беззнак32(целое32(32) - н));
    низ = низ << беззнак32(н);
    вернуть (беззнак64(верх) << беззнак64(32)) | беззнак64(низ);
конец

функция __lshrdi3(беззнак64 а, целое32 сдвиг): беззнак64
    целое32 н = сдвиг & целое32(63);
    если (н == целое32(0))
        вернуть а;
    конец
    беззнак32 низ = беззнак32(а);
    беззнак32 верх = беззнак32(а >> беззнак64(32));
    если (н >= целое32(32))
        вернуть беззнак64(верх >> беззнак32(н - целое32(32)));
    конец
    низ = (низ >> беззнак32(н)) | (верх << беззнак32(целое32(32) - н));
    верх = верх >> беззнак32(н);
    вернуть (беззнак64(верх) << беззнак64(32)) | беззнак64(низ);
конец

функция __ashrdi3(целое а, целое32 сдвиг): целое
    целое32 н = сдвиг & целое32(63);
    если (н == целое32(0))
        вернуть а;
    конец
    беззнак64 ч = беззнак64(а);
    беззнак64 сдвинуто = __lshrdi3(ч, н);
    если (а >= 0)
        вернуть целое(сдвинуто);
    конец
    // у отрицательного числа старшие освободившиеся разряды — единицы
    беззнак64 единицы = беззнак64(0) - беззнак64(1);
    вернуть целое(сдвинуто | __ashldi3(единицы, целое32(64) - н));
конец
