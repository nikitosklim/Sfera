// почта_защита.код — защищённое соединение для почтового клиента (TLS поверх OpenSSL), по-русски.
//
// Подключается как обычная библиотека: "подключить почта_защита;".
// Латинские имена (OPENSSL_init_ssl, BIO_read и так далее) существуют ТОЛЬКО в
// этом файле, внутри "как "..."" — программа, которая пользуется модулем,
// не пишет ни одной латинской буквы. Тот же приём, что в графика.код.
//
// Зачем OpenSSL, а не своя реализация: защищённое соединение — это ровно то место,
// где изобретать своё опасно. Мы вызываем проверенную библиотеку, а вся
// почтовая логика поверх неё написана на Сфере.
//
// Что проверяется: сертификат сервера обязан быть выдан доверенным центром И
// относиться к тому имени, к которому мы подключаемся. Иначе соединение не
// открывается (защита от подмены сервера).
//
// Сборка программы с этим модулем: добавить  --линковать ssl --линковать crypto
//
// Все «указатели» OpenSSL хранятся числом (целое), а не текстом: текст в Сфере
// считается ссылками, и чужой указатель в нём мог бы быть освобождён по ошибке.

подключить память;

// ---- привязки к OpenSSL (латиница только здесь) ----
внешняя функция защита_запустить_библиотеку(беззнак64 флаги, текст настройки): целое32 как "OPENSSL_init_ssl";
внешняя функция защита_способ_клиента(): текст как "TLS_client_method";
внешняя функция защита_новый_контекст(текст способ): текст как "SSL_CTX_new";
внешняя функция защита_системные_корни(текст контекст): целое32 как "SSL_CTX_set_default_verify_paths";
внешняя функция защита_загрузить_корни(текст контекст, текст файл, текст папка): целое32 как "SSL_CTX_load_verify_locations";
внешняя функция защита_режим_проверки(текст контекст, целое32 режим, текст обработчик) как "SSL_CTX_set_verify";
внешняя функция защита_параметры_проверки(текст контекст): текст как "SSL_CTX_get0_param";
внешняя функция защита_имя_узла_в_проверке(текст параметры, текст имя, целое размер): целое32 как "X509_VERIFY_PARAM_set1_host";
внешняя функция защита_новая_цепочка(текст контекст): текст как "BIO_new_ssl_connect";
внешняя функция защита_управлять_цепочкой(текст цепочка, целое32 команда, целое аргумент, текст указатель): целое как "BIO_ctrl";
внешняя функция защита_читать_байты(текст цепочка, текст буфер, целое32 размер): целое32 как "BIO_read";
внешняя функция защита_писать_байты(текст цепочка, текст данные, целое32 размер): целое32 как "BIO_write";
внешняя функция защита_освободить_цепочку(текст цепочка) как "BIO_free_all";
внешняя функция защита_освободить_контекст(текст контекст) как "SSL_CTX_free";
внешняя функция защита_управлять_соединением(текст соединение, целое32 команда, целое аргумент, текст указатель): целое как "SSL_ctrl";

// Команды OpenSSL, заданные числами (в заголовках это макросы, их нельзя вызвать напрямую).
функция защита_команда_имя_узла(): целое32
    вернуть целое32(100);
конец
функция защита_команда_рукопожатие(): целое32
    вернуть целое32(101);
конец
функция защита_команда_получить_соединение(): целое32
    вернуть целое32(110);
конец
функция защита_команда_имя_для_сервера(): целое32
    вернуть целое32(55);
конец

функция защита_пустой_указатель(): текст
    вернуть указатель_по_адресу(0);
конец

// Открывает защищённое соединение с узлом и портом. Имя узла — латиницей (для
// кириллических доменов — в форме «xn--…»; перевод имён добавим отдельно).
// файл_доверия — путь к файлу корневых сертификатов; пустой текст — взять
// системные. Возвращает число-«дескриптор» соединения, 0 — если открыть не удалось.
функция защита_открыть(текст узел, целое порт, текст файл_доверия): целое
    защита_запустить_библиотеку(беззнак64(0), защита_пустой_указатель());
    текст контекст = защита_новый_контекст(защита_способ_клиента());
    если (адрес_текста(контекст) == 0)
        вернуть 0;
    конец
    если (длина(файл_доверия) == 0)
        защита_системные_корни(контекст);
    иначе
        если (целое(защита_загрузить_корни(контекст, файл_доверия, защита_пустой_указатель())) меньше 1)
            вернуть 0;
        конец
    конец
    // 1 = требовать проверку сертификата сервера
    защита_режим_проверки(контекст, целое32(1), защита_пустой_указатель());
    защита_имя_узла_в_проверке(защита_параметры_проверки(контекст), узел, 0);

    текст цепочка = защита_новая_цепочка(контекст);
    // Цепочка держит собственную ссылку на контекст — наша больше не нужна.
    защита_освободить_контекст(контекст);
    если (адрес_текста(цепочка) == 0)
        вернуть 0;
    конец
    текст адрес_и_порт = узел + ":" + целое_в_текст(порт);
    защита_управлять_цепочкой(цепочка, защита_команда_имя_узла(), 0, адрес_и_порт);

    // Передать серверу имя, к которому подключаемся (нужно серверам с несколькими сертификатами).
    текст ячейка = выделить_память(8);
    записать_целое64(ячейка, 0, 0);
    защита_управлять_цепочкой(цепочка, защита_команда_получить_соединение(), 0, ячейка);
    целое соединение = прочитать_целое64(ячейка, 0);
    освободить_память(ячейка);
    если (соединение != 0)
        защита_управлять_соединением(указатель_по_адресу(соединение), защита_команда_имя_для_сервера(), 0, узел);
    конец

    // Рукопожатие: здесь же проверяется сертификат. Меньше 1 — отказ.
    целое итог = защита_управлять_цепочкой(цепочка, защита_команда_рукопожатие(), 0, защита_пустой_указатель());
    если (итог меньше 1)
        защита_освободить_цепочку(цепочка);
        вернуть 0;
    конец
    вернуть адрес_текста(цепочка);
конец

// Отправляет текст по соединению. Возвращает число отправленных байт или значение меньше 1 при ошибке.
функция защита_отправить(целое дескриптор, текст данные): целое
    вернуть целое(защита_писать_байты(указатель_по_адресу(дескриптор), данные, целое32(длина(данные))));
конец

// Читает одну строку (до перевода строки; сам перевод строки отрезается).
// Пустой результат вместе с признаком конца — через защита_конец_данных.
функция защита_прочитать_строку(целое дескриптор): текст
    текст буфер = выделить_память(65544);
    целое занято = 0;
    пока (занято меньше 65536)
        целое прочитано = целое(защита_читать_байты(указатель_по_адресу(дескриптор), указатель_по_адресу(адрес_текста(буфер) + занято), целое32(1)));
        если (прочитано меньше 1)
            прервать
        конец
        текст один = указатель_по_адресу(адрес_текста(буфер) + занято);
        целое код = целое(прочитать_целое32(один, 0));
        если (наложить_маску(код, 255) == 10)
            прервать
        конец
        занято = занято + 1;
    конец
    // Отрезать завершающий возврат каретки.
    если (занято больше 0)
        текст последний = указатель_по_адресу(адрес_текста(буфер) + занято - 1);
        если (наложить_маску(целое(прочитать_целое32(последний, 0)), 255) == 13)
            занято = занято - 1;
        конец
    конец
    записать_целое32(буфер, занято, целое32(0));
    // Отдаём обычный текст Сферы (копию), а рабочий буфер освобождаем — иначе
    // каждая прочитанная строка стоила бы 64 КБ утечки.
    результат из текста часть = подстрока(буфер, 0, занято);
    освободить_память(буфер);
    если (часть.успешно)
        вернуть часть.значение;
    конец
    вернуть "";
конец

функция защита_закрыть(целое дескриптор)
    если (дескриптор != 0)
        защита_освободить_цепочку(указатель_по_адресу(дескриптор));
    конец
конец

// Читает ровно «сколько» байт (или меньше, если соединение оборвалось) и отдаёт их текстом.
// Нужно для «литералов» протокола получения почты: сервер сообщает размер {N}, затем присылает N байт.
функция защита_прочитать_точно(целое дескриптор, целое сколько): текст
    текст буфер = выделить_память(сколько + 8)
    целое получено = 0
    пока (получено < сколько)
        целое осталось = сколько - получено
        если (осталось > 16384)
            осталось = 16384
        конец
        целое n = целое(защита_читать_байты(указатель_по_адресу(дескриптор), указатель_по_адресу(адрес_текста(буфер) + получено), целое32(осталось)))
        если (n < 1)
            прервать
        конец
        получено = получено + n
    конец
    записать_целое32(буфер, получено, целое32(0));
    результат из текста часть = подстрока(буфер, 0, получено)
    освободить_память(буфер)
    если (часть.успешно)
        вернуть часть.значение
    конец
    вернуть ""
конец
