// диск_х86.код — чтение диска (ATA, режим PIO) и простая файловая система «СФС» (только чтение) на x86-64.
//
// Подключение (после  железо_х86):  подключить диск_х86;
// Диск — вторичный контроллер IDE, ведущее устройство (порты 0x170…0x177, 0x376). В QEMU:
//   qemu-system-x86_64 ... -drive file=данные.img,format=raw,if=ide,index=2
//
// Устройство СФС (сектора по 512 байт):
//   сектор 0: «SFS1», +4 число файлов (4 байта), с +16 записи по 32 байта:
//             +0 имя (до 19 байт UTF-8, дальше нули), +20 первый сектор файла, +24 размер в байтах;
//   файлы идут подряд с сектора 1, каждый начинается с границы сектора.
// Образ делает инструменты/диск/собрать_диск.py.  Сектор 0 читается в буфер по адресу 0x310000.

функция диск_ждать(): целое
    целое n = 0;
    пока (n < 2000000)
        целое с = целое(порт_ввод8(0x177));
        если (наложить_маску(с, 128) == 0)
            вернуть с;
        конец
        n = n + 1;
    конец
    вернуть 0 - 1;
конец

// Читает один сектор (номер сектора лба) по адресу в памяти. Возвращает 0 или -1 при ошибке.
функция диск_читать_сектор(целое лба, целое адрес): целое
    порт_вывод8(0x376, беззнак8(2));   // прерывания диска не нужны
    если (диск_ждать() < 0)
        вернуть 0 - 1;
    конец
    порт_вывод8(0x176, беззнак8(включить_биты(0xE0, наложить_маску(сдвинуть_вправо(лба, 24), 15))));
    порт_вывод8(0x172, беззнак8(1));
    порт_вывод8(0x173, беззнак8(наложить_маску(лба, 255)));
    порт_вывод8(0x174, беззнак8(наложить_маску(сдвинуть_вправо(лба, 8), 255)));
    порт_вывод8(0x175, беззнак8(наложить_маску(сдвинуть_вправо(лба, 16), 255)));
    порт_вывод8(0x177, беззнак8(0x20));  // команда «читать сектор»
    целое статус = диск_ждать();
    если (статус < 0 или наложить_маску(статус, 1) != 0 или наложить_маску(статус, 8) == 0)
        вернуть 0 - 1;
    конец
    целое i = 0;
    пока (i < 256)
        аппаратная_запись16(адрес + i * 2, порт_ввод16(0x170));
        i = i + 1;
    конец
    вернуть 0;
конец

// Читает таблицу файлов. Возвращает число файлов или -1, если диска нет или это не СФС.
функция фс_открыть(): целое
    если (диск_читать_сектор(0, 0x310000) != 0)
        вернуть 0 - 1;
    конец
    если (аппаратное_чтение32(0x310000) != беззнак32(0x31534653))   // «SFS1»
        вернуть 0 - 1;
    конец
    вернуть целое(аппаратное_чтение32(0x310004));
конец

// Имя файла номер n: байты по адресу, который возвращает функция (оканчиваются нулём).
функция фс_имя(целое n): целое
    вернуть 0x310010 + n * 32;
конец

функция фс_сектор(целое n): целое
    вернуть целое(аппаратное_чтение32(0x310010 + n * 32 + 20));
конец

функция фс_размер(целое n): целое
    вернуть целое(аппаратное_чтение32(0x310010 + n * 32 + 24));
конец

// Ищет файл, имя которого лежит в памяти по адресу «адрес» длиной «длина» байт. Возвращает номер или -1.
функция фс_найти(целое адрес, целое длина): целое
    целое число = фс_открыть();
    целое n = 0;
    пока (n < число)
        целое имя = фс_имя(n);
        целое i = 0;
        пока (i < длина и аппаратное_чтение8(имя + i) == аппаратное_чтение8(адрес + i))
            i = i + 1;
        конец
        если (i == длина и аппаратное_чтение8(имя + длина) == беззнак8(0))
            вернуть n;
        конец
        n = n + 1;
    конец
    вернуть 0 - 1;
конец
