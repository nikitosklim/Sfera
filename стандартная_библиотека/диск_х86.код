// диск_х86.код — чтение и запись диска и простая файловая система «СФС» на x86-64.
// Диски: SATA через контроллер AHCI (современные компьютеры; ищется диск с «SFS1» в нулевом секторе)
// или, если такого нет, старый IDE (ATA, режим PIO, вторичный канал). Выбор делает сама библиотека.
//
// Подключение (после  железо_х86):  подключить диск_х86;
// Диск — вторичный контроллер IDE, ведущее устройство (порты 0x170…0x177, 0x376). В QEMU:
//   qemu-system-x86_64 ... -drive file=данные.img,format=raw,if=ide,index=2
//
// Устройство СФС (сектора по 512 байт):
//   сектор 0: «SFS1», +4 число файлов (4 байта), с +16 записи по 32 байта:
//             +0 имя (до 19 байт UTF-8, дальше нули), +20 первый сектор файла, +24 размер в байтах;
//   файлы идут подряд с сектора 1, каждый начинается с границы сектора.
// Образ делает инструменты/диск/собрать_диск.py.  Сектор 0 читается в буфер по адресу 0x310000.
//
// Запись: фс_записать создаёт файл или заменяет его (если новое содержимое не больше места, занятого
// старым, файл остаётся на месте, иначе уходит в конец данных), фс_удалить убирает запись из таблицы
// (дырки в середине не уплотняются, место после последнего файла освобождается). Файлов — не больше 15.
// Буфер сектора при записи — 0x312000.

функция диск_ждать(): целое
    целое n = 0;
    пока (n < 2000000)
        целое с = целое(порт_ввод8(0x177));
        если (наложить_маску(с, 128) == 0)
            вернуть с;
        конец
        n = n + 1;
    конец
    вернуть 0 - 1;
конец

// Читает один сектор (номер сектора лба) по адресу в памяти. Возвращает 0 или -1 при ошибке.
функция ата_читать_сектор(целое лба, целое адрес): целое
    порт_вывод8(0x376, беззнак8(2));   // прерывания диска не нужны
    если (диск_ждать() < 0)
        вернуть 0 - 1;
    конец
    порт_вывод8(0x176, беззнак8(включить_биты(0xE0, наложить_маску(сдвинуть_вправо(лба, 24), 15))));
    порт_вывод8(0x172, беззнак8(1));
    порт_вывод8(0x173, беззнак8(наложить_маску(лба, 255)));
    порт_вывод8(0x174, беззнак8(наложить_маску(сдвинуть_вправо(лба, 8), 255)));
    порт_вывод8(0x175, беззнак8(наложить_маску(сдвинуть_вправо(лба, 16), 255)));
    порт_вывод8(0x177, беззнак8(0x20));  // команда «читать сектор»
    целое статус = диск_ждать();
    если (статус < 0 или наложить_маску(статус, 1) != 0 или наложить_маску(статус, 8) == 0)
        вернуть 0 - 1;
    конец
    целое i = 0;
    пока (i < 256)
        аппаратная_запись16(адрес + i * 2, порт_ввод16(0x170));
        i = i + 1;
    конец
    вернуть 0;
конец

// Читает таблицу файлов. Возвращает число файлов или -1, если диска нет или это не СФС.
функция фс_открыть(): целое
    если (диск_читать_сектор(0, 0x310000) != 0)
        вернуть 0 - 1;
    конец
    если (аппаратное_чтение32(0x310000) != беззнак32(0x31534653))   // «SFS1»
        вернуть 0 - 1;
    конец
    вернуть целое(аппаратное_чтение32(0x310004));
конец

// Имя файла номер n: байты по адресу, который возвращает функция (оканчиваются нулём).
функция фс_имя(целое n): целое
    вернуть 0x310010 + n * 32;
конец

функция фс_сектор(целое n): целое
    вернуть целое(аппаратное_чтение32(0x310010 + n * 32 + 20));
конец

функция фс_размер(целое n): целое
    вернуть целое(аппаратное_чтение32(0x310010 + n * 32 + 24));
конец

// Ищет файл, имя которого лежит в памяти по адресу «адрес» длиной «длина» байт. Возвращает номер или -1.
функция фс_найти(целое адрес, целое длина): целое
    целое число = фс_открыть();
    целое n = 0;
    пока (n < число)
        целое имя = фс_имя(n);
        целое i = 0;
        пока (i < длина и аппаратное_чтение8(имя + i) == аппаратное_чтение8(адрес + i))
            i = i + 1;
        конец
        если (i == длина и аппаратное_чтение8(имя + длина) == беззнак8(0))
            вернуть n;
        конец
        n = n + 1;
    конец
    вернуть 0 - 1;
конец

// Записывает один сектор из памяти (адрес) на диск (номер лба). Возвращает 0 или -1 при ошибке.
функция ата_писать_сектор(целое лба, целое адрес): целое
    порт_вывод8(0x376, беззнак8(2));
    если (диск_ждать() < 0)
        вернуть 0 - 1;
    конец
    порт_вывод8(0x176, беззнак8(включить_биты(0xE0, наложить_маску(сдвинуть_вправо(лба, 24), 15))));
    порт_вывод8(0x172, беззнак8(1));
    порт_вывод8(0x173, беззнак8(наложить_маску(лба, 255)));
    порт_вывод8(0x174, беззнак8(наложить_маску(сдвинуть_вправо(лба, 8), 255)));
    порт_вывод8(0x175, беззнак8(наложить_маску(сдвинуть_вправо(лба, 16), 255)));
    порт_вывод8(0x177, беззнак8(0x30));  // команда «писать сектор»
    целое статус = диск_ждать();
    если (статус < 0 или наложить_маску(статус, 1) != 0 или наложить_маску(статус, 8) == 0)
        вернуть 0 - 1;
    конец
    целое i = 0;
    пока (i < 256)
        порт_вывод16(0x170, аппаратное_чтение16(адрес + i * 2));
        i = i + 1;
    конец
    порт_вывод8(0x177, беззнак8(0xE7));  // сбросить кэш диска на носитель
    если (диск_ждать() < 0)
        вернуть 0 - 1;
    конец
    вернуть 0;
конец

// Сколько секторов на диске (по ответу диска на запрос «кто ты»); 0, если диска нет.
функция ата_секторов(): целое
    порт_вывод8(0x376, беззнак8(2));
    если (диск_ждать() < 0)
        вернуть 0;
    конец
    порт_вывод8(0x176, беззнак8(0xE0));
    порт_вывод8(0x177, беззнак8(0xEC));
    целое статус = диск_ждать();
    если (статус < 0 или наложить_маску(статус, 8) == 0)
        вернуть 0;
    конец
    целое i = 0;
    пока (i < 256)
        аппаратная_запись16(0x312000 + i * 2, порт_ввод16(0x170));
        i = i + 1;
    конец
    вернуть целое(аппаратное_чтение16(0x312000 + 120)) + целое(аппаратное_чтение16(0x312000 + 122)) * 65536;
конец


// ===================== SATA (AHCI) =====================
// Состояние (0x313000): +0 «метка» 0x4B534944 — выбор уже сделан; +4 режим (1 — IDE, 2 — AHCI); +8 адрес порта AHCI.
// Память AHCI: 0x340000 список команд (1 КБ), 0x340400 приём ответов (256 Б), 0x340800 таблица команды.
// Данные идут прямо по переданному адресу (он должен быть ниже 4 ГБ и чётным).

функция ахси_чит(целое база, целое смещение): целое
    вернуть целое(аппаратное_чтение32(база + смещение));
конец

функция ахси_пис(целое база, целое смещение, целое значение)
    аппаратная_запись32(база + смещение, беззнак32(значение));
конец

функция ахси_мпк(целое шина, целое устройство, целое смещение): целое
    целое адрес = включить_биты(0x80000000, включить_биты(сдвинуть_влево(шина, 16), включить_биты(сдвинуть_влево(устройство, 11), смещение)));
    порт_вывод32(0xCF8, беззнак32(адрес));
    вернуть целое(порт_ввод32(0xCFC));
конец

функция ахси_мпк_писать(целое шина, целое устройство, целое смещение, целое значение)
    целое адрес = включить_биты(0x80000000, включить_биты(сдвинуть_влево(шина, 16), включить_биты(сдвинуть_влево(устройство, 11), смещение)));
    порт_вывод32(0xCF8, беззнак32(адрес));
    порт_вывод32(0xCFC, беззнак32(значение));
конец

// Ждёт, пока (регистр & маска) станет равным нужному значению. 0 — дождались, -1 — время вышло.
функция ахси_ждать(целое адрес, целое маска, целое нужно): целое
    целое n = 0;
    пока (n < 1000000)
        если (наложить_маску(целое(аппаратное_чтение32(адрес)), маска) == нужно)
            вернуть 0;
        конец
        n = n + 1;
    конец
    вернуть 0 - 1;
конец

// Останавливает порт, задаёт ему наши буферы и запускает. 0 — готово, -1 — порт не отвечает.
функция ахси_порт_включить(целое порт): целое
    ахси_пис(порт, 0x18, наложить_маску(ахси_чит(порт, 0x18), 0xFFFFFFEE));   // сбросить ST и FRE
    если (ахси_ждать(порт + 0x18, 0xC000, 0) != 0)                          // ждём CR = 0 и FR = 0
        вернуть 0 - 1;
    конец
    ахси_пис(порт, 0x00, 0x340000);
    ахси_пис(порт, 0x04, 0);
    ахси_пис(порт, 0x08, 0x340400);
    ахси_пис(порт, 0x0C, 0);
    ахси_пис(порт, 0x30, 0xFFFFFFFF);
    ахси_пис(порт, 0x10, 0xFFFFFFFF);
    ахси_пис(порт, 0x14, 0);                                               // прерывания не нужны
    ахси_пис(порт, 0x18, включить_биты(ахси_чит(порт, 0x18), 0x10));        // FRE
    если (ахси_ждать(порт + 0x20, 0x88, 0) != 0)                            // диск не занят (BSY, DRQ = 0)
        вернуть 0 - 1;
    конец
    ахси_пис(порт, 0x18, включить_биты(ахси_чит(порт, 0x18), 0x11));        // ST
    вернуть 0;
конец

// Выполняет одну команду ATA с одним сектором (512 байт) данных. запись = 1 — в диск, 0 — из диска.
функция ахси_команда(целое порт, целое команда, целое лба, целое адрес, целое запись): целое
    целое т = 0x340800;
    целое i = 0;
    пока (i < 144)
        аппаратная_запись8(т + i, беззнак8(0));
        i = i + 1;
    конец
    аппаратная_запись8(т, беззнак8(0x27));              // FIS «хост → устройство»
    аппаратная_запись8(т + 1, беззнак8(0x80));          // это команда
    аппаратная_запись8(т + 2, беззнак8(команда));
    аппаратная_запись8(т + 4, беззнак8(наложить_маску(лба, 255)));
    аппаратная_запись8(т + 5, беззнак8(наложить_маску(сдвинуть_вправо(лба, 8), 255)));
    аппаратная_запись8(т + 6, беззнак8(наложить_маску(сдвинуть_вправо(лба, 16), 255)));
    аппаратная_запись8(т + 7, беззнак8(0x40));          // режим LBA
    аппаратная_запись8(т + 8, беззнак8(наложить_маску(сдвинуть_вправо(лба, 24), 255)));
    аппаратная_запись8(т + 9, беззнак8(наложить_маску(сдвинуть_вправо(лба, 32), 255)));
    аппаратная_запись8(т + 10, беззнак8(наложить_маску(сдвинуть_вправо(лба, 40), 255)));
    аппаратная_запись8(т + 12, беззнак8(1));            // один сектор
    ахси_пис(т, 0x80, адрес);                           // таблица областей данных: адрес…
    ахси_пис(т, 0x84, 0);
    ахси_пис(т, 0x8C, 511);                             // …и 512 байт (длина минус один)
    целое флаги = 5 + 65536;                            // FIS из 5 слов, одна область данных
    если (команда == 0xEA)
        флаги = 5;                                      // сброс кэша — команда без данных
    конец
    если (запись == 1)
        флаги = флаги + 64;
    конец
    ахси_пис(0x340000, 0, флаги);
    ахси_пис(0x340000, 4, 0);
    ахси_пис(0x340000, 8, т);
    ахси_пис(0x340000, 12, 0);
    ахси_пис(порт, 0x10, 0xFFFFFFFF);
    ахси_пис(порт, 0x38, 1);                            // запустить команду в слоте 0
    целое n = 0;
    пока (n < 5000000)
        если (наложить_маску(ахси_чит(порт, 0x10), 0x40000000) != 0)   // ошибка устройства
            вернуть 0 - 1;
        конец
        если (наложить_маску(ахси_чит(порт, 0x38), 1) == 0)
            вернуть 0;
        конец
        n = n + 1;
    конец
    вернуть 0 - 1;
конец

// Ищет контроллер AHCI и на нём диск с файловой системой СФС. Возвращает адрес порта или 0.
функция ахси_найти(): целое
    целое шина = 0;
    пока (шина < 4)
        целое устройство = 0;
        пока (устройство < 32)
            целое функц = 0;
            пока (функц < 8)
                целое см = функц * 256;
                если (наложить_маску(ахси_мпк(шина, устройство, см), 0xFFFF) != 0xFFFF)
                    если (сдвинуть_вправо(ахси_мпк(шина, устройство, см + 8), 16) == 0x0106)
                        целое база = наложить_маску(ахси_мпк(шина, устройство, см + 0x24), 0xFFFFFFF0);
                        если (база != 0 и (база < 0x40000000 или (база >= 0x80000000 и база < 0x100000000)))
                            ахси_мпк_писать(шина, устройство, см + 4, включить_биты(наложить_маску(ахси_мпк(шина, устройство, см + 4), 0xFFFF), 6));
                            ахси_пис(база, 0x04, наложить_маску(включить_биты(ахси_чит(база, 0x04), 0x80000000), 0xFFFFFFFD));   // AHCI вкл., прерывания выкл.
                            целое реализовано = ахси_чит(база, 0x0C);
                            целое номер = 0;
                            пока (номер < 32)
                                если (наложить_маску(сдвинуть_вправо(реализовано, номер), 1) == 1)
                                    целое порт = база + 0x100 + номер * 0x80;
                                    целое связь = ахси_чит(порт, 0x28);
                                    если (наложить_маску(связь, 15) == 3 и наложить_маску(сдвинуть_вправо(связь, 8), 15) == 1 и ахси_чит(порт, 0x24) == 0x101)
                                        если (ахси_порт_включить(порт) == 0)
                                            если (ахси_команда(порт, 0x25, 0, 0x312000, 0) == 0 и аппаратное_чтение32(0x312000) == беззнак32(0x31534653))
                                                вернуть порт;
                                            конец
                                        конец
                                    конец
                                конец
                                номер = номер + 1;
                            конец
                        конец
                    конец
                конец
                функц = функц + 1;
            конец
            устройство = устройство + 1;
        конец
        шина = шина + 1;
    конец
    вернуть 0;
конец

// Какой диск используем: 2 — SATA (AHCI), 1 — IDE. Решается при первом обращении.
функция диск_режим(): целое
    если (аппаратное_чтение32(0x313000) == беззнак32(0x4B534944))
        вернуть целое(аппаратное_чтение32(0x313004));
    конец
    целое порт = ахси_найти();
    целое режим = 1;
    если (порт != 0)
        режим = 2;
    конец
    аппаратная_запись32(0x313004, беззнак32(режим));
    аппаратная_запись32(0x313008, беззнак32(порт));
    аппаратная_запись32(0x313000, беззнак32(0x4B534944));
    вернуть режим;
конец

// Читает один сектор (номер лба) по адресу в памяти. Возвращает 0 или -1 при ошибке.
функция диск_читать_сектор(целое лба, целое адрес): целое
    если (диск_режим() == 2)
        вернуть ахси_команда(целое(аппаратное_чтение32(0x313008)), 0x25, лба, адрес, 0);
    конец
    вернуть ата_читать_сектор(лба, адрес);
конец

// Записывает один сектор из памяти (адрес) на диск (номер лба). Возвращает 0 или -1 при ошибке.
функция диск_писать_сектор(целое лба, целое адрес): целое
    если (диск_режим() == 2)
        целое порт = целое(аппаратное_чтение32(0x313008));
        если (ахси_команда(порт, 0x35, лба, адрес, 1) != 0)
            вернуть 0 - 1;
        конец
        вернуть ахси_команда(порт, 0xEA, 0, 0x312000, 0);   // сбросить кэш диска (данные в команде не нужны, адрес безопасный)
    конец
    вернуть ата_писать_сектор(лба, адрес);
конец

// Сколько секторов на диске; 0, если диска нет.
функция диск_секторов(): целое
    если (диск_режим() == 2)
        если (ахси_команда(целое(аппаратное_чтение32(0x313008)), 0xEC, 0, 0x312000, 0) != 0)
            вернуть 0;
        конец
        вернуть целое(аппаратное_чтение32(0x312000 + 200));
    конец
    вернуть ата_секторов();
конец

функция секторов_для(целое размер): целое
    вернуть (размер + 511) / 512;
конец

// Номер файла с таким именем в уже прочитанной таблице (число файлов — «число»), или -1.
функция фс_поиск(целое адрес, целое длина, целое число): целое
    целое n = 0;
    пока (n < число)
        целое имя = фс_имя(n);
        целое i = 0;
        пока (i < длина и аппаратное_чтение8(имя + i) == аппаратное_чтение8(адрес + i))
            i = i + 1;
        конец
        если (i == длина и аппаратное_чтение8(имя + длина) == беззнак8(0))
            вернуть n;
        конец
        n = n + 1;
    конец
    вернуть 0 - 1;
конец

// Первый сектор после данных последнего файла.
функция фс_конец_данных(целое число): целое
    целое конец_данных = 1;
    целое n = 0;
    пока (n < число)
        целое е = фс_сектор(n) + секторов_для(фс_размер(n));
        если (е > конец_данных)
            конец_данных = е;
        конец
        n = n + 1;
    конец
    вернуть конец_данных;
конец

// Читает файл номер n в память по адресу (не больше «максимум» байт). Возвращает число прочитанных байт или -1.
функция фс_читать(целое n, целое адрес, целое максимум): целое
    целое размер = фс_размер(n);
    если (размер > максимум)
        размер = максимум;
    конец
    целое сектор = фс_сектор(n);
    целое i = 0;
    пока (i * 512 < размер)
        если (диск_читать_сектор(сектор + i, 0x312000) != 0)
            вернуть 0 - 1;
        конец
        целое б = 0;
        пока (б < 512 и i * 512 + б < размер)
            аппаратная_запись8(адрес + i * 512 + б, аппаратное_чтение8(0x312000 + б));
            б = б + 1;
        конец
        i = i + 1;
    конец
    вернуть размер;
конец

// Создаёт файл (или заменяет существующий): имя — байты по адресу (длина до 19), данные — байты в памяти.
// Возвращает 0, -1 нет диска/СФС, -2 плохое имя, -3 нет места, -4 слишком много файлов, -5 ошибка записи.
функция фс_записать(целое имя_адрес, целое имя_длина, целое данные, целое размер): целое
    целое число = фс_открыть();
    если (число < 0)
        вернуть 0 - 1;
    конец
    если (имя_длина < 1 или имя_длина > 19)
        вернуть 0 - 2;
    конец
    целое n = фс_поиск(имя_адрес, имя_длина, число);
    целое нужно = секторов_для(размер);
    целое сектор = 0;
    если (n >= 0 и нужно <= секторов_для(фс_размер(n)))
        сектор = фс_сектор(n);
    иначе
        сектор = фс_конец_данных(число);
        если (n >= 0)
            // старое место освобождаем: файл переезжает в конец
            n = n;
        конец
        если (сектор + нужно > диск_секторов())
            вернуть 0 - 3;
        конец
        если (n < 0)
            если (число >= 15)
                вернуть 0 - 4;
            конец
            n = число;
            число = число + 1;
        конец
    конец
    // данные по секторам (последний — с дополнением нулями)
    целое i = 0;
    пока (i < нужно)
        целое б = 0;
        пока (б < 512)
            если (i * 512 + б < размер)
                аппаратная_запись8(0x312000 + б, аппаратное_чтение8(данные + i * 512 + б));
            иначе
                аппаратная_запись8(0x312000 + б, беззнак8(0));
            конец
            б = б + 1;
        конец
        если (диск_писать_сектор(сектор + i, 0x312000) != 0)
            вернуть 0 - 5;
        конец
        i = i + 1;
    конец
    // запись в таблице
    целое запись = 0x310010 + n * 32;
    целое к = 0;
    пока (к < 32)
        аппаратная_запись8(запись + к, беззнак8(0));
        к = к + 1;
    конец
    к = 0;
    пока (к < имя_длина)
        аппаратная_запись8(запись + к, аппаратное_чтение8(имя_адрес + к));
        к = к + 1;
    конец
    аппаратная_запись32(запись + 20, беззнак32(сектор));
    аппаратная_запись32(запись + 24, беззнак32(размер));
    аппаратная_запись32(0x310004, беззнак32(число));
    если (диск_писать_сектор(0, 0x310000) != 0)
        вернуть 0 - 5;
    конец
    вернуть 0;
конец

// Удаляет файл из таблицы. Возвращает 0, -1 (нет диска или файла), -5 (ошибка записи).
функция фс_удалить(целое имя_адрес, целое имя_длина): целое
    целое число = фс_открыть();
    если (число < 0)
        вернуть 0 - 1;
    конец
    целое n = фс_поиск(имя_адрес, имя_длина, число);
    если (n < 0)
        вернуть 0 - 1;
    конец
    целое i = n;
    пока (i + 1 < число)
        целое к = 0;
        пока (к < 32)
            аппаратная_запись8(0x310010 + i * 32 + к, аппаратное_чтение8(0x310010 + (i + 1) * 32 + к));
            к = к + 1;
        конец
        i = i + 1;
    конец
    целое к = 0;
    пока (к < 32)
        аппаратная_запись8(0x310010 + (число - 1) * 32 + к, беззнак8(0));
        к = к + 1;
    конец
    аппаратная_запись32(0x310004, беззнак32(число - 1));
    если (диск_писать_сектор(0, 0x310000) != 0)
        вернуть 0 - 5;
    конец
    вернуть 0;
конец
