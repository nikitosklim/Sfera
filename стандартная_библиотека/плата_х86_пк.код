// плата_х86_пк.код — «плата» для обычного ПК (и QEMU) на x86-64: вывод символов в последовательный порт COM1.
//
// Подключение:  подключить плата_х86_пк;  (вместе с  подключить голое_железо;)
//
// Каждый символ уходит в порт 0x3F8; QEMU показывает его, если запустить с ключом  -serial stdio.
// На настоящем ПК порт нужно сначала настроить — это делает функция sfera_плата_старт() (скорость 115200).

подключить железо_х86;

функция sfera_плата_старт()
    порт_вывод8(0x3F9, беззнак8(0));     // прерывания порта выключены
    порт_вывод8(0x3FB, беззнак8(0x80));  // открыть делитель скорости
    порт_вывод8(0x3F8, беззнак8(1));     // делитель = 1 → 115200 бод
    порт_вывод8(0x3F9, беззнак8(0));
    порт_вывод8(0x3FB, беззнак8(3));     // 8 бит, без чётности, 1 стоп-бит
    порт_вывод8(0x3FA, беззнак8(0xC7));  // очередь передатчика включена
    порт_вывод8(0x3FC, беззнак8(0x0B));
конец

функция sfera_вывод_символа(целое32 символ)
    // ждём, пока передатчик освободится (бит 5 регистра состояния)
    пока (наложить_маску(порт_ввод8(0x3FD), беззнак8(0x20)) == беззнак8(0))
        пустая_команда();
    конец
    порт_вывод8(0x3F8, беззнак8(символ));
конец
