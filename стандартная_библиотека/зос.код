// зос.код — чтение и сборка ЗОС («Запись Объектов Скрипта», по-английски JSON).
//
// Подключается как `подключить зос;` (сам подключает `память`).
//
// Читать ЗОС удобно «по пути»: зос_текст(данные, "игрок.очки") достаёт
// значение, не строя дерево в памяти. Путь — имена полей через точку;
// для массивов вместо имени пишется номер элемента с нуля:
//   "враги.2.имя"  — поле «имя» у третьего элемента массива «враги».
//
// ⚠️ Честно, узко:
// - Имя поля с точкой внутри по пути не достать (точка — разделитель).
// - \uXXXX разбирается в UTF-8, включая пары суррогатов (эмодзи).
// - Глубина вложенности ограничена только стеком программы.

подключить память;

// ------------------------------------------------------------ вспомогательное

// Безопасная подстрока: при любой ошибке возвращает пустой текст.
функция зос_кусок(текст источник, целое начало, целое сколько): текст
    если (начало меньше 0 или сколько меньше 0)
        вернуть "";
    конец
    результат из текста часть = подстрока(источник, начало, сколько);
    если (часть.успешно)
        вернуть часть.значение;
    конец
    вернуть "";
конец

функция зос_байт(текст с, целое п): целое
    если (п меньше 0 или п не меньше длина(с))
        вернуть -1;
    конец
    вернуть целое(байт_текста(с, п));
конец

// Первая позиция, начиная с п, где стоит не пробел.
функция зос_пропустить_пробелы(текст с, целое п): целое
    целое n = длина(с);
    целое i = п;
    пока (i меньше n)
        целое б = целое(байт_текста(с, i));
        если (б == 32 или б == 9 или б == 10 или б == 13)
            i = i + 1;
        иначе
            вернуть i;
        конец
    конец
    вернуть i;
конец

// п стоит на открывающей кавычке. Возвращает позицию ПОСЛЕ закрывающей или -1.
функция зос_конец_строки(текст с, целое п): целое
    целое n = длина(с);
    целое i = п + 1;
    пока (i меньше n)
        целое б = целое(байт_текста(с, i));
        если (б == 34)
            вернуть i + 1;
        конец
        если (б == 92)
            i = i + 2;
        иначе если (б меньше 32)
            вернуть -1;
        иначе
            i = i + 1;
        конец
    конец
    вернуть -1;
конец

функция зос_это_цифра(целое б): верно
    вернуть б не меньше 48 и б не больше 57;
конец

// п стоит на первом символе значения (не на пробеле). Возвращает позицию
// ПОСЛЕ значения или -1, если ЗОС некорректен.
функция зос_конец_значения(текст с, целое п): целое
    целое б = зос_байт(с, п);
    если (б == 34)
        вернуть зос_конец_строки(с, п);
    конец
    если (б == 123)
        целое i = зос_пропустить_пробелы(с, п + 1);
        если (зос_байт(с, i) == 125)
            вернуть i + 1;
        конец
        пока (да)
            i = зос_пропустить_пробелы(с, i);
            если (зос_байт(с, i) != 34)
                вернуть -1;
            конец
            i = зос_конец_строки(с, i);
            если (i меньше 0)
                вернуть -1;
            конец
            i = зос_пропустить_пробелы(с, i);
            если (зос_байт(с, i) != 58)
                вернуть -1;
            конец
            i = зос_пропустить_пробелы(с, i + 1);
            i = зос_конец_значения(с, i);
            если (i меньше 0)
                вернуть -1;
            конец
            i = зос_пропустить_пробелы(с, i);
            целое с2 = зос_байт(с, i);
            если (с2 == 44)
                i = i + 1;
            иначе если (с2 == 125)
                вернуть i + 1;
            иначе
                вернуть -1;
            конец
        конец
    конец
    если (б == 91)
        целое i = зос_пропустить_пробелы(с, п + 1);
        если (зос_байт(с, i) == 93)
            вернуть i + 1;
        конец
        пока (да)
            i = зос_пропустить_пробелы(с, i);
            i = зос_конец_значения(с, i);
            если (i меньше 0)
                вернуть -1;
            конец
            i = зос_пропустить_пробелы(с, i);
            целое с2 = зос_байт(с, i);
            если (с2 == 44)
                i = i + 1;
            иначе если (с2 == 93)
                вернуть i + 1;
            иначе
                вернуть -1;
            конец
        конец
    конец
    если (зос_кусок(с, п, 4) == "true")
        вернуть п + 4;
    конец
    если (зос_кусок(с, п, 5) == "false")
        вернуть п + 5;
    конец
    если (зос_кусок(с, п, 4) == "null")
        вернуть п + 4;
    конец
    // число: -?цифры(.цифры)?([eE][+-]?цифры)?
    целое i = п;
    если (зос_байт(с, i) == 45)
        i = i + 1;
    конец
    целое начало_цифр = i;
    пока (зос_это_цифра(зос_байт(с, i)))
        i = i + 1;
    конец
    если (i == начало_цифр)
        вернуть -1;
    конец
    если (зос_байт(с, i) == 46)
        i = i + 1;
        целое после_точки = i;
        пока (зос_это_цифра(зос_байт(с, i)))
            i = i + 1;
        конец
        если (i == после_точки)
            вернуть -1;
        конец
    конец
    если (зос_байт(с, i) == 101 или зос_байт(с, i) == 69)
        i = i + 1;
        если (зос_байт(с, i) == 43 или зос_байт(с, i) == 45)
            i = i + 1;
        конец
        целое после_е = i;
        пока (зос_это_цифра(зос_байт(с, i)))
            i = i + 1;
        конец
        если (i == после_е)
            вернуть -1;
        конец
    конец
    вернуть i;
конец

// ------------------------------------------------------------ строки

функция зос_шестнадцатеричная(целое б): целое
    если (б не меньше 48 и б не больше 57)
        вернуть б - 48;
    конец
    если (б не меньше 97 и б не больше 102)
        вернуть б - 87;
    конец
    если (б не меньше 65 и б не больше 70)
        вернуть б - 55;
    конец
    вернуть -1;
конец

// Четыре шестнадцатеричные цифры с позиции п → число или -1.
функция зос_четыре_цифры(текст с, целое п): целое
    целое значение = 0;
    целое k = 0;
    пока (k меньше 4)
        целое ц = зос_шестнадцатеричная(зос_байт(с, п + k));
        если (ц меньше 0)
            вернуть -1;
        конец
        значение = значение * 16 + ц;
        k = k + 1;
    конец
    вернуть значение;
конец

// Записывает кодовую точку в буфер как UTF-8, возвращает новое смещение.
функция зос_записать_фпю8(текст буфер, целое смещение, целое код): целое
    если (код меньше 128)
        записать_байт(буфер, смещение, код);
        вернуть смещение + 1;
    конец
    если (код меньше 2048)
        записать_байт(буфер, смещение, 192 | (код >> 6));
        записать_байт(буфер, смещение + 1, 128 | (код & 63));
        вернуть смещение + 2;
    конец
    если (код меньше 65536)
        записать_байт(буфер, смещение, 224 | (код >> 12));
        записать_байт(буфер, смещение + 1, 128 | ((код >> 6) & 63));
        записать_байт(буфер, смещение + 2, 128 | (код & 63));
        вернуть смещение + 3;
    конец
    записать_байт(буфер, смещение, 240 | (код >> 18));
    записать_байт(буфер, смещение + 1, 128 | ((код >> 12) & 63));
    записать_байт(буфер, смещение + 2, 128 | ((код >> 6) & 63));
    записать_байт(буфер, смещение + 3, 128 | (код & 63));
    вернуть смещение + 4;
конец

// п стоит на открывающей кавычке. Возвращает содержимое строки без
// экранирования (результат в куче, как у других функций, возвращающих текст).
функция зос_разобрать_строку(текст с, целое п): текст
    целое закрытие = зос_конец_строки(с, п);
    если (закрытие меньше 0)
        вернуть "";
    конец
    целое i = п + 1;
    целое последний = закрытие - 1;
    текст буфер = выделить_память(последний - i + 8);
    целое выход = 0;
    пока (i меньше последний)
        целое б = целое(байт_текста(с, i));
        если (б != 92)
            записать_байт(буфер, выход, б);
            выход = выход + 1;
            i = i + 1;
        иначе
            целое е = зос_байт(с, i + 1);
            i = i + 2;
            если (е == 110)
                записать_байт(буфер, выход, 10);
                выход = выход + 1;
            иначе если (е == 116)
                записать_байт(буфер, выход, 9);
                выход = выход + 1;
            иначе если (е == 114)
                записать_байт(буфер, выход, 13);
                выход = выход + 1;
            иначе если (е == 98)
                записать_байт(буфер, выход, 8);
                выход = выход + 1;
            иначе если (е == 102)
                записать_байт(буфер, выход, 12);
                выход = выход + 1;
            иначе если (е == 117)
                целое код = зос_четыре_цифры(с, i);
                если (код меньше 0)
                    код = 63;
                    выход = зос_записать_фпю8(буфер, выход, код);
                иначе
                    i = i + 4;
                    // пара суррогатов (символы вне основного плана, например эмодзи)
                    если (код не меньше 55296 и код меньше 56320 и зос_байт(с, i) == 92 и зос_байт(с, i + 1) == 117)
                        целое младший = зос_четыре_цифры(с, i + 2);
                        если (младший не меньше 56320 и младший меньше 57344)
                            код = 65536 + ((код - 55296) << 10) + (младший - 56320);
                            i = i + 6;
                        конец
                    конец
                    выход = зос_записать_фпю8(буфер, выход, код);
                конец
            иначе
                // \" \\ \/ и всё прочее — сам символ
                записать_байт(буфер, выход, е);
                выход = выход + 1;
            конец
        конец
    конец
    записать_байт(буфер, выход, 0);
    вернуть буфер;
конец

// ------------------------------------------------------------ путь

// Позиция значения по пути или -1. Пустой путь — всё значение целиком.
функция зос_найти_позицию(текст с, текст путь): целое
    целое п = зос_пропустить_пробелы(с, 0);
    целое осталось_от = 0;
    целое длина_пути = длина(путь);
    если (длина_пути == 0)
        вернуть п;
    конец
    пока (осталось_от меньше длина_пути)
        // очередной отрезок пути до точки
        целое конец_отрезка = длина_пути;
        результат из целого точка = найти(зос_кусок(путь, осталось_от, длина_пути - осталось_от), ".");
        если (точка.успешно)
            конец_отрезка = осталось_от + точка.значение;
        конец
        текст отрезок = зос_кусок(путь, осталось_от, конец_отрезка - осталось_от);
        осталось_от = конец_отрезка + 1;

        целое б = зос_байт(с, п);
        если (б == 123)
            целое i = зос_пропустить_пробелы(с, п + 1);
            целое нашли = -1;
            пока (нашли меньше 0 и зос_байт(с, i) == 34)
                текст ключ = зос_разобрать_строку(с, i);
                целое после_ключа = зос_конец_строки(с, i);
                если (после_ключа меньше 0)
                    освободить_память(ключ);
                    вернуть -1;
                конец
                целое двоеточие = зос_пропустить_пробелы(с, после_ключа);
                если (зос_байт(с, двоеточие) != 58)
                    освободить_память(ключ);
                    вернуть -1;
                конец
                целое начало_значения = зос_пропустить_пробелы(с, двоеточие + 1);
                если (ключ == отрезок)
                    нашли = начало_значения;
                иначе
                    целое конец_значения = зос_конец_значения(с, начало_значения);
                    если (конец_значения меньше 0)
                        освободить_память(ключ);
                        вернуть -1;
                    конец
                    i = зос_пропустить_пробелы(с, конец_значения);
                    если (зос_байт(с, i) == 44)
                        i = зос_пропустить_пробелы(с, i + 1);
                    иначе
                        i = -1;
                    конец
                конец
                освободить_память(ключ);
            конец
            если (нашли меньше 0)
                вернуть -1;
            конец
            п = нашли;
        иначе если (б == 91)
            результат из целого номер = текст_в_целое(отрезок);
            если (не номер.успешно)
                вернуть -1;
            конец
            целое нужный = номер.значение;
            если (нужный меньше 0)
                вернуть -1;
            конец
            целое i = зос_пропустить_пробелы(с, п + 1);
            целое k = 0;
            целое нашли = -1;
            пока (нашли меньше 0)
                если (зос_байт(с, i) == 93 или i меньше 0)
                    вернуть -1;
                конец
                если (k == нужный)
                    нашли = i;
                иначе
                    целое конец_значения = зос_конец_значения(с, i);
                    если (конец_значения меньше 0)
                        вернуть -1;
                    конец
                    i = зос_пропустить_пробелы(с, конец_значения);
                    если (зос_байт(с, i) == 44)
                        i = зос_пропустить_пробелы(с, i + 1);
                        k = k + 1;
                    иначе
                        вернуть -1;
                    конец
                конец
            конец
            п = нашли;
        иначе
            вернуть -1;
        конец
    конец
    вернуть п;
конец

// ------------------------------------------------------------ чтение

// Корректен ли весь документ.
функция зос_верен(текст с): верно
    целое п = зос_пропустить_пробелы(с, 0);
    целое к = зос_конец_значения(с, п);
    если (к меньше 0)
        вернуть нет;
    конец
    вернуть зос_пропустить_пробелы(с, к) == длина(с);
конец

// «Сырой» ЗОС значения по пути (строка останется в кавычках, объект — с фигурными скобками).
функция зос_значение(текст с, текст путь): результат из текста
    целое п = зос_найти_позицию(с, путь);
    если (п меньше 0)
        вернуть ошибка("в ЗОС нет значения по пути '" + путь + "'");
    конец
    целое к = зос_конец_значения(с, п);
    если (к меньше 0)
        вернуть ошибка("некорректный ЗОС");
    конец
    вернуть успех(зос_кусок(с, п, к - п));
конец

// Есть ли значение по этому пути.
функция зос_есть(текст с, текст путь): верно
    целое п = зос_найти_позицию(с, путь);
    если (п меньше 0)
        вернуть нет;
    конец
    вернуть зос_конец_значения(с, п) не меньше 0;
конец

// Строка по пути, уже без экранирования. Если там не строка — ошибка.
функция зос_текст(текст с, текст путь): результат из текста
    целое п = зос_найти_позицию(с, путь);
    если (п меньше 0)
        вернуть ошибка("в ЗОС нет значения по пути '" + путь + "'");
    конец
    если (зос_байт(с, п) != 34)
        вернуть ошибка("по пути '" + путь + "' лежит не строка");
    конец
    если (зос_конец_строки(с, п) меньше 0)
        вернуть ошибка("некорректный ЗОС");
    конец
    вернуть успех(зос_разобрать_строку(с, п));
конец

// Целое число по пути.
функция зос_целое(текст с, текст путь): результат из целого
    результат из текста сырое = зос_значение(с, путь);
    если (не сырое.успешно)
        вернуть ошибка(сырое.сообщение);
    конец
    результат из целого число = текст_в_целое(сырое.значение);
    если (не число.успешно)
        вернуть ошибка("по пути '" + путь + "' лежит не целое число");
    конец
    вернуть успех(число.значение);
конец

// Дробное число по пути.
функция зос_дробное(текст с, текст путь): результат из дробного
    результат из текста сырое = зос_значение(с, путь);
    если (не сырое.успешно)
        вернуть ошибка(сырое.сообщение);
    конец
    результат из дробного число = дробное_из_текста(сырое.значение);
    если (не число.успешно)
        вернуть ошибка("по пути '" + путь + "' лежит не число");
    конец
    вернуть успех(число.значение);
конец

// Логическое значение по пути (true/false).
функция зос_логическое(текст с, текст путь): результат из целого
    результат из текста сырое = зос_значение(с, путь);
    если (не сырое.успешно)
        вернуть ошибка(сырое.сообщение);
    конец
    если (сырое.значение == "true")
        вернуть успех(1);
    конец
    если (сырое.значение == "false")
        вернуть успех(0);
    конец
    вернуть ошибка("по пути '" + путь + "' лежит не true/false");
конец

// Сколько элементов в массиве (или полей в объекте) по пути.
функция зос_размер(текст с, текст путь): результат из целого
    целое п = зос_найти_позицию(с, путь);
    если (п меньше 0)
        вернуть ошибка("в ЗОС нет значения по пути '" + путь + "'");
    конец
    целое б = зос_байт(с, п);
    если (б != 91 и б != 123)
        вернуть ошибка("по пути '" + путь + "' лежит не массив и не объект");
    конец
    целое закрывающая = 93;
    если (б == 123)
        закрывающая = 125;
    конец
    целое i = зос_пропустить_пробелы(с, п + 1);
    если (зос_байт(с, i) == закрывающая)
        вернуть успех(0);
    конец
    целое сколько = 0;
    пока (да)
        если (закрывающая == 125)
            i = зос_конец_строки(с, i);
            если (i меньше 0)
                вернуть ошибка("некорректный ЗОС");
            конец
            i = зос_пропустить_пробелы(с, i);
            i = зос_пропустить_пробелы(с, i + 1);
        конец
        i = зос_конец_значения(с, i);
        если (i меньше 0)
            вернуть ошибка("некорректный ЗОС");
        конец
        сколько = сколько + 1;
        i = зос_пропустить_пробелы(с, i);
        целое с2 = зос_байт(с, i);
        если (с2 == 44)
            i = зос_пропустить_пробелы(с, i + 1);
        иначе если (с2 == закрывающая)
            вернуть успех(сколько);
        иначе
            вернуть ошибка("некорректный ЗОС");
        конец
    конец
    вернуть успех(сколько);
конец

