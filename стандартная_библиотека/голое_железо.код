// голое_железо.код — рантайм для программ без операционной системы (сборка с флагом --без-ос).
//
// Что здесь есть:
//   • память: malloc и free (настоящий распределитель с освобождением), memcpy, memmove, memset, memcmp;
//   • строки: strlen, strcmp, strstr, strtol, strdup;
//   • вывод чисел: целые и дробные числа (знак, 6 знаков после точки) в текст и на устройство.
// Компилятор в режиме --без-ос вместо libc обращается именно к этим функциям.
//
// Что должна дать плата (одна из функций в самой программе или в модуле платы):
//   функция sfera_вывод_символа(целое32 символ)   — выводит один символ (UART, экран...)
//   sfera_куча_начало(): целое, sfera_куча_размер(): целое — область памяти под кучу
//     (на x86-64 их даёт examples/голое-железо/запуск_х86_64.s).
//
// Подключение:  подключить голое_железо;
//
// Правило этого файла: внутри нет переменных типа «текст» — только адреса-числа. Текст в языке
// освобождается автоматически, а здесь освобождать нечем, пока распределитель не заработал.

внешняя функция куча_начало(): целое как "sfera_куча_начало";
внешняя функция куча_размер(): целое как "sfera_куча_размер";

// ---------------------------------------------------------------- ячейки памяти

функция читать64(целое адрес): целое
    вернуть прочитать_целое64(указатель_по_адресу(адрес), 0);
конец

функция писать64(целое адрес, целое значение)
    записать_целое64(указатель_по_адресу(адрес), 0, значение);
конец

функция копировать_байты(целое назначение, целое источник, целое размер)
    целое инд = 0;
    пока (инд < размер)
        записать_байт(указатель_по_адресу(назначение), инд, байт_текста(указатель_по_адресу(источник), инд));
        инд = инд + 1;
    конец
конец

// ---------------------------------------------------------------- распределитель памяти
//
// Куча — последовательность блоков. У каждого 16-байтовый заголовок: размер блока вместе с заголовком;
// младший бит — «занят». Размеры кратны 16, поэтому полезные данные тоже выровнены по 16.
// malloc ищет первый подходящий свободный блок, склеивая соседние свободные, и режет лишнее.
// free помечает блок свободным. Первые 16 байт кучи — метка «куча подготовлена».

функция подготовить_кучу(целое база, целое объём)
    если (читать64(база) != 0x5346455241)
        писать64(база, 0x5346455241);
        писать64(база + 16, объём - 16);
    конец
конец

функция malloc(целое размер): текст
    целое база = куча_начало();
    целое объём = куча_размер();
    подготовить_кучу(база, объём);
    целое нужно = ((размер + 15) / 16) * 16 + 16;
    если (нужно < 32)
        нужно = 32;
    конец
    целое конец_кучи = база + объём;
    целое блок = база + 16;
    пока (блок < конец_кучи)
        целое слово = читать64(блок);
        целое занят = слово % 2;
        целое длина_блока = слово - занят;
        если (длина_блока <= 0)
            вернуть указатель_по_адресу(0);
        конец
        если (занят == 0)
            целое продолжать = 1;
            пока (продолжать == 1)
                целое следующий = блок + длина_блока;
                если (следующий >= конец_кучи)
                    продолжать = 0;
                иначе
                    целое слово_следующего = читать64(следующий);
                    если (слово_следующего % 2 == 0 и слово_следующего > 0)
                        длина_блока = длина_блока + слово_следующего;
                    иначе
                        продолжать = 0;
                    конец
                конец
            конец
            если (длина_блока >= нужно)
                если (длина_блока - нужно >= 32)
                    писать64(блок + нужно, длина_блока - нужно);
                    писать64(блок, нужно + 1);
                иначе
                    писать64(блок, длина_блока + 1);
                конец
                вернуть указатель_по_адресу(блок + 16);
            конец
            писать64(блок, длина_блока);
        конец
        блок = блок + длина_блока;
    конец
    вернуть указатель_по_адресу(0);
конец

функция free(текст указатель)
    целое адрес = адрес_текста(указатель);
    целое база = куча_начало();
    если (адрес >= база + 32 и адрес < база + куча_размер())
        целое блок = адрес - 16;
        целое слово = читать64(блок);
        если (слово % 2 == 1)
            писать64(блок, слово - 1);
        конец
    конец
конец

// ---------------------------------------------------------------- память и строки

функция memcpy(текст назначение, текст источник, целое размер): текст
    копировать_байты(адрес_текста(назначение), адрес_текста(источник), размер);
    вернуть назначение;
конец

функция memmove(текст назначение, текст источник, целое размер): текст
    целое куда = адрес_текста(назначение);
    целое откуда = адрес_текста(источник);
    если (куда <= откуда)
        копировать_байты(куда, откуда, размер);
    иначе
        целое инд = размер;
        пока (инд > 0)
            инд = инд - 1;
            записать_байт(назначение, инд, байт_текста(источник, инд));
        конец
    конец
    вернуть назначение;
конец

функция memset(текст назначение, целое32 значение, целое размер): текст
    целое инд = 0;
    пока (инд < размер)
        записать_байт(назначение, инд, значение);
        инд = инд + 1;
    конец
    вернуть назначение;
конец

функция memcmp(текст а, текст б, целое размер): целое32
    целое инд = 0;
    пока (инд < размер)
        целое32 х = байт_текста(а, инд);
        целое32 у = байт_текста(б, инд);
        если (х != у)
            вернуть х - у;
        конец
        инд = инд + 1;
    конец
    вернуть целое32(0);
конец

функция strlen(текст строка): целое
    целое н = 0;
    пока (байт_текста(строка, н) != целое32(0))
        н = н + 1;
    конец
    вернуть н;
конец

функция strcmp(текст а, текст б): целое32
    целое инд = 0;
    целое идти = 1;
    целое32 разница = целое32(0);
    пока (идти == 1)
        целое32 х = байт_текста(а, инд);
        целое32 у = байт_текста(б, инд);
        если (х != у)
            разница = х - у;
            идти = 0;
        иначе
            если (х == целое32(0))
                идти = 0;
            иначе
                инд = инд + 1;
            конец
        конец
    конец
    вернуть разница;
конец

// Первое вхождение «искомое» в «строка»: указатель на него или пустой указатель.
функция strstr(текст строка, текст искомое): текст
    целое база = адрес_текста(строка);
    целое длина_искомого = strlen(искомое);
    целое длина_строки = strlen(строка);
    целое с = 0;
    пока (с + длина_искомого <= длина_строки)
        если (memcmp(указатель_по_адресу(база + с), искомое, длина_искомого) == целое32(0))
            вернуть указатель_по_адресу(база + с);
        конец
        с = с + 1;
    конец
    вернуть указатель_по_адресу(0);
конец

// Разбор целого числа (основание 10). Конец разбора записывается в «конец», если он не пустой.
функция strtol(текст строка, текст конец_разбора, целое32 основание): целое
    целое база = адрес_текста(строка);
    целое с = 0;
    пока (байт_текста(строка, с) == целое32(32) или байт_текста(строка, с) == целое32(9))
        с = с + 1;
    конец
    целое знак = 1;
    если (байт_текста(строка, с) == целое32(45))
        знак = 0 - 1;
        с = с + 1;
    иначе
        если (байт_текста(строка, с) == целое32(43))
            с = с + 1;
        конец
    конец
    целое итог = 0;
    целое идти = 1;
    пока (идти == 1)
        целое32 б = байт_текста(строка, с);
        если (б >= целое32(48) и б <= целое32(57))
            итог = итог * 10 + целое(б - целое32(48));
            с = с + 1;
        иначе
            идти = 0;
        конец
    конец
    если (адрес_текста(конец_разбора) != 0)
        писать64(адрес_текста(конец_разбора), база + с);
    конец
    вернуть итог * знак;
конец

функция strdup(текст строка): текст
    целое н = strlen(строка) + 1;
    целое новый = адрес_текста(malloc(н));
    если (новый != 0)
        копировать_байты(новый, адрес_текста(строка), н);
    конец
    вернуть указатель_по_адресу(новый);
конец

// ---------------------------------------------------------------- числа в текст и на устройство
//
// «режим» 0 — символы уходят на устройство (sfera_вывод_символа), режим 1 — записываются в буфер.

функция выдать_байт(целое режим, целое буфер, целое смещение, целое32 символ): целое
    если (режим == 0)
        sfera_вывод_символа(символ);
    иначе
        записать_байт(указатель_по_адресу(буфер), смещение, символ);
    конец
    вернуть смещение + 1;
конец

// Беззнаковое число десятичными цифрами; «минимум» — сколько цифр писать как минимум (с нулями слева).
функция выдать_цифры(целое режим, целое буфер, целое смещение, беззнак64 число, целое минимум): целое
    беззнак64 делитель = беззнак64(1);
    целое знаков = 1;
    пока (число / делитель >= беззнак64(10))
        делитель = делитель * беззнак64(10);
        знаков = знаков + 1;
    конец
    пока (знаков < минимум)
        смещение = выдать_байт(режим, буфер, смещение, целое32(48));
        знаков = знаков + 1;
    конец
    пока (делитель > беззнак64(0))
        беззнак64 цифра = число / делитель;
        число = число - цифра * делитель;
        делитель = делитель / беззнак64(10);
        смещение = выдать_байт(режим, буфер, смещение, целое32(48) + целое32(цифра));
    конец
    вернуть смещение;
конец

функция выдать_целое(целое режим, целое буфер, целое смещение, целое значение): целое
    если (значение < 0)
        смещение = выдать_байт(режим, буфер, смещение, целое32(45));
        вернуть выдать_цифры(режим, буфер, смещение, беззнак64(0 - значение), 1);
    конец
    вернуть выдать_цифры(режим, буфер, смещение, беззнак64(значение), 1);
конец

функция выдать_слово(целое режим, целое буфер, целое смещение, целое32 а, целое32 б, целое32 в2): целое
    смещение = выдать_байт(режим, буфер, смещение, а);
    смещение = выдать_байт(режим, буфер, смещение, б);
    вернуть выдать_байт(режим, буфер, смещение, в2);
конец

// Дробное число как «%f»: знак, целая часть, точка, 6 знаков (с округлением).
функция выдать_дробное(целое режим, целое буфер, целое смещение, дробное число): целое
    если (число != число)
        вернуть выдать_слово(режим, буфер, смещение, целое32(110), целое32(97), целое32(110));
    конец
    дробное модуль = число;
    если (число < 0.0)
        смещение = выдать_байт(режим, буфер, смещение, целое32(45));
        модуль = 0.0 - число;
    конец
    если (модуль > 9000000000000000000.0)
        вернуть выдать_слово(режим, буфер, смещение, целое32(105), целое32(110), целое32(102));
    конец
    целое целая = целое(модуль);
    дробное остаток = модуль - дробное(целая);
    целое доля = целое(остаток * 1000000.0 + 0.5);
    если (доля >= 1000000)
        целая = целая + 1;
        доля = доля - 1000000;
    конец
    смещение = выдать_цифры(режим, буфер, смещение, беззнак64(целая), 1);
    смещение = выдать_байт(режим, буфер, смещение, целое32(46));
    вернуть выдать_цифры(режим, буфер, смещение, беззнак64(доля), 6);
конец

функция sfera_целое_в_буфер(текст буфер, целое размер, целое значение)
    целое конец_записи = выдать_целое(1, адрес_текста(буфер), 0, значение);
    записать_байт(буфер, конец_записи, 0);
конец

функция sfera_дробное_в_буфер(текст буфер, целое размер, дробное значение)
    целое конец_записи = выдать_дробное(1, адрес_текста(буфер), 0, значение);
    записать_байт(буфер, конец_записи, 0);
конец

функция sfera_вывод_текста(текст строка)
    целое инд = 0;
    пока (байт_текста(строка, инд) != целое32(0))
        sfera_вывод_символа(байт_текста(строка, инд));
        инд = инд + 1;
    конец
    sfera_вывод_символа(целое32(10));
конец

функция sfera_вывод_целого(целое значение)
    выдать_целое(0, 0, 0, значение);
    sfera_вывод_символа(целое32(10));
конец

функция sfera_вывод_дробного(дробное значение)
    выдать_дробное(0, 0, 0, значение);
    sfera_вывод_символа(целое32(10));
конец

// Выводит текст без перевода строки.
функция вывести_текст(текст т)
    целое номер = 0;
    пока (номер < длина(т))
        sfera_вывод_символа(целое32(байт_текста(т, номер)));
        номер = номер + 1;
    конец
конец
