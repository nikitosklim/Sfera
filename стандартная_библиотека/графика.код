// Рисует текст на холсте в позиции (х, у) заданным шрифтом и цветом.
// Собирает воедино весь путь: рендер в поверхность -> текстура -> копия
// на холст с нужным размером (запрошенным у самой текстуры).
функция нарисовать_текст(текст холст, текст шрифт, текст строка, целое32 х, целое32 у, беззнак32 цвет) -> целое32 {
    текст поверхность = отрисовать_текст(шрифт, строка, цвет);
    текст текстура = создать_текстуру(холст, поверхность);

    текст буфер_ширины = выделить_память(4);
    текст буфер_высоты = выделить_память(4);
    узнать_размер_текстуры(текстура, нулевой_указатель(), нулевой_указатель(), буфер_ширины, буфер_высоты);
    целое32 ширина = прочитать_целое32(буфер_ширины, 0);
    целое32 высота = прочитать_целое32(буфер_высоты, 0);

    текст область_назначения = выделить_память(16);
    записать_целое32(область_назначения, 0, х);
    записать_целое32(область_назначения, 4, у);
    записать_целое32(область_назначения, 8, ширина);
    записать_целое32(область_назначения, 12, высота);

    целое32 итог = показать_текстуру(холст, текстура, нулевой_указатель(), область_назначения);

    освободить_поверхность(поверхность);
    уничтожить_текстуру(текстура);

    вернуть итог;
}

// НОВОЕ: картинка с ЗАДАННЫМ размером на экране (масштабирование под
// нужную область — например, под размер кнопки или иконки навбара,
// независимо от исходного размера файла). Загружает заново при каждом
// вызове — для статичного UI (иконки навбара, редко меняющиеся
// картинки) это приемлемо; для картинки, перерисовываемой каждый
// кадр в цикле анимации, честно эффективнее загрузить один раз и
// переиспользовать текстуру — этот, более быстрый путь даёт
// нарисовать_картинку_текстурой ниже.
функция нарисовать_картинку(текст холст, текст путь_к_файлу, целое32 х, целое32 у, целое32 ширина, целое32 высота) -> целое32 {
    текст поверхность = загрузить_картинку(путь_к_файлу);
    текст текстура = создать_текстуру(холст, поверхность);

    текст область_назначения = выделить_память(16);
    записать_целое32(область_назначения, 0, х);
    записать_целое32(область_назначения, 4, у);
    записать_целое32(область_назначения, 8, ширина);
    записать_целое32(область_назначения, 12, высота);

    целое32 итог = показать_текстуру(холст, текстура, нулевой_указатель(), область_назначения);

    освободить_поверхность(поверхность);
    уничтожить_текстуру(текстура);

    вернуть итог;
}

// НОВОЕ: более быстрый путь для картинки, рисуемой много раз подряд
// (анимация, повторяющийся кадр) — принимает уже готовую текстуру
// (загруженную один раз через загрузить_картинку+создать_текстуру,
// до начала цикла отрисовки), не грузит файл заново на каждый вызов.
функция нарисовать_картинку_текстурой(текст холст, текст текстура, целое32 х, целое32 у, целое32 ширина, целое32 высота) -> целое32 {
    текст область_назначения = выделить_память(16);
    записать_целое32(область_назначения, 0, х);
    записать_целое32(область_назначения, 4, у);
    записать_целое32(область_назначения, 8, ширина);
    записать_целое32(область_назначения, 12, высота);

    вернуть показать_текстуру(холст, текстура, нулевой_указатель(), область_назначения);
}

// Коды типов событий и константы, нужные для их разбора (проверены через C):
//   закрытие_окна = 256, клик_мыши = 1025, ввод_текста = 771, нажатие_клавиши = 768
// Смещения полей внутри события о клике мыши (совпадающего по началу с
// общей структурой события): тип=0, кнопка=16, состояние=17, х=20, у=24.
// Смещения полей внутри события о вводе текста: тип=0, сам текст=12 (готовая
// null-terminated UTF-8 строка — читается через прочитать_текст_по_смещению,
// не прочитать_целое32, поскольку это текст, а не число).
// Смещения полей внутри события о нажатии клавиши: тип=0, код_клавиши=20
// (Sint32 — обычное число, читается через прочитать_целое32).
// Коды специальных клавиш (не порождающих событие ввода текста):
//   backspace = 8, enter = 13, escape = 27

// НОВОЕ: строгий, табличный стиль UI (по образцу Excel/1C) — вместо ярких
// скруглённых кнопок. Произвольное число колонок (ширины — Список<целое>),
// каждая строка получает тонкую серую границу, разделители между
// колонками и чередующийся (полосатый) фон для читаемости — тот же
// приём, что в любой настоящей таблице данных.
структура Таблица {
    целое32 х;
    целое32 у;
    Список<целое> ширины_колонок;
    целое32 высота_строки;

    // Суммарная ширина всех колонок вместе — используется и для заливки
    // фона строки/заголовка, и для верхней/боковой границы таблицы.
    функция общая_ширина() -> целое32 {
        // ⚠️ НАЙДЕНО ПРИ РЕАЛЬНОМ ТЕСТИРОВАНИИ: "это.поле.метод()" — цепочка
        // доступа к полю-списку с немедленным вызовом метода — компилятор
        // пока не поддерживает (требует, чтобы каждый промежуточный шаг
        // цепочки был структурой, а Список<T> устроен иначе). Обходной путь
        // без изменений компилятора — сначала прочитать поле в локальную
        // переменную, вызывать методы уже у неё.
        Список<целое> колонки = это.ширины_колонок;
        целое32 сумма = целое32(0);
        целое индекс = 0;
        пока (индекс < колонки.размер()) {
            сумма = сумма + целое32(колонки.получить(индекс));
            индекс = индекс + 1;
        }
        вернуть сумма;
    }

    // Рисует вертикальные разделители между соседними колонками (не
    // после последней — там уже общая правая граница) — общий, частный
    // метод, используемый и заголовком, и обычными строками.
    функция нарисовать_разделители_колонок(текст холст, целое32 у_строки) -> целое32 {
        Список<целое> колонки = это.ширины_колонок;
        задать_цвет(холст, 200, 200, 200, 255);
        целое32 смещение_x = это.х;
        целое индекс = 0;
        пока (индекс < колонки.размер()) {
            смещение_x = смещение_x + целое32(колонки.получить(индекс));
            если (индекс < колонки.размер() - 1) {
                нарисовать_линию(холст, смещение_x, у_строки, смещение_x, у_строки + это.высота_строки);
            }
            индекс = индекс + 1;
        }
        вернуть целое32(0);
    }

    // Рисует одну строку данных — "значения" должен содержать РОВНО
    // столько элементов, сколько колонок в таблице. "чётная" определяет
    // чередование фона — передавай (номер_строки % 2 == 0).
    функция нарисовать_строку(текст холст, текст шрифт, целое32 номер_строки, Список<текст> значения, верно чётная) -> целое32 {
        целое32 у_строки = это.у + номер_строки * это.высота_строки;
        целое32 ширина_всего = это.общая_ширина();

        если (чётная) {
            задать_цвет(холст, 245, 245, 245, 255);
        } иначе {
            задать_цвет(холст, 255, 255, 255, 255);
        }
        нарисовать_прямоугольник(холст, это.х, у_строки, ширина_всего, это.высота_строки);

        задать_цвет(холст, 200, 200, 200, 255);
        нарисовать_линию(холст, это.х, у_строки, это.х + ширина_всего, у_строки);
        это.нарисовать_разделители_колонок(холст, у_строки);

        // Текст каждой колонки — тёмно-серый, не чисто чёрный (мягче для
        // глаз, тот же выбор, что у большинства настоящих таблиц данных).
        Список<целое> колонки = это.ширины_колонок;
        целое32 смещение_x = это.х;
        целое индекс = 0;
        пока (индекс < колонки.размер()) {
            текст значение = значения.получить(индекс);
            нарисовать_текст(холст, шрифт, значение, смещение_x + целое32(8), у_строки + целое32(6), 4282729797);
            смещение_x = смещение_x + целое32(колонки.получить(индекс));
            индекс = индекс + 1;
        }

        вернуть целое32(0);
    }

    // Рисует строку заголовка — более тёмный фон, текст белым.
    функция нарисовать_заголовок(текст холст, текст шрифт, Список<текст> заголовки) -> целое32 {
        целое32 ширина_всего = это.общая_ширина();

        задать_цвет(холст, 60, 70, 90, 255);
        нарисовать_прямоугольник(холст, это.х, это.у, ширина_всего, это.высота_строки);
        это.нарисовать_разделители_колонок(холст, это.у);

        Список<целое> колонки = это.ширины_колонок;
        целое32 смещение_x = это.х;
        целое индекс = 0;
        пока (индекс < колонки.размер()) {
            текст значение = заголовки.получить(индекс);
            нарисовать_текст(холст, шрифт, значение, смещение_x + целое32(8), это.у + целое32(6), 4294967295);
            смещение_x = смещение_x + целое32(колонки.получить(индекс));
            индекс = индекс + 1;
        }

        вернуть целое32(0);
    }
}

// НОВОЕ: первый настоящий виджет UI — кнопка. Никаких новых привязок к
// SDL2 не понадобилось: кнопка — это просто прямоугольник (уже умеем
// рисовать) плюс логика "попадает ли точка в его границы" (обычная
// арифметика самого языка Сфера). Именно так и должны строиться более
// сложные элементы интерфейса поверх низкоуровневых примитивов библиотеки.
// НОВОЕ: реальный размер окна в рантайме — узнан у самой ОС, а не
// предположен заранее (see объяснение назначения у объявления
// "узнать_размер_окна_сырое" выше). Нужен для якорей — без этого
// "прикрепить к низу экрана" физически невозможно сделать честно:
// придётся либо угадывать число, либо спросить у ОС.
структура РазмерЭкрана {
    целое32 ширина;
    целое32 высота;
}

функция размер_окна(текст окно) -> РазмерЭкрана {
    текст буфер_ширины = выделить_память(4);
    текст буфер_высоты = выделить_память(4);
    узнать_размер_окна_сырое(окно, буфер_ширины, буфер_высоты);
    целое32 ширина = прочитать_целое32(буфер_ширины, 0);
    целое32 высота = прочитать_целое32(буфер_высоты, 0);
    освободить_память(буфер_ширины);
    освободить_память(буфер_высоты);
    вернуть РазмерЭкрана(ширина, высота);
}

структура Кнопка {
    целое32 х;
    целое32 у;
    целое32 ширина;
    целое32 высота;
    беззнак8 цвет_к;
    беззнак8 цвет_з;
    беззнак8 цвет_с;
    // НОВОЕ: подпись кнопки — пустая строка означает "без текста" (тогда
    // ведёт себя как раньше, просто цветной прямоугольник).
    текст подпись;

    // Проверяет, попадает ли точка (например, координаты клика мыши) в
    // границы кнопки — включая левый/верхний край, исключая правый/нижний
    // (тот же принцип, что и в большинстве графических библиотек).
    функция содержит_точку(целое32 точка_х, целое32 точка_у) -> верно {
        вернуть точка_х >= это.х && точка_х < это.х + это.ширина
            && точка_у >= это.у && точка_у < это.у + это.высота;
    }

    // Рисует кнопку на холсте — заливка её цветом со скруглёнными углами
    // (современный вид вместо резких прямых углов), затем, если подпись
    // не пустая, белый текст по центру. "шрифт" — отдельный параметр, не
    // поле структуры: шрифт загружается один раз для всего приложения,
    // не для каждой кнопки отдельно.
    функция нарисовать(текст холст, текст шрифт) -> целое32 {
        задать_цвет(холст, это.цвет_к, это.цвет_з, это.цвет_с, 255);
        целое32 итог = нарисовать_скруглённый_прямоугольник(холст, это.х, это.у, это.ширина, это.высота, целое32(10));

        если (длина(это.подпись) > 0) {
            текст поверхность = отрисовать_текст(шрифт, это.подпись, беззнак32(4294967295));
            текст текстура = создать_текстуру(холст, поверхность);

            текст буфер_ширины = выделить_память(4);
            текст буфер_высоты = выделить_память(4);
            узнать_размер_текстуры(текстура, нулевой_указатель(), нулевой_указатель(), буфер_ширины, буфер_высоты);
            целое32 ширина_текста = прочитать_целое32(буфер_ширины, 0);
            целое32 высота_текста = прочитать_целое32(буфер_высоты, 0);

            целое32 х_текста = это.х + (это.ширина - ширина_текста) / целое32(2);
            целое32 у_текста = это.у + (это.высота - высота_текста) / целое32(2);

            текст область_назначения = выделить_память(16);
            записать_целое32(область_назначения, 0, х_текста);
            записать_целое32(область_назначения, 4, у_текста);
            записать_целое32(область_назначения, 8, ширина_текста);
            записать_целое32(область_назначения, 12, высота_текста);
            показать_текстуру(холст, текстура, нулевой_указатель(), область_назначения);

            освободить_поверхность(поверхность);
            уничтожить_текстуру(текстура);
        }

        вернуть итог;
    }
}

// НОВОЕ: панель — фон на всю ширину (верхний или нижний навбар, боковое
// меню, любая полоса интерфейса) плюс произвольный набор кнопок внутри.
// Позиции самих кнопок панель не вычисляет автоматически — каждая
// кнопка уже несёт свои собственные х/у/ширина/высота (та же логика,
// что и для отдельных кнопок вне панели) — панель просто рисует фон,
// затем каждую кнопку из своего списка по очереди.
структура Панель {
    целое32 х;
    целое32 у;
    целое32 ширина;
    целое32 высота;
    беззнак8 цвет_к;
    беззнак8 цвет_з;
    беззнак8 цвет_с;
    Список<Кнопка> кнопки;

    // Рисует фон панели, затем все кнопки внутри неё по очереди.
    функция нарисовать(текст холст, текст шрифт) -> целое32 {
        задать_цвет(холст, это.цвет_к, это.цвет_з, это.цвет_с, 255);
        целое32 итог = нарисовать_прямоугольник(холст, это.х, это.у, это.ширина, это.высота);

        Список<Кнопка> список_кнопок = это.кнопки;
        целое индекс = 0;
        пока (индекс < список_кнопок.размер()) {
            Кнопка кнопка = список_кнопок.получить(индекс);
            кнопка.нарисовать(холст, шрифт);
            индекс = индекс + 1;
        }

        вернуть итог;
    }

    // Возвращает индекс кнопки, в которую попадает точка (клик) — или -1,
    // если точка не попала ни в одну кнопку панели. Тот же приём, что уже
    // используется в отдельных кнопках (содержит_точку), только сразу по
    // всему списку — удобно для обработки клика по навбару одним вызовом.
    функция кнопка_под_точкой(целое32 точка_х, целое32 точка_у) -> целое32 {
        Список<Кнопка> список_кнопок = это.кнопки;
        целое индекс = 0;
        пока (индекс < список_кнопок.размер()) {
            Кнопка кнопка = список_кнопок.получить(индекс);
            если (кнопка.содержит_точку(точка_х, точка_у)) {
                вернуть целое32(индекс);
            }
            индекс = индекс + 1;
        }
        вернуть целое32(-1);
    }

    // НОВОЕ (якоря — адаптивное расположение UI под реальный размер
    // экрана, взамен жёстко угаданных чисел вроде "целое32(630)"):
    // ставит нижний край панели ровно у нижнего края экрана (минус
    // отступ) — вместо предположения заранее, каким будет размер окна.
    //
    // ⚠️ Честно: кнопки внутри панели хранят СВОИ СОБСТВЕННЫЕ, абсолютные
    // координаты, не относительные к панели (см. объяснение у структуры
    // Панель выше) — просто передвинуть это.у здесь было бы недостаточно,
    // кнопки остались бы на старом месте. Метод сдвигает панель И каждую
    // её кнопку на одну и ту же разницу, чтобы взаимное расположение
    // (кнопка была на 15 пикселей ниже верха панели — осталась на 15
    // пикселей ниже и после сдвига) сохранилось.
    функция закрепить_снизу(РазмерЭкрана размер, целое32 отступ_снизу) -> целое {
        целое32 новое_у = размер.высота - это.высота - отступ_снизу;
        целое32 разница = новое_у - это.у;
        это.у = новое_у;

        Список<Кнопка> список_кнопок = это.кнопки;
        целое индекс = 0;
        пока (индекс < список_кнопок.размер()) {
            Кнопка кнопка = список_кнопок.получить(индекс);
            кнопка.у = кнопка.у + разница;
            индекс = индекс + 1;
        }
        вернуть 0;
    }

    // Симметричный якорь для верха экрана — для верхнего навбара обычно
    // не нужен (там и так естественно у=0 подходит), но полезен, когда
    // нужен отступ под системную область (вырез камеры, статус-бар).
    функция закрепить_сверху(целое32 отступ_сверху) -> целое {
        целое32 разница = отступ_сверху - это.у;
        это.у = отступ_сверху;

        Список<Кнопка> список_кнопок = это.кнопки;
        целое индекс = 0;
        пока (индекс < список_кнопок.размер()) {
            Кнопка кнопка = список_кнопок.получить(индекс);
            кнопка.у = кнопка.у + разница;
            индекс = индекс + 1;
        }
        вернуть 0;
    }

    // Растягивает фон панели на всю ширину экрана — для случаев, когда
    // реальное устройство шире/уже, чем ширина, заложенная при создании
    // окна (панель без этого выглядела бы обрезанной сбоку или не
    // доходящей до края на непредвиденных соотношениях сторон экрана).
    //
    // ⚠️ Честно, узкое ограничение: растягивает только фон САМОЙ панели —
    // не переставляет и не растягивает кнопки внутри неё (это уже
    // отдельная, более сложная задача — "распределить N кнопок равномерно
    // по новой ширине" — оставлена для будущего, если понадобится).
    функция растянуть_по_ширине(РазмерЭкрана размер) -> целое {
        это.ширина = размер.ширина;
        вернуть 0;
    }
}

// НОВОЕ: UTF-8-осознанное удаление последнего СИМВОЛА (не байта) из текста
// — нужно для клавиши Backspace в текстовом поле ввода. Язык "Сфера"
// полностью кириллический, а кириллица занимает 2 байта на символ в UTF-8
// — простое "удалить последний байт" оставляло бы битую, нечитаемую
// половину буквы. Идёт с конца строки, пропуская байты-продолжения
// (0x80-0xBF, старшие два бита равны "10"), пока не найдёт байт начала
// символа — это и есть точка, откуда нужно "обрезать" строку.
функция удалить_последний_символ(текст строка) -> текст {
    целое длина_строки = длина(строка);
    если (длина_строки == 0) {
        вернуть "";
    }

    целое индекс = длина_строки - 1;
    пока (индекс > 0 && (байт_текста(строка, индекс) & целое32(192)) == целое32(128)) {
        // (байт & 0xC0) == 0x80 значит "байт-продолжение UTF-8-символа" —
        // ещё не дошли до начала последнего символа, идём дальше назад.
        индекс = индекс - 1;
    }

    результат<текст> итог = подстрока(строка, 0, индекс);
    если (итог.успешно) {
        вернуть итог.значение;
    }
    вернуть "";
}

// НОВОЕ: текстовое поле ввода — фон со скруглёнными углами (тот же
// внешний вид, что и у Кнопка), поверх которого рисуется введённый текст
// и мигающий текстовый курсор. Само поле НЕ подписывается на события
// самостоятельно — программа сама решает, когда вызывать
// добавить_текст/удалить_символ, реагируя на события ввод_текста/
// нажатие_клавиши в своём собственном цикле (см. ДОКУМЕНТАЦИЯ_ЯЗЫКА.md,
// раздел "Графика и UI").
структура ПолеВвода {
    целое32 х;
    целое32 у;
    целое32 ширина;
    целое32 высота;
    беззнак8 цвет_фона_к;
    беззнак8 цвет_фона_з;
    беззнак8 цвет_фона_с;
    текст содержимое;
    // Есть ли у ПОЛЯ фокус прямо сейчас — рисует курсор, только когда
    // верно (не более одного активного поля разом решает сама программа,
    // например, при клике по другому полю).
    верно в_фокусе;

    функция содержит_точку(целое32 точка_х, целое32 точка_у) -> верно {
        вернуть точка_х >= это.х && точка_х < это.х + это.ширина
            && точка_у >= это.у && точка_у < это.у + это.высота;
    }

    // Дописывает кусочек текста в конец содержимого — вызывается прямо
    // тем текстом, что пришёл в событии "ввод_текста" (см. прочитать_текст_по_смещению
    // со смещением 12 — уже готовая, декодированная UTF-8 строка).
    функция добавить_текст(текст новый_кусок) -> целое {
        это.содержимое = это.содержимое + новый_кусок;
        вернуть 0;
    }

    // Удаляет последний символ (не байт — см. удалить_последний_символ
    // выше) — вызывается в ответ на код клавиши Backspace (8).
    функция удалить_символ() -> целое {
        это.содержимое = удалить_последний_символ(это.содержимое);
        вернуть 0;
    }

    // Рисует фон, затем текст поверх него (если поле не пустое), затем,
    // если поле сейчас в фокусе, простой мигающий курсор сразу после
    // текста. "кадр" — счётчик кадров текущего запуска программы, тот же,
    // что уже используется в основном цикле отрисовки — используется
    // только для мигания курсора (каждые примерно пол секунды при 30
    // кадрах в секунду), не хранится самим полем.
    функция нарисовать(текст холст, текст шрифт, целое кадр) -> целое32 {
        задать_цвет(холст, это.цвет_фона_к, это.цвет_фона_з, это.цвет_фона_с, 255);
        целое32 итог = нарисовать_скруглённый_прямоугольник(холст, это.х, это.у, это.ширина, это.высота, целое32(6));

        целое32 х_текста = это.х + целое32(10);
        если (длина(это.содержимое) > 0) {
            текст поверхность = отрисовать_текст(шрифт, это.содержимое, беззнак32(4278190080));
            текст текстура = создать_текстуру(холст, поверхность);

            текст буфер_ширины = выделить_память(4);
            текст буфер_высоты = выделить_память(4);
            узнать_размер_текстуры(текстура, нулевой_указатель(), нулевой_указатель(), буфер_ширины, буфер_высоты);
            целое32 ширина_текста = прочитать_целое32(буфер_ширины, 0);
            целое32 высота_текста = прочитать_целое32(буфер_высоты, 0);
            целое32 у_текста = это.у + (это.высота - высота_текста) / целое32(2);

            текст область_назначения = выделить_память(16);
            записать_целое32(область_назначения, 0, х_текста);
            записать_целое32(область_назначения, 4, у_текста);
            записать_целое32(область_назначения, 8, ширина_текста);
            записать_целое32(область_назначения, 12, высота_текста);
            показать_текстуру(холст, текстура, нулевой_указатель(), область_назначения);

            х_текста = х_текста + ширина_текста + целое32(2);

            освободить_поверхность(поверхность);
            уничтожить_текстуру(текстура);
        }

        если (это.в_фокусе && (кадр / 15) % 2 == 0) {
            задать_цвет(холст, беззнак8(60), беззнак8(60), беззнак8(60), беззнак8(255));
            нарисовать_прямоугольник(холст, х_текста, это.у + целое32(8), целое32(2), это.высота - целое32(16));
        }

        вернуть итог;
    }
}
