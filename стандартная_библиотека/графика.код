// подряд в памяти (х, у, ширина, высота, по 4 байта каждое, итого 16 байт)
// — "собираем" эту структуру вручную через записать_целое32, вместо того
// чтобы добавлять в язык полноценную поддержку "C-совместимых структур".
//
// НОВОЕ: для рисования скруглённых углов кнопок — растеризация четверти
// окружности по строкам требует квадратного корня, которого нет как
// встроенной функции языка — привязываемся напрямую к libm.
внешняя функция квадратный_корень(дробное х) -> дробное как "sqrt";

// Обычная функция САМОГО ЯЗЫКА (не "внешняя") — показывает, как строить
// удобный, кириллический API поверх низкоуровневых примитивов.
функция нарисовать_прямоугольник(текст холст, целое32 х, целое32 у, целое32 ширина, целое32 высота) -> целое32 {
    текст прямоугольник = выделить_память(16);
    записать_целое32(прямоугольник, 0, х);
    записать_целое32(прямоугольник, 4, у);
    записать_целое32(прямоугольник, 8, ширина);
    записать_целое32(прямоугольник, 12, высота);
    вернуть закрасить_область(холст, прямоугольник);
}

функция обвести_прямоугольник(текст холст, целое32 х, целое32 у, целое32 ширина, целое32 высота) -> целое32 {
