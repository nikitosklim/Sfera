// НОВОЕ: скруглённый прямоугольник — современный вид кнопок вместо
// обычных резких углов. Алгоритм: заливаем "крестовину" (центр без
// углов) обычными прямоугольниками, затем для каждого из четырёх углов
// растеризуем четверть окружности построчно (для каждой строки отступа
// от края вычисляем, докуда должна доходить закраска через теорему
// Пифагора — sqrt(r² - (r-i)²)) — тот же принцип, каким любая
// компьютерная графика превращает окружность в набор пикселей.
функция нарисовать_скруглённый_прямоугольник(текст холст, целое32 x, целое32 y, целое32 ширина, целое32 высота, целое32 радиус) -> целое32 {
    нарисовать_прямоугольник(холст, x + радиус, y, ширина - радиус * целое32(2), высота);
    нарисовать_прямоугольник(холст, x, y + радиус, радиус, высота - радиус * целое32(2));
    нарисовать_прямоугольник(холст, x + ширина - радиус, y + радиус, радиус, высота - радиус * целое32(2));

    дробное r_дробное = дробное(радиус);
    целое32 i = целое32(0);
    пока (i < радиус) {
        дробное di = дробное(радиус - i - целое32(1));
        дробное под_корнем = r_дробное * r_дробное - di * di;
        если (под_корнем < 0.0) {
            под_корнем = 0.0;
        }
        целое32 ширина_дуги = целое32(квадратный_корень(под_корнем));

        нарисовать_прямоугольник(холст, x + радиус - ширина_дуги, y + i, ширина_дуги, целое32(1));
        нарисовать_прямоугольник(холст, x + ширина - радиус, y + i, ширина_дуги, целое32(1));
        нарисовать_прямоугольник(холст, x + радиус - ширина_дуги, y + высота - i - целое32(1), ширина_дуги, целое32(1));
        нарисовать_прямоугольник(холст, x + ширина - радиус, y + высота - i - целое32(1), ширина_дуги, целое32(1));

        i = i + целое32(1);
    }

    вернуть целое32(0);
}

