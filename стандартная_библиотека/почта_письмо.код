// почта_письмо.код — разбор письма: заголовки, текст, вложения.
//
// Подключается как "подключить почта_письмо;". Работает только с текстом письма
// (то, что сервер отдаёт целиком), сети не касается. Все позиции — в байтах.
//
//   разобрать_письмо(текст сырое): Письмо
//   освободить_письмо(Письмо п)         — освобождает данные вложений
//   значение_заголовка(текст заголовки, текст имя): текст
//
// Что понимает разбор: заголовки с переносами и «словами» (=?UTF-8?B?…?=), письма из
// нескольких частей (multipart) любой вложенности, кодирование частей «основание 64»
// и «печатаемое с экранированием», кодировки UTF-8, windows-1251, КОИ8-Р, имена вложений
// в обычной записи и в записи RFC 2231 (filename*=UTF-8''…). Письмо только из
// HTML превращается в текст вырезанием тегов.

подключить почта_кодирование;

структура Вложение
    текст имя;
    текст тип;
    целое адрес;
    целое размер;
конец

структура Письмо
    текст от_кого;
    текст кому;
    текст тема;
    текст дата;
    текст тело;
    верно тело_из_html;
    Список из Вложение вложения;
конец

// ---------------------------------------------------------------- мелочи с текстом

// Безопасный срез: за границы текста не выходит, при ошибке — пустой текст.
функция часть(текст т, целое от, целое сколько): текст
    целое n = длина(т);
    если (от < 0)
        от = 0;
    конец
    если (от >= n или сколько <= 0)
        вернуть "";
    конец
    если (от + сколько > n)
        сколько = n - от;
    конец
    результат из текста р = подстрока(т, от, сколько);
    если (р.успешно)
        вернуть р.значение;
    конец
    вернуть "";
конец

// Позиция первого вхождения «что» начиная с «от»; -1, если нет.
функция найти_от(текст т, текст что, целое от): целое
    если (от >= длина(т))
        вернуть -1;
    конец
    результат из целого р = найти(часть(т, от, длина(т) - от), что);
    если (р.успешно)
        вернуть от + р.значение;
    конец
    вернуть -1;
конец

функция пробельный(целое б): верно
    вернуть б == 32 или б == 9 или б == 13 или б == 10;
конец

// Убирает пробелы, табуляции и переводы строк по краям.
функция обрезать(текст т): текст
    целое от = 0;
    целое до = длина(т);
    пока (от < до и пробельный(целое(байт_текста(т, от))))
        от = от + 1;
    конец
    пока (до > от и пробельный(целое(байт_текста(т, до - 1))))
        до = до - 1;
    конец
    вернуть часть(т, от, до - от);
конец

функция начинается_с(текст т, текст префикс): верно
    вернуть часть(т, 0, длина(префикс)) == префикс;
конец

// ---------------------------------------------------------------- заголовки

// Делит письмо на заголовки и тело по первой пустой строке. Возвращает позицию начала тела
// (или длину текста, если пустой строки нет); заголовки — до позиции конца_заголовков.
функция граница_заголовков(текст т): Список из целых
    Список из целых р = Список из целых();
    целое а = найти_от(т, "\r\n\r\n", 0);
    целое б = найти_от(т, "\n\n", 0);
    если (а >= 0 и (б < 0 или а <= б))
        р.добавить(а);
        р.добавить(а + 4);
        вернуть р;
    конец
    если (б >= 0)
        р.добавить(б);
        р.добавить(б + 2);
        вернуть р;
    конец
    р.добавить(длина(т));
    р.добавить(длина(т));
    вернуть р;
конец

// Значение заголовка по имени (без учёта регистра), с учётом переносов строк.
// Нет такого заголовка — пустой текст.
функция значение_заголовка(текст заголовки, текст имя): текст
    текст нужное = нижний_латинский(имя) + ":";
    целое n = длина(заголовки);
    целое i = 0;
    пока (i < n)
        целое конец_строки = найти_от(заголовки, "\n", i);
        если (конец_строки < 0)
            конец_строки = n
        конец
        текст строка = часть(заголовки, i, конец_строки - i);
        если (начинается_с(нижний_латинский(строка), нужное))
            текст значение = часть(строка, длина(нужное), длина(строка));
            // строки-продолжения начинаются с пробела или табуляции
            целое j = конец_строки + 1;
            пока (j < n)
                целое первый = целое(байт_текста(заголовки, j));
                если (первый != 32 и первый != 9)
                    прервать;
                конец
                целое конец2 = найти_от(заголовки, "\n", j);
                если (конец2 < 0)
                    конец2 = n
                конец
                значение = значение + " " + обрезать(часть(заголовки, j, конец2 - j));
                j = конец2 + 1;
            конец
            вернуть обрезать(значение);
        конец
        i = конец_строки + 1;
    конец
    вернуть "";
конец

// Значение параметра в строке вида «text/plain; charset="utf-8"; name=файл».
// Понимает кавычки и запись RFC 2231 (имя*=UTF-8''%D0%…).
функция параметр_заголовка(текст значение, текст имя): текст
    текст маленькое = нижний_латинский(значение);
    текст нужное = нижний_латинский(имя);
    целое n = длина(значение);
    // сначала запись RFC 2231 с кодировкой: имя*=кодировка'язык'данные
    целое звезда = найти_от(маленькое, нужное + "*=", 0);
    если (звезда >= 0)
        целое начало = звезда + длина(нужное) + 2;
        целое конец_значения = найти_от(значение, ";", начало);
        если (конец_значения < 0)
            конец_значения = n
        конец
        текст сырое = обрезать(часть(значение, начало, конец_значения - начало));
        целое к1 = найти_от(сырое, "'", 0);
        если (к1 >= 0)
            целое к2 = найти_от(сырое, "'", к1 + 1);
            если (к2 >= 0)
                текст кодировка = часть(сырое, 0, к1);
                текст данные = часть(сырое, к2 + 1, длина(сырое));
                вернуть раскодировать_проценты(данные, кодировка);
            конец
        конец
    конец
    целое позиция = 0;
    пока (позиция < n)
        целое найден = найти_от(маленькое, нужное + "=", позиция);
        если (найден < 0)
            вернуть "";
        конец
        // перед именем должна быть граница: начало, «;» или пробел
        если (найден == 0 или пробельный(целое(байт_текста(значение, найден - 1))) или целое(байт_текста(значение, найден - 1)) == 59)
            целое начало = найден + длина(нужное) + 1;
            если (начало < n и целое(байт_текста(значение, начало)) == 34)
                целое закрытие = найти_от(значение, "\"", начало + 1);
                если (закрытие < 0)
                    закрытие = n;
                конец
                вернуть часть(значение, начало + 1, закрытие - начало - 1);
            конец
            целое конец_значения = найти_от(значение, ";", начало);
            если (конец_значения < 0)
                конец_значения = n
            конец
            вернуть обрезать(часть(значение, начало, конец_значения - начало));
        конец
        позиция = найден + 1;
    конец
    вернуть "";
конец

// «%D0%9F» → байты, затем перевод из кодировки в UTF-8 (так записаны имена файлов по RFC 2231).
функция раскодировать_проценты(текст т, текст кодировка): текст
    целое n = длина(т);
    текст буфер = выделить_память(n + 8);
    целое выход = 0;
    целое i = 0;
    пока (i < n)
        целое б = целое(байт_текста(т, i));
        если (б == 37 и i + 2 < n)
            целое а = цифра16(целое(байт_текста(т, i + 1)));
            целое с = цифра16(целое(байт_текста(т, i + 2)));
            если (а >= 0 и с >= 0)
                записать_байт(буфер, выход, а * 16 + с);
                выход = выход + 1;
                i = i + 3;
                продолжить;
            конец
        конец
        записать_байт(буфер, выход, б);
        выход = выход + 1;
        i = i + 1;
    конец
    Данные д = Данные(адрес_текста(буфер), выход);
    текст итог = байты_в_текст(д, кодировка);
    освободить_данные(д);
    вернуть итог;
конец

// ---------------------------------------------------------------- тело и части

// Вырезает теги из HTML и подставляет самые частые сущности.
функция гипертекст_в_текст(текст т): текст
    целое n = длина(т);
    текст буфер = выделить_память(n + 8);
    целое выход = 0;
    целое i = 0;
    верно в_теге = нет;
    пока (i < n)
        целое б = целое(байт_текста(т, i));
        если (б == 60)
            в_теге = да;
            // <br> и конец абзаца дают перевод строки
            текст след = нижний_латинский(часть(т, i, 4));
            если (след == "<br>" или след == "<br/" или след == "<br " или след == "</p>" или след == "</di")
                записать_байт(буфер, выход, 10);
                выход = выход + 1;
            конец
            i = i + 1;
            продолжить;
        конец
        если (б == 62 и в_теге)
            в_теге = нет;
            i = i + 1;
            продолжить;
        конец
        если (не в_теге)
            если (б == 38)
                если (часть(т, i, 6) == "&nbsp;")
                    записать_байт(буфер, выход, 32);
                    выход = выход + 1;
                    i = i + 6;
                    продолжить;
                конец
                если (часть(т, i, 5) == "&amp;")
                    записать_байт(буфер, выход, 38);
                    выход = выход + 1;
                    i = i + 5;
                    продолжить;
                конец
                если (часть(т, i, 4) == "&lt;")
                    записать_байт(буфер, выход, 60);
                    выход = выход + 1;
                    i = i + 4;
                    продолжить;
                конец
                если (часть(т, i, 4) == "&gt;")
                    записать_байт(буфер, выход, 62);
                    выход = выход + 1;
                    i = i + 4;
                    продолжить;
                конец
            конец
            записать_байт(буфер, выход, б);
            выход = выход + 1;
        конец
        i = i + 1;
    конец
    вернуть текст_из_буфера(буфер, выход);
конец

// Расшифровывает тело части по способу кодирования (base64, quoted-printable, остальное — как есть).
функция раскодировать_тело(текст тело, текст способ): Данные
    текст с = нижний_латинский(обрезать(способ));
    если (с == "base64")
        вернуть декодировать_б64(тело);
    конец
    если (с == "quoted-printable")
        вернуть декодировать_печатаемое(тело, нет);
    конец
    текст буфер = выделить_память(длина(тело) + 8);
    скопировать_память(буфер, тело, длина(тело));
    Данные д = Данные(адрес_текста(буфер), длина(тело));
    вернуть д;
конец

// Делит тело многочастного письма на части по границе.
функция разделить_по_границе(текст тело, текст граница): Список из текстов
    Список из текстов части = Список из текстов();
    текст метка = "--" + граница;
    целое позиция = найти_от(тело, метка, 0);
    пока (позиция >= 0)
        // начало части — после строки с границей
        целое строка_до = найти_от(тело, "\n", позиция);
        если (строка_до < 0)
            прервать;
        конец
        целое начало = строка_до + 1;
        целое следующая = найти_от(тело, "\n" + метка, начало - 1);
        если (следующая < 0)
            // последняя часть без закрывающей границы
            части.добавить(часть(тело, начало, длина(тело) - начало));
            прервать;
        конец
        // часть заканчивается перед переводом строки, предшествующим границе
        целое конец_части = следующая;
        если (конец_части > начало и целое(байт_текста(тело, конец_части - 1)) == 13)
            конец_части = конец_части - 1
        конец
        части.добавить(часть(тело, начало, конец_части - начало));
        позиция = следующая + 1;
        // закрывающая граница: «--метка--»
        если (часть(тело, позиция, длина(метка) + 2) == метка + "--")
            прервать;
        конец
    конец
    вернуть части;
конец

// Разбирает одну часть (заголовки + тело) и кладёт результат в письмо.
функция разобрать_часть(Письмо п, текст сырое_части)
    Список из целых г = граница_заголовков(сырое_части);
    текст заголовки = часть(сырое_части, 0, г.получить(0));
    текст тело = часть(сырое_части, г.получить(1), длина(сырое_части) - г.получить(1));
    текст тип_строка = значение_заголовка(заголовки, "content-type");
    если (длина(тип_строка) == 0)
        тип_строка = "text/plain";
    конец
    результат из целого точка = найти(тип_строка, ";");
    текст тип = тип_строка;
    если (точка.успешно)
        тип = часть(тип_строка, 0, точка.значение);
    конец
    тип = нижний_латинский(обрезать(тип));

    если (начинается_с(тип, "multipart/"))
        текст граница = параметр_заголовка(тип_строка, "boundary");
        если (длина(граница) > 0)
            Список из текстов части = разделить_по_границе(тело, граница);
            для каждого ч в части
                разобрать_часть(п, ч);
            конец
        конец
        вернуть;
    конец

    текст способ = значение_заголовка(заголовки, "content-transfer-encoding");
    текст расположение = нижний_латинский(значение_заголовка(заголовки, "content-disposition"));
    текст имя = параметр_заголовка(расположение_полностью(заголовки), "filename");
    если (длина(имя) == 0)
        имя = параметр_заголовка(тип_строка, "name");
    конец
    имя = декодировать_заголовок(имя);

    верно текстовая = начинается_с(тип, "text/plain") или начинается_с(тип, "text/html");
    верно вложение = начинается_с(расположение, "attachment") или длина(имя) > 0 или не текстовая;

    Данные сырые = раскодировать_тело(тело, способ);
    если (вложение)
        Вложение вл = Вложение(имя, тип, сырые.адрес, сырые.размер);
        если (длина(вл.имя) == 0)
            вл.имя = "вложение";
        конец
        п.вложения.добавить(вл);
        вернуть;
    конец
    текст кодировка = параметр_заголовка(тип_строка, "charset");
    текст как_текст = байты_в_текст(сырые, кодировка);
    освободить_данные(сырые);
    если (тип == "text/plain")
        если (длина(п.тело) == 0 или п.тело_из_html)
            п.тело = как_текст;
            п.тело_из_html = нет;
        конец
        вернуть;
    конец
    // HTML — только если настоящего текста нет
    если (длина(п.тело) == 0)
        п.тело = гипертекст_в_текст(как_текст);
        п.тело_из_html = да;
    конец
конец

// Полная строка Content-Disposition с исходным регистром (для имени файла).
функция расположение_полностью(текст заголовки): текст
    вернуть значение_заголовка(заголовки, "content-disposition");
конец

// ---------------------------------------------------------------- главное

функция разобрать_письмо(текст сырое): Письмо
    Список из целых г = граница_заголовков(сырое);
    текст заголовки = часть(сырое, 0, г.получить(0));
    Письмо п = Письмо("", "", "", "", "", нет, Список из Вложение());
    п.от_кого = декодировать_заголовок(значение_заголовка(заголовки, "from"));
    п.кому = декодировать_заголовок(значение_заголовка(заголовки, "to"));
    п.тема = декодировать_заголовок(значение_заголовка(заголовки, "subject"));
    п.дата = значение_заголовка(заголовки, "date");
    разобрать_часть(п, сырое);
    вернуть п;
конец

функция освободить_письмо(Письмо п)
    для каждого вл в п.вложения
        если (вл.адрес != 0)
            освободить_память(указатель_по_адресу(вл.адрес));
            вл.адрес = 0;
        конец
    конец
конец
