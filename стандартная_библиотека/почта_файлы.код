// почта_файлы.код — чтение и запись файлов целиком в виде байтов (для вложений писем).
//
// Подключается как "подключить почта_файлы;". В отличие от обычного чтения файла в текст,
// здесь файл может содержать нулевые байты (картинки, архивы): он хранится в структуре
// «Данные» (адрес буфера и размер, см. почта_кодирование).
//
//   прочитать_файл_байтами(текст путь): Данные      — если не удалось, адрес равен 0
//   записать_файл_байтами(текст путь, Данные д): верно

подключить почта_кодирование;

внешняя функция файл_открыть_сырой(текст путь, текст режим): текст как "fopen";
внешняя функция файл_закрыть_сырой(текст файл): целое32 как "fclose";
внешняя функция файл_читать_сырой(текст буфер, целое размер_элемента, целое число, текст файл): целое как "fread";
внешняя функция файл_писать_сырой(текст буфер, целое размер_элемента, целое число, текст файл): целое как "fwrite";
внешняя функция файл_переместиться_сырой(текст файл, целое смещение, целое32 откуда): целое32 как "fseek";
внешняя функция файл_позиция_сырая(текст файл): целое как "ftell";

функция прочитать_файл_байтами(текст путь): Данные
    Данные пусто = данные_пустые()
    текст файл = файл_открыть_сырой(путь, "rb")
    если (адрес_текста(файл) == 0)
        вернуть пусто
    конец
    файл_переместиться_сырой(файл, 0, целое32(2))
    целое размер = файл_позиция_сырая(файл)
    файл_переместиться_сырой(файл, 0, целое32(0))
    если (размер < 0)
        файл_закрыть_сырой(файл)
        вернуть пусто
    конец
    текст буфер = выделить_память(размер + 8)
    целое прочитано = 0
    если (размер > 0)
        прочитано = файл_читать_сырой(буфер, 1, размер, файл)
    конец
    файл_закрыть_сырой(файл)
    Данные итог = Данные(адрес_текста(буфер), прочитано)
    вернуть итог
конец

функция записать_файл_байтами(текст путь, Данные д): верно
    текст файл = файл_открыть_сырой(путь, "wb")
    если (адрес_текста(файл) == 0)
        вернуть нет
    конец
    целое записано = 0
    если (д.размер > 0)
        записано = файл_писать_сырой(указатель_по_адресу(д.адрес), 1, д.размер, файл)
    конец
    файл_закрыть_сырой(файл)
    вернуть записано == д.размер
конец
