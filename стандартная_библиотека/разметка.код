// разметка.код — перевод Markdown в HTML для статей и документации.
//
// Подключается как `подключить разметка;`.
//
//   markdown_в_html(текст): текст   — страница в HTML; результат освобождает вызывающий
//   оглавление_html(текст): текст   — список ссылок на заголовки (# … ####); освобождает вызывающий
//   заголовок_документа(текст): текст — текст первого заголовка «# …» (или пустой текст)
//
// Поддерживается: заголовки # … ####, абзацы, списки «- » и «1. », цитаты «> »,
// таблицы «| a | b |», горизонтальная черта «---», блоки кода ``` с языком,
// внутри строк: `код`, **жирный**, *курсив*, [текст](адрес).
// Заголовки получают id="р1", "р2", … — в том же порядке, что и в оглавлении.
// Весь HTML из исходника экранируется: сырой HTML в Markdown не пропускается.

подключить память;

// --------------------------------------------------------------- запись в буфер

функция писать_байт(текст буфер, целое выход, целое б): целое
    записать_целое32(буфер, выход, целое32(б));
    вернуть выход + 1;
конец

функция писать_текст(текст буфер, целое выход, текст т): целое
    целое n = длина(т);
    целое i = 0;
    пока (i меньше n)
        выход = писать_байт(буфер, выход, целое(байт_текста(т, i)));
        i = i + 1;
    конец
    вернуть выход;
конец

функция писать_экранированно(текст буфер, целое выход, текст источник, целое начало, целое до): целое
    целое i = начало;
    пока (i меньше до)
        целое б = целое(байт_текста(источник, i));
        если (б == 38)
            выход = писать_текст(буфер, выход, "&amp;");
        иначе если (б == 60)
            выход = писать_текст(буфер, выход, "&lt;");
        иначе если (б == 62)
            выход = писать_текст(буфер, выход, "&gt;");
        иначе если (б == 34)
            выход = писать_текст(буфер, выход, "&quot;");
        иначе
            выход = писать_байт(буфер, выход, б);
        конец
        i = i + 1;
    конец
    вернуть выход;
конец

// ------------------------------------------------------------------ поиск в тексте

функция найти_байт(текст т, целое от, целое до, целое б): целое
    целое i = от;
    пока (i меньше до)
        если (целое(байт_текста(т, i)) == б)
            вернуть i;
        конец
        i = i + 1;
    конец
    вернуть -1;
конец

функция найти_два_байта(текст т, целое от, целое до, целое б1, целое б2): целое
    целое i = от;
    пока (i + 1 меньше до)
        если (целое(байт_текста(т, i)) == б1 и целое(байт_текста(т, i + 1)) == б2)
            вернуть i;
        конец
        i = i + 1;
    конец
    вернуть -1;
конец

функция конец_строки_с(текст т, целое от, целое n): целое
    целое i = от;
    пока (i меньше n)
        если (целое(байт_текста(т, i)) == 10)
            вернуть i;
        конец
        i = i + 1;
    конец
    вернуть n;
конец

// строка [от, до) без завершающего \r
функция без_возврата_каретки(текст т, целое от, целое до): целое
    если (до больше от и целое(байт_текста(т, до - 1)) == 13)
        вернуть до - 1;
    конец
    вернуть до;
конец

функция начинается_с_в(текст т, целое от, целое до, текст префикс): верно
    целое k = длина(префикс);
    если (от + k больше до)
        вернуть нет;
    конец
    целое i = 0;
    пока (i меньше k)
        если (байт_текста(т, от + i) != байт_текста(префикс, i))
            вернуть нет;
        конец
        i = i + 1;
    конец
    вернуть да;
конец

функция пустая_строка(текст т, целое от, целое до): верно
    целое i = от;
    пока (i меньше до)
        целое б = целое(байт_текста(т, i));
        если (б != 32 и б != 9)
            вернуть нет;
        конец
        i = i + 1;
    конец
    вернуть да;
конец

// ------------------------------------------------------------ строчная разметка

функция писать_строчное(текст буфер, целое выход, текст т, целое от, целое до): целое
    целое i = от;
    пока (i меньше до)
        целое б = целое(байт_текста(т, i));
        целое обработано = 0;
        если (б == 96)
            целое закрытие = найти_байт(т, i + 1, до, 96);
            если (закрытие больше 0)
                выход = писать_текст(буфер, выход, "<code>");
                выход = писать_экранированно(буфер, выход, т, i + 1, закрытие);
                выход = писать_текст(буфер, выход, "</code>");
                i = закрытие + 1;
                обработано = 1;
            конец
        иначе если (б == 42 и i + 1 меньше до и целое(байт_текста(т, i + 1)) == 42)
            целое закрытие = найти_два_байта(т, i + 2, до, 42, 42);
            если (закрытие больше 0)
                выход = писать_текст(буфер, выход, "<strong>");
                выход = писать_строчное(буфер, выход, т, i + 2, закрытие);
                выход = писать_текст(буфер, выход, "</strong>");
                i = закрытие + 2;
                обработано = 1;
            конец
        иначе если (б == 42 и i + 1 меньше до и целое(байт_текста(т, i + 1)) != 32)
            целое закрытие = найти_байт(т, i + 1, до, 42);
            если (закрытие больше i + 1)
                выход = писать_текст(буфер, выход, "<em>");
                выход = писать_строчное(буфер, выход, т, i + 1, закрытие);
                выход = писать_текст(буфер, выход, "</em>");
                i = закрытие + 1;
                обработано = 1;
            конец
        иначе если (б == 91)
            целое середина = найти_два_байта(т, i + 1, до, 93, 40);
            если (середина больше 0)
                целое закрытие = найти_байт(т, середина + 2, до, 41);
                если (закрытие больше 0)
                    выход = писать_текст(буфер, выход, "<a href=\"");
                    выход = писать_экранированно(буфер, выход, т, середина + 2, закрытие);
                    выход = писать_текст(буфер, выход, "\">");
                    выход = писать_строчное(буфер, выход, т, i + 1, середина);
                    выход = писать_текст(буфер, выход, "</a>");
                    i = закрытие + 1;
                    обработано = 1;
                конец
            конец
        конец
        если (обработано == 0)
            выход = писать_экранированно(буфер, выход, т, i, i + 1);
            i = i + 1;
        конец
    конец
    вернуть выход;
конец

