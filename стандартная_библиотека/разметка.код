функция markdown_в_html(текст источник): текст
    целое n = длина(источник);
    текст буфер = выделить_память(n * 24 + 512);
    целое выход = 0;
    целое состояние = 0;
    целое номер_заголовка = 0;
    целое i = 0;
    пока (i меньше n)
        целое до = без_возврата_каретки(источник, i, конец_строки_с(источник, i, n));
        целое следующая = конец_строки_с(источник, i, n) + 1;
        если (начинается_с_в(источник, i, до, "```"))
            выход = закрыть_блок(буфер, выход, состояние);
            состояние = 0;
            целое тело_начало = следующая;
            целое j = следующая;
            целое тело_конец = n;
            целое после = n;
            пока (j меньше n)
                целое до_j = без_возврата_каретки(источник, j, конец_строки_с(источник, j, n));
                если (начинается_с_в(источник, j, до_j, "```"))
                    тело_конец = j;
                    после = конец_строки_с(источник, j, n) + 1;
                    j = n;
                иначе
                    j = конец_строки_с(источник, j, n) + 1;
                конец
            конец
            выход = писать_код(буфер, выход, источник, тело_начало, тело_конец, i + 3, до);
            следующая = после;
        иначе если (пустая_строка(источник, i, до))
            выход = закрыть_блок(буфер, выход, состояние);
            состояние = 0;
        иначе если (уровень_заголовка(источник, i, до) больше 0)
            выход = закрыть_блок(буфер, выход, состояние);
            состояние = 0;
            целое ур = уровень_заголовка(источник, i, до);
            номер_заголовка = номер_заголовка + 1;
            выход = писать_текст(буфер, выход, "<h");
            выход = писать_байт(буфер, выход, 48 + ур);
            выход = писать_текст(буфер, выход, " id=\"р");
            выход = писать_текст(буфер, выход, целое_в_текст(номер_заголовка));
            выход = писать_текст(буфер, выход, "\">");
            выход = писать_строчное(буфер, выход, источник, i + ур + 1, до);
            выход = писать_текст(буфер, выход, "</h");
            выход = писать_байт(буфер, выход, 48 + ур);
            выход = писать_текст(буфер, выход, ">\n");
        иначе если (начинается_с_в(источник, i, до, "---") и до - i == 3)
            выход = закрыть_блок(буфер, выход, состояние);
            состояние = 0;
            выход = писать_текст(буфер, выход, "<hr>\n");
        иначе если (начинается_с_в(источник, i, до, "- ") или начинается_с_в(источник, i, до, "* "))
            если (состояние != 2)
                выход = закрыть_блок(буфер, выход, состояние);
                выход = писать_текст(буфер, выход, "<ul>\n");
                состояние = 2;
            конец
            выход = писать_текст(буфер, выход, "<li>");
            выход = писать_строчное(буфер, выход, источник, i + 2, до);
            выход = писать_текст(буфер, выход, "</li>\n");
        иначе если (длина_номера(источник, i, до) больше 0)
            если (состояние != 3)
                выход = закрыть_блок(буфер, выход, состояние);
                выход = писать_текст(буфер, выход, "<ol>\n");
                состояние = 3;
            конец
            выход = писать_текст(буфер, выход, "<li>");
            выход = писать_строчное(буфер, выход, источник, i + длина_номера(источник, i, до), до);
            выход = писать_текст(буфер, выход, "</li>\n");
        иначе если (начинается_с_в(источник, i, до, "> "))
            выход = закрыть_блок(буфер, выход, состояние);
            состояние = 0;
            выход = писать_текст(буфер, выход, "<blockquote>");
            выход = писать_строчное(буфер, выход, источник, i + 2, до);
            выход = писать_текст(буфер, выход, "</blockquote>\n");
        иначе если (начинается_с_в(источник, i, до, "|"))
            если (состояние != 4)
                выход = закрыть_блок(буфер, выход, состояние);
                выход = писать_текст(буфер, выход, "<table>\n");
                состояние = 4;
                выход = строка_таблицы(буфер, выход, источник, i, до, "th");
            иначе если (не разделитель_таблицы(источник, i, до))
                выход = строка_таблицы(буфер, выход, источник, i, до, "td");
            конец
        иначе
            если (состояние != 1)
                выход = закрыть_блок(буфер, выход, состояние);
                выход = писать_текст(буфер, выход, "<p>");
                состояние = 1;
            иначе
                выход = писать_текст(буфер, выход, "\n");
            конец
            выход = писать_строчное(буфер, выход, источник, i, до);
        конец
        i = следующая;
    конец
    выход = закрыть_блок(буфер, выход, состояние);
    записать_целое32(буфер, выход, целое32(0));
    вернуть буфер;
конец

