// Слово [от, до) есть в списке слов, разделённых пробелами.
функция слово_в_списке(текст список, текст т, целое от, целое до): верно
    целое k = длина(список);
    целое длина_слова = до - от;
    целое i = 0;
    пока (i меньше k)
        целое j = i;
        пока (j меньше k и целое(байт_текста(список, j)) != 32)
            j = j + 1;
        конец
        если (j - i == длина_слова)
            целое q = 0;
            верно совпало = да;
            пока (q меньше длина_слова и совпало)
                если (байт_текста(список, i + q) != байт_текста(т, от + q))
                    совпало = нет;
                конец
                q = q + 1;
            конец
            если (совпало)
                вернуть да;
            конец
        конец
        i = j + 1;
    конец
    вернуть нет;
конец

// байт буквы слова: латиница, цифры, «_» и любой байт многобайтного символа (кириллица)
функция байт_слова(целое б): верно
    вернуть (б не меньше 97 и б не больше 122) или (б не меньше 65 и б не больше 90) или
        (б не меньше 48 и б не больше 57) или б == 95 или б не меньше 128;
конец

функция открыть_span(текст буфер, целое выход, текст класс): целое
    выход = писать_текст(буфер, выход, "<span class=\"");
    выход = писать_текст(буфер, выход, класс);
    вернуть писать_текст(буфер, выход, "\">");
конец

// Подсвеченный код [от, до): комментарии (к-ком), строки (к-стр), числа (к-чис),
// ключевые слова (к-сл), типы (к-тип).
функция писать_подсвеченный(текст буфер, целое выход, текст т, целое от, целое до): целое
    текст ключевые = "да нет неуказано функция структура внешняя как контракт подключить если иначе для каждого в пока вернуть публично приватно результат успех ошибка слабая неизменно ссылка параллельно детерминировано канал это прервать продолжить конец из и или не меньше больше";
    текст типы = "целое целое8 целое16 целое32 целое64 беззнак8 беззнак16 беззнак32 беззнак64 дробное дробное32 дробное64 текст верно Список Словарь";
    целое i = от;
    пока (i меньше до)
        целое б = целое(байт_текста(т, i));
        если (б == 47 и i + 1 меньше до и целое(байт_текста(т, i + 1)) == 47)
            целое e = i;
            пока (e меньше до и целое(байт_текста(т, e)) != 10)
                e = e + 1;
            конец
            выход = открыть_span(буфер, выход, "к-ком");
            выход = писать_экранированно(буфер, выход, т, i, e);
            выход = писать_текст(буфер, выход, "</span>");
            i = e;
        иначе если (б == 34)
            целое e = i + 1;
            пока (e меньше до и целое(байт_текста(т, e)) != 34 и целое(байт_текста(т, e)) != 10)
                если (целое(байт_текста(т, e)) == 92)
                    e = e + 1;
                конец
                e = e + 1;
            конец
            если (e меньше до и целое(байт_текста(т, e)) == 34)
                e = e + 1;
            конец
            если (e больше до)
                e = до;
            конец
            выход = открыть_span(буфер, выход, "к-стр");
            выход = писать_экранированно(буфер, выход, т, i, e);
            выход = писать_текст(буфер, выход, "</span>");
            i = e;
        иначе если (б не меньше 48 и б не больше 57)
            целое e = i;
            пока (e меньше до и ((целое(байт_текста(т, e)) не меньше 48 и целое(байт_текста(т, e)) не больше 57) или целое(байт_текста(т, e)) == 46))
                e = e + 1;
            конец
            выход = открыть_span(буфер, выход, "к-чис");
            выход = писать_экранированно(буфер, выход, т, i, e);
            выход = писать_текст(буфер, выход, "</span>");
            i = e;
        иначе если (байт_слова(б))
            целое e = i;
            пока (e меньше до и байт_слова(целое(байт_текста(т, e))))
                e = e + 1;
            конец
            если (слово_в_списке(ключевые, т, i, e))
                выход = открыть_span(буфер, выход, "к-сл");
                выход = писать_экранированно(буфер, выход, т, i, e);
                выход = писать_текст(буфер, выход, "</span>");
            иначе если (слово_в_списке(типы, т, i, e))
                выход = открыть_span(буфер, выход, "к-тип");
                выход = писать_экранированно(буфер, выход, т, i, e);
                выход = писать_текст(буфер, выход, "</span>");
            иначе
                выход = писать_экранированно(буфер, выход, т, i, e);
            конец
            i = e;
        иначе
            выход = писать_экранированно(буфер, выход, т, i, i + 1);
            i = i + 1;
        конец
    конец
    вернуть выход;
конец

// Блок кода [от, до) с языком [яз_от, яз_до). Подсвечиваются блоки без языка и с
// языками «сфера»/«код»; остальные выводятся как есть.
функция писать_код(текст буфер, целое выход, текст т, целое от, целое до, целое яз_от, целое яз_до): целое
    выход = писать_текст(буфер, выход, "<pre><code class=\"язык-");
    выход = писать_экранированно(буфер, выход, т, яз_от, яз_до);
    выход = писать_текст(буфер, выход, "\">");
    верно подсвечивать = яз_от == яз_до или слово_в_списке("сфера код сфера-новый", т, яз_от, яз_до);
    если (подсвечивать)
        выход = писать_подсвеченный(буфер, выход, т, от, до);
    иначе
        выход = писать_экранированно(буфер, выход, т, от, до);
    конец
    выход = писать_текст(буфер, выход, "</code></pre>\n");
    вернуть выход;
конец

// ------------------------------------------------------------------ состояния

функция закрыть_блок(текст буфер, целое выход, целое состояние): целое
    если (состояние == 1)
        выход = писать_текст(буфер, выход, "</p>\n");
    иначе если (состояние == 2)
        выход = писать_текст(буфер, выход, "</ul>\n");
    иначе если (состояние == 3)
        выход = писать_текст(буфер, выход, "</ol>\n");
    иначе если (состояние == 4)
        выход = писать_текст(буфер, выход, "</table>\n");
    конец
    вернуть выход;
конец

// сколько «#» в начале строки (1…4), иначе 0; после них обязателен пробел
функция уровень_заголовка(текст т, целое от, целое до): целое
    целое k = 0;
    пока (от + k меньше до и целое(байт_текста(т, от + k)) == 35)
        k = k + 1;
    конец
    если (k больше 0 и k не больше 4 и от + k меньше до и целое(байт_текста(т, от + k)) == 32)
        вернуть k;
    конец
    вернуть 0;
конец

// Номер длины «1. » (цифры, точка, пробел) или 0
функция длина_номера(текст т, целое от, целое до): целое
    целое k = 0;
    пока (от + k меньше до и целое(байт_текста(т, от + k)) не меньше 48 и целое(байт_текста(т, от + k)) не больше 57)
        k = k + 1;
    конец
    если (k больше 0 и от + k + 1 меньше до и целое(байт_текста(т, от + k)) == 46 и целое(байт_текста(т, от + k + 1)) == 32)
        вернуть k + 2;
    конец
    вернуть 0;
конец

функция строка_таблицы(текст буфер, целое выход, текст т, целое от, целое до, текст ячейка): целое
    выход = писать_текст(буфер, выход, "<tr>");
    целое i = от;
    если (i меньше до и целое(байт_текста(т, i)) == 124)
        i = i + 1;
    конец
    пока (i меньше до)
        целое конец_ячейки = найти_байт(т, i, до, 124);
        если (конец_ячейки меньше 0)
            конец_ячейки = до;
        конец
        если (не (конец_ячейки == до и пустая_строка(т, i, до)))
            выход = писать_текст(буфер, выход, "<");
            выход = писать_текст(буфер, выход, ячейка);
            выход = писать_текст(буфер, выход, ">");
            целое а = i;
            пока (а меньше конец_ячейки и целое(байт_текста(т, а)) == 32)
                а = а + 1;
            конец
            целое з = конец_ячейки;
            пока (з больше а и целое(байт_текста(т, з - 1)) == 32)
                з = з - 1;
            конец
            выход = писать_строчное(буфер, выход, т, а, з);
            выход = писать_текст(буфер, выход, "</");
            выход = писать_текст(буфер, выход, ячейка);
            выход = писать_текст(буфер, выход, ">");
        конец
        i = конец_ячейки + 1;
    конец
    выход = писать_текст(буфер, выход, "</tr>\n");
    вернуть выход;
конец

функция разделитель_таблицы(текст т, целое от, целое до): верно
    если (не начинается_с_в(т, от, до, "|"))
        вернуть нет;
    конец
    если (найти_два_байта(т, от, до, 45, 45) меньше 0)
        вернуть нет;
    конец
    целое i = от;
    пока (i меньше до)
        целое б = целое(байт_текста(т, i));
        если (б != 124 и б != 45 и б != 58 и б != 32)
            вернуть нет;
        конец
        i = i + 1;
    конец
    вернуть да;
конец

