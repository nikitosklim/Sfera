// вебсокет.код — сервер WebSocket: рукопожатие, приём и отправка текстовых сообщений.
//
// Браузер открывает соединение командой new WebSocket("ws://адрес:порт") (в Сфере это
// делает модуль «игра», функция соединиться). Сервер на Сфере принимает такие соединения.
//
// Схема сервера: главный поток принимает подключения и на каждое запускает свой поток,
// который читает сообщения. Все данные в общий «центр» (канал) отправляют только эти
// потоки, а рассылает ответы один поток-центр. Так не нужны замки. Пример: игры/чат-сервер.код
//
//   принять_вебсокет(слушающий)  — ждёт клиента, делает рукопожатие, возвращает номер соединения
//   читать_сообщение(клиент)     — ждёт следующее текстовое сообщение (ошибка — соединение закрыто)
//   отправить_сообщение(клиент, текст) — отправляет одно сообщение (до 65535 байт)
//   закрыть_вебсокет(клиент)
//
// Порт открывается так же, как для HTTP: открыть_порт(порт) из модуля «веб».

подключить память;
подключить сеть;
подключить веб;
подключить хеш;

// Ответ сервера на рукопожатие: основание64(бах1(ключ + магическая строка из RFC 6455)).
функция ключ_принятия(текст ключ): текст
    Список из целых хеш = бах1(ключ + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11");
    текст ответ = основание64(хеш);
    хеш.освободить();
    вернуть ответ;
конец

// ---- чтение и отправка кадров

// Читает ровно n байт в список. Ошибка — соединение оборвалось.
функция прочитать_байты(целое32 клиент, целое n): результат из Список из целых
    Список из целых итог = Список из целых();
    текст буфер = выделить_память(4104);
    целое осталось = n;
    пока (осталось больше 0)
        целое хочу = осталось;
        если (хочу больше 4096)
            хочу = 4096;
        конец
        целое получено = получить_данные(клиент, буфер, хочу, целое32(0));
        если (получено меньше 1 или получено больше хочу)
            освободить_память(буфер);
            вернуть ошибка("соединение закрыто");
        конец
        целое j = 0;
        пока (j меньше получено)
            итог.добавить(целое(байт_текста(буфер, j)));
            j = j + 1;
        конец
        осталось = осталось - получено;
    конец
    освободить_память(буфер);
    вернуть успех(итог);
конец

функция отправить_байты(целое32 клиент, Список из целых байты): целое
    целое n = байты.размер();
    текст буфер = выделить_память(n + 8);
    целое i = 0;
    пока (i меньше n)
        записать_байт(буфер, i, байты.получить(i));
        i = i + 1;
    конец
    записать_байт(буфер, n, 0);
    целое р = отправить_данные(клиент, буфер, n, целое32(0));
    освободить_память(буфер);
    если (р != n)
        вернуть 0 - 1;
    конец
    вернуть n;
конец

// ---- публичные функции

// Принимает одно подключение, читает запрос и отвечает рукопожатием. Блокирует поток,
// пока кто-нибудь не подключится.
функция принять_вебсокет(целое слушающий): результат из целого
    целое32 клиент = принять_подключение(целое32(слушающий), нулевой_указатель_сети(), нулевой_указатель_сети());
    если (клиент меньше целое32(0))
        вернуть ошибка("не удалось принять подключение");
    конец
    результат из Запрос з = прочитать_запрос(клиент);
    если ( не з.успешно)
        закрыть_сокет(клиент);
        вернуть ошибка("не удалось прочитать запрос");
    конец
    Запрос запрос = з.значение;
    текст ключ = заголовок(запрос, "sec-websocket-key");
    если (длина(ключ) == 0)
        текст отказ = "HTTP/1.1 400 Bad Request\r\nContent-Length: 0\r\nConnection: close\r\n\r\n";
        отправить_данные(клиент, отказ, длина(отказ), целое32(0));
        закрыть_сокет(клиент);
        вернуть ошибка("это не запрос WebSocket");
    конец
    текст ответ = "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: " + ключ_принятия(ключ) + "\r\n\r\n";
    отправить_данные(клиент, ответ, длина(ответ), целое32(0));
    вернуть успех(целое(клиент));
конец

функция закрыть_вебсокет(целое клиент)
    закрыть_сокет(целое32(клиент));
конец

// Отправляет одно текстовое сообщение (до 65535 байт).
функция отправить_сообщение(целое клиент, текст сообщение): результат из целого
    целое n = длина(сообщение);
    если (n больше 65535)
        вернуть ошибка("сообщение длиннее 65535 байт");
    конец
    Список из целых кадр = Список из целых();
    кадр.добавить(129);
    если (n меньше 126)
        кадр.добавить(n);
    иначе
        кадр.добавить(126);
        кадр.добавить((n >> 8) & 255);
        кадр.добавить(n & 255);
    конец
    целое i = 0;
    пока (i меньше n)
        кадр.добавить(целое(байт_текста(сообщение, i)));
        i = i + 1;
    конец
    целое р = отправить_байты(целое32(клиент), кадр);
    кадр.освободить();
    если (р меньше 0)
        вернуть ошибка("не удалось отправить");
    конец
    вернуть успех(р);
конец

// Ждёт следующее текстовое сообщение. Ping отвечает сам, закрытие соединения — ошибка.
функция читать_сообщение(целое клиент): результат из текста
    пока (да)
        результат из Список из целых шапка = прочитать_байты(целое32(клиент), 2);
        если ( не шапка.успешно)
            вернуть ошибка("соединение закрыто");
        конец
        целое операция = шапка.значение.получить(0) & 15;
        целое с_маской = (шапка.значение.получить(1) >> 7) & 1;
        целое размер = шапка.значение.получить(1) & 127;
        если (размер == 126)
            результат из Список из целых р2 = прочитать_байты(целое32(клиент), 2);
            если ( не р2.успешно)
                вернуть ошибка("соединение закрыто");
            конец
            размер = (р2.значение.получить(0) << 8) | р2.значение.получить(1);
        иначе если (размер == 127)
            вернуть ошибка("слишком большое сообщение");
        конец
        Список из целых маска = Список из целых();
        если (с_маской == 1)
            результат из Список из целых м = прочитать_байты(целое32(клиент), 4);
            если ( не м.успешно)
                вернуть ошибка("соединение закрыто");
            конец
            маска = м.значение;
        иначе
            маска.добавить(0);
            маска.добавить(0);
            маска.добавить(0);
            маска.добавить(0);
        конец
        результат из Список из целых тело = прочитать_байты(целое32(клиент), размер);
        если ( не тело.успешно)
            вернуть ошибка("соединение закрыто");
        конец
        если (операция == 8)
            вернуть ошибка("соединение закрыто");
        конец
        если (операция == 9)
            // ping: отвечаем pong с теми же данными
            Список из целых понг = Список из целых();
            понг.добавить(138);
            понг.добавить(размер);
            целое i = 0;
            пока (i меньше размер)
                понг.добавить(тело.значение.получить(i) ^ маска.получить(i % 4));
                i = i + 1;
            конец
            отправить_байты(целое32(клиент), понг);
            понг.освободить();
        иначе если (операция == 1)
            текст буфер = выделить_память(размер + 8);
            целое i = 0;
            пока (i меньше размер)
                записать_байт(буфер, i, тело.значение.получить(i) ^ маска.получить(i % 4));
                i = i + 1;
            конец
            записать_байт(буфер, размер, 0);
            вернуть успех(буфер);
        конец
    конец
    вернуть ошибка("соединение закрыто");
конец
