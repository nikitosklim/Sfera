// база_данных.код — обёртка над SQLite через прямой FFI, тем же способом,
// каким графика.код обёрнута вокруг SDL2 и сеть.код — вокруг системных
// сокетов: сама библиотека C делает всю настоящую работу, "Сфера" просто
// объявляет её функции по именам символов.
//
// SQLite выбрана как первая, стартовая база данных СОЗНАТЕЛЬНО — она
// встраиваемая (вся база — один файл, без отдельно запущенного сервера,
// без сети, без пароля), что прямо совпадает с уже проверенной, рабочей
// моделью FFI к SDL2. Клиент-серверные СУБД (PostgreSQL, MySQL) — отдельная,
// более сложная по интеграции задача на будущее (нужен не только FFI к
// клиентской библиотеке, но и сам работающий, настроенный сервер рядом).
//
// ⚠️ Честно, открыто: это ВРЕМЕННОЕ, стартовое решение, не финальная
// цель. Стратегическая, куда более амбициозная задача — собственная,
// написанная на самой "Сфере" система хранения данных, без зависимости
// от какой-либо внешней библиотеки вообще. SQLite здесь — чтобы двигаться
// быстро прямо сейчас, опираясь на то, что уже несколько раз проверенно
// работает (тот же FFI-приём).

внешняя функция выделить_память(целое размер) -> текст как "malloc";
внешняя функция освободить_память(текст указатель) -> целое32 как "free";

// Открывает (или создаёт, если не существует) файл базы данных — "имя_файла"
// может быть и специальной строкой ":memory:" для временной, живущей только
// в памяти базы (полезно для тестов). Возвращает 0 при успехе (SQLITE_OK).
// Реальный указатель на открытую базу SQLite записывает САМА в переданный
// буфер (классический C-паттерн "выходного параметра" через двойной
// указатель) — читается обратно через прочитать_указатель(буфер, 0).
внешняя функция sqlite_открыть(текст имя_файла, текст буфер_для_указателя) -> целое32 как "sqlite3_open";
внешняя функция sqlite_закрыть(текст бд) -> целое32 как "sqlite3_close";

// Простое выполнение SQL без ожидания результатов (CREATE TABLE, INSERT,
// UPDATE, DELETE) — три средних параметра (callback, его аргумент, буфер
// для текста ошибки) передаются как "нулевой_указатель()", когда не нужны.
внешняя функция sqlite_выполнить(текст бд, текст sql, текст callback, текст callback_аргумент, текст буфер_ошибки) -> целое32 как "sqlite3_exec";
внешняя функция sqlite_текст_ошибки(текст бд) -> текст как "sqlite3_errmsg";

// Подготовленные выражения — нужны для SELECT (когда важен РЕЗУЛЬТАТ
// запроса, не только факт его выполнения) и для параметризованных запросов
// с "?" (безопасный способ вставить значение в SQL, без риска SQL-инъекции
// через простую склейку строк).
внешняя функция sqlite_подготовить(текст бд, текст sql, целое32 длина_sql, текст буфер_для_stmt, текст хвост) -> целое32 как "sqlite3_prepare_v2";
// Делает один шаг выполнения — возвращает 100 (SQLITE_ROW), если готова
// очередная строка результата, 101 (SQLITE_DONE), когда строк больше нет.
внешняя функция sqlite_шаг(текст выражение) -> целое32 как "sqlite3_step";
внешняя функция sqlite_завершить(текст выражение) -> целое32 как "sqlite3_finalize";

// Чтение значений из текущей строки результата — "колонка" нумеруется с 0.
внешняя функция sqlite_колонка_текст(текст выражение, целое32 колонка) -> текст как "sqlite3_column_text";
внешняя функция sqlite_колонка_целое(текст выражение, целое32 колонка) -> целое32 как "sqlite3_column_int";

// Привязка параметров к "?"-плейсхолдерам подготовленного выражения —
// "индекс" нумеруется с 1 (не с 0, таково соглашение самой SQLite).
// Пятый аргумент sqlite3_bind_text — это НЕ число, а указатель на функцию-
// деструктор строки (значение типа "void(*)(void*)"), и SQLITE_TRANSIENT
// — специальное значение ЭТОГО указателя "все биты равны единице"
// ((sqlite3_destructor_type)-1) — то есть на 64-битной системе это
// 0xFFFFFFFFFFFFFFFF, ПОЛНЫЙ 64-битный указатель, не 32-битное число.
// ⚠️ Найдено реальной проверкой: если объявить этот параметр как целое32,
// передача целое32(-1) даёт только 32 единичных бита, а не 64 — SQLite
// получает совсем не то значение, что ожидает для SQLITE_TRANSIENT, и
// ломает свою внутреннюю логику владения переданной строкой (крах внутри
// sqlite3_finalize при попытке эту строку освободить). Обязательно целое
// (64-битный тип), не целое32.
внешняя функция sqlite_привязать_текст(текст выражение, целое32 индекс, текст значение, целое32 длина, целое деструктор) -> целое32 как "sqlite3_bind_text";
внешняя функция sqlite_привязать_целое(текст выражение, целое32 индекс, целое32 значение) -> целое32 как "sqlite3_bind_int";

// Приём для получения null-указателя там, где C-функция допускает
// необязательный аргумент (например, callback у sqlite_выполнить, если
// результат не нужен) — тот же приём, что уже используется в графика.код
// и сеть.код: getenv() с заведомо несуществующим именем переменной
// окружения гарантированно возвращает NULL.
внешняя функция получить_нулевой_указатель_бд(текст имя) -> текст как "getenv";
функция нулевой_указатель_бд() -> текст {
    вернуть получить_нулевой_указатель_бд("СФЕРА_ГАРАНТИРОВАННО_НЕСУЩЕСТВУЮЩАЯ_ПЕРЕМЕННАЯ_БД");
}

// Удобная обёртка: открывает базу и сразу возвращает готовый указатель на
// неё (а не просто код ошибки, как это делает сырая sqlite_открыть) —
// прячет "буфер + прочитать_указатель" ритуал, который иначе пришлось бы
// повторять в каждой программе, использующей эту библиотеку.
функция открыть_базу(текст имя_файла) -> результат<текст> {
    текст буфер = выделить_память(8);
    целое32 итог = sqlite_открыть(имя_файла, буфер);
    если (итог != целое32(0)) {
        вернуть ошибка("не удалось открыть базу данных '" + имя_файла + "'");
    }
    текст бд = прочитать_указатель(буфер, 0);
    освободить_память(буфер);
    вернуть успех(бд);
}

// Удобная обёртка над sqlite_выполнить — для запросов без результата
// (CREATE TABLE, INSERT, UPDATE, DELETE), с понятным текстом ошибки на
// русском вместо голого числового кода.
функция выполнить_sql(текст бд, текст sql) -> результат<целое> {
    целое32 итог = sqlite_выполнить(бд, sql, нулевой_указатель_бд(), нулевой_указатель_бд(), нулевой_указатель_бд());
    если (итог != целое32(0)) {
        вернуть ошибка("ошибка выполнения SQL: " + sqlite_текст_ошибки(бд));
    }
    вернуть успех(0);
}
