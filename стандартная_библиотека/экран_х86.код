// экран_х86.код — графический экран и текстовая консоль для x86 (QEMU, видеокарта «стандартная» / Bochs VBE).
//
// Подключение (после  подключить голое_железо;):  подключить экран_х86;
// Нужен растровый шрифт (шрифт_8х16.s, см. инструменты/шрифт) и адрес шрифта от стартового кода.
//
// Экран 800×600, 32 бита на точку. Знак — 8×16 точек, в строке 100 знаков, всего 37 строк.
// Текст принимается байтами в UTF-8, поэтому русские буквы работают как есть.
//
// Состояние консоли хранится в памяти по адресу 0x300400 (глобальных переменных в Сфере нет):
//   +0 адрес видеопамяти, +8 столбец, +16 строка, +24 сколько байт символа ещё ждём, +32 собираемый код, +40 длина строки экрана в байтах

внешняя функция шрифт_адрес(): целое как "sfera_шрифт_адрес";
внешняя функция инфо_загрузчика(): целое как "sfera_инфо_загрузчика";

функция экран_состояние(целое поле): целое
    вернуть читать64(0x300400 + поле);
конец

функция экран_задать(целое поле, целое значение)
    писать64(0x300400 + поле, значение);
конец

// Читает 32 бита из пространства настройки PCI.
функция pci_читать(целое шина, целое устройство, целое смещение): целое
    целое адрес = включить_биты(0x80000000, включить_биты(сдвинуть_влево(шина, 16), включить_биты(сдвинуть_влево(устройство, 11), смещение)));
    порт_вывод32(0xCF8, беззнак32(адрес));
    вернуть целое(порт_ввод32(0xCFC));
конец

функция видео_задать(целое номер, целое значение)
    порт_вывод16(0x1CE, беззнак16(номер));
    порт_вывод16(0x1CF, беззнак16(значение));
конец

// Закрашивает всю картинку цветом.
функция экран_очистить(целое цвет)
    целое база = экран_состояние(0);
    целое пара = включить_биты(цвет, сдвинуть_влево(цвет, 32));
    целое смещение = 0;
    пока (смещение < 600 * экран_состояние(40))
        писать64(база + смещение, пара);
        смещение = смещение + 8;
    конец
конец

// Включает экран и очищает его. Если загрузчик уже включил графику (поле экрана в сведениях Multiboot),
// берёт адрес и длину строки оттуда; иначе находит виртуальную видеокарту QEMU на шине PCI и включает
// режим 800×600 через порты Bochs VBE. Возвращает 1, если экран есть, иначе 0.
функция экран_настроить(): целое
    целое сведения = инфо_загрузчика();
    целое флаги = целое(аппаратное_чтение32(сведения));
    если (наложить_маску(флаги, 4096) != 0 и аппаратное_чтение32(сведения + 88) != беззнак32(0))
        экран_задать(0, целое(аппаратное_чтение32(сведения + 88)));
        экран_задать(40, целое(аппаратное_чтение32(сведения + 96)));
    иначе
        целое устройство = 0;
        целое адрес = 0;
        пока (устройство < 32)
            если (наложить_маску(pci_читать(0, устройство, 0), 0xFFFFFFFF) == 0x11111234)
                адрес = наложить_маску(pci_читать(0, устройство, 0x10), 0xFFFFFFF0);
                устройство = 99;
            конец
            устройство = устройство + 1;
        конец
        если (адрес == 0)
            вернуть 0;
        конец
        видео_задать(4, 0);
        видео_задать(1, 800);
        видео_задать(2, 600);
        видео_задать(3, 32);
        видео_задать(4, 0x41);
        экран_задать(0, адрес);
        экран_задать(40, 3200);
    конец
    экран_задать(8, 0);
    экран_задать(16, 0);
    экран_задать(24, 0);
    экран_задать(32, 0);
    экран_очистить(0x101820);
    вернуть 1;
конец

// Номер знака в шрифте: 0–94 латиница и цифры, 95–158 «А…я», 159 «Ё», 160 «ё», 161 «, 162 », 163 —, 164 №.
функция номер_знака(целое код): целое
    если (код >= 32 и код <= 126)
        вернуть код - 32;
    конец
    если (код >= 0x410 и код <= 0x44F)
        вернуть 95 + код - 0x410;
    конец
    если (код == 0x401)
        вернуть 159;
    конец
    если (код == 0x451)
        вернуть 160;
    конец
    если (код == 0xAB)
        вернуть 161;
    конец
    если (код == 0xBB)
        вернуть 162;
    конец
    если (код == 0x2014)
        вернуть 163;
    конец
    если (код == 0x2116)
        вернуть 164;
    конец
    вернуть 31;
конец

// Рисует знак в клетке (столбец, строка).
функция экран_знак(целое номер, целое столбец, целое строка, целое цвет, целое фон)
    целое база = экран_состояние(0);
    целое образ = шрифт_адрес() + номер * 16;
    целое ряд = 0;
    пока (ряд < 16)
        целое биты = целое(аппаратное_чтение8(образ + ряд));
        целое адрес = база + (строка * 16 + ряд) * экран_состояние(40) + столбец * 32;
        целое точка = 0;
        пока (точка < 8)
            если (наложить_маску(биты, сдвинуть_вправо(128, точка)) != 0)
                аппаратная_запись32(адрес + точка * 4, беззнак32(цвет));
            иначе
                аппаратная_запись32(адрес + точка * 4, беззнак32(фон));
            конец
            точка = точка + 1;
        конец
        ряд = ряд + 1;
    конец
конец

// Сдвигает всё содержимое на одну текстовую строку вверх, нижнюю строку очищает.
функция экран_прокрутка()
    целое база = экран_состояние(0);
    целое длина_строки = экран_состояние(40);
    целое строка = 16 * длина_строки;
    целое смещение = 0;
    пока (смещение < 600 * длина_строки - строка)
        писать64(база + смещение, читать64(база + смещение + строка));
        смещение = смещение + 8;
    конец
    пока (смещение < 600 * длина_строки)
        писать64(база + смещение, 0x0010182000101820);
        смещение = смещение + 8;
    конец
конец

// Выводит один символ (код Юникода) в текущее место консоли.
функция экран_символ(целое код)
    целое столбец = экран_состояние(8);
    целое строка = экран_состояние(16);
    если (код == 10)
        столбец = 0;
        строка = строка + 1;
    иначе
        если (код == 13)
            столбец = 0;
        иначе
            если (код == 8)
                если (столбец > 0)
                    столбец = столбец - 1;
                    экран_знак(0, столбец, строка, 0xDCE6F0, 0x101820);
                конец
            иначе
                экран_знак(номер_знака(код), столбец, строка, 0xDCE6F0, 0x101820);
                столбец = столбец + 1;
                если (столбец >= 100)
                    столбец = 0;
                    строка = строка + 1;
                конец
            конец
        конец
    конец
    если (строка >= 37)
        экран_прокрутка();
        строка = 36;
    конец
    экран_задать(8, столбец);
    экран_задать(16, строка);
конец

// Принимает один байт текста в UTF-8 (русские буквы приходят двумя байтами).
функция экран_байт(целое байт)
    если (экран_состояние(0) == 0)
        вернуть;
    конец
    если (байт < 128)
        экран_символ(байт);
        вернуть;
    конец
    если (байт >= 192)
        если (байт < 224)
            экран_задать(24, 1);
            экран_задать(32, наложить_маску(байт, 31));
        иначе
            экран_задать(24, 2);
            экран_задать(32, наложить_маску(байт, 15));
        конец
        вернуть;
    конец
    целое осталось = экран_состояние(24);
    если (осталось > 0)
        экран_задать(32, включить_биты(сдвинуть_влево(экран_состояние(32), 6), наложить_маску(байт, 63)));
        осталось = осталось - 1;
        экран_задать(24, осталось);
        если (осталось == 0)
            экран_символ(экран_состояние(32));
        конец
    конец
конец
