// почта_кодирование.код — перевод почтовых кодировок: основание 64 (его называют «base64»),
// «печатаемое с экранированием» (quoted-printable), русские заголовки писем
// («слова» вида =?UTF-8?B?…?=), а также кодировки windows-1251 и КОИ8-Р.
//
// Подключается как обычная библиотека: "подключить почта_кодирование;".
// Модуль чистый: ничего не знает о сети, работает только с байтами.
//
// Двоичные данные (вложения) могут содержать нулевые байты, а текст Сферы на нуле
// заканчивается, поэтому такие данные хранятся в структуре «Данные»: адрес буфера
// числом и размер. Буфер освобождает вызывающий (освободить_данные).

подключить память;

структура Данные
    целое адрес
    целое размер
конец

функция данные_пустые(): Данные
    Данные д = Данные(0, 0)
    вернуть д
конец

функция освободить_данные(Данные д)
    если (д.адрес != 0)
        освободить_память(указатель_по_адресу(д.адрес))
    конец
конец

// Превращает первые n байт буфера в обычный текст Сферы и освобождает буфер.
функция текст_из_буфера(текст буфер, целое n): текст
    записать_байт(буфер, n, 0)
    результат из текста часть = подстрока(буфер, 0, n)
    освободить_память(буфер)
    если (часть.успешно)
        вернуть часть.значение
    конец
    вернуть ""
конец

// Копирует байты данных в обычный текст (годится для текстовых вложений; на нулевом байте текст обрывается).
функция данные_в_текст(Данные д): текст
    если (д.адрес == 0)
        вернуть ""
    конец
    текст буфер = выделить_память(д.размер + 8)
    скопировать_память(буфер, указатель_по_адресу(д.адрес), д.размер)
    вернуть текст_из_буфера(буфер, д.размер)
конец

// ---------------------------------------------------------------- основание 64

функция б64_значение(целое б): целое
    если (б >= 65 и б <= 90)
        вернуть б - 65
    конец
    если (б >= 97 и б <= 122)
        вернуть б - 97 + 26
    конец
    если (б >= 48 и б <= 57)
        вернуть б - 48 + 52
    конец
    если (б == 43)
        вернуть 62
    конец
    если (б == 47)
        вернуть 63
    конец
    вернуть -1
конец

// Расшифровывает основание 64. Пробелы и переводы строк пропускаются, «=» завершает данные.
функция декодировать_б64(текст источник): Данные
    целое n = длина(источник)
    текст буфер = выделить_память(n + 8)
    целое выход = 0
    целое накоплено = 0
    целое бит = 0
    целое i = 0
    пока (i < n)
        целое б = целое(байт_текста(источник, i))
        i = i + 1
        если (б == 61)
            прервать
        конец
        целое з = б64_значение(б)
        если (з < 0)
            продолжить
        конец
        накоплено = накоплено * 64 + з
        бит = бит + 6
        если (бит >= 8)
            бит = бит - 8
            целое делитель = 1
            целое k = 0
            пока (k < бит)
                делитель = делитель * 2
                k = k + 1
            конец
            целое старшее = накоплено / делитель
            записать_байт(буфер, выход, старшее % 256)
            выход = выход + 1
            накоплено = накоплено % делитель
        конец
    конец
    Данные итог = Данные(адрес_текста(буфер), выход)
    вернуть итог
конец

функция б64_символ(целое з): целое
    если (з < 26)
        вернуть 65 + з
    конец
    если (з < 52)
        вернуть 97 + з - 26
    конец
    если (з < 62)
        вернуть 48 + з - 52
    конец
    если (з == 62)
        вернуть 43
    конец
    вернуть 47
конец

// Кодирует байты в основание 64. Если ширина_строки больше нуля, после каждых
// ширина_строки знаков ставится «\r\n» (для писем принято 76).
функция кодировать_б64_байты(целое адрес, целое размер, целое ширина_строки): текст
    целое запас = размер / 3 * 4 + 8 + (размер / 3 * 4 / 60 + 1) * 2
    текст буфер = выделить_память(запас + 16)
    целое выход = 0
    целое в_строке = 0
    целое i = 0
    пока (i < размер)
        целое п1 = целое(байт_текста(указатель_по_адресу(адрес + i), 0))
        целое остаток = размер - i
        целое п2 = 0
        целое п3 = 0
        если (остаток > 1)
            п2 = целое(байт_текста(указатель_по_адресу(адрес + i + 1), 0))
        конец
        если (остаток > 2)
            п3 = целое(байт_текста(указатель_по_адресу(адрес + i + 2), 0))
        конец
        целое слово = п1 * 65536 + п2 * 256 + п3
        записать_байт(буфер, выход, б64_символ(слово / 262144 % 64))
        записать_байт(буфер, выход + 1, б64_символ(слово / 4096 % 64))
        если (остаток > 1)
            записать_байт(буфер, выход + 2, б64_символ(слово / 64 % 64))
        иначе
            записать_байт(буфер, выход + 2, 61)
        конец
        если (остаток > 2)
            записать_байт(буфер, выход + 3, б64_символ(слово % 64))
        иначе
            записать_байт(буфер, выход + 3, 61)
        конец
        выход = выход + 4
        в_строке = в_строке + 4
        i = i + 3
        если (ширина_строки > 0 и в_строке >= ширина_строки и i < размер)
            записать_байт(буфер, выход, 13)
            записать_байт(буфер, выход + 1, 10)
            выход = выход + 2
            в_строке = 0
        конец
    конец
    вернуть текст_из_буфера(буфер, выход)
конец

// Кодирует текст (его байты в UTF-8) в основание 64 без переносов строк.
функция кодировать_б64(текст т): текст
    вернуть кодировать_б64_байты(адрес_текста(т), длина(т), 0)
конец

// ---------------------------------------------------------------- печатаемое с экранированием

функция цифра16(целое б): целое
    если (б >= 48 и б <= 57)
        вернуть б - 48
    конец
    если (б >= 65 и б <= 70)
        вернуть б - 55
    конец
    если (б >= 97 и б <= 102)
        вернуть б - 87
    конец
    вернуть -1
конец

// Расшифровывает «печатаемое с экранированием»: «=D0» — байт, «=» в конце строки — мягкий перенос.
// В заголовках (в_заголовке = верно) знак «_» означает пробел.
функция декодировать_печатаемое(текст источник, верно в_заголовке): Данные
    целое n = длина(источник)
    текст буфер = выделить_память(n + 8)
    целое выход = 0
    целое i = 0
    пока (i < n)
        целое б = целое(байт_текста(источник, i))
        если (б == 61 и i + 2 < n)
            целое в1 = цифра16(целое(байт_текста(источник, i + 1)))
            целое в2 = цифра16(целое(байт_текста(источник, i + 2)))
            если (в1 >= 0 и в2 >= 0)
                записать_байт(буфер, выход, в1 * 16 + в2)
                выход = выход + 1
                i = i + 3
                продолжить
            конец
        конец
        если (б == 61 и i + 1 < n)
            // мягкий перенос: «=» и конец строки
            целое след = целое(байт_текста(источник, i + 1))
            если (след == 13)
                i = i + 2
                если (i < n и целое(байт_текста(источник, i)) == 10)
                    i = i + 1
                конец
                продолжить
            конец
            если (след == 10)
                i = i + 2
                продолжить
            конец
        конец
        если (б == 61 и i + 1 == n)
            i = i + 1
            продолжить
        конец
        если (в_заголовке и б == 95)
            б = 32
        конец
        записать_байт(буфер, выход, б)
        выход = выход + 1
        i = i + 1
    конец
    Данные итог = Данные(адрес_текста(буфер), выход)
    вернуть итог
конец

// ---------------------------------------------------------------- кодировки текста и заголовки

// Дописывает в буфер один знак по его номеру в Юникоде (в виде UTF-8). Возвращает новое смещение.
функция писать_знак(текст буфер, целое выход, целое код): целое
    если (код < 128)
        записать_байт(буфер, выход, код)
        вернуть выход + 1
    конец
    если (код < 2048)
        записать_байт(буфер, выход, 192 + код / 64)
        записать_байт(буфер, выход + 1, 128 + код % 64)
        вернуть выход + 2
    конец
    записать_байт(буфер, выход, 224 + код / 4096)
    записать_байт(буфер, выход + 1, 128 + код / 64 % 64)
    записать_байт(буфер, выход + 2, 128 + код % 64)
    вернуть выход + 3
конец

// Номера знаков Юникода для верхней половины windows-1251 (байты 128…191), которые не идут подряд с «А».
функция знак_1251_верхний(целое б): целое
    если (б == 168)
        вернуть 1025
    конец
    если (б == 184)
        вернуть 1105
    конец
    если (б == 150)
        вернуть 8211
    конец
    если (б == 151)
        вернуть 8212
    конец
    если (б == 171)
        вернуть 171
    конец
    если (б == 187)
        вернуть 187
    конец
    если (б == 185)
        вернуть 8470
    конец
    если (б == 145)
        вернуть 8216
    конец
    если (б == 146)
        вернуть 8217
    конец
    если (б == 147)
        вернуть 8220
    конец
    если (б == 148)
        вернуть 8221
    конец
    если (б == 133)
        вернуть 8230
    конец
    если (б == 160)
        вернуть 160
    конец
    если (б == 136)
        вернуть 8364
    конец
    вернуть 63
конец

// КОИ8-Р: байты 192…255 идут в порядке «юабцдефгхийклмнопярстужвьызшэщчъ» и тех же заглавных.
функция знак_кои8р(целое б): целое
    если (б < 128)
        вернуть б
    конец
    если (б == 163)
        вернуть 1105
    конец
    если (б == 179)
        вернуть 1025
    конец
    если (б >= 192 и б < 224)
        // строчные: ю а б ц д е ф г х и й к л м н о п я р с т у ж в ь ы з ш э щ ч ъ
        целое номер = б - 192
        целое[] порядок = массив(1102, 1072, 1073, 1094, 1076, 1077, 1092, 1075, 1093, 1080, 1081, 1082, 1083, 1084, 1085, 1086, 1087, 1103, 1088, 1089, 1090, 1091, 1078, 1074, 1100, 1099, 1079, 1096, 1101, 1097, 1095, 1098)
        вернуть порядок(номер)
    конец
    если (б >= 224)
        целое номер = б - 224
        целое[] порядок = массив(1070, 1040, 1041, 1062, 1044, 1045, 1060, 1043, 1061, 1048, 1049, 1050, 1051, 1052, 1053, 1054, 1055, 1071, 1056, 1057, 1058, 1059, 1046, 1042, 1068, 1067, 1047, 1064, 1069, 1065, 1063, 1066)
        вернуть порядок(номер)
    конец
    вернуть 63
конец

// Нижний регистр только для латинских букв (имена кодировок и типов).
функция нижний_латинский(текст т): текст
    целое n = длина(т)
    текст буфер = выделить_память(n + 8)
    целое i = 0
    пока (i < n)
        целое б = целое(байт_текста(т, i))
        если (б >= 65 и б <= 90)
            б = б + 32
        конец
        записать_байт(буфер, i, б)
        i = i + 1
    конец
    вернуть текст_из_буфера(буфер, n)
конец

// Переводит байты в UTF-8 по названию кодировки (utf-8, windows-1251, koi8-r, iso-8859-1, us-ascii).
// Неизвестные названия считаются UTF-8.
функция байты_в_текст(Данные д, текст название): текст
    если (д.адрес == 0)
        вернуть ""
    конец
    текст имя = нижний_латинский(название)
    верно в_1251 = имя == "windows-1251" или имя == "cp1251" или имя == "win-1251"
    верно в_кои = имя == "koi8-r" или имя == "koi8r"
    верно в_латинице1 = имя == "iso-8859-1" или имя == "latin1"
    если ( не в_1251 и не в_кои и не в_латинице1)
        вернуть данные_в_текст(д)
    конец
    текст буфер = выделить_память(д.размер * 3 + 8)
    целое выход = 0
    целое i = 0
    пока (i < д.размер)
        целое б = целое(байт_текста(указатель_по_адресу(д.адрес + i), 0))
        целое код = б
        если (б >= 128)
            если (в_1251)
                если (б >= 192)
                    код = 1040 + б - 192
                иначе
                    код = знак_1251_верхний(б)
                конец
            конец
            если (в_кои)
                код = знак_кои8р(б)
            конец
        конец
        выход = писать_знак(буфер, выход, код)
        i = i + 1
    конец
    вернуть текст_из_буфера(буфер, выход)
конец

// Расшифровывает заголовок с «словами» =?кодировка?B|Q?…?=. Обычный текст остаётся как есть.
// Пробелы между соседними «словами» отбрасываются (так сказано в стандарте).
функция декодировать_заголовок(текст т): текст
    целое n = длина(т)
    текст буфер = выделить_память(n * 3 + 16)
    целое выход = 0
    целое i = 0
    верно прошлое_слово = нет
    пока (i < n)
        целое б = целое(байт_текста(т, i))
        если (б == 61 и i + 1 < n и целое(байт_текста(т, i + 1)) == 63)
            // =?кодировка?способ?данные?=
            целое к1 = i + 2
            целое к2 = к1
            пока (к2 < n и целое(байт_текста(т, к2)) != 63)
                к2 = к2 + 1
            конец
            целое с1 = к2 + 1
            целое д1 = с1 + 2
            целое д2 = д1
            пока (д2 + 1 < n и не (целое(байт_текста(т, д2)) == 63 и целое(байт_текста(т, д2 + 1)) == 61))
                д2 = д2 + 1
            конец
            если (к2 < n и с1 + 1 < n и д2 + 1 < n)
                результат из текста кодировка = подстрока(т, к1, к2 - к1)
                результат из текста данные = подстрока(т, д1, д2 - д1)
                результат из текста способ = подстрока(т, с1, 1)
                если (кодировка.успешно и данные.успешно и способ.успешно)
                    целое звездочка = 0
                    Данные сырые = данные_пустые()
                    если (нижний_латинский(способ.значение) == "b")
                        сырые = декодировать_б64(данные.значение)
                    иначе
                        сырые = декодировать_печатаемое(данные.значение, да)
                    конец
                    // кодировка может содержать язык после «*» (RFC 2231) — отбрасываем
                    текст название = кодировка.значение
                    результат из целого звезда = найти(название, "*")
                    если (звезда.успешно)
                        результат из текста короткое = подстрока(название, 0, звезда.значение)
                        если (короткое.успешно)
                            название = короткое.значение
                        конец
                    конец
                    текст часть = байты_в_текст(сырые, название)
                    освободить_данные(сырые)
                    целое k = 0
                    целое m = длина(часть)
                    пока (k < m)
                        записать_байт(буфер, выход, целое(байт_текста(часть, k)))
                        выход = выход + 1
                        k = k + 1
                    конец
                    i = д2 + 2
                    прошлое_слово = да
                    продолжить
                конец
            конец
        конец
        // пробелы между соседними закодированными словами не нужны
        если (прошлое_слово и (б == 32 или б == 9 или б == 13 или б == 10))
            целое j = i
            пока (j < n и (целое(байт_текста(т, j)) == 32 или целое(байт_текста(т, j)) == 9 или целое(байт_текста(т, j)) == 13 или целое(байт_текста(т, j)) == 10))
                j = j + 1
            конец
            если (j + 1 < n и целое(байт_текста(т, j)) == 61 и целое(байт_текста(т, j + 1)) == 63)
                i = j
                продолжить
            конец
        конец
        записать_байт(буфер, выход, б)
        выход = выход + 1
        прошлое_слово = нет
        i = i + 1
    конец
    вернуть текст_из_буфера(буфер, выход)
конец
