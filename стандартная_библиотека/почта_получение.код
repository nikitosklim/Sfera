// почта_получение.код — получение почты (протокол «IMAP», по-русски «получение»).
//
// Подключается как "подключить почта_получение;". Нужна сборка с
//   --линковать ssl --линковать crypto
//
//   ящик_открыть(узел, порт, файл_доверия, имя, пароль): Ящик   — если ящик.открыт == нет, причина в ящик.сбой
//   ящик_список(Ящик, сколько_последних): Список из ПисьмоВСписке
//   ящик_письмо(Ящик, код): Письмо                              — полное письмо с вложениями
//   ящик_прочитано(Ящик, код)                                    — поставить отметку «прочитано»
//   ящик_удалить(Ящик, код)                                      — удалить письмо
//   ящик_закрыть(Ящик)
//
// «Код» письма — его постоянный номер на сервере (он не меняется, пока письмо существует).
// Латинские слова протокола (LOGIN, SELECT, FETCH) — это слова самого протокола,
// они живут только внутри строк этого файла; наружу выходят русские имена.

подключить почта_защита;
подключить почта_письмо;

структура Ящик
    целое дескриптор
    целое счётчик
    верно открыт
    текст сбой
    целое писем
конец

структура ПисьмоВСписке
    целое номер
    целое код
    текст от_кого
    текст тема
    текст дата
    целое размер
    верно прочитано
конец

структура Ответ
    верно успешно
    текст сообщение
    Список из текстов строки
конец

// Отметка, которой в списке строк ответа помечается «литерал» (кусок данных произвольной длины).
функция метка_литерала(): текст
    вернуть "<<ЛИТЕРАЛ>>"
конец

// Берёт из строки число после слова: число_после("UID 17 FLAGS", "UID ") = 17. Нет слова — -1.
функция число_после(текст строка, текст слово): целое
    целое п = найти_от(строка, слово, 0)
    если (п < 0)
        вернуть -1
    конец
    целое i = п + длина(слово)
    целое n = длина(строка)
    целое значение = 0
    целое цифр = 0
    пока (i < n)
        целое б = целое(байт_текста(строка, i))
        если (б < 48 или б > 57)
            прервать;
        конец
        значение = значение * 10 + (б - 48)
        цифр = цифр + 1
        i = i + 1
    конец
    если (цифр == 0)
        вернуть -1
    конец
    вернуть значение
конец

// Размер литерала в конце строки «… {151}»; -1, если строка так не заканчивается.
функция размер_литерала(текст строка): целое
    целое n = длина(строка)
    если (n < 3 или целое(байт_текста(строка, n - 1)) != 125)
        вернуть -1
    конец
    целое i = n - 2
    пока (i >= 0 и целое(байт_текста(строка, i)) >= 48 и целое(байт_текста(строка, i)) <= 57)
        i = i - 1
    конец
    если (i < 0 или целое(байт_текста(строка, i)) != 123 или i == n - 2)
        вернуть -1
    конец
    вернуть число_после(строка, "{")
конец

// Заключает текст в кавычки по правилам протокола (обратная косая черта и кавычка экранируются).
функция в_кавычки(текст т): текст
    текст итог = "\""
    целое n = длина(т)
    целое i = 0
    пока (i < n)
        целое б = целое(байт_текста(т, i))
        если (б == 92 или б == 34)
            итог = итог + "\\"
        конец
        итог = итог + часть(т, i, 1)
        i = i + 1
    конец
    вернуть итог + "\""
конец

// Отправляет команду и собирает весь ответ до строки с её меткой.
функция ящик_команда(Ящик я, текст команда): Ответ
    я.счётчик = я.счётчик + 1
    текст метка = "a" + целое_в_текст(я.счётчик)
    Ответ о = Ответ(нет, "", Список из текстов())
    если (защита_отправить(я.дескриптор, метка + " " + команда + "\r\n") < 1)
        о.сообщение = "не удалось отправить команду"
        вернуть о
    конец
    пока (да)
        текст строка = защита_прочитать_строку(я.дескриптор)
        если (длина(строка) == 0)
            о.сообщение = "соединение прервано"
            вернуть о
        конец
        если (начинается_с(строка, метка + " "))
            о.успешно = начинается_с(строка, метка + " OK")
            о.сообщение = часть(строка, длина(метка) + 1, длина(строка))
            вернуть о
        конец
        о.строки.добавить(строка)
        целое размер = размер_литерала(строка)
        если (размер >= 0)
            о.строки.добавить(метка_литерала())
            о.строки.добавить(защита_прочитать_точно(я.дескриптор, размер))
        конец
    конец
    вернуть о
конец

функция ящик_открыть(текст узел, целое порт, текст файл_доверия, текст имя, текст пароль): Ящик
    Ящик я = Ящик(0, 0, нет, "", 0)
    я.дескриптор = защита_открыть(узел, порт, файл_доверия)
    если (я.дескриптор == 0)
        я.сбой = "не удалось установить защищённое соединение (проверьте адрес сервера и сертификат)"
        вернуть я
    конец
    текст приветствие = защита_прочитать_строку(я.дескриптор)
    если ( не начинается_с(приветствие, "* OK"))
        я.сбой = "сервер не ответил приветствием"
        защита_закрыть(я.дескриптор)
        я.дескриптор = 0
        вернуть я
    конец
    Ответ о = ящик_команда(я, "LOGIN " + в_кавычки(имя) + " " + в_кавычки(пароль))
    если ( не о.успешно)
        я.сбой = "вход не удался: " + о.сообщение
        защита_закрыть(я.дескриптор)
        я.дескриптор = 0
        вернуть я
    конец
    Ответ в_папку = ящик_команда(я, "SELECT INBOX")
    если ( не в_папку.успешно)
        я.сбой = "не удалось открыть папку «Входящие»: " + в_папку.сообщение
        вернуть я
    конец
    для каждого с в в_папку.строки
        если (начинается_с(с, "* ") и найти_от(с, " EXISTS", 0) > 0)
            я.писем = число_после(с, "* ")
        конец
    конец
    я.открыт = да
    вернуть я
конец

// Список писем: последние «сколько» писем папки «Входящие» (0 — все), в порядке на сервере (старые первыми).
функция ящик_список(Ящик я, целое сколько): Список из ПисьмоВСписке
    Список из ПисьмоВСписке итог = Список из ПисьмоВСписке()
    если ( не я.открыт или я.писем < 1)
        вернуть итог
    конец
    целое с = 1
    если (сколько > 0 и я.писем > сколько)
        с = я.писем - сколько + 1
    конец
    Ответ о = ящик_команда(я, "FETCH " + целое_в_текст(с) + ":" + целое_в_текст(я.писем) + " (UID FLAGS RFC822.SIZE BODY.PEEK[HEADER.FIELDS (FROM SUBJECT DATE)])")
    если ( не о.успешно)
        я.сбой = "не удалось получить список: " + о.сообщение
        вернуть итог
    конец
    целое i = 0
    целое n = о.строки.размер()
    пока (i < n)
        текст строка = о.строки.получить(i)
        если (начинается_с(строка, "* ") и найти_от(строка, " FETCH ", 0) > 0)
            ПисьмоВСписке п = ПисьмоВСписке(число_после(строка, "* "), число_после(строка, "UID "), "", "", "", число_после(строка, "RFC822.SIZE "), нет)
            п.прочитано = найти_от(строка, "\\Seen", 0) >= 0
            если (i + 2 < n и о.строки.получить(i + 1) == метка_литерала())
                текст заголовки = о.строки.получить(i + 2)
                п.от_кого = декодировать_заголовок(значение_заголовка(заголовки, "from"))
                п.тема = декодировать_заголовок(значение_заголовка(заголовки, "subject"))
                п.дата = значение_заголовка(заголовки, "date")
                i = i + 2
            конец
            итог.добавить(п)
        конец
        i = i + 1
    конец
    вернуть итог
конец

// Полное письмо по коду. Если не вышло — письмо пустое, причина в ящик.сбой.
функция ящик_письмо(Ящик я, целое код): Письмо
    Ответ о = ящик_команда(я, "UID FETCH " + целое_в_текст(код) + " BODY.PEEK[]")
    если ( не о.успешно)
        я.сбой = "не удалось получить письмо: " + о.сообщение
        вернуть разобрать_письмо("")
    конец
    целое i = 0
    пока (i + 1 < о.строки.размер())
        если (о.строки.получить(i) == метка_литерала())
            вернуть разобрать_письмо(о.строки.получить(i + 1))
        конец
        i = i + 1
    конец
    я.сбой = "сервер не прислал письмо"
    вернуть разобрать_письмо("")
конец

функция ящик_прочитано(Ящик я, целое код)
    ящик_команда(я, "UID STORE " + целое_в_текст(код) + " +FLAGS (\\Seen)")
конец

функция ящик_удалить(Ящик я, целое код)
    ящик_команда(я, "UID STORE " + целое_в_текст(код) + " +FLAGS (\\Deleted)")
    ящик_команда(я, "EXPUNGE")
конец

функция ящик_закрыть(Ящик я)
    если (я.дескриптор != 0)
        ящик_команда(я, "LOGOUT")
        защита_закрыть(я.дескриптор)
        я.дескриптор = 0
    конец
    я.открыт = нет
конец
