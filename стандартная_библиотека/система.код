// система.код — сведения о компьютере и содержимое папок (Linux).
//
// Подключается как `подключить система;` (сам подключает `память` и `зос`).
//
//   прочитать_системный_файл(путь): результат из текста
//        — читает файл кусками, в том числе «виртуальные» файлы Linux вроде
//          /proc/meminfo, у которых размер равен нулю (встроенная
//          `прочитать_файл` их не читает)
//   список_папки(путь): результат из Список из ЗаписьПапки
//        — имена, размеры, даты и признак «папка»; сначала папки, потом файлы,
//          внутри — по алфавиту (побайтово, регистр учитывается)
//   сведения_о_системе(путь_диска): текст
//        — ЗОС с параметрами компьютера: ОС, ядро, процессор, память, диск,
//          время работы, нагрузка
//
// ⚠️ Честно, узко:
// - Только Linux x86_64 (для macOS и Windows другие структуры в памяти).
//   Это нужно серверу: проводник и панель сведений работают с Linux-сервером.
// - Размер и дата берутся из системного вызова stat по смещениям структуры
//   x86_64; для ARM/macOS смещения иные — там модуль работать не будет.
// - Названия в /proc зависят от ядра; недостающие значения возвращаются
//   как 0 или пустой текст, а не как ошибка.

подключить память;
подключить зос;

внешняя функция системный_открыть(текст путь, целое32 флаги): целое32 как "open";
внешняя функция системный_читать(целое32 дескриптор, текст буфер, целое размер): целое как "read";
внешняя функция системный_закрыть(целое32 дескриптор): целое32 как "close";
внешняя функция системный_открыть_папку(текст путь): текст как "opendir";
внешняя функция системный_читать_папку(текст папка): текст как "readdir";
внешняя функция системный_закрыть_папку(текст папка): целое32 как "closedir";
внешняя функция системный_состояние(текст путь, текст буфер): целое32 как "stat";
// Приём как в приложение_android.код: llabs от адреса даёт 0 только для пустого указателя.
внешняя функция система_адрес(текст р): целое64 как "llabs";
внешняя функция системный_состояние_диска(текст путь, текст буфер): целое32 как "statvfs";

структура ЗаписьПапки
    текст имя;
    верно папка;
    целое размер;
    целое изменён;
конец

функция система_указатель_пуст(текст р): верно
    вернуть система_адрес(р) == целое64(0);
конец

// ------------------------------------------------------------ чтение системных файлов

функция прочитать_системный_файл(текст путь): результат из текста
    целое32 д = системный_открыть(путь, целое32(0));
    если (д меньше целое32(0))
        вернуть ошибка("не удалось открыть " + путь);
    конец
    целое ёмкость = 8192;
    текст буфер = выделить_память(ёмкость + 1);
    текст кусок = выделить_память(4096);
    целое занято = 0;
    пока (да)
        целое прочитано = системный_читать(д, кусок, 4096);
        если (прочитано меньше 1)
            записать_байт(буфер, занято, 0);
            системный_закрыть(д);
            освободить_память(кусок);
            вернуть успех(буфер);
        конец
        если (занято + прочитано больше ёмкость)
            целое новая = ёмкость * 2;
            текст больший = выделить_память(новая + 1);
            скопировать_память(больший, буфер, занято);
            освободить_память(буфер);
            буфер = больший;
            ёмкость = новая;
        конец
        целое i = 0;
        пока (i меньше прочитано)
            записать_байт(буфер, занято + i, целое(байт_текста(кусок, i)));
            i = i + 1;
        конец
        занято = занято + прочитано;
    конец
    вернуть успех(буфер);
конец

// ------------------------------------------------------------ байты из памяти

// Беззнаковое 64-битное число из восьми байт по смещению (порядок байт — little-endian).
функция система_число64(текст буфер, целое смещение): целое
    целое значение = 0;
    целое k = 7;
    пока (k не меньше 0)
        значение = значение * 256 + целое(байт_текста(буфер, смещение + k));
        k = k - 1;
    конец
    вернуть значение;
конец

функция система_число32(текст буфер, целое смещение): целое
    целое значение = 0;
    целое k = 3;
    пока (k не меньше 0)
        значение = значение * 256 + целое(байт_текста(буфер, смещение + k));
        k = k - 1;
    конец
    вернуть значение;
конец

// Строка с нулём на конце по смещению → новый текст.
функция система_строка(текст буфер, целое смещение): текст
    целое n = 0;
    пока (целое(байт_текста(буфер, смещение + n)) != 0)
        n = n + 1;
    конец
    текст копия = выделить_память(n + 1);
    целое i = 0;
    пока (i меньше n)
        записать_байт(копия, i, целое(байт_текста(буфер, смещение + i)));
        i = i + 1;
    конец
    записать_байт(копия, n, 0);
    вернуть копия;
конец

// ------------------------------------------------------------ папки

// Сравнение двух текстов побайтово: -1, 0, 1.
функция система_сравнить(текст а, текст б): целое
    целое la = длина(а);
    целое lb = длина(б);
    целое i = 0;
    пока (i меньше la и i меньше lb)
        целое x = целое(байт_текста(а, i));
        целое y = целое(байт_текста(б, i));
        если (x меньше y)
            вернуть -1;
        конец
        если (x больше y)
            вернуть 1;
        конец
        i = i + 1;
    конец
    если (la == lb)
        вернуть 0;
    конец
    если (la меньше lb)
        вернуть -1;
    конец
    вернуть 1;
конец

// Первая запись должна стоять раньше второй: папки раньше файлов, затем по имени.
функция система_раньше(ЗаписьПапки а, ЗаписьПапки б): верно
    если (а.папка и не б.папка)
        вернуть да;
    конец
    если (б.папка и не а.папка)
        вернуть нет;
    конец
    вернуть система_сравнить(а.имя, б.имя) меньше 0;
конец

// Папка ли это (по системному вызову stat).
функция это_папка(текст путь): верно
    текст состояние = выделить_память(256);
    верно итог = нет;
    если (системный_состояние(путь, состояние) == целое32(0))
        итог = (система_число32(состояние, 24) & 61440) == 16384;
    конец
    освободить_память(состояние);
    вернуть итог;
конец

// Сортировка вставками: папки раньше файлов, затем по имени.
функция система_упорядочить(Список из ЗаписьПапки записи)
    целое i = 1;
    пока (i меньше записи.размер())
        ЗаписьПапки х = записи.получить(i);
        целое j = i - 1;
        пока (j не меньше 0 и система_раньше(х, записи.получить(j)))
            записи.установить(j + 1, записи.получить(j));
            j = j - 1;
        конец
        записи.установить(j + 1, х);
        i = i + 1;
    конец
конец

функция список_папки(текст путь): результат из Список из ЗаписьПапки
    текст папка = системный_открыть_папку(путь);
    если (система_указатель_пуст(папка))
        вернуть ошибка("не удалось открыть папку " + путь);
    конец
    Список из ЗаписьПапки записи = Список из ЗаписьПапки();
    текст состояние = выделить_память(256);
    пока (да)
        текст запись = системный_читать_папку(папка);
        если (система_указатель_пуст(запись))
            системный_закрыть_папку(папка);
            освободить_память(состояние);
            система_упорядочить(записи);
            вернуть успех(записи);
        конец
        // struct dirent (Linux x86_64): d_name начинается с байта 19
        текст имя = система_строка(запись, 19);
        если (имя != "." и имя != "..")
            текст полный = путь + "/" + имя;
            ЗаписьПапки новая = ЗаписьПапки(имя, нет, 0, 0);
            если (системный_состояние(полный, состояние) == целое32(0))
                // struct stat (Linux x86_64): st_mode — байт 24, st_size — 48, st_mtime — 88
                целое режим = система_число32(состояние, 24);
                новая = ЗаписьПапки(имя, (режим & 61440) == 16384, система_число64(состояние, 48), система_число64(состояние, 88));
            конец
            записи.добавить(новая);
        конец
    конец
    вернуть успех(записи);
конец

// ------------------------------------------------------------ сведения о компьютере

// Безопасная подстрока: при любой ошибке пустой текст.
функция система_кусок(текст источник, целое начало, целое сколько): текст
    если (начало меньше 0 или сколько меньше 0)
        вернуть "";
    конец
    результат из текста часть = подстрока(источник, начало, сколько);
    если (часть.успешно)
        вернуть часть.значение;
    конец
    вернуть "";
конец

// Убирает пробелы, переводы строк и парные кавычки по краям.
функция система_обрезать(текст с): текст
    целое a = 0;
    целое b = длина(с);
    пока (a меньше b и (целое(байт_текста(с, a)) == 32 или целое(байт_текста(с, a)) == 9 или целое(байт_текста(с, a)) == 34))
        a = a + 1;
    конец
    пока (b больше a и (целое(байт_текста(с, b - 1)) == 32 или целое(байт_текста(с, b - 1)) == 10 или целое(байт_текста(с, b - 1)) == 9 или целое(байт_текста(с, b - 1)) == 34 или целое(байт_текста(с, b - 1)) == 13))
        b = b - 1;
    конец
    вернуть система_кусок(с, a, b - a);
конец

// Значение строки вида «ключ: значение» или «ключ=значение» в тексте файла.
// Ключ должен стоять в начале строки. Нет такой строки — пустой текст.
функция система_значение(текст файл, текст ключ): текст
    целое n = длина(файл);
    целое k = длина(ключ);
    целое начало = 0;
    пока (начало меньше n)
        целое конец_строки = начало;
        пока (конец_строки меньше n и целое(байт_текста(файл, конец_строки)) != 10)
            конец_строки = конец_строки + 1;
        конец
        если (конец_строки - начало больше k и система_кусок(файл, начало, k) == ключ)
            целое п = начало + k;
            пока (п меньше конец_строки и (целое(байт_текста(файл, п)) == 32 или целое(байт_текста(файл, п)) == 9))
                п = п + 1;
            конец
            если (п меньше конец_строки и (целое(байт_текста(файл, п)) == 58 или целое(байт_текста(файл, п)) == 61))
                вернуть система_обрезать(система_кусок(файл, п + 1, конец_строки - п - 1));
            конец
        конец
        начало = конец_строки + 1;
    конец
    вернуть "";
конец

// Сколько строк в файле начинаются с ключа (например, «processor» в /proc/cpuinfo).
функция система_строк_с_ключом(текст файл, текст ключ): целое
    целое n = длина(файл);
    целое k = длина(ключ);
    целое начало = 0;
    целое сколько = 0;
    пока (начало меньше n)
        целое конец_строки = начало;
        пока (конец_строки меньше n и целое(байт_текста(файл, конец_строки)) != 10)
            конец_строки = конец_строки + 1;
        конец
        если (конец_строки - начало не меньше k и система_кусок(файл, начало, k) == ключ)
            сколько = сколько + 1;
        конец
        начало = конец_строки + 1;
    конец
    вернуть сколько;
конец

// «16384 kB» → 16384 (число в начале текста; нет числа — 0).
функция система_число_в_начале(текст с): целое
    целое значение = 0;
    целое i = 0;
    пока (i меньше длина(с) и целое(байт_текста(с, i)) не меньше 48 и целое(байт_текста(с, i)) не больше 57)
        значение = значение * 10 + (целое(байт_текста(с, i)) - 48);
        i = i + 1;
    конец
    вернуть значение;
конец

// Содержимое системного файла или пустой текст, если его нет.
функция система_файл_или_пусто(текст путь): текст
    результат из текста р = прочитать_системный_файл(путь);
    если (р.успешно)
        вернуть р.значение;
    конец
    вернуть "";
конец

// Параметры компьютера в виде ЗОС (Linux). Объём диска считается для папки путь_диска.
// Поля: хост, ос, ядро, процессор, ядер, память_всего_кб, память_доступно_кб,
// своп_всего_кб, своп_свободно_кб, диск_всего, диск_свободно (байты),
// время_работы_сек, нагрузка, время_сервера (юникс-секунды).
функция сведения_о_системе(текст путь_диска): текст
    текст память = система_файл_или_пусто("/proc/meminfo");
    текст процессор = система_файл_или_пусто("/proc/cpuinfo");
    текст выпуск = система_файл_или_пусто("/etc/os-release");
    текст работа = система_файл_или_пусто("/proc/uptime");
    текст нагрузка = система_файл_или_пусто("/proc/loadavg");

    целое диск_всего = 0;
    целое диск_свободно = 0;
    текст буфер_диска = выделить_память(256);
    если (системный_состояние_диска(путь_диска, буфер_диска) == целое32(0))
        целое блок = система_число64(буфер_диска, 8);
        диск_всего = система_число64(буфер_диска, 16) * блок;
        диск_свободно = система_число64(буфер_диска, 32) * блок;
    конец
    освободить_память(буфер_диска);

    текст имя_ос = система_значение(выпуск, "PRETTY_NAME");
    если (длина(имя_ос) == 0)
        имя_ос = "Linux";
    конец
    текст модель = система_значение(процессор, "model name");
    если (длина(модель) == 0)
        модель = "неизвестно";
    конец
    целое ядер = система_строк_с_ключом(процессор, "processor");
    целое секунд = система_число_в_начале(работа);

    // «0.15 0.10 0.05 1/234 5678» → «0.15 0.10 0.05»
    текст средняя = нагрузка;
    целое пробелов = 0;
    целое i = 0;
    пока (i меньше длина(нагрузка) и пробелов меньше 3)
        если (целое(байт_текста(нагрузка, i)) == 32)
            пробелов = пробелов + 1;
        конец
        i = i + 1;
    конец
    если (пробелов == 3)
        средняя = система_кусок(нагрузка, 0, i - 1);
    иначе
        средняя = система_обрезать(нагрузка);
    конец

    текст пары = зос_пара_текст("хост", система_обрезать(система_файл_или_пусто("/proc/sys/kernel/hostname")));
    пары = пары + "," + зос_пара_текст("ос", имя_ос);
    пары = пары + "," + зос_пара_текст("ядро", система_обрезать(система_файл_или_пусто("/proc/sys/kernel/osrelease")));
    пары = пары + "," + зос_пара_текст("процессор", модель);
    пары = пары + "," + зос_пара_целое("ядер", ядер);
    пары = пары + "," + зос_пара_целое("память_всего_кб", система_число_в_начале(система_значение(память, "MemTotal")));
    пары = пары + "," + зос_пара_целое("память_доступно_кб", система_число_в_начале(система_значение(память, "MemAvailable")));
    пары = пары + "," + зос_пара_целое("своп_всего_кб", система_число_в_начале(система_значение(память, "SwapTotal")));
    пары = пары + "," + зос_пара_целое("своп_свободно_кб", система_число_в_начале(система_значение(память, "SwapFree")));
    пары = пары + "," + зос_пара_целое("диск_всего", диск_всего);
    пары = пары + "," + зос_пара_целое("диск_свободно", диск_свободно);
    пары = пары + "," + зос_пара_целое("время_работы_сек", секунд);
    пары = пары + "," + зос_пара_текст("нагрузка", средняя);
    пары = пары + "," + зос_пара_целое("время_сервера", юникс_время());
    вернуть зос_объект(пары);
конец
