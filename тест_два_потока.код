внешняя функция подождать_секунды(беззнак32 секунды) как "sleep";

функция медленный_поток() -> целое {
    подождать_секунды(2);
    вывести("Медленный поток (2 сек) завершился");
    вернуть 0;
}

функция быстрый_поток() -> целое {
    подождать_секунды(1);
    вывести("Быстрый поток (1 сек) завершился");
    вернуть 0;
}

функция главная() -> целое {
    вывести("Запускаю медленный поток первым в коде...");
    параллельно {
        медленный_поток();
    }

    вывести("Запускаю быстрый поток вторым в коде...");
    параллельно {
        быстрый_поток();
    }

    // Если выполнение реально параллельное — быстрый поток (1 сек)
    // выведет своё сообщение РАНЬШЕ медленного (2 сек), несмотря на то,
    // что запущен ВТОРЫМ в коде. Если бы выполнение было
    // последовательным — порядок совпал бы с порядком в коде.
    подождать_секунды(3);
    вывести("Главная функция завершается");

    вернуть 0;
}
