// Змейка — игра для браузера на Сфере.
// Управление: стрелки или WASD. После проигрыша — пробел.
// Сборка для itch.io: ./собрать-игру.sh игры/змейка.код

подключить игра;

неизменно целое КЛЕТКА = 20;
неизменно целое ШИРИНА = 24;
неизменно целое ВЫСОТА = 16;
неизменно целое ШАГ_МС = 110;

Список из целых тело_х = Список из целых();
Список из целых тело_у = Список из целых();
целое направление_х = 1;
целое направление_у = 0;
целое следующий_х = 1;
целое следующий_у = 0;
целое еда_х = 5;
целое еда_у = 5;
целое очки = 0;
целое рекорд = 0;
верно проиграли = нет;
целое прошлый_шаг = 0;

функция новая_еда()
    еда_х = случайное(ШИРИНА);
    еда_у = случайное(ВЫСОТА);
конец

функция занято(целое х, целое у): верно
    целое i = 0;
    пока (i меньше тело_х.размер())
        если (тело_х.получить(i) == х и тело_у.получить(i) == у)
            вернуть да;
        конец
        i = i + 1;
    конец
    вернуть нет;
конец

функция начать()
    тело_х = Список из целых();
    тело_у = Список из целых();
    тело_х.добавить(10);
    тело_у.добавить(8);
    тело_х.добавить(9);
    тело_у.добавить(8);
    тело_х.добавить(8);
    тело_у.добавить(8);
    направление_х = 1;
    направление_у = 0;
    следующий_х = 1;
    следующий_у = 0;
    очки = 0;
    проиграли = нет;
    новая_еда();
    пока (занято(еда_х, еда_у))
        новая_еда();
    конец
конец

функция читать_клавиши()
    если ((клавиша("влево") или клавиша("a")) и направление_х == 0)
        следующий_х = 0 - 1;
        следующий_у = 0;
    конец
    если ((клавиша("вправо") или клавиша("d")) и направление_х == 0)
        следующий_х = 1;
        следующий_у = 0;
    конец
    если ((клавиша("вверх") или клавиша("w")) и направление_у == 0)
        следующий_х = 0;
        следующий_у = 0 - 1;
    конец
    если ((клавиша("вниз") или клавиша("s")) и направление_у == 0)
        следующий_х = 0;
        следующий_у = 1;
    конец
конец

функция шаг()
    направление_х = следующий_х;
    направление_у = следующий_у;
    целое новая_х = тело_х.получить(0) + направление_х;
    целое новая_у = тело_у.получить(0) + направление_у;

    если (новая_х меньше 0 или новая_х не меньше ШИРИНА или новая_у меньше 0 или новая_у не меньше ВЫСОТА)
        проиграли = да;
        звук(120, 300);
        вернуть;
    конец
    если (занято(новая_х, новая_у))
        проиграли = да;
        звук(120, 300);
        вернуть;
    конец

    Список из целых х2 = Список из целых();
    Список из целых у2 = Список из целых();
    х2.добавить(новая_х);
    у2.добавить(новая_у);
    целое длина_тела = тело_х.размер();
    целое i = 0;
    пока (i меньше длина_тела)
        х2.добавить(тело_х.получить(i));
        у2.добавить(тело_у.получить(i));
        i = i + 1;
    конец

    если (новая_х == еда_х и новая_у == еда_у)
        очки = очки + 1;
        звук(660, 60);
        если (очки больше рекорд)
            рекорд = очки;
            сохранить("змейка-рекорд", рекорд);
        конец
        тело_х = х2;
        тело_у = у2;
        новая_еда();
        пока (занято(еда_х, еда_у))
            новая_еда();
        конец
    иначе
        х2.удалить(х2.размер() - 1);
        у2.удалить(у2.размер() - 1);
        тело_х = х2;
        тело_у = у2;
    конец
конец

функция рисовать()
    очистить(16, 24, 32);
    цвет(30, 44, 58);
    прямоугольник(0, 0, ШИРИНА * КЛЕТКА, ВЫСОТА * КЛЕТКА);
    цвет(235, 90, 70);
    круг(еда_х * КЛЕТКА + КЛЕТКА / 2, еда_у * КЛЕТКА + КЛЕТКА / 2, КЛЕТКА / 2 - 2);
    целое i = 0;
    пока (i меньше тело_х.размер())
        если (i == 0)
            цвет(120, 230, 140);
        иначе
            цвет(70, 190, 100);
        конец
        прямоугольник(тело_х.получить(i) * КЛЕТКА + 1, тело_у.получить(i) * КЛЕТКА + 1, КЛЕТКА - 2, КЛЕТКА - 2);
        i = i + 1;
    конец
    цвет(255, 255, 255);
    надпись("Очки: %очки%   Рекорд: %рекорд%", 8, 6, 18);
    если (проиграли)
        цвет(0, 0, 0);
        прямоугольник(100, 130, 280, 60);
        цвет(255, 255, 255);
        надпись("Игра окончена. Пробел — заново", 112, 150, 18);
    конец
конец

функция кадр()
    если (проиграли)
        если (клавиша_нажата("пробел"))
            начать();
        конец
    иначе
        читать_клавиши();
        целое сейчас = время_мс();
        если (сейчас - прошлый_шаг не меньше ШАГ_МС)
            прошлый_шаг = сейчас;
            шаг();
        конец
    конец
    рисовать();
конец

функция главная()
    холст(ШИРИНА * КЛЕТКА, ВЫСОТА * КЛЕТКА);
    рекорд = взять_сохранённое("змейка-рекорд");
    начать();
    запустить_игру("кадр");
конец
