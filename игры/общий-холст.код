// Общий холст: каждый клик ставит точку, и её видят все подключённые игроки.
// Пример игры по сети: клиент в браузере + сервер игры/чат-сервер.код.
//
// 1. Запустите сервер:      запустить игры/чат-сервер.код
// 2. Соберите клиент:       ./собрать-игру.sh игры/общий-холст.код
// 3. Откройте игры/общий-холст-веб/index.html через любой веб-сервер в нескольких вкладках.

подключить игра;

неизменно целое ШИРИНА = 640;
неизменно целое ВЫСОТА = 400;

Список из целых точки_х = Список из целых();
Список из целых точки_у = Список из целых();
Список из целых точки_цвет_к = Список из целых();
Список из целых точки_цвет_з = Список из целых();
Список из целых точки_цвет_с = Список из целых();
целое мой_к = 255;
целое мой_з = 255;
целое мой_с = 255;
верно подключались = нет;

// Сообщение: "x,y,красный,зелёный,синий". Возвращает 5 чисел через список.
функция разобрать(текст сообщение): Список из целых
    Список из целых числа = Список из целых();
    текст остаток = сообщение;
    целое сколько = 0;
    пока (сколько меньше 5)
        результат из целого запятая = найти(остаток, ",");
        текст часть = остаток;
        если (запятая.успешно)
            результат из текста взято = подстрока(остаток, 0, запятая.значение);
            часть = взято.значение;
            результат из текста дальше = подстрока(остаток, запятая.значение + 1, длина(остаток) - запятая.значение - 1);
            остаток = дальше.значение;
        конец
        результат из целого число = текст_в_целое(часть);
        если (число.успешно)
            числа.добавить(число.значение);
        иначе
            числа.добавить(0);
        конец
        сколько = сколько + 1;
    конец
    вернуть числа;
конец

функция кадр()
    если ( не подключались и соединено())
        подключались = да;
    конец

    // получить всё, что прислал сервер
    пока (есть_сообщение())
        Список из целых п = разобрать(прочитать_сообщение());
        точки_х.добавить(п.получить(0));
        точки_у.добавить(п.получить(1));
        точки_цвет_к.добавить(п.получить(2));
        точки_цвет_з.добавить(п.получить(3));
        точки_цвет_с.добавить(п.получить(4));
        п.освободить();
    конец

    // клик — отправить свою точку
    если (мышь_нажата() и соединено())
        отправить_серверу("%(мышь_х())%,%(мышь_у())%,%мой_к%,%мой_з%,%мой_с%");
    конец

    очистить(20, 24, 34);
    целое i = 0;
    пока (i меньше точки_х.размер())
        цвет(точки_цвет_к.получить(i), точки_цвет_з.получить(i), точки_цвет_с.получить(i));
        круг(точки_х.получить(i), точки_у.получить(i), 10);
        i = i + 1;
    конец

    цвет(255, 255, 255);
    если (соединено())
        надпись("Кликайте по полю: точки видят все", 10, 8, 18);
    иначе если (соединение_закрыто())
        надпись("Нет связи с сервером (запустите игры/чат-сервер.код)", 10, 8, 18);
    иначе
        надпись("Подключаюсь…", 10, 8, 18);
    конец
конец

функция главная()
    холст(ШИРИНА, ВЫСОТА);
    мой_к = 80 + случайное(176);
    мой_з = 80 + случайное(176);
    мой_с = 80 + случайное(176);
    соединиться("ws://localhost:9001");
    запустить_игру("кадр");
конец
