// Сервер для игр и чатов по WebSocket на Сфере.
// Все сообщения от любого игрока рассылаются всем подключённым (включая отправителя).
// Запуск: запустить игры/чат-сервер.код        (порт 9001)
//
// Схема без замков: на каждого клиента свой поток читает сообщения и кладёт их
// в канал; единственный поток-центр забирает из канала и рассылает.

подключить вебсокет;

канал из текстов события = создать_канал();
целое слушающий = 0;

функция главная()
    результат из целого порт = открыть_порт(9001);
    если ( не порт.успешно)
        вывести("Не удалось открыть порт: %(порт.сообщение)%");
        вернуть;
    конец
    вывести("Сервер слушает порт 9001");
    слушающий = порт.значение;

        // рабочие потоки: каждый ждёт клиента, читает его сообщения, потом ждёт следующего
    целое рабочий = 0;
    пока (рабочий меньше 16)
        параллельно
            пока (да)
                результат из целого клиент = принять_вебсокет(слушающий);
                если (клиент.успешно)
                    целое номер = клиент.значение;
                    события.отправить("+" + целое_в_текст(номер));
                    верно открыто = да;
                    пока (открыто)
                        результат из текста с = читать_сообщение(номер);
                        если (с.успешно)
                            события.отправить("м" + целое_в_текст(номер) + ":" + с.значение);
                        иначе
                            события.отправить("-" + целое_в_текст(номер));
                            открыто = нет;
                        конец
                    конец
                конец
            конец
        конец
        рабочий = рабочий + 1;
    конец

    // центр: знает всех клиентов и рассылает
    Список из целых клиенты = Список из целых();
    пока (да)
        текст с = события.получить();
        текст вид = срез(с, 0, 1);
        если (вид == "+")
            результат из целого новый = текст_в_целое(срез(с, 1, длина(с) - 1));
            клиенты.добавить(новый.значение);
            вывести("подключился игрок, всего %(клиенты.размер())%");
        иначе если (вид == "-")
            результат из целого уходящий = текст_в_целое(срез(с, 1, длина(с) - 1));
            целое кто = уходящий.значение;
            Список из целых остались = Список из целых();
            для каждого к в клиенты
                если (к != кто)
                    остались.добавить(к);
                конец
            конец
            клиенты = остались;
            закрыть_вебсокет(кто);
            вывести("игрок вышел, всего %(клиенты.размер())%");
        иначе
            результат из целого двоеточие = найти(с, ":");
            текст сообщение = срез(с, двоеточие.значение + 1, длина(с) - двоеточие.значение - 1);
            для каждого к в клиенты
                отправить_сообщение(к, сообщение);
            конец
        конец
    конец
конец
