// тест_канал.код — первая проверка канал<T>: главный поток запускает
// фоновый через "параллельно", тот вычисляет что-то и отправляет
// результат обратно через канал — главный поток дожидается его через
// получить() и продолжает работу с настоящим, переданным значением.
функция главная() -> целое {
    канал<целое> канал_результата = создать_канал();

    параллельно {
        целое вычислено = 2 + 2;
        канал_результата.отправить(вычислено);
    }

    целое значение = канал_результата.получить();
    вывести("Получено из канала: " + целое_в_текст(значение));

    вернуть 0;
}
