// арена_распределитель.код — простейший распределитель памяти ("bump
// allocator"), написанный ПОЛНОСТЬЮ на самом языке Сфера. Даёт структурам
// и тексту под ARC возможность работать в автономном режиме (--автономно),
// где взять настоящий malloc из libc неоткуда — наш ARC жёстко вызывает
// функции с именами "malloc"/"free" (см. codegen.rs), а откуда именно
// приходит их реализация, компилятору всё равно: свои функции здесь,
// определённые обычным образом (не "внешняя функция"), получают ровно
// такое же, буквальное LLVM-имя ("malloc"/"free") — то же самое,
// найденное раньше решение для дачи функциям полностью кириллических
// имён (см. README, "как \"РеальноеИмя\"") сработало и в обратную
// сторону, безо всяких изменений в компиляторе.
//
// Первые 8 байт зарезервированной области памяти ("арены", см.
// минимальный_рантайм.s) хранят "текущее смещение" — сколько байт уже
// выделено. Сам рантайм инициализирует его значением 8 (пропуская
// восьмибайтовый заголовок) ДО вызова главная() — здесь эту логику
// повторять не нужно.
//
// ⚠️ ЧЕСТНОЕ, НАМЕРЕННОЕ ОГРАНИЧЕНИЕ v1: это "bump allocator" — память
// НИКОГДА не освобождается по-настоящему, "free" ничего не делает.
// Указатель просто продвигается вперёд при каждом выделении. Этого
// достаточно для демонстрации и для многих реальных, коротко живущих
// программ во встраиваемых системах — но не подходит для программы,
// которая должна работать долго и постоянно выделять/освобождать память.
// Настоящий, умеющий переиспользовать освобождённую память распределитель
// — самостоятельный, больший следующий шаг.

// ⚠️ РЕАЛЬНАЯ НАХОДКА, ОБНАРУЖЕННАЯ ТЕСТОМ ЛИНКОВКИ: функции из
// ПОДКЛЮЧАЕМЫХ модулей (через "подключить") у нас манглируются (см.
// пространства имён v2) — их LLVM-имя становится "модуль__имя", не
// остаётся буквальным. ARC-кодогенерация ищет malloc/free СТРОГО по
// буквальному имени, без какого-либо fallback-механизма (в отличие от
// обычных вызовов функций пользователя, для которых такой механизм
// есть). Значит эти две функции ОБЯЗАНЫ находиться прямо в главном
// файле программы, а не быть подключены отсюда через "подключить" —
// иначе линковка упадёт с "undefined reference to `malloc`", хотя
// функция определена, просто под другим именем. Этот файл — справочный
// пример кода распределителя; для реального использования скопируй его
// содержимое прямо в свой главный .код-файл (см. тест_структуры_автономно.код).

внешняя функция адрес_арены() -> текст как "sfera_адрес_арены";

функция malloc(целое размер) -> текст {
    текст база = адрес_арены();
    целое32 смещение = прочитать_целое32(база, 0);
    текст итоговый_адрес = прочитать_текст_по_смещению(база, целое(смещение));
    целое32 новое_смещение = смещение + целое32(размер);
    записать_целое32(база, 0, новое_смещение);
    вернуть итоговый_адрес;
}

