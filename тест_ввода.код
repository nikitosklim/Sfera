// Отдельный тестовый файл для "прочитать_строку()" — специально НЕ включён
// в привет.код, потому что реально ждёт ввода с клавиатуры: если бы это
// было внутри привет.код, обычный запуск ("запустить привет.код") завис бы
// в ожидании ввода и сломал бы привычный автоматический прогон всех
// остальных тестов.
//
// Запускай отдельно, когда готов(а) что-то ввести:
//   запустить тест_ввода.код

функция главная() -> целое {
    вывести("Введи что-нибудь и нажми Enter:");

    результат<текст> строка = прочитать_строку();
    если (строка.успешно) {
        вывести("Ты ввёл(а):");
        вывести(строка.значение);
    } иначе {
        вывести(строка.сообщение);
    }

    вернуть 0;
}
