подключить графика;

функция главная() -> целое {
    SDL_Init(32);
    вывести("SDL2 инициализирован");

    текст окно = SDL_CreateWindow("Кликер — тест окна", 0, 0, 400, 300, 0);
    вывести("Окно создано");

    текст рендерер = SDL_CreateRenderer(окно, -1, 0);
    вывести("Рендерер создан");

    SDL_SetRenderDrawColor(рендерер, 40, 120, 200, 255);
    SDL_RenderClear(рендерер);
    SDL_RenderPresent(рендерер);
    вывести("Экран закрашен и показан");

    SDL_Delay(200);

    SDL_DestroyWindow(окно);
    SDL_Quit();
    вывести("Завершено успешно");

    вернуть 0;
}
