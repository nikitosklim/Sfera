целое счёт = 10;
дробное коэффициент = 1.5;
верно играем = да;
неизменно целое МАКС = 3;

функция прибавить(целое н)
    счёт = счёт + н;
конец

функция показать_числа()
    вывести("счёт = %счёт%, коэф = %коэффициент%, играем: %играем%");
конец

функция проверка_чисел()
    показать_числа();
    прибавить(5);
    прибавить(7);
    показать_числа();
    целое счёт2 = счёт * МАКС;
    вывести("утроенный: %счёт2%");
    играем = нет;
    показать_числа();
конец

структура Игра
    целое очки;
    текст имя;
конец

Игра игра = Игра(0, "Аня");
Список из целых история = Список из целых();

функция очко()
    игра.очки = игра.очки + 1;
    история.добавить(игра.очки);
конец

функция сброс()
    игра = Игра(100, "Борис");
конец

функция проверка_структур()
    очко();
    очко();
    вывести("%(игра.имя)%: %(игра.очки)%, в истории %(история.размер())%");
    сброс();
    очко();
    вывести("%(игра.имя)%: %(игра.очки)%, в истории %(история.размер())%");
    целое последнее = история.получить(история.размер() - 1);
    вывести("последнее %последнее%");
конец

функция главная()
    проверка_чисел();
    проверка_структур();
конец
