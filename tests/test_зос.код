подключить зос;

функция главная()
    текст д = "{\"игрок\": {\"имя\": \"Ник\\nита\", \"очки\": 120, \"жив\": true}, \"враги\": [{\"имя\": \"а\"}, {\"имя\": \"б\\u0436\"}, 7], \"пусто\": [], \"э\": \"\\ud83d\\ude00\"}";
    вывести("верен: %(зос_верен(д))%");
    текст мусор = "{";
    вывести("верен(мусор): %(зос_верен(мусор))%");
    результат из текста и1 = зос_текст(д, "игрок.имя");
    вывести(и1.значение);
    результат из целого о = зос_целое(д, "игрок.очки");
    вывести("очки: %(о.значение)%");
    результат из целого ж = зос_логическое(д, "игрок.жив");
    вывести("жив: %(ж.значение)%");
    результат из текста в2 = зос_текст(д, "враги.1.имя");
    вывести(в2.значение);
    результат из целого р = зос_размер(д, "враги");
    вывести("врагов: %(р.значение)%");
    результат из целого р2 = зос_размер(д, "игрок");
    вывести("полей: %(р2.значение)%");
    результат из целого р3 = зос_размер(д, "пусто");
    вывести("пусто: %(р3.значение)%");
    результат из целого н = зос_целое(д, "враги.2");
    вывести("третий: %(н.значение)%");
    результат из текста э = зос_текст(д, "э");
    вывести(э.значение);
    результат из целого нет1 = зос_целое(д, "игрок.возраст");
    вывести(нет1.сообщение);
    результат из целого нет2 = зос_целое(д, "игрок.имя");
    вывести(нет2.сообщение);
    текст п5 = "враги.5";
    текст п0 = "враги.0.имя";
    вывести("есть враги.5: %(зос_есть(д, п5))%");
    вывести("есть враги.0.имя: %(зос_есть(д, п0))%");
    текст пары = зос_пара_текст("имя", "О\"к") + "," + зос_пара_целое("n", 5) + "," + зос_пара_логическое("ok", да);
    текст собрано = зос_объект(пары);
    вывести(собрано);
    вывести("верен собранный: %(зос_верен(собрано))%");
    вывести(зос_массив("1,2," + зос_в_кавычках("x")));
конец
