подключить система;
подключить файлы;

функция главная()
    // разбор текста вроде /proc/meminfo
    текст п = "MemTotal:       16384 kB\nMemFree:  100 kB\nmodel name\t: Тест CPU @ 2GHz\nPRETTY_NAME=\"Ubuntu 22.04\"\nprocessor\t: 0\nprocessor\t: 1\n";
    целое всего = система_число_в_начале(система_значение(п, "MemTotal"));
    вывести("%всего%");
    вывести(система_значение(п, "model name"));
    вывести(система_значение(п, "PRETTY_NAME"));
    целое ядер_в_тексте = система_строк_с_ключом(п, "processor");
    вывести("ядер: %ядер_в_тексте%");
    текст нет_значения = система_значение(п, "Нет");
    вывести("нет: [%нет_значения%]");

    // папка с файлами и вложенной папкой
    создать_папку("/tmp/sfera_test_система");
    создать_папку("/tmp/sfera_test_система/б_папка");
    записать_файл("/tmp/sfera_test_система/я.txt", "12345");
    записать_файл("/tmp/sfera_test_система/а.txt", "xy");
    записать_файл("/tmp/sfera_test_система/Б.txt", "");
    результат из Список из ЗаписьПапки л = список_папки("/tmp/sfera_test_система");
    Список из ЗаписьПапки з = л.значение;
    целое i = 0;
    пока (i меньше з.размер())
        ЗаписьПапки з1 = з.получить(i);
        целое показ = з1.размер;
        если (з1.папка)
            показ = 0;
        конец
        вывести("%(з1.имя)% папка=%(з1.папка)% размер=%показ%");
        i = i + 1;
    конец
    верно папка_да = это_папка("/tmp/sfera_test_система");
    верно папка_нет = это_папка("/tmp/sfera_test_система/а.txt");
    вывести("это_папка: %папка_да% %папка_нет%");
    результат из Список из ЗаписьПапки нет2 = список_папки("/tmp/sfera_test_система/нет");
    вывести(нет2.сообщение);
    удалить_файл("/tmp/sfera_test_система/я.txt");
    удалить_файл("/tmp/sfera_test_система/а.txt");
    удалить_файл("/tmp/sfera_test_система/Б.txt");
    удалить_файл("/tmp/sfera_test_система/б_папка");
    удалить_файл("/tmp/sfera_test_система");

    // сведения о системе — корректный ЗОС с правдоподобными значениями
    текст с = сведения_о_системе("/");
    вывести("зос: %(зос_верен(с))%");
    результат из целого ядра = зос_целое(с, "ядер");
    результат из целого память = зос_целое(с, "память_всего_кб");
    результат из целого диск = зос_целое(с, "диск_всего");
    вывести("ядер >= 1: %(ядра.значение не меньше 1)%");
    вывести("память > 0: %(память.значение больше 0)%");
    вывести("диск > 0: %(диск.значение больше 0)%");
    результат из текста ос = зос_текст(с, "ос");
    вывести("ос непустая: %(длина(ос.значение) больше 0)%");
конец
