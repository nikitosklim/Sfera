подключить время;

функция показать(целое юникс)
    ДатаВремя д = время_из_юникса(юникс);
    вывести("%юникс% -> %(дата_время_в_текст(д))% день недели %(день_недели(юникс))% обратно %(юникс_из_времени(д))%");
конец

функция проба(текст с)
    результат из ДатаВремя р = разобрать_дату_время(с);
    если (р.успешно)
        вывести("%с% -> %(юникс_из_времени(р.значение))%");
    иначе
        вывести("%с% -> ошибка: %(р.сообщение)%");
    конец
конец

функция главная()
    показать(0);
    показать(1700000000);
    показать(951782400);
    показать(-1);
    показать(-86400 * 365);
    показать(4102444800);
    ДатаВремя м = время_из_юникса_со_смещением(1700000000, смещение_москвы());
    вывести(дата_по_русски(м));
    вывести(название_дня_недели(день_недели(1700000000)));
    вывести(название_месяца(2) + " " + название_месяца_в_дате(2));
    вывести("високосные: %(високосный_год(1900))% %(високосный_год(2000))% %(високосный_год(2024))%");
    вывести("дней в феврале 2024: %(дней_в_месяце(2024, 2))%");
    вывести("дней между: %(дней_между(0, 1700000000))%");
    вывести("через 40 дней: %(дата_в_текст(время_из_юникса(прибавить_дни(1700000000, 40))))%");
    проба("2026-11-23");
    проба("2026-11-23 14:36:05");
    проба("2026-11-23T14:36:05Z");
    проба("2026-02-30");
    проба("2026-11-23 25:00:00");
    проба("23.11.2026");
    проба("2026-11-23 14:36:05x");
    ДатаВремя н = сейчас();
    вывести("сейчас позже 2026: %(н.год не меньше 2026)%");
конец
