функция показать(текст т)
    результат из дробного р = дробное_из_текста(т);
    если (р.успешно)
        вывести("%т% -> %(р.значение)%");
    иначе
        вывести("%т% -> ошибка");
    конец
конец

функция главная()
    показать("2.5");
    показать("-0.125");
    показать("42");
    показать("1e3");
    показать("1,5");
    показать("2.5abc");
    показать("");
    показать("абв");
    результат из дробного р = дробное_из_текста("abc");
    вывести(р.сообщение);
конец
