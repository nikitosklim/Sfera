// Перечисления с данными и «выбрать»: создание, разбор, иначе, «_»,
// текст в данных, перечисления в списке и в поле структуры, вложенный «выбрать».

перечисление Фигура
    круг(дробное радиус);
    прямоугольник(дробное ширина, дробное высота);
    подпись(текст название, целое номер);
    точка;
конец

перечисление Команда
    шаг(целое длина);
    стоп;
конец

структура Робот
    Команда последняя;
    целое пройдено;
конец

функция площадь(Фигура ф): дробное
    выбрать ф
        когда круг(р)
            вернуть 3.0 * р * р;
        когда прямоугольник(ш, выс)
            вернуть ш * выс;
        иначе
            вернуть 0.0;
    конец
конец

функция название(Фигура ф): текст
    выбрать ф
        когда подпись(т, _)
            вернуть т;
        когда круг
            вернуть "круг";
        когда прямоугольник(_, _)
            вернуть "прямоугольник";
        когда точка
            вернуть "точка";
    конец
конец

функция создать(целое н): Фигура
    если (н == 0)
        вернуть Фигура.точка;
    конец
    если (н % 2 == 0)
        вернуть Фигура.круг(дробное(н));
    конец
    вернуть Фигура.подпись("метка" + целое_в_текст(н), н);
конец

функция главная(): целое
    Фигура а = Фигура.круг(2.0);
    Фигура б = Фигура.прямоугольник(3.0, 4.0);
    Фигура тч = Фигура.точка();
    вывести(площадь(а));
    вывести(площадь(б));
    вывести(площадь(тч));
    вывести(название(а));
    вывести(название(б));
    вывести(название(тч));
    вывести(название(Фигура.подпись("привет", 5)));

    Список из Фигура все = Список из Фигура();
    целое н = 0;
    пока (н меньше 5)
        все.добавить(создать(н));
        н = н + 1;
    конец
    для каждого ф в все
        вывести(название(ф));
    конец

    Робот р = Робот(Команда.шаг(7), 0);
    Команда к = р.последняя;
    выбрать к
        когда шаг(д)
            р.пройдено = р.пройдено + д;
            выбрать р.последняя
                когда Команда.шаг(е)
                    вывести(е * 10 + д);
                когда Команда.стоп
                    вывести(0 - 1);
            конец
        когда стоп
            вывести(0);
    конец
    вывести(р.пройдено);
    вернуть 0;
конец
