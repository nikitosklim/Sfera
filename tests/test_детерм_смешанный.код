функция главная() {
    // Один детерминированный сам по себе — не должен ждать "включения"
    // в эстафету (N=1, работает фактически без блокировок).
    параллельно детерминировано {
        целое i = 0;
        пока (i < 3) {
            вывести("Соло" + целое_в_текст(i));
            i = i + 1;
        }
    }
    дождаться_все_потоки();

    // Обычный "параллельно" рядом с детерминированными — не участвует в
    // эстафете, не блокируется и не блокирует их.
    параллельно {
        вывести("Обычный");
    }
    параллельно детерминировано {
        целое i = 0;
        пока (i < 3) {
            вывести("Г" + целое_в_текст(i));
            i = i + 1;
        }
    }
    параллельно детерминировано {
        целое i = 0;
        пока (i < 3) {
            вывести("Д" + целое_в_текст(i));
            i = i + 1;
        }
    }
    дождаться_все_потоки();
    вывести("конец");
}
