функция главная() {
    // Только второй сценарий из test_детерм_смешанный: обычный +
    // два детерминированных в ОДНОМ батче, БЕЗ предыдущего соло-батча.
    параллельно {
        вывести("Обычный");
    }
    параллельно детерминировано {
        целое i = 0;
        пока (i < 3) {
            вывести("Г" + целое_в_текст(i));
            i = i + 1;
        }
    }
    параллельно детерминировано {
        целое i = 0;
        пока (i < 3) {
            вывести("Д" + целое_в_текст(i));
            i = i + 1;
        }
    }
    дождаться_все_потоки();
    вывести("конец");
}
