подключить json;

функция главная()
    текст д = "{\"игрок\": {\"имя\": \"Ник\\nита\", \"очки\": 120, \"жив\": true}, \"враги\": [{\"имя\": \"а\"}, {\"имя\": \"б\\u0436\"}, 7], \"пусто\": [], \"э\": \"\\ud83d\\ude00\"}";
    вывести("верен: %(json_верен(д))%");
    текст мусор = "{";
    вывести("верен(мусор): %(json_верен(мусор))%");
    результат из текста и1 = json_текст(д, "игрок.имя");
    вывести(и1.значение);
    результат из целого о = json_целое(д, "игрок.очки");
    вывести("очки: %(о.значение)%");
    результат из целого ж = json_логическое(д, "игрок.жив");
    вывести("жив: %(ж.значение)%");
    результат из текста в2 = json_текст(д, "враги.1.имя");
    вывести(в2.значение);
    результат из целого р = json_размер(д, "враги");
    вывести("врагов: %(р.значение)%");
    результат из целого р2 = json_размер(д, "игрок");
    вывести("полей: %(р2.значение)%");
    результат из целого р3 = json_размер(д, "пусто");
    вывести("пусто: %(р3.значение)%");
    результат из целого н = json_целое(д, "враги.2");
    вывести("третий: %(н.значение)%");
    результат из текста э = json_текст(д, "э");
    вывести(э.значение);
    результат из целого нет1 = json_целое(д, "игрок.возраст");
    вывести(нет1.сообщение);
    результат из целого нет2 = json_целое(д, "игрок.имя");
    вывести(нет2.сообщение);
    текст п5 = "враги.5";
    текст п0 = "враги.0.имя";
    вывести("есть враги.5: %(json_есть(д, п5))%");
    вывести("есть враги.0.имя: %(json_есть(д, п0))%");
    текст пары = json_пара_текст("имя", "О\"к") + "," + json_пара_целое("n", 5) + "," + json_пара_логическое("ok", да);
    текст собрано = json_объект(пары);
    вывести(собрано);
    вывести("верен собранный: %(json_верен(собрано))%");
    вывести(json_массив("1,2," + json_в_кавычках("x")));
конец
