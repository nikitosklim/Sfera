канал из целого числа = создать_канал();
канал из текстов слова = создать_канал();

функция главная()
    параллельно
        целое i = 1;
        пока (i не больше 5)
            числа.отправить(i * 10);
            слова.отправить("слово " + целое_в_текст(i));
            i = i + 1;
        конец
    конец
    целое сумма = 0;
    целое k = 0;
    пока (k меньше 5)
        целое н = числа.получить();
        текст с = слова.получить();
        сумма = сумма + н;
        вывести("%н% %с%");
        k = k + 1;
    конец
    вывести("сумма %сумма%");
