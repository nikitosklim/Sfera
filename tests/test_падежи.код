структура Пользователь
    текст имя;
    целое возраст;
конец

структура Коробка
    целое размер;
конец

функция делить(целое а, целое б): результат из целых
    вернуть успех(а / б);
конец

функция главная(): целое
    Список из текстам имена = Список из текстам();
    имена.добавить("а");
    имена.добавить("б");
    Список из целому числа = Список из целым();
    числа.добавить(5);
    Список из Пользователей люди = Список из Пользователей();
    люди.добавить(Пользователь("Аня", 20));
    Словарь из текста и целых оценки = Словарь из текста и целых();
    оценки.положить("м", 5);
    Список из Коробками ящики = Список из Коробкам();
    ящики.добавить(Коробка(3));
    для каждого имя из имена
        вывести(имя);
    конец
    для каждого х в числа
        вывести("%х%");
    конец
    для каждого чел из люди
        вывести("%(чел.имя)% %(чел.возраст)%");
    конец
    вывести("ящиков: %(ящики.размер())%");
    вернуть 0;
конец
