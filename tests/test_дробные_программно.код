// Проверка программной арифметики (дробные_программно) сравнением с процессором хозяина: запускать обычным способом,
// ожидается: во всех трёх строках 0 ошибок (файл .ожидание).
подключить дробные_программно;

функция следующее(беззнак64 с): беззнак64
    вернуть с * беззнак64(6364136223846793005) + беззнак64(1442695040888963407);
конец

функция широкое_число(беззнак64 с): беззнак64
    беззнак64 знак = (с >> беззнак64(33)) & беззнак64(1);
    беззнак64 порядок = беззнак64(1) + ((с >> беззнак64(40)) % беззнак64(2046));
    беззнак64 дробь = (с * беззнак64(2862933555777941757)) & беззнак64(0xFFFFFFFFFFFFF);
    вернуть (знак << беззнак64(63)) | (порядок << беззнак64(52)) | дробь;
конец


функция главная(): целое
    беззнак64 с = беззнак64(777);
    целое ош_арифм = 0;
    целое ош_целые = 0;
    целое ош_сравн = 0;
    целое круг = 0;
    пока (круг < 30000)
        с = следующее(с);
        беззнак64 а = широкое_число(с);
        с = следующее(с);
        беззнак64 б = широкое_число(с);
        // чтобы сложение и вычитание чаще давали сокращение — иногда берём почти равные числа
        если (круг % 4 == 0)
            б = а ^ ((с >> беззнак64(50)) & беззнак64(255));
        конец
        дробное х1 = дробное_из_битов(а);
        дробное х2 = дробное_из_битов(б);
        беззнак64 р1 = биты_дробного(х1 + х2);
        беззнак64 р2 = биты_дробного(х1 - х2);
        беззнак64 р3 = биты_дробного(х1 * х2);
        беззнак64 р4 = биты_дробного(х1 / х2);
        // пропускаем денормализованные результаты (у нас они обнуляются)
        если (((р1 >> беззнак64(52)) & беззнак64(2047)) != беззнак64(0) и __adddf3(а, б) != р1)
            ош_арифм = ош_арифм + 1;
            если (ош_арифм < 4)
                вывести("сложение");
                вывести(целое(а));
                вывести(целое(б));
            конец
        конец
        если (((р2 >> беззнак64(52)) & беззнак64(2047)) != беззнак64(0) и __subdf3(а, б) != р2)
            ош_арифм = ош_арифм + 1;
            если (ош_арифм < 4)
                вывести("вычитание");
                вывести(целое(а));
                вывести(целое(б));
            конец
        конец
        если (((р3 >> беззнак64(52)) & беззнак64(2047)) != беззнак64(0) и __muldf3(а, б) != р3)
            ош_арифм = ош_арифм + 1;
            если (ош_арифм < 4)
                вывести("умножение");
                вывести(целое(а));
                вывести(целое(б));
            конец
        конец
        если (((р4 >> беззнак64(52)) & беззнак64(2047)) != беззнак64(0) и __divdf3(а, б) != р4)
            ош_арифм = ош_арифм + 1;
            если (ош_арифм < 4)
                вывести("деление");
                вывести(целое(а));
                вывести(целое(б));
            конец
        конец
        // сравнения
        целое32 н1 = __ltdf2(а, б);
        целое32 н2 = __gtdf2(а, б);
        целое32 н3 = __eqdf2(а, б);
        если ((н1 < целое32(0)) != (х1 < х2) или (н2 > целое32(0)) != (х1 > х2) или (н3 == целое32(0)) != (х1 == х2))
            ош_сравн = ош_сравн + 1;
        конец
        // целые числа: разной длины
        целое ц = целое(с);
        если (круг % 3 == 0)
            ц = ц / 1099511627776;
        конец
        если (круг % 5 == 0)
            ц = ц / 4294967296;
        конец
        если (__floatdidf(ц) != биты_дробного(дробное(ц)))
            ош_целые = ош_целые + 1;
            если (ош_целые < 4)
                вывести("целое → дробное");
                вывести(ц);
            конец
        конец
        // дробное → целое (только если помещается)
        дробное большое = дробное(ц) * 0.37;
        если (__fixdfdi(биты_дробного(большое)) != целое(большое))
            ош_целые = ош_целые + 1;
            если (ош_целые < 4)
                вывести("дробное → целое");
                вывести(ц);
            конец
        конец
        // 64-битное деление и остаток
        целое дл = целое(с >> беззнак64(1)) / 7;
        если (дл != 0 и ц != 0)
            если (__divdi3(ц, дл) != ц / дл или __moddi3(ц, дл) != ц % дл)
                ош_целые = ош_целые + 1;
                если (ош_целые < 4)
                    вывести("деление целых");
                    вывести(ц);
                    вывести(дл);
                конец
            конец
            если (целое(__udivdi3(беззнак64(ц), беззнак64(дл))) != целое(беззнак64(ц) / беззнак64(дл)))
                ош_целые = ош_целые + 1;
            конец
        конец
        если (__muldi3(беззнак64(ц), беззнак64(дл)) != беззнак64(ц) * беззнак64(дл))
            ош_целые = ош_целые + 1;
        конец
        // сдвиги на переменное число разрядов
        целое32 ск = целое32(круг % 64);
        если (__ashldi3(беззнак64(ц), ск) != (беззнак64(ц) << беззнак64(ск)) или __lshrdi3(беззнак64(ц), ск) != (беззнак64(ц) >> беззнак64(ск)))
            ош_целые = ош_целые + 1;
        конец
        если (__ashrdi3(ц, ск) != (ц >> целое(ск)))
            ош_целые = ош_целые + 1;
            если (ош_целые < 4)
                вывести("арифметический сдвиг");
                вывести(ц);
                вывести(целое(ск));
            конец
        конец
        круг = круг + 1;
    конец
    вывести("ошибок арифметики:");
    вывести(ош_арифм);
    вывести("ошибок сравнения:");
    вывести(ош_сравн);
    вывести("ошибок целых:");
    вывести(ош_целые);
    вернуть 0;
конец
