структура Коробка
    текст имя;

    функция назвать(целое н): текст
        текст т = "кот" + целое_в_текст(н);
        вернуть т;
    конец
конец

функция в_цикле(целое сколько): текст
    текст итог = "" + "#";
    целое к = 0;
    пока (к < сколько)
        итог = итог + целое_в_текст(к);
        к = к + 1;
    конец
    вернуть итог;
конец

функция по_условию(целое н): текст
    текст р = целое_в_текст(н) + "!";
    если (н > 1)
        р = р + "?";
    конец
    вернуть р;
конец

функция в_поле(Коробка к): текст
    текст т = "поле" + целое_в_текст(5);
    к.имя = т;
    вернуть т;
конец

функция в_список(Список из текстов с): текст
    текст т = "элем" + целое_в_текст(7);
    с.добавить(т);
    вернуть т;
конец

функция литерал(): текст
    текст т = "литерал";
    вернуть т;
конец

функция из_параметра(текст п): текст
    текст т = п;
    вернуть т;
конец

функция главная()
    Коробка к = Коробка("");
    вывести(к.назвать(1));
    вывести(в_цикле(3));
    вывести(по_условию(1));
    вывести(по_условию(2));
    текст п1 = в_поле(к);
    вывести(п1 + " / " + к.имя);
    Список из текстов список = Список из текстов();
    текст п2 = в_список(список);
    вывести(п2 + " / " + список.получить(0));
    текст п3 = литерал();
    вывести(п3);
    текст п4 = из_параметра("парам");
    вывести(п4);
    целое номер = 0;
    пока (номер < 3)
        текст х = в_цикле(номер);
        вывести(х);
        номер = номер + 1;
    конец
конец
