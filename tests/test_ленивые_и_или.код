// "и" и "или" вычисляют правую часть только при необходимости.
функция шум(текст что, верно значение): верно
    вывести("вычислено: %что%");
    вернуть значение;
конец

функция главная()
    // или: левая верна — правая не вычисляется
    если (шум("а", да) или шум("б", да))
        вывести("1 ок");
    конец
    // или: левая неверна — правая вычисляется
    если (шум("в", нет) или шум("г", да))
        вывести("2 ок");
    конец
    // и: левая неверна — правая не вычисляется
    если (шум("д", нет) и шум("е", да))
        вывести("не должно");
    иначе
        вывести("3 ок");
    конец
    // и: левая верна — правая вычисляется
    если (шум("ж", да) и шум("з", да))
        вывести("4 ок");
    конец

    // вложенные и смешанные выражения
    если ((шум("и1", нет) и шум("и2", да)) или шум("и3", да))
        вывести("5 ок");
    конец
    если (шум("к1", да) и (шум("к2", нет) или шум("к3", да)))
        вывести("6 ок");
    конец

    // результат как значение
    верно итог = шум("л", нет) или шум("м", нет);
    вывести("итог: %итог%");

    // неудавшийся результат: правая часть читала бы пустое значение
    результат из текста р = прочитать_файл("нет_такого_файла_для_теста.txt");
    если ( не р.успешно или длина(р.значение) == 0)
        вывести("файла нет");
    конец
    если (р.успешно и длина(р.значение) больше 0)
        вывести("не должно");
    иначе
        вывести("и тоже безопасно");
    конец

    // границы списка: индекс проверяется раньше обращения
    Список из целых числа = Список из целых();
    числа.добавить(5);
    целое i = 3;
    если (i меньше числа.размер() и числа.получить(i) == 5)
        вывести("не должно");
    иначе
        вывести("границы соблюдены");
    конец
    числа.освободить();

    // цикл с составным условием и временным текстом в правой части
    целое к = 0;
    пока (к меньше 3 и содержит("абв" + целое_в_текст(к), "в0"))
        к = к + 1;
    конец
    вывести("цикл остановился на %к%");
    пока (к меньше 5 и не (к == 4))
        к = к + 1;
    конец
    вывести("цикл остановился на %к%");
конец
