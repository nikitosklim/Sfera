функция главная() {
    // Соло-батч, затем ВТОРОЙ батч из ДВУХ детерминированных — БЕЗ
    // обычного (недетерминированного) "параллельно" внутри второго батча.
    параллельно детерминировано {
        целое i = 0;
        пока (i < 3) {
            вывести("Соло" + целое_в_текст(i));
            i = i + 1;
        }
    }
    дождаться_все_потоки();

    параллельно детерминировано {
        целое i = 0;
        пока (i < 3) {
            вывести("Г" + целое_в_текст(i));
            i = i + 1;
        }
    }
    параллельно детерминировано {
        целое i = 0;
        пока (i < 3) {
            вывести("Д" + целое_в_текст(i));
            i = i + 1;
        }
    }
    дождаться_все_потоки();
    вывести("конец");
}
