// ARC: чтение поля-структуры в локальную переменную увеличивает счётчик
// ссылок (раньше объект освобождался дважды при выходе из области).

структура Т
    целое х;
    целое у;
конец

структура Очередь
    Т последнее;
    целое счёт;
конец

функция создать(целое н): Т
    вернуть Т(н, н * 2);
конец

функция сумма(Очередь о): целое
    Т а = о.последнее;
    Т б = о.последнее;
    вернуть а.х + б.у;
конец

функция главная(): целое
    Очередь о = Очередь(создать(4), 9);
    Т а = о.последнее;
    неизменно Т б = о.последнее;
    вывести(а.х);
    вывести(б.у);
    вывести(сумма(о));
    вывести(о.счёт);
    вернуть 0;
конец
