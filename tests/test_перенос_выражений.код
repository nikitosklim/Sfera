функция сумма3(целое а, целое б, целое ц): целое
    вернуть а + б + ц
конец

целое счёт = 0

функция прибавить(целое н)
    счёт = счёт + н
конец

функция главная(): целое
    // вызов с числом и следующая строка с вызовом — не объявление массива
    прибавить(5)
    прибавить(7)
    вывести(счёт)
    целое первое = 1
    целое второе = 2
    целое третье = 3
    целое итог = первое +
        второе +
        третье
    вывести(итог)
    вывести(сумма3(1,
        2,
        3))
    целое х = 1; целое у = 2
    вывести(х + у)
    если (итог > 3) вывести("да") конец
    вернуть 0
конец
