функция главная()
    Список из целых числа = Список из целых();
    числа.добавить(1);
    числа.добавить(2);
    числа.добавить(3);
    числа.установить(1, 20);
    числа.установить(0, числа.получить(0) + 100);
    вывести("%(числа.получить(0))% %(числа.получить(1))% %(числа.получить(2))%");

    Список из дробных д = Список из дробных();
    д.добавить(1.5);
    д.установить(0, 2.25);
    вывести("%(д.получить(0))%");

    Список из текстов т = Список из текстов();
    т.добавить("а");
    т.добавить("б");
    текст новый = "в";
    т.установить(0, новый);
    т.установить(1, "г" + "д");
    вывести("%(т.получить(0))%%(т.получить(1))%");

    Список из Точка точки = Список из Точка();
    точки.добавить(Точка(1, 2));
    Точка п = Точка(5, 6);
    точки.установить(0, п);
    вывести("%(точки.получить(0).х)%");

    // пузырьковая сортировка — для этого установить и нужен
    Список из целых с = Список из целых();
    с.добавить(5);
    с.добавить(2);
    с.добавить(9);
    с.добавить(1);
    целое i = 0;
    пока (i меньше с.размер())
        целое j = 0;
        пока (j меньше с.размер() - 1 - i)
            если (с.получить(j) больше с.получить(j + 1))
                целое врем = с.получить(j);
                с.установить(j, с.получить(j + 1));
                с.установить(j + 1, врем);
            конец
            j = j + 1;
        конец
        i = i + 1;
    конец
    вывести("%(с.получить(0))% %(с.получить(1))% %(с.получить(2))% %(с.получить(3))%");
    числа.установить(3, 1);
    вывести("не должно напечататься");
конец
