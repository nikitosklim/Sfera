// Проверка многофайловой сборки: этот файл подключает утилиты.код
// (по имени, без расширения — компилятор сам ищет "утилиты.код" рядом
// с этим файлом) и использует функцию/структуру, объявленные там.
//
// Также подключает "математика" — этого файла НЕТ рядом (нет
// "математика.код" в этой же папке), значит компилятор находит его
// запасным путём: в "пакеты/математика.код" (см. разрешить_путь_подключения
// в main.rs) — демонстрация нового способа подключения "внешнего" кода.
//
// НОВОЕ: первый шаг к настоящим пространствам имён — квалифицированный
// доступ "модуль.функция(...)". Работает НАРЯДУ с обычным, неквалифицированным
// доступом (не ломает уже существующий код) — см. README, раздел про
// пространства имён, про честные ограничения этой версии (пока не решает
// коллизии имён между модулями, только добавляет синтаксис).

подключить утилиты;
подключить математика;

функция главная() -> целое {
    целое итог = удвоить(21);
    вывести(итог);

    // То же самое, но КВАЛИФИЦИРОВАННО — через имя модуля (файла, из
    // которого подключена функция). Оба способа дают одинаковый результат.
    целое итог_квалифицированный = утилиты.удвоить(21);
    вывести(итог_квалифицированный);

    Точка точка = Точка(3, 4);
    вывести(точка.сумма_координат());

    целое утроенное = утроить(7);
    вывести(утроенное);

    // Квалифицированный доступ и для модуля "математика" тоже.
    целое утроенное_квалифицированное = математика.утроить(7);
    вывести(утроенное_квалифицированное);

    вернуть 0;
}
