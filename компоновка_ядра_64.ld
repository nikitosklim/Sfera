/* компоновка_ядра_64.ld — та же идея, что и у 32-битной версии, но main()
 * от компилятора Сферы уже 64-битная функция. Multiboot 1 (традиционная
 * спецификация, которую понимает QEMU через -kernel) требует именно
 * 32-битный ELF-КОНТЕЙНЕР — реальная находка, обнаруженная попыткой
 * загрузки настоящего ELF64 файла ("Cannot load x86-64 image, give a
 * 32bit one"). Решение — известная в сообществе разработки хобби-ОС
 * техника: обернуть 64-битный машинный код в 32-битный ELF-контейнер
 * через OUTPUT_FORMAT — сам код внутри остаётся полностью 64-битным,
 * меняется только формат заголовка файла, который понимает загрузчик.
 */
OUTPUT_FORMAT(elf32-i386)
ENTRY(_start)

SECTIONS
{
    . = 1M;

    .multiboot : {
        *(.multiboot)
    }

    .text : {
        *(.text)
    }

    .rodata : {
        *(.rodata)
    }

    .bss : {
        *(.bss)
    }
}
