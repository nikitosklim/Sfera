// Цвета в виде трёх целых 0..255 (красный, зелёный, синий).

подключить веб;

функция в_диапазон(целое х): целое
    если (х меньше 0)
        вернуть 0;
    конец
    если (х больше 255)
        вернуть 255;
    конец
    вернуть х;
конец

функция две_цифры(целое х): текст
    текст таблица = "0123456789abcdef";
    целое v = в_диапазон(х);
    вернуть срез(таблица, v / 16, 1) + срез(таблица, v % 16, 1);
конец

// Цвет в виде «#rrggbb».
функция в_шестнадцатеричный(целое красный, целое зелёный, целое синий): текст
    вернуть "#" + две_цифры(красный) + две_цифры(зелёный) + две_цифры(синий);
конец

// Смешивает два канала: процент 0 даёт первый, 100 даёт второй.
функция смешать_канал(целое а, целое б, целое процент): целое
    целое п = процент;
    если (п меньше 0)
        п = 0;
    конец
    если (п больше 100)
        п = 100;
    конец
    вернуть (а * (100 - п) + б * п) / 100;
конец

// Яркость по весам красного, зелёного и синего, 0..255. Нужна, чтобы выбрать цвет текста на фоне.
функция яркость(целое красный, целое зелёный, целое синий): целое
    вернуть (красный * 299 + зелёный * 587 + синий * 114) / 1000;
конец

// Светлый ли фон: на нём лучше читается тёмный текст.
функция светлый(целое красный, целое зелёный, целое синий): верно
    вернуть яркость(красный, зелёный, синий) больше 140;
конец

// Один канал, сдвинутый к чёрному (процент 100 — полностью чёрный).
функция затемнить_канал(целое один, целое процент): целое
    вернуть смешать_канал(один, 0, процент);
конец

// Один канал, сдвинутый к белому (процент 100 — полностью белый).
функция осветлить_канал(целое один, целое процент): целое
    вернуть смешать_канал(один, 255, процент);
конец
