// Математика для целых чисел.

функция модуль(целое х): целое
    если (х меньше 0)
        вернуть 0 - х;
    конец
    вернуть х;
конец

функция минимум(целое а, целое б): целое
    если (а меньше б)
        вернуть а;
    конец
    вернуть б;
конец

функция максимум(целое а, целое б): целое
    если (а больше б)
        вернуть а;
    конец
    вернуть б;
конец

// Число х, зажатое между низ и верх.
функция ограничить(целое х, целое низ, целое верх): целое
    вернуть минимум(максимум(х, низ), верх);
конец

// Основание в целой неотрицательной степени.
функция степень(целое основание, целое показатель): целое
    целое итог = 1;
    целое k = 0;
    пока (k меньше показатель)
        итог = итог * основание;
        k = k + 1;
    конец
    вернуть итог;
конец

// Целая часть квадратного корня (для отрицательных чисел — 0).
функция корень_целый(целое х): целое
    если (х меньше 1)
        вернуть 0;
    конец
    целое низ = 0;
    целое верх = х;
    если (верх больше 3037000499)
        верх = 3037000499;
    конец
    пока (низ меньше верх)
        целое середина = (низ + верх + 1) / 2;
        если (середина * середина больше х)
            верх = середина - 1;
        иначе
            низ = середина;
        конец
    конец
    вернуть низ;
конец

// Наибольший общий делитель (алгоритм Евклида).
функция нод(целое а, целое б): целое
    целое x = модуль(а);
    целое y = модуль(б);
    пока (y != 0)
        целое остаток = x % y;
        x = y;
        y = остаток;
    конец
    вернуть x;
конец

// Наименьшее общее кратное (0, если одно из чисел 0).
функция нок(целое а, целое б): целое
    если (а == 0 или б == 0)
        вернуть 0;
    конец
    вернуть модуль(а / нод(а, б) * б);
конец

// Факториал: до 20 включительно помещается в целое.
функция факториал(целое n): целое
    целое итог = 1;
    целое k = 2;
    пока (k не больше n)
        итог = итог * k;
        k = k + 1;
    конец
    вернуть итог;
конец

функция простое(целое n): верно
    если (n меньше 2)
        вернуть нет;
    конец
    целое d = 2;
    пока (d * d не больше n)
        если (n % d == 0)
            вернуть нет;
        конец
        d = d + 1;
    конец
    вернуть да;
конец
