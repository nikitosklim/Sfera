// Помощники для текста. Длина считается в байтах: русская буква занимает два байта.

подключить веб;

функция повторить(текст что, целое раз): текст
    текст итог = "";
    целое k = 0;
    пока (k меньше раз)
        итог = итог + что;
        k = k + 1;
    конец
    вернуть итог;
конец

функция начинается_на(текст источник, текст начало): верно
    если (длина(начало) больше длина(источник))
        вернуть нет;
    конец
    вернуть срез(источник, 0, длина(начало)) == начало;
конец

функция заканчивается_на(текст источник, текст конец_текста): верно
    целое n = длина(источник);
    целое m = длина(конец_текста);
    если (m больше n)
        вернуть нет;
    конец
    вернуть срез(источник, n - m, m) == конец_текста;
конец

// Сколько раз часть встречается в тексте (без пересечений).
функция число_вхождений(текст источник, текст часть): целое
    если (длина(часть) == 0)
        вернуть 0;
    конец
    целое штук = 0;
    целое позиция = 0;
    целое всего = длина(источник);
    пока (позиция + длина(часть) не больше всего)
        если (срез(источник, позиция, длина(часть)) == часть)
            штук = штук + 1;
            позиция = позиция + длина(часть);
        иначе
            позиция = позиция + 1;
        конец
    конец
    вернуть штук;
конец

// Число с нулями слева до нужной ширины: с_нулями(7, 3) даёт «007».
функция с_нулями(целое число, целое ширина): текст
    текст цифры = целое_в_текст(число);
    если (длина(цифры) не меньше ширина)
        вернуть цифры;
    конец
    вернуть повторить("0", ширина - длина(цифры)) + цифры;
конец

// Пустой текст или только пробелы.
функция пусто(текст источник): верно
    вернуть длина(обрезать_края(источник)) == 0;
конец
