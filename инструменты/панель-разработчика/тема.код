// тема.код — тема «Синяя сталь» для панели Сферы (та же, что на сайте: сайт/static/сталь.css).
// Общая для macOS/Linux, Windows и Android: цвета в виде целых 0xRRGGBB, вертикальные градиенты,
// овальные глянцевые кнопки, панели, поля ввода и выделение пункта меню. Всё рисуется построчно
// прямоугольниками SDL, поэтому работает одинаково на всех платформах.

подключить графика;

// ---- цвета (то же, что переменные --bg, --win, --line… на сайте) ----
функция т_фон(): целое
    вернуть 660006;     // 0a1226
конец
функция т_фон_низ(): целое
    вернуть 396058;     // 060b1a
конец
функция т_окно(): целое
    вернуть 1121592;    // 111d38
конец
функция т_окно_2(): целое
    вернуть 1451594;    // 16264a
конец
функция т_утоплено(): целое
    вернуть 660518;     // 0a1426
конец
функция т_линия(): целое
    вернуть 2834544;    // 2b4070
конец
функция т_контур(): целое
    вернуть 660264;     // 0a1328
конец

функция т_р(целое с): целое
    вернуть (с / 65536) % 256;
конец
функция т_з(целое с): целое
    вернуть (с / 256) % 256;
конец
функция т_с(целое с): целое
    вернуть с % 256;
конец
функция т_упаковать(целое р, целое з, целое с): целое
    вернуть р * 65536 + з * 256 + с;
конец

// Смесь двух цветов: доля 0..100 (0 — первый, 100 — второй).
функция т_смесь(целое а, целое б, целое доля): целое
    целое р = (т_р(а) * (100 - доля) + т_р(б) * доля) / 100;
    целое з = (т_з(а) * (100 - доля) + т_з(б) * доля) / 100;
    целое с = (т_с(а) * (100 - доля) + т_с(б) * доля) / 100;
    вернуть т_упаковать(р, з, с);
конец

функция т_залить(текст холст, целое х, целое у, целое ш, целое выс, целое с, целое прозрачность): целое
    если (ш меньше 1 или выс меньше 1)
        вернуть 0;
    конец
    задать_цвет(холст, беззнак8(т_р(с)), беззнак8(т_з(с)), беззнак8(т_с(с)), беззнак8(прозрачность));
    нарисовать_прямоугольник(холст, целое32(х), целое32(у), целое32(ш), целое32(выс));
    вернуть 0;
конец

// Цвет строки градиента из четырёх остановок: 0%, 48%, 52%, 100% (как «металл» на сайте).
функция т_цвет_строки(целое c0, целое c1, целое c2, целое c3, целое строка, целое всего): целое
    целое знам = всего - 1;
    если (знам меньше 1)
        знам = 1;
    конец
    целое т = строка * 100 / знам;
    если (т меньше 48)
        вернуть т_смесь(c0, c1, т * 100 / 48);
    конец
    если (т меньше 52)
        вернуть т_смесь(c1, c2, (т - 48) * 100 / 4);
    конец
    вернуть т_смесь(c2, c3, (т - 52) * 100 / 48);
конец

// Сколько пикселей срезать слева и справа на строке, отстоящей на d от центра дуги радиуса r.
функция т_вырез(целое r, целое d): целое
    дробное под = дробное(r * r) - дробное(d * d) + дробное(d);
    если (под меньше 0.0)
        под = 0.0;
    конец
    целое ширина_дуги = целое(квадратный_корень(под));
    целое итог = r - ширина_дуги;
    если (итог меньше 0)
        итог = 0;
    конец
    вернуть итог;
конец

// Скруглённый прямоугольник с вертикальным градиентом.
функция т_градиент(текст холст, целое х, целое у, целое ш, целое выс, целое r, целое c0, целое c1, целое c2, целое c3, целое прозрачность): целое
    целое радиус = r;
    если (радиус * 2 больше выс)
        радиус = выс / 2;
    конец
    если (радиус * 2 больше ш)
        радиус = ш / 2;
    конец
    целое i = 0;
    пока (i меньше выс)
        целое вырез = 0;
        если (i меньше радиус)
            вырез = т_вырез(радиус, радиус - i);
        иначе если (i больше выс - радиус - 1)
            вырез = т_вырез(радиус, i - (выс - радиус) + 1);
        конец
        т_залить(холст, х + вырез, у + i, ш - вырез * 2, 1, т_цвет_строки(c0, c1, c2, c3, i, выс), прозрачность);
        i = i + 1;
    конец
    вернуть 0;
конец

функция т_сплошной(текст холст, целое х, целое у, целое ш, целое выс, целое r, целое с): целое
    вернуть т_градиент(холст, х, у, ш, выс, r, с, с, с, с, 255);
конец

// Рамка 1 пиксель + градиентная заливка внутри.
функция т_рамка_градиент(текст холст, целое х, целое у, целое ш, целое выс, целое r, целое контур, целое c0, целое c1, целое c2, целое c3): целое
    т_сплошной(холст, х, у, ш, выс, r, контур);
    т_градиент(холст, х + 1, у + 1, ш - 2, выс - 2, r - 1, c0, c1, c2, c3, 255);
    вернуть 0;
конец

// Овальная глянцевая кнопка. Стили: 0 обычная, 1 и 3 главная (синяя), 2 опасная, 4 предупреждение.
// наведение и нажатие — 0..100.
функция т_кнопка(текст холст, целое х, целое у, целое ш, целое выс, целое стиль, целое наведение, целое нажатие, верно доступна): целое
    целое c0 = 4876452;     // 4a68a4
    целое c1 = 3164541;     // 30497d
    целое c2 = 1847130;     // 1c2f5a
    целое c3 = 2769522;     // 2a4272
    целое контур = т_контур();
    если (стиль == 1 или стиль == 3)
        c0 = 9427199;       // 8fd8ff
        c1 = 3051248;       // 2e8ef0
        c2 = 1333438;       // 1458be
        c3 = 4891391;       // 4aa2ff
        контур = 605066;    // 093b8a
    иначе если (стиль == 2)
        c0 = 15305342;      // e98a7e
        c1 = 13650492;      // d04a3c
        c2 = 10101016;      // 9a2118
        c3 = 12862522;      // c4443a
        контур = 4853000;   // 4a0d08
    иначе если (стиль == 4)
        c0 = 16767370;      // ffd98a
        c1 = 15770926;      // f0a52e
        c2 = 12087306;      // b8700a
        c3 = 14849311;      // e2951f
        контур = 5911811;   // 5a3503
    конец
    если ( не доступна)
        c0 = 2765648;       // 2a3350
        c1 = 2239044;       // 222a44
        c2 = 1778232;       // 1b2238
        c3 = 2238020;
        контур = 1383216;   // 151b30
    иначе
        если (наведение больше 0)
            целое св = наведение * 22 / 100;
            c0 = т_смесь(c0, 16777215, св);
            c1 = т_смесь(c1, 16777215, св);
            c2 = т_смесь(c2, 16777215, св);
            c3 = т_смесь(c3, 16777215, св);
        конец
        если (нажатие больше 0)
            целое тм = нажатие * 30 / 100;
            c0 = т_смесь(c0, 0, тм);
            c1 = т_смесь(c1, 0, тм);
            c2 = т_смесь(c2, 0, тм);
            c3 = т_смесь(c3, 0, тм);
        конец
    конец
    целое r = выс / 2;
    т_рамка_градиент(холст, х, у, ш, выс, r, контур, c0, c1, c2, c3);
    если (доступна)
        // тонкий блик по верхней кромке
        т_залить(холст, х + r, у + 1, ш - r * 2, 1, 16777215, 70 - нажатие / 2);
    конец
    вернуть 0;
конец

// Панель-окно (карточки, плитки): контур, лёгкий вертикальный перелив, блик сверху.
функция т_панель(текст холст, целое х, целое у, целое ш, целое выс, целое r): целое
    т_рамка_градиент(холст, х, у, ш, выс, r, т_контур(), т_окно_2(), т_окно(), т_окно(), т_окно());
    т_залить(холст, х + r, у + 1, ш - r * 2, 1, 16777215, 22);
    вернуть 0;
конец

// Утопленная область (поле вывода, строка команды, поле ввода).
функция т_утопленная(текст холст, целое х, целое у, целое ш, целое выс, целое r, верно фокус): целое
    целое контур = т_линия();
    если (фокус)
        контур = 3906815;   // 3b9cff
    конец
    т_сплошной(холст, х, у, ш, выс, r, контур);
    т_градиент(холст, х + 1, у + 1, ш - 2, выс - 2, r - 1, 397088, т_утоплено(), т_утоплено(), т_утоплено(), 255);
    вернуть 0;
конец

// Выбранный пункт меню (градиент «--sel» с сайта).
функция т_выбрано(текст холст, целое х, целое у, целое ш, целое выс): целое
    т_градиент(холст, х, у, ш, выс, 6, 5940991, 2847462, 2320604, 1591976, 255);
    т_залить(холст, х + 6, у + 1, ш - 12, 1, 16777215, 60);
    вернуть 0;
конец

// Шапка окна: «металл» с сайта.
функция т_металл(текст холст, целое х, целое у, целое ш, целое выс): целое
    целое i = 0;
    пока (i меньше выс)
        т_залить(холст, х, у + i, ш, 1, т_цвет_строки(5798072, 3428490, 1847650, 2770040, i, выс), 255);
        i = i + 1;
    конец
    вернуть 0;
конец

// Фон окна: вертикальный градиент от «--bg» вниз.
функция т_фон_окна(текст холст, целое х, целое у, целое ш, целое выс): целое
    целое i = 0;
    пока (i меньше выс)
        т_залить(холст, х, у + i, ш, 2, т_смесь(т_фон(), т_фон_низ(), i * 100 / выс), 255);
        i = i + 2;
    конец
    вернуть 0;
конец
