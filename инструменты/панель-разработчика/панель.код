    результат из целого итог = выполнить_команду(команда);
    если ( не итог.успешно)
        вернуть ошибка("не удалось выполнить запрос (нет интернета?)");
    конец

    результат из текста содержимое = прочитать_файл(лог);
    если ( не содержимое.успешно)
        вернуть ошибка("не удалось прочитать ответ GitHub");
    конец
    вернуть успех(содержимое.значение);
конец

функция начинается_с(текст строка, текст префикс): верно
    если (длина(строка) меньше длина(префикс))
        вернуть нет;
    конец
    результат из текста начало = подстрока(строка, 0, длина(префикс));
    если (начало.успешно)
        вернуть начало.значение == префикс;
    конец
    вернуть нет;
конец

// НОВОЕ: разбирает текстовый вывод "сфера_пакеты список" (см. точный
// формат в показать_список, src/bin/сфера_пакеты.rs) в три параллельных
// списка — по одной записи на пакет. Опирается на точные префиксы строк
// ("  " перед именем, "    источник: "/"    описание: " перед полями) —
// тот же формат, что мы сами и печатаем, поэтому не нужен более общий,
// терпимый к ошибкам разбор.
функция разобрать_пакеты(текст вывод, Список из текстов имена, Список из текстов источники, Список из текстов описания): целое
    текст остаток = вывод;
    текст текущее_имя = "";
    текст текущий_источник = "—";
    текст текущее_описание = "—";
    верно есть_текущий = нет;

    пока (длина(остаток) больше 0)
        текст строка = остаток;
        текст следующий_остаток = "";
        результат из целого позиция_переноса = найти(остаток, "\n");
        если (позиция_переноса.успешно)
            результат из текста часть = подстрока(остаток, 0, позиция_переноса.значение);
            если (часть.успешно)
                строка = часть.значение;
            конец
            целое после = позиция_переноса.значение + 1;
            результат из текста хвост = подстрока(остаток, после, длина(остаток) - после);
            если (хвост.успешно)
                следующий_остаток = хвост.значение;
            конец
        конец

        если (начинается_с(строка, "    источник: "))
            // ⚠️ НАЙДЕННЫЙ БАГ: раньше здесь стояло жёсткое число 15 —
            // неверное, поскольку "источник"/"описание" — кириллица,
            // каждая буква 2 байта в UTF-8, реальная длина префикса 22
            // байта. Исправлено на динамический расчёт от самого текста
            // префикса — больше никогда не собьётся, даже если сам текст
            // префикса потом изменится.
            целое длина_префикса = длина("    источник: ");
            результат из текста значение = подстрока(строка, длина_префикса, длина(строка) - длина_префикса);
            если (значение.успешно)
                текущий_источник = значение.значение;
            конец
        иначе если (начинается_с(строка, "    описание: "))
            целое длина_префикса = длина("    описание: ");
            результат из текста значение = подстрока(строка, длина_префикса, длина(строка) - длина_префикса);
            если (значение.успешно)
                текущее_описание = значение.значение;
            конец
        иначе если (начинается_с(строка, "  ") и не начинается_с(строка, "    ") и длина(строка) больше 2)
            // Начало новой записи о пакете — сохраняем предыдущую (если
            // была) и начинаем собирать следующую.
            если (есть_текущий)
                имена.добавить(текущее_имя);
                источники.добавить(текущий_источник);
                описания.добавить(текущее_описание);
            конец
            // Пробелы однобайтовые, "2" тут технически верно, но
            // динамический расчёт для единообразия с исправлением выше.
            целое длина_отступа = длина("  ");
            результат из текста имя_без_отступа = подстрока(строка, длина_отступа, длина(строка) - длина_отступа);
            если (имя_без_отступа.успешно)
                текущее_имя = имя_без_отступа.значение;
            конец
            текущий_источник = "—";
            текущее_описание = "—";
            есть_текущий = да;
        конец

        остаток = следующий_остаток;
        если ( не позиция_переноса.успешно)
            остаток = "";
        конец
    конец

    если (есть_текущий)
        имена.добавить(текущее_имя);
        источники.добавить(текущий_источник);
        описания.добавить(текущее_описание);
    конец

    вернуть 0;
конец

// Выводит многострочный текст (с \n внутри) построчно, начиная с
// заданной Y-координаты — графическая библиотека умеет рисовать только
// одну строку за раз, эта функция разбивает текст сама.
функция нарисовать_многострочный_текст(текст холст, текст шрифт, текст содержимое, целое32 х, целое32 начальный_у): целое
    текст остаток = содержимое;
    целое32 текущий_у = начальный_у;
    целое строк_нарисовано = 0;

    пока (строк_нарисовано меньше 20)
        результат из целого позиция_переноса = найти(остаток, "\n");
        если (позиция_переноса.успешно)
            результат из текста строка = подстрока(остаток, 0, позиция_переноса.значение);
            если (строка.успешно)
                нарисовать_текст(холст, шрифт, строка.значение, х, текущий_у, 4294967295);
            конец
            целое следующая_позиция = позиция_переноса.значение + 1;
            // ⚠️ НАЙДЕННАЯ ОШИБКА: третий аргумент "подстрока" — это ДЛИНА
            // подстроки, а не абсолютный индекс конца, как предполагалось
            // изначально. "длина(остаток) - следующая_позиция" —
            // правильная длина оставшейся части СТРОКИ.
            целое длина_остатка = длина(остаток) - следующая_позиция;
            результат из текста остаток_после = подстрока(остаток, следующая_позиция, длина_остатка);
            если (остаток_после.успешно)
                остаток = остаток_после.значение;
            иначе
                вернуть строк_нарисовано;
            конец
        иначе
            если (длина(остаток) больше 0)
                нарисовать_текст(холст, шрифт, остаток, х, текущий_у, 4294967295);
                строк_нарисовано = строк_нарисовано + 1;
            конец
            вернуть строк_нарисовано;
        конец
        текущий_у = текущий_у + целое32(22);
        строк_нарисовано = строк_нарисовано + 1;
    конец

    вернуть строк_нарисовано;
конец

// НОВОЕ: подробная информация о языке — версия уже была (текущая_версия),
// добавлены название/описание/честные ограничения, показывается на
// вкладке "Обзор".
функция описание_языка(): текст
    вернуть "«Сфера» — независимый, компилируемый язык программирования\n"
        + "с полностью русским синтаксисом. Компилятор написан на Rust,\n"
        + "генерирует машинный код напрямую через LLVM.\n\n"
        + "Возможности: автоматическое управление памятью (ARC), контракты\n"
        + "и полиморфизм, обобщённые типы, настоящая многопоточность,\n"
        + "графический интерфейс, собственное хранилище данных.\n\n"
        + "Честные ограничения: соло-проект одного разработчика — скорость\n"
        + "развития такая, какая есть. Нет полноценного пакетного менеджера\n"
        + "с публикацией и версиями. Диагностика ошибок компилятора\n"
        + "активно дорабатывается.";
конец

функция главная(): целое
    инициализировать(32);
    инициализировать_шрифты();

    текст окно = создать_окно("Сфера — среда разработки", 0, 0, 720, 760, 0);
    текст холст = создать_холст(окно, -1, 0);
    текст шрифт = открыть_шрифт(выбрать_путь_шрифта(), 17);

    // --- Боковая панель вкладок (слева, x = 0..150) ---
    Кнопка вкладка_обзор = Кнопка(0, 0, 150, 50, 45, 45, 50, "");
    Кнопка вкладка_пакеты = Кнопка(0, 50, 150, 50, 45, 45, 50, "");
    Кнопка вкладка_документация = Кнопка(0, 100, 150, 50, 45, 45, 50, "");

    // --- Кнопки вкладки "Обзор" ---
    Кнопка кнопка_установить = Кнопка(170, 200, 220, 50, 60, 160, 60, "");
    Кнопка кнопка_удалить = Кнопка(170, 260, 220, 50, 170, 60, 60, "");
    Кнопка кнопка_собрать = Кнопка(170, 320, 220, 50, 60, 120, 200, "");
    Кнопка кнопка_обновить = Кнопка(170, 380, 260, 50, 200, 140, 40, "");

    // --- Кнопки вкладки "Пакеты" ---
    Кнопка кнопка_список_пакетов = Кнопка(170, 60, 220, 45, 60, 100, 200, "");

    // НОВОЕ: настоящая, структурированная таблица (Имя | Источник |
    // Описание) вместо голого текстового вывода — заполняется разбором
    // вывода "сфера_пакеты список" через разобрать_пакеты.
    Список из целых ширины_колонок_пакетов = Список из целых();
    ширины_колонок_пакетов.добавить(150);
    ширины_колонок_пакетов.добавить(160);
    ширины_колонок_пакетов.добавить(240);
    Таблица таблица_пакетов = Таблица(170, 130, ширины_колонок_пакетов, 30);

    Список из текстов заголовки_пакетов = Список из текстов();
    заголовки_пакетов.добавить("Имя");
    заголовки_пакетов.добавить("Источник");
    заголовки_пакетов.добавить("Описание");

    Список из текстов имена_пакетов = Список из текстов();
    Список из текстов источники_пакетов = Список из текстов();
    Список из текстов описания_пакетов = Список из текстов();

    // --- Кнопки вкладки "Документация" ---
    Кнопка кнопка_открыть_документацию = Кнопка(170, 300, 260, 50, 60, 160, 60, "");

    целое текущая_вкладка = 0;
    текст статус = "";
    верно найдено_обновление = нет;
    текст новая_версия_текст = "";
    // НОВОЕ: полный текст описания изменений найденного обновления —
    // из поля "body" ответа GitHub Releases API, показывается
    // многострочно на экране, когда найдено_обновление == да.
    текст новая_версия_описание = "";
    // НОВОЕ: папка установки — по умолчанию прежнее значение (~/.sfera),
    // меняется на выбранную пользователем через системный диалог при
    // нажатии "Установить" (см. выбрать_папку_через_диалог).
    текст выбранная_папка_установки = папка_установки_по_умолчанию();
    верно продолжать = да;
    текст буфер_события = выделить_память(64);
    целое итерация = 0;

    пока (продолжать и итерация меньше 6000)
        целое32 есть_событие = опросить_событие(буфер_события);
        если (есть_событие != целое32(0))
            целое32 тип_события = прочитать_целое32(буфер_события, 0);

            если (тип_события == целое32(256))
                продолжать = нет;
            иначе если (тип_события == целое32(1025))
                целое32 х = прочитать_целое32(буфер_события, 20);
                целое32 у = прочитать_целое32(буфер_события, 24);

                // --- Переключение вкладок — работает независимо от того,
                // какая вкладка сейчас открыта ---
                если (вкладка_обзор.содержит_точку(х, у))
                    текущая_вкладка = 0;
                    статус = "";
                иначе если (вкладка_пакеты.содержит_точку(х, у))
                    текущая_вкладка = 1;
                    статус = "";
                иначе если (вкладка_документация.содержит_точку(х, у))
                    текущая_вкладка = 2;
                    статус = "";
                иначе если (текущая_вкладка == 0)
                    если ( не сфера_уже_установлена(выбранная_папка_установки) и кнопка_установить.содержит_точку(х, у))
                        статус = "Выбери папку для установки...";
                        результат из текста выбор = выбрать_папку_через_диалог();
                        если ( не выбор.успешно)
                            статус = "Установка отменена.";
                        иначе
                            выбранная_папка_установки = выбор.значение;
                            статус = "Устанавливаю в " + выбранная_папка_установки + "...";
                            верно установлено_успешно = установить_сферу(выбранная_папка_установки);
                            если (установлено_успешно)
                                статус = "Готово — Сфера установлена.";
                            иначе
                                статус = "Не удалось установить.";
                            конец
                        конец
                    иначе если (сфера_уже_установлена(выбранная_папка_установки) и кнопка_удалить.содержит_точку(х, у))
                        статус = "Удаляю...";
                        верно удалено_успешно = удалить_сферу(выбранная_папка_установки);
                        если (удалено_успешно)
                            статус = "Сфера удалена.";
                        иначе
                            статус = "Не удалось удалить.";
                        конец
                    иначе если (сфера_уже_установлена(выбранная_папка_установки) и кнопка_собрать.содержит_точку(х, у))
                        статус = "Идёт сборка...";
                        текст лог_ошибки = "/tmp/sfera_панель_ошибка.log";
                        текст команда_сборки = "cd /tmp && " + путь_установленного_sfera(выбранная_папка_установки) + " " + путь_установленного_примера(выбранная_папка_установки) + " -c 2> " + лог_ошибки;
                        результат из целого итог = выполнить_команду(команда_сборки);
                        если (итог.успешно и итог.значение == 0)
                            статус = "Сборка успешна!";
                        иначе
                            результат из текста содержимое_ошибки = прочитать_файл(лог_ошибки);
                            если (содержимое_ошибки.успешно и длина(содержимое_ошибки.значение) больше 0)
                                целое показать_символов = 60;
                                если (длина(содержимое_ошибки.значение) меньше показать_символов)
                                    показать_символов = длина(содержимое_ошибки.значение);
                                конец
                                результат из текста обрезанная_ошибка = подстрока(содержимое_ошибки.значение, 0, показать_символов);
                                если (обрезанная_ошибка.успешно)
                                    статус = "Ошибка: " + обрезанная_ошибка.значение;
                                конец
                            иначе
                                статус = "Ошибка сборки.";
                            конец
                        конец
                    иначе если (кнопка_обновить.содержит_точку(х, у))
                        если (найдено_обновление)
                            // НОВОЕ: вместо автоматической подмены самого
                            // .app-бандла (рискованно — панель заменяла бы
                            // файлы, из которых сама сейчас запущена) —
                            // честно, безопасно открываем страницу релиза
                            // на GitHub в браузере, пользователь сам
                            // скачивает и заменяет бандл, обычным macOS-
                            // способом обновления приложений.
                            выполнить_команду("open https://github.com/nikitosklim/Sfera/releases/latest");
                            статус = "Открыл страницу релиза в браузере — скачай и замени приложение.";
                        иначе
                            статус = "Проверяю обновления...";
                            результат из текста ответ = проверить_обновления_на_github();
                            если ( не ответ.успешно)
                                статус = "Не удалось проверить обновления: " + ответ.сообщение;
                            иначе
                                текст json = ответ.значение;
                                результат из текста тег = извлечь_json_строковое_поле(json, "tag_name");
                                если ( не тег.успешно)
                                    статус = "Не удалось разобрать ответ GitHub (нет релизов?).";
                                иначе
                                    текст версия_с_github = тег.значение;
                                    если (начинается_с(версия_с_github, "v"))
                                        результат из текста без_v = подстрока(версия_с_github, 1, длина(версия_с_github) - 1);
                                        если (без_v.успешно)
                                            версия_с_github = без_v.значение;
                                        конец
                                    конец

                                    если (версия_с_github == текущая_версия())
                                        статус = "У тебя последняя версия.";
                                    иначе если ( не релиз_содержит_сборку_для_платформы(json))
                                        // НОВОЕ: версия на GitHub новее, но
                                        // среди файлов релиза нет сборки
                                        // под ЭТУ платформу (метка_текущей_
                                        // платформы) — честно, отдельно
                                        // сообщаем об этом, не предлагаем
                                        // "обновить" то, чего фактически
                                        // нет для скачивания.
                                        статус = "Вышла версия " + версия_с_github + ", но пока не собрана для " + метка_текущей_платформы() + ".";
                                    иначе
                                        найдено_обновление = да;
                                        новая_версия_текст = версия_с_github;
                                        новая_версия_описание = "Без описания изменений.";
                                        результат из текста тело = извлечь_json_строковое_поле(json, "body");
                                        если (тело.успешно и длина(тело.значение) больше 0)
                                            новая_версия_описание = разэкранировать_json_текст(тело.значение);
                                        конец
                                        статус = "Доступно обновление " + версия_с_github + "!";
                                    конец
                                конец
                            конец
                        конец
                    конец
                иначе если (текущая_вкладка == 1)
                    если (кнопка_список_пакетов.содержит_точку(х, у))
                        статус = "Обновляю список...";
                        имена_пакетов = Список из текстов();
                        источники_пакетов = Список из текстов();
                        описания_пакетов = Список из текстов();
                        разобрать_пакеты(получить_список_пакетов(выбранная_папка_установки), имена_пакетов, источники_пакетов, описания_пакетов);
                        статус = "";
                    конец
                иначе если (текущая_вкладка == 2)
                    если (кнопка_открыть_документацию.содержит_точку(х, у))
                        открыть_документацию();
                        статус = "Открываю README.md...";
                    конец
                конец
            конец
        конец

        // --- Отрисовка ---
        задать_цвет(холст, 20, 20, 20, 255);
        очистить_холст(холст);

        // Боковая панель — фон чуть светлее основного, для визуального
        // разделения (в духе таблицы с "шапкой"/колонкой заголовков).
        Кнопка фон_боковой_панели = Кнопка(0, 0, 150, 760, 30, 30, 35, "");
        фон_боковой_панели.нарисовать(холст, шрифт);

        вкладка_обзор.нарисовать(холст, шрифт);
        вкладка_пакеты.нарисовать(холст, шрифт);
        вкладка_документация.нарисовать(холст, шрифт);
        нарисовать_текст(холст, шрифт, "Обзор", 15, 18, 4294967295);
        нарисовать_текст(холст, шрифт, "Пакеты", 15, 68, 4294967295);
        нарисовать_текст(холст, шрифт, "Документация", 15, 118, 4294967295);

        если (текущая_вкладка == 0)
            нарисовать_текст(холст, шрифт, "Обзор языка Сфера", 170, 20, 4294967295);
            нарисовать_текст(холст, шрифт, "Версия: " + текущая_версия(), 170, 50, 4294967295);

            если (сфера_уже_установлена(выбранная_папка_установки))
                нарисовать_текст(холст, шрифт, "Статус: установлено", 170, 80, 4294967295);
