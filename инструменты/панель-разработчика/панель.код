// НОВОЕ: системный диалог выбора папки — macOS-нативный, через
// "osascript" (тот же приём, что и остальная панель уже использует для
// запуска процессов: команда пишет результат в файл, мы читаем файл, а
// не пытаемся разобрать вывод напрямую из живого процесса). "choose
// folder" — стандартный, встроенный в macOS диалог выбора папки, без
// сторонних зависимостей.
//
// ⚠️ НЕ ПРОВЕРЕНО ВЖИВУЮ (нет доступа к настоящему macOS здесь) — как и
// с Windows-установщиком ранее, первая реальная проверка — по факту
// присланной ошибки, если она возникнет.
функция выбрать_папку_через_диалог(): результат из текста
    текст лог = "/tmp/sfera_панель_выбор_папки.log";
    текст команда = "osascript -e 'POSIX path of (choose folder with prompt \"Выберите папку для установки языка Сфера\")' > " + лог + " 2>/dev/null";
    результат из целого итог = выполнить_команду(команда);
    // Пользователь нажал "Отмена" в диалоге — osascript возвращает
    // ненулевой код (это НЕ ошибка запуска команды, а честный,
    // ожидаемый отказ пользователя, обрабатывается отдельно, не как
    // "не удалось выполнить команду").
    если ( не итог.успешно или итог.значение != 0)
        вернуть ошибка("отменено пользователем");
    конец

    результат из текста содержимое = прочитать_файл(лог);
    если ( не содержимое.успешно)
        вернуть ошибка("не удалось прочитать выбранный путь");
    конец

    // "choose folder" всегда возвращает POSIX-путь с завершающим "/" и
    // переводом строки в конце — убираем оба, прежде чем использовать
    // как обычный путь для конкатенации.
    текст путь = содержимое.значение;
    результат из целого позиция_переноса = найти(путь, "\n");
    если (позиция_переноса.успешно)
        результат из текста обрезанный = подстрока(путь, 0, позиция_переноса.значение);
        если (обрезанный.успешно)
            путь = обрезанный.значение;
        конец
    конец
    если (длина(путь) больше 0)
        результат из текста последний_символ_результат = подстрока(путь, длина(путь) - 1, 1);
        если (последний_символ_результат.успешно и последний_символ_результат.значение == "/")
            результат из текста без_слеша = подстрока(путь, 0, длина(путь) - 1);
            если (без_слеша.успешно)
                путь = без_слеша.значение;
            конец
        конец
    конец

    вернуть успех(путь + "/.sfera");
конец

функция установить_сферу(текст базовая_папка): верно
    текст папка_bin = базовая_папка + "/bin";
    текст папка_share = базовая_папка + "/share";
    текст встроенный_bin = путь_встроенного_бандла();

    текст команда = "mkdir -p '" + папка_bin + "' '" + папка_share + "' && "
        + "cp '" + встроенный_bin + "/запустить' '" + папка_bin + "/запустить' && "
        + "cp '" + встроенный_bin + "/сфера_lsp' '" + папка_bin + "/сфера_lsp' && "
        + "cp '" + встроенный_bin + "/сфера_пакеты' '" + папка_bin + "/сфера_пакеты' && "
        + "cp '" + встроенный_bin + "/привет.код' '" + папка_share + "/привет.код' && "
        + "mkdir -p '" + базовая_папка + "/lib/sfera' && rm -rf '" + базовая_папка + "/lib/sfera/стандартная_библиотека' && "
        + "cp -r '" + встроенный_bin + "/../lib/sfera/стандартная_библиотека' '" + базовая_папка + "/lib/sfera/стандартная_библиотека' && "
        + "echo '" + текущая_версия() + "' > '" + папка_share + "/версия.txt' && "
        + "chmod +x '" + папка_bin + "/запустить' '" + папка_bin + "/сфера_lsp' '" + папка_bin + "/сфера_пакеты'";

    результат из целого итог = выполнить_команду(команда);
    вернуть итог.успешно и итог.значение == 0;
конец

