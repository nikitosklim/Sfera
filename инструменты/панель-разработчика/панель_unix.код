        т_залить(холст, меню_ш, с.высота - 30, с.ширина - меню_ш, 1, т_линия(), 255);
        текст нижняя = с.статус;
        если (длина(с.подсказка) больше 0)
            нижняя = с.подсказка;
        иначе если (длина(нижняя) == 0 и не с.связь_есть и с.фон_задача == 0)
            нижняя = "Нет связи с сайтом — обновления не проверены";
        конец
        если (с.задача больше 0)
            нарисовать_спиннер(холст, х0 + 8, с.высота - 15, с.кадр);
            текст_в(холст, ш_малый, нижняя, х0 + 24, с.высота - 23, цвет_текста(190, 208, 240));
        иначе
            текст_в(холст, ш_малый, нижняя, х0, с.высота - 23, цвет_текста(142, 164, 208));
        конец

        если (с.диалог больше 0)
            нарисовать_диалог(с, холст, ш_обычный, ш_крупный);
        конец

        с.з_х = с.н_х;
        с.з_у = с.н_у;
        с.з_ш = с.н_ш;
        с.з_в = с.н_в;
        с.з_ид = с.н_ид;

        показать_холст(холст);
        подождать(16);
    конец

    вернуть 0;
конец
