функция внутри(целое х, целое у, целое рх, целое ру, целое рш, целое рв): верно
    вернуть х не меньше рх и х меньше рх + рш и у не меньше ру и у меньше ру + рв;
конец

// 1..3 — вкладки; 10..15 — кнопки вкладок; 21..23 — кнопки диалога.
// 0 — ничего. Пока открыт диалог, работают ТОЛЬКО его кнопки; пока идёт
// задача — только вкладки.
функция элемент_в_точке(целое х, целое у, целое вкладка, целое диалог, верно занято): целое
    если (диалог больше 0)
        если (длина(подпись_слота(диалог, 1)) больше 0 и внутри(х, у, 434, 428, 136, 42))
            вернуть 21;
        конец
        если (длина(подпись_слота(диалог, 2)) больше 0 и внутри(х, у, 288, 428, 136, 42))
            вернуть 22;
        конец
        если (длина(подпись_слота(диалог, 3)) больше 0 и внутри(х, у, 142, 428, 136, 42))
            вернуть 23;
        конец
        вернуть 0;
    конец
    если (внутри(х, у, 0, 0, 150, 50))
        вернуть 1;
    конец
    если (внутри(х, у, 0, 50, 150, 50))
        вернуть 2;
    конец
    если (внутри(х, у, 0, 100, 150, 50))
        вернуть 3;
    конец
    если (занято)
        вернуть 0;
    конец
    если (вкладка == 0)
        если (внутри(х, у, 170, 200, 220, 50))
            вернуть 10;
        конец
        если (внутри(х, у, 170, 260, 220, 50))
            вернуть 11;
        конец
        если (внутри(х, у, 170, 320, 220, 50))
            вернуть 12;
        конец
        если (внутри(х, у, 170, 380, 260, 50))
            вернуть 13;
        конец
    иначе если (вкладка == 1)
        если (внутри(х, у, 170, 60, 220, 45))
            вернуть 14;
        конец
    иначе если (вкладка == 2)
        если (внутри(х, у, 170, 300, 260, 50))
            вернуть 15;
        конец
    конец
    вернуть 0;
конец

