    узнать_размер_окна_сырое(окно, б_окно_ш, б_окно_в);
    целое32 вывод_ш = прочитать_целое32(б_вывод_ш, 0);
    целое32 окно_ш = прочитать_целое32(б_окно_ш, 0);
    целое плотность_экрана = 1;
    если (окно_ш больше целое32(0) и вывод_ш >= окно_ш * целое32(2))
