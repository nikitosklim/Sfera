                    иначе если (клавиша == целое32(118) и (наложить_маску(целое32(модиф), целое32(960))) != целое32(0))
                        поле_формы_добавить(с, взять_буфер_обмена());
                    конец
                иначе если (с.в_фокусе)
                    если (клавиша == целое32(8))
