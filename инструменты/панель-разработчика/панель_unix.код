        иначе
            открыть_диалог(с, 3, 1, "Не удалось установить", текст_лога_кратко());
        конец
    иначе если (вид == 3)
        с.установлена = сфера_уже_установлена(с.папка);
        если (код == 0 и не с.установлена)
            открыть_диалог(с, 3, 2, "Сфера удалена", "Папка удалена:\n" + с.папка);
        иначе
            открыть_диалог(с, 3, 1, "Не удалось удалить", текст_лога_кратко());
        конец
    иначе если (вид == 4)
        текст вывод_теста = прочитать_слот(0, "log");
        с.консоль = вывод_теста;
        если (код == 0 и содержит(вывод_теста, "Привет, мир!"))
            с.итог_консоли = "Всё работает: программа собрана и ответила.";
        иначе
            с.итог_консоли = "Тест не пройден. Подробности выше.";
        конец
    иначе если (вид == 10)
        если (код == 0)
            открыть_диалог(с, 3, 2, "Пакет установлен", "«" + с.выбран_пакет + "» установлен в папку проекта:\n" + с.папка_пакета + "\nПодключай его в коде: подключить пакеты/" + с.выбран_пакет + "/…");
            с.статус = "";
        иначе
            открыть_диалог(с, 3, 1, "Не удалось установить пакет", текст_лога_кратко());
        конец
    иначе если (вид == 11)
        если (код == 0)
            открыть_диалог(с, 3, 2, "Пакет отправлен", "Пакет опубликован на сайте. Сначала он будет «непроверенным».\n" + текст_лога_кратко());
        иначе
            открыть_диалог(с, 3, 1, "Не удалось опубликовать", текст_лога_кратко());
        конец
    иначе если (вид == 12)
        если (код == 0)
            открыть_диалог(с, 3, 2, "Готово", "Токен автора сохранён. Теперь «сфера опубликовать» работает из любого терминала.");
        иначе
            открыть_диалог(с, 3, 1, "Не удалось сохранить токен", текст_лога_кратко());
        конец
    иначе если (вид == 8)
        если (код == 0)
            с.найдено_обновление = нет;
            открыть_диалог(с, 3, 2, "Панель обновлена", "Закрой панель и открой её снова — запустится новая версия " + с.новая_версия + ".");
        иначе
            открыть_диалог(с, 3, 1, "Не удалось обновить панель", текст_лога_кратко());
