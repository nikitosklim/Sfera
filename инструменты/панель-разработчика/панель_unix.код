функция завершить_задачу(Состояние с, целое код): целое
    целое вид = с.задача;
    с.задача = 0;
    с.статус = "";

    если (вид == 1)
        если (код == 0)
            текст путь = последняя_строка(прочитать_слот(0, "log"));
            если (длина(путь) больше 0 и с.вид_выбора == 2)
