        т_фон_окна(холст, 0, 0, с.ширина, с.высота);
        целое меню_ш = 148;
        целое х0 = меню_ш + 20;
        целое ш0 = с.ширина - х0 - 20;
        целое в0 = с.высота - 44 - 16;
        целое у0 = 16;

        если (с.страница == 0)
            нарисовать_обзор(с, холст, ш_обычный, ш_малый, ш_крупный, х0, у0, ш0);
        иначе если (с.страница == 1)
            нарисовать_тест(с, холст, ш_обычный, ш_малый, ш_крупный, х0, у0, ш0, в0);
        иначе если (с.страница == 2)
            нарисовать_пакеты(с, холст, ш_обычный, ш_малый, ш_крупный, х0, у0, ш0, в0, имена_пакетов, версии_пакетов, авторы_пакетов, описания_пакетов);
        иначе если (с.страница == 3)
            нарисовать_документацию(с, холст, ш_обычный, ш_малый, ш_крупный, х0, у0, ш0, в0, разделы_мат, пути_мат, названия_мат, описания_мат, метки_мат);
        иначе
            нарисовать_вход(с, холст, ш_обычный, ш_малый, ш_крупный, х0, у0, ш0, в0);
        конец
        если (с.страница_п меньше 100)
