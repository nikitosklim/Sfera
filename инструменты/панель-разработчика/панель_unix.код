// --- Зоны нажатия (режим «рисуем и тут же запоминаем, где кнопка») ---

функция зона(Состояние с, целое ид, целое х, целое у, целое ш, целое выс): целое
    с.н_х.добавить(х);
    с.н_у.добавить(у);
    с.н_ш.добавить(ш);
    с.н_в.добавить(выс);
    с.н_ид.добавить(ид);
    вернуть 0;
конец

// Номер зоны под курсором по данным прошлого кадра; верхние (нарисованные позже) важнее.
функция зона_в_точке(Состояние с, целое х, целое у): целое
    целое i = с.з_ид.размер() - 1;
    пока (i не меньше 0)
        целое ид = с.з_ид.получить(i);
        если (с.диалог == 0 или ид не меньше 900)
            если (х не меньше с.з_х.получить(i) и х меньше с.з_х.получить(i) + с.з_ш.получить(i)
                и у не меньше с.з_у.получить(i) и у меньше с.з_у.получить(i) + с.з_в.получить(i))
                вернуть ид;
            конец
        конец
        i = i - 1;
    конец
    вернуть 0;
конец

// Иконки из линий и квадратиков: 1 папка, 2 многоточие, 3 галочка, 4 плюс, 5 обновление-стрелка вниз
функция иконка(текст холст, целое вид, целое цх, целое цу, целое р, целое з, целое с): целое
    задать_цвет(холст, беззнак8(р), беззнак8(з), беззнак8(с), 255);
    если (вид == 1)
        нарисовать_прямоугольник(холст, ц32(цх - 8), ц32(цу - 5), 7, 3);
        нарисовать_прямоугольник(холст, ц32(цх - 8), ц32(цу - 3), 16, 10);
        задать_цвет(холст, 50, 56, 72, 255);
        нарисовать_прямоугольник(холст, ц32(цх - 6), ц32(цу - 1), 12, 6);
    иначе если (вид == 2)
        нарисовать_прямоугольник(холст, ц32(цх - 7), ц32(цу - 1), 3, 3);
        нарисовать_прямоугольник(холст, ц32(цх - 1), ц32(цу - 1), 3, 3);
        нарисовать_прямоугольник(холст, ц32(цх + 5), ц32(цу - 1), 3, 3);
    иначе если (вид == 6)
        нарисовать_прямоугольник(холст, ц32(цх - 6), ц32(цу - 6), 8, 10);
        задать_цвет(холст, 62, 68, 86, 255);
        нарисовать_прямоугольник(холст, ц32(цх - 4), ц32(цу - 4), 4, 6);
        задать_цвет(холст, беззнак8(р), беззнак8(з), беззнак8(с), 255);
        нарисовать_прямоугольник(холст, ц32(цх - 2), ц32(цу - 2), 8, 10);
    иначе если (вид == 3)
        нарисовать_линию(холст, ц32(цх - 7), ц32(цу), ц32(цх - 3), ц32(цу + 4));
        нарисовать_линию(холст, ц32(цх - 7), ц32(цу + 1), ц32(цх - 3), ц32(цу + 5));
        нарисовать_линию(холст, ц32(цх - 3), ц32(цу + 4), ц32(цх + 6), ц32(цу - 5));
        нарисовать_линию(холст, ц32(цх - 3), ц32(цу + 5), ц32(цх + 6), ц32(цу - 4));
    иначе
        нарисовать_прямоугольник(холст, ц32(цх - 7), ц32(цу - 1), 14, 3);
        нарисовать_прямоугольник(холст, ц32(цх - 1), ц32(цу - 7), 3, 14);
    конец
    вернуть 0;
конец

// Цвета кнопок: 0 нейтральная, 1 зелёная, 2 красная, 3 синяя, 4 жёлтая
функция нарисовать_кнопку(Состояние с, текст холст, текст шрифт, целое ид, целое х, целое у, целое ш, целое выс, текст подпись, целое стиль, верно доступна, текст подсказка): целое
