конец

функция запустить_материалы(Состояние с): целое
    если (с.мат_задача == 0 и запустить_в_слоте(4, тело_материалов()))
        с.мат_задача = 7;
    конец
    вернуть 0;
конец

// Разбирает список: раздел | адрес | название | описание | метка.
функция разобрать_материалы(текст исходный, Список из текст разделы, Список из текст пути, Список из текст названия, Список из текст описания, Список из текст метки): целое
    Список из текст строки = Список из текст();
    строки_текста(исходный, строки);
    целое k = 0;
    пока (k меньше строки.размер())
        текст строка = обрезать_края(строки.получить(k));
        если (длина(строка) больше 0 и не начинается_с(строка, "#"))
            Список из текст части = Список из текст();
            разбить_по_полям(строка, части);
            если (части.размер() не меньше 5)
                разделы.добавить(части.получить(0));
                пути.добавить(части.получить(1));
                названия.добавить(части.получить(2));
                описания.добавить(части.получить(3));
                метки.добавить(части.получить(4));
            конец
        конец
        k = k + 1;
    конец
    вернуть разделы.размер();
конец

// Группа материала: 0 уроки, 1 курс, 2 железо, 3 справочник.
функция группа_материала(текст раздел, текст метка): целое
    если (раздел == "docs")
        вернуть 3;
    конец
    если (начинается_с(метка, "Курс"))
        вернуть 1;
    конец
    если (начинается_с(метка, "Железо"))
        вернуть 2;
    конец
    вернуть 0;
конец

функция название_группы(целое г): текст
    если (г == 0)
        вернуть "Уроки";
    иначе если (г == 1)
        вернуть "Курс «Для обучения программированию»";
    иначе если (г == 2)
        вернуть "Железо: Сфера без операционной системы";
    конец
    вернуть "Справочник по языку";
конец

// --- Измерения и рисование ---

// Во сколько раз экран плотнее обычного (2 на Retina). Хранится в переменной среды SFERA_K:
// шрифты открыты в k раз крупнее, а все размеры и координаты остаются «логическими».
функция плотность(): целое
    текст к = прочитать_среду("SFERA_K");
    если (к == "2")
        вернуть 2;
    конец
    если (к == "3")
        вернуть 3;
    конец
    вернуть 1;
конец

// Текст в логических координатах: картинка строки в k раз крупнее и сжимается до логического размера,
// поэтому на Retina буквы чёткие.
функция нарисовать_текст_чётко(текст холст, текст шрифт, текст строка, целое32 х, целое32 у, беззнак32 цвет): целое32
    целое к = плотность();
    если (к == 1)
        вернуть нарисовать_текст(холст, шрифт, строка, х, у, цвет);
    конец
    текст поверхность = отрисовать_текст(шрифт, строка, цвет);
    текст текстура = создать_текстуру(холст, поверхность);
    текст буфер_ширины = выделить_память(4);
    текст буфер_высоты = выделить_память(4);
    узнать_размер_текстуры(текстура, нулевой_указатель(), нулевой_указатель(), буфер_ширины, буфер_высоты);
    целое32 ширина = прочитать_целое32(буфер_ширины, 0);
    целое32 высота = прочитать_целое32(буфер_высоты, 0);
    текст область = выделить_память(16);
    записать_целое32(область, 0, х);
    записать_целое32(область, 4, у);
    записать_целое32(область, 8, ширина / целое32(к));
    записать_целое32(область, 12, высота / целое32(к));
    целое32 итог = показать_текстуру(холст, текстура, нулевой_указатель(), область);
    освободить_поверхность(поверхность);
    уничтожить_текстуру(текстура);
    освободить_память(буфер_ширины);
    освободить_память(буфер_высоты);
    освободить_память(область);
    вернуть итог;
конец

функция ширина_строки(текст шрифт, текст строка): целое
    если (длина(строка) == 0)
        вернуть 0;
    конец
    текст бш = выделить_память(8);
    текст бв = выделить_память(8);
    узнать_размер_строки(шрифт, строка, бш, бв);
    целое ш = целое(прочитать_целое32(бш, 0));
    ш = (ш + плотность() - 1) / плотность();
    освободить_память(бш);
    освободить_память(бв);
    вернуть ш;
конец

// Обрезает строку справа, добавляя «…».
функция вписать_справа(текст шрифт, текст строка, целое максимум): текст
    если (ширина_строки(шрифт, строка) не больше максимум)
        вернуть строка;
    конец
    текст с = строка;
    пока (длина(с) больше 1 и ширина_строки(шрифт, с + "…") больше максимум)
        с = удалить_последний_символ(с);
    конец
    вернуть с + "…";
конец

// Обрезает строку слева: «…конец/пути» — для путей важнее хвост.
функция вписать_слева(текст шрифт, текст строка, целое максимум): текст
    если (ширина_строки(шрифт, строка) не больше максимум)
        вернуть строка;
    конец
    целое начало = 0;
    пока (начало < длина(строка) - 1)
        начало = начало + длина_символа(строка, начало);
        результат из текст р = подстрока(строка, начало, длина(строка) - начало);
        если (р.успешно)
            текст кандидат = "…" + р.значение;
            если (ширина_строки(шрифт, кандидат) не больше максимум)
                вернуть кандидат;
            конец
        конец
    конец
    вернуть "…";
конец

функция цвет_текста(целое р, целое з, целое с): беззнак32
    вернуть беззнак32(4278190080 + с * 65536 + з * 256 + р);
конец

функция залить(текст холст, целое х, целое у, целое ш, целое выс, целое р, целое з, целое с, целое а): целое
    задать_цвет(холст, беззнак8(р), беззнак8(з), беззнак8(с), беззнак8(а));
    нарисовать_прямоугольник(холст, ц32(х), ц32(у), ц32(ш), ц32(выс));
