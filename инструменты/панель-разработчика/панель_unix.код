функция окончивается_на(текст строка, текст хвост): верно
    если (длина(строка) меньше длина(хвост))
        вернуть нет;
    конец
    результат из текст позиция_конца = подстрока(строка, длина(строка) - длина(хвост), длина(хвост));
    если (позиция_конца.успешно)
        вернуть позиция_конца.значение == хвост;
    конец
    вернуть нет;
