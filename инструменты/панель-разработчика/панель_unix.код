// Находит позицию ПОСЛЕДНЕГО вхождения "искомое" в "строка" — "найти"
// (встроенная) даёт только первое, а для разбора пути (взять папку, в
// которой лежит .exe) нужен именно последний разделитель. Простой
// ручной перебор с конца, тем же приёмом, что и остальной файл уже
// использует для посимвольного разбора (см. разобрать_пакеты выше).
функция найти_последнее(текст строка, текст искомое): результат из целое
    целое длина_искомого = длина(искомое);
    если (длина_искомого == 0 или длина(строка) меньше длина_искомого)
        вернуть ошибка("не найдено");
    конец
    целое индекс = длина(строка) - длина_искомого;
    пока (индекс не меньше 0)
        результат из текст кусок = подстрока(строка, индекс, длина_искомого);
        если (кусок.успешно и кусок.значение == искомое)
            вернуть успех(индекс);
        конец
        индекс = индекс - 1;
    конец
    вернуть ошибка("не найдено");
конец

