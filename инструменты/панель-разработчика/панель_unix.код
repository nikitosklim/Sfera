функция кодировать_путь(текст путь): текст
    текст цифры = "0123456789ABCDEF";
    текст процент = знак_процента();
    текст итог = "";
    целое i = 0;
    пока (i меньше длина(путь))
        целое з = целое(байт_текста(путь, i));
        верно простой = (з >= 48 и з <= 57) или (з >= 65 и з <= 90) или (з >= 97 и з <= 122) или з == 45 или з == 95 или з == 46 или з == 47;
        результат из текст символ = подстрока(путь, i, 1);
        если (простой и символ.успешно)
            итог = итог + символ.значение;
        иначе
            результат из текст старшая = подстрока(цифры, з / 16, 1);
            результат из текст младшая = подстрока(цифры, з % 16, 1);
            если (старшая.успешно и младшая.успешно)
                итог = итог + процент + старшая.значение + младшая.значение;
            конец
        конец
        i = i + 1;
    конец
    вернуть итог;
конец

функция тело_материалов(): текст
