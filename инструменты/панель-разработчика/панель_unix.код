            иначе если (тип_события == целое32(1024))
                с.мышь_х = целое(прочитать_целое32(буфер_события, 20));
                с.мышь_у = целое(прочитать_целое32(буфер_события, 24));
            иначе если (тип_события == целое32(1025))
                с.мышь_х = целое(прочитать_целое32(буфер_события, 20));
                с.мышь_у = целое(прочитать_целое32(буфер_события, 24));
                с.нажатый = зона_в_точке(с, с.мышь_х, с.мышь_у);
            иначе если (тип_события == целое32(1026))
                с.мышь_х = целое(прочитать_целое32(буфер_события, 20));
                с.мышь_у = целое(прочитать_целое32(буфер_события, 24));
                целое куда = зона_в_точке(с, с.мышь_х, с.мышь_у);
                целое было = с.нажатый;
                с.нажатый = 0;
                если (было больше 0 и было == куда)
                    обработать_нажатие(с, было, имена_пакетов);
                иначе если (было == 0 и куда == 0 и с.диалог == 0)
                    с.в_фокусе = нет;
                конец
            иначе если (тип_события == целое32(1027))
                целое dy = целое(прочитать_целое32(буфер_события, 20));
                если (dy больше 0)
                    с.колесо = с.колесо - 1;
                иначе если (dy меньше 0)
                    с.колесо = с.колесо + 1;
                конец
            иначе если (тип_события == целое32(771))
                текст кусок = прочитать_текст_по_смещению(буфер_события, 12);
                если (с.диалог больше 4 и с.фокус_диалога)
                    с.папка_пакета = с.папка_пакета + кусок;
                иначе если (с.в_фокусе и с.диалог == 0)
                    с.поле_пути = с.поле_пути + кусок;
                иначе если (с.фокус_формы больше 0 и с.диалог == 0)
                    поле_формы_добавить(с, кусок);
                конец
            иначе если (тип_события == целое32(768))
                целое32 клавиша = прочитать_целое32(буфер_события, 20);
                целое модиф = целое(прочитать_целое32(буфер_события, 24));
                если (с.диалог больше 0)
                    если (клавиша == целое32(27))
                        обработать_нажатие(с, 901, имена_пакетов);
                    иначе если (клавиша == целое32(13))
                        обработать_нажатие(с, 900, имена_пакетов);
                    иначе если (с.диалог больше 4 и с.фокус_диалога)
                        если (клавиша == целое32(8))
                            с.папка_пакета = удалить_последний_символ(с.папка_пакета);
                        иначе если (клавиша == целое32(118) и (наложить_маску(целое32(модиф), целое32(960))) != целое32(0))
                            с.папка_пакета = с.папка_пакета + взять_буфер_обмена();
                        конец
                    конец
                иначе если (с.фокус_формы больше 0)
                    если (клавиша == целое32(8))
                        поле_формы_стереть(с);
                    иначе если (клавиша == целое32(13))
                        отправить_форму(с);
                    иначе если (клавиша == целое32(9))
                        целое макс_поле = 2;
                        если (с.режим_входа == 1)
                            макс_поле = 3;
                        конец
                        с.фокус_формы = с.фокус_формы % макс_поле + 1;
                    иначе если (клавиша == целое32(27))
