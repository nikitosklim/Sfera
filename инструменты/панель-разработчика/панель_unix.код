                применить_путь(с);
            конец
        конец
        вернуть 0;
    конец

    если (код == 0 - 1)
        открыть_диалог(с, 3, 1, "Слишком долго", "Задача не завершилась за отведённое время. Возможно, нет интернета или команда зависла.");
