// Обновление самой панели: скачать архив с сайта, распаковать и заменить файлы.
// Не проверялось на реальных macOS и Linux-сборках — см. README панели.
функция тело_обновления_панели(текст адрес): текст
    текст д = "$";
    текст э = д + "PANEL_DIR";
    текст б = определить_папку_панели();
    б = б + "T=\"" + д + "(mktemp -d)\"\n";
    б = б + с_проверкой("curl -fsSL --max-time 600 -o \"" + д + "T/пакет\" '" + адрес + "'");
    б = б + "mkdir \"" + д + "T/файлы\"\n";
    б = б + "case '" + адрес + "' in\n";
    б = б + "  *.zip) unzip -q \"" + д + "T/пакет\" -d \"" + д + "T/файлы\" || exit 1 ;;\n";
    б = б + "  *) tar -xf \"" + д + "T/пакет\" -C \"" + д + "T/файлы\" || exit 1 ;;\n";
    б = б + "esac\n";
    // macOS: внутри лежит приложение .app — заменяем его целиком.
    б = б + "APP=\"" + д + "(find \"" + д + "T/файлы\" -maxdepth 2 -name '*.app' | head -n 1)\"\n";
    б = б + "if [ -n \"" + д + "APP\" ]; then\n";
    б = б + "  OLD=\"" + д + "(cd \"" + э + "/../..\" 2>/dev/null && pwd)\"\n";
    б = б + "  case \"" + д + "OLD\" in *.app) rm -rf \"" + д + "OLD\" && cp -R \"" + д + "APP\" \"" + д + "OLD\" || exit 1 ;; *) echo 'Не найдено приложение для замены'; exit 1 ;; esac\n";
    б = б + "else\n";
    б = б + "  SRC=\"" + д + "T/файлы\"\n";
    б = б + "  if [ " + д + "(ls \"" + д + "SRC\" | wc -l) -eq 1 ] && [ -d \"" + д + "SRC/" + д + "(ls \"" + д + "SRC\")\" ]; then SRC=\"" + д + "SRC/" + д + "(ls \"" + д + "SRC\")\"; fi\n";
    б = б + "  rm -f \"" + э + "/Sfera-Panel\" \"" + э + "/панель_unix\" 2>/dev/null\n";
    б = б + "  cp -Rf \"" + д + "SRC/.\" \"" + э + "/\" || exit 1\n";
    б = б + "fi\n";
    б = б + "rm -rf \"" + д + "T\"\n";
    б = б + "echo 'Панель обновлена'\n";
    вернуть б;
конец

