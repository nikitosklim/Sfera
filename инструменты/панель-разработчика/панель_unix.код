// Одно сжатие SHA-256: h — 8 слов состояния, блок — 16 слов.
функция сжать(текст h, текст w, текст k, текст блок): целое
    целое i = 0;
    пока (i меньше 16)
        положить(w, i, слово(блок, i));
        i = i + 1;
    конец
    пока (i меньше 64)
        беззнак32 а15 = слово(w, i - 15);
        беззнак32 а2 = слово(w, i - 2);
        беззнак32 с0 = переключить_биты(переключить_биты(вращать(а15, 7), вращать(а15, 18)), сдвинуть_вправо(а15, беззнак32(3)));
        беззнак32 с1 = переключить_биты(переключить_биты(вращать(а2, 17), вращать(а2, 19)), сдвинуть_вправо(а2, беззнак32(10)));
        положить(w, i, слово(w, i - 16) + с0 + слово(w, i - 7) + с1);
        i = i + 1;
    конец
    беззнак32 а = слово(h, 0);
    беззнак32 б = слово(h, 1);
    беззнак32 с = слово(h, 2);
    беззнак32 д = слово(h, 3);
    беззнак32 е = слово(h, 4);
    беззнак32 ф = слово(h, 5);
    беззнак32 г = слово(h, 6);
    беззнак32 з = слово(h, 7);
    i = 0;
    пока (i меньше 64)
        беззнак32 с1 = переключить_биты(переключить_биты(вращать(е, 6), вращать(е, 11)), вращать(е, 25));
        беззнак32 выбор = переключить_биты(наложить_маску(е, ф), наложить_маску(инвертировать_биты(е), г));
        беззнак32 т1 = з + с1 + выбор + слово(k, i) + слово(w, i);
        беззнак32 с0 = переключить_биты(переключить_биты(вращать(а, 2), вращать(а, 13)), вращать(а, 22));
        беззнак32 большинство = переключить_биты(переключить_биты(наложить_маску(а, б), наложить_маску(а, с)), наложить_маску(б, с));
        беззнак32 т2 = с0 + большинство;
        з = г;
        г = ф;
        ф = е;
        е = д + т1;
        д = с;
        с = б;
        б = а;
        а = т1 + т2;
        i = i + 1;
    конец
    положить(h, 0, слово(h, 0) + а);
    положить(h, 1, слово(h, 1) + б);
    положить(h, 2, слово(h, 2) + с);
    положить(h, 3, слово(h, 3) + д);
    положить(h, 4, слово(h, 4) + е);
    положить(h, 5, слово(h, 5) + ф);
    положить(h, 6, слово(h, 6) + г);
    положить(h, 7, слово(h, 7) + з);
    вернуть 0;
конец

// 16 слов блока из 64 байт (старший байт первым).
функция слова_из_байт(текст блок, текст байты, целое с_позиции): целое
    целое i = 0;
    пока (i меньше 16)
        целое о = с_позиции + i * 4;
        беззнак32 а = беззнак32(целое(байт_текста(байты, о)));
        беззнак32 б = беззнак32(целое(байт_текста(байты, о + 1)));
        беззнак32 в1 = беззнак32(целое(байт_текста(байты, о + 2)));
        беззнак32 г = беззнак32(целое(байт_текста(байты, о + 3)));
        положить(блок, i, включить_биты(включить_биты(сдвинуть_влево(а, беззнак32(24)), сдвинуть_влево(б, беззнак32(16))), включить_биты(сдвинуть_влево(в1, беззнак32(8)), г)));
        i = i + 1;
    конец
    вернуть 0;
конец

// Дописывает в состояние h сообщение из n байт (после уже обработанных "префикс" байт) с дополнением SHA-256.
функция хеш_сообщения(текст h, текст w, текст k, текст байты, целое n, целое префикс): целое
    текст блок = выделить_память(64);
    целое позиция = 0;
    пока (n - позиция не меньше 64)
        слова_из_байт(блок, байты, позиция);
        сжать(h, w, k, блок);
        позиция = позиция + 64;
    конец
    текст хвост = выделить_память(128);
    целое j = 0;
    пока (j меньше 128)
        записать_байт(хвост, j, 0);
        j = j + 1;
    конец
    j = 0;
    пока (позиция + j меньше n)
        записать_байт(хвост, j, целое(байт_текста(байты, позиция + j)));
        j = j + 1;
    конец
    записать_байт(хвост, j, 128);
    целое всего_блоков = 1;
    если (j + 1 больше 56)
        всего_блоков = 2;
    конец
    целое биты = (префикс + n) * 8;
    целое конец_хвоста = всего_блоков * 64;
    записать_байт(хвост, конец_хвоста - 4, (биты / 16777216) % 256);
    записать_байт(хвост, конец_хвоста - 3, (биты / 65536) % 256);
    записать_байт(хвост, конец_хвоста - 2, (биты / 256) % 256);
    записать_байт(хвост, конец_хвоста - 1, биты % 256);
    слова_из_байт(блок, хвост, 0);
    сжать(h, w, k, блок);
    если (всего_блоков == 2)
        слова_из_байт(блок, хвост, 64);
        сжать(h, w, k, блок);
    конец
    освободить_память(блок);
    освободить_память(хвост);
    вернуть 0;
конец

функция слово_в_hex(беззнак32 х): текст
    текст цифры = "0123456789abcdef";
    текст итог = "";
    целое сдвиг = 28;
    пока (сдвиг не меньше 0)
        целое ц = целое(наложить_маску(сдвинуть_вправо(х, беззнак32(сдвиг)), беззнак32(15)));
        результат из текст с = подстрока(цифры, ц, 1);
        если (с.успешно)
            итог = итог + с.значение;
        конец
        сдвиг = сдвиг - 4;
    конец
    вернуть итог;
конец

// Один блок с хвостом «32 байта + 0x80 + длина 768 бит» (внутренний/внешний шаг HMAC при пароле ≤ 64 байт).
функция блок_хеша(текст блок, текст слова8): целое
    копия_слов(блок, слова8, 8);
    положить(блок, 8, беззнак32(2147483648));
    положить(блок, 9, беззнак32(0));
    положить(блок, 10, беззнак32(0));
    положить(блок, 11, беззнак32(0));
    положить(блок, 12, беззнак32(0));
    положить(блок, 13, беззнак32(0));
    положить(блок, 14, беззнак32(0));
    положить(блок, 15, беззнак32(768));
    вернуть 0;
конец

// PBKDF2-HMAC-SHA256, 1 блок (32 байта), результат — 64 hex-символа. Как в браузере сайта.
функция pbkdf2_sha256(текст пароль, текст соль, целое итераций): текст
    текст k = таблица_k();
    текст w = выделить_память(256);
    текст ключ = выделить_память(64);
    целое j = 0;
    пока (j меньше 64)
        записать_байт(ключ, j, 0);
        j = j + 1;
    конец
    если (длина(пароль) больше 64)
        текст hк = выделить_память(32);
        начальное_состояние(hк);
        хеш_сообщения(hк, w, k, пароль, длина(пароль), 0);
        j = 0;
        пока (j меньше 8)
            беззнак32 х = слово(hк, j);
            записать_байт(ключ, j * 4, целое(сдвинуть_вправо(х, беззнак32(24))));
            записать_байт(ключ, j * 4 + 1, целое(наложить_маску(сдвинуть_вправо(х, беззнак32(16)), беззнак32(255))));
            записать_байт(ключ, j * 4 + 2, целое(наложить_маску(сдвинуть_вправо(х, беззнак32(8)), беззнак32(255))));
            записать_байт(ключ, j * 4 + 3, целое(наложить_маску(х, беззнак32(255))));
            j = j + 1;
        конец
        освободить_память(hк);
    иначе
        j = 0;
        пока (j меньше длина(пароль))
            записать_байт(ключ, j, целое(байт_текста(пароль, j)));
            j = j + 1;
        конец
    конец
    текст пад = выделить_память(64);
    текст блок = выделить_память(64);
    текст внутр = выделить_память(32);
    текст внеш = выделить_память(32);
    текст ток = выделить_память(32);
    текст цепь = выделить_память(32);
    текст итог = выделить_память(32);
    текст запись = выделить_память(32);
    j = 0;
    пока (j меньше 64)
        записать_байт(пад, j, переключить_биты(целое(байт_текста(ключ, j)), 54));
        j = j + 1;
    конец
    начальное_состояние(внутр);
    слова_из_байт(блок, пад, 0);
    сжать(внутр, w, k, блок);
    j = 0;
    пока (j меньше 64)
        записать_байт(пад, j, переключить_биты(целое(байт_текста(ключ, j)), 92));
        j = j + 1;
    конец
    начальное_состояние(внеш);
    слова_из_байт(блок, пад, 0);
    сжать(внеш, w, k, блок);
    // U1 = HMAC(пароль, соль || 00000001)
    целое n = длина(соль);
    текст сообщение = выделить_память(n + 4);
    j = 0;
    пока (j меньше n)
        записать_байт(сообщение, j, целое(байт_текста(соль, j)));
        j = j + 1;
    конец
    записать_байт(сообщение, n, 0);
    записать_байт(сообщение, n + 1, 0);
    записать_байт(сообщение, n + 2, 0);
    записать_байт(сообщение, n + 3, 1);
    копия_слов(цепь, внутр, 8);
    хеш_сообщения(цепь, w, k, сообщение, n + 4, 64);
    блок_хеша(блок, цепь);
    копия_слов(запись, внеш, 8);
    сжать(запись, w, k, блок);
    копия_слов(ток, запись, 8);
    копия_слов(итог, запись, 8);
    целое круг = 1;
    пока (круг меньше итераций)
        блок_хеша(блок, ток);
        копия_слов(цепь, внутр, 8);
        сжать(цепь, w, k, блок);
