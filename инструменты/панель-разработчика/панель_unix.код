// Последние «сколько» строк текста — для окна вывода.
функция последние_строки(текст исходный, целое сколько): текст
    Список из текстов строки = Список из текстов();
    текст остаток = исходный;
    пока (длина(остаток) больше 0)
        результат из целое позиция = найти(остаток, "\n");
        если ( не позиция.успешно)
            строки.добавить(остаток);
            остаток = "";
        иначе
            результат из текст часть = подстрока(остаток, 0, позиция.значение);
            если (часть.успешно)
                строки.добавить(часть.значение);
            конец
            результат из текст хвост = подстрока(остаток, позиция.значение + 1, длина(остаток) - позиция.значение - 1);
            если (хвост.успешно)
                остаток = хвост.значение;
            иначе
                остаток = "";
            конец
        конец
    конец
    целое с = 0;
    если (строки.размер() > сколько)
        с = строки.размер() - сколько;
    конец
    текст итог = "";
    пока (с меньше строки.размер())
        текст одна = строки.получить(с);
        итог = итог + обрезать_символы(одна, 62) + "\n";
        с = с + 1;
    конец
    строки.освободить();
    вернуть итог;
конец
