// --- Работа с текстом ---

// Длина UTF-8 символа в байтах по его первому байту.
функция длина_символа(текст строка, целое индекс): целое
    целое32 б = байт_текста(строка, индекс);
    если ((наложить_маску(б, целое32(128))) == целое32(0))
        вернуть 1;
    конец
    если ((наложить_маску(б, целое32(224))) == целое32(192))
        вернуть 2;
    конец
    если ((наложить_маску(б, целое32(240))) == целое32(224))
        вернуть 3;
    конец
    вернуть 4;
конец

// Убирает пробелы, переводы строк и BOM (EF BB BF) с обоих концов.
функция обрезать_края(текст исходный): текст
    целое начало = 0;
    целое позиция_конца = длина(исходный);
    верно идти = да;
    пока (идти и начало меньше позиция_конца)
        целое32 б = байт_текста(исходный, начало);
        если (б == целое32(32) или б == целое32(13) или б == целое32(10) или б == целое32(9) или б == целое32(239) или б == целое32(187) или б == целое32(191))
            начало = начало + 1;
        иначе
            идти = нет;
        конец
    конец
    идти = да;
    пока (идти и позиция_конца больше начало)
        целое32 б = байт_текста(исходный, позиция_конца - 1);
        если (б == целое32(32) или б == целое32(13) или б == целое32(10) или б == целое32(9))
            позиция_конца = позиция_конца - 1;
        иначе
            идти = нет;
        конец
    конец
    результат из текст часть = подстрока(исходный, начало, позиция_конца - начало);
    если (часть.успешно)
        вернуть часть.значение;
    конец
    вернуть "";
конец

// Всё до первого управляющего символа (перевод строки, возврат каретки,
// нулевой байт и т. п.): выбор папки возвращает путь одной строкой, всё, что
// идёт после него, — мусор, который ломает командный файл установки.
функция первая_строка(текст исходный): текст
    целое позиция = 0;
    верно идти = да;
    пока (идти и позиция меньше длина(исходный))
        целое32 б = байт_текста(исходный, позиция);
        если (б меньше целое32(32) и б больше целое32(0 - 1))
            идти = нет;
        иначе
            позиция = позиция + 1;
        конец
    конец
    результат из текст часть = подстрока(исходный, 0, позиция);
    если (часть.успешно)
        вернуть часть.значение;
    конец
    вернуть "";
конец

// Все переводы строк — в пробелы (подряд идущие схлопываются).
функция в_одну_строку(текст исходный): текст
    текст итог = "";
    целое индекс = 0;
    верно прошлый_пробел = нет;
    пока (индекс меньше длина(исходный))
        целое32 б = байт_текста(исходный, индекс);
        если (б == целое32(13) или б == целое32(10) или б == целое32(32))
            если ( не прошлый_пробел)
                итог = итог + " ";
            конец
            прошлый_пробел = да;
            индекс = индекс + 1;
        иначе
            целое л = длина_символа(исходный, индекс);
            результат из текст символ = подстрока(исходный, индекс, л);
            если (символ.успешно)
                итог = итог + символ.значение;
            конец
            прошлый_пробел = нет;
            индекс = индекс + л;
        конец
    конец
    вернуть итог;
конец

// Оставляет не больше "максимум" СИМВОЛОВ (не байт), добавляя "…".
функция обрезать_символы(текст исходный, целое максимум): текст
    целое индекс = 0;
    целое символов = 0;
    пока (индекс меньше длина(исходный) и символов меньше максимум)
        индекс = индекс + длина_символа(исходный, индекс);
        символов = символов + 1;
    конец
    если (индекс не меньше длина(исходный))
        вернуть исходный;
    конец
    результат из текст часть = подстрока(исходный, 0, индекс);
    если (часть.успешно)
        вернуть часть.значение + "…";
    конец
    вернуть исходный;
конец

// Переносит текст по "ширина" символов (по пробелу, если он близко, иначе
// жёстко) — нужно для длинных путей и текста ошибок в диалогах.
функция перенести_текст(текст исходный, целое ширина): текст
    текст итог = "";
    целое индекс = 0;
    целое в_строке = 0;
    пока (индекс меньше длина(исходный))
        целое32 б = байт_текста(исходный, индекс);
        если (б == целое32(10))
            итог = итог + "\n";
            в_строке = 0;
            индекс = индекс + 1;
        иначе если (б == целое32(32) и в_строке не меньше ширина - 8)
            итог = итог + "\n";
            в_строке = 0;
            индекс = индекс + 1;
        иначе
            если (в_строке не меньше ширина)
                итог = итог + "\n";
                в_строке = 0;
            конец
            целое л = длина_символа(исходный, индекс);
            результат из текст символ = подстрока(исходный, индекс, л);
            если (символ.успешно)
                итог = итог + символ.значение;
            конец
            в_строке = в_строке + 1;
            индекс = индекс + л;
        конец
    конец
    вернуть итог;
конец

// Содержимое лога последней задачи — одной короткой строкой для диалога.
функция текст_лога_кратко(): текст
    результат из текст лог = прочитать_файл(файл_задачи("log"));
    если (лог.успешно)
        текст чистый = в_одну_строку(обрезать_края(лог.значение));
        если (длина(чистый) больше 0)
            вернуть обрезать_символы(чистый, 190);
        конец
    конец
    вернуть "Подробностей нет.";
конец

