// Многострочный текст мелким шрифтом, шаг 18 пикселей.
функция нарисовать_многострочный_текст_малый(текст холст, текст шрифт, текст содержимое, целое х, целое у): целое
    текст остаток = содержимое;
    целое ту = у;
    целое n = 0;
    пока (длина(остаток) больше 0 и n меньше 40)
        результат из целое п = найти(остаток, "\n");
        если (п.успешно)
            результат из текст стр = подстрока(остаток, 0, п.значение);
            если (стр.успешно)
                текст_в(холст, шрифт, стр.значение, х, ту, цвет_текста(223, 233, 255));
            конец
            результат из текст хв = подстрока(остаток, п.значение + 1, длина(остаток) - п.значение - 1);
            если (хв.успешно)
                остаток = хв.значение;
            иначе
                остаток = "";
            конец
        иначе
            текст_в(холст, шрифт, остаток, х, ту, цвет_текста(223, 233, 255));
            остаток = "";
        конец
        ту = ту + 18;
        n = n + 1;
    конец
    вернуть n;
конец

