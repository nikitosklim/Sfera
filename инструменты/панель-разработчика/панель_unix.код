    вернуть домашняя_папка() + "/.sfera-panel-cookies.txt";
конец

функция адрес_аккаунта(текст действие): текст
    вернуть адрес_сервера() + "/" + кодировать_адрес("аккаунт") + "/" + кодировать_адрес(действие);
конец

функция запустить_акк(Состояние с, целое вид, текст тело): верно
    если ( не запустить_в_слоте(3, тело))
        вернуть нет;
    конец
    с.акк_задача = вид;
    вернуть да;
конец

функция запрос_аккаунта(текст ключи, текст действие, текст данные, текст файл_ответа): текст
    текст б = "curl -sS --max-time 30 " + ключи + " -b '" + файл_куки() + "' -c '" + файл_куки() + "' -H 'X-Sfera: 1' ";
    если (длина(данные) больше 0)
        б = б + "-d '" + данные + "' ";
    конец
    б = б + "-o '" + файл_ответа + "' '" + адрес_аккаунта(действие) + "'";
    вернуть с_проверкой(б) + "chmod 600 '" + файл_куки() + "' 2>/dev/null\ntrue\n";
конец

функция тело_кто_я(): текст
    вернуть запрос_аккаунта("", "я", "", файл_слота(3, "json"));
конец

функция тело_моих_пакетов(): текст
    вернуть запрос_аккаунта("", "мои-пакеты", "", файл_слота(3, "txt"));
конец

функция тело_входа(текст действие, текст ник_закодированный, текст хеш): текст
    вернуть запрос_аккаунта("", действие, "имя=" + ник_закодированный + "&пароль=" + хеш, файл_слота(3, "json"));
конец

функция тело_выхода(): текст
    текст б = запрос_аккаунта("-X POST", "выход", "", файл_слота(3, "json"));
    вернуть б + "rm -f '" + файл_куки() + "'\n";
конец

// Достаёт токен автора с сайта и сохраняет его для сфера_пакеты.
функция тело_подключения_публикации(текст сфера): текст
    текст д = "$";
    текст б = "T=" + д + "(curl -fsS --max-time 20 -b '" + файл_куки() + "' -H 'X-Sfera: 1' '" + адрес_аккаунта("токен") + "' | grep -o '\"токен\":\"[^\"]*\"' | cut -d'\"' -f4)\n";
    б = б + "if [ -z \"" + д + "T\" ]; then echo 'Токен не получен: войди в аккаунт'; exit 1; fi\n";
    б = б + с_проверкой("'" + путь_установленного_сфера_пакеты(сфера) + "' войти \"" + д + "T\"");
    вернуть б;
конец

функция json_поле(текст json, текст имя): текст
    результат из текст р = извлечь_json_строковое_поле(json, имя);
    если (р.успешно)
        вернуть р.значение;
    конец
    вернуть "";
конец

// Нижний регистр для латиницы и кириллицы (как toLowerCase в браузере — пароль солится именем).
функция в_нижний(текст строка): текст
    текст верх_лат = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    текст низ_лат = "abcdefghijklmnopqrstuvwxyz";
    текст верх_кир = "АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ";
    текст низ_кир = "абвгдеёжзийклмнопрстуфхцчшщъыьэюя";
    текст итог = "";
    целое i = 0;
    пока (i меньше длина(строка))
        целое л = длина_символа(строка, i);
        результат из текст символ = подстрока(строка, i, л);
        текст добавить = "";
        если (символ.успешно)
            добавить = символ.значение;
            если (л == 1)
                результат из целое п = найти(верх_лат, символ.значение);
                если (п.успешно)
                    результат из текст н = подстрока(низ_лат, п.значение, 1);
                    если (н.успешно)
                        добавить = н.значение;
                    конец
                конец
            иначе
                результат из целое п2 = найти(верх_кир, символ.значение);
                если (п2.успешно)
                    результат из текст н2 = подстрока(низ_кир, п2.значение, 2);
                    если (н2.успешно)
                        добавить = н2.значение;
                    конец
                конец
            конец
        конец
        итог = итог + добавить;
        i = i + л;
    конец
    вернуть итог;
конец

функция число_символов(текст строка): целое
    целое n = 0;
    целое i = 0;
    пока (i меньше длина(строка))
        i = i + длина_символа(строка, i);
        n = n + 1;
    конец
    вернуть n;
конец

функция точки_пароля(текст строка): текст
    текст итог = "";
    целое n = число_символов(строка);
    целое k = 0;
    пока (k меньше n)
        итог = итог + "•";
        k = k + 1;
    конец
    вернуть итог;
конец

// Мои пакеты из ответа сервера: последняя версия каждого, новые сверху.
функция собрать_мои_пакеты(текст исходный, Список из текст имена, Список из текст версии, Список из текст статусы, Список из текст описания): целое
    Список из текст строки = Список из текст();
    строки_текста(исходный, строки);
    целое k = строки.размер() - 1;
    пока (k не меньше 0)
        Список из текст части = Список из текст();
        разбить_по_полям(строки.получить(k), части);
        если (части.размер() не меньше 3 и не есть_в_списке(имена, части.получить(0)))
            имена.добавить(части.получить(0));
            версии.добавить(части.получить(1));
            статусы.добавить(части.получить(2));
            если (части.размер() больше 3)
                описания.добавить(части.получить(3));
            иначе
                описания.добавить("");
            конец
        конец
        k = k - 1;
    конец
    вернуть имена.размер();
конец

функция запомнить_вход(Состояние с, текст json): целое
    с.вошёл = да;
    с.ник = json_поле(json, "имя");
    с.роль = json_поле(json, "роль");
    с.ошибка_входа = "";
    с.поле_пароля = "";
    с.поле_повтора = "";
    запустить_акк(с, 13, тело_моих_пакетов());
    вернуть 0;
конец

функция завершить_акк(Состояние с, целое код): целое
    целое вид = с.акк_задача;
    с.акк_задача = 0;
    текст json = прочитать_слот(3, "json");
    если (вид == 12)
        если (код == 0 и содержит(json, "\"вошёл\":true"))
            запомнить_вход(с, json);
        иначе
            с.вошёл = нет;
        конец
    иначе если (вид == 13)
        если (код == 0)
            с.мои_пакеты_текст = прочитать_слот(3, "txt");
        конец
    иначе если (вид == 14 или вид == 15)
        если (код == 0 и содержит(json, "\"ok\":true"))
            запомнить_вход(с, json);
            с.статус = "Вы вошли как " + с.ник;
            с.статус_до = с.кадр + 180;
        иначе если (код == 0 и длина(json_поле(json, "ошибка")) больше 0)
            с.ошибка_входа = json_поле(json, "ошибка");
        иначе
            с.ошибка_входа = "Нет связи с сервером. Проверь интернет.";
        конец
    иначе если (вид == 16)
        с.вошёл = нет;
        с.ник = "";
        с.роль = "";
        с.мои_пакеты_текст = "";
        с.статус = "Вы вышли из аккаунта";
        с.статус_до = с.кадр + 180;
    конец
    вернуть 0;
конец

функция отправить_форму(Состояние с): целое
    если (с.акк_задача больше 0)
        вернуть 0;
    конец
    текст имя = обрезать_края(с.поле_ника);
    если (число_символов(имя) меньше 3)
        с.ошибка_входа = "Имя: не короче трёх знаков.";
        вернуть 0;
    конец
    если (число_символов(с.поле_пароля) меньше 8)
        с.ошибка_входа = "Пароль: не короче восьми знаков.";
        вернуть 0;
    конец
    если (с.режим_входа == 1 и с.поле_пароля != с.поле_повтора)
        с.ошибка_входа = "Пароли не совпадают.";
        вернуть 0;
    конец
    // Тот же PBKDF2, что и в браузере на сайте: имя в нижнем регистре служит солью.
    текст хеш = pbkdf2_sha256(с.поле_пароля, "sfera:" + в_нижний(имя), 150000);
    текст действие = "вход";
    целое вид = 14;
    если (с.режим_входа == 1)
        действие = "регистрация";
        вид = 15;
    конец
    с.ошибка_входа = "";
    с.поле_пароля = "";
    с.поле_повтора = "";
    с.фокус_формы = 0;
    запустить_акк(с, вид, тело_входа(действие, кодировать_адрес(имя), хеш));
    вернуть 0;
конец

функция поле_формы_добавить(Состояние с, текст кусок): целое
    если (с.фокус_формы == 1)
        с.поле_ника = с.поле_ника + кусок;
    иначе если (с.фокус_формы == 2)
        с.поле_пароля = с.поле_пароля + кусок;
    иначе если (с.фокус_формы == 3)
        с.поле_повтора = с.поле_повтора + кусок;
    конец
    вернуть 0;
конец

функция поле_формы_стереть(Состояние с): целое
    если (с.фокус_формы == 1)
        с.поле_ника = удалить_последний_символ(с.поле_ника);
    иначе если (с.фокус_формы == 2)
        с.поле_пароля = удалить_последний_символ(с.поле_пароля);
    иначе если (с.фокус_формы == 3)
        с.поле_повтора = удалить_последний_символ(с.поле_повтора);
    конец
    вернуть 0;
конец

