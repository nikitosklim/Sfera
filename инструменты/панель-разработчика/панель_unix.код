    конец
    если (плотность_экрана == 2)
        записать_среду("SFERA_K", "2", 1);
        масштаб_холста(холст, дробное32(2.0), дробное32(2.0));
    конец
    освободить_память(б_вывод_ш);
    освободить_память(б_вывод_в);
    освободить_память(б_окно_ш);
    освободить_память(б_окно_в);
    текст путь_шрифта = выбрать_путь_шрифта();
    текст ш_обычный = открыть_шрифт(путь_шрифта, 14 * плотность_экрана);
