// Первый запуск на macOS из «Загрузок» или с образа диска: предлагает перенести приложение в «Программы».
// Оттуда оно видно в Launchpad, а копии без метки загрузки из интернета (quarantine) открываются без
// запроса подтверждения. Возвращает да, если приложение перенесено и запущено заново: тогда эту копию закрываем.
функция предложить_перенос_в_программы(): верно
    текст д = "$";
    текст метка_переноса = "/tmp/sfera_перенесено.txt";
    выполнить_команду("rm -f '" + метка_переноса + "'");
    текст б = "[ \"" + д + "(uname -s)\" = Darwin ] || exit 0\n";
    б = б + определить_папку_панели();
    б = б + "APP=\"" + д + "(cd \"" + д + "PANEL_DIR/../..\" 2>/dev/null && pwd)\"\n";
    б = б + "case \"" + д + "APP\" in *.app) ;; *) exit 0 ;; esac\n";
    б = б + "case \"" + д + "APP\" in /Applications/*) exit 0 ;; esac\n";
    б = б + "[ -f \"" + д + "HOME/.sfera-не-переносить\" ] && exit 0\n";
    б = б + "R=" + д + "(osascript -e 'button returned of (display dialog \"Переместить «Панель Сферы» в папку «Программы»? Тогда она появится в Launchpad и перестанет просить подтверждение при каждом запуске.\" buttons {\"Не сейчас\", \"Не спрашивать\", \"Переместить\"} default button \"Переместить\" with title \"Сфера\")' 2>/dev/null)\n";
    б = б + "if [ \"" + д + "R\" = \"Не спрашивать\" ]; then touch \"" + д + "HOME/.sfera-не-переносить\"; exit 0; fi\n";
    б = б + "[ \"" + д + "R\" = \"Переместить\" ] || exit 0\n";
    б = б + "DEST='/Applications/Панель Сферы.app'\n";
    б = б + "if rm -rf \"" + д + "DEST\" 2>/dev/null && ditto \"" + д + "APP\" \"" + д + "DEST\" 2>/dev/null; then\n";
    б = б + "  xattr -dr com.apple.quarantine \"" + д + "DEST\" 2>/dev/null\n";
    б = б + "  open \"" + д + "DEST\" && echo 1 > '" + метка_переноса + "'\n";
    б = б + "else\n";
    б = б + "  osascript -e 'display dialog \"Не удалось скопировать в «Программы». Перетащите «Панель Сферы» в папку «Программы» вручную.\" buttons {\"Понятно\"} with title \"Сфера\"' >/dev/null 2>&1\n";
    б = б + "fi\n";
    записать_файл("/tmp/sfera_перенос.sh", б);
    выполнить_команду("sh /tmp/sfera_перенос.sh >/dev/null 2>&1");
    результат из текста итог = прочитать_файл(метка_переноса);
    вернуть итог.успешно;
конец

функция главная(): целое
    записать_среду("SFERA_K", "1", 1);
