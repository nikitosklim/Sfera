функция нарисовать_шапку(Состояние с, текст холст, текст ш_обычный, текст ш_малый, текст ш_крупный, целое х, целое у, целое ш): целое
    текст_в(холст, ш_крупный, "Сфера", х, у, цвет_текста(255, 255, 255));
    текст_в(холст, ш_малый, "v" + текущая_версия(), х + ширина_строки(ш_крупный, "Сфера") + 8, у + 14, цвет_текста(142, 164, 208));
    текст состояние = "не установлена";
    беззнак32 цс = цвет_текста(240, 190, 70);
    если ( не с.применена)
        состояние = "путь не выбран";
    иначе если (с.установлена)
        состояние = "установлена";
        цс = цвет_текста(100, 210, 120);
    конец
    текст_в(холст, ш_малый, состояние, х + ш - ширина_строки(ш_малый, состояние), у + 14, цс);
    вернуть 0;
конец

функция нарисовать_обзор(Состояние с, текст холст, текст ш_обычный, текст ш_малый, текст ш_крупный, целое х, целое у, целое ш): целое
    нарисовать_шапку(с, холст, ш_обычный, ш_малый, ш_крупный, х, у, ш);
    целое строка_у = у + 52;
    текст_в(холст, ш_малый, "Папка установки", х, строка_у, цвет_текста(142, 164, 208));
    строка_у = строка_у + 20;

    // Строка пути: поле, три квадратные кнопки, главная кнопка.
    целое гл_ш = 152;
    целое кв = 32;
    целое поле_ш = ш - гл_ш - кв * 3 - 6 * 4;
    если (поле_ш меньше 120)
        поле_ш = 120;
    конец
    зона(с, 10, х, строка_у, поле_ш, 32);
    целое ф = 40;
    если (с.в_фокусе)
        ф = 54;
    конец
    т_утопленная(холст, х, строка_у, поле_ш, 32, 6, с.в_фокусе);
    текст видимый = с.поле_пути;
    беззнак32 цп = цвет_текста(223, 233, 255);
    если (длина(видимый) == 0)
        видимый = "Укажи папку или нажми «…»";
        цп = цвет_текста(94, 112, 150);
    конец
    если (с.в_фокусе)
        видимый = вписать_слева(ш_обычный, видимый, поле_ш - 24);
        текст_в(холст, ш_обычный, видимый, х + 8, строка_у + 7, цп);
        если ((с.кадр / 15) % 2 == 0)
            залить(холст, х + 9 + ширина_строки(ш_обычный, видимый), строка_у + 7, 2, 18, 223, 233, 255, 255);
        конец
    иначе
        видимый = вписать_слева(ш_обычный, видимый, поле_ш - 16);
        текст_в(холст, ш_обычный, видимый, х + 8, строка_у + 7, цп);
    конец
    если (с.диалог == 0 и с.мышь_х не меньше х и с.мышь_х меньше х + поле_ш и с.мышь_у не меньше строка_у и с.мышь_у меньше строка_у + 32)
        с.подсказка = "Путь, куда ставится Сфера";
    конец

    целое бх = х + поле_ш + 6;
    кнопка_значок(с, холст, ш_обычный, 11, бх, строка_у, кв, 1, 0, да, "Открыть папку в файловом менеджере");
    бх = бх + кв + 6;
    кнопка_значок(с, холст, ш_обычный, 12, бх, строка_у, кв, 2, 0, с.задача == 0, "Выбрать папку в окне системы");
    бх = бх + кв + 6;
    верно изменено = обрезать_края(с.поле_пути) != с.папка или не с.применена;
    кнопка_значок(с, холст, ш_обычный, 13, бх, строка_у, кв, 3, 3, изменено и длина(обрезать_края(с.поле_пути)) больше 0, "Применить путь");
    бх = бх + кв + 6;
    если (с.установлена)
        кнопка_текст(с, холст, ш_обычный, 14, бх, строка_у, гл_ш, 32, "Удалить Сферу", 2, с.задача == 0, "Удалить Сферу с компьютера");
    иначе
        кнопка_текст(с, холст, ш_обычный, 14, бх, строка_у, гл_ш, 32, "Установить Сферу", 1, с.задача == 0 и с.применена, "Установить Сферу по выбранному пути");
    конец
    строка_у = строка_у + 44;

    если (не с.применена)
        текст_в(холст, ш_малый, "Путь не применён: нажми ✓ или выбери папку.", х, строка_у, цвет_текста(240, 190, 70));
        строка_у = строка_у + 24;
    конец

    // Плашка обновления.
    если (с.найдено_обновление)
        т_рамка_градиент(холст, х, строка_у, ш, 40, 6, 9858590, 3419160, 3419160, 3419160, 3419160);
