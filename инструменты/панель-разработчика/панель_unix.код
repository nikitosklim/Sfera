функция команда_добавить_в_path(текст папка_bin): текст
    // Строка экспорта дописывается в ~/.profile и ~/.zshrc один раз.
    текст д = "$";
    текст строка = "export PATH=\"" + папка_bin + ":" + д + "PATH\"";
    текст команда = "for f in \"" + домашняя_папка() + "/.profile\" \"" + домашняя_папка() + "/.zshrc\"; do "
        + "grep -qF '" + папка_bin + "' \"" + д + "f\" 2>/dev/null || echo '" + строка + "' >> \"" + д + "f\"; done";
    вернуть команда;
конец

функция команда_убрать_из_path(текст папка_bin): текст
    текст д = "$";
    вернуть "for f in \"" + домашняя_папка() + "/.profile\" \"" + домашняя_папка() + "/.zshrc\"; do "
        + "if [ -f \"" + д + "f\" ]; then grep -vF '" + папка_bin + "' \"" + д + "f\" > \"" + д + "f.sfera_tmp\"; mv \"" + д + "f.sfera_tmp\" \"" + д + "f\"; fi; done; true";
конец

// Папка, где лежит исполняемый файл панели. Язык отдаёт программе только
// аргументы пользователя (без имени самой программы), поэтому путь
// определяет оболочка: ищет запущенный процесс панели и берёт его путь.
// Результат — в переменной оболочки PANEL_DIR (по умолчанию «.»).
функция определить_папку_панели(): текст
    текст д = "$";
    текст б = "PANEL_DIR=''\n";
    б = б + "for n in Sfera-Panel панель_unix панель_linux; do\n";
    б = б + "  for p in " + д + "(pgrep -x " + д + "n 2>/dev/null); do\n";
    б = б + "    x=" + д + "(readlink \"/proc/" + д + "p/exe\" 2>/dev/null)\n";
    б = б + "    if [ -z \"" + д + "x\" ]; then x=" + д + "(ps -p \"" + д + "p\" -o comm= 2>/dev/null); fi\n";
    б = б + "    if [ -n \"" + д + "x\" ] && [ -z \"" + д + "PANEL_DIR\" ]; then PANEL_DIR=" + д + "(dirname \"" + д + "x\"); fi\n";
    б = б + "  done\n";
    б = б + "done\n";
    б = б + "if [ -z \"" + д + "PANEL_DIR\" ]; then PANEL_DIR='.'; fi\n";
    вернуть б;
конец

функция тело_установки(текст базовая_папка): текст
    текст папка_bin = базовая_папка + "/bin";
    текст папка_share = базовая_папка + "/share";
    текст папка_lib = базовая_папка + "/lib/sfera";
    текст д = "$";
    текст э = д + "PANEL_DIR";
    // Где лежат собранные файлы: рядом с панелью в «bin» (готовый релиз),
    // в «Resources/bin» (приложение macOS), в «target/release» репозитория
    // либо там, куда ставили раньше.
    текст б = определить_папку_панели() + "SRC=''\n";
    б = б + "for d in \"" + э + "/bin\" \"" + э + "/../Resources/bin\" \"" + э + "/target/release\" \"" + э + "/../../target/release\" '/Applications/Панель Сферы.app/Contents/Resources/bin' '" + домашняя_папка() + "/Applications/Панель Сферы.app/Contents/Resources/bin' '" + домашняя_папка() + "/.sfera/bin'; do\n";
    б = б + "  if [ -z \"" + д + "SRC\" ] && [ -f \"" + д + "d/запустить\" ]; then SRC=\"" + д + "d\"; fi\n";
    б = б + "done\n";
    б = б + "if [ -z \"" + д + "SRC\" ]; then echo \"Не найден запустить. Панель запущена из: " + д + "PANEL_DIR\"; exit 1; fi\n";
    б = б + "echo \"Копирую из: " + д + "SRC\"\n";
    б = б + с_проверкой("mkdir -p '" + папка_bin + "' '" + папка_share + "' '" + папка_lib + "'");
    б = б + с_проверкой("cp \"" + д + "SRC/запустить\" '" + папка_bin + "/запустить'");
    б = б + "[ -f \"" + д + "SRC/сфера_lsp\" ] && cp \"" + д + "SRC/сфера_lsp\" '" + папка_bin + "/сфера_lsp'\n";
    б = б + "[ -f \"" + д + "SRC/сфера_пакеты\" ] && cp \"" + д + "SRC/сфера_пакеты\" '" + папка_bin + "/сфера_пакеты'\n";
    б = б + "if [ -f \"" + д + "SRC/привет.код\" ]; then cp \"" + д + "SRC/привет.код\" '" + папка_share + "/привет.код'; elif [ -f \"" + д + "SRC/../../examples/привет.код\" ]; then cp \"" + д + "SRC/../../examples/привет.код\" '" + папка_share + "/привет.код'; fi\n";
    // Стандартная библиотека: компилятор ищет её в «../lib/sfera» рядом с bin.
    б = б + "for l in \"" + д + "SRC/../lib/sfera/стандартная_библиотека\" \"" + д + "SRC/../../стандартная_библиотека\" \"" + э + "/lib/sfera/стандартная_библиотека\"; do\n";
    б = б + "  if [ -d \"" + д + "l\" ]; then rm -rf '" + папка_lib + "/стандартная_библиотека'; cp -r \"" + д + "l\" '" + папка_lib + "/стандартная_библиотека'; break; fi\n";
    б = б + "done\n";
    б = б + "chmod +x '" + папка_bin + "'/*\n";
    б = б + с_проверкой("echo '" + текущая_версия() + "' > '" + папка_share + "/version.txt'");
    б = б + команда_добавить_в_path(папка_bin) + "\n";
    б = б + "echo 'Готово. Откройте НОВЫЙ терминал и выполните: запустить --help'\n";
    вернуть б;
конец

функция тело_документации(): текст
    текст д = "$";
    текст э = д + "PANEL_DIR";
    текст б = определить_папку_панели() + "for f in \"" + э + "/README.md\" \"" + э + "/../Resources/README.md\" \"" + э + "/../../README.md\" 'README.md'; do\n";
    б = б + "  if [ -f \"" + д + "f\" ]; then (open \"" + д + "f\" || xdg-open \"" + д + "f\") >/dev/null 2>&1; exit 0; fi\n";
    б = б + "done\necho 'README.md не найден'\nexit 1\n";
    вернуть б;
