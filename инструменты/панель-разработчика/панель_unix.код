                    иначе если (клавиша == целое32(13))
                        применить_путь(с);
                        с.в_фокусе = нет;
                    иначе если (клавиша == целое32(27))
                        с.в_фокусе = нет;
                    иначе если (клавиша == целое32(118) и (наложить_маску(целое32(модиф), целое32(960))) != целое32(0))
                        с.поле_пути = с.поле_пути + взять_буфер_обмена();
                    конец
                конец
            конец
            есть_событие = опросить_событие(буфер_события);
        конец

        с.кадр = с.кадр + 1;
