            нарисовать_текст(холст, шрифт, "кириллический синтаксис, компиляция в машинный", 170, 77, 4293451996);
            нарисовать_текст(холст, шрифт, "код через LLVM, автоматический подсчёт ссылок (ARC).", 170, 99, 4293451996);
            нарисовать_текст(холст, шрифт, "Полное описание возможностей — в файле README.md", 170, 130, 4293451996);
            нарисовать_текст(холст, шрифт, "в папке проекта.", 170, 152, 4293451996);
            нарисовать_кнопку(холст, шрифт, 170, 300, 260, 50, 60, 160, 60, "Открыть README", ан.получить(15), да);
