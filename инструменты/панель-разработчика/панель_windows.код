        нарисовать_кнопку(холст, шрифт, 288, ку, 136, 42, 70, 78, 100, подпись_слота(1, 2), ан.получить(22), да);
        нарисовать_кнопку(холст, шрифт, 142, ку, 136, 42, 70, 78, 100, подпись_слота(1, 3), ан.получить(23), да);
    } иначе если (с.диалог == 2) {
        нарисовать_кнопку(холст, шрифт, 434, ку, 136, 42, 190, 70, 70, подпись_слота(2, 1), ан.получить(21), да);
        нарисовать_кнопку(холст, шрифт, 288, ку, 136, 42, 70, 78, 100, подпись_слота(2, 2), ан.получить(22), да);
