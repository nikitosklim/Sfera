    нарисовать_текст(холст, шрифт, с.заголовок, ц32(бх + 24), ц32(бу + 18), 4294967295);
    нарисовать_многострочный_текст(холст, шрифт, с.сообщение, ц32(бх + 24), ц32(бу + 66));

    целое ку = бу + 178;
