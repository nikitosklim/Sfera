        нарисовать_прямоугольник(холст, 0, ц32(с.инд_у + 9), 4, 32);
        нарисовать_текст(холст, шрифт, "v" + текущая_версия(), 15, 725, 4286475881);

        если (с.вкладка == 0) {
            нарисовать_текст(холст, шрифт, "Обзор языка Сфера", 170, 20, 4294967295);
            нарисовать_текст(холст, шрифт, "Версия: " + текущая_версия(), 170, 50, 4293451996);
            если (с.установлена) {
                нарисовать_текст(холст, шрифт, "Статус: установлено", 170, 80, 4287421550);
