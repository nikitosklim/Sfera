            нарисовать_кнопку(холст, шрифт, 170, 60, 220, 45, 60, 100, 200, "Обновить список", ан.получить(14), с.задача == 0 && с.установлена);
            если (имена_пакетов.размер() > 0) {
                таблица_пакетов.нарисовать_заголовок(холст, шрифт, заголовки_пакетов);
                целое32 строка_индекс = целое32(0);
                пока (целое(строка_индекс) < имена_пакетов.размер()) {
