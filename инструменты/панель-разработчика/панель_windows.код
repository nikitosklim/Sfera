// Системный диалог выбора папки через PowerShell/.NET FolderBrowserDialog.
// ⚠️ "\$f" в литерале не работает (баг лексера, см. историю файла) — "$"
// собирается отдельным кусочком и приклеивается через "+".
функция тело_выбора_папки() -> текст {
    текст д = "$";
    текст скрипт = "Add-Type -AssemblyName System.Windows.Forms; "
        + д + "f = New-Object System.Windows.Forms.FolderBrowserDialog; "
        + д + "f.Description = 'Выберите папку для установки языка Сфера'; "
        + "if (" + д + "f.ShowDialog() -eq 'OK') { " + д + "f.SelectedPath } else { exit 1 }";
    вернуть с_проверкой("powershell -NoProfile -Command \"" + скрипт + "\"");
}

// --- Работа с текстом ---

// Длина UTF-8 символа в байтах по его первому байту.
функция длина_символа(текст строка, целое индекс) -> целое {
    целое32 б = байт_текста(строка, индекс);
    если ((б & целое32(128)) == целое32(0)) {
        вернуть 1;
    }
    если ((б & целое32(224)) == целое32(192)) {
        вернуть 2;
    }
    если ((б & целое32(240)) == целое32(224)) {
        вернуть 3;
    }
    вернуть 4;
}

// Убирает пробелы, переводы строк и BOM (EF BB BF) с обоих концов.
функция обрезать_края(текст исходный) -> текст {
    целое начало = 0;
    целое конец = длина(исходный);
    верно идти = да;
    пока (идти && начало < конец) {
        целое32 б = байт_текста(исходный, начало);
        если (б == целое32(32) || б == целое32(13) || б == целое32(10) || б == целое32(9) || б == целое32(239) || б == целое32(187) || б == целое32(191)) {
            начало = начало + 1;
        } иначе {
            идти = нет;
        }
    }
    идти = да;
    пока (идти && конец > начало) {
        целое32 б = байт_текста(исходный, конец - 1);
        если (б == целое32(32) || б == целое32(13) || б == целое32(10) || б == целое32(9)) {
            конец = конец - 1;
        } иначе {
            идти = нет;
        }
    }
    результат<текст> часть = подстрока(исходный, начало, конец - начало);
    если (часть.успешно) {
        вернуть часть.значение;
    }
    вернуть "";
}

// Все переводы строк — в пробелы (подряд идущие схлопываются).
функция в_одну_строку(текст исходный) -> текст {
    текст итог = "";
    целое индекс = 0;
    верно прошлый_пробел = нет;
    пока (индекс < длина(исходный)) {
        целое32 б = байт_текста(исходный, индекс);
        если (б == целое32(13) || б == целое32(10) || б == целое32(32)) {
            если (!прошлый_пробел) {
                итог = итог + " ";
            }
            прошлый_пробел = да;
            индекс = индекс + 1;
        } иначе {
            целое л = длина_символа(исходный, индекс);
            результат<текст> символ = подстрока(исходный, индекс, л);
            если (символ.успешно) {
                итог = итог + символ.значение;
            }
            прошлый_пробел = нет;
            индекс = индекс + л;
        }
    }
    вернуть итог;
}

// Оставляет не больше "максимум" СИМВОЛОВ (не байт), добавляя "…".
функция обрезать_символы(текст исходный, целое максимум) -> текст {
    целое индекс = 0;
    целое символов = 0;
    пока (индекс < длина(исходный) && символов < максимум) {
        индекс = индекс + длина_символа(исходный, индекс);
        символов = символов + 1;
    }
    если (индекс >= длина(исходный)) {
        вернуть исходный;
    }
    результат<текст> часть = подстрока(исходный, 0, индекс);
    если (часть.успешно) {
        вернуть часть.значение + "…";
    }
    вернуть исходный;
}

// Переносит текст по "ширина" символов (по пробелу, если он близко, иначе
// жёстко) — нужно для длинных путей и текста ошибок в диалогах.
функция перенести_текст(текст исходный, целое ширина) -> текст {
    текст итог = "";
    целое индекс = 0;
    целое в_строке = 0;
    пока (индекс < длина(исходный)) {
        целое32 б = байт_текста(исходный, индекс);
        если (б == целое32(10)) {
            итог = итог + "\n";
            в_строке = 0;
            индекс = индекс + 1;
        } иначе если (б == целое32(32) && в_строке >= ширина - 8) {
            итог = итог + "\n";
            в_строке = 0;
            индекс = индекс + 1;
        } иначе {
            если (в_строке >= ширина) {
                итог = итог + "\n";
                в_строке = 0;
            }
            целое л = длина_символа(исходный, индекс);
            результат<текст> символ = подстрока(исходный, индекс, л);
            если (символ.успешно) {
                итог = итог + символ.значение;
            }
            в_строке = в_строке + 1;
            индекс = индекс + л;
        }
    }
    вернуть итог;
}

// Содержимое лога последней задачи — одной короткой строкой для диалога.
функция текст_лога_кратко() -> текст {
    результат<текст> лог = прочитать_файл(файл_задачи("log"));
    если (лог.успешно) {
        текст чистый = в_одну_строку(обрезать_края(лог.значение));
        если (длина(чистый) > 0) {
            вернуть обрезать_символы(чистый, 190);
        }
    }
    вернуть "Подробностей нет.";
}

// --- Диалоги ---

функция открыть_диалог(Состояние с, целое вид, целое тон, текст заголовок, текст сообщение) -> целое {
    с.диалог = вид;
    с.тон = тон;
    с.диалог_п = 0;
    с.заголовок = заголовок;
    с.сообщение = перенести_текст(сообщение, 46);
    вернуть 0;
}

функция сообщение_установки(текст папка) -> текст {
    вернуть "Сфера будет установлена в папку:\n" + папка + "\n\nХочешь другое место — нажми «Выбрать папку…».";
}

функция открыть_диалог_установки(Состояние с) -> целое {
    открыть_диалог(с, 1, 0, "Установить Сферу?", сообщение_установки(с.папка));
    вернуть 0;
}

функция подпись_слота(целое вид, целое слот) -> текст {
    если (вид == 1) {
        если (слот == 1) {
            вернуть "Установить";
        } иначе если (слот == 2) {
            вернуть "Выбрать папку…";
        }
        вернуть "Отмена";
    }
    если (вид == 2) {
        если (слот == 1) {
            вернуть "Удалить";
        } иначе если (слот == 2) {
            вернуть "Отмена";
        }
        вернуть "";
    }
    если (вид == 3) {
        если (слот == 1) {
            вернуть "Понятно";
        }
        вернуть "";
    }
    вернуть "";
}

// --- Попадание точки в элементы (единая точка правды для кликов и подсветки) ---

функция внутри(целое х, целое у, целое рх, целое ру, целое рш, целое рв) -> верно {
    вернуть х >= рх && х < рх + рш && у >= ру && у < ру + рв;
}

// 1..3 — вкладки; 10..15 — кнопки вкладок; 21..23 — кнопки диалога.
// 0 — ничего. Пока открыт диалог, работают ТОЛЬКО его кнопки; пока идёт
// задача — только вкладки.
функция элемент_в_точке(целое х, целое у, целое вкладка, целое диалог, верно занято) -> целое {
    если (диалог > 0) {
        если (длина(подпись_слота(диалог, 1)) > 0 && внутри(х, у, 434, 428, 136, 42)) {
            вернуть 21;
        }
        если (длина(подпись_слота(диалог, 2)) > 0 && внутри(х, у, 288, 428, 136, 42)) {
            вернуть 22;
        }
        если (длина(подпись_слота(диалог, 3)) > 0 && внутри(х, у, 142, 428, 136, 42)) {
            вернуть 23;
        }
        вернуть 0;
    }
    если (внутри(х, у, 0, 0, 150, 50)) {
        вернуть 1;
    }
    если (внутри(х, у, 0, 50, 150, 50)) {
        вернуть 2;
    }
    если (внутри(х, у, 0, 100, 150, 50)) {
        вернуть 3;
    }
    если (занято) {
        вернуть 0;
    }
    если (вкладка == 0) {
        если (внутри(х, у, 170, 200, 220, 50)) {
            вернуть 10;
        }
        если (внутри(х, у, 170, 260, 220, 50)) {
            вернуть 11;
        }
        если (внутри(х, у, 170, 320, 220, 50)) {
            вернуть 12;
        }
        если (внутри(х, у, 170, 380, 260, 50)) {
            вернуть 13;
        }
    } иначе если (вкладка == 1) {
        если (внутри(х, у, 170, 60, 220, 45)) {
            вернуть 14;
        }
    } иначе если (вкладка == 2) {
        если (внутри(х, у, 170, 300, 260, 50)) {
            вернуть 15;
        }
    }
    вернуть 0;
}

// --- Действия ---

функция сообщить_что_не_установлена(Состояние с) -> целое {
    открыть_диалог(с, 3, 1, "Сфера не установлена", "По пути\n" + с.папка + "\nСферы нет. Сначала нажми «Установить Сферу» на вкладке «Обзор».");
    вернуть 0;
}

функция начать_задачу_или_ошибка(Состояние с, целое вид, текст тело, текст статус) -> целое {
    если (запустить_задачу(с, вид, тело)) {
        с.статус = статус;
    } иначе {
        открыть_диалог(с, 3, 1, "Не удалось запустить", "Не получилось создать временный файл команды в папке TEMP: " + временная_папка());
    }
    вернуть 0;
}

функция закрыть_диалог(Состояние с) -> целое {
    с.диалог = 0;
    с.диалог_п = 0;
    вернуть 0;
}

функция обработать_нажатие(Состояние с, целое id) -> целое {
    если (id >= 1 && id <= 3) {
        если (с.вкладка != id - 1) {
            с.вкладка = id - 1;
            с.страница_п = 0;
        }
        вернуть 0;
    }

    если (id >= 21 && id <= 23) {
        целое вид = с.диалог;
        закрыть_диалог(с);
        если (вид == 1) {
            если (id == 21) {
                начать_задачу_или_ошибка(с, 2, тело_установки(с.папка), "Устанавливаю в " + с.папка + "...");
            } иначе если (id == 22) {
                начать_задачу_или_ошибка(с, 1, тело_выбора_папки(), "Выбери папку в открывшемся окне...");
            }
        } иначе если (вид == 2) {
            если (id == 21) {
                // Страховка: удаляем только папку, которую создали сами
                // (всегда оканчивается на ".sfera"), а не что попало.
                если (окончивается_на(с.папка, ".sfera")) {
                    начать_задачу_или_ошибка(с, 3, тело_удаления(с.папка), "Удаляю...");
                } иначе {
                    открыть_диалог(с, 3, 1, "Отказано в удалении", "Из осторожности удаляются только папки с именем «.sfera». Путь:\n" + с.папка);
                }
            }
        }
        вернуть 0;
    }

    если (с.задача > 0) {
        вернуть 0;
    }

    если (id == 10) {
        если (с.установлена) {
            открыть_диалог(с, 3, 0, "Сфера уже установлена", "Расположение:\n" + с.папка + "\n\nЧтобы поставить заново, сначала удали текущую установку.");
        } иначе {
            открыть_диалог_установки(с);
        }
    } иначе если (id == 11) {
        если (с.установлена) {
            открыть_диалог(с, 2, 1, "Удалить Сферу?", "Папка будет удалена вместе со всем содержимым:\n" + с.папка);
        } иначе {
            сообщить_что_не_установлена(с);
        }
    } иначе если (id == 12) {
        если (с.установлена) {
            начать_задачу_или_ошибка(с, 4, тело_сборки(с.папка), "Идёт сборка...");
        } иначе {
            сообщить_что_не_установлена(с);
        }
    } иначе если (id == 13) {
        если (с.найдено_обновление) {
            // Не подменяем запущенный .exe самим собой (рискованно) —
            // открываем страницу релиза, пользователь заменяет сам.
            выполнить_команду("start \"\" https://github.com/nikitosklim/Sfera/releases/latest");
            с.статус = "Открыл страницу релиза в браузере — скачай и замени приложение.";
        } иначе {
            начать_задачу_или_ошибка(с, 5, тело_обновлений(), "Проверяю обновления...");
        }
    } иначе если (id == 14) {
        если (с.установлена) {
            начать_задачу_или_ошибка(с, 6, тело_пакетов(с.папка), "Получаю список пакетов...");
        } иначе {
            сообщить_что_не_установлена(с);
        }
    } иначе если (id == 15) {
        начать_задачу_или_ошибка(с, 7, тело_документации(), "Открываю README.md...");
    }
    вернуть 0;
}

функция окончивается_на(текст строка, текст хвост) -> верно {
    если (длина(строка) < длина(хвост)) {
        вернуть нет;
    }
    результат<текст> конец = подстрока(строка, длина(строка) - длина(хвост), длина(хвост));
    если (конец.успешно) {
        вернуть конец.значение == хвост;
    }
    вернуть нет;
}

// Вызывается, когда фоновая задача закончилась. код: 0 — успех, -1 —
// не дождались, иначе — ошибка.
функция завершить_задачу(Состояние с, целое код) -> целое {
    целое вид = с.задача;
    с.задача = 0;
    с.статус = "";

    если (вид == 1) {
        // Выбор папки: код != 0 — пользователь нажал "Отмена".
        если (код == 0) {
            результат<текст> лог = прочитать_файл(файл_задачи("log"));
            если (лог.успешно) {
                текст путь = обрезать_края(лог.значение);
                если (длина(путь) > 0) {
                    с.папка = путь + "\\.sfera";
                    с.установлена = сфера_уже_установлена(с.папка);
                }
            }
        }
        открыть_диалог_установки(с);
        вернуть 0;
    }

    если (код == 0 - 1) {
        открыть_диалог(с, 3, 1, "Слишком долго", "Задача не завершилась за минуту. Возможно, нет интернета или команда зависла.");
        вернуть 0;
    }

    если (вид == 2) {
        с.установлена = сфера_уже_установлена(с.папка);
        если (код == 0 && с.установлена) {
            открыть_диалог(с, 3, 2, "Готово", "Сфера установлена в:\n" + с.папка + "\n\nОткрой НОВОЕ окно PowerShell — там заработает команда «запустить файл.код» из любой папки.");
        } иначе {
            открыть_диалог(с, 3, 1, "Не удалось установить", текст_лога_кратко());
        }
    } иначе если (вид == 3) {
        с.установлена = сфера_уже_установлена(с.папка);
        если (код == 0 && !с.установлена) {
            открыть_диалог(с, 3, 2, "Сфера удалена", "Папка удалена:\n" + с.папка);
        } иначе {
            открыть_диалог(с, 3, 1, "Не удалось удалить", текст_лога_кратко());
        }
    } иначе если (вид == 4) {
        если (код == 0) {
            открыть_диалог(с, 3, 2, "Сборка успешна", "Пример привет.код собран без ошибок.");
        } иначе {
            открыть_диалог(с, 3, 1, "Ошибка сборки", текст_лога_кратко());
        }
    } иначе если (вид == 7) {
        если (код != 0) {
            открыть_диалог(с, 3, 1, "README.md не найден", "Файла README.md нет ни рядом с панелью, ни в папке проекта.");
        }
    } иначе если (вид == 6) {
        если (код == 0) {
            результат<текст> лог = прочитать_файл(файл_задачи("log"));
            если (лог.успешно) {
                с.вывод_пакетов = лог.значение;
                с.пакеты_готовы = да;
            }
        } иначе {
            открыть_диалог(с, 3, 1, "Не удалось получить пакеты", текст_лога_кратко());
        }
    } иначе если (вид == 5) {
        результат<текст> ответ = прочитать_файл(файл_задачи("json"));
        если (код != 0 || !ответ.успешно) {
            открыть_диалог(с, 3, 1, "Нет связи с GitHub", "Не удалось выполнить запрос. Проверь интернет и наличие curl в системе.");
            вернуть 0;
        }
        текст json = ответ.значение;
        результат<текст> тег = извлечь_json_строковое_поле(json, "tag_name");
        если (!тег.успешно) {
            открыть_диалог(с, 3, 1, "Не удалось разобрать ответ", "GitHub вернул ответ без номера версии (возможно, релизов ещё нет).");
            вернуть 0;
        }
        текст версия_с_github = тег.значение;
        если (начинается_с(версия_с_github, "v")) {
            результат<текст> без_v = подстрока(версия_с_github, 1, длина(версия_с_github) - 1);
            если (без_v.успешно) {
                версия_с_github = без_v.значение;
            }
        }
        если (версия_с_github == текущая_версия()) {
            открыть_диалог(с, 3, 2, "Обновлений нет", "У тебя последняя версия: " + текущая_версия());
        } иначе если (!релиз_содержит_сборку_для_платформы(json)) {
            открыть_диалог(с, 3, 0, "Сборки для Windows пока нет", "Вышла версия " + версия_с_github + ", но для " + метка_текущей_платформы() + " её ещё не собрали.");
        } иначе {
            с.найдено_обновление = да;
            с.новая_версия = версия_с_github;
            с.описание_обновления = "Без описания изменений.";
            результат<текст> тело = извлечь_json_строковое_поле(json, "body");
            если (тело.успешно && длина(тело.значение) > 0) {
                с.описание_обновления = разэкранировать_json_текст(тело.значение);
            }
            с.статус = "Доступно обновление " + версия_с_github + "!";
        }
    }
    вернуть 0;
}

// ===========================================================================
// АНИМАЦИИ И ОТРИСОВКА
// ===========================================================================

функция зажать(целое а) -> целое {
    если (а < 0) {
        вернуть 0;
    }
    если (а > 255) {
        вернуть 255;
    }
    вернуть а;
}

функция ц32(целое а) -> целое32 {
    вернуть целое32(а);
}

// Плавно (замедляясь к концу) приближает "текущее" к "цели" — шаг в
// четверть оставшегося пути, но не меньше единицы, чтобы значение
// гарантированно дошло до цели.
функция приблизить(целое текущее, целое цель) -> целое {
    если (текущее == цель) {
        вернуть цель;
    }
    целое разница = цель - текущее;
    целое шаг = разница / 4;
    если (шаг == 0) {
        если (разница > 0) {
            шаг = 1;
        } иначе {
            шаг = 0 - 1;
        }
    }
    вернуть текущее + шаг;
}

// Кнопка с движением: при наведении чуть вырастает и светлеет, при нажатии
// уменьшается и темнеет, под ней — мягкая тень, которая "прижимается".
функция нарисовать_кнопку(текст холст, текст шрифт, целое х, целое у, целое ш, целое выс, целое к, целое з, целое с, текст подпись, Движение д, верно доступна) -> целое {
    целое h = д.наведение;
    целое p = д.нажатие;
    целое рост = h * 3 / 100 - p * 4 / 100;
    целое светлее = h * 40 / 100;
    целое темнее = p * 45 / 100;
    целое кк = к;
    целое зз = з;
    целое сс = с;
    если (!доступна) {
        кк = 66;
        зз = 69;
        сс = 78;
        светлее = 0;
        темнее = 0;
        рост = 0;
    } иначе {
        целое тень_смещение = 4 - p * 3 / 100;
        задать_цвет(холст, 0, 0, 0, беззнак8(55 + h * 35 / 100));
        нарисовать_скруглённый_прямоугольник(холст, ц32(х - рост), ц32(у - рост + тень_смещение), ц32(ш + 2 * рост), ц32(выс + 2 * рост), целое32(10));
    }
    Кнопка тело = Кнопка(ц32(х - рост), ц32(у - рост), ц32(ш + 2 * рост), ц32(выс + 2 * рост),
        беззнак8(зажать(кк + светлее - темнее)), беззнак8(зажать(зз + светлее - темнее)), беззнак8(зажать(сс + светлее - темнее)), подпись);
    тело.нарисовать(холст, шрифт);
    вернуть 0;
}

функция нарисовать_вкладку(текст холст, текст шрифт, целое номер, текст подпись, Движение д, верно активна) -> целое {
    целое у = номер * 50;
    целое h = д.наведение;
    целое p = д.нажатие;
    целое к = 30 + 14 * h / 100 - 6 * p / 100;
    целое з = 30 + 17 * h / 100 - 6 * p / 100;
    целое с = 35 + 23 * h / 100 - 6 * p / 100;
    если (активна) {
        к = 48;
        з = 54;
        с = 72;
    }
    задать_цвет(холст, беззнак8(к), беззнак8(з), беззнак8(с), 255);
    нарисовать_прямоугольник(холст, 0, ц32(у), 150, 50);
    беззнак32 цвет = беззнак32(4289502358);
    если (активна || h > 40) {
        цвет = беззнак32(4294967295);
    }
    нарисовать_текст(холст, шрифт, подпись, ц32(15 + h * 5 / 100 + p * 2 / 100), ц32(у + 16), цвет);
    вернуть 0;
}

функция х_кольца(целое i) -> целое {
    целое к = i % 12;
    если (к == 1 || к == 5) {
        вернуть 6;
    }
    если (к == 2 || к == 4) {
        вернуть 10;
    }
    если (к == 3) {
        вернуть 12;
    }
    если (к == 7 || к == 11) {
        вернуть 0 - 6;
    }
    если (к == 8 || к == 10) {
        вернуть 0 - 10;
    }
    если (к == 9) {
        вернуть 0 - 12;
    }
    вернуть 0;
}

// Крутящийся индикатор загрузки: 12 точек по кругу, у "головы" полная
// яркость, хвост затухает.
функция нарисовать_спиннер(текст холст, целое цх, целое цу, целое кадр) -> целое {
    целое фаза = (кадр / 3) % 12;
    целое k = 0;
    пока (k < 12) {
        целое хвост = (фаза - k + 12) % 12;
        целое альфа = 255 - хвост * 20;
        задать_цвет(холст, 120, 180, 255, беззнак8(альфа));
        нарисовать_прямоугольник(холст, ц32(цх + х_кольца(k) - 2), ц32(цу + х_кольца(k + 9) - 2), 4, 4);
        k = k + 1;
    }
    вернуть 0;
}

// Бегущая полоска сверху области содержимого — видна, пока идёт задача.
функция нарисовать_полоску_загрузки(текст холст, целое кадр) -> целое {
    целое левый = 150 + (кадр * 7) % 710 - 140;
    целое правый = левый + 140;
    если (левый < 150) {
        левый = 150;
    }
    если (правый > 720) {
        правый = 720;
    }
    задать_цвет(холст, 40, 46, 60, 255);
    нарисовать_прямоугольник(холст, 150, 0, 570, 3);
    если (правый > левый) {
        задать_цвет(холст, 120, 180, 255, 255);
        нарисовать_прямоугольник(холст, ц32(левый), 0, ц32(правый - левый), 3);
    }
    вернуть 0;
}

функция нарисовать_диалог(текст холст, текст шрифт, Состояние с, Список<Движение> ан) -> целое {
