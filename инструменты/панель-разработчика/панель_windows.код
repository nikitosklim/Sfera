    нарисовать_прямоугольник(холст, 0, 0, 720, 760);

    целое бх = 130;
    целое бу = 250 + (100 - п) * 24 / 100;
    задать_цвет(холст, 0, 0, 0, 90);
    нарисовать_скруглённый_прямоугольник(холст, ц32(бх - 3), ц32(бу + 2), 466, 246, целое32(14));
    задать_цвет(холст, 90, 100, 125, 255);
    нарисовать_скруглённый_прямоугольник(холст, ц32(бх - 1), ц32(бу - 1), 462, 242, целое32(12));
