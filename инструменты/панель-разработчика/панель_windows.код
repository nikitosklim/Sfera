                    строка_значений.добавить(источники_пакетов.получить(целое(строка_индекс)));
                    строка_значений.добавить(описания_пакетов.получить(целое(строка_индекс)));
                    верно чётная_строка = целое(строка_индекс) % 2 == 0;
