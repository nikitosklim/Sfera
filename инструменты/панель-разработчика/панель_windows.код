// ===========================================================================
// ФОНОВЫЕ ЗАДАЧИ (установка, удаление, сборка, запрос к GitHub, список
// пакетов, выбор папки)
//
// ⚠️ НАЙДЕНО РЕАЛЬНЫМ ЗАПУСКОМ НА WINDOWS (вкладка "Пакеты"): "выполнить_
// команду" передаёт строку в cmd.exe как "cmd /c <строка>". Если строка
// НАЧИНАЕТСЯ с кавычки и содержит ещё кавычки (а у нас так выглядит любой
// запуск exe по пути "C:\Users\...\сфера_пакеты.exe" список > "лог"), cmd
// молча срезает первую и последнюю кавычку — получается бессмыслица, и
// консоль печатает "Синтаксическая ошибка в имени файла, имени папки или
// метке тома." Кроме того, system() передаёт cmd байты UTF-8, а он читает
// их как кодовую страницу OEM (CP866) — кириллица в путях превращается в
// мусор.
//
// Поэтому ни одна "длинная" команда больше не идёт в командную строку
// напрямую: её тело пишется в .bat-файл (первой строкой "chcp 65001" — cmd
// дальше читает файл как UTF-8), а в командную строку попадает лишь
// короткая команда "start "" /B cmd /c call "<файл>"", которая начинается с
// "start", а не с кавычки. Заодно задача идёт В ФОНЕ: окно не замирает, пока
// копируются файлы или идёт запрос к GitHub — панель рисует индикатор
// загрузки и опрашивает файл-метку "готово", в который .bat пишет код
// завершения.
// ===========================================================================

структура Состояние {
    целое вкладка;
    целое диалог;          // 0 — нет; 1 — подтверждение установки; 2 — подтверждение удаления; 3 — сообщение
    целое диалог_п;        // 0..100 — анимация появления диалога
    целое страница_п;      // 0..100 — анимация появления вкладки
    целое тон;             // цвет полосы в диалоге: 0 — инфо, 1 — ошибка, 2 — успех
    целое задача;          // 0 — нет; 1 — выбор папки; 2 — установка; 3 — удаление; 4 — сборка; 5 — обновления; 6 — пакеты
    целое задача_кадр;
    целое нажатый;
    целое мышь_х;
    целое мышь_у;
    целое кадр;
    целое инд_у;
    верно установлена;
    верно найдено_обновление;
    верно продолжать;
    верно пакеты_готовы;
    текст заголовок;
    текст сообщение;
    текст папка;
    текст статус;
    текст новая_версия;
    текст описание_обновления;
    текст вывод_пакетов;
}

структура Движение {
    целое наведение;   // 0..100
    целое нажатие;     // 0..100
}

функция файл_задачи(текст расширение) -> текст {
    вернуть временная_папка() + "\\sfera_task." + расширение;
}

функция с_проверкой(текст команда) -> текст {
    вернуть команда + "\r\nif errorlevel 1 exit /b 1\r\n";
}

// Запускает .bat в фоне. "тело" — строки cmd.exe через "\r\n"; в конце
// .bat сам пишет код завершения в файл-метку.
функция запустить_задачу(Состояние с, целое вид, текст тело) -> верно {
    текст бат = файл_задачи("bat");
    текст лог = файл_задачи("log");
    текст метка = файл_задачи("done");

    // Прежняя метка и лог не должны быть приняты за результат новой задачи.
    выполнить_команду("del /q \"" + метка + "\" \"" + лог + "\" 2>nul");

    текст скрипт = "@echo off\r\n"
        + "chcp 65001 >nul\r\n"
        + "call :main > \"" + лог + "\" 2>&1\r\n"
        + "echo %ERRORLEVEL% > \"" + метка + "\"\r\n"
        + "exit /b 0\r\n"
        + ":main\r\n"
        + тело
        + "exit /b 0\r\n";
    результат<верно> запись = записать_файл(бат, скрипт);
    если (!запись.успешно) {
        вернуть нет;
    }

    результат<целое> запуск = выполнить_команду("start \"\" /B cmd /c call \"" + бат + "\"");
    если (!запуск.успешно) {
        вернуть нет;
    }
    с.задача = вид;
    с.задача_кадр = с.кадр;
    вернуть да;
}

// -2 — задача ещё идёт; иначе код завершения (0 — успех).
функция проверить_метку() -> целое {
    текст путь_метки = файл_задачи("done");
    результат<текст> метка = прочитать_файл(путь_метки);
    если (!метка.успешно) {
        вернуть 0 - 2;
    }
    целое длина_метки = длина(метка.значение);
    если (длина_метки == 0) {
        вернуть 0 - 2;
    }
    если (начинается_с(метка.значение, "0")) {
        вернуть 0;
    }
    вернуть 1;
}

// --- Тексты команд ---

// PowerShell-команда, добавляющая папку в PATH ТЕКУЩЕГО ПОЛЬЗОВАТЕЛЯ (не
// нужны права администратора; идемпотентна — повторная установка не
// плодит дубликаты). Новые окна PowerShell/cmd увидят команду "запустить".
// "$" собирается отдельным кусочком (баг лексера с "\$").
функция команда_добавить_в_path(текст папка_bin) -> текст {
    текст д = "$";
    текст скрипт = д + "b = '" + папка_bin + "'; "
        + д + "p = [Environment]::GetEnvironmentVariable('Path', 'User'); "
        + "if (" + д + "p -eq " + д + "null) { " + д + "p = '' }; "
        + "if ((" + д + "p -split ';') -notcontains " + д + "b) { "
        + "[Environment]::SetEnvironmentVariable('Path', (" + д + "p.TrimEnd(';') + ';' + " + д + "b).TrimStart(';'), 'User') }";
    вернуть "powershell -NoProfile -Command \"" + скрипт + "\"";
}

функция команда_убрать_из_path(текст папка_bin) -> текст {
    текст д = "$";
    текст скрипт = д + "b = '" + папка_bin + "'; "
        + д + "p = [Environment]::GetEnvironmentVariable('Path', 'User'); "
        + "if (" + д + "p -ne " + д + "null) { "
        + д + "n = (" + д + "p -split ';' | Where-Object { " + д + "_ -ne " + д + "b -and " + д + "_ -ne '' }) -join ';'; "
        + "[Environment]::SetEnvironmentVariable('Path', " + д + "n, 'User') }";
    вернуть "powershell -NoProfile -Command \"" + скрипт + "\"";
}

функция тело_установки(текст базовая_папка) -> текст {
    текст папка_bin = базовая_папка + "\\bin";
    текст папка_share = базовая_папка + "\\share";
    текст э = папка_исполняемого_файла();
    // Где лежат собранные файлы Сферы, ищет сам .bat (там и русские имена
    // файлов, и "if exist" работают правильно): рядом с панелью в "bin"
    // (готовый релиз), в "target\\release" (панель собрана в репозитории,
    // из его папки или из "инструменты\\панель-разработчика"), либо там,
    // куда уже ставил установщик.
    текст б = "set \"SRC=\"\r\n";
    б = б + "if exist \"" + э + "\\bin\\запустить.exe\" set \"SRC=" + э + "\\bin\"\r\n";
    б = б + "if not defined SRC if exist \"" + э + "\\target\\release\\запустить.exe\" set \"SRC=" + э + "\\target\\release\"\r\n";
    б = б + "if not defined SRC if exist \"" + э + "\\..\\..\\target\\release\\запустить.exe\" set \"SRC=" + э + "\\..\\..\\target\\release\"\r\n";
    б = б + "if not defined SRC if exist \"%LOCALAPPDATA%\\Сфера\\bin\\запустить.exe\" set \"SRC=%LOCALAPPDATA%\\Сфера\\bin\"\r\n";
    б = б + "if not defined SRC echo Не найден запустить.exe: ни рядом с панелью, ни в target\\release & exit /b 1\r\n";
    б = б + "echo Копирую из: %SRC%\r\n";
    б = б + с_проверкой("if not exist \"" + папка_bin + "\" mkdir \"" + папка_bin + "\"");
    б = б + с_проверкой("if not exist \"" + папка_share + "\" mkdir \"" + папка_share + "\"");
    б = б + с_проверкой("copy /Y \"%SRC%\\запустить.exe\" \"" + папка_bin + "\\запустить.exe\" >nul");
    б = б + "if exist \"%SRC%\\сфера_lsp.exe\" copy /Y \"%SRC%\\сфера_lsp.exe\" \"" + папка_bin + "\\сфера_lsp.exe\" >nul\r\n";
    б = б + "if exist \"%SRC%\\сфера_пакеты.exe\" copy /Y \"%SRC%\\сфера_пакеты.exe\" \"" + папка_bin + "\\сфера_пакеты.exe\" >nul\r\n";
    б = б + "if exist \"%SRC%\\привет.код\" copy /Y \"%SRC%\\привет.код\" \"" + папка_share + "\\привет.код\" >nul\r\n";
    б = б + "if not exist \"" + папка_share + "\\привет.код\" if exist \"%SRC%\\..\\..\\examples\\привет.код\" copy /Y \"%SRC%\\..\\..\\examples\\привет.код\" \"" + папка_share + "\\привет.код\" >nul\r\n";
    // Из коробки: рантайм потоков (компилятор ищет его в "..\\lib\\sfera"
    // рядом с bin) и библиотеки SDL2 для графических программ — всё, что
    // найдётся рядом; чего нет, то просто пропускается.
    текст папка_lib = базовая_папка + "\\lib\\sfera";
    б = б + "if not exist \"" + папка_lib + "\" mkdir \"" + папка_lib + "\"\r\n";
    б = б + "if exist \"%SRC%\\..\\lib\\sfera\\pthread_win.o\" copy /Y \"%SRC%\\..\\lib\\sfera\\pthread_win.o\" \"" + папка_lib + "\\pthread_win.o\" >nul\r\n";
    б = б + "if not exist \"" + папка_lib + "\\pthread_win.o\" if exist \"%SRC%\\..\\..\\рантайм_windows\\pthread_win.o\" copy /Y \"%SRC%\\..\\..\\рантайм_windows\\pthread_win.o\" \"" + папка_lib + "\\pthread_win.o\" >nul\r\n";
    б = б + "if not exist \"" + папка_lib + "\\pthread_win.o\" if exist \"%LOCALAPPDATA%\\Сфера\\lib\\sfera\\pthread_win.o\" copy /Y \"%LOCALAPPDATA%\\Сфера\\lib\\sfera\\pthread_win.o\" \"" + папка_lib + "\\pthread_win.o\" >nul\r\n";
    // DLL графики из релизного архива лежат рядом с панелью.
    б = б + "if exist \"" + э + "\\*.dll\" copy /Y \"" + э + "\\*.dll\" \"" + папка_bin + "\\\" >nul\r\n";
    б = б + "if exist \"%LOCALAPPDATA%\\Сфера\\bin\\SDL2.dll\" copy /Y \"%LOCALAPPDATA%\\Сфера\\bin\\SDL2.dll\" \"" + папка_bin + "\\SDL2.dll\" >nul\r\n";
    б = б + "if exist \"%LOCALAPPDATA%\\Сфера\\bin\\SDL2_ttf.dll\" copy /Y \"%LOCALAPPDATA%\\Сфера\\bin\\SDL2_ttf.dll\" \"" + папка_bin + "\\SDL2_ttf.dll\" >nul\r\n";
    б = б + с_проверкой("(echo " + текущая_версия() + ")> \"" + папка_share + "\\version.txt\"");
    б = б + с_проверкой(команда_добавить_в_path(папка_bin));
    вернуть б;
}

// Открыть README.md: ищет файл тем же .bat (русские папки в пути).
функция тело_документации() -> текст {
    текст э = папка_исполняемого_файла();
    текст б = "if exist \"" + э + "\\README.md\" start \"\" \"" + э + "\\README.md\" & exit /b 0\r\n";
    б = б + "if exist \"" + э + "\\..\\..\\README.md\" start \"\" \"" + э + "\\..\\..\\README.md\" & exit /b 0\r\n";
    б = б + "if exist \"README.md\" start \"\" \"README.md\" & exit /b 0\r\n";
    б = б + "echo README.md не найден\r\nexit /b 1\r\n";
    вернуть б;
}

