        нарисовать_вкладку(холст, шрифт, 1, "Пакеты", ан.получить(2), с.вкладка == 1);
        нарисовать_вкладку(холст, шрифт, 2, "Документация", ан.получить(3), с.вкладка == 2);
        // Полоска-индикатор текущей страницы плавно "переезжает" между вкладками.
