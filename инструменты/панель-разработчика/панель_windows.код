// панель_windows.код — Windows-версия "панели разработчика" (см.
// панель.код — исходная, macOS-версия). Логика и экран ТЕ ЖЕ самые —
// скопировано оттуда и изменены ТОЛЬКО места, завязанные на конкретную
// ОС: путь к шрифту, домашняя папка, системный диалог выбора папки
// (вместо osascript — PowerShell), команды установки/удаления (вместо
// mkdir -p/cp/chmod/rm -rf — Windows cmd.exe эквиваленты) и метка
// платформы. Причина отдельного файла, а не единого кода с проверкой
// ОС внутри — в самом языке Сфера пока нет условной компиляции
// (аналога #cfg/#if), поэтому платформенные варианты неизбежно — два
// отдельных файла, как и установить-windows.ps1 отдельно от macOS-пути.
//
// ⚠️ НЕ ПРОВЕРЕНО ВЖИВУЮ (нет доступа к настоящему Windows с графикой
// здесь) — как и со всем остальным Windows-путём этого проекта, первая
// реальная проверка — по факту присланной ошибки, если она возникнет.
подключить графика;

функция текущая_версия() -> текст {
    вернуть "0.2.0";
}

// --- Пути и самоустановка ---

функция выбрать_путь_шрифта() -> текст {
    // Tahoma — стандартный шрифт Windows с широкой поддержкой кириллицы
    // (присутствует на любой Windows начиная с XP), хороший выбор по
    // умолчанию. Путь предполагает установку Windows на диск C: — почти
    // всегда так, но не гарантировано на 100% (честно: редкий случай
    // установки на другой диск здесь не обрабатывается).
    текст windows_путь = "C:\\Windows\\Fonts\\tahoma.ttf";
    результат<текст> проверка_windows = прочитать_файл(windows_путь);
    если (проверка_windows.успешно) {
        вернуть windows_путь;
    }

    текст windows_arial_путь = "C:\\Windows\\Fonts\\arial.ttf";
    результат<текст> проверка_arial = прочитать_файл(windows_arial_путь);
    если (проверка_arial.успешно) {
        вернуть windows_arial_путь;
    }

    вернуть windows_путь;
}

внешняя функция получить_переменную_окружения(текст имя) -> текст как "getenv";

// НАЙДЕНО РЕАЛЬНОЙ ПРОВЕРКОЙ: "HOME" в обычном Windows cmd.exe НЕ задана
// (в отличие от macOS/Linux) — getenv("HOME") вернула бы NULL, а не
// пустую строку, что рискованно превращать в текст напрямую. На Windows
// нужная переменная называется "USERPROFILE" (например
// "C:\Users\Имя") — её и используем, без обращения к "HOME" вообще.
функция домашняя_папка() -> текст {
    вернуть получить_переменную_окружения("USERPROFILE");
}

// Помогает собрать путь ВНУТРИ папки пользователя для временных логов —
// на Windows это осмысленнее через TEMP, чем через домашнюю папку.
функция временная_папка() -> текст {
    текст путь = получить_переменную_окружения("TEMP");
    если (длина(путь) > 0) {
        вернуть путь;
    }
    вернуть домашняя_папка();
}

// Находит позицию ПОСЛЕДНЕГО вхождения "искомое" в "строка" — "найти"
// (встроенная) даёт только первое, а для разбора пути (взять папку, в
// которой лежит .exe) нужен именно последний разделитель. Простой
// ручной перебор с конца, тем же приёмом, что и остальной файл уже
// использует для посимвольного разбора (см. разобрать_пакеты выше).
функция найти_последнее(текст строка, текст искомое) -> результат<целое> {
    целое длина_искомого = длина(искомое);
    если (длина_искомого == 0 || длина(строка) < длина_искомого) {
        вернуть ошибка("не найдено");
    }
    целое индекс = длина(строка) - длина_искомого;
    пока (индекс >= 0) {
        результат<текст> кусок = подстрока(строка, индекс, длина_искомого);
        если (кусок.успешно && кусок.значение == искомое) {
            вернуть успех(индекс);
        }
        индекс = индекс - 1;
    }
    вернуть ошибка("не найдено");
}

// Папка, в которой лежит сам запущенный .exe — берётся из argv[0]
// (первый аргумент командной строки, по стандартному соглашению — путь
// к самой программе). Нужна, чтобы найти папку "bin" со встроенными
// бинарниками рядом с панелью, без macOS-специфичного понятия
// ".app-бандла" (на Windows это просто папка рядом с .exe).
функция папка_исполняемого_файла() -> текст {
    Список<текст> аргументы = аргументы_командной_строки();
    если (аргументы.размер() == 0) {
        вернуть ".";
    }
    текст путь_к_себе = аргументы.получить(0);
    результат<целое> позиция = найти_последнее(путь_к_себе, "\\");
    если (!позиция.успешно) {
        вернуть ".";
    }
    результат<текст> папка = подстрока(путь_к_себе, 0, позиция.значение);
    если (папка.успешно) {
        вернуть папка.значение;
    }
    вернуть ".";
}

// НОВОЕ: путь установки теперь ПАРАМЕТР, а не жёстко зашитое значение —
// пользователь выбирает его сам через системный диалог (см.
// выбрать_папку_через_диалог ниже) при нажатии "Установить". По
// умолчанию (если пользователь ничего не выбирал) используется прежнее
// значение ~/.sfera — см. папка_установки_по_умолчанию.
функция папка_установки_по_умолчанию() -> текст {
    вернуть домашняя_папка() + "\\.sfera";
}

функция путь_установленного_sfera(текст базовая_папка) -> текст {
    вернуть базовая_папка + "\\bin\\запустить.exe";
}

функция путь_установленного_сфера_пакеты(текст базовая_папка) -> текст {
    вернуть базовая_папка + "\\bin\\сфера_пакеты.exe";
}

функция путь_установленного_примера(текст базовая_папка) -> текст {
    вернуть базовая_папка + "\\share\\привет.код";
}

функция путь_файла_версии(текст базовая_папка) -> текст {
    вернуть базовая_папка + "\\share\\версия.txt";
}

// На Windows нет .app-бандла — панель это просто Панель-Сферы.exe, а
// рядом с ней (в той же папке, при установке/распаковке релиза) лежит
// подпапка "bin" со встроенными бинарниками. См. README в этой папке —
// соглашение об именах файлов релиза для сборки под Windows.
функция путь_встроенного_бандла() -> текст {
    вернуть папка_исполняемого_файла() + "\\bin";
}

функция сфера_уже_установлена(текст базовая_папка) -> верно {
    результат<текст> проверка = прочитать_файл(путь_установленного_sfera(базовая_папка));
    вернуть проверка.успешно;
}

// Системный диалог выбора папки — на Windows нет встроенной команды
// для этого (в отличие от macOS "osascript"), но PowerShell (есть в
// любой Windows начиная с 7) умеет открыть стандартный .NET
// FolderBrowserDialog в одну строку. Тот же приём, что и на macOS:
// команда пишет результат в файл, мы читаем файл, а не пытаемся
// разобрать вывод напрямую из живого процесса.
//
// ⚠️ НЕ ПРОВЕРЕНО ВЖИВУЮ (нет доступа к настоящему Windows с графикой
// здесь) — первая реальная проверка, как и со всем остальным
// Windows-путём проекта, по факту присланной ошибки, если возникнет.
функция выбрать_папку_через_диалог() -> результат<текст> {
    текст лог = временная_папка() + "\\sfera_панель_выбор_папки.log";
    // ⚠️ НАЙДЕННЫЙ БАГ КОМПИЛЯТОРА (отдельный от Windows-переноса, стоит
    // когда-нибудь починить в lexer.rs/parser.rs): "$имя" внутри
    // текстового литерала — это интерполяция, а "\$" ДОЛЖНО вставлять
    // буквальный "$" без неё (так и задокументировано). На деле лексер
    // разворачивает "\$" в обычный "$" ДО того, как парсер ищет
    // интерполяцию — экранирование теряется, и "\$f" всё равно пытается
    // подставить несуществующую переменную "f". Обходим здесь иначе —
    // собираем "$" как отдельный кусочек текста и приклеиваем буквы PowerShell-
    // переменной через "+", так что ни в одном литерале "$" не стоит
    // рядом с буквой — тогда интерполяция просто не запускается.
    текст д = "$";
    текст powershell_скрипт = "Add-Type -AssemblyName System.Windows.Forms; "
        + д + "f = New-Object System.Windows.Forms.FolderBrowserDialog; "
        + д + "f.Description = 'Выберите папку для установки языка Сфера'; "
        + "if (" + д + "f.ShowDialog() -eq 'OK') { " + д + "f.SelectedPath } else { exit 1 }";
    текст команда = "powershell -NoProfile -Command \"" + powershell_скрипт + "\" > \"" + лог + "\"";
    результат<целое> итог = выполнить_команду(команда);
    // Пользователь нажал "Отмена" в диалоге — скрипт выше явно делает
    // "exit 1" (это НЕ ошибка запуска команды, а честный, ожидаемый
    // отказ пользователя, обрабатывается отдельно, не как "не удалось
    // выполнить команду").
    если (!итог.успешно || итог.значение != 0) {
        вернуть ошибка("отменено пользователем");
    }

    результат<текст> содержимое = прочитать_файл(лог);
    если (!содержимое.успешно) {
        вернуть ошибка("не удалось прочитать выбранный путь");
    }

    // PowerShell дописывает перевод строки в конце вывода — убираем его,
    // прежде чем использовать путь для конкатенации (сам путь уже без
    // завершающего "\", FolderBrowserDialog так не возвращает).
    текст путь = содержимое.значение;
    результат<целое> позиция_переноса = найти(путь, "\n");
    если (позиция_переноса.успешно) {
        результат<текст> обрезанный = подстрока(путь, 0, позиция_переноса.значение);
        если (обрезанный.успешно) {
            путь = обрезанный.значение;
        }
    }
    если (длина(путь) > 0) {
        результат<текст> последний_символ_результат = подстрока(путь, длина(путь) - 1, 1);
        если (последний_символ_результат.успешно && последний_символ_результат.значение == "\r") {
            результат<текст> без_cr = подстрока(путь, 0, длина(путь) - 1);
            если (без_cr.успешно) {
                путь = без_cr.значение;
            }
        }
    }

    вернуть успех(путь + "\\.sfera");
}

функция установить_сферу(текст базовая_папка) -> верно {
    текст папка_bin = базовая_папка + "\\bin";
    текст папка_share = базовая_папка + "\\share";
    текст встроенный_bin = путь_встроенного_бандла();

    // cmd.exe-эквиваленты: "mkdir" на Windows сам создаёт недостающие
    // промежуточные папки (в отличие от старого DOS), но возвращает
    // ошибку, если папка УЖЕ существует — отсюда "if not exist" вместо
    // "-p". "copy /Y" — без вопроса на перезапись. Нет аналога chmod +x
    // — на Windows у .exe нет "бита исполняемости", это не нужно.
    текст команда = "(if not exist \"" + папка_bin + "\" mkdir \"" + папка_bin + "\") && "
        + "(if not exist \"" + папка_share + "\" mkdir \"" + папка_share + "\") && "
        + "copy /Y \"" + встроенный_bin + "\\запустить.exe\" \"" + папка_bin + "\\запустить.exe\" && "
        + "copy /Y \"" + встроенный_bin + "\\сфера_lsp.exe\" \"" + папка_bin + "\\сфера_lsp.exe\" && "
        + "copy /Y \"" + встроенный_bin + "\\сфера_пакеты.exe\" \"" + папка_bin + "\\сфера_пакеты.exe\" && "
        + "copy /Y \"" + встроенный_bin + "\\привет.код\" \"" + папка_share + "\\привет.код\" && "
        + "echo " + текущая_версия() + "> \"" + папка_share + "\\версия.txt\"";

    результат<целое> итог = выполнить_команду(команда);
    вернуть итог.успешно && итог.значение == 0;
}

// НОВОЕ: удаление — обратная операция, полностью убирает папку установки.
функция удалить_сферу(текст базовая_папка) -> верно {
    текст команда = "rmdir /s /q \"" + базовая_папка + "\"";
    результат<целое> итог = выполнить_команду(команда);
    вернуть итог.успешно && итог.значение == 0;
}

// НОВОЕ: открыть README во внешней программе просмотра — "start" на
// Windows открывает файл программой, назначенной по умолчанию для его
// типа (ровно как "open" на macOS). Первый "" — пустой заголовок окна,
// обязательный аргумент "start", когда путь может содержать пробелы.
функция открыть_документацию() -> верно {
    результат<целое> итог = выполнить_команду("start \"\" README.md");
    вернуть итог.успешно;
}

// НОВОЕ: захватывает список пакетов В ФАЙЛ (а не в невидимую консоль —
// пользователь, запустивший панель двойным кликом, эту консоль вообще
// не увидит) и возвращает его содержимое одной строкой, с переносами.
функция получить_список_пакетов(текст базовая_папка) -> текст {
    текст лог = временная_папка() + "\\sfera_панель_пакеты.log";
    текст команда = "\"" + путь_установленного_сфера_пакеты(базовая_папка) + "\" список > \"" + лог + "\" 2>&1";
    выполнить_команду(команда);
    результат<текст> содержимое = прочитать_файл(лог);
    если (содержимое.успешно) {
        вернуть содержимое.значение;
    }
    вернуть "Не удалось получить список пакетов.";
}

// НОВОЕ: проверяет, начинается ли "строка" ровно с "префикс" (в самом
// начале, не где угодно — в отличие от "содержит").
// НОВОЕ (настоящая проверка обновлений через GitHub Releases API — не
// полноценный JSON-парсер, а точечное извлечение конкретных, известных
// полей из фиксированного формата ответа GitHub, тем же уровнем
// прагматизма, что и разбор вывода "сфера_пакеты список" ниже). Ищет
// '"имя_поля":"', возвращает всё до следующей НЕэкранированной кавычки
// (учитывает \" внутри значения — например, в тексте описания релиза).
функция извлечь_json_строковое_поле(текст json, текст имя_поля) -> результат<текст> {
    текст искомое = "\"" + имя_поля + "\":\"";
    результат<целое> позиция_ключа = найти(json, искомое);
    если (!позиция_ключа.успешно) {
        вернуть ошибка("поле '" + имя_поля + "' не найдено в ответе");
    }
    целое начало_значения = позиция_ключа.значение + длина(искомое);

    целое индекс = начало_значения;
    целое конец_значения = 0 - 1;
    пока (индекс < длина(json) && конец_значения == 0 - 1) {
        целое32 байт = байт_текста(json, индекс);
        если (байт == целое32(34)) {
            если (индекс == начало_значения) {
                конец_значения = индекс;
            } иначе {
                целое32 предыдущий_байт = байт_текста(json, индекс - 1);
                если (предыдущий_байт != целое32(92)) {
                    конец_значения = индекс;
                }
            }
        }
        индекс = индекс + 1;
    }

    если (конец_значения == 0 - 1) {
        вернуть ошибка("не удалось найти конец значения поля '" + имя_поля + "'");
    }

    вернуть подстрока(json, начало_значения, конец_значения - начало_значения);
}

// НОВОЕ: базовая разэкранировка JSON-строки — \n в настоящий перенос
// строки (для показа через нарисовать_многострочный_текст), \" в ",
// \\ в \, \r отбрасывается. Байты копируются по одному через подстроку
// (не через байт_текста — та даёт число, не кусок текста) — работает
// корректно и для многобайтовых, кириллических символов: раз они просто
// копируются последовательно, без попытки их интерпретировать.
функция разэкранировать_json_текст(текст исходный) -> текст {
    текст итог = "";
    целое индекс = 0;
    пока (индекс < длина(исходный)) {
        целое32 байт = байт_текста(исходный, индекс);
        если (байт == целое32(92) && индекс + 1 < длина(исходный)) {
            целое32 следующий = байт_текста(исходный, индекс + 1);
            если (следующий == целое32(110)) {
                итог = итог + "\n";
                индекс = индекс + 2;
            } иначе если (следующий == целое32(34)) {
                итог = итог + "\"";
                индекс = индекс + 2;
            } иначе если (следующий == целое32(92)) {
                итог = итог + "\\";
                индекс = индекс + 2;
            } иначе если (следующий == целое32(114)) {
                индекс = индекс + 2;
            } иначе {
                результат<текст> символ = подстрока(исходный, индекс, 1);
                если (символ.успешно) {
                    итог = итог + символ.значение;
                }
                индекс = индекс + 1;
            }
        } иначе {
            результат<текст> символ = подстрока(исходный, индекс, 1);
            если (символ.успешно) {
                итог = итог + символ.значение;
            }
            индекс = индекс + 1;
        }
    }
    вернуть итог;
}

// НОВОЕ: настоящая проверка обновлений через GitHub Releases API —
// заменяет прежний "фейковый сервер обновлений" (file:///tmp/...).
// Скачивает JSON последнего релиза через curl (в языке пока нет
// HTTPS/TLS — GitHub API доступен только по HTTPS, поэтому используется
// уже установленная в системе curl, тем же приёмом, что и остальная
// панель), извлекает номер версии и полный текст описания изменений.
// НОВОЕ: релиз на GitHub может содержать сборки сразу под несколько ОС
// (macOS/Windows/Linux/Android) — один и тот же номер версии не
// обязательно значит, что ЭТОЙ конкретной панели есть что скачивать
// (например, версия вышла с исправлением только под Android). Файлы
// релиза (assets) должны называться по условию, включающему метку
// платформы (например "Панель-Сферы-macOS.zip") — эта функция ищет её
// среди имён файлов, не просто сравнивает номер версии.
//
// Это Windows-версия панели (см. шапку файла) — метка должна совпадать
// с соглашением об именовании файлов релиза, например
// "Панель-Сферы-Windows.zip" (см. README рядом).
функция метка_текущей_платформы() -> текст {
    вернуть "Windows";
}

// Вырезает СОДЕРЖИМОЕ JSON-массива по имени поля (например "assets") —
// от открывающей "[" до СООТВЕТСТВУЮЩЕЙ закрывающей "]", считая глубину
// вложенности (в массиве объектов assets вложенных [] не бывает, но
// подсчёт глубины на всякий случай честнее, чем поиск первой попавшейся
// "]"). Та же, уже принятая для этого файла степень упрощения — не
// полноценный JSON-парсер, точечное извлечение для известного,
// фиксированного формата ответа GitHub.
функция извлечь_json_массив(текст json, текст имя_поля) -> результат<текст> {
    текст искомое = "\"" + имя_поля + "\":[";
    результат<целое> позиция = найти(json, искомое);
    если (!позиция.успешно) {
        вернуть ошибка("поле '" + имя_поля + "' не найдено");
    }
    целое начало = позиция.значение + длина(искомое);

    целое глубина = 1;
    целое индекс = начало;
    целое конец = 0 - 1;
    пока (индекс < длина(json) && конец == 0 - 1) {
        целое32 байт = байт_текста(json, индекс);
        если (байт == целое32(91)) {
            глубина = глубина + 1;
        } иначе если (байт == целое32(93)) {
            глубина = глубина - 1;
            если (глубина == 0) {
                конец = индекс;
            }
        }
        индекс = индекс + 1;
    }

    если (конец == 0 - 1) {
        вернуть ошибка("не удалось найти конец массива '" + имя_поля + "'");
    }
    вернуть подстрока(json, начало, конец - начало);
}

// Есть ли среди файлов релиза (assets) хотя бы один, чьё имя содержит
// метку текущей платформы — то есть реально ли что-то скачивать именно
// для ЭТОЙ ОС, а не только "номер версии стал больше".
функция релиз_содержит_сборку_для_платформы(текст json) -> верно {
    результат<текст> массив_ассетов = извлечь_json_массив(json, "assets");
    если (!массив_ассетов.успешно) {
        вернуть нет;
    }
    вернуть содержит(массив_ассетов.значение, метка_текущей_платформы());
}

функция проверить_обновления_на_github() -> результат<текст> {
    текст лог = временная_папка() + "\\sfera_панель_обновление.log";
    // cmd.exe не убирает одинарные кавычки, как это делает bash на
    // macOS/Linux — curl получил бы их буквально как часть заголовка.
    // На Windows нужны двойные. "curl" встроен в Windows начиная с
    // версии 1803 (2018) — для более старых систем его тут нет.
    текст команда = "curl -s -H \"Accept: application/vnd.github+json\" "
        + "https://api.github.com/repos/nikitosklim/Sfera/releases/latest > \"" + лог + "\" 2>nul";
    результат<целое> итог = выполнить_команду(команда);
    если (!итог.успешно) {
        вернуть ошибка("не удалось выполнить запрос (нет интернета?)");
    }

    результат<текст> содержимое = прочитать_файл(лог);
    если (!содержимое.успешно) {
        вернуть ошибка("не удалось прочитать ответ GitHub");
    }
    вернуть успех(содержимое.значение);
}

функция начинается_с(текст строка, текст префикс) -> верно {
    если (длина(строка) < длина(префикс)) {
        вернуть нет;
    }
    результат<текст> начало = подстрока(строка, 0, длина(префикс));
    если (начало.успешно) {
        вернуть начало.значение == префикс;
    }
    вернуть нет;
}

// НОВОЕ: разбирает текстовый вывод "сфера_пакеты список" (см. точный
// формат в показать_список, src/bin/сфера_пакеты.rs) в три параллельных
// списка — по одной записи на пакет. Опирается на точные префиксы строк
// ("  " перед именем, "    источник: "/"    описание: " перед полями) —
// тот же формат, что мы сами и печатаем, поэтому не нужен более общий,
// терпимый к ошибкам разбор.
функция разобрать_пакеты(текст вывод, Список<текст> имена, Список<текст> источники, Список<текст> описания) -> целое {
    текст остаток = вывод;
    текст текущее_имя = "";
    текст текущий_источник = "—";
    текст текущее_описание = "—";
    верно есть_текущий = нет;

    пока (длина(остаток) > 0) {
        текст строка = остаток;
        текст следующий_остаток = "";
        результат<целое> позиция_переноса = найти(остаток, "\n");
        если (позиция_переноса.успешно) {
            результат<текст> часть = подстрока(остаток, 0, позиция_переноса.значение);
            если (часть.успешно) {
                строка = часть.значение;
            }
            целое после = позиция_переноса.значение + 1;
            результат<текст> хвост = подстрока(остаток, после, длина(остаток) - после);
            если (хвост.успешно) {
                следующий_остаток = хвост.значение;
            }
        }

        если (начинается_с(строка, "    источник: ")) {
            // ⚠️ НАЙДЕННЫЙ БАГ: раньше здесь стояло жёсткое число 15 —
            // неверное, поскольку "источник"/"описание" — кириллица,
            // каждая буква 2 байта в UTF-8, реальная длина префикса 22
            // байта. Исправлено на динамический расчёт от самого текста
            // префикса — больше никогда не собьётся, даже если сам текст
            // префикса потом изменится.
            целое длина_префикса = длина("    источник: ");
            результат<текст> значение = подстрока(строка, длина_префикса, длина(строка) - длина_префикса);
            если (значение.успешно) {
                текущий_источник = значение.значение;
            }
        } иначе если (начинается_с(строка, "    описание: ")) {
            целое длина_префикса = длина("    описание: ");
            результат<текст> значение = подстрока(строка, длина_префикса, длина(строка) - длина_префикса);
            если (значение.успешно) {
                текущее_описание = значение.значение;
            }
        } иначе если (начинается_с(строка, "  ") && !начинается_с(строка, "    ") && длина(строка) > 2) {
            // Начало новой записи о пакете — сохраняем предыдущую (если
            // была) и начинаем собирать следующую.
            если (есть_текущий) {
                имена.добавить(текущее_имя);
                источники.добавить(текущий_источник);
                описания.добавить(текущее_описание);
            }
            // Пробелы однобайтовые, "2" тут технически верно, но
            // динамический расчёт для единообразия с исправлением выше.
            целое длина_отступа = длина("  ");
            результат<текст> имя_без_отступа = подстрока(строка, длина_отступа, длина(строка) - длина_отступа);
            если (имя_без_отступа.успешно) {
                текущее_имя = имя_без_отступа.значение;
            }
            текущий_источник = "—";
            текущее_описание = "—";
            есть_текущий = да;
        }

        остаток = следующий_остаток;
        если (!позиция_переноса.успешно) {
            остаток = "";
        }
    }

    если (есть_текущий) {
        имена.добавить(текущее_имя);
        источники.добавить(текущий_источник);
        описания.добавить(текущее_описание);
    }

    вернуть 0;
}

// Выводит многострочный текст (с \n внутри) построчно, начиная с
// заданной Y-координаты — графическая библиотека умеет рисовать только
// одну строку за раз, эта функция разбивает текст сама.
функция нарисовать_многострочный_текст(текст холст, текст шрифт, текст содержимое, целое32 х, целое32 начальный_у) -> целое {
    текст остаток = содержимое;
    целое32 текущий_у = начальный_у;
    целое строк_нарисовано = 0;

    пока (строк_нарисовано < 20) {
        результат<целое> позиция_переноса = найти(остаток, "\n");
        если (позиция_переноса.успешно) {
            результат<текст> строка = подстрока(остаток, 0, позиция_переноса.значение);
            если (строка.успешно) {
                нарисовать_текст(холст, шрифт, строка.значение, х, текущий_у, 4294967295);
            }
            целое следующая_позиция = позиция_переноса.значение + 1;
            // ⚠️ НАЙДЕННАЯ ОШИБКА: третий аргумент "подстрока" — это ДЛИНА
            // подстроки, а не абсолютный индекс конца, как предполагалось
            // изначально. "длина(остаток) - следующая_позиция" —
            // правильная длина оставшейся части СТРОКИ.
            целое длина_остатка = длина(остаток) - следующая_позиция;
            результат<текст> остаток_после = подстрока(остаток, следующая_позиция, длина_остатка);
            если (остаток_после.успешно) {
                остаток = остаток_после.значение;
            } иначе {
                вернуть строк_нарисовано;
            }
        } иначе {
            если (длина(остаток) > 0) {
                нарисовать_текст(холст, шрифт, остаток, х, текущий_у, 4294967295);
                строк_нарисовано = строк_нарисовано + 1;
            }
            вернуть строк_нарисовано;
        }
        текущий_у = текущий_у + целое32(22);
        строк_нарисовано = строк_нарисовано + 1;
    }

    вернуть строк_нарисовано;
}

// НОВОЕ: подробная информация о языке — версия уже была (текущая_версия),
// добавлены название/описание/честные ограничения, показывается на
