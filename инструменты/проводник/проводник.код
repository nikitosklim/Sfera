// ---------- кириллический адрес сайта -> punycode ----------
// curl на macOS не переводит «языксфера.рф» в «xn--80ajfm5aev7c8a.xn--p1ai» сам и ругается на сертификат,
// поэтому переводим каждую часть имени с не-ASCII буквами (алгоритм RFC 3492).
функция пуни_цифра(целое д): текст
    текст алфавит = "abcdefghijklmnopqrstuvwxyz0123456789";
    результат из текста р = подстрока(алфавит, д, 1);
    если (р.успешно)
        вернуть р.значение;
    конец
    вернуть "";
конец

функция пуни_адаптация(целое дельта_вход, целое число_точек, целое первый): целое
    целое дельта = дельта_вход / 2;
    если (первый == 1)
        дельта = дельта_вход / 700;
    конец
    дельта = дельта + дельта / число_точек;
    целое к = 0;
    пока (дельта больше 455)
        дельта = дельта / 35;
        к = к + 36;
    конец
    вернуть к + 36 * дельта / (дельта + 38);
конец

// UTF-8 -> кодовые точки
функция кодовые_точки(текст с, Список из целых т): целое
    целое п = 0;
    пока (п меньше длина(с))
        целое б = целое(байт_текста(с, п));
        если (б меньше 128)
            т.добавить(б);
            п = п + 1;
        иначе если (б меньше 224)
            т.добавить((б % 32) * 64 + целое(байт_текста(с, п + 1)) % 64);
            п = п + 2;
        иначе если (б меньше 240)
            т.добавить((б % 16) * 4096 + (целое(байт_текста(с, п + 1)) % 64) * 64 + целое(байт_текста(с, п + 2)) % 64);
            п = п + 3;
        иначе
            т.добавить((б % 8) * 262144 + (целое(байт_текста(с, п + 1)) % 64) * 4096 + (целое(байт_текста(с, п + 2)) % 64) * 64 + целое(байт_текста(с, п + 3)) % 64);
            п = п + 4;
        конец
    конец
    вернуть т.размер();
конец

функция пуникод(текст метка): текст
    Список из целых т = Список из целых();
    кодовые_точки(метка, т);
    текст вывод = "";
    целое базовых = 0;
    целое ин = 0;
    пока (ин меньше т.размер())
        если (т.получить(ин) меньше 128)
            вывод = вывод + символ_из_кода(т.получить(ин));
            базовых = базовых + 1;
        конец
        ин = ин + 1;
    конец
    если (базовых больше 0)
        вывод = вывод + "-";
    конец
    целое н = 128;
    целое дельта = 0;
    целое сдвиг = 72;
    целое сделано = базовых;
    пока (сделано меньше т.размер())
        целое м = 2147483647;
        ин = 0;
        пока (ин меньше т.размер())
            если (т.получить(ин) не меньше н и т.получить(ин) меньше м)
                м = т.получить(ин);
            конец
            ин = ин + 1;
        конец
        дельта = дельта + (м - н) * (сделано + 1);
        н = м;
        ин = 0;
        пока (ин меньше т.размер())
            целое с = т.получить(ин);
            если (с меньше н)
                дельта = дельта + 1;
            конец
            если (с == н)
                целое q = дельта;
                целое к = 36;
                целое идти = 1;
                пока (идти == 1)
                    целое порог = к - сдвиг;
                    если (к не больше сдвиг)
                        порог = 1;
                    иначе если (к не меньше сдвиг + 26)
                        порог = 26;
                    конец
                    если (q меньше порог)
                        идти = 0;
                    иначе
                        вывод = вывод + пуни_цифра(порог + (q - порог) % (36 - порог));
                        q = (q - порог) / (36 - порог);
                        к = к + 36;
                    конец
                конец
                вывод = вывод + пуни_цифра(q);
                целое первый = 0;
                если (сделано == базовых)
                    первый = 1;
                конец
                сдвиг = пуни_адаптация(дельта, сделано + 1, первый);
                дельта = 0;
                сделано = сделано + 1;
            конец
            ин = ин + 1;
        конец
        дельта = дельта + 1;
        н = н + 1;
    конец
    вернуть вывод;
конец

функция символ_из_кода(целое к): текст
    текст таблица = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~";
    результат из текста р = подстрока(таблица, к - 32, 1);
    если (р.успешно и к не меньше 32 и к меньше 127)
        вернуть р.значение;
    конец
    вернуть "";
конец

функция есть_не_ascii(текст с): верно
    целое п = 0;
    пока (п меньше длина(с))
        если (целое(байт_текста(с, п)) не меньше 128)
            вернуть да;
        конец
        п = п + 1;
    конец
    вернуть нет;
конец

// «языксфера.рф» -> «xn--80ajfm5aev7c8a.xn--p1ai»; части без русских букв остаются как есть.
функция хост_в_пуникод(текст хост): текст
    текст итог = "";
    целое начало = 0;
    целое п = 0;
    пока (п не больше длина(хост))
        если (п == длина(хост) или целое(байт_текста(хост, п)) == 46)
            текст метка = "";
            результат из текста м = подстрока(хост, начало, п - начало);
            если (м.успешно)
                метка = м.значение;
            конец
            если (есть_не_ascii(метка))
                итог = итог + "xn--" + пуникод(регистр_в_нижний(метка));
            иначе
                итог = итог + метка;
            конец
            если (п меньше длина(хост))
                итог = итог + ".";
            конец
            начало = п + 1;
        конец
        п = п + 1;
    конец
    вернуть итог;
конец

функция основа_адреса(Состояние с): текст
    текст а = обрезать_края(с.адрес);
    пока (длина(а) больше 0 и целое(байт_текста(а, длина(а) - 1)) == 47)
        результат из текста р = подстрока(а, 0, длина(а) - 1);
        если ( не р.успешно)
            вернуть а;
        конец
        а = р.значение;
    конец
    результат из целого есть_схема = найти(а, "://");
    если ( не есть_схема.успешно)
        // Без схемы: адрес с портом или localhost — это тестовый сервер, он обычно без https.
        результат из целого есть_порт = найти(а, ":");
        если (есть_порт.успешно или начинается(а, "localhost"))
            а = "http://" + а;
        иначе
            а = "https://" + а;
        конец
    конец
    // Имя сайта по-русски переводим в punycode (только часть до «:» или «/»).
    результат из целого после_схемы = найти(а, "://");
    если (после_схемы.успешно и есть_не_ascii(а))
        целое от = после_схемы.значение + 3;
        целое до = от;
        пока (до меньше длина(а) и целое(байт_текста(а, до)) != 47 и целое(байт_текста(а, до)) != 58)
            до = до + 1;
        конец
        результат из текста голова = подстрока(а, 0, от);
        результат из текста хост = подстрока(а, от, до - от);
        результат из текста хвост = подстрока(а, до, длина(а) - до);
        если (голова.успешно и хост.успешно и хвост.успешно)
            а = голова.значение + хост_в_пуникод(хост.значение) + хвост.значение;
        конец
    конец
    вернуть а;
конец

// ---------- запросы через curl в фоне ----------
// Слоты: 1 — список, 2 — сведения о сервере, 3 — скачивание.
функция записать_заголовок(Состояние с): целое
    // Пишем во временный файл и подменяем целиком: два запроса подряд (список и сведения) читают
    // этот файл из фона, и недописанный заголовок давал бы ложный ответ «неверный токен».
    текст ф = путь_заголовка();
    текст врем = ф + ".tmp";
    выполнить_команду("umask 077; : > '" + для_оболочки(врем) + "'");
    записать_файл(врем, "Authorization: Bearer " + обрезать_края(с.токен) + "\n");
    выполнить_команду("chmod 600 '" + для_оболочки(врем) + "'");
    переименовать_файл(врем, ф);
    вернуть 0;
конец

функция запустить_слот(целое слот, текст тело): верно
    текст скрипт = путь_слота(слот, "sh");
    выполнить_команду("rm -f '" + для_оболочки(путь_слота(слот, "done")) + "'");
    результат из верного запись = записать_файл(скрипт, тело);
    если ( не запись.успешно)
        вернуть нет;
    конец
    результат из целого запуск = выполнить_команду("sh '" + для_оболочки(скрипт) + "' > /dev/null 2>&1 &");
    вернуть запуск.успешно;
конец

// Код ответа HTTP ("200", "401", "000" — нет связи) или "" пока идёт.
функция итог_слота(целое слот): текст
    результат из текста р = прочитать_файл(путь_слота(слот, "done"));
    если ( не р.успешно или длина(р.значение) == 0)
        вернуть "";
    конец
    вернуть обрезать_края(р.значение);
конец

функция прочитать_ответ(целое слот): текст
    результат из текста р = прочитать_файл(путь_слота(слот, "out"));
    если (р.успешно)
        вернуть р.значение;
    конец
    вернуть "";
конец

функция скрипт_запроса(Состояние с, текст метод_путь, текст путь_параметр, целое слот, целое время): текст
    текст д = "$";
    текст готово = для_оболочки(путь_слота(слот, "done"));
    текст итог = "c=" + д + "(curl -sS -m " + целое_в_текст(время) + " -H @'" + для_оболочки(путь_заголовка()) + "' -G ";
    если (длина(путь_параметр) больше 0 или метод_путь == "/api/файлы")
        итог = итог + "--data-urlencode 'путь=" + для_оболочки(путь_параметр) + "' ";
    конец
    если (метод_путь == "/api/файлы")
        итог = итог + "--data-urlencode 'формат=2' --data-urlencode 'стр=" + целое_в_текст(с.стр) + "' ";
    конец
    итог = итог + "-o '" + для_оболочки(путь_слота(слот, "out")) + "' -w '%{http_code}' '" + для_оболочки(основа_адреса(с) + метод_путь) + "' 2>'" + для_оболочки(путь_слота(слот, "err")) + "')\n";
    итог = итог + "echo " + д + "c > '" + готово + ".tmp'; mv '" + готово + ".tmp' '" + готово + "'\n";
    вернуть итог;
конец

// Первая строка того, что curl написал об ошибке (например «Could not resolve host»).
функция причина_сбоя(целое слот): текст
    результат из текста р = прочитать_файл(путь_слота(слот, "err"));
    если ( не р.успешно)
        вернуть "";
    конец
    текст т = обрезать_края(р.значение);
    результат из целого конец_строки = найти(т, "\n");
    если (конец_строки.успешно)
        результат из текста первая = подстрока(т, 0, конец_строки.значение);
        если (первая.успешно)
            т = первая.значение;
        конец
    конец
    если (начинается(т, "curl: "))
        результат из текста без = подстрока(т, 6, длина(т) - 6);
        если (без.успешно)
            т = без.значение;
        конец
    конец
    вернуть т;
конец

функция запросить_список(Состояние с): целое
    записать_заголовок(с);
    если (запустить_слот(1, скрипт_запроса(с, "/api/файлы", с.путь, 1, 10)))
        с.ждём_список = 1;
    иначе
        с.список_ошибка = "Не удалось запустить запрос";
    конец
    вернуть 0;
конец

функция запросить_инфо(Состояние с): целое
