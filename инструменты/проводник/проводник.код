// Адрес для шапки: без «http://», готовится один раз при входе.
функция подготовить_показ(Состояние с): целое
    текст адрес = основа_адреса(с);
    результат из целого сх = найти(адрес, "://");
    если (сх.успешно)
        результат из текста без = подстрока(адрес, сх.значение + 3, длина(адрес) - сх.значение - 3);
        если (без.успешно)
            адрес = без.значение;
        конец
    конец
    с.адрес_показ = обрезать(адрес, 24);
    вернуть 0;
конец

