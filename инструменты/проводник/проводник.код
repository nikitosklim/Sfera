// Кнопка: возвращает да, если мышь над ней (клик обрабатывает вызывающий).
функция кнопка(Кисть к, Состояние с, текст подпись, целое х, целое у, целое ш, целое выс, целое основной): верно
    верно над = внутри(с.мышь_х, с.мышь_у, х, у, ш, выс);
    целое фон = Ц_ПАНЕЛЬ2;
    если (основной == 1)
        фон = Ц_СИНИЙ;
    конец
    если (над и основной == 0)
        фон = Ц_ЛИНИЯ;
    конец
    если (над и основной == 1)
        фон = 0x6ba0ff;
    конец
    залить_скругл(к, фон, х, у, ш, выс, 6);
    если (основной == 0)
        рамка(к, Ц_ЛИНИЯ, х, у, ш, выс);
    конец
    писать_по_центру(к, пх(к.шрифт), подпись, х + ш / 2, у + (выс - 20) / 2, Ц_ТЕКСТ);
    вернуть над;
конец

// ---------- текст ----------
// Обрезает по числу СИМВОЛОВ (не байт) и добавляет «…».
функция обрезать(текст с, целое макс): текст
    целое п = 0;
    целое симв = 0;
    пока (п меньше длина(с))
        целое б = целое(байт_текста(с, п));
        если (б меньше 128 или б не меньше 192)
            если (симв == макс)
                результат из текста р = подстрока(с, 0, п);
                если (р.успешно)
                    вернуть р.значение + "…";
                конец
                вернуть с;
            конец
            симв = симв + 1;
        конец
        п = п + 1;
    конец
    // Копия, а не сам «с»: временную строку-аргумент освободят сразу после вызова.
    результат из текста копия = подстрока(с, 0, длина(с));
    если (копия.успешно)
        вернуть копия.значение;
    конец
    вернуть с;
конец

// Убирает пробелы, табы и переводы строк по краям.
функция пробельный(целое б): верно
    вернуть б == 32 или б == 9 или б == 10 или б == 13;
конец

функция обрезать_края(текст с): текст
    целое от = 0;
    целое до = длина(с);
    пока (от меньше до и пробельный(целое(байт_текста(с, от))))
        от = от + 1;
    конец
    пока (до больше от и пробельный(целое(байт_текста(с, до - 1))))
        до = до - 1;
    конец
    результат из текста р = подстрока(с, от, до - от);
    если (р.успешно)
        вернуть р.значение;
    конец
    вернуть "";
конец

функция десятичное(целое десятых): текст
    вернуть целое_в_текст(десятых / 10) + "," + целое_в_текст(десятых % 10);
конец

функция размер_в_текст(целое б): текст
    если (б меньше 1024)
        вернуть целое_в_текст(б) + " Б";
    конец
    если (б меньше 1048576)
        вернуть десятичное(б * 10 / 1024) + " КБ";
    конец
    если (б меньше 1073741824)
        вернуть десятичное(б * 10 / 1048576) + " МБ";
    конец
    если (б меньше 1099511627776)
        вернуть десятичное(б * 10 / 1073741824) + " ГБ";
    конец
    вернуть десятичное(б * 10 / 1099511627776) + " ТБ";
конец

функция дата_файла(целое юникс): текст
    ДатаВремя дв = время_из_юникса_со_смещением(юникс, смещение_москвы());
    вернуть дополнить_нулём(дв.день) + "." + дополнить_нулём(дв.месяц) + "." + целое_в_текст(дв.год) + " " + дополнить_нулём(дв.час) + ":" + дополнить_нулём(дв.минута);
конец

функция время_работы(целое сек): текст
    целое д = сек / 86400;
    целое ч = (сек % 86400) / 3600;
    целое м = (сек % 3600) / 60;
    если (д больше 0)
        вернуть целое_в_текст(д) + " д " + целое_в_текст(ч) + " ч";
    конец
    если (ч больше 0)
        вернуть целое_в_текст(ч) + " ч " + целое_в_текст(м) + " мин";
    конец
    вернуть целое_в_текст(м) + " мин";
конец

функция слово_ядер(целое н): текст
    если (н % 10 == 1 и н % 100 != 11)
        вернуть "ядро";
    конец
    если (н % 10 больше 1 и н % 10 меньше 5 и (н % 100 меньше 10 или н % 100 не меньше 20))
        вернуть "ядра";
    конец
    вернуть "ядер";
конец

функция в_нижнем(текст с): текст
