функция начинается(текст с, текст начало): верно
    если (длина(с) меньше длина(начало))
        вернуть нет;
    конец
    результат из текста р = подстрока(с, 0, длина(начало));
    вернуть р.успешно и р.значение == начало;
конец

функция основа_адреса(Состояние с): текст
    текст а = обрезать_края(с.адрес);
    пока (длина(а) больше 0 и целое(байт_текста(а, длина(а) - 1)) == 47)
        результат из текста р = подстрока(а, 0, длина(а) - 1);
        если ( не р.успешно)
            вернуть а;
        конец
        а = р.значение;
    конец
    результат из целого есть_схема = найти(а, "://");
    если ( не есть_схема.успешно)
        // Без схемы: адрес с портом или localhost — это тестовый сервер, он обычно без https.
        результат из целого есть_порт = найти(а, ":");
        если (есть_порт.успешно или начинается(а, "localhost"))
            а = "http://" + а;
        иначе
            а = "https://" + а;
        конец
    конец
    вернуть а;
конец

