    вернуть 0;
конец

// 0 обычный файл, 1 папка, 2 программа (спрашиваем перед запуском), 3 архив или пакет.
функция вид_файла(текст имя, целое папка): целое
    если (папка == 1)
        вернуть 1;
    конец
    если (опасное_имя(имя))
        вернуть 2;
    конец
    текст н = в_нижнем(имя);
    если (оканчивается(н, ".zip") или оканчивается(н, ".apk") или оканчивается(н, ".bin") или оканчивается(н, ".vsix"))
        вернуть 3;
    конец
    вернуть 0;
конец

функция разобрать_список(текст зос, Список из текстов т, Список из целых ч): целое
    очистить_тексты(т);
    очистить_целые(ч);
    результат из целого н = зос_размер(зос, "записи");
    если ( не н.успешно)
        вернуть 0;
    конец
    целое предел = н.значение;
    если (предел больше 1000)
        предел = 1000;
    конец
    целое ин = 0;
    пока (ин меньше предел)
        текст база = "записи." + целое_в_текст(ин) + ".";
        текст имя = текст_поля(зос, база + "имя");
        целое папка = 0;
        результат из целого п = зос_логическое(зос, база + "папка");
        если (п.успешно и п.значение == 1)
            папка = 1;
        конец
        целое размер = число_поля(зос, база + "размер");
        целое дата = число_поля(зос, база + "изменён");
        добавить_запись(т, ч, имя, папка, размер, дата);
        ин = ин + 1;
    конец
    вернуть предел;
конец

функция добавить_запись(Список из текстов т, Список из целых ч, текст имя, целое папка, целое размер, целое дата): целое
    т.добавить(имя);
    т.добавить(обрезать(имя, 33));
    т.добавить(обрезать(имя, 26));
    если (папка == 1)
        т.добавить(дата_файла(дата));
        т.добавить("папка");
    иначе
        т.добавить(размер_в_текст(размер) + "  ·  " + дата_файла(дата));
        т.добавить(размер_в_текст(размер));
    конец
    ч.добавить(папка);
    ч.добавить(размер);
    ч.добавить(дата);
    ч.добавить(вид_файла(имя, папка));
    вернуть 0;
конец

// Компактный список от сервера: «СПИСОК1», всего(10), записей(10), затем записи фиксированной ширины
// папка(1) размер(12) изменён(12) длина_имени(3) имя. Читается за один проход, без поиска по тексту.
функция число_из_части(текст о, целое от, целое сколько): целое
    результат из целого р = текст_в_целое(часть_текста(о, от, сколько));
    если (р.успешно)
        вернуть р.значение;
    конец
    вернуть 0;
конец

функция разобрать_компактный(текст о, Список из текстов т, Список из целых ч): целое
    очистить_тексты(т);
    очистить_целые(ч);
    целое число = число_из_части(о, 23, 10);
    целое байт = длина(о);
    целое поз = 33;
    целое ин = 0;
    пока (ин меньше число и поз + 28 не больше байт)
        целое папка = число_из_части(о, поз, 1);
        целое размер = число_из_части(о, поз + 1, 12);
        целое дата = число_из_части(о, поз + 13, 12);
        целое дл = число_из_части(о, поз + 25, 3);
        текст имя = часть_текста(о, поз + 28, дл);
        добавить_запись(т, ч, имя, папка, размер, дата);
        поз = поз + 28 + дл;
        ин = ин + 1;
    конец
    вернуть ин;
конец

функция путь_внутри(Состояние с, текст имя): текст
    если (длина(с.путь) == 0)
        вернуть имя;
    конец
    вернуть с.путь + "/" + имя;
конец

функция папка_выше(текст путь): текст
    текст итог = "";
    целое п = длина(путь) - 1;
    пока (п не меньше 0)
        если (целое(байт_текста(путь, п)) == 47)
            результат из текста р = подстрока(путь, 0, п);
            если (р.успешно)
                итог = р.значение;
            конец
            вернуть итог;
        конец
        п = п - 1;
    конец
    вернуть "";
конец

функция перейти_без_истории(Состояние с, текст путь): целое
    // «Обновить» вызывает перейти(с, с.путь): не присваиваем строку самой себе.
    если (путь != с.путь)
        с.путь = путь;
        с.стр = 0;
        с.всего = 0;
    конец
    с.выбрано = 0 - 1;
    с.прокрутка = 0;
    с.список_есть = 0;
    с.список_ошибка = "";
    с.путь_показ = обрезать("/" + с.путь, 34);
    с.покой = "Подключено. Папка на сервере: /" + с.путь;
    с.грязно = 1;
    запросить_список(с);
    вернуть 0;
конец

// ---------- история переходов (кнопки < и >) ----------
// Стек — одна строка: каждый путь заканчивается «\n» (корень — пустой путь, то есть просто «\n»).
функция часть_текста(текст т, целое от, целое сколько): текст
    если (сколько не больше 0)
        вернуть "";
    конец
    результат из текста р = подстрока(т, от, сколько);
    если (р.успешно)
        вернуть р.значение;
    конец
    вернуть "";
конец

функция начало_верха(текст стек): целое
    целое п = длина(стек) - 2;
    пока (п не меньше 0 и целое(байт_текста(стек, п)) != 10)
        п = п - 1;
    конец
    вернуть п + 1;
конец

функция верх_стека(текст стек): текст
    если (длина(стек) == 0)
        вернуть "";
    конец
    целое н = начало_верха(стек);
    вернуть часть_текста(стек, н, длина(стек) - 1 - н);
конец

функция без_верха(текст стек): текст
    если (длина(стек) == 0)
        вернуть "";
    конец
    вернуть часть_текста(стек, 0, начало_верха(стек));
конец

// Не даём истории расти бесконечно: выбрасываем самое старое.
функция укоротить_стек(текст стек): текст
    если (длина(стек) меньше 4000)
        вернуть часть_текста(стек, 0, длина(стек));   // копия: возвращать сам аргумент нельзя (временная строка)
    конец
    целое п = 2000;
    пока (п меньше длина(стек) и целое(байт_текста(стек, п)) != 10)
        п = п + 1;
    конец
    вернуть часть_текста(стек, п + 1, длина(стек) - п - 1);
конец

функция перейти(Состояние с, текст путь): целое
    если (путь != с.путь)
        с.назад = укоротить_стек(с.назад + с.путь + "\n");
        с.вперёд = "";
    конец
    перейти_без_истории(с, путь);
    вернуть 0;
конец

функция шаг_назад(Состояние с): целое
    если (длина(с.назад) == 0)
        вернуть 0;
    конец
    текст цель = верх_стека(с.назад);
    с.назад = без_верха(с.назад);
    с.вперёд = с.вперёд + с.путь + "\n";
    перейти_без_истории(с, цель);
    вернуть 0;
конец

функция шаг_вперёд(Состояние с): целое
    если (длина(с.вперёд) == 0)
        вернуть 0;
    конец
    текст цель = верх_стека(с.вперёд);
    с.вперёд = без_верха(с.вперёд);
    с.назад = укоротить_стек(с.назад + с.путь + "\n");
    перейти_без_истории(с, цель);
    вернуть 0;
конец

функция сбросить_историю(Состояние с): целое
    с.назад = "";
    с.вперёд = "";
    вернуть 0;
конец

