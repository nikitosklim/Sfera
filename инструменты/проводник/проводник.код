конец

// Тексты панели собирает собрать_инфо один раз на ответ сервера (раз в 5 секунд), а здесь только рисуем.
// инфо_т: 0 хост, 1 ОС, 2 ядро, 3 память %, 4 память занято, 5 память свободно, 6 диск %, 7 диск занято,
// 8 диск свободно, 9 процессор, 10 ядер, 11 нагрузка, 12 время работы, 13 подкачка.
// инфо_ч: 0 память занято, 1 память всего, 2 диск занято, 3 диск всего (в байтах).
функция собрать_инфо(текст зос, Список из текстов т, Список из целых ч): целое
    очистить_тексты(т);
    очистить_целые(ч);
    целое всего_п = число_поля(зос, "память_всего_кб") * 1024;
    целое доступно_п = число_поля(зос, "память_доступно_кб") * 1024;
    целое занято_п = всего_п - доступно_п;
    целое всего_д = число_поля(зос, "диск_всего");
    целое своб_д = число_поля(зос, "диск_свободно");
    целое занято_д = всего_д - своб_д;
    целое ядер = число_поля(зос, "ядер");
    целое своп = число_поля(зос, "своп_всего_кб") * 1024;
    т.добавить(обрезать(текст_поля(зос, "хост"), 18));
    т.добавить(обрезать(текст_поля(зос, "ос"), 30));
    т.добавить("ядро " + обрезать(текст_поля(зос, "ядро"), 24));
    т.добавить(процент(занято_п, всего_п));
    т.добавить("занято " + размер_в_текст(занято_п));
    т.добавить("свободно " + размер_в_текст(доступно_п) + " из " + размер_в_текст(всего_п));
    т.добавить(процент(занято_д, всего_д));
    т.добавить("занято " + размер_в_текст(занято_д));
    т.добавить("свободно " + размер_в_текст(своб_д) + " из " + размер_в_текст(всего_д));
    т.добавить(обрезать(текст_поля(зос, "процессор"), 27));
    т.добавить(целое_в_текст(ядер) + " " + слово_ядер(ядер));
    т.добавить("нагрузка " + текст_поля(зос, "нагрузка"));
    т.добавить(время_работы(число_поля(зос, "время_работы_сек")));
    если (своп больше 0)
        целое своп_св = число_поля(зос, "своп_свободно_кб") * 1024;
        т.добавить("подкачка " + размер_в_текст(своп - своп_св) + " из " + размер_в_текст(своп));
    иначе
        т.добавить("подкачки нет");
    конец
    ч.добавить(занято_п);
    ч.добавить(всего_п);
    ч.добавить(занято_д);
    ч.добавить(всего_д);
    вернуть 0;
конец

