функция писать(Кисть к, текст шрифт, текст строка, целое х, целое у, целое с): целое
    если (длина(строка) == 0)
        вернуть 0;
    конец
    беззнак32 ц = беззнак32(4278190080 + (с / 65536) + ((с / 256) % 256) * 256 + (с % 256) * 65536);
    текст пов = отрисовать_текст(шрифт, строка, ц);
    текст тек = создать_текстуру(пх(к.холст), пов);
    узнать_размер_текстуры(тек, нулевой_указатель(), нулевой_указатель(), пх(к.бш), пх(к.бв));
    записать_целое32(пх(к.бо), 0, целое32(х));
    записать_целое32(пх(к.бо), 4, целое32(у));
    записать_целое32(пх(к.бо), 8, целое32(целое(прочитать_целое32(пх(к.бш), 0)) / к.масштаб));
    записать_целое32(пх(к.бо), 12, целое32(целое(прочитать_целое32(пх(к.бв), 0)) / к.масштаб));
    показать_текстуру(пх(к.холст), тек, нулевой_указатель(), пх(к.бо));
    освободить_поверхность(пов);
    уничтожить_текстуру(тек);
    вернуть 0;
конец

