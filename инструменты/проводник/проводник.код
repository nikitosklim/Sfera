неизменно целое СТРОКА_ВЫС = 38;
неизменно целое СПИСОК_ВЕРХ = 70;
неизменно целое СПИСОК_НИЗ = 520;

функция видимых_строк(): целое
    вернуть (СПИСОК_НИЗ - СПИСОК_ВЕРХ) / СТРОКА_ВЫС;
конец

функция смещение_строк(Состояние с): целое
