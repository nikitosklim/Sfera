// Одинарные кавычки внутри значения для sh: ' -> '\''
функция для_оболочки(текст с): текст
    текст итог = "";
    целое п = 0;
    пока (п меньше длина(с))
        результат из текста один = подстрока(с, п, 1);
        если (один.успешно и один.значение == "'")
            итог = итог + "'\\''";
        иначе
            если (один.успешно)
                итог = итог + один.значение;
            конец
        конец
        п = п + 1;
    конец
    вернуть итог;
конец

