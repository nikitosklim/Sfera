// ---------- экран входа ----------
функция поле_ввода(Кисть к, Состояние с, текст подпись, текст значение, целое у, целое активно, целое скрыть): целое
    писать(к, пх(к.мелкий), подпись, 120, у - 20, Ц_ТИХИЙ);
    залить_скругл(к, Ц_ФОН, 120, у, 360, 36, 6);
    если (активно == 1)
        рамка(к, Ц_СИНИЙ, 120, у, 360, 36);
        рамка(к, Ц_СИНИЙ, 121, у + 1, 358, 34);
    иначе
        рамка(к, Ц_ЛИНИЯ, 120, у, 360, 36);
    конец
    текст видимое = значение;
    если (скрыть == 1)
        видимое = "";
        целое н = длина(значение);
        если (н больше 30)
            н = 30;
        конец
        целое ин = 0;
        пока (ин меньше н)
            видимое = видимое + "•";
            ин = ин + 1;
        конец
    иначе
        видимое = обрезать(значение, 38);
    конец
    писать(к, пх(к.шрифт), видимое, 132, у + 8, Ц_ТЕКСТ);
    если (активно == 1 и (с.кадр / 15) % 2 == 0)
        залить(к, Ц_ТЕКСТ, 134 + ширина_строки(к, пх(к.шрифт), видимое), у + 8, 2, 20);
    конец
    вернуть 0;
