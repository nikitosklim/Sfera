функция открыть_строку(Состояние с, целое строка, Список из текстов т, Список из целых ч): целое
    целое сдвиг = смещение_строк(с);
    если (сдвиг == 1 и строка == 0)
        перейти(с, папка_выше(с.путь));
        вернуть 0;
    конец
    целое ин = строка - сдвиг;
    если (ин меньше 0 или ин не меньше ч.размер() / 4)
        вернуть 0;
    конец
    текст имя = т.получить(ин * 5);
    целое размер = ч.получить(ин * 4 + 1);
    если (ч.получить(ин * 4) == 1)
        перейти(с, путь_внутри(с, имя));
        вернуть 0;
    конец
    если (ч.получить(ин * 4 + 3) == 2)
        с.спросить = путь_внутри(с, имя);
        с.файл_всего = размер;
        с.грязно = 1;
        вернуть 0;
    конец
    скачать(с, путь_внутри(с, имя), имя, размер, 1);
    вернуть 0;
конец

функция показать_выбранную(Состояние с, целое всего): целое
    если (с.выбрано меньше с.прокрутка)
        с.прокрутка = с.выбрано;
    конец
    если (с.выбрано не меньше с.прокрутка + видимых_строк())
        с.прокрутка = с.выбрано - видимых_строк() + 1;
    конец
    вернуть 0;
конец

функция ограничить_прокрутку(Состояние с, целое всего): целое
    целое предел = всего - видимых_строк();
    если (предел меньше 0)
        предел = 0;
    конец
    если (с.прокрутка больше предел)
        с.прокрутка = предел;
    конец
    если (с.прокрутка меньше 0)
        с.прокрутка = 0;
    конец
    вернуть 0;
конец

функция нажата_вставка(целое мод): верно
    вернуть (мод / 64) % 4 != 0 или (мод / 1024) % 4 != 0;
конец

// Возвращает 1, если нужно закрыть окно.
функция событие(Состояние с, текст буф, Список из текстов т, Список из целых ч): целое
    целое тип = целое(прочитать_целое32(буф, 0));
    если (тип == 256)
        вернуть 1;
    конец
    если (тип == 1024)
        с.мышь_х = целое(прочитать_целое32(буф, 20));
        с.мышь_у = целое(прочитать_целое32(буф, 24));
        вернуть 0;
    конец

    // ----- вход -----
    если (с.экран == 0)
        если (тип == 771)
            вставить_в_поле(с, прочитать_текст_по_смещению(буф, 12));
        иначе если (тип == 768)
            целое клавиша = целое(прочитать_целое32(буф, 20));
            целое мод = целое(прочитать_целое32(буф, 24)) % 65536;
            если (клавиша == 8)
                если (с.поле == 0)
                    с.адрес = удалить_последний_символ(с.адрес);
                иначе
                    с.токен = удалить_последний_символ(с.токен);
                конец
            иначе если (клавиша == 9)
                с.поле = 1 - с.поле;
            иначе если (клавиша == 13)
                если (с.поле == 0)
                    с.поле = 1;
                иначе
                    подключиться(с);
                конец
            иначе если (клавиша == 118 и нажата_вставка(мод))
                вставить_в_поле(с, обрезать_края(буфер_обмена_текст()));
            конец
        иначе если (тип == 1025)
            целое х = целое(прочитать_целое32(буф, 20));
            целое у = целое(прочитать_целое32(буф, 24));
            если (внутри(х, у, 120, 190, 360, 36))
                с.поле = 0;
            иначе если (внутри(х, у, 120, 266, 360, 36))
                с.поле = 1;
            иначе если (внутри(х, у, 120, 346, 360, 42))
                подключиться(с);
            конец
        конец
        вернуть 0;
    конец

    // ----- окно подтверждения -----
    если (длина(с.спросить) больше 0)
        если (тип == 768)
            если (целое(прочитать_целое32(буф, 20)) == 27)
                с.спросить = "";
            конец
        иначе если (тип == 1025)
            целое х = целое(прочитать_целое32(буф, 20));
            целое у = целое(прочитать_целое32(буф, 24));
            текст путь = с.спросить;
            // Сначала скачиваем, потом стираем поле: «путь» указывает на ту же строку, что и с.спросить.
            если (внутри(х, у, 94, 336, 200, 40))
                скачать(с, путь, имя_из_пути(путь), с.файл_всего, 1);
                с.спросить = "";
            иначе если (внутри(х, у, 302, 336, 130, 40))
                скачать(с, путь, имя_из_пути(путь), с.файл_всего, 0);
                с.спросить = "";
            иначе если (внутри(х, у, 440, 336, 76, 40))
                с.спросить = "";
            конец
        конец
        вернуть 0;
    конец

    // ----- проводник -----
    целое всего = ч.размер() / 4 + смещение_строк(с);
    если (тип == 1027)
        с.прокрутка = с.прокрутка - целое(прочитать_целое32(буф, 20)) * 2;
        ограничить_прокрутку(с, всего);
    иначе если (тип == 768)
        целое клавиша = целое(прочитать_целое32(буф, 20));
        если (клавиша == 1073741905 и с.список_есть == 1)
            если (с.выбрано меньше всего - 1)
                с.выбрано = с.выбрано + 1;
            конец
            показать_выбранную(с, всего);
        иначе если (клавиша == 1073741906 и с.список_есть == 1)
            если (с.выбрано больше 0)
                с.выбрано = с.выбрано - 1;
            конец
            показать_выбранную(с, всего);
        иначе если (клавиша == 13 и с.выбрано не меньше 0)
            открыть_строку(с, с.выбрано, т, ч);
        иначе если (клавиша == 8 и длина(с.путь) больше 0)
            перейти(с, папка_выше(с.путь));
        иначе если (клавиша == 1073741886)
            перейти(с, с.путь);
            запросить_инфо(с);
        конец
    иначе если (тип == 1025)
        целое х = целое(прочитать_целое32(буф, 20));
        целое у = целое(прочитать_целое32(буф, 24));
        если (внутри(х, у, 432, 7, 84, 26))
            перейти(с, с.путь);
            запросить_инфо(с);
        иначе если (внутри(х, у, 524, 7, 66, 26))
            выйти_из_сервера(с, "");
        иначе если (внутри(х, у, 262, 528, 88, 34) и с.выбрано не меньше 0 и с.список_есть == 1)
            целое сдвиг = смещение_строк(с);
            целое ин = с.выбрано - сдвиг;
            если (ин не меньше 0 и ин меньше ч.размер() / 4)
                если (ч.получить(ин * 4) == 1)
                    открыть_строку(с, с.выбрано, т, ч);
                иначе
                    скачать(с, путь_внутри(с, т.получить(ин * 5)), т.получить(ин * 5), ч.получить(ин * 4 + 1), 0);
                конец
            конец
        иначе если (с.список_есть == 1 и внутри(х, у, 0, СПИСОК_ВЕРХ, 354, СПИСОК_НИЗ - СПИСОК_ВЕРХ))
            целое строка = с.прокрутка + (у - СПИСОК_ВЕРХ) / СТРОКА_ВЫС;
            если (строка меньше всего)
                если (строка == с.прошлая_строка и с.кадр - с.прошлый_клик меньше 16)
                    открыть_строку(с, строка, т, ч);
                    с.прошлая_строка = 0 - 1;
                иначе
                    с.выбрано = строка;
                    с.прошлая_строка = строка;
                    с.прошлый_клик = с.кадр;
                конец
            конец
        конец
    конец
    вернуть 0;
конец

