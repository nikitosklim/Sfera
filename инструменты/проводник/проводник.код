// Кнопка: возвращает да, если мышь над ней (клик обрабатывает вызывающий).
функция кнопка(Кисть к, Состояние с, текст подпись, целое х, целое у, целое ш, целое выс, целое основной): верно
    верно над = внутри(с.мышь_х, с.мышь_у, х, у, ш, выс);
    целое фон = Ц_ПАНЕЛЬ2;
    если (основной == 1)
        фон = Ц_СИНИЙ;
    конец
    если (над и основной == 0)
        фон = Ц_ЛИНИЯ;
    конец
    если (над и основной == 1)
        фон = 0x6ba0ff;
    конец
    залить_скругл(к, фон, х, у, ш, выс, 6);
    если (основной == 0)
        рамка(к, Ц_ЛИНИЯ, х, у, ш, выс);
    конец
    писать_по_центру(к, пх(к.шрифт), подпись, х + ш / 2, у + (выс - 20) / 2, Ц_ТЕКСТ);
    вернуть над;
конец

