    конец
    вернуть 0;
конец

функция иконка(Кисть к, целое х, целое у, целое вид): целое
    если (вид == 1)
        залить_скругл(к, Ц_ПАПКА, х, у + 3, 12, 6, 2);
        залить_скругл(к, Ц_ПАПКА, х, у + 6, 24, 16, 3);
    иначе
        целое с = 0x9db4e8;
        если (вид == 2)
            с = Ц_ЗЕЛЁНЫЙ;
        конец
        если (вид == 3)
            с = Ц_ЖЁЛТЫЙ;
        конец
        залить_скругл(к, с, х + 3, у, 18, 24, 3);
        залить(к, Ц_ФОН, х + 8, у + 8, 8, 2);
        залить(к, Ц_ФОН, х + 8, у + 13, 8, 2);
        залить(к, Ц_ФОН, х + 8, у + 18, 5, 2);
    конец
    вернуть 0;
конец

функция нарисовать_список(Кисть к, Состояние с, Список из текстов т, Список из целых ч): целое
    залить(к, Ц_ФОН, 0, 40, 360, 530);
    залить(к, Ц_ПАНЕЛЬ, 0, 40, 360, 26);
    писать(к, пх(к.мелкий), с.путь_показ, 12, 45, Ц_ТИХИЙ);
    залить(к, Ц_ЛИНИЯ, 0, 66, 360, 1);

    если (с.список_есть == 0)
        если (длина(с.список_ошибка) больше 0)
            писать_по_центру(к, пх(к.шрифт), с.список_ошибка, 180, 250, Ц_КРАСНЫЙ);
            писать_по_центру(к, пх(к.мелкий), "нажми «Обновить» или F5", 180, 280, Ц_ТИХИЙ);
        иначе
            писать_по_центру(к, пх(к.шрифт), "Загружаю список…", 180, 250, Ц_ТИХИЙ);
        конец
        вернуть 0;
    конец

    целое число = ч.размер() / 4;
    целое сдвиг = смещение_строк(с);
    целое всего = число + сдвиг;
    если (всего == 0)
        писать_по_центру(к, пх(к.шрифт), "Папка пуста", 180, 250, Ц_ТИХИЙ);
        вернуть 0;
    конец

    целое р = 0;
    пока (р меньше видимых_строк())
        целое номер = с.прокрутка + р;
        если (номер меньше всего)
            целое у = СПИСОК_ВЕРХ + р * СТРОКА_ВЫС;
            если (номер == с.выбрано)
                залить(к, 0x1d3566, 0, у, 360, СТРОКА_ВЫС);
                залить(к, Ц_СИНИЙ, 0, у, 3, СТРОКА_ВЫС);
            иначе
                если (внутри(с.мышь_х, с.мышь_у, 0, у, 360, СТРОКА_ВЫС))
                    залить(к, Ц_ПАНЕЛЬ, 0, у, 360, СТРОКА_ВЫС);
                конец
            конец
            если (сдвиг == 1 и номер == 0)
                иконка(к, 14, у + 7, 1);
                писать(к, пх(к.шрифт), "..", 52, у + 4, Ц_ТЕКСТ);
                писать(к, пх(к.мелкий), "на уровень выше", 52, у + 22, Ц_ТИХИЙ);
            иначе
                целое ин = номер - сдвиг;
                иконка(к, 14, у + 7, ч.получить(ин * 4 + 3));
                писать(к, пх(к.шрифт), т.получить(ин * 5 + 1), 52, у + 4, Ц_ТЕКСТ);
                писать(к, пх(к.мелкий), т.получить(ин * 5 + 3), 52, у + 22, Ц_ТИХИЙ);
            конец
            залить(к, Ц_ПАНЕЛЬ, 12, у + СТРОКА_ВЫС - 1, 336, 1);
        конец
        р = р + 1;
    конец

    // полоса прокрутки
    если (всего больше видимых_строк())
        целое высота = СПИСОК_НИЗ - СПИСОК_ВЕРХ;
        целое ползунок = высота * видимых_строк() / всего;
        если (ползунок меньше 24)
            ползунок = 24;
        конец
        целое ход = высота - ползунок;
        целое пред = всего - видимых_строк();
        целое смещ = ход * с.прокрутка / пред;
        залить_скругл(к, Ц_ЛИНИЯ, 354, СПИСОК_ВЕРХ + смещ, 4, ползунок, 2);
    конец
    вернуть 0;
конец

