функция значение_ключа(текст все, текст ключ): текст
    текст с = "\n" + все;
    результат из целого где = найти(с, "\n" + ключ + "=");
    если ( не где.успешно)
        вернуть "";
    конец
    целое от = где.значение + длина(ключ) + 2;
    результат из текста хвост = подстрока(с, от, длина(с) - от);
    если ( не хвост.успешно)
        вернуть "";
    конец
    результат из целого конец_строки = найти(хвост.значение, "\n");
    если ( не конец_строки.успешно)
        вернуть обрезать_края(хвост.значение);
    конец
    результат из текста строка = подстрока(хвост.значение, 0, конец_строки.значение);
    если (строка.успешно)
        вернуть обрезать_края(строка.значение);
    конец
    вернуть "";
конец

