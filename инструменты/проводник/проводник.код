функция скрипт_запроса(Состояние с, текст метод_путь, текст путь_параметр, целое слот, целое время): текст
    текст д = "$";
    текст готово = для_оболочки(путь_слота(слот, "done"));
    текст итог = "c=" + д + "(curl -sS -m " + целое_в_текст(время) + " -H @'" + для_оболочки(путь_заголовка()) + "' -G ";
    если (длина(путь_параметр) больше 0 или метод_путь == "/api/файлы")
        итог = итог + "--data-urlencode 'путь=" + для_оболочки(путь_параметр) + "' ";
    конец
    итог = итог + "-o '" + для_оболочки(путь_слота(слот, "out")) + "' -w '%{http_code}' '" + для_оболочки(основа_адреса(с) + метод_путь) + "' 2>/dev/null)\n";
    итог = итог + "echo " + д + "c > '" + готово + ".tmp'; mv '" + готово + ".tmp' '" + готово + "'\n";
    вернуть итог;
конец

функция запросить_список(Состояние с): целое
    записать_заголовок(с);
    если (запустить_слот(1, скрипт_запроса(с, "/api/файлы", с.путь, 1, 10)))
        с.ждём_список = 1;
    иначе
        с.список_ошибка = "Не удалось запустить запрос";
    конец
    вернуть 0;
конец

функция запросить_инфо(Состояние с): целое
    записать_заголовок(с);
    если (запустить_слот(2, скрипт_запроса(с, "/api/сервер", "", 2, 8)))
        с.ждём_инфо = 1;
    конец
    с.инфо_кадр = с.кадр;
    вернуть 0;
конец

функция оканчивается(текст с, текст хвост): верно
    если (длина(с) меньше длина(хвост))
        вернуть нет;
    конец
    результат из текста р = подстрока(с, длина(с) - длина(хвост), длина(хвост));
    вернуть р.успешно и р.значение == хвост;
конец

// Расширения программ: перед запуском с сервера спрашиваем.
функция опасное_имя(текст имя): верно
    текст н = в_нижнем(имя);
    если (оканчивается(н, ".sh") или оканчивается(н, ".command") или оканчивается(н, ".app") или оканчивается(н, ".exe"))
        вернуть да;
    конец
    если (оканчивается(н, ".bat") или оканчивается(н, ".cmd") или оканчивается(н, ".ps1") или оканчивается(н, ".msi"))
        вернуть да;
    конец
    если (оканчивается(н, ".dmg") или оканчивается(н, ".pkg") или оканчивается(н, ".jar") или оканчивается(н, ".run"))
        вернуть да;
    конец
    если (оканчивается(н, ".appimage") или оканчивается(н, ".deb") или оканчивается(н, ".rpm") или оканчивается(н, ".scr"))
        вернуть да;
    конец
    вернуть нет;
конец

функция сказать(Состояние с, текст сообщение): целое
    с.статус = обрезать(сообщение, 80);
    с.статус_кадр = с.кадр;
    с.грязно = 1;
    вернуть 0;
конец

// Скачивает файл (путь относительно корня) в кэш. открыть = 1 — открыть, 0 — показать в папке.
функция скачать(Состояние с, текст путь, текст имя, целое всего, целое открыть): целое
    если (с.ждём_файл == 1)
        сказать(с, "Уже идёт скачивание — дождись конца");
        вернуть 0;
    конец
    записать_заголовок(с);
    текст д = "$";
    текст часть = для_оболочки(папка_кэша() + "/" + имя + ".part");
    текст файл = для_оболочки(папка_кэша() + "/" + имя);
    текст готово = для_оболочки(путь_слота(3, "done"));
    текст т = "c=" + д + "(curl -sS -m 7200 -H @'" + для_оболочки(путь_заголовка()) + "' -G --data-urlencode 'путь=" + для_оболочки(путь) + "' -o '" + часть + "' -w '%{http_code}' '" + для_оболочки(основа_адреса(с) + "/api/скачать") + "' 2>/dev/null)\n";
    т = т + "if [ \"" + д + "c\" = 200 ]; then mv -f '" + часть + "' '" + файл + "'; ";
    если (открыть == 1)
        т = т + "if [ \"" + д + "(uname)\" = Darwin ]; then open '" + файл + "'; else xdg-open '" + файл + "' >/dev/null 2>&1; fi; ";
    иначе
        т = т + "if [ \"" + д + "(uname)\" = Darwin ]; then open -R '" + файл + "'; else xdg-open '" + для_оболочки(папка_кэша()) + "' >/dev/null 2>&1; fi; ";
    конец
    т = т + "else rm -f '" + часть + "'; fi\n";
    т = т + "echo " + д + "c > '" + готово + ".tmp'; mv '" + готово + ".tmp' '" + готово + "'\n";
    если (запустить_слот(3, т))
        с.ждём_файл = 1;
        с.файл_имя = имя;
        с.файл_всего = всего;
        с.файл_открыть = открыть;
        сказать(с, "Скачиваю «" + обрезать(имя, 28) + "»…");
    иначе
        сказать(с, "Не удалось начать скачивание");
    конец
    вернуть 0;
конец

// ---------- разбор ответов ----------
функция число_поля(текст зос, текст путь): целое
    результат из целого р = зос_целое(зос, путь);
    если (р.успешно)
        вернуть р.значение;
    конец
    вернуть 0;
конец

функция текст_поля(текст зос, текст путь): текст
    результат из текста р = зос_текст(зос, путь);
    если (р.успешно)
        вернуть р.значение;
    конец
    вернуть "";
конец

// Все подписи строк готовятся ОДИН раз здесь, а не при каждой перерисовке: в Сфере текстовые
// временные значения пока не освобождаются сами, и пересборка строк на каждом кадре копила бы память.
// т: по 5 текстов на запись — [0] имя, [1] имя до 33 символов, [2] имя до 26, [3] подпись под именем,
//    [4] размер словами. ч: по 4 числа — [0] папка (1/0), [1] размер, [2] изменён, [3] вид (см. вид_файла).
функция очистить_тексты(Список из текстов л): целое
    // .освободить() оставил бы висящий указатель, поэтому чистим удалением с конца.
    пока (л.размер() больше 0)
        л.удалить(л.размер() - 1);
    конец
    вернуть 0;
конец

функция очистить_целые(Список из целых л): целое
    пока (л.размер() больше 0)
        л.удалить(л.размер() - 1);
    конец
    вернуть 0;
конец

// 0 обычный файл, 1 папка, 2 программа (спрашиваем перед запуском), 3 архив или пакет.
функция вид_файла(текст имя, целое папка): целое
    если (папка == 1)
        вернуть 1;
    конец
    если (опасное_имя(имя))
        вернуть 2;
    конец
    текст н = в_нижнем(имя);
    если (оканчивается(н, ".zip") или оканчивается(н, ".apk") или оканчивается(н, ".bin") или оканчивается(н, ".vsix"))
        вернуть 3;
    конец
    вернуть 0;
конец

функция разобрать_список(текст зос, Список из текстов т, Список из целых ч): целое
    очистить_тексты(т);
    очистить_целые(ч);
    результат из целого н = зос_размер(зос, "записи");
    если ( не н.успешно)
        вернуть 0;
    конец
    целое предел = н.значение;
    если (предел больше 1000)
        предел = 1000;
    конец
    целое ин = 0;
    пока (ин меньше предел)
        текст база = "записи." + целое_в_текст(ин) + ".";
        текст имя = текст_поля(зос, база + "имя");
        целое папка = 0;
        результат из целого п = зос_логическое(зос, база + "папка");
        если (п.успешно и п.значение == 1)
            папка = 1;
        конец
        целое размер = число_поля(зос, база + "размер");
        целое дата = число_поля(зос, база + "изменён");
        т.добавить(имя);
        т.добавить(обрезать(имя, 33));
        т.добавить(обрезать(имя, 26));
        если (папка == 1)
            т.добавить(дата_файла(дата));
            т.добавить("папка");
        иначе
            т.добавить(размер_в_текст(размер) + "  ·  " + дата_файла(дата));
            т.добавить(размер_в_текст(размер));
        конец
        ч.добавить(папка);
        ч.добавить(размер);
        ч.добавить(дата);
        ч.добавить(вид_файла(имя, папка));
        ин = ин + 1;
    конец
    вернуть предел;
конец

функция путь_внутри(Состояние с, текст имя): текст
    если (длина(с.путь) == 0)
        вернуть имя;
    конец
    вернуть с.путь + "/" + имя;
конец

функция папка_выше(текст путь): текст
    текст итог = "";
    целое п = длина(путь) - 1;
    пока (п не меньше 0)
        если (целое(байт_текста(путь, п)) == 47)
            результат из текста р = подстрока(путь, 0, п);
            если (р.успешно)
                итог = р.значение;
            конец
            вернуть итог;
        конец
        п = п - 1;
    конец
    вернуть "";
конец

функция перейти(Состояние с, текст путь): целое
    // «Обновить» вызывает перейти(с, с.путь): не присваиваем строку самой себе.
    если (путь != с.путь)
        с.путь = путь;
    конец
    с.выбрано = 0 - 1;
    с.прокрутка = 0;
    с.список_есть = 0;
    с.список_ошибка = "";
    с.путь_показ = обрезать("/" + с.путь, 44);
    с.покой = "Подключено. Папка на сервере: /" + с.путь;
    с.грязно = 1;
    запросить_список(с);
    вернуть 0;
конец

// ---------- сведения о сервере ----------
функция полоса(Кисть к, целое х, целое у, целое ш, целое занято, целое всего): целое
    залить_скругл(к, Ц_ФОН, х, у, ш, 10, 4);
    если (всего больше 0)
        целое доля = занято * 100 / всего;
        целое заполн = ш * доля / 100;
        если (заполн меньше 8 и занято больше 0)
            заполн = 8;
        конец
        целое с = Ц_ЗЕЛЁНЫЙ;
        если (доля не меньше 70)
            с = Ц_ЖЁЛТЫЙ;
        конец
        если (доля не меньше 90)
            с = Ц_КРАСНЫЙ;
        конец
        залить_скругл(к, с, х, у, заполн, 10, 4);
    конец
    рамка(к, Ц_ЛИНИЯ, х, у, ш, 10);
    вернуть 0;
конец

функция процент(целое занято, целое всего): текст
    если (всего меньше 1)
        вернуть "—";
    конец
    вернуть целое_в_текст(занято * 100 / всего) + "%";
конец

функция карточка(Кисть к, целое х, целое у, целое ш, целое выс, текст заголовок): целое
    залить_скругл(к, Ц_ПАНЕЛЬ, х, у, ш, выс, 8);
    рамка(к, Ц_ЛИНИЯ, х + 1, у + 1, ш - 2, выс - 2);
    писать(к, пх(к.мелкий), заголовок, х + 12, у + 8, Ц_ТИХИЙ);
    вернуть 0;
конец

// Тексты панели собирает собрать_инфо один раз на ответ сервера (раз в 5 секунд), а здесь только рисуем.
// инфо_т: 0 хост, 1 ОС, 2 ядро, 3 память %, 4 память занято, 5 память свободно, 6 диск %, 7 диск занято,
// 8 диск свободно, 9 процессор, 10 ядер, 11 нагрузка, 12 время работы, 13 подкачка.
// инфо_ч: 0 память занято, 1 память всего, 2 диск занято, 3 диск всего (в байтах).
функция собрать_инфо(текст зос, Список из текстов т, Список из целых ч): целое
    очистить_тексты(т);
    очистить_целые(ч);
    целое всего_п = число_поля(зос, "память_всего_кб") * 1024;
    целое доступно_п = число_поля(зос, "память_доступно_кб") * 1024;
    целое занято_п = всего_п - доступно_п;
    целое всего_д = число_поля(зос, "диск_всего");
    целое своб_д = число_поля(зос, "диск_свободно");
    целое занято_д = всего_д - своб_д;
    целое ядер = число_поля(зос, "ядер");
    целое своп = число_поля(зос, "своп_всего_кб") * 1024;
    т.добавить(обрезать(текст_поля(зос, "хост"), 18));
    т.добавить(обрезать(текст_поля(зос, "ос"), 30));
    т.добавить("ядро " + обрезать(текст_поля(зос, "ядро"), 24));
    т.добавить(процент(занято_п, всего_п));
    т.добавить("занято " + размер_в_текст(занято_п));
    т.добавить("свободно " + размер_в_текст(доступно_п) + " из " + размер_в_текст(всего_п));
    т.добавить(процент(занято_д, всего_д));
    т.добавить("занято " + размер_в_текст(занято_д));
    т.добавить("свободно " + размер_в_текст(своб_д) + " из " + размер_в_текст(всего_д));
    т.добавить(обрезать(текст_поля(зос, "процессор"), 27));
    т.добавить(целое_в_текст(ядер) + " " + слово_ядер(ядер));
    т.добавить("нагрузка " + текст_поля(зос, "нагрузка"));
    т.добавить(время_работы(число_поля(зос, "время_работы_сек")));
    если (своп больше 0)
        целое своп_св = число_поля(зос, "своп_свободно_кб") * 1024;
        т.добавить("подкачка " + размер_в_текст(своп - своп_св) + " из " + размер_в_текст(своп));
    иначе
        т.добавить("подкачки нет");
    конец
    ч.добавить(занято_п);
    ч.добавить(всего_п);
    ч.добавить(занято_д);
    ч.добавить(всего_д);
    вернуть 0;
конец

