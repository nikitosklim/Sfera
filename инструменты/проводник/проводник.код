// Обрезает по числу СИМВОЛОВ (не байт) и добавляет «…».
функция обрезать(текст с, целое макс): текст
    целое п = 0;
    целое симв = 0;
    пока (п меньше длина(с))
        целое б = целое(байт_текста(с, п));
        если (б меньше 128 или б не меньше 192)
            если (симв == макс)
                результат из текста р = подстрока(с, 0, п);
                если (р.успешно)
                    вернуть р.значение + "…";
                конец
                вернуть с;
            конец
            симв = симв + 1;
        конец
        п = п + 1;
    конец
    // Копия, а не сам «с»: временную строку-аргумент освободят сразу после вызова.
    результат из текста копия = подстрока(с, 0, длина(с));
    если (копия.успешно)
        вернуть копия.значение;
    конец
    вернуть с;
конец

// Убирает пробелы, табы и переводы строк по краям.
функция пробельный(целое б): верно
    вернуть б == 32 или б == 9 или б == 10 или б == 13;
конец

функция обрезать_края(текст с): текст
    целое от = 0;
    целое до = длина(с);
    пока (от меньше до и пробельный(целое(байт_текста(с, от))))
        от = от + 1;
    конец
    пока (до больше от и пробельный(целое(байт_текста(с, до - 1))))
        до = до - 1;
    конец
    результат из текста р = подстрока(с, от, до - от);
    если (р.успешно)
        вернуть р.значение;
    конец
    вернуть "";
конец

функция десятичное(целое десятых): текст
