// почта_мак.код — «Почта Сферы» для macOS: меню стоит в самой верхней строке экрана, как у любой программы Mac.
// Если родное меню по какой-то причине не создалось (или запуск с СФЕРА_ПОЧТА_МЕНЮ=окно), меню рисуется
// внутри окна, как на других системах.
//
// Собирается в приложение скриптом собрать-приложение-macos.sh (рядом).
//
// Вручную:
//   запустить почта_мак.код --линковать SDL2 --линковать SDL2_ttf --линковать m --линковать ssl --линковать crypto --линковать objc

подключить приложение;
подключить меню_мак;

функция главная(): целое
    Кисть к = создать_кисть("Почта Сферы", Ш_ОКНА, В_ОКНА);
    Состояние с = новое_состояние();
    Ящик я = Ящик(0, 0, нет, "", 0);
    Меню м = меню_создать();
    Список из целых элементы = Список из целых();
    Список из целых команды = Список из целых();
    если (окружение("СФЕРА_ПОЧТА_МЕНЮ") != "окно")
        если (родное_меню_создать(м, элементы, команды) == 1)
            с.родное = 1;
        конец
    конец
    начать_сеанс(с);
    текст буфер = выделить_память(128);
    пока (с.выход == 0)
        целое рисовали = оборот(к, с, я, м, буфер);
        если (рисовали == 1 и с.родное == 1)
            родное_меню_обновить(элементы, команды, отключённые(с), отмеченные(с));
        конец
    конец
    закончить_сеанс(я);
    вернуть 0;
конец
