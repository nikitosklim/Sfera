// меню_мак.код — родное меню macOS: строка меню в самом верху экрана (рядом с яблоком и названием программы).
//
// Объективного С здесь нет: меню строится через библиотеку времени выполнения Objective-C (libobjc),
// её функции вызываются напрямую. Латинские слова в строках — это имена классов и сообщений самой macOS
// (NSMenu, setEnabled: и т. п.), они живут только внутри строк.
//
// Пункты берутся из того же списка, что и внутриоконное меню (меню.код): одно описание — два способа показа.
// Выбор пункта превращается в событие пользователя SDL (тип 32768), и клиент выполняет команду так же,
// как при щелчке по внутриоконному меню.
//
// Подключается как "подключить меню_мак;" только в почта_мак.код; сборка с --линковать objc.

подключить меню;

внешняя функция объект_класса(текст имя): целое64 как "objc_getClass";
внешняя функция селектор(текст имя): целое64 как "sel_registerName";
внешняя функция сообщение(целое64 получатель, целое64 имя, целое64 а, целое64 б, целое64 ц, целое64 д): целое64 как "objc_msgSend";
внешняя функция создать_класс(целое64 родитель, текст имя, целое64 лишнее): целое64 как "objc_allocateClassPair";
внешняя функция добавить_метод(целое64 класс, целое64 имя, целое64 реализация, текст типы): целое32 как "class_addMethod";
внешняя функция зарегистрировать_класс(целое64 класс) как "objc_registerClassPair";
внешняя функция отправить_событие_сдл(текст событие): целое32 как "SDL_PushEvent";

// Строка Сферы -> строка macOS (NSString).
функция строка_мак(текст т): целое64
    вернуть сообщение(объект_класса("NSString"), селектор("stringWithUTF8String:"), адрес_текста(т), 0, 0, 0);
конец

функция новый_объект(целое64 класс): целое64
    вернуть сообщение(сообщение(класс, селектор("alloc"), 0, 0, 0, 0), селектор("init"), 0, 0, 0, 0);
конец

// Вызывается macOS, когда выбран пункт меню. Номер команды лежит в «метке» пункта (tag).
функция родное_действие(целое сам, целое выбор, целое отправитель): целое
    целое команда = целое(сообщение(отправитель, селектор("tag"), 0, 0, 0, 0));
    текст событие = выделить_память(64);
    целое ин = 0;
    пока (ин меньше 64)
        записать_байт(событие, ин, 0);
        ин = ин + 1;
    конец
    записать_целое32(событие, 0, целое32(32768));
    записать_целое32(событие, 12, целое32(команда));
    отправить_событие_сдл(событие);
    освободить_память(событие);
    вернуть 0;
конец

// «⌘N» -> «n», «⌘1» -> «1»; всё остальное (Esc, ↓, F11…) без горячей клавиши в macOS.
функция клавиша_пункта(текст сочетание): текст
    если (начинается_с(сочетание, "⌘") и знаков(сочетание) == 2)
        вернуть регистр_в_нижний(срез(сочетание, длина("⌘"), длина(сочетание) - длина("⌘")));
    конец
    вернуть "";
конец

функция добавить_пункт(целое64 подменю, целое64 цель, текст название, текст клавиша, целое команда, Список из целых элементы, Список из целых команды): целое
    целое64 пункт = сообщение(сообщение(объект_класса("NSMenuItem"), селектор("alloc"), 0, 0, 0, 0), селектор("initWithTitle:action:keyEquivalent:"), строка_мак(название), селектор("sferaAction:"), строка_мак(клавиша), 0);
    сообщение(пункт, селектор("setTarget:"), цель, 0, 0, 0);
    сообщение(пункт, селектор("setTag:"), команда, 0, 0, 0);
    сообщение(подменю, селектор("addItem:"), пункт, 0, 0, 0);
    элементы.добавить(целое(пункт));
    команды.добавить(команда);
    вернуть 0;
конец

функция добавить_черту(целое64 подменю): целое
    сообщение(подменю, селектор("addItem:"), сообщение(объект_класса("NSMenuItem"), селектор("separatorItem"), 0, 0, 0, 0), 0, 0, 0);
    вернуть 0;
конец

функция новое_подменю(текст название): целое64
    целое64 подменю = сообщение(сообщение(объект_класса("NSMenu"), селектор("alloc"), 0, 0, 0, 0), селектор("initWithTitle:"), строка_мак(название), 0, 0, 0);
    сообщение(подменю, селектор("setAutoenablesItems:"), 0, 0, 0, 0);
    вернуть подменю;
конец

функция вставить_в_панель(целое64 панель, целое64 подменю, текст название): целое
    целое64 пункт = сообщение(сообщение(объект_класса("NSMenuItem"), селектор("alloc"), 0, 0, 0, 0), селектор("initWithTitle:action:keyEquivalent:"), строка_мак(название), 0, строка_мак(""), 0);
    сообщение(пункт, селектор("setSubmenu:"), подменю, 0, 0, 0);
    сообщение(панель, селектор("addItem:"), пункт, 0, 0, 0);
    вернуть 0;
конец

// Строит меню и ставит его в верх экрана. 1 — получилось; 0 — нет (тогда клиент оставит меню в окне).
функция родное_меню_создать(Меню м, Список из целых элементы, Список из целых команды): целое
    целое64 приложение = сообщение(объект_класса("NSApplication"), селектор("sharedApplication"), 0, 0, 0, 0);
    если (целое(приложение) == 0)
        вернуть 0;
    конец
    целое64 родитель = объект_класса("NSObject");
    если (целое(родитель) == 0)
        вернуть 0;
    конец
    целое64 класс = создать_класс(родитель, "SferaMailMenuHandler", 0);
    если (целое(класс) == 0)
        вернуть 0;
    конец
    добавить_метод(класс, селектор("sferaAction:"), адрес_функции(родное_действие), "v@:@");
    зарегистрировать_класс(класс);
    целое64 цель = новый_объект(класс);
    если (целое(цель) == 0)
        вернуть 0;
    конец

    целое64 панель = сообщение(сообщение(объект_класса("NSMenu"), селектор("alloc"), 0, 0, 0, 0), селектор("initWithTitle:"), строка_мак(""), 0, 0, 0);

    // меню программы: «О программе», «Скрыть», «Выйти»
    целое64 меню_программы = новое_подменю("Почта Сферы");
    добавить_пункт(меню_программы, цель, "О «Почте Сферы»", "", 51, элементы, команды);
    добавить_черту(меню_программы);
    целое64 скрыть = сообщение(сообщение(объект_класса("NSMenuItem"), селектор("alloc"), 0, 0, 0, 0), селектор("initWithTitle:action:keyEquivalent:"), строка_мак("Скрыть «Почту Сферы»"), селектор("hide:"), строка_мак("h"), 0);
    сообщение(скрыть, селектор("setTarget:"), приложение, 0, 0, 0);
    сообщение(меню_программы, селектор("addItem:"), скрыть, 0, 0, 0);
    добавить_черту(меню_программы);
    добавить_пункт(меню_программы, цель, "Выйти из «Почты Сферы»", "q", 5, элементы, команды);
    вставить_в_панель(панель, меню_программы, "Почта Сферы");

    // остальные меню — из общего описания; «Выйти» и «О программе» уже в меню программы
    Список из целых подменю = Список из целых();
    целое н = 0;
    пока (н меньше м.заголовки.размер())
        целое64 п = новое_подменю(м.заголовки.получить(н));
        подменю.добавить(целое(п));
        н = н + 1;
    конец
    целое ин = 0;
    пока (ин меньше м.пункты.размер())
        текст строка = м.пункты.получить(ин);
        целое номер = число_из_текста(поле_пункта(строка, 0));
        целое команда = число_из_текста(поле_пункта(строка, 1));
        если (команда == 5 или команда == 51)
            ин = ин + 1;
        иначе
            целое64 где = целое64(подменю.получить(номер));
            если (команда == 0)
                добавить_черту(где);
            иначе
                добавить_пункт(где, цель, поле_пункта(строка, 2), клавиша_пункта(поле_пункта(строка, 3)), команда, элементы, команды);
            конец
            ин = ин + 1;
        конец
    конец
    н = 0;
    пока (н меньше м.заголовки.размер())
        вставить_в_панель(панель, подменю.получить(н), м.заголовки.получить(н));
        н = н + 1;
    конец

    сообщение(приложение, селектор("setMainMenu:"), панель, 0, 0, 0);
    вернуть 1;
конец

// Серые пункты и галочки — по тем же перечням, что и во внутриоконном меню.
функция родное_меню_обновить(Список из целых элементы, Список из целых команды, текст отключены, текст отмечены): целое
    целое64 вкл = селектор("setEnabled:");
    целое64 сост = селектор("setState:");
    целое ин = 0;
    пока (ин меньше элементы.размер())
        целое ид = команды.получить(ин);
        целое включён = 1;
        если (в_перечне(отключены, ид))
            включён = 0;
        конец
        целое отмечен = 0;
        если (в_перечне(отмечены, ид))
            отмечен = 1;
        конец
        сообщение(элементы.получить(ин), вкл, включён, 0, 0, 0);
        сообщение(элементы.получить(ин), сост, отмечен, 0, 0, 0);
        ин = ин + 1;
    конец
    вернуть 0;
конец
