функция рядов_папок(Состояние с): целое
    целое н = с.п_имена.размер();
    если (найти_папку_вида(с, 3) больше 0 - 1)
        н = н - 1;
    конец
    если (н больше 9)
        н = 9;
    конец
    вернуть н;
