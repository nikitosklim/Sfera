// Номер папки в ряду списка слева (без «Корзины», она стоит отдельно внизу).
функция папка_в_ряду(Состояние с, целое ряд): целое
    целое корзина = найти_папку_вида(с, 3);
    целое номер = 0;
    целое ин = 0;
    пока (ин меньше с.п_имена.размер())
        если (ин != корзина)
            если (номер == ряд)
                вернуть ин;
            конец
            номер = номер + 1;
        конец
        ин = ин + 1;
    конец
    вернуть 0 - 1;
