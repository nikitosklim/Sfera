// Русская раскладка -> клавиша на латинской (для сочетаний ⌘).
функция латинская_клавиша(целое клавиша): целое
    если (клавиша не меньше 1072 и клавиша не больше 1103)
        текст таблица = "f,dult;pbqrkvyjghcnea[wxio]sm'.z";
        вернуть целое(байт_текста(таблица, клавиша - 1072));
