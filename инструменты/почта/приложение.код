            ПисьмоВСписке п = с.письма.получить(номер);
            я.сбой = "";
            текст итог = "";
            целое корзина = найти_папку_вида(с, 3);
            если (вид_текущей(с) == 3 или корзина меньше 0)
                ящик_удалить(я, п.код);
                итог = "Письмо удалено навсегда";
            иначе
                если (ящик_переместить(я, п.код, с.п_имена.получить(корзина)))
