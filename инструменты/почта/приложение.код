// Настройки, автовход из окружения (для проверок), ввод текста. Вызывается один раз после создания окна.
функция начать_сеанс(Состояние с): целое
    загрузить_настройки(с);
    если (длина(с.отправитель) больше 0)
        с.поле = 1;
    конец
    // Сценарий для проверок: пароль и автоматический вход из окружения (в обычной работе не используется).
    если (длина(окружение("СФЕРА_ПОЧТА_ПАРОЛЬ")) больше 0)
        с.пароль = окружение("СФЕРА_ПОЧТА_ПАРОЛЬ");
        если (длина(окружение("СФЕРА_ПОЧТА_ВХОД")) больше 0)
            с.дело = 1;
        конец
    конец
    начать_ввод_текста();
    вернуть 0;
конец

функция закончить_сеанс(Ящик я): целое
    ящик_закрыть(я);
    закончить_ввод_текста();
    завершить();
    вернуть 0;
конец

// Один оборот цикла: события, отложенные дела, проверка почты, рисование.
// Возвращает 1, если окно перерисовано (родное меню в этом случае обновляет доступность пунктов).
функция оборот(Кисть к, Состояние с, Ящик я, Меню м, текст буфер): целое
    с.кадр = с.кадр + 1;
    целое32 есть = опросить_событие(буфер);
    пока (есть != целое32(0))
        с.грязно = 1;
        если (событие(к, с, я, м, буфер) == 1)
            с.выход = 1;
        конец
        есть = опросить_событие(буфер);
    конец

    // отложенное действие выполняем после того, как на экране появилось сообщение о нём
    если (с.дело != 0 и с.грязно == 0)
        выполнить_дело(к, с, я);
    конец
    // сообщение в строке состояния гаснет через несколько секунд
    если (длина(с.статус) больше 0 и с.дело == 0 и с.кадр - с.статус_кадр больше 150)
        с.статус = "";
        с.грязно = 1;
    конец
    // новые письма приходят сами: раз в ~15 секунд спрашиваем сервер
    если (с.экран == 1 и с.дело == 0 и с.диалог == 0 и я.открыт и с.кадр - с.проверено больше ПРОВЕРКА_КАДРОВ)
        с.проверено = с.кадр;
        с.дело = 5;
    конец

    // Без событий перерисовываем только для мигания курсора (там, где есть поле ввода):
    // каждая перерисовка — работа процессора и немного памяти, зря её не тратим.
    целое мигает = 0;
    если (с.экран != 1 или с.поиск_активен == 1 или с.диалог == 5)
        мигает = 1;
    конец
    целое рисовали = 0;
    если (с.грязно == 1 или (мигает == 1 и с.кадр % 15 == 0))
        рисовали = 1;
        с.грязно = 0;
        если (с.экран == 0)
            нарисовать_вход(к, с, м);
        иначе если (с.экран == 2)
            нарисовать_написание(к, с, я);
        иначе
            космос(к, Ш_ОКНА, В_ОКНА);
            нарисовать_панель_кнопок(к, с);
            нарисовать_папки(к, с);
            нарисовать_список(к, с);
            если (с.есть_открыто == 1)
                нарисовать_письмо(к, с);
            иначе
                нарисовать_пусто(к, с);
            конец
        конец
        нарисовать_статус(к, с, я);
        если (с.родное == 1)
            нарисовать_полосу(к, с);
        иначе
            текст справа = "";
            если (с.экран != 0)
                справа = с.отправитель;
            конец
            меню_рисовать(к, м, Ш_ОКНА, с.мышь_х, с.мышь_у, отключённые(с), отмеченные(с), справа);
        конец
        если (с.диалог != 0)
            нарисовать_диалог(к, с);
        конец
        показать_холст(пх(к.холст));
        // если рисовали из-за ожидающего дела, оно выполнится в следующем обороте
        если (с.дело != 0)
            с.грязно = 0;
        конец
    конец
    подождать(беззнак32(33));
    вернуть рисовали;
конец
