// Номер первой папки такого вида; -1, если такой нет.
функция найти_папку_вида(Состояние с, целое вид): целое
    целое ин = 0;
    пока (ин меньше с.п_виды.размер())
        если (с.п_виды.получить(ин) == вид)
            вернуть ин;
        конец
        ин = ин + 1;
    конец
    вернуть 0 - 1;
