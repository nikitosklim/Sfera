функция очистить_целые(Список из целых л): целое
    пока (л.размер() больше 0)
        л.удалить(л.размер() - 1);
    конец
    вернуть 0;
конец

функция очистить_тексты(Список из текстов л): целое
    пока (л.размер() больше 0)
        л.удалить(л.размер() - 1);
    конец
    вернуть 0;
конец

функция сколько_новых(Состояние с): целое
    целое н = 0;
    целое ин = 0;
    пока (ин меньше с.новые.размер())
        н = н + с.новые.получить(ин);
        ин = ин + 1;
    конец
    вернуть н;
конец

// Код выбранного письма на сервере; -1, если ничего не выбрано.
функция код_выбранного(Состояние с): целое
    если (с.выбрано больше 0 - 1 и с.выбрано меньше с.видимые.размер())
        ПисьмоВСписке было = с.письма.получить(с.видимые.получить(с.выбрано));
        вернуть было.код;
    конец
    вернуть 0 - 1;
конец

функция пересчитать(Состояние с): целое
    вернуть пересчитать_для(с, код_выбранного(с));
конец

// Собирает список видимых писем (новейшие первыми) с учётом поиска и фильтра «только непрочитанные».
// Выбранное письмо запоминаем по его коду на сервере: номера в списке после обновления сдвигаются.
функция пересчитать_для(Состояние с, целое выбранный_код): целое
    очистить_целые(с.видимые);
    текст запрос = регистр_в_нижний(без_краёв(с.поиск));
    целое ин = с.письма.размер() - 1;
    пока (ин больше 0 - 1)
        верно берём = да;
        если (с.только_новые == 1 и с.новые.получить(ин) == 0)
            берём = нет;
        конец
        если (берём и длина(запрос) больше 0)
            ПисьмоВСписке п = с.письма.получить(ин);
            текст стог = регистр_в_нижний(п.от_кого + " " + п.кому + " " + п.тема);
            результат из целого р = найти(стог, запрос);
            берём = р.успешно;
        конец
        если (берём)
            с.видимые.добавить(ин);
        конец
        ин = ин - 1;
    конец
    с.выбрано = 0 - 1;
    целое й = 0;
    пока (й меньше с.видимые.размер())
        ПисьмоВСписке есть = с.письма.получить(с.видимые.получить(й));
        если (есть.код == выбранный_код)
            с.выбрано = й;
        конец
        й = й + 1;
    конец
    с.грязно = 1;
    вернуть 0;
конец

функция строк_в_списке(Состояние с): целое
    вернуть (НИЗ - ВЕРХ - 26) / высота_строки(с);
конец

функция высота_строки(Состояние с): целое
    если (с.плотный == 1)
        вернуть 38;
    конец
    вернуть 62;
конец

функция показать_выбранное(Состояние с): целое
    если (с.выбрано меньше 0)
        вернуть 0;
    конец
    если (с.выбрано меньше с.прокрутка)
        с.прокрутка = с.выбрано;
    конец
    если (с.выбрано не меньше с.прокрутка + строк_в_списке(с))
        с.прокрутка = с.выбрано - строк_в_списке(с) + 1;
    конец
    вернуть 0;
конец

функция ограничить_прокрутку(Состояние с): целое
    целое предел = с.видимые.размер() - строк_в_списке(с);
    если (с.прокрутка больше предел)
        с.прокрутка = предел;
    конец
    если (с.прокрутка меньше 0)
        с.прокрутка = 0;
    конец
    вернуть 0;
конец

