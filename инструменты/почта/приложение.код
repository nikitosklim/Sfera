// ---------- разбор строк ----------
функция найти_байт(текст т, целое код, целое от): целое
    целое п = от;
    пока (п меньше длина(т))
        если (целое(байт_текста(т, п)) == код)
            вернуть п;
        конец
        п = п + 1;
    конец
    вернуть 0 - 1;
конец

функция слова(текст т): Список из текстов
    Список из текстов итог = Список из текстов();
    целое от = 0;
    целое п = 0;
    пока (п не больше длина(т))
        если (п == длина(т) или целое(байт_текста(т, п)) == 32)
            если (п больше от)
                итог.добавить(срез(т, от, п - от));
            конец
            от = п + 1;
        конец
        п = п + 1;
    конец
    вернуть итог;
конец

функция в_одну_строку(текст т): текст
    текст итог = "";
    целое п = 0;
    пока (п меньше длина(т))
        целое б = целое(байт_текста(т, п));
        если (б == 10 или б == 13 или б == 9)
            итог = итог + " ";
        иначе
            итог = итог + срез(т, п, 1);
        конец
        п = п + 1;
    конец
    вернуть итог;
конец

// «Имя <адрес>» -> «Имя» (или адрес, если имени нет).
функция имя_из_адреса(текст от): текст
    целое л = найти_байт(от, 60, 0);
    если (л больше 0 - 1)
        текст имя = без_краёв(срез(от, 0, л));
        если (длина(имя) больше 1 и целое(байт_текста(имя, 0)) == 34)
            имя = срез(имя, 1, длина(имя) - 2);
        конец
        если (длина(имя) больше 0)
            вернуть имя;
        конец
        целое п = найти_байт(от, 62, л);
        если (п больше л)
            вернуть срез(от, л + 1, п - л - 1);
        конец
    конец
    вернуть без_краёв(от);
конец

// «Имя <адрес>» -> «адрес».
функция адрес_из_адреса(текст от): текст
    целое л = найти_байт(от, 60, 0);
    если (л больше 0 - 1)
        целое п = найти_байт(от, 62, л);
        если (п больше л)
            вернуть срез(от, л + 1, п - л - 1);
        конец
    конец
    вернуть без_краёв(от);
конец

функция номер_месяца(текст имя): целое
    результат из целого р = найти("JanFebMarAprMayJunJulAugSepOctNovDec", срез(имя, 0, 3));
    если (р.успешно)
        вернуть р.значение / 3 + 1;
    конец
    вернуть 0;
конец

функция месяц_кратко(целое м): текст
    вернуть поле_пункта("янв.|февр.|мар.|апр.|мая|июн.|июл.|авг.|сент.|окт.|нояб.|дек.", м - 1);
конец

// Дата письма: «11:59» для сегодняшнего, «26 нояб.» для остальных. Показ — по времени, указанному в письме.
функция дата_для_списка(текст д): текст
    Список из текстов с = слова(д);
    целое ф = 0;
    если (с.размер() больше 0 и найти_байт(с.получить(0), 44, 0) больше 0 - 1)
        ф = 1;
    конец
    если (с.размер() меньше ф + 4)
        вернуть кратко(д, 12);
    конец
    целое день = число_из_текста(с.получить(ф));
    целое мес = номер_месяца(с.получить(ф + 1));
    если (мес == 0 или день == 0)
        вернуть кратко(д, 12);
    конец
    ДатаВремя сейчас = время_из_юникса_со_смещением(юникс_время(), смещение_москвы());
    если (сейчас.день == день и сейчас.месяц == мес)
        вернуть срез(с.получить(ф + 3), 0, 5);
    конец
    вернуть целое_в_текст(день) + " " + месяц_кратко(мес);
конец

// «26.11.2026 11:59»
функция дата_полная(текст д): текст
    Список из текстов с = слова(д);
    целое ф = 0;
    если (с.размер() больше 0 и найти_байт(с.получить(0), 44, 0) больше 0 - 1)
        ф = 1;
    конец
    если (с.размер() меньше ф + 4)
        вернуть д;
    конец
    целое мес = номер_месяца(с.получить(ф + 1));
    если (мес == 0)
        вернуть д;
    конец
    вернуть дополнить_нулём(число_из_текста(с.получить(ф))) + "." + дополнить_нулём(мес) + "." + с.получить(ф + 2) + " " + срез(с.получить(ф + 3), 0, 5);
конец

функция имя_файла_из_пути(текст путь): текст
    целое п = длина(путь);
    пока (п больше 0 и целое(байт_текста(путь, п - 1)) != 47)
        п = п - 1;
    конец
    вернуть срез(путь, п, длина(путь) - п);
конец

функция тип_по_имени(текст имя): текст
    текст н = регистр_в_нижний(имя);
    если (оканчивается_на(н, ".txt") или оканчивается_на(н, ".md"))
        вернуть "text/plain";
    конец
    если (оканчивается_на(н, ".pdf"))
        вернуть "application/pdf";
    конец
    если (оканчивается_на(н, ".png"))
        вернуть "image/png";
    конец
    если (оканчивается_на(н, ".jpg") или оканчивается_на(н, ".jpeg"))
        вернуть "image/jpeg";
    конец
    если (оканчивается_на(н, ".gif"))
        вернуть "image/gif";
    конец
    если (оканчивается_на(н, ".zip"))
        вернуть "application/zip";
    конец
    если (оканчивается_на(н, ".html"))
        вернуть "text/html";
    конец
    вернуть "application/octet-stream";
конец

функция оканчивается_на(текст с, текст хвост): верно
    если (длина(с) меньше длина(хвост))
        вернуть нет;
    конец
    вернуть срез(с, длина(с) - длина(хвост), длина(хвост)) == хвост;
конец

// Имя файла без опасных знаков (путь внутри имени, двоеточие).
функция безопасное_имя(текст имя): текст
    текст итог = "";
    целое п = 0;
    пока (п меньше длина(имя))
        целое б = целое(байт_текста(имя, п));
        если (б == 47 или б == 92 или б == 58 или б меньше 32)
            итог = итог + "_";
        иначе
            итог = итог + срез(имя, п, 1);
        конец
        п = п + 1;
    конец
    если (длина(без_краёв(итог)) == 0 или итог == "." или итог == "..")
        вернуть "вложение";
    конец
    вернуть итог;
конец

