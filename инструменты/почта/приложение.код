// Какие команды сейчас недоступны (серые) и какие отмечены галочкой.
функция отключённые(Состояние с): текст
    текст итог = ",";
    если (с.экран != 1)
        итог = итог + "2,3,6,4,25,26,27,28,12,13,20,21,30,31,32,33,60,61,70,71,72,";
    конец
    если (вид_текущей(с) != 3 или с.есть_открыто == 0)
        итог = итог + "28,";
    конец
    если (с.есть_открыто == 0)
        итог = итог + "25,26,27,3,6,10,";
    иначе если (с.вл_имена.размер() == 0)
        итог = итог + "3,6,";
    конец
    если (с.экран == 2)
        итог = итог + "1,";
    конец
    вернуть итог;
конец

функция отмеченные(Состояние с): текст
    текст итог = ",";
    если (с.только_новые == 1)
        итог = итог + "20,";
    конец
    если (с.плотный == 1)
        итог = итог + "21,";
    конец
    вернуть итог;
конец

функция открыть_папку(Состояние с, целое номер): целое
    если (номер меньше 0 или номер не меньше с.п_имена.размер() или номер == с.п_текущая)
        вернуть 0;
    конец
    с.дело_параметр = номер;
    с.дело = 6;
    с.п_текущая = номер;
    сказать(с, "Открываем папку…");
    вернуть 1;
конец

функция щелчок_по_папкам(Состояние с, целое мх, целое му): целое
    целое ряды = рядов_папок(с);
    целое ряд = 0;
    пока (ряд меньше ряды)
        если (внутри(мх, му, 8, ВЕРХ + 40 + ряд * ШАГ_ПАПКИ, БОК - 16, ШАГ_ПАПКИ - 4))
            открыть_папку(с, папка_в_ряду(с, ряд));
            вернуть 1;
        конец
        ряд = ряд + 1;
    конец
    если (внутри(мх, му, 8, ВЕРХ + 40 + ряды * ШАГ_ПАПКИ, БОК - 16, ШАГ_ПАПКИ - 4))
        с.ввод = "";
        с.диалог = 5;
        вернуть 1;
    конец
    целое корзина = найти_папку_вида(с, 3);
    если (корзина больше 0 - 1)
        если (внутри(мх, му, 8, КОРЗИНА_Y, БОК - 16, ШАГ_ПАПКИ - 4))
            открыть_папку(с, корзина);
            вернуть 1;
        конец
        если (с.п_текущая == корзина и внутри(мх, му, 12, КОРЗИНА_Y + 40, БОК - 24, 30))
            с.диалог = 6;
            вернуть 1;
        конец
    конец
    вернуть 0;
конец

// В имени папки нельзя: «.» (разделитель уровней на сервере), «/», «\», «%», «*» и кавычки.
функция имя_папки_допустимо(текст имя): верно
    если (длина(имя) == 0)
        вернуть нет;
    конец
    целое п = 0;
    пока (п меньше длина(имя))
        целое б = целое(байт_текста(имя, п));
        если (б == 46 или б == 47 или б == 92 или б == 37 или б == 42 или б == 34 или б меньше 32)
            вернуть нет;
        конец
        п = п + 1;
    конец
    вернуть да;
конец

// Нажали главную кнопку окна-вопроса (Enter или щелчок).
функция подтвердить_диалог(Состояние с): целое
    целое вид = с.диалог;
    если (вид == 5)
        если ( не имя_папки_допустимо(без_краёв(с.ввод)))
            сказать(с, "Введите название без знаков . / \\ % *");
            вернуть 0;
        конец
        с.диалог = 0;
        сказать(с, "Создаём папку…");
        с.дело = 7;
        вернуть 1;
    конец
    с.диалог = 0;
    если (вид == 3)
        сказать(с, "Выполняем…");
        с.дело = 3;
    иначе если (вид == 4)
        с.экран = 1;
    иначе если (вид == 6)
        сказать(с, "Очищаем корзину…");
        с.дело = 8;
    конец
    вернуть 1;
конец

функция перейти_к(Кисть к, Состояние с, Ящик я, целое место): целое
    если (с.видимые.размер() == 0)
        вернуть 0;
    конец
    целое н = место;
    если (н меньше 0)
        н = 0;
    конец
    если (н не меньше с.видимые.размер())
        н = с.видимые.размер() - 1;
    конец
    с.выбрано = н;
    показать_выбранное(с);
    открыть_выбранное(к, с, я);
    с.грязно = 1;
    вернуть 1;
конец

функция выполнить(Кисть к, Состояние с, Ящик я, Меню м, целое команда): целое
    с.грязно = 1;
    // Меню macOS и сочетания клавиш могут сообщить об одной и той же команде — второй раз её не выполняем.
    если (с.родное == 1 и команда == с.посл_команда и с.кадр - с.посл_кадр меньше 3)
        вернуть 0;
    конец
    с.посл_команда = команда;
    с.посл_кадр = с.кадр;
    если (команда == 1)
        если (с.экран == 1)
            начать_письмо(с, "", "", "");
        конец
    иначе если (команда == 2 и с.экран == 1)
        сказать(с, "Обновляем…");
        с.дело = 2;
    иначе если (команда == 3 и с.экран == 1)
        если (с.есть_открыто == 1 и с.вл_имена.размер() == 1)
            сохранить_вложение(с, 0);
        иначе если (с.есть_открыто == 1)
            сказать(с, "Нажмите на нужное вложение — или «Сохранить все вложения»");
        конец
    иначе если (команда == 6 и с.экран == 1)
        сохранить_все_вложения(с);
    иначе если (команда == 4)
        ящик_закрыть(я);
        закрыть_письмо(с);
        очистить_целые(с.видимые);
        пока (с.письма.размер() больше 0)
            с.письма.удалить(с.письма.размер() - 1);
        конец
        очистить_целые(с.новые);
        очистить_тексты(с.п_имена);
        очистить_тексты(с.п_показ);
        очистить_целые(с.п_виды);
        очистить_целые(с.п_новых);
        с.п_текущая = 0;
        с.пароль = "";
        с.экран = 0;
        с.поле = 1;
        с.выбрано = 0 - 1;
        с.статус = "";
    иначе если (команда == 5)
        с.выход = 1;
    иначе если (команда == 10)
        если (с.есть_открыто == 1)
            задать_буфер_обмена(с.о_тело);
            сказать(с, "Текст письма скопирован");
        конец
    иначе если (команда == 11)
        вставить_из_буфера(с);
    иначе если (команда == 12 и с.экран == 1)
        с.поиск_активен = 1;
    иначе если (команда == 13 и с.экран == 1)
        с.поиск = "";
        с.поиск_активен = 0;
        пересчитать(с);
    иначе если (команда == 20 и с.экран == 1)
        с.только_новые = 1 - с.только_новые;
        пересчитать(с);
        с.прокрутка = 0;
    иначе если (команда == 21 и с.экран == 1)
        с.плотный = 1 - с.плотный;
        ограничить_прокрутку(с);
        показать_выбранное(с);
    иначе если (команда == 25 и с.экран == 1)
        ответить(с);
    иначе если (команда == 26 и с.экран == 1)
        если (с.есть_открыто == 1)
            сказать(с, "Письмо уже отмечено прочитанным");
        конец
    иначе если (команда == 27 и с.экран == 1)
        если (с.есть_открыто == 1)
            с.диалог = 3;
        конец
    иначе если (команда == 30 и с.экран == 1)
        перейти_к(к, с, я, с.выбрано + 1);
    иначе если (команда == 31 и с.экран == 1)
        перейти_к(к, с, я, с.выбрано - 1);
    иначе если (команда == 32 и с.экран == 1)
        перейти_к(к, с, я, 0);
    иначе если (команда == 33 и с.экран == 1)
        перейти_к(к, с, я, с.видимые.размер() - 1);
    иначе если (команда == 28 и с.экран == 1)
        если (с.есть_открыто == 1 и вид_текущей(с) == 3)
            сказать(с, "Возвращаем письмо…");
            с.дело = 9;
        конец
    иначе если (команда == 60 и с.экран == 1)
        с.ввод = "";
        с.диалог = 5;
    иначе если (команда == 61 и с.экран == 1)
        если (найти_папку_вида(с, 3) больше 0 - 1)
            с.диалог = 6;
        конец
    иначе если ((команда == 70 или команда == 71 или команда == 72) и с.экран == 1)
        целое вид_нужный = 1;
        если (команда == 71)
            вид_нужный = 2;
        иначе если (команда == 72)
            вид_нужный = 3;
        конец
        открыть_папку(с, найти_папку_вида(с, вид_нужный));
    иначе если (команда == 40)
        свернуть_окно(пх(к.окно));
    иначе если (команда == 41)
        режим_экрана(пх(к.окно), беззнак32(4097));
        сказать(с, "Выйти из полного экрана — F11");
    иначе если (команда == 50)
        с.диалог = 1;
    иначе если (команда == 51)
        с.диалог = 2;
    конец
    вернуть 0;
конец

функция вставить_из_буфера(Состояние с): целое
    текст из_буфера = буфер_обмена_текст();
    если (длина(из_буфера) == 0)
        вернуть 0;
    конец
    ввести_текст(с, из_буфера);
    вернуть 0;
конец

// Ввод в активное поле текущего экрана.
функция ввести_текст(Состояние с, текст кусок): целое
    с.грязно = 1;
    если (с.экран == 0)
        текст ч = в_одну_строку(кусок);
        если (с.поле == 0)
            с.отправитель = с.отправитель + ч;
        иначе если (с.поле == 1)
            с.пароль = с.пароль + ч;
        иначе если (с.поле == 2)
            с.узел = с.узел + ч;
        иначе если (с.поле == 3)
            с.узел_отправки = с.узел_отправки + ч;
        иначе если (с.поле == 4)
            с.имя = с.имя + ч;
        иначе
            с.отправитель_имя = с.отправитель_имя + ч;
        конец
        с.сбой = "";
    иначе если (с.экран == 2)
        если (с.поле == 0)
            с.к_кому = с.к_кому + в_одну_строку(кусок);
        иначе если (с.поле == 1)
            с.к_тема = с.к_тема + в_одну_строку(кусок);
        иначе если (с.поле == 2)
            с.к_тело = с.к_тело + кусок;
        иначе
            с.к_путь = с.к_путь + в_одну_строку(кусок);
        конец
    иначе если (с.экран == 1 и с.поиск_активен == 1)
        с.поиск = с.поиск + в_одну_строку(кусок);
        пересчитать(с);
        с.прокрутка = 0;
    конец
    вернуть 0;
конец

функция стереть_знак(Состояние с): целое
    с.грязно = 1;
    если (с.экран == 0)
        если (с.поле == 0)
            с.отправитель = удалить_последний_символ(с.отправитель);
        иначе если (с.поле == 1)
            с.пароль = удалить_последний_символ(с.пароль);
        иначе если (с.поле == 2)
            с.узел = удалить_последний_символ(с.узел);
        иначе если (с.поле == 3)
