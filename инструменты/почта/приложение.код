функция клавиша_клик_сочетание(Кисть к, Состояние с, Ящик я, Меню м, целое клавиша, целое мод): целое
    целое л = латинская_клавиша(клавиша);
    // ⌘ (0x400|0x800) или Ctrl (0x40|0x80)
    верно команда_нажата = (мод / 64) % 4 != 0 или (мод / 1024) % 4 != 0;
    если ( не команда_нажата)
        вернуть 0;
    конец
    если (л больше 96 и л меньше 123)
        текст сочетание = "⌘" + регистр_в_верхний(срез("abcdefghijklmnopqrstuvwxyz", л - 97, 1));
        целое ид = меню_по_сочетанию(м, сочетание);
        если (ид больше 0 и не в_перечне(отключённые(с), ид))
            выполнить(к, с, я, м, ид);
            вернуть 1;
        конец
    конец
    если (л больше 47 и л меньше 58)
        текст цифра = "⌘" + срез("0123456789", л - 48, 1);
        целое ид2 = меню_по_сочетанию(м, цифра);
        если (ид2 больше 0 и не в_перечне(отключённые(с), ид2))
            выполнить(к, с, я, м, ид2);
            вернуть 1;
        конец
    конец
    если (л == 47)
        выполнить(к, с, я, м, 50);
        вернуть 1;
    конец
    вернуть 0;
конец

функция событие(Кисть к, Состояние с, Ящик я, Меню м, текст буф): целое
    целое тип = целое(прочитать_целое32(буф, 0));
    если (тип == 256)
        с.выход = 1;
        вернуть 1;
    конец
    если (тип == 1024)
        с.мышь_х = целое(прочитать_целое32(буф, 20));
        с.мышь_у = целое(прочитать_целое32(буф, 24));
        если (с.родное == 0)
            меню_наведение(к, м, с.мышь_х, с.мышь_у);
        конец
        вернуть 0;
    конец

    // ----- команда из меню macOS -----
    если (тип == 32768)
        если (с.диалог == 0 или целое(прочитать_целое32(буф, 12)) == 5)
            выполнить(к, с, я, м, целое(прочитать_целое32(буф, 12)));
        конец
        вернуть 0;
    конец

    // ----- файл перетащили на окно -----
    если (тип == 4096)
        текст путь = прочитать_указатель(буф, 8);
        если (с.экран == 1)
            начать_письмо(с, "", "", "");
        конец
        если (с.экран == 2)
            добавить_файл(с, путь);
        конец
        вернуть 0;
    конец

    // ----- колесо мыши -----
    если (тип == 1027)
        целое шаг = целое(прочитать_целое32(буф, 20));
        если (с.экран == 1 и с.диалог == 0)
            если (с.мышь_х не меньше БОК и с.мышь_х меньше Ш_СПИСКА)
                с.прокрутка = с.прокрутка - шаг;
                ограничить_прокрутку(с);
            иначе если (с.мышь_х не меньше Ш_СПИСКА)
                с.тело_прокрутка = с.тело_прокрутка - шаг * 40;
            конец
        конец
        вернуть 0;
    конец

    // ----- окно-вопрос -----
    если (с.диалог != 0)
        если (с.диалог == 5 и тип == 771)
            с.ввод = с.ввод + в_одну_строку(прочитать_текст_по_смещению(буф, 12));
        иначе если (тип == 768)
            целое кл = целое(прочитать_целое32(буф, 20));
            целое мод_д = целое(прочитать_целое32(буф, 24)) % 65536;
            если (кл == 27)
                с.диалог = 0;
            иначе если (кл == 13)
                если (с.диалог == 3 или с.диалог == 4 или с.диалог == 5 или с.диалог == 6)
                    подтвердить_диалог(с);
                иначе
                    с.диалог = 0;
                конец
            иначе если (кл == 8 и с.диалог == 5)
                с.ввод = удалить_последний_символ(с.ввод);
            иначе если (кл == 118 и с.диалог == 5 и ((мод_д / 64) % 4 != 0 или (мод_д / 1024) % 4 != 0))
                с.ввод = с.ввод + в_одну_строку(буфер_обмена_текст());
            конец
        иначе если (тип == 1025)
            целое мх = целое(прочитать_целое32(буф, 20));
            целое му = целое(прочитать_целое32(буф, 24));
            целое вид = с.диалог;
            если (вид == 3 или вид == 4 или вид == 5 или вид == 6)
                если (тут_ли_диалог(вид, мх, му, 0))
                    подтвердить_диалог(с);
                иначе если (тут_ли_диалог(вид, мх, му, 1))
                    с.диалог = 0;
                конец
            иначе
                с.диалог = 0;
            конец
        конец
        с.грязно = 1;
        вернуть 0;
    конец

    // ----- щелчок в строке меню -----
    если (тип == 1025 и с.родное == 0)
        целое мх = целое(прочитать_целое32(буф, 20));
        целое му = целое(прочитать_целое32(буф, 24));
        целое р = меню_щелчок(к, м, мх, му, отключённые(с));
        если (р больше 0)
            выполнить(к, с, я, м, р);
            вернуть 0;
        конец
        если (р == 0)
            вернуть 0;
        конец
    конец
    если (тип == 768 и м.открыто больше 0 - 1)
        если (целое(прочитать_целое32(буф, 20)) == 27)
            м.открыто = 0 - 1;
            вернуть 0;
        конец
    конец

    // ----- сочетания клавиш -----
    если (тип == 768)
        целое клавиша = целое(прочитать_целое32(буф, 20));
        целое мод = целое(прочитать_целое32(буф, 24)) % 65536;
        если (клавиша_клик_сочетание(к, с, я, м, клавиша, мод) == 1)
            вернуть 0;
        конец
        если (клавиша == 1073741886 и с.экран == 1)
            выполнить(к, с, я, м, 2);
            вернуть 0;
        конец
        если (клавиша == 1073741892)
            выполнить(к, с, я, м, 41);
            вернуть 0;
        конец
        верно команда_нажата = (мод / 64) % 4 != 0 или (мод / 1024) % 4 != 0;
        если (команда_нажата и клавиша == 13 и с.экран == 2)
            с.дело = 4;
            сказать(с, "Отправляем письмо…");
            вернуть 0;
        конец
    конец

    // ----- вход -----
    если (с.экран == 0)
        если (тип == 771)
            ввести_текст(с, прочитать_текст_по_смещению(буф, 12));
        иначе если (тип == 768)
            целое клавиша = целое(прочитать_целое32(буф, 20));
            целое мод = целое(прочитать_целое32(буф, 24)) % 65536;
            если (клавиша == 8)
                стереть_знак(с);
            иначе если (клавиша == 9)
                целое всего_полей = 2;
                если (с.доп == 1)
                    всего_полей = 6;
                конец
                с.поле = (с.поле + 1) % всего_полей;
            иначе если (клавиша == 13)
                если (с.поле == 0)
                    с.поле = 1;
                иначе
                    попытка_войти(с, я);
                конец
            иначе если (клавиша == 118 и ((мод / 64) % 4 != 0 или (мод / 1024) % 4 != 0))
                ввести_текст(с, буфер_обмена_текст());
            конец
        иначе если (тип == 1025)
            целое мх = целое(прочитать_целое32(буф, 20));
            целое му = целое(прочитать_целое32(буф, 24));
            целое кх = (Ш_ОКНА - 480) / 2 + 40;
            если (внутри(мх, му, кх, 196, 400, 36))
                с.поле = 0;
            иначе если (внутри(мх, му, кх, 262, 400, 36))
                с.поле = 1;
            иначе если (внутри(мх, му, кх, 324, 400, 42))
                попытка_войти(с, я);
            иначе если (внутри(мх, му, кх, 374, 400, 28))
                с.доп = 1 - с.доп;
                если (с.доп == 1 и длина(домен_почты(без_краёв(с.отправитель))) больше 0)
                    настроить_по_адресу(с);
                конец
            иначе если (с.доп == 1)
                если (внутри(мх, му, кх, 436, 190, 36))
                    с.поле = 2;
                иначе если (внутри(мх, му, кх + 210, 436, 190, 36))
                    с.поле = 3;
                иначе если (внутри(мх, му, кх, 502, 400, 36))
                    с.поле = 4;
                иначе если (внутри(мх, му, кх, 568, 400, 36))
                    с.поле = 5;
                конец
            конец
        конец
        с.грязно = 1;
        вернуть 0;
    конец

    // ----- написание -----
    если (с.экран == 2)
        если (тип == 771)
            ввести_текст(с, прочитать_текст_по_смещению(буф, 12));
        иначе если (тип == 768)
            целое клавиша = целое(прочитать_целое32(буф, 20));
            если (клавиша == 8)
                стереть_знак(с);
            иначе если (клавиша == 27)
                если (с.к_путь_вкл == 1)
                    с.к_путь_вкл = 0;
                    с.поле = 2;
                иначе если (длина(без_краёв(с.к_тело)) == 0 и длина(с.к_кому) == 0 и длина(с.к_тема) == 0 и с.к_файлы.размер() == 0)
                    с.экран = 1;
                иначе
                    с.диалог = 4;
                конец
            иначе если (клавиша == 9)
                целое сл = с.поле + 1;
                если (сл == 3 и с.к_путь_вкл == 0)
                    сл = 0;
                конец
                если (сл больше 3)
                    сл = 0;
                конец
                с.поле = сл;
            иначе если (клавиша == 13)
                если (с.поле == 2)
                    с.к_тело = с.к_тело + "\n";
                иначе если (с.поле == 3)
                    если (добавить_файл(с, с.к_путь) == 1)
                        с.к_путь = "";
                        с.к_путь_вкл = 0;
                        с.поле = 2;
                    конец
                иначе
                    с.поле = с.поле + 1;
                конец
            иначе если (клавиша == 118 и (((целое(прочитать_целое32(буф, 24)) % 65536) / 64) % 4 != 0 или ((целое(прочитать_целое32(буф, 24)) % 65536) / 1024) % 4 != 0))
                вставить_из_буфера(с);
            конец
        иначе если (тип == 1025)
            целое мх = целое(прочитать_целое32(буф, 20));
            целое му = целое(прочитать_целое32(буф, 24));
            если (внутри(мх, му, 24, 106, Ш_ОКНА - 48, 36))
                с.поле = 0;
            иначе если (внутри(мх, му, 24, 170, Ш_ОКНА - 48, 36))
                с.поле = 1;
            иначе если (с.к_путь_вкл == 1 и внутри(мх, му, 24, 218, Ш_ОКНА - 48, 36))
                с.поле = 3;
            иначе если (внутри(мх, му, 24, 260, Ш_ОКНА - 48, 356))
                с.поле = 2;
            иначе если (внутри(мх, му, 24, 630, 168, 38))
                с.дело = 4;
                сказать(с, "Отправляем письмо…");
            иначе если (внутри(мх, му, 200, 630, 110, 38))
                если (длина(без_краёв(с.к_тело)) == 0 и длина(с.к_кому) == 0 и длина(с.к_тема) == 0 и с.к_файлы.размер() == 0)
                    с.экран = 1;
                иначе
                    с.диалог = 4;
                конец
            иначе если (внутри(мх, му, Ш_ОКНА - 24 - 190, 630, 190, 38))
                с.к_путь_вкл = 1 - с.к_путь_вкл;
                если (с.к_путь_вкл == 1)
                    с.поле = 3;
                иначе
                    с.поле = 2;
                конец
            иначе если (с.к_путь_вкл == 0 и му не меньше 218 и му меньше 246)
                // щелчок по вложению — убрать его
                целое вх = 24;
                целое ин = 0;
                пока (ин меньше с.к_файлы.размер())
                    текст подпись = по_ширине(к, пх(к.мелкий), имя_файла_из_пути(с.к_файлы.получить(ин)), 220);
                    целое ш = ширина_строки(к, пх(к.мелкий), подпись) + 52;
                    если (внутри(мх, му, вх, 218, ш, 28))
                        с.к_файлы.удалить(ин);
                        сказать(с, "Вложение убрано");
                        прервать;
                    конец
                    вх = вх + ш + 8;
                    ин = ин + 1;
                конец
            конец
        конец
        с.грязно = 1;
        вернуть 0;
    конец

    // ----- главный экран -----
    если (тип == 771)
        ввести_текст(с, прочитать_текст_по_смещению(буф, 12));
    иначе если (тип == 768)
        целое клавиша = целое(прочитать_целое32(буф, 20));
        если (клавиша == 8)
            если (с.поиск_активен == 1)
                стереть_знак(с);
            иначе если (с.есть_открыто == 1)
                с.диалог = 3;
            конец
        иначе если (клавиша == 127)
            если (с.есть_открыто == 1 и с.поиск_активен == 0)
                с.диалог = 3;
            конец
        иначе если (клавиша == 27)
            если (длина(с.поиск) больше 0)
                с.поиск = "";
                пересчитать(с);
            конец
            с.поиск_активен = 0;
        иначе если (клавиша == 13)
            с.поиск_активен = 0;
        иначе если (клавиша == 1073741905)
            перейти_к(к, с, я, с.выбрано + 1);
        иначе если (клавиша == 1073741906)
            перейти_к(к, с, я, с.выбрано - 1);
        иначе если (клавиша == 1073741898)
            перейти_к(к, с, я, 0);
        иначе если (клавиша == 1073741901)
            перейти_к(к, с, я, с.видимые.размер() - 1);
        иначе если (клавиша == 1073741899)
            с.тело_прокрутка = с.тело_прокрутка - 300;
        иначе если (клавиша == 1073741902 или клавиша == 32)
            с.тело_прокрутка = с.тело_прокрутка + 300;
        конец
    иначе если (тип == 1025)
        целое мх = целое(прочитать_целое32(буф, 20));
        целое му = целое(прочитать_целое32(буф, 24));
        с.поиск_активен = 0;
        если (внутри(мх, му, 12, 36, 104, 28))
            выполнить(к, с, я, м, 1);
        иначе если (внутри(мх, му, 124, 36, 104, 28))
            выполнить(к, с, я, м, 2);
        иначе если (внутри(мх, му, 236, 36, 104, 28))
            выполнить(к, с, я, м, 25);
        иначе если (внутри(мх, му, 348, 36, 92, 28))
            выполнить(к, с, я, м, 27);
        иначе если (внутри(мх, му, Ш_ОКНА - 14 - 270, 36, 270, 28))
            с.поиск_активен = 1;
        иначе если (мх меньше БОК и му не меньше ВЕРХ)
            щелчок_по_папкам(с, мх, му);
        иначе если (внутри(мх, му, БОК, ВЕРХ + 26, Ш_СПИСКА - БОК, НИЗ - ВЕРХ - 26))
            целое строка = (му - ВЕРХ - 26) / высота_строки(с);
            целое место = с.прокрутка + строка;
            если (место меньше с.видимые.размер())
                с.выбрано = место;
                открыть_выбранное(к, с, я);
            конец
        иначе
            целое ин = 0;
            пока (ин * 4 + 3 меньше с.чипы.размер())
                если (внутри(мх, му, с.чипы.получить(ин * 4), с.чипы.получить(ин * 4 + 1), с.чипы.получить(ин * 4 + 2), с.чипы.получить(ин * 4 + 3)))
                    сохранить_вложение(с, ин);
                конец
                ин = ин + 1;
            конец
        конец
    конец
    с.грязно = 1;
    вернуть 0;
конец

