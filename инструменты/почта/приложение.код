функция строка_папки(Кисть к, Состояние с, целое номер, целое у): целое
    целое вид = с.п_виды.получить(номер);
    верно выбрана = номер == с.п_текущая;
    верно над = внутри(с.мышь_х, с.мышь_у, 8, у, БОК - 16, ШАГ_ПАПКИ - 4) и с.диалог == 0;
    если (выбрана)
        градиент_скругл(к, 0x3a56ad, 0x2b3b8a, 240, 8, у, БОК - 16, ШАГ_ПАПКИ - 4, 8);
        залить_скругл(к, 0xaabcff, 8, у + 7, 3, ШАГ_ПАПКИ - 18, 1);
    иначе если (над)
        залить_скругл_альфа(к, 0x2d3f85, 130, 8, у, БОК - 16, ШАГ_ПАПКИ - 4, 8);
    конец
    значок_папки(к, вид, 22, у + 9);
    целое н = с.п_новых.получить(номер);
    целое место_имени = БОК - 66;
    если (н больше 0 и вид != 3 и вид != 2)
        место_имени = БОК - 96;
    конец
    писать(к, пх(к.шрифт), по_ширине(к, пх(к.шрифт), с.п_показ.получить(номер), место_имени), 44, у + 5, Ц_ТЕКСТ);
    если (н больше 0 и вид != 3 и вид != 2)
        текст т = целое_в_текст(н);
        если (н больше 99)
            т = "99+";
        конец
        целое ш = ширина_строки(к, пх(к.мелкий), т) + 14;
        если (ш меньше 22)
            ш = 22;
        конец
        градиент_скругл(к, 0x8ea4ff, 0x7b5cf6, 255, БОК - 18 - ш, у + 4, ш, 20, 10);
        писать_по_центру(к, пх(к.мелкий), т, БОК - 18 - ш / 2, у + 6, 0xffffff);
    конец
    вернуть 0;
конец

функция нарисовать_папки(Кисть к, Состояние с): целое
    залить_альфа(к, 0x040818, 150, 0, ВЕРХ, БОК, НИЗ - ВЕРХ);
    залить_альфа(к, 0x2b4070, 190, БОК - 1, ВЕРХ, 1, НИЗ - ВЕРХ);
    писать(к, пх(к.мелкий), "Папки", 18, ВЕРХ + 12, Ц_ТИХИЙ);
    целое ряды = рядов_папок(с);
    целое ряд = 0;
    пока (ряд меньше ряды)
        строка_папки(к, с, папка_в_ряду(с, ряд), ВЕРХ + 40 + ряд * ШАГ_ПАПКИ);
        ряд = ряд + 1;
    конец
    целое у_нов = ВЕРХ + 40 + ряды * ШАГ_ПАПКИ;
    верно над = внутри(с.мышь_х, с.мышь_у, 8, у_нов, БОК - 16, ШАГ_ПАПКИ - 4) и с.диалог == 0;
    если (над)
        залить_скругл_альфа(к, 0x2d3f85, 130, 8, у_нов, БОК - 16, ШАГ_ПАПКИ - 4, 8);
    конец
    писать(к, пх(к.крупный), "+", 22, у_нов + 1, Ц_СВЕТЛЫЙ);
    писать(к, пх(к.шрифт), "Создать папку", 44, у_нов + 5, Ц_СВЕТЛЫЙ);
    целое корзина = найти_папку_вида(с, 3);
    если (корзина больше 0 - 1)
        залить_альфа(к, 0x2b4070, 150, 14, КОРЗИНА_Y - 8, БОК - 28, 1);
        строка_папки(к, с, корзина, КОРЗИНА_Y);
        целое у_подсказки = КОРЗИНА_Y + 42;
        если (с.п_текущая == корзина)
            кнопка(к, с, "Очистить корзину", 12, КОРЗИНА_Y + 40, БОК - 24, 30, 0, да);
            у_подсказки = КОРЗИНА_Y + 78;
        конец
        Список из текстов строки = Список из текстов();
        перенос(к, пх(к.мелкий), "Письма в корзине удаляются сами через 7 дней.", БОК - 32, строки);
        целое л = 0;
        пока (л меньше строки.размер() и л меньше 3)
            писать(к, пх(к.мелкий), строки.получить(л), 16, у_подсказки + л * 16, Ц_ТИХИЙ);
            л = л + 1;
        конец
    конец
    вернуть 0;
конец

