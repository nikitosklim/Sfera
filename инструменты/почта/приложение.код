// Вид выбранной папки: 1 входящие, 2 отправленные, 3 корзина, 5 спам, 0 обычная.
функция вид_текущей(Состояние с): целое
    если (с.п_текущая меньше 0 или с.п_текущая не меньше с.п_виды.размер())
        вернуть 1;
    конец
    вернуть с.п_виды.получить(с.п_текущая);
