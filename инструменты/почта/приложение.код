            конец
            закрыть_письмо(с);
            обновить_список(с, я, 1);
            сказать(с, итог);
        конец
    иначе если (д == 4)
        сказать(с, "Отправляем письмо…");
        отправить(с, я);
    иначе если (д == 5)
        // проверка новых писем без лишнего шума
        целое р = ящик_проверка(я);
        если (р != 0)
            обновить_список(с, я, 1);
        иначе
            обновить_счётчики(с, я);
        конец
        с.проверено = с.кадр;
    иначе если (д == 6)
        // переход в другую папку
        целое номер = с.дело_параметр;
        если (номер больше 0 - 1 и номер меньше с.п_имена.размер())
            закрыть_письмо(с);
            с.п_текущая = номер;
