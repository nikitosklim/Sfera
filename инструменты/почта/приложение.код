        писать(к, пх(к.шрифт), "Все письма в корзине будут удалены навсегда.", х + 28, у + 70, Ц_ТЕКСТ);
        писать(к, пх(к.мелкий), "Корзина и так очищается сама: письма старше 7 дней уходят из неё.", х + 28, у + 104, Ц_ТИХИЙ);
