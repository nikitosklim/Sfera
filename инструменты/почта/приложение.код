        верх = 0x8ea4ff;
        низ = 0x7b5cf6;
        цвет_текста = 0xffffff;
        если (над)
            верх = 0xaabcff;
            низ = 0x9373ff;
        конец
    иначе если (над)
        верх = 0x34489a;
        низ = 0x202d6e;
    конец
    если ( не включена)
        верх = 0x101834;
        низ = 0x0c1229;
        цвет_текста = 0x55678f;
    конец
    градиент_скругл(к, верх, низ, 255, х, у, ш, выс, 8);
    если (включена)
        залить_альфа(к, 0xffffff, 40, х + 8, у + 1, ш - 16, 1);
    конец
    писать_по_центру(к, пх(к.шрифт), подпись, х + ш / 2, у + (выс - 20) / 2, цвет_текста);
