// почта.код — «Почта Сферы»: точка входа почтового клиента (Linux и Windows: меню рисуется внутри окна).
// На macOS меню стоит в самом верху экрана — там запускается почта_мак.код.
//
// Сборка и запуск:
//   запустить почта.код --линковать SDL2 --линковать SDL2_ttf --линковать m --линковать ssl --линковать crypto
//
// Вся работа клиента — в приложение.код; здесь только окно и цикл.

подключить приложение;

функция главная(): целое
    Кисть к = создать_кисть("Почта Сферы", Ш_ОКНА, В_ОКНА);
    Состояние с = новое_состояние();
    Ящик я = Ящик(0, 0, нет, "", 0);
    Меню м = меню_создать();
    начать_сеанс(с);
    текст буфер = выделить_память(128);
    пока (с.выход == 0)
        оборот(к, с, я, м, буфер);
    конец
    закончить_сеанс(я);
    вернуть 0;
конец
