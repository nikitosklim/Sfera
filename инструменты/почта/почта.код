функция значение_ключа(текст все, текст ключ): текст
    текст с = "\n" + все;
    результат из целого где = найти(с, "\n" + ключ + "=");
    если ( не где.успешно)
        вернуть "";
    конец
    целое от = где.значение + длина(ключ) + 2;
    целое до = найти_байт(с, 10, от);
    если (до меньше 0)
        до = длина(с);
    конец
    вернуть без_краёв(срез(с, от, до - от));
конец

