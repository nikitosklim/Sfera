// Русская раскладка -> клавиша на латинской (для сочетаний ⌘).
функция латинская_клавиша(целое клавиша): целое
    если (клавиша не меньше 1072 и клавиша не больше 1103)
        текст таблица = "f,dult;pbqrkvyjghcnea[wxio]sm'.z";
        вернуть целое(байт_текста(таблица, клавиша - 1072));
    конец
    если (клавиша == 1105)
        вернуть 96;
    конец
    вернуть клавиша;
конец

// Сообщения серверов — на понятный русский.
функция понятная_ошибка(текст сообщение): текст
    результат из целого а = найти(сообщение, "AUTHENTICATIONFAILED");
    результат из целого б = найти(сообщение, "Authentication failed");
    результат из целого в_ = найти(сообщение, "535");
    если (а.успешно или б.успешно или в_.успешно)
        вернуть "Неверное имя пользователя или пароль";
    конец
    вернуть сообщение;
конец

функция попытка_войти(Состояние с, Ящик я): целое
    если (длина(без_краёв(с.узел)) == 0 или длина(без_краёв(с.имя)) == 0 или длина(с.пароль) == 0)
        с.сбой = "Заполните сервер, имя пользователя и пароль";
        вернуть 0;
    конец
    с.сбой = "Входим…";
    с.дело = 1;
    с.грязно = 1;
    вернуть 0;
конец

функция выполнить_дело(Кисть к, Состояние с, Ящик я): целое
    целое д = с.дело;
    с.дело = 0;
    если (д == 1)
        открыть_ящик(с, я);
        если (я.открыт)
            с.сбой = "";
            сохранить_настройки(с);
            с.экран = 1;
            с.статус = "";
            обновить_список(с, я);
            если (с.видимые.размер() больше 0)
                перейти_к(к, с, я, 0);
            конец
        иначе
            с.сбой = понятная_ошибка(я.сбой);
        конец
    иначе если (д == 2)
        обновить_список(с, я);
    иначе если (д == 3)
        если (с.есть_открыто == 1 и с.выбрано больше 0 - 1)
            целое номер = с.видимые.получить(с.выбрано);
            ПисьмоВСписке п = с.письма.получить(номер);
            я.сбой = "";
            ящик_удалить(я, п.код);
            закрыть_письмо(с);
            обновить_список(с, я);
            сказать(с, "Письмо удалено");
        конец
    иначе если (д == 4)
        сказать(с, "Отправляем письмо…");
        отправить(с);
    конец
    с.грязно = 1;
    вернуть 0;
конец

// ---------- события ----------
функция клавиша_клик_сочетание(Кисть к, Состояние с, Ящик я, Меню м, целое клавиша, целое мод): целое
    целое л = латинская_клавиша(клавиша);
    // ⌘ (0x400|0x800) или Ctrl (0x40|0x80)
    верно команда_нажата = (мод / 64) % 4 != 0 или (мод / 1024) % 4 != 0;
    если ( не команда_нажата)
        вернуть 0;
    конец
    если (л больше 96 и л меньше 123)
        текст сочетание = "⌘" + регистр_в_верхний(срез("abcdefghijklmnopqrstuvwxyz", л - 97, 1));
        целое ид = меню_по_сочетанию(м, сочетание);
        если (ид больше 0 и не в_перечне(отключённые(с), ид))
