        иначе если (с.поле == 2)
            с.пароль = удалить_последний_символ(с.пароль);
        иначе
            с.отправитель = удалить_последний_символ(с.отправитель);
        конец
    иначе если (с.экран == 2)
        если (с.поле == 0)
            с.к_кому = удалить_последний_символ(с.к_кому);
        иначе если (с.поле == 1)
            с.к_тема = удалить_последний_символ(с.к_тема);
        иначе если (с.поле == 2)
            с.к_тело = удалить_последний_символ(с.к_тело);
        иначе
            с.к_путь = удалить_последний_символ(с.к_путь);
