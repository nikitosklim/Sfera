// Какие команды сейчас недоступны (серые) и какие отмечены галочкой.
функция отключённые(Состояние с): текст
    текст итог = ",";
    если (с.экран != 1)
        итог = итог + "2,3,6,4,25,26,27,12,13,20,21,30,31,32,33,";
    конец
    если (с.есть_открыто == 0)
        итог = итог + "25,26,27,3,6,10,";
    иначе если (с.вл_имена.размер() == 0)
        итог = итог + "3,6,";
    конец
    если (с.экран == 2)
        итог = итог + "1,";
    конец
    вернуть итог;
конец

функция отмеченные(Состояние с): текст
    текст итог = ",";
    если (с.только_новые == 1)
        итог = итог + "20,";
    конец
    если (с.плотный == 1)
        итог = итог + "21,";
    конец
    вернуть итог;
конец

функция перейти_к(Кисть к, Состояние с, Ящик я, целое место): целое
    если (с.видимые.размер() == 0)
        вернуть 0;
    конец
    целое н = место;
    если (н меньше 0)
        н = 0;
    конец
    если (н не меньше с.видимые.размер())
        н = с.видимые.размер() - 1;
    конец
    с.выбрано = н;
    показать_выбранное(с);
    открыть_выбранное(к, с, я);
    с.грязно = 1;
    вернуть 1;
конец

функция выполнить(Кисть к, Состояние с, Ящик я, Меню м, целое команда): целое
    с.грязно = 1;
    если (команда == 1)
        если (с.экран == 1)
            начать_письмо(с, "", "", "");
        конец
    иначе если (команда == 2 и с.экран == 1)
        сказать(с, "Получаем почту…");
        с.дело = 2;
    иначе если (команда == 3 и с.экран == 1)
        если (с.есть_открыто == 1 и с.вл_имена.размер() == 1)
            сохранить_вложение(с, 0);
        иначе если (с.есть_открыто == 1)
            сказать(с, "Нажмите на нужное вложение — или «Сохранить все вложения»");
        конец
    иначе если (команда == 6 и с.экран == 1)
        сохранить_все_вложения(с);
    иначе если (команда == 4)
        ящик_закрыть(я);
        закрыть_письмо(с);
        очистить_целые(с.видимые);
        пока (с.письма.размер() больше 0)
            с.письма.удалить(с.письма.размер() - 1);
        конец
        очистить_целые(с.новые);
        с.пароль = "";
        с.экран = 0;
        с.поле = 2;
        с.выбрано = 0 - 1;
        с.статус = "";
    иначе если (команда == 5)
        с.выход = 1;
    иначе если (команда == 10)
        если (с.есть_открыто == 1)
            задать_буфер_обмена(с.о_тело);
            сказать(с, "Текст письма скопирован");
        конец
    иначе если (команда == 11)
        вставить_из_буфера(с);
    иначе если (команда == 12 и с.экран == 1)
        с.поиск_активен = 1;
    иначе если (команда == 13 и с.экран == 1)
        с.поиск = "";
        с.поиск_активен = 0;
        пересчитать(с);
    иначе если (команда == 20 и с.экран == 1)
        с.только_новые = 1 - с.только_новые;
        пересчитать(с);
        с.прокрутка = 0;
    иначе если (команда == 21 и с.экран == 1)
        с.плотный = 1 - с.плотный;
        ограничить_прокрутку(с);
        показать_выбранное(с);
    иначе если (команда == 25 и с.экран == 1)
        ответить(с);
    иначе если (команда == 26 и с.экран == 1)
        если (с.есть_открыто == 1)
            сказать(с, "Письмо уже отмечено прочитанным");
        конец
    иначе если (команда == 27 и с.экран == 1)
        если (с.есть_открыто == 1)
            с.диалог = 3;
        конец
    иначе если (команда == 30 и с.экран == 1)
        перейти_к(к, с, я, с.выбрано + 1);
    иначе если (команда == 31 и с.экран == 1)
        перейти_к(к, с, я, с.выбрано - 1);
    иначе если (команда == 32 и с.экран == 1)
        перейти_к(к, с, я, 0);
    иначе если (команда == 33 и с.экран == 1)
        перейти_к(к, с, я, с.видимые.размер() - 1);
    иначе если (команда == 40)
        свернуть_окно(пх(к.окно));
    иначе если (команда == 41)
        режим_экрана(пх(к.окно), беззнак32(4097));
        сказать(с, "Выйти из полного экрана — F11");
    иначе если (команда == 50)
        с.диалог = 1;
    иначе если (команда == 51)
        с.диалог = 2;
    конец
    вернуть 0;
конец

функция вставить_из_буфера(Состояние с): целое
    текст из_буфера = буфер_обмена_текст();
    если (длина(из_буфера) == 0)
        вернуть 0;
    конец
    ввести_текст(с, из_буфера);
    вернуть 0;
конец

// Ввод в активное поле текущего экрана.
функция ввести_текст(Состояние с, текст кусок): целое
    с.грязно = 1;
    если (с.экран == 0)
        текст ч = в_одну_строку(кусок);
        если (с.поле == 0)
            с.узел = с.узел + ч;
        иначе если (с.поле == 1)
            с.имя = с.имя + ч;
        иначе если (с.поле == 2)
            с.пароль = с.пароль + ч;
        иначе
            с.отправитель = с.отправитель + ч;
        конец
        с.сбой = "";
    иначе если (с.экран == 2)
        если (с.поле == 0)
            с.к_кому = с.к_кому + в_одну_строку(кусок);
        иначе если (с.поле == 1)
            с.к_тема = с.к_тема + в_одну_строку(кусок);
        иначе если (с.поле == 2)
            с.к_тело = с.к_тело + кусок;
        иначе
            с.к_путь = с.к_путь + в_одну_строку(кусок);
        конец
    иначе если (с.экран == 1 и с.поиск_активен == 1)
        с.поиск = с.поиск + в_одну_строку(кусок);
        пересчитать(с);
        с.прокрутка = 0;
    конец
    вернуть 0;
конец

