функция загрузить_настройки(Состояние с): целое
    с.отправитель = "почта@языксфера.рф";
    с.отправитель_имя = "Сфера";
    с.узел = "mail.языксфера.рф";
    результат из текста файл = прочитать_файл(путь_настроек());
    если (файл.успешно)
        текст вв = файл.значение;
        если (длина(значение_ключа(вв, "узел")) больше 0)
            с.узел = значение_ключа(вв, "узел");
        конец
        с.имя = значение_ключа(вв, "имя");
        если (длина(значение_ключа(вв, "отправитель")) больше 0)
            с.отправитель = значение_ключа(вв, "отправитель");
        конец
        если (длина(значение_ключа(вв, "отправитель_имя")) больше 0)
            с.отправитель_имя = значение_ключа(вв, "отправитель_имя");
        конец
        с.порт_получения = число_или(значение_ключа(вв, "порт_получения"), 993);
        с.порт_отправки = число_или(значение_ключа(вв, "порт_отправки"), 465);
        с.доверие = значение_ключа(вв, "доверие");
    конец
    // Переменные окружения важнее файла (для проверок и сценариев).
    если (длина(окружение("СФЕРА_ПОЧТА_УЗЕЛ")) больше 0)
        с.узел = окружение("СФЕРА_ПОЧТА_УЗЕЛ");
    конец
    если (длина(окружение("СФЕРА_ПОЧТА_ИМЯ")) больше 0)
        с.имя = окружение("СФЕРА_ПОЧТА_ИМЯ");
    конец
    если (длина(окружение("СФЕРА_ПОЧТА_ПОРТ")) больше 0)
        с.порт_получения = число_из_текста(окружение("СФЕРА_ПОЧТА_ПОРТ"));
    конец
    если (длина(окружение("СФЕРА_ПОЧТА_ПОРТ_ОТПРАВКИ")) больше 0)
        с.порт_отправки = число_из_текста(окружение("СФЕРА_ПОЧТА_ПОРТ_ОТПРАВКИ"));
    конец
    если (длина(окружение("СФЕРА_ПОЧТА_ДОВЕРИЕ")) больше 0)
        с.доверие = окружение("СФЕРА_ПОЧТА_ДОВЕРИЕ");
    конец
    если (длина(окружение("СФЕРА_ПОЧТА_ОТПРАВИТЕЛЬ")) больше 0)
        с.отправитель = окружение("СФЕРА_ПОЧТА_ОТПРАВИТЕЛЬ");
    конец
    вернуть 0;
конец

