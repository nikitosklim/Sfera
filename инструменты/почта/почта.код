    целое ин = 0;
    пока (ин меньше с.новые.размер())
        н = н + с.новые.получить(ин);
        ин = ин + 1;
    конец
    вернуть н;
конец

// Собирает список видимых писем (новейшие первыми) с учётом поиска и фильтра «только непрочитанные».
функция пересчитать(Состояние с): целое
    // Выбранное письмо запоминаем по его коду на сервере: номера в списке после обновления сдвигаются.
    целое выбранный_код = 0 - 1;
    если (с.выбрано больше 0 - 1 и с.выбрано меньше с.видимые.размер())
        ПисьмоВСписке было = с.письма.получить(с.видимые.получить(с.выбрано));
        выбранный_код = было.код;
    конец
    очистить_целые(с.видимые);
    текст запрос = регистр_в_нижний(без_краёв(с.поиск));
    целое ин = с.письма.размер() - 1;
    пока (ин больше 0 - 1)
        верно берём = да;
        если (с.только_новые == 1 и с.новые.получить(ин) == 0)
            берём = нет;
        конец
        если (берём и длина(запрос) больше 0)
            ПисьмоВСписке п = с.письма.получить(ин);
            текст стог = регистр_в_нижний(п.от_кого + " " + п.тема);
            результат из целого р = найти(стог, запрос);
            берём = р.успешно;
        конец
        если (берём)
            с.видимые.добавить(ин);
        конец
        ин = ин - 1;
    конец
    с.выбрано = 0 - 1;
    целое й = 0;
    пока (й меньше с.видимые.размер())
        ПисьмоВСписке есть = с.письма.получить(с.видимые.получить(й));
        если (есть.код == выбранный_код)
            с.выбрано = й;
        конец
        й = й + 1;
    конец
    с.грязно = 1;
    вернуть 0;
конец

функция строк_в_списке(Состояние с): целое
    вернуть (НИЗ - ВЕРХ - 26) / высота_строки(с);
конец

функция высота_строки(Состояние с): целое
    если (с.плотный == 1)
        вернуть 38;
    конец
    вернуть 62;
конец

функция показать_выбранное(Состояние с): целое
    если (с.выбрано меньше 0)
        вернуть 0;
    конец
    если (с.выбрано меньше с.прокрутка)
        с.прокрутка = с.выбрано;
    конец
    если (с.выбрано не меньше с.прокрутка + строк_в_списке(с))
        с.прокрутка = с.выбрано - строк_в_списке(с) + 1;
    конец
    вернуть 0;
конец

функция ограничить_прокрутку(Состояние с): целое
    целое предел = с.видимые.размер() - строк_в_списке(с);
    если (с.прокрутка больше предел)
        с.прокрутка = предел;
    конец
    если (с.прокрутка меньше 0)
        с.прокрутка = 0;
    конец
    вернуть 0;
конец

// ---------- почтовый ящик ----------
функция скопировать_ящик(Ящик куда, Ящик откуда): целое
    куда.дескриптор = откуда.дескриптор;
    куда.счётчик = откуда.счётчик;
    куда.открыт = откуда.открыт;
    куда.сбой = откуда.сбой;
    куда.писем = откуда.писем;
    вернуть 0;
конец

функция открыть_ящик(Состояние с, Ящик я): целое
    Ящик н = ящик_открыть(хост_в_пуникод(без_краёв(с.узел)), с.порт_получения, с.доверие, без_краёв(с.имя), с.пароль);
    скопировать_ящик(я, н);
    вернуть 0;
конец

// Заново выбирает «Входящие», чтобы узнать, сколько писем сейчас (после удаления и прихода новых).
функция узнать_число_писем(Ящик я): целое
    Ответ в_папку = ящик_команда(я, "SELECT INBOX");
    если ( не в_папку.успешно)
        я.сбой = "не удалось открыть «Входящие»: " + в_папку.сообщение;
        вернуть 0;
    конец
    я.писем = 0;
    для каждого строка в в_папку.строки
        если (начинается_с(строка, "* ") и найти_от(строка, " EXISTS", 0) > 0)
            я.писем = число_после(строка, "* ");
        конец
    конец
    вернуть 1;
конец

функция обновить_список(Состояние с, Ящик я): целое
    я.сбой = "";
    узнать_число_писем(я);
    если (длина(я.сбой) больше 0)
        // соединение могло устареть — открываем заново один раз
        ящик_закрыть(я);
        открыть_ящик(с, я);
        если ( не я.открыт)
            сказать(с, "Нет связи с сервером: " + я.сбой);
            вернуть 0;
        конец
    конец
    Список из ПисьмоВСписке л = ящик_список(я, 300);
    если (длина(я.сбой) больше 0)
        сказать(с, "Не удалось получить список: " + я.сбой);
        вернуть 0;
    конец
    очистить_целые(с.новые);
    пока (с.письма.размер() больше 0)
        с.письма.удалить(с.письма.размер() - 1);
    конец
    для каждого п в л
        с.письма.добавить(п);
        если (п.прочитано)
            с.новые.добавить(0);
        иначе
            с.новые.добавить(1);
        конец
    конец
    пересчитать(с);
    с.обновлено = с.кадр;
    целое н = сколько_новых(с);
    если (н больше 0)
        сказать(с, "Получено. Новых писем: " + целое_в_текст(н));
    иначе
        сказать(с, "Получено. Новых писем нет");
    конец
    вернуть 1;
конец

функция закрыть_письмо(Состояние с): целое
    целое ин = 0;
    пока (ин меньше с.вл_адреса.размер())
        освободить_данные(Данные(с.вл_адреса.получить(ин), с.вл_размеры.получить(ин)));
        ин = ин + 1;
    конец
    очистить_тексты(с.вл_имена);
    очистить_целые(с.вл_адреса);
    очистить_целые(с.вл_размеры);
    с.о_от = "";
    с.о_кому = "";
    с.о_тема = "";
    с.о_дата = "";
    с.о_тело = "";
    с.есть_открыто = 0;
    с.открыт_код = 0;
    очистить_тексты(с.тело_строки);
    очистить_целые(с.чипы);
    с.тело_прокрутка = 0;
    вернуть 0;
конец

функция открыть_выбранное(Кисть к, Состояние с, Ящик я): целое
    если (с.выбрано меньше 0 или с.выбрано не меньше с.видимые.размер())
        закрыть_письмо(с);
        вернуть 0;
    конец
    целое номер = с.видимые.получить(с.выбрано);
    ПисьмоВСписке из_списка = с.письма.получить(номер);
    если (из_списка.код == с.открыт_код и с.есть_открыто == 1)
        вернуть 0;
    конец
    закрыть_письмо(с);
    я.сбой = "";
    Письмо п = ящик_письмо(я, из_списка.код);
    если (длина(я.сбой) больше 0)
        сказать(с, "Не удалось открыть письмо: " + я.сбой);
        вернуть 0;
    конец
    // Всё копируем в состояние: поля структуры «Письмо» живут только пока жива переменная п.
    с.о_от = срез(п.от_кого, 0, длина(п.от_кого));
    с.о_кому = срез(п.кому, 0, длина(п.кому));
    с.о_тема = срез(п.тема, 0, длина(п.тема));
    с.о_дата = срез(п.дата, 0, длина(п.дата));
    с.о_тело = срез(п.тело, 0, длина(п.тело));
    для каждого влож в п.вложения
        с.вл_имена.добавить(срез(влож.имя, 0, длина(влож.имя)));
        с.вл_адреса.добавить(влож.адрес);
        с.вл_размеры.добавить(влож.размер);
    конец
    с.есть_открыто = 1;
    с.открыт_код = из_списка.код;
    текст тело = с.о_тело;
    если (длина(тело) больше 60000)
        тело = срез(тело, 0, 60000) + "\n\n… (письмо длиннее, показано начало)";
    конец
    перенос(к, пх(к.шрифт), тело, ПОЛЕЗНАЯ_ШИРИНА, с.тело_строки);
    если (с.новые.получить(номер) == 1)
        ящик_прочитано(я, из_списка.код);
        с.новые.установить(номер, 0);
    конец
    с.грязно = 1;
    вернуть 1;
конец

// ---------- вложения ----------
функция папка_загрузок(): текст
    вернуть домашняя() + "/Downloads";
конец

функция сохранить_вложение(Состояние с, целое номер): целое
    если (с.есть_открыто == 0 или номер меньше 0 или номер не меньше с.вл_имена.размер())
        вернуть 0;
    конец
    выполнить_команду("mkdir -p '" + для_оболочки(папка_загрузок()) + "'");
    текст имя = безопасное_имя(с.вл_имена.получить(номер));
    текст путь = папка_загрузок() + "/" + имя;
    целое попытка = 2;
    результат из целого есть_ли = размер_файла(путь);
    пока (есть_ли.успешно и попытка меньше 100)
        путь = папка_загрузок() + "/(" + целое_в_текст(попытка) + ") " + имя;
        попытка = попытка + 1;
        есть_ли = размер_файла(путь);
    конец
    верно ок = записать_файл_байтами(путь, Данные(с.вл_адреса.получить(номер), с.вл_размеры.получить(номер)));
    если (ок)
        сказать(с, "Сохранено в «Загрузки»: " + имя_файла_из_пути(путь));
        вернуть 1;
    конец
    сказать(с, "Не удалось сохранить вложение: " + имя);
    вернуть 0;
конец

функция сохранить_все_вложения(Состояние с): целое
    если (с.есть_открыто == 0 или с.вл_имена.размер() == 0)
        сказать(с, "В письме нет вложений");
        вернуть 0;
    конец
    целое ин = 0;
    пока (ин меньше с.вл_имена.размер())
        сохранить_вложение(с, ин);
        ин = ин + 1;
    конец
    сказать(с, "Сохранено вложений: " + целое_в_текст(с.вл_имена.размер()) + " (папка «Загрузки»)");
    вернуть 1;
конец

// ---------- написание ----------
функция начать_письмо(Состояние с, текст кому, текст тема, текст тело): целое
    с.к_кому = кому;
    с.к_тема = тема;
    с.к_тело = тело;
    очистить_тексты(с.к_файлы);
    с.к_путь = "";
    с.к_путь_вкл = 0;
    с.поле = 0;
    если (длина(кому) больше 0)
        с.поле = 2;
    конец
    с.экран = 2;
    с.поиск_активен = 0;
    с.грязно = 1;
    вернуть 0;
конец

функция ответить(Состояние с): целое
    если (с.есть_открыто == 0)
        сказать(с, "Сначала откройте письмо");
        вернуть 0;
    конец
    текст тема = с.о_тема;
    если ( не начинается_с(регистр_в_нижний(тема), "re:") и не начинается_с(регистр_в_нижний(тема), "ответ:"))
        тема = "Re: " + тема;
    конец
    Список из текстов строки = Список из текстов();
    разрезать_строки(с.о_тело, строки);
    текст цитата = "\n\n" + имя_из_адреса(с.о_от) + " писал(а):\n";
    целое последняя = строки.размер();
    пока (последняя больше 0 и длина(без_краёв(строки.получить(последняя - 1))) == 0)
        последняя = последняя - 1;
    конец
    целое ин = 0;
    пока (ин меньше последняя и ин меньше 200)
        цитата = цитата + "> " + строки.получить(ин) + "\n";
        ин = ин + 1;
    конец
    начать_письмо(с, адрес_из_адреса(с.о_от), тема, цитата);
    // курсор — в начало письма невозможен (ввод только в конец), поэтому ответ пишется под цитатой
    с.поле = 2;
    вернуть 1;
конец

функция разрезать_строки(текст все, Список из текстов итог): целое
    целое от = 0;
    целое п = 0;
    пока (п не больше длина(все))
        если (п == длина(все) или целое(байт_текста(все, п)) == 10)
            итог.добавить(без_правого_возврата(срез(все, от, п - от)));
            от = п + 1;
        конец
        п = п + 1;
    конец
    вернуть итог.размер();
конец

функция без_правого_возврата(текст т): текст
    если (длина(т) больше 0 и целое(байт_текста(т, длина(т) - 1)) == 13)
        вернуть срез(т, 0, длина(т) - 1);
    конец
    вернуть т;
конец

функция добавить_файл(Состояние с, текст путь_сырой): целое
    текст путь = без_краёв(путь_сырой);
    если (длина(путь) больше 1 и целое(байт_текста(путь, 0)) == 39)
        путь = срез(путь, 1, длина(путь) - 2);
    конец
    если (длина(путь) больше 1 и целое(байт_текста(путь, 0)) == 126)
        путь = домашняя() + срез(путь, 1, длина(путь) - 1);
    конец
    результат из целого найден = размер_файла(путь);
    если ( не найден.успешно)
        сказать(с, "Файл не найден: " + путь);
        вернуть 0;
    конец
    с.к_файлы.добавить(путь);
    сказать(с, "Прикреплено: " + имя_файла_из_пути(путь));
    вернуть 1;
конец

функция отправить(Состояние с): целое
    если (длина(без_краёв(с.к_кому)) == 0)
        сказать(с, "Укажите, кому отправить письмо");
        с.поле = 0;
        вернуть 0;
    конец
    Список из Вложение вложения = Список из Вложение();
    Список из Данные данные = Список из Данные();
    целое ин = 0;
    пока (ин меньше с.к_файлы.размер())
        текст путь = с.к_файлы.получить(ин);
        Данные д = прочитать_файл_байтами(путь);
        если (д.адрес == 0 и д.размер == 0)
            // пустой файл тоже допустим, но если не прочитался — скажем
            результат из целого р = размер_файла(путь);
            если ( не р.успешно или р.значение больше 0)
                сказать(с, "Не удалось прочитать файл: " + имя_файла_из_пути(путь));
                вернуть 0;
            конец
        конец
        данные.добавить(д);
        текст имя = имя_файла_из_пути(путь);
        вложения.добавить(Вложение(имя, тип_по_имени(имя), д.адрес, д.размер));
        ин = ин + 1;
    конец
    текст письмо = собрать_письмо(с.отправитель_имя, с.отправитель, без_краёв(с.к_кому), с.к_тема, с.к_тело, вложения);
    результат из верного р = отправить_письмо(хост_в_пуникод(без_краёв(с.узел)), с.порт_отправки, с.доверие, без_краёв(с.имя), с.пароль, с.отправитель, без_краёв(с.к_кому), письмо);
    целое й = 0;
    пока (й меньше данные.размер())
        освободить_данные(данные.получить(й));
        й = й + 1;
    конец
    если (р.успешно)
        с.экран = 1;
        сказать(с, "Письмо отправлено: " + без_краёв(с.к_кому));
        вернуть 1;
    конец
    сказать(с, "Не отправлено: " + понятная_ошибка(р.сообщение));
    вернуть 0;
конец

// ---------- рисование: общие части ----------
функция кнопка(Кисть к, Состояние с, текст подпись, целое х, целое у, целое ш, целое выс, целое основная, верно включена): верно
    верно над = внутри(с.мышь_х, с.мышь_у, х, у, ш, выс) и включена;
    целое фон = Ц_ПАНЕЛЬ2;
    если (основная == 1)
        фон = Ц_СИНИЙ;
    конец
    если (над и основная == 0)
        фон = Ц_ЛИНИЯ;
    конец
    если (над и основная == 1)
        фон = Ц_СВЕТЛЫЙ;
    конец
    если ( не включена)
        фон = Ц_ПАНЕЛЬ;
    конец
    залить_скругл(к, фон, х, у, ш, выс, 6);
    если (основная == 0)
        рамка(к, Ц_ЛИНИЯ, х, у, ш, выс);
    конец
    целое цвет_текста = Ц_ТЕКСТ;
    если ( не включена)
        цвет_текста = 0x55678f;
    конец
    писать_по_центру(к, пх(к.шрифт), подпись, х + ш / 2, у + (выс - 20) / 2, цвет_текста);
    вернуть над;
конец

функция поле_текста(Кисть к, Состояние с, текст подпись, текст значение, целое х, целое у, целое ш, целое активно, целое скрыть, текст подсказка): целое
    если (длина(подпись) больше 0)
        писать(к, пх(к.мелкий), подпись, х, у - 19, Ц_ТИХИЙ);
    конец
    залить_скругл(к, Ц_ФОН, х, у, ш, 36, 6);
    если (активно == 1)
        рамка(к, Ц_СИНИЙ, х, у, ш, 36);
        рамка(к, Ц_СИНИЙ, х + 1, у + 1, ш - 2, 34);
    иначе
        рамка(к, Ц_ЛИНИЯ, х, у, ш, 36);
    конец
    текст видимое = значение;
    если (скрыть == 1)
        видимое = "";
        целое н = знаков(значение);
        если (н больше 40)
            н = 40;
        конец
        целое ин = 0;
        пока (ин меньше н)
            видимое = видимое + "•";
            ин = ин + 1;
        конец
    иначе
        видимое = по_ширине_справа(к, значение, ш - 28);
    конец
    если (длина(значение) == 0 и длина(подсказка) больше 0)
        писать(к, пх(к.шрифт), подсказка, х + 12, у + 8, 0x4d6190);
    иначе
        писать(к, пх(к.шрифт), видимое, х + 12, у + 8, Ц_ТЕКСТ);
    конец
    если (активно == 1 и (с.кадр / 15) % 2 == 0)
        залить(к, Ц_ТЕКСТ, х + 14 + ширина_строки(к, пх(к.шрифт), видимое), у + 8, 2, 20);
    конец
    вернуть 0;
конец

// Если текст не помещается, показываем его конец (там идёт ввод).
функция по_ширине_справа(Кисть к, текст т, целое макс): текст
    текст итог = т;
    пока (ширина_строки(к, пх(к.шрифт), итог) больше макс и знаков(итог) больше 1)
        целое п = 1;
        пока (п меньше длина(итог) и не начало_знака(целое(байт_текста(итог, п))))
            п = п + 1;
        конец
        итог = срез(итог, п, длина(итог) - п);
    конец
    вернуть итог;
конец

функция аватар(Кисть к, текст имя, целое х, целое у, целое размер): целое
    залить_скругл(к, Ц_ВЫДЕЛЕНИЕ, х, у, размер, размер, размер / 2);
    текст буква = "";
    если (длина(имя) больше 0)
        целое п = 1;
        пока (п меньше длина(имя) и не начало_знака(целое(байт_текста(имя, п))))
            п = п + 1;
        конец
        буква = регистр_в_верхний(срез(имя, 0, п));
    конец
    писать_по_центру(к, пх(к.шрифт), буква, х + размер / 2, у + размер / 2 - 10, Ц_СВЕТЛЫЙ);
    вернуть 0;
конец

// ---------- вход ----------
функция положение_поля_входа(целое номер): целое
    вернуть 178 + номер * 70;
конец

функция нарисовать_вход(Кисть к, Состояние с, Меню м): целое
    залить(к, Ц_ФОН, 0, 0, Ш_ОКНА, В_ОКНА);
    целое кх = (Ш_ОКНА - 480) / 2;
    залить_скругл(к, Ц_ПАНЕЛЬ, кх, 56, 480, 574, 12);
    рамка(к, Ц_ЛИНИЯ, кх, 56, 480, 574);
    писать_по_центру(к, пх(к.крупный), "Почта Сферы", Ш_ОКНА / 2, 78, Ц_ТЕКСТ);
    писать_по_центру(к, пх(к.мелкий), "Вход в ящик · защищённое соединение", Ш_ОКНА / 2, 112, Ц_ТИХИЙ);
    поле_текста(к, с, "Сервер", с.узел, кх + 40, положение_поля_входа(0), 400, ц_если(с.поле == 0), 0, "mail.языксфера.рф");
    поле_текста(к, с, "Имя пользователя", с.имя, кх + 40, положение_поля_входа(1), 400, ц_если(с.поле == 1), 0, "pochta");
    поле_текста(к, с, "Пароль", с.пароль, кх + 40, положение_поля_входа(2), 400, ц_если(с.поле == 2), 1, "");
    поле_текста(к, с, "Адрес отправителя", с.отправитель, кх + 40, положение_поля_входа(3), 400, ц_если(с.поле == 3), 0, "почта@языксфера.рф");
    кнопка(к, с, "Войти", кх + 40, 466, 400, 42, 1, да);
    если (длина(с.сбой) больше 0)
        писать_по_центру(к, пх(к.мелкий), по_ширине(к, пх(к.мелкий), с.сбой, 420), Ш_ОКНА / 2, 522, Ц_КРАСНЫЙ);
    конец
    писать_по_центру(к, пх(к.мелкий), "Пароль нигде не сохраняется. Enter в поле пароля — войти.", Ш_ОКНА / 2, 580, Ц_ТИХИЙ);
    вернуть 0;
конец

функция ц_если(верно у): целое
    если (у)
        вернуть 1;
    конец
    вернуть 0;
конец

