функция нарисовать_панель_кнопок(Кисть к, Состояние с): целое
    градиент(к, 0x14213f, 0x101a33, 0, 28, Ш_ОКНА, 44);
    черта(к, Ц_ЛИНИЯ, 0, 71, Ш_ОКНА);
    верно есть_письмо = с.есть_открыто == 1;
    кнопка(к, с, "Написать", 12, 36, 104, 28, 1, да);
    кнопка(к, с, "Получить", 124, 36, 104, 28, 0, да);
    кнопка(к, с, "Ответить", 236, 36, 104, 28, 0, есть_письмо);
    кнопка(к, с, "Удалить", 348, 36, 92, 28, 0, есть_письмо);
    поле_поиска(к, с);
    вернуть 0;
конец

функция поле_поиска(Кисть к, Состояние с): целое
    целое х = Ш_ОКНА - 14 - 270;
    залить_скругл(к, Ц_ФОН, х, 36, 270, 28, 14);
    если (с.поиск_активен == 1)
        рамка(к, Ц_СИНИЙ, х, 36, 270, 28);
    иначе
        рамка(к, Ц_ЛИНИЯ, х, 36, 270, 28);
    конец
    если (длина(с.поиск) == 0)
        писать(к, пх(к.мелкий), "Поиск по письмам  ⌘F", х + 16, 43, 0x4d6190);
    иначе
        писать(к, пх(к.шрифт), по_ширине_справа(к, с.поиск, 238), х + 14, 40, Ц_ТЕКСТ);
    конец
    если (с.поиск_активен == 1 и (с.кадр / 15) % 2 == 0)
        залить(к, Ц_ТЕКСТ, х + 16 + ширина_строки(к, пх(к.шрифт), по_ширине_справа(к, с.поиск, 238)), 41, 2, 18);
    конец
    вернуть 0;
конец

функция нарисовать_список(Кисть к, Состояние с): целое
    залить(к, Ц_ФОН, 0, ВЕРХ, Ш_СПИСКА, НИЗ - ВЕРХ);
    // заголовок списка
    залить(к, Ц_ПАНЕЛЬ, 0, ВЕРХ, Ш_СПИСКА, 26);
    текст заг = "Входящие";
    если (с.только_новые == 1)
        заг = "Входящие · только непрочитанные";
    конец
    писать(к, пх(к.мелкий), заг, 14, ВЕРХ + 5, Ц_ТЕКСТ);
    писать_справа(к, пх(к.мелкий), целое_в_текст(с.видимые.размер()) + " из " + целое_в_текст(с.письма.размер()), Ш_СПИСКА - 14, ВЕРХ + 5, Ц_ТИХИЙ);
    черта(к, Ц_ЛИНИЯ, 0, ВЕРХ + 25, Ш_СПИСКА);

    целое вв = высота_строки(с);
    целое кол = строк_в_списке(с);
    целое н = с.видимые.размер();
    если (н == 0)
        текст сообщение = "В ящике пока нет писем";
        если (длина(с.поиск) больше 0 или с.только_новые == 1)
            сообщение = "Ничего не найдено";
        конец
        писать_по_центру(к, пх(к.шрифт), сообщение, Ш_СПИСКА / 2, ВЕРХ + 120, Ц_ТИХИЙ);
    конец
    целое ин = 0;
    пока (ин меньше кол и с.прокрутка + ин меньше н)
        целое место = с.прокрутка + ин;
        целое номер = с.видимые.получить(место);
        ПисьмоВСписке п = с.письма.получить(номер);
        целое у = ВЕРХ + 26 + ин * вв;
        верно новое = с.новые.получить(номер) == 1;
        верно под_мышью = внутри(с.мышь_х, с.мышь_у, 0, у, Ш_СПИСКА, вв) и с.диалог == 0;
        если (место == с.выбрано)
            залить(к, Ц_ВЫДЕЛЕНИЕ, 0, у, Ш_СПИСКА, вв);
            залить(к, Ц_СИНИЙ, 0, у, 3, вв);
        иначе если (под_мышью)
            залить(к, Ц_ПАНЕЛЬ, 0, у, Ш_СПИСКА, вв);
        конец
        целое цвет_имени = Ц_ТЕКСТ;
        если ( не новое)
            цвет_имени = 0xb6c4e6;
        конец
        если (новое)
            залить_скругл(к, Ц_СИНИЙ, 12, у + 11, 9, 9, 4);
        конец
        текст кто = имя_из_адреса(п.от_кого);
        если (длина(кто) == 0)
            кто = "(без отправителя)";
        конец
        текст тема = п.тема;
        если (длина(тема) == 0)
            тема = "(без темы)";
        конец
        текст дата = дата_для_списка(п.дата);
        целое ш_даты = ширина_строки(к, пх(к.мелкий), дата);
        если (с.плотный == 1)
            писать(к, пх(к.шрифт), по_ширине(к, пх(к.шрифт), кто, 130), 30, у + 9, цвет_имени);
            писать(к, пх(к.мелкий), по_ширине(к, пх(к.мелкий), тема, Ш_СПИСКА - 210 - ш_даты), 172, у + 12, Ц_ТИХИЙ);
            писать_справа(к, пх(к.мелкий), дата, Ш_СПИСКА - 14, у + 12, Ц_ТИХИЙ);
        иначе
            писать(к, пх(к.шрифт), по_ширине(к, пх(к.шрифт), кто, Ш_СПИСКА - 70 - ш_даты), 30, у + 10, цвет_имени);
            писать_справа(к, пх(к.мелкий), дата, Ш_СПИСКА - 14, у + 13, Ц_ТИХИЙ);
            целое цвет_темы = Ц_ТИХИЙ;
            если (новое)
                цвет_темы = 0xc9d6f5;
            конец
            писать(к, пх(к.шрифт), по_ширине(к, пх(к.шрифт), тема, Ш_СПИСКА - 46), 30, у + 33, цвет_темы);
        конец
        черта(к, 0x1a2a4d, 12, у + вв - 1, Ш_СПИСКА - 24);
        ин = ин + 1;
    конец
    // полоса прокрутки
    если (н больше кол)
        целое всего_у = кол * вв;
        целое ползунок = всего_у * кол / н;
        если (ползунок меньше 24)
            ползунок = 24;
        конец
        целое ход = всего_у - ползунок;
        целое предел = н - кол;
        целое ру = ВЕРХ + 26 + ход * с.прокрутка / предел;
        залить_скругл(к, Ц_ЛИНИЯ, Ш_СПИСКА - 6, ру, 4, ползунок, 2);
    конец
    залить(к, Ц_ЛИНИЯ, Ш_СПИСКА, ВЕРХ, 1, НИЗ - ВЕРХ);
    вернуть 0;
конец

функция нарисовать_пусто(Кисть к, Состояние с): целое
    целое цх = Ш_СПИСКА + (Ш_ОКНА - Ш_СПИСКА) / 2;
    залить_скругл(к, Ц_ПАНЕЛЬ, цх - 36, 250, 72, 72, 36);
    писать_по_центру(к, пх(к.крупный), "С", цх, 268, Ц_СВЕТЛЫЙ);
    писать_по_центру(к, пх(к.крупный), "Выберите письмо", цх, 346, Ц_ТЕКСТ);
    текст подсказка = "Письма выбранного ящика откроются здесь";
    если (с.письма.размер() == 0)
        подсказка = "Нажмите «Получить», чтобы загрузить письма";
    конец
    писать_по_центру(к, пх(к.мелкий), подсказка, цх, 382, Ц_ТИХИЙ);
    вернуть 0;
конец

функция нарисовать_письмо(Кисть к, Состояние с): целое
    целое х0 = Ш_СПИСКА + 25;
    целое строка_ш = 20;
    // тело письма рисуем первым: шапка потом перекроет всё, что заехало вверх
    залить(к, Ц_ФОН, Ш_СПИСКА + 1, ВЕРХ, Ш_ОКНА - Ш_СПИСКА - 1, НИЗ - ВЕРХ);
    очистить_целые(с.чипы);
    // шапка: считаем её высоту заранее
    Список из текстов тема_строки = Список из текстов();
    текст тема = с.о_тема;
    если (длина(тема) == 0)
        тема = "(без темы)";
    конец
    перенос(к, пх(к.крупный), тема, ПОЛЕЗНАЯ_ШИРИНА, тема_строки);
    целое строк_темы = тема_строки.размер();
    если (строк_темы больше 2)
        строк_темы = 2;
    конец
    целое у = ВЕРХ + 14;
    целое выс_шапки = 14 + строк_темы * 27 + 8 + 64;
    // вложения: размещаем рядами по ширине
    Список из целых размещение = Список из целых();
    целое вх = х0;
    целое ряд = 0;
    целое число_вложений = с.вл_имена.размер();
    целое ин = 0;
    пока (ин меньше число_вложений)
        текст подпись = по_ширине(к, пх(к.мелкий), с.вл_имена.получить(ин), 230) + "  " + размер_в_текст(с.вл_размеры.получить(ин));
        целое ш = ширина_строки(к, пх(к.мелкий), подпись) + 34;
        если (вх + ш больше Ш_ОКНА - 25 и вх больше х0)
            вх = х0;
            ряд = ряд + 1;
        конец
        размещение.добавить(вх);
        размещение.добавить(ряд);
        размещение.добавить(ш);
        вх = вх + ш + 8;
        ин = ин + 1;
    конец
    целое рядов = 0;
    если (число_вложений больше 0)
        рядов = ряд + 1;
        выс_шапки = выс_шапки + 8 + рядов * 34;
    конец

    // тело
    целое область = НИЗ - (ВЕРХ + выс_шапки + 6);
    целое строк_тела = с.тело_строки.размер();
    целое полная_высота = строк_тела * строка_ш;
    целое предел = полная_высота - область + 20;
    если (предел меньше 0)
        предел = 0;
    конец
    если (с.тело_прокрутка больше предел)
        с.тело_прокрутка = предел;
    конец
    если (с.тело_прокрутка меньше 0)
        с.тело_прокрутка = 0;
    конец
    целое первая = с.тело_прокрутка / строка_ш;
    целое смещ = 0 - (с.тело_прокрутка % строка_ш);
    целое видно = область / строка_ш + 2;
    целое л = 0;
    пока (л меньше видно и первая + л меньше строк_тела)
        писать(к, пх(к.шрифт), с.тело_строки.получить(первая + л), х0, ВЕРХ + выс_шапки + 12 + смещ + л * строка_ш, 0xd0dbf7);
        л = л + 1;
    конец
    если (предел больше 0)
        целое ползунок = область * область / (полная_высота + 20);
        если (ползунок меньше 24)
            ползунок = 24;
        конец
        целое ход = область - ползунок;
        залить_скругл(к, Ц_ЛИНИЯ, Ш_ОКНА - 8, ВЕРХ + выс_шапки + 6 + ход * с.тело_прокрутка / предел, 4, ползунок, 2);
    конец

    // шапка поверх
    залить(к, Ц_ФОН, Ш_СПИСКА + 1, ВЕРХ, Ш_ОКНА - Ш_СПИСКА - 1, выс_шапки);
    целое т = 0;
    пока (т меньше строк_темы)
        писать(к, пх(к.крупный), тема_строки.получить(т), х0, у + т * 27, Ц_ТЕКСТ);
        т = т + 1;
    конец
    у = у + строк_темы * 27 + 10;
    текст кто = имя_из_адреса(с.о_от);
    аватар(к, кто, х0, у, 40);
    писать(к, пх(к.шрифт), по_ширине(к, пх(к.шрифт), с.о_от, ПОЛЕЗНАЯ_ШИРИНА - 200), х0 + 52, у, Ц_ТЕКСТ);
    писать_справа(к, пх(к.мелкий), дата_полная(с.о_дата), Ш_ОКНА - 25, у + 3, Ц_ТИХИЙ);
    писать(к, пх(к.мелкий), "Кому: " + по_ширине(к, пх(к.мелкий), с.о_кому, ПОЛЕЗНАЯ_ШИРИНА - 80), х0 + 52, у + 24, Ц_ТИХИЙ);
    у = у + 54;
    если (число_вложений больше 0)
        у = у + 8;
        целое вв = 0;
        пока (вв меньше число_вложений)
            целое чх = размещение.получить(вв * 3);
            целое чу = у + размещение.получить(вв * 3 + 1) * 34;
            целое чш = размещение.получить(вв * 3 + 2);
            верно над = внутри(с.мышь_х, с.мышь_у, чх, чу, чш, 28);
            целое фон = Ц_ПАНЕЛЬ2;
            если (над)
                фон = Ц_ЛИНИЯ;
            конец
            залить_скругл(к, фон, чх, чу, чш, 28, 6);
            рамка(к, Ц_ЛИНИЯ, чх, чу, чш, 28);
            залить(к, Ц_ЖЁЛТЫЙ, чх + 11, чу + 8, 8, 12);
            писать(к, пх(к.мелкий), по_ширине(к, пх(к.мелкий), с.вл_имена.получить(вв), 230) + "  " + размер_в_текст(с.вл_размеры.получить(вв)), чх + 26, чу + 7, Ц_ТЕКСТ);
            с.чипы.добавить(чх);
            с.чипы.добавить(чу);
            с.чипы.добавить(чш);
            с.чипы.добавить(28);
            вв = вв + 1;
        конец
    конец
    черта(к, Ц_ЛИНИЯ, Ш_СПИСКА + 1, ВЕРХ + выс_шапки, Ш_ОКНА - Ш_СПИСКА - 1);
    вернуть 0;
конец

функция нарисовать_статус(Кисть к, Состояние с, Ящик я): целое
    залить(к, 0x0d1730, 0, НИЗ, Ш_ОКНА, В_ОКНА - НИЗ);
    черта(к, Ц_ЛИНИЯ, 0, НИЗ, Ш_ОКНА);
    текст сообщение = с.статус;
    целое цвет_сообщения = Ц_ТЕКСТ;
    если (длина(сообщение) == 0 и с.экран == 1)
        сообщение = целое_в_текст(с.письма.размер()) + " писем, непрочитанных: " + целое_в_текст(сколько_новых(с));
        цвет_сообщения = Ц_ТИХИЙ;
    конец
    писать(к, пх(к.мелкий), по_ширине(к, пх(к.мелкий), сообщение, 640), 14, НИЗ + 6, цвет_сообщения);
    если (с.экран != 0 и я.открыт)
        залить_скругл(к, Ц_ЗЕЛЁНЫЙ, Ш_ОКНА - 14 - 8 - 4 - ширина_строки(к, пх(к.мелкий), "защищённое соединение"), НИЗ + 10, 8, 8, 4);
        писать_справа(к, пх(к.мелкий), "защищённое соединение", Ш_ОКНА - 14, НИЗ + 6, Ц_ТИХИЙ);
    конец
    вернуть 0;
конец

// ---------- написание письма ----------
функция нарисовать_написание(Кисть к, Состояние с, Ящик я): целое
    залить(к, Ц_ФОН, 0, ВЕРХ - 44, Ш_ОКНА, В_ОКНА - ВЕРХ + 44);
    градиент(к, 0x14213f, 0x101a33, 0, 28, Ш_ОКНА, 44);
    черта(к, Ц_ЛИНИЯ, 0, 71, Ш_ОКНА);
    писать(к, пх(к.крупный), "Новое письмо", 24, 36, Ц_ТЕКСТ);
    писать_справа(к, пх(к.мелкий), "От: " + с.отправитель_имя + " <" + с.отправитель + ">", Ш_ОКНА - 24, 44, Ц_ТИХИЙ);
    поле_текста(к, с, "Кому", в_одну_строку(с.к_кому), 24, 106, Ш_ОКНА - 48, ц_если(с.поле == 0), 0, "адрес получателя; несколько — через запятую");
    поле_текста(к, с, "Тема", в_одну_строку(с.к_тема), 24, 170, Ш_ОКНА - 48, ц_если(с.поле == 1), 0, "");

    // вложения или ввод пути
    целое у = 218;
    если (с.к_путь_вкл == 1)
        поле_текста(к, с, "", в_одну_строку(с.к_путь), 24, у, Ш_ОКНА - 48, ц_если(с.поле == 3), 0, "путь к файлу — вставьте его или перетащите файл в окно; Enter — прикрепить");
        у = у + 46;
    иначе
        целое вх = 24;
        целое ин = 0;
        пока (ин меньше с.к_файлы.размер())
            текст имя = имя_файла_из_пути(с.к_файлы.получить(ин));
            текст подпись = по_ширине(к, пх(к.мелкий), имя, 220);
            целое ш = ширина_строки(к, пх(к.мелкий), подпись) + 52;
            верно над = внутри(с.мышь_х, с.мышь_у, вх, у, ш, 28);
            целое фон = Ц_ПАНЕЛЬ2;
            если (над)
                фон = Ц_ЛИНИЯ;
            конец
            залить_скругл(к, фон, вх, у, ш, 28, 6);
            рамка(к, Ц_ЛИНИЯ, вх, у, ш, 28);
            залить(к, Ц_ЖЁЛТЫЙ, вх + 11, у + 8, 8, 12);
            писать(к, пх(к.мелкий), подпись, вх + 26, у + 7, Ц_ТЕКСТ);
            писать(к, пх(к.шрифт), "×", вх + ш - 18, у + 3, Ц_ТИХИЙ);
            вх = вх + ш + 8;
            ин = ин + 1;
        конец
        если (с.к_файлы.размер() == 0)
            писать(к, пх(к.мелкий), "Вложений нет. Файл можно перетащить в окно.", 24, у + 7, 0x4d6190);
        конец
        у = у + 40;
    конец

    // тело письма
    целое верх_тела = у;
    целое низ_тела = 596;
    залить_скругл(к, Ц_ПАНЕЛЬ, 24, верх_тела, Ш_ОКНА - 48, низ_тела - верх_тела, 8);
    если (с.поле == 2)
        рамка(к, Ц_СИНИЙ, 24, верх_тела, Ш_ОКНА - 48, низ_тела - верх_тела);
    иначе
        рамка(к, Ц_ЛИНИЯ, 24, верх_тела, Ш_ОКНА - 48, низ_тела - верх_тела);
    конец
    Список из текстов строки = Список из текстов();
    перенос(к, пх(к.шрифт), с.к_тело, Ш_ОКНА - 48 - 32, строки);
    целое видно = (низ_тела - верх_тела - 20) / 20;
    целое первая = строки.размер() - видно;
    если (первая меньше 0)
        первая = 0;
    конец
    целое л = 0;
    пока (первая + л меньше строки.размер() и л меньше видно)
        писать(к, пх(к.шрифт), строки.получить(первая + л), 40, верх_тела + 10 + л * 20, Ц_ТЕКСТ);
        л = л + 1;
    конец
    если (с.поле == 2 и (с.кадр / 15) % 2 == 0)
        целое посл = строки.размер() - 1 - первая;
        если (посл меньше 0)
            посл = 0;
        конец
        текст последняя = "";
        если (строки.размер() больше 0)
            последняя = строки.получить(строки.размер() - 1);
        конец
        залить(к, Ц_ТЕКСТ, 42 + ширина_строки(к, пх(к.шрифт), последняя), верх_тела + 10 + посл * 20, 2, 18);
    конец

    кнопка(к, с, "Отправить  ⌘↵", 24, 610, 168, 38, 1, да);
    кнопка(к, с, "Отмена", 200, 610, 110, 38, 0, да);
    кнопка(к, с, "Прикрепить файл…", Ш_ОКНА - 24 - 190, 610, 190, 38, 0, да);
    вернуть 0;
конец

