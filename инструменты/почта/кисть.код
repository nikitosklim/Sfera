// Целый корень: наибольшее r, для которого r*r не больше n.
функция корень_целый(целое n): целое
    если (n меньше 1)
        вернуть 0;
    конец
    целое х = n;
    целое у = (х + 1) / 2;
    пока (у меньше х)
        х = у;
        у = (х + n / х) / 2;
    конец
    вернуть х;
конец

// Цвет между двумя цветами: доля «часть» из «всего».
функция смесь(целое с1, целое с2, целое часть, целое всего): целое
    если (всего меньше 1)
        вернуть с1;
    конец
    целое р = (с1 / 65536) % 256 + ((с2 / 65536) % 256 - (с1 / 65536) % 256) * часть / всего;
    целое з = (с1 / 256) % 256 + ((с2 / 256) % 256 - (с1 / 256) % 256) * часть / всего;
    целое б = с1 % 256 + (с2 % 256 - с1 % 256) * часть / всего;
    вернуть р * 65536 + з * 256 + б;
конец

// Вертикальный градиент в скруглённом прямоугольнике (кнопки, выделения). «а» — прозрачность 0..255.
функция градиент_скругл(Кисть к, целое верх, целое низ, целое а, целое х, целое у, целое ш, целое выс, целое р): целое
    целое ин = 0;
    пока (ин меньше выс)
        целое до_края = ин;
        если (выс - 1 - ин меньше до_края)
            до_края = выс - 1 - ин;
        конец
        целое отступ = 0;
        если (до_края меньше р)
            целое дв = р - до_края - 1;
            отступ = р - корень_целый(р * р - дв * дв);
        конец
        залить_альфа(к, смесь(верх, низ, ин, выс - 1), а, х + отступ, у + ин, ш - 2 * отступ, 1);
        ин = ин + 1;
    конец
    вернуть 0;
конец

// Мягкое свечение: эллипс из пяти вложенных слоёв прозрачности («туманность»).
функция свечение(Кисть к, целое с, целое а, целое цх, целое цу, целое рх, целое ру): целое
    целое слой = 1;
    пока (слой не больше 5)
        целое ах = рх * слой / 5;
        целое ау = ру * слой / 5;
        если (ау больше 1)
            целое дв = 0 - ау;
            пока (дв меньше ау)
                целое полу = корень_целый(ах * ах * (ау * ау - дв * дв) / (ау * ау));
                залить_альфа(к, с, а, цх - полу, цу + дв, 2 * полу, 3);
                дв = дв + 3;
            конец
        конец
        слой = слой + 1;
    конец
    вернуть 0;
конец

// Шар с бликом: знак «Сферы».
функция шар(Кисть к, целое цх, целое цу, целое р, целое светлый, целое тёмный): целое
    свечение(к, светлый, 7, цх, цу, р * 2, р * 2);
    целое дв = 0 - р;
    пока (дв меньше р)
        целое полу = корень_целый(р * р - дв * дв);
        залить(к, смесь(светлый, тёмный, дв + р, 2 * р), цх - полу, цу + дв, 2 * полу, 1);
        дв = дв + 1;
    конец
    свечение(к, 0xffffff, 16, цх - р / 3, цу - р / 3, р / 2, р / 2);
    вернуть 0;
конец

// Космический фон окна: глубокий градиент, туманности и звёзды (звёзды всегда в одних и тех же местах).
функция космос(Кисть к, целое ш, целое вых): целое
    целое середина = вых * 6 / 10;
    градиент(к, 0x050816, 0x0b0f2b, 0, 0, ш, середина);
    градиент(к, 0x0b0f2b, 0x180c36, 0, середина, ш, вых - середина);
    свечение(к, 0x3b5bdb, 9, ш * 80 / 100, вых * 18 / 100, 560, 240);
    свечение(к, 0x7c3aed, 8, ш * 12 / 100, вых * 88 / 100, 520, 210);
    свечение(к, 0x2dd4bf, 4, ш * 45 / 100, вых * 52 / 100, 420, 150);
    целое сем = 12345;
    целое ин = 0;
    пока (ин меньше 170)
        сем = (сем * 1103515245 + 12345) % 2147483648;
        целое х = (сем / 65536) % ш;
        сем = (сем * 1103515245 + 12345) % 2147483648;
        целое у = (сем / 65536) % вых;
        сем = (сем * 1103515245 + 12345) % 2147483648;
        целое яркость = 70 + (сем / 65536) % 186;
        целое размер = 1;
        если (ин % 17 == 0)
            размер = 2;
        конец
        целое тон = 0xffffff;
        если (ин % 5 == 0)
            тон = 0xaec2ff;
        иначе если (ин % 7 == 0)
            тон = 0xffe6b8;
        конец
        залить_альфа(к, тон, яркость, х, у, размер, размер);
        ин = ин + 1;
    конец
    вернуть 0;
конец

функция ширина_строки(Кисть к, текст шрифт, текст строка): целое
    если (длина(строка) == 0)
        вернуть 0;
    конец
    размер_текста_ттф(шрифт, строка, пх(к.бш), пх(к.бв));
    вернуть целое(прочитать_целое32(пх(к.бш), 0)) / к.масштаб;
конец

функция писать(Кисть к, текст шрифт, текст строка, целое х, целое у, целое с): целое
    если (длина(строка) == 0)
        вернуть 0;
    конец
    беззнак32 ц = беззнак32(4278190080 + (с / 65536) + ((с / 256) % 256) * 256 + (с % 256) * 65536);
    текст пов = отрисовать_текст(шрифт, строка, ц);
    если (адрес_текста(пов) == 0)
        вернуть 0;
    конец
    текст тек = создать_текстуру(пх(к.холст), пов);
    узнать_размер_текстуры(тек, нулевой_указатель(), нулевой_указатель(), пх(к.бш), пх(к.бв));
    записать_целое32(пх(к.бо), 0, целое32(х));
    записать_целое32(пх(к.бо), 4, целое32(у));
    записать_целое32(пх(к.бо), 8, целое32(целое(прочитать_целое32(пх(к.бш), 0)) / к.масштаб));
    записать_целое32(пх(к.бо), 12, целое32(целое(прочитать_целое32(пх(к.бв), 0)) / к.масштаб));
    показать_текстуру(пх(к.холст), тек, нулевой_указатель(), пх(к.бо));
    освободить_поверхность(пов);
    уничтожить_текстуру(тек);
    вернуть 0;
конец

