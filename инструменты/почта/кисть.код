// ---------- текст ----------
// Безопасный срез в байтах: за границы не выходит, всегда возвращает копию.
функция срез(текст с, целое от, целое сколько): текст
    целое о = от;
    если (о меньше 0)
        о = 0;
    конец
    если (о больше длина(с))
        о = длина(с);
    конец
    целое н = сколько;
    если (о + н больше длина(с))
        н = длина(с) - о;
    конец
    если (н меньше 1)
        вернуть "";
    конец
    результат из текста р = подстрока(с, о, н);
    если (р.успешно)
        вернуть р.значение;
    конец
    вернуть "";
конец

функция начало_знака(целое б): верно
    вернуть б меньше 128 или б не меньше 192;
конец

// Сколько знаков (не байт) в тексте.
функция знаков(текст с): целое
    целое п = 0;
    целое н = 0;
    пока (п меньше длина(с))
        если (начало_знака(целое(байт_текста(с, п))))
            н = н + 1;
        конец
        п = п + 1;
    конец
    вернуть н;
конец

// Обрезает по числу знаков и добавляет «…».
функция кратко(текст с, целое макс): текст
    целое п = 0;
    целое симв = 0;
    пока (п меньше длина(с))
        если (начало_знака(целое(байт_текста(с, п))))
            если (симв == макс)
                вернуть срез(с, 0, п) + "…";
            конец
            симв = симв + 1;
        конец
        п = п + 1;
    конец
    вернуть срез(с, 0, длина(с));
конец

// Обрезает по ширине в точках: добавляет «…», если не помещается.
функция по_ширине(Кисть к, текст шрифт, текст с, целое макс): текст
    если (ширина_строки(к, шрифт, с) не больше макс)
        вернуть срез(с, 0, длина(с));
    конец
    целое п = длина(с);
    пока (п больше 0)
        п = п - 1;
        пока (п больше 0 и не начало_знака(целое(байт_текста(с, п))))
            п = п - 1;
        конец
        текст кусок = срез(с, 0, п) + "…";
        если (ширина_строки(к, шрифт, кусок) не больше макс)
            вернуть кусок;
        конец
    конец
    вернуть "…";
конец

функция пробельный_знак(целое б): верно
    вернуть б == 32 или б == 9 или б == 10 или б == 13;
конец

функция без_краёв(текст с): текст
    целое от = 0;
    целое до = длина(с);
    пока (от меньше до и пробельный_знак(целое(байт_текста(с, от))))
        от = от + 1;
    конец
    пока (до больше от и пробельный_знак(целое(байт_текста(с, до - 1))))
        до = до - 1;
    конец
    вернуть срез(с, от, до - от);
конец

// Перенос по словам в ширину «макс» точек. Переводы строк внутри текста сохраняются.
функция перенос(Кисть к, текст шрифт, текст т, целое макс, Список из текстов итог): целое
    целое п = 0;
    целое н = длина(т);
    текст строка = "";
    целое слово_с = 0;
    пока (п не больше н)
        целое б = 0;
        если (п меньше н)
            б = целое(байт_текста(т, п));
        конец
        если (п == н или б == 32 или б == 10)
            текст слово = срез(т, слово_с, п - слово_с);
            если (длина(слово) больше 0 и целое(байт_текста(слово, длина(слово) - 1)) == 13)
                слово = срез(слово, 0, длина(слово) - 1);
            конец
            слово_с = п + 1;
            если (длина(слово) больше 0)
                текст проба = слово;
                если (длина(строка) больше 0)
                    проба = строка + " " + слово;
                конец
                если (ширина_строки(к, шрифт, проба) больше макс и длина(строка) больше 0)
                    итог.добавить(строка);
                    строка = слово;
                иначе
                    строка = проба;
                конец
                // слишком длинное слово режем по знакам
                пока (ширина_строки(к, шрифт, строка) больше макс и знаков(строка) больше 1)
                    текст откуда = строка;
                    целое ц = длина(откуда);
                    ц = ц - 1;
                    пока (ц больше 1 и не начало_знака(целое(байт_текста(откуда, ц))))
                        ц = ц - 1;
                    конец
                    целое грань = ц;
                    пока (грань больше 1 и ширина_строки(к, шрифт, срез(откуда, 0, грань)) больше макс)
                        грань = грань - 1;
                        пока (грань больше 1 и не начало_знака(целое(байт_текста(откуда, грань))))
                            грань = грань - 1;
                        конец
                    конец
                    итог.добавить(срез(откуда, 0, грань));
                    строка = срез(откуда, грань, длина(откуда) - грань);
                конец
            конец
            если (п == н или б == 10)
                итог.добавить(строка);
                строка = "";
            конец
        конец
        п = п + 1;
    конец
    вернуть итог.размер();
конец

функция десятичное(целое десятых): текст
    вернуть целое_в_текст(десятых / 10) + "," + целое_в_текст(десятых % 10);
конец

функция размер_в_текст(целое б): текст
    если (б меньше 1024)
        вернуть целое_в_текст(б) + " Б";
    конец
    если (б меньше 1048576)
        вернуть десятичное(б * 10 / 1024) + " КБ";
    конец
    если (б меньше 1073741824)
        вернуть десятичное(б * 10 / 1048576) + " МБ";
    конец
    вернуть десятичное(б * 10 / 1073741824) + " ГБ";
конец

функция в_нижнем(текст с): текст
    вернуть регистр_в_нижний(с);
конец

// Одинарные кавычки внутри значения для sh: ' -> '\''
функция для_оболочки(текст с): текст
    текст итог = "";
    целое п = 0;
    пока (п меньше длина(с))
        текст один = срез(с, п, 1);
        если (один == "'")
            итог = итог + "'\\''";
        иначе
            итог = итог + один;
        конец
        п = п + 1;
    конец
    вернуть итог;
конец

