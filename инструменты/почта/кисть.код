    вернуть 0;
конец

// Вертикальный градиент между двумя цветами (по одной полосе на строку пикселей).
функция градиент(Кисть к, целое верх, целое низ, целое х, целое у, целое ш, целое выс): целое
    целое ин = 0;
    пока (ин меньше выс)
        целое р1 = (верх / 65536) % 256;
        целое з1 = (верх / 256) % 256;
        целое с1 = верх % 256;
        целое р2 = (низ / 65536) % 256;
        целое з2 = (низ / 256) % 256;
        целое с2 = низ % 256;
        целое р = р1 + (р2 - р1) * ин / выс;
        целое з = з1 + (з2 - з1) * ин / выс;
        целое с = с1 + (с2 - с1) * ин / выс;
        залить(к, р * 65536 + з * 256 + с, х, у + ин, ш, 1);
        ин = ин + 1;
    конец
    вернуть 0;
конец

