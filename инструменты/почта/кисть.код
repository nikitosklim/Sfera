// Создаёт окно нужного размера и кисть к нему; ширина и высота — в «логических» точках.
функция создать_кисть(текст заголовок, целое ширина, целое высота): Кисть
    инициализировать(32);
    инициализировать_шрифты();
    подсказка_сдл("SDL_RENDER_SCALE_QUALITY", "linear");
    // 8192 = SDL_WINDOW_ALLOW_HIGHDPI: без него macOS растягивает картинку, и всё выглядит размытым.
    текст окно = создать_окно(заголовок, 805240832, 805240832, ширина, высота, 8192);
    текст холст = создать_холст(окно, 0 - 1, 0);
    задать_режим_смешивания(холст, 1);
    текст замер = выделить_память(8);
    размер_вывода_сырое(холст, замер, выделить_память(8));
    целое масштаб = целое(прочитать_целое32(замер, 0)) / ширина;
    если (масштаб меньше 1)
        масштаб = 1;
    конец
    если (масштаб больше 1)
        логический_размер(холст, целое32(ширина), целое32(высота));
    конец
    текст ш = путь_шрифта();
    Кисть к = Кисть(указатель_в_число(холст), указатель_в_число(открыть_шрифт(ш, 15 * масштаб)), указатель_в_число(открыть_шрифт(ш, 12 * масштаб)), указатель_в_число(открыть_шрифт(ш, 20 * масштаб)), указатель_в_число(выделить_память(8)), указатель_в_число(выделить_память(8)), указатель_в_число(выделить_память(16)), масштаб, указатель_в_число(окно));
    вернуть к;
конец

