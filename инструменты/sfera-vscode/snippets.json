{
  "Главная": {
    "prefix": "главная",
    "body": [
      "функция главная(): целое",
      "\t$0",
      "\tвернуть 0;",
      "конец"
    ],
    "description": "Точка входа"
  },
  "Функция": {
    "prefix": "функция",
    "body": [
      "функция ${1:имя}(${2}): ${3:целое}",
      "\t$0",
      "конец"
    ]
  },
  "Если": {
    "prefix": "если",
    "body": [
      "если (${1:условие})",
      "\t$0",
      "конец"
    ]
  },
  "Если иначе": {
    "prefix": "еслииначе",
    "body": [
      "если (${1:условие})",
      "\t$2",
      "иначе",
      "\t$0",
      "конец"
    ]
  },
  "Пока": {
    "prefix": "пока",
    "body": [
      "пока (${1:условие})",
      "\t$0",
      "конец"
    ]
  },
  "Для каждого": {
    "prefix": "длякаждого",
    "body": [
      "для каждого ${1:элемент} из ${2:список}",
      "\t$0",
      "конец"
    ]
  },
  "Структура": {
    "prefix": "структура",
    "body": [
      "структура ${1:Имя}",
      "\t${2:целое} ${3:поле};",
      "конец"
    ]
  },
  "Вывести": {
    "prefix": "вывести",
    "body": [
      "вывести(\"${1}\");"
    ]
  },
  "Параллельно": {
    "prefix": "параллельно",
    "body": [
      "параллельно",
      "\t$0",
      "конец"
    ]
  }
