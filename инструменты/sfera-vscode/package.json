{
  "name": "sfera-lang",
  "displayName": "Сфера",
  "description": "Язык программирования «Сфера»: подсветка синтаксиса, ошибки в реальном времени, подсказки и автодополнение.",
  "version": "0.3.5",
  "publisher": "sfera-lang",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/nikitosklim/Sfera.git"
  },
  "homepage": "https://языксфера.рф",
  "bugs": {
    "url": "https://github.com/nikitosklim/Sfera/issues"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "сфера",
    "sfera",
    "русский язык программирования",
    "компилятор"
  ],
  "activationEvents": [],
  "main": "./src/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "sfera",
        "aliases": [
          "Сфера",
          "Sfera"
        ],
        "extensions": [
          ".код"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sfera",
        "scopeName": "source.sfera",
        "path": "./syntaxes/sfera.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "sfera",
        "path": "./snippets.json"
      }
    ],
    "configuration": {
      "title": "Сфера",
      "properties": {
        "sfera.serverPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Путь к языковому серверу `сфера_lsp`. Если пусто, используется `сфера_lsp` из PATH. Сервер лежит в архиве с компилятором."
        },
        "sfera.enableLanguageServer": {
          "type": "boolean",
          "default": true,
          "description": "Включить языковой сервер (ошибки, подсказки, автодополнение)."
        }
      }
    },
    "configurationDefaults": {
      "[sfera]": {
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": false
        },
        "editor.suggest.showWords": false,
        "editor.wordBasedSuggestions": "off"
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "scripts": {
    "package": "vsce package"
  }
}