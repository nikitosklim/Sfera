подключить графика;

// НОВОЕ (найдено реальной проверкой — "прочитать_файл" вернула 0 байт
// для /proc/self/maps): /proc — виртуальная файловая система ядра, файлы
// в ней генерируются "на лету" при чтении, у них нет настоящего размера
// — fseek(SEEK_END)/ftell(), на которых, судя по всему, основана
// "прочитать_файл", возвращают 0 для таких файлов. Прямые open/read/close
// (без попытки узнать размер заранее) читают такие файлы правильно.
внешняя функция открыть_сырой(текст путь, целое32 флаги) -> целое32 как "open";
внешняя функция прочитать_сырой(целое32 fd, текст буфер, целое размер) -> целое как "read";
внешняя функция закрыть_сырой(целое32 fd) -> целое32 как "close";

// НОВОЕ: найдено реальной проверкой — "выполнить_команду" (system(),
// через промежуточный /system/bin/sh -c "...") вернула код 127
// ("command not found"), хотя путь к файлу был построен правильно.
// SELinux, судя по всему, разрешает исполнение файлов из nativeLibraryDir
// НАПРЯМУЮ приложением, но не обязательно тому же самому файлу, запущенному
// ЧЕРЕЗ шелл — та же тонкость, из-за которой Termux использует прямой
// fork()+exec(), а не system(). execl() (не execve()) выбран специально
// — принимает аргументы как обычный, фиксированный список C-функции, не
// требует вручную строить char*[] массив в сырой памяти.
// НОВОЕ: НАЙДЕНО РЕАЛЬНОЙ ПРОВЕРКОЙ — fork() внутри обычного, уже
// запущенного, многопоточного Android-приложения фундаментально не
// поддерживается (полный backtrace краха указал на libbinder.so —
// внутреннее IPC-состояние ART/Binder не переживает fork(), это ломает
// его для всего процесса, не только для нашей попытки). Только
// специальный процесс Zygote может безопасно делать fork() для создания
// новых приложений — обычное, уже живущее приложение не может.
// vfork() не дублирует адресное пространство (дочерний временно
// использует ту же память, что и родитель, до самого execve()/_exit()) —
// меньше шансов сломать общее, многопоточное состояние процесса.
внешняя функция fork_сырой() -> целое32 как "vfork";
внешняя функция execl_сырой(текст путь, текст arg0, текст null_конец) -> целое32 как "execl";
внешняя функция waitpid_сырой(целое32 pid, текст статус, целое32 флаги) -> целое32 как "waitpid";
// Прямой, "сырой" выход из процесса — единственное, что безопасно
// вызывать в дочернем процессе после vfork(), если execl() провалился
// (между vfork() и execve()/_exit() память временно общая с родителем).
внешняя функция exit_group_сырой(целое32 код) как "_exit";
// НОВОЕ: точная причина провала execl() (ENOENT/EACCES/ENOEXEC и т.д.) —
// на bionic errno это TLS-переменная, доступная через __errno() (просто
// чтение указателя, без malloc/syscalls — безопасно между vfork() и
// выходом из дочернего процесса).
внешняя функция получить_адрес_errno() -> текст как "__errno";

функция прочитать_proc_файл(текст путь) -> результат<текст> {
    целое32 fd = открыть_сырой(путь, целое32(0));
    если (fd < целое32(0)) {
        вернуть ошибка("не удалось открыть файл (open вернул отрицательный fd)");
    }

    // НОВОЕ: НАЙДЕНО РЕАЛЬНОЙ ПРОВЕРКОЙ — один read() для /proc-файла
    // может вернуть МЕНЬШЕ данных, чем есть в файле на самом деле (ядро
    // ограничивает размер одного возврата для виртуальных файлов), даже
    // когда файл ещё не закончился. Читаем в цикле, пока read() не
    // вернёт 0 (настоящий конец файла), а не после первого же вызова.
    // НОВОЕ: НАЙДЕНО РЕАЛЬНОЙ ПРОВЕРКОЙ — 64КБ буфера не хватило на
    // настоящем устройстве (там оказалось заметно больше данных, чем
    // предполагалось: ART runtime и десятки системных библиотек дают
    // куда более длинную карту памяти, чем у простого тестового
    // приложения) — "длина карты памяти: 65535" была ровно верхней
    // границей буфера, а не настоящим концом файла: мы обрывали чтение,
    // не дойдя до записи libmain.so. Даём заметно больше места с запасом.
    целое размер_буфера = 4194304;
    текст буфер = выделить_память(размер_буфера);
    целое всего_прочитано = 0;

    пока (всего_прочитано < размер_буфера - 1) {
        текст текущая_позиция = прочитать_текст_по_смещению(буфер, всего_прочитано);
        целое осталось_места = размер_буфера - 1 - всего_прочитано;
        целое прочитано_за_раз = прочитать_сырой(fd, текущая_позиция, осталось_места);
        если (прочитано_за_раз <= 0) {
            // 0 — настоящий конец файла, отрицательное — ошибка чтения;
            // в обоих случаях больше читать нечего.
            закрыть_сырой(fd);
            если (всего_прочитано == 0) {
                освободить_память(буфер);
                вернуть ошибка("read вернул 0 байт с самого начала");
            }
            текст конец_данных = прочитать_текст_по_смещению(буфер, всего_прочитано);
            скопировать_память(конец_данных, "", 1);
            вернуть успех(буфер);
        }
        всего_прочитано = всего_прочитано + прочитано_за_раз;
    }

    закрыть_сырой(fd);
    текст конец_данных2 = прочитать_текст_по_смещению(буфер, всего_прочитано);
    скопировать_память(конец_данных2, "", 1);
    вернуть успех(буфер);
}

функция главная() -> целое {
    инициализировать(беззнак32(32));
    инициализировать_шрифты();
    текст окно = создать_окно("Тест запуска", целое32(0), целое32(0), целое32(400), целое32(400), беззнак32(0));

    android_лог(целое32(4), "SferaExecTest", "начинаю поиск пути к своей библиотеке");

    результат<текст> карта = прочитать_proc_файл("/proc/self/maps");
    если (!карта.успешно) {
        android_лог(целое32(6), "SferaExecTest", "не удалось прочитать /proc/self/maps: " + карта.сообщение);
        вернуть 1;
    }
    android_лог(целое32(4), "SferaExecTest", "длина карты памяти: " + целое_в_текст(длина(карта.значение)));

    // Строка вида "... /data/app/~~xxx/ru.sfera.test-yyy/lib/arm64/libmain.so"
    // где-то внутри полной карты памяти — сначала находим позицию самого
    // "libmain.so", затем берём разумный кусок ПЕРЕД ней (типичный путь
    // заметно короче 300 байт) и ищем "/data" уже в этом небольшом куске
    // — не во всей карте, где "/data" встречается много раз для разных
    // библиотек.
    результат<целое> позиция_libmain = найти(карта.значение, "libmain.so");
    если (!позиция_libmain.успешно) {
        android_лог(целое32(6), "SferaExecTest", "libmain.so не найден в карте памяти вообще");
        вернуть 1;
    }
    // НОВОЕ: НАЙДЕНО РЕАЛЬНОЙ ПРОВЕРКОЙ — окно фиксированного размера (300
    // байт) перед "libmain.so" на реальном устройстве захватывало СРАЗУ
    // НЕСКОЛЬКО строк карты памяти (разные библиотеки идут в maps плотно
    // друг за другом), и поиск ПЕРВОГО "/data" в этом окне находил путь к
    // СОСЕДНЕЙ библиотеке (например libSDL2_ttf.so), а не к той, что
    // реально содержит libmain.so — execl() пытался запустить не тот
    // файл. Правильный способ — найти начало ИМЕННО ТОЙ строки, что
    // содержит "libmain.so": идём назад по байтам от найденной позиции,
    // пока не встретим перенос строки (или начало всей карты).
    целое позиция_поиска_назад = позиция_libmain.значение;
    целое начало_строки = 0;
    целое32 символ_переноса = целое32(10);
    верно нашли_перенос = нет;
    пока (позиция_поиска_назад > 0 && !нашли_перенос) {
        позиция_поиска_назад = позиция_поиска_назад - 1;
        целое32 текущий_байт = байт_текста(карта.значение, позиция_поиска_назад);
        если (текущий_байт == символ_переноса) {
            начало_строки = позиция_поиска_назад + 1;
            нашли_перенос = да;
        }
    }

    целое длина_окна = позиция_libmain.значение - начало_строки;
    результат<текст> окно_поиска = подстрока(карта.значение, начало_строки, длина_окна);
    если (!окно_поиска.успешно) {
        вернуть 1;
    }
    android_лог(целое32(4), "SferaExecTest", "строка с libmain.so: " + окно_поиска.значение);

    результат<целое> позиция_data = найти(окно_поиска.значение, "/data");
    если (!позиция_data.успешно) {
        android_лог(целое32(6), "SferaExecTest", "/data не найден в строке с libmain.so");
        вернуть 1;
    }
    результат<текст> папка_библиотек = подстрока(окно_поиска.значение, позиция_data.значение, длина(окно_поиска.значение) - позиция_data.значение);
    если (!папка_библиотек.успешно) {
        вернуть 1;
    }

    // НОВОЕ: НАЙДЕНО РЕАЛЬНОЙ ПРОВЕРКОЙ (errno=2, ENOENT) — имя файла с
    // кириллицей внутри ZIP-архива APK оказалось искажено (mojibake) при
    // добавлении через обычную команду "zip" без явного UTF-8 режима —
    // тот же класс проблемы, что уже встречалась с apksigner/zipalign и
    // именами файлов вне архива. Внутри самого APK-архива, пока это не
    // исправлено на уровне сборки, используем латинское имя файла — это
    // имя внутри архива, не часть исходного кода на языке.
    текст путь_к_тесту = папка_библиотек.значение + "libtestbin2.so";
    android_лог(целое32(4), "SferaExecTest", "пробую запустить напрямую (fork+execl): " + путь_к_тесту);

    // НОВОЕ: между vfork() и execve()/_exit() в дочернем процессе почти
    // ничего нельзя безопасно вызывать (память временно общая с
    // родителем) — android_лог()/malloc()/обычный "вернуть" здесь были
    // бы небезопасны. Прямой _exit_group syscall — единственное, что
    // точно безопасно, если execl() провалился.

    целое32 pid = fork_сырой();
    если (pid == целое32(0)) {
        // Дочерний процесс — становится нашим тестовым бинарником, если
        // execl() сработал (тогда управление сюда вообще не вернётся).
        // Если НЕ сработал — errno содержит точную причину (ENOENT=2
        // файл не найден, EACCES=13 нет прав, ENOEXEC=8 неверный формат
        // файла) — передаём его как код выхода вместо фиксированного
        // числа, чтобы родитель мог его увидеть через waitpid.
        execl_сырой(путь_к_тесту, путь_к_тесту, нулевой_указатель());
        текст адрес_errno = получить_адрес_errno();
        целое32 значение_errno = прочитать_целое32(адрес_errno, 0);
        exit_group_сырой(значение_errno);
        вернуть 1;
    } иначе если (pid > целое32(0)) {
        // Родительский процесс — ждём завершения дочернего, читаем код
        // выхода из статус-буфера (на Linux/Android exit-код лежит в
        // байтах 1 сверху 32-битного статуса — сдвиг вправо на 8 бит,
        // младший байт).
        текст статус_буфер = выделить_память(4);
        целое32 итог_ожидания = waitpid_сырой(pid, статус_буфер, целое32(0));
        целое32 сырой_статус = прочитать_целое32(статус_буфер, 0);
        целое32 код_выхода = сырой_статус / целое32(256);
        android_лог(целое32(4), "SferaExecTest", "waitpid pid=" + целое_в_текст(целое(итог_ожидания)) + " код_выхода(errno если не 0)=" + целое_в_текст(целое(код_выхода)));
        освободить_память(статус_буфер);
    } иначе {
        android_лог(целое32(6), "SferaExecTest", "vfork() провалился");
    }

    android_лог(целое32(4), "SferaExecTest", "тест завершён");
    закрыть_окно(окно);
    завершить();
    вернуть 0;
}
