функция отступ_строки(текст код, целое курсор): текст
    целое нач = начало_строки(код, курсор);
    целое к = нач;
    пока (к меньше длина(код) и байт(код, к) == 32)
        к = к + 1;
    конец
    вернуть вырезать(код, нач, к);
конец

функция открывающая_строка(текст код, целое курсор): верно
    целое нач = начало_строки(код, курсор);
    текст ст = обрезать_пробелы(вырезать(код, нач, курсор));
    вернуть начинается_с(ст, "функция ") или начинается_с(ст, "если ") или начинается_с(ст, "если(") или начинается_с(ст, "пока") или начинается_с(ст, "структура ") или начинается_с(ст, "иначе") или начинается_с(ст, "для ") или начинается_с(ст, "контракт ");
конец

функция перевод_строки(Ср с): целое
    текст отступ = отступ_строки(с.код, с.курсор);
    если (открывающая_строка(с.код, с.курсор))
        отступ = отступ + "    ";
    конец
    вставить_в_курсор(с, "\n" + отступ);
    вернуть 0;
конец

функция строка_курсора(Ср с): целое
