функция кодировать_адрес(текст строка): текст
    текст цифры = "0123456789ABCDEF";
    текст процент = знак_процента();
    текст итог = "";
    целое i = 0;
    пока (i меньше длина(строка))
        целое32 б = байт_текста(строка, i);
        целое з = целое(б);
        верно простой = (з >= 48 и з <= 57) или (з >= 65 и з <= 90) или (з >= 97 и з <= 122) или з == 45 или з == 95 или з == 46;
        результат из текст символ = подстрока(строка, i, 1);
        если (простой и символ.успешно)
            итог = итог + символ.значение;
        иначе
            результат из текст старшая = подстрока(цифры, з / 16, 1);
            результат из текст младшая = подстрока(цифры, з % 16, 1);
            если (старшая.успешно и младшая.успешно)
                итог = итог + процент + старшая.значение + младшая.значение;
            конец
        конец
        i = i + 1;
    конец
    вернуть итог;
конец

функция строки_текста(текст исходный, Список из текст строки): целое
    текст остаток = исходный;
    пока (длина(остаток) больше 0)
        результат из целое позиция = найти(остаток, "\n");
        если ( не позиция.успешно)
            строки.добавить(остаток);
            остаток = "";
        иначе
            результат из текст часть = подстрока(остаток, 0, позиция.значение);
            если (часть.успешно)
                строки.добавить(часть.значение);
            конец
            результат из текст хвост = подстрока(остаток, позиция.значение + 1, длина(остаток) - позиция.значение - 1);
            если (хвост.успешно)
                остаток = хвост.значение;
            иначе
                остаток = "";
            конец
        конец
    конец
    вернуть строки.размер();
конец

функция обрезать_края(текст исходный): текст
    целое начало = 0;
    целое позиция_конца = длина(исходный);
    верно идти = да;
    пока (идти и начало меньше позиция_конца)
        целое32 б = байт_текста(исходный, начало);
        если (б == целое32(32) или б == целое32(13) или б == целое32(10) или б == целое32(9) или б == целое32(239) или б == целое32(187) или б == целое32(191))
            начало = начало + 1;
        иначе
            идти = нет;
        конец
    конец
    идти = да;
    пока (идти и позиция_конца больше начало)
        целое32 б = байт_текста(исходный, позиция_конца - 1);
        если (б == целое32(32) или б == целое32(13) или б == целое32(10) или б == целое32(9))
            позиция_конца = позиция_конца - 1;
        иначе
            идти = нет;
        конец
    конец
    результат из текст часть = подстрока(исходный, начало, позиция_конца - начало);
    если (часть.успешно)
        вернуть часть.значение;
    конец
    вернуть "";
конец

функция разбить_по_полям(текст строка, Список из текст части): целое
    текст остаток = строка;
    пока (длина(остаток) больше 0)
        результат из целое позиция = найти(остаток, " | ");
        если ( не позиция.успешно)
            части.добавить(остаток);
            остаток = "";
        иначе
            результат из текст часть = подстрока(остаток, 0, позиция.значение);
            если (часть.успешно)
                части.добавить(часть.значение);
            конец
            результат из текст хвост = подстрока(остаток, позиция.значение + 3, длина(остаток) - позиция.значение - 3);
            если (хвост.успешно)
                остаток = хвост.значение;
            иначе
                остаток = "";
            конец
        конец
    конец
    вернуть части.размер();
конец

функция есть_в_списке(Список из текст список, текст искомое): верно
    целое i = 0;
    пока (i меньше список.размер())
        если (список.получить(i) == искомое)
            вернуть да;
        конец
        i = i + 1;
    конец
    вернуть нет;
конец

функция разобрать_реестр(текст файл, Список из текст имена, Список из текст версии, Список из текст авторы, Список из текст описания): целое
    Список из текст строки = Список из текст();
    строки_текста(файл, строки);
    целое k = строки.размер() - 1;
    пока (k не меньше 0)
        текст строка = обрезать_края(строки.получить(k));
        если (длина(строка) больше 0 и не начинается_с(строка, "#"))
            Список из текст части = Список из текст();
            разбить_по_полям(строка, части);
            если (части.размер() не меньше 8)
                целое последняя = части.размер() - 1;
                если (части.получить(последняя) != "1" и не есть_в_списке(имена, части.получить(0)))
                    текст описание = "";
                    целое j = 6;
                    пока (j меньше последняя)
                        если (j > 6)
                            описание = описание + " | ";
                        конец
                        описание = описание + части.получить(j);
                        j = j + 1;
                    конец
                    имена.добавить(части.получить(0));
                    версии.добавить(части.получить(1));
                    авторы.добавить(части.получить(5));
                    описания.добавить(описание);
                конец
            конец
        конец
        k = k - 1;
    конец
    вернуть имена.размер();
конец

функция извлечь_json_строковое_поле(текст json, текст имя_поля): результат из текст
    текст искомое = "\"" + имя_поля + "\":\"";
    результат из целое позиция_ключа = найти(json, искомое);
    если ( не позиция_ключа.успешно)
        вернуть ошибка("поле '" + имя_поля + "' не найдено в ответе");
    конец
    целое начало_значения = позиция_ключа.значение + длина(искомое);

    целое индекс = начало_значения;
    целое конец_значения = 0 - 1;
    пока (индекс меньше длина(json) и конец_значения == 0 - 1)
        целое32 байт = байт_текста(json, индекс);
        если (байт == целое32(34))
            если (индекс == начало_значения)
                конец_значения = индекс;
            иначе
                целое32 предыдущий_байт = байт_текста(json, индекс - 1);
                если (предыдущий_байт != целое32(92))
                    конец_значения = индекс;
                конец
            конец
        конец
        индекс = индекс + 1;
    конец

    если (конец_значения == 0 - 1)
        вернуть ошибка("не удалось найти конец значения поля '" + имя_поля + "'");
    конец

    вернуть подстрока(json, начало_значения, конец_значения - начало_значения);
конец

функция json_поле(текст json, текст имя): текст
    результат из текст р = извлечь_json_строковое_поле(json, имя);
