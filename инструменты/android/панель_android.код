функция определить_библиотеки(): текст
    текст д = "$";
    текст б = "p=" + д + д + "\n";
    б = б + "LIB=''\n";
    б = б + "while [ \"" + д + "p\" -gt 1 ] 2>/dev/null; do\n";
    б = б + "  LIB=" + д + "(grep -o '/data/app/[^ ]*/lib/arm64/libmain.so' /proc/" + д + "p/maps 2>/dev/null | head -1 | sed 's#/libmain.so" + д + "##')\n";
    б = б + "  if [ -n \"" + д + "LIB\" ]; then break; fi\n";
    б = б + "  p=" + д + "(cut -d' ' -f4 /proc/" + д + "p/stat 2>/dev/null)\n";
    б = б + "done\n";
    вернуть б;
конец

функция сценарий_подготовки(Ср с): текст
    текст д = "$";
    текст б = определить_библиотеки();
    б = б + "R=" + с.корень + "\n";
    б = б + "echo \"" + д + "LIB\" > " + д + "R/lib.txt\n";
    б = б + "mkdir -p " + д + "R/programs " + д + "R/work\n";
    б = б + "if [ ! -f \"" + д + "R/docs/.версия_" + версия_приложения() + "\" ] && [ -f \"" + д + "LIB/libsfera_docs.so\" ]; then\n";
    б = б + "  rm -rf " + д + "R/docs " + д + "R/lessons " + д + "R/examples\n";
    б = б + "  tar -xf \"" + д + "LIB/libsfera_docs.so\" -C " + д + "R && touch \"" + д + "R/docs/.версия_" + версия_приложения() + "\"\n";
    б = б + "fi\n";
    вернуть б;
конец

функция сценарий_запуска(Ср с): текст
    текст д = "$";
    текст б = "echo " + д + д + " > " + с.корень + "/work/pid.txt\n";
    б = б + "LIB=" + д + "(cat " + с.корень + "/lib.txt)\n";
    б = б + "if [ ! -f \"" + д + "LIB/libsferac.so\" ]; then echo 'В этом APK нет компилятора'; exit 1; fi\n";
    б = б + "W=" + с.корень + "/work\n";
    б = б + "mkdir -p " + д + "W/bin " + д + "W/std\n";
    б = б + "cd " + д + "W || exit 1\n";
    б = б + "ln -sf \"" + д + "LIB/libsfera_clang.so\" bin/clang\n";
    б = б + "if [ ! -d std/стандартная_библиотека ]; then tar -xf \"" + д + "LIB/libsfera_stdlib.so\" -C std 2>/dev/null; fi\n";
    б = б + "export PATH=\"" + д + "W/bin:" + д + "PATH\"\n";
    б = б + "export SFERA_STDLIB=\"" + д + "W/std/стандартная_библиотека\"\n";
    б = б + "export TMPDIR=" + д + "W\n";
    б = б + "echo '--- сборка ---'\n";
    б = б + "\"" + д + "LIB/libsferac.so\" программа.код --только-собрать || { echo \"Сборка не удалась (код " + д + "?)\"; exit 1; }\n";
    б = б + "echo '--- запуск ---'\n";
    б = б + "./программа < /dev/null\n";
    б = б + "echo \"--- код выхода: " + д + "? ---\"\n";
    вернуть б;
конец

функция подготовить(Ср с): целое
    записать_файл(с.корень + "/подготовка.sh", сценарий_подготовки(с));
    команда("sh " + с.корень + "/подготовка.sh > " + с.корень + "/подготовка.txt 2>&1");
    вернуть 0;
конец

функция запустить_программу(Ср с): целое
    если (с.идёт)
        сказать(с, "Программа уже выполняется");
        вернуть 0;
    конец
    сохранить(с);
    текст р = с.корень + "/work";
    команда("mkdir -p " + р);
    записать_файл(р + "/программа.код", с.код);
    записать_файл(р + "/запуск.sh", сценарий_запуска(с));
    команда("rm -f " + р + "/готово.txt " + р + "/сырой.txt");
    команда("(sh " + р + "/запуск.sh > " + р + "/сырой.txt 2>&1 < /dev/null; echo x > " + р + "/готово.txt) > /dev/null 2>&1 &");
    с.идёт = да;
    с.старт_тик = сейчас();
    с.вывод = Список из текст();
    с.вывод.добавить("Сборка и запуск: " + с.имя + ".код");
    с.вывод_скр = 0;
    с.экран = 4;
    журнал("запуск " + с.имя);
    вернуть 0;
конец

функция опросить_вывод(Ср с): целое
    текст р = с.корень + "/work";
    результат из текст ч = прочитать_файл(р + "/сырой.txt");
    если (ч.успешно)
        Список из текст итог = Список из текст();
        итог.добавить("Сборка и запуск: " + с.имя + ".код");
        Список из текст сырые = разбить_строки(ч.значение);
        целое ин = 0;
        пока (ин меньше сырые.размер())
            перенести(сырые.получить(ин), (с.W - 60) / с.cw, итог);
            ин = ин + 1;
        конец
        с.вывод = итог;
        целое макс = итог.размер() * с.lh - (с.H - 130 - 140 - 130);
        если (макс больше 0)
            с.вывод_скр = макс;
        конец
    конец
