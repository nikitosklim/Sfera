конец

функция столбец_курсора(Ср с): целое
    вернуть символов_между(с.код, начало_строки(с.код, с.курсор), с.курсор);
конец

функция поставить_курсор(Ср с, целое строка, целое столбец): целое
    целое всего = число_строк(с.код);
    целое ст = строка;
    если (ст меньше 0)
        ст = 0;
    конец
    если (ст не меньше всего)
        ст = всего - 1;
    конец
    целое нач = смещение_строки(с.код, ст);
    целое кон = конец_строки(с.код, нач);
    с.курсор = сдвиг_на_символы(с.код, нач, столбец, кон);
    вернуть 0;
конец

функция низ_редактора(Ср с): целое
    если (с.клав)
        вернуть с.H * 55 / 100;
    конец
    вернуть с.H - 140;
конец

функция видимых_строк(Ср с): целое
    вернуть (низ_редактора(с) - 250 - 130) / с.lh;
конец

функция следить_за_курсором(Ср с): целое
    целое ст = строка_курсора(с);
    целое вид = видимых_строк(с);
    если (ст меньше с.скр_у)
        с.скр_у = ст;
    конец
    если (ст не меньше с.скр_у + вид)
        с.скр_у = ст - вид + 1;
    конец
    целое кол = столбец_курсора(с);
    целое колонок = (с.W - 100) / с.cw;
    если (кол меньше с.скр_х)
        с.скр_х = кол;
    конец
    если (кол не меньше с.скр_х + колонок - 1)
        с.скр_х = кол - колонок + 2;
    конец
    вернуть 0;
конец

функция ключевое(текст слово): верно
    результат из целое п = найти(" функция конец если иначе пока для каждого в вернуть структура контракт подключить внешняя как из и или не меньше больше результат ссылка это да нет прервать продолжить публично приватно канал параллельно успех ошибка ", " " + слово + " ");
