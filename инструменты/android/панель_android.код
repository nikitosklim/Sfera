// Многострочный текст постоянного цвета — тот же приём, что и в
// панели для macOS, скопирован сюда напрямую (не вынесен в общий
// графика.код), чтобы не менять уже отработанный API для той панели.
функция нарисовать_многострочный_текст(текст холст, текст шрифт, текст содержимое, целое32 х, целое32 начальный_у, беззнак32 цвет): целое
    текст остаток = содержимое;
    целое32 текущий_у = начальный_у;
    целое строк_нарисовано = 0;

    пока (строк_нарисовано меньше 30)
        результат из целого позиция_переноса = найти(остаток, "\n");
        если (позиция_переноса.успешно)
            результат из текста строка = подстрока(остаток, 0, позиция_переноса.значение);
            если (строка.успешно)
                нарисовать_текст(холст, шрифт, строка.значение, х, текущий_у, цвет);
            конец
            целое следующая_позиция = позиция_переноса.значение + 1;
            целое длина_остатка = длина(остаток) - следующая_позиция;
            результат из текста остаток_после = подстрока(остаток, следующая_позиция, длина_остатка);
            если (остаток_после.успешно)
                остаток = остаток_после.значение;
            иначе
                вернуть строк_нарисовано;
            конец
        иначе
            если (длина(остаток) больше 0)
                нарисовать_текст(холст, шрифт, остаток, х, текущий_у, цвет);
                строк_нарисовано = строк_нарисовано + 1;
            конец
            вернуть строк_нарисовано;
        конец
        текущий_у = текущий_у + целое32(55);
        строк_нарисовано = строк_нарисовано + 1;
    конец

    вернуть строк_нарисовано;
конец

// Программа, которую кнопка «Запуск» собирает и запускает прямо на телефоне.
функция программа_для_запуска(): текст
    вернуть "функция главная(): целое\n"
        + "    вывести(\"Привет из Сферы на Android!\");\n"
        + "    целое сумма = 0;\n"
        + "    целое число = 1;\n"
        + "    пока (число не больше 10)\n"
        + "        сумма = сумма + число;\n"
        + "        число = число + 1;\n"
        + "    конец\n"
        + "    вывести(\"Сумма чисел от 1 до 10: \" + целое_в_текст(сумма));\n"
        + "    вернуть 0;\n"
        + "конец\n";
конец

// Сценарий оболочки: находит каталог библиотек приложения, где лежат
// компилятор, линковщик и замена clang (в APK они упакованы как lib*.so),
// собирает программу и запускает её. Весь вывод идёт в журнал.
функция сценарий_запуска(): текст
    текст д = "$";
    текст б = "p=" + д + д + "\n";
    б = б + "LIB=''\n";
    б = б + "while [ \"" + д + "p\" -gt 1 ] 2>/dev/null; do\n";
    б = б + "  LIB=" + д + "(grep -o '/data/app/[^ ]*/lib/arm64/libmain.so' /proc/" + д + "p/maps 2>/dev/null | head -1 | sed 's#/libmain.so" + д + "##')\n";
    б = б + "  if [ -n \"" + д + "LIB\" ]; then break; fi\n";
    б = б + "  p=" + д + "(cut -d' ' -f4 /proc/" + д + "p/stat 2>/dev/null)\n";
    б = б + "done\n";
    б = б + "echo \"Каталог библиотек: " + д + "LIB\"\n";
    б = б + "if [ ! -f \"" + д + "LIB/libsferac.so\" ]; then echo 'В этом APK нет компилятора'; exit 1; fi\n";
    б = б + "W=/data/data/ru.sfera.panel/files/work\n";
    б = б + "mkdir -p " + д + "W/bin " + д + "W/std\n";
    б = б + "cd " + д + "W || exit 1\n";
    б = б + "ln -sf \"" + д + "LIB/libsfera_clang.so\" bin/clang\n";
    б = б + "if [ ! -d std/стандартная_библиотека ]; then tar -xf \"" + д + "LIB/libsfera_stdlib.so\" -C std 2>/dev/null; fi\n";
    б = б + "export PATH=\"" + д + "W/bin:" + д + "PATH\"\n";
    б = б + "export SFERA_STDLIB=\"" + д + "W/std/стандартная_библиотека\"\n";
    б = б + "export TMPDIR=" + д + "W\n";
    б = б + "echo '--- сборка ---'\n";
    б = б + "\"" + д + "LIB/libsferac.so\" пример.код --только-собрать || { echo \"сборка не удалась, код " + д + "?\"; exit 1; }\n";
    б = б + "echo '--- запуск ---'\n";
    б = б + "./пример\n";
    б = б + "echo \"код выхода: " + д + "?\"\n";
    вернуть б;
конец

// Короткая запись в журнал Android (adb logcat -s SferaPanel).
функция журнал(текст сообщение): целое
    android_лог(целое32(4), "SferaPanel", сообщение);
    вернуть 0;
конец

// Собирает и запускает программу, возвращает последние строки вывода.
// Каждый шаг пишется в журнал Android — по нему видно, где остановилось.
функция собрать_и_запустить(): текст
    текст рабочая = "/data/data/ru.sfera.panel/files/work";
    журнал("запуск: начало");
    результат из целое р1 = выполнить_команду("mkdir -p " + рабочая);
    журнал("запуск: mkdir успех=" + верно_в_текст(р1.успешно) + " код=" + целое_в_текст(р1.значение));
    результат из верного р2 = записать_файл(рабочая + "/пример.код", программа_для_запуска());
    журнал("запуск: запись примера успех=" + верно_в_текст(р2.успешно));
    результат из верного р3 = записать_файл(рабочая + "/запуск.sh", сценарий_запуска());
    журнал("запуск: запись сценария успех=" + верно_в_текст(р3.успешно));
    результат из целое р4 = выполнить_команду("sh " + рабочая + "/запуск.sh > " + рабочая + "/сырой.txt 2>&1");
    журнал("запуск: сценарий завершён успех=" + верно_в_текст(р4.успешно) + " код=" + целое_в_текст(р4.значение));
    результат из целое р5 = выполнить_команду("fold -w 30 " + рабочая + "/сырой.txt | tail -n 16 > " + рабочая + "/вывод.txt 2>&1");
    журнал("запуск: fold код=" + целое_в_текст(р5.значение));
    результат из текста вывод = прочитать_файл(рабочая + "/вывод.txt");
    если (вывод.успешно и длина(вывод.значение) больше 0)
        журнал("вывод: " + вывод.значение);
        вернуть вывод.значение;
    конец
    результат из текста сырой = прочитать_файл(рабочая + "/сырой.txt");
    если (сырой.успешно и длина(сырой.значение) больше 0)
        журнал("сырой вывод: " + сырой.значение);
        вернуть сырой.значение;
    конец
    вернуть "Пустой вывод. Подробности:\nadb logcat -s SferaPanel";
конец

функция главная(): целое
    инициализировать(беззнак32(32));
    инициализировать_шрифты();

    текст окно = создать_окно("Сфера — среда разработки", целое32(0), целое32(0), целое32(400), целое32(700), беззнак32(0));
    текст рендерер = создать_холст(окно, целое32(-1), беззнак32(2));
    текст шрифт = открыть_шрифт("font.ttf", целое32(40));
    текст буфер_события = выделить_память(56);

    РазмерЭкрана размер = размер_окна(окно);
    android_лог(целое32(4), "SferaPanel", "размер окна: " + целое_в_текст(целое(размер.ширина)) + "x" + целое_в_текст(целое(размер.высота)));

    // Вкладки сверху (не сбоку, как в macOS-версии) — на узком экране
    // телефона боковая колонка отъедала бы слишком много ширины у
    // содержимого; горизонтальные вкладки — привычнее для мобильного UI.
    Кнопка вкладка_обзор = Кнопка(целое32(0), целое32(0), целое32(0), целое32(150), беззнак8(40), беззнак8(45), беззнак8(60), "Обзор");
    Кнопка вкладка_документация = Кнопка(целое32(0), целое32(0), целое32(0), целое32(150), беззнак8(40), беззнак8(45), беззнак8(60), "Пример");
    Кнопка вкладка_установка = Кнопка(целое32(0), целое32(0), целое32(0), целое32(150), беззнак8(40), беззнак8(45), беззнак8(60), "Установка");
    Кнопка вкладка_запуск = Кнопка(целое32(0), целое32(0), целое32(0), целое32(150), беззнак8(40), беззнак8(45), беззнак8(60), "Запуск");
    Кнопка кнопка_запуска = Кнопка(целое32(50), целое32(280), целое32(900), целое32(140), беззнак8(40), беззнак8(150), беззнак8(60), "Собрать и запустить");
    Список из Кнопка вкладки_список = Список из Кнопка();
    вкладки_список.добавить(вкладка_обзор);
    вкладки_список.добавить(вкладка_документация);
    вкладки_список.добавить(вкладка_установка);
    вкладки_список.добавить(вкладка_запуск);
    Панель панель_вкладок = Панель(целое32(0), целое32(0), целое32(1000), целое32(150), беззнак8(25), беззнак8(28), беззнак8(38), вкладки_список);
    // НОВОЕ (якоря): ширина панели и позиции трёх вкладок внутри нее
    // должны подстраиваться под реальную ширину экрана устройства, а не
    // угаданную заранее — растягиваем панель, затем расставляем вкладки
    // равными долями по её новой, настоящей ширине.
    панель_вкладок.растянуть_по_ширине(размер);
    целое32 ширина_вкладки = размер.ширина / целое32(4);
    Список из Кнопка вкладки_для_позиций = панель_вкладок.кнопки;
    Кнопка вкладка0 = вкладки_для_позиций.получить(0);
    вкладка0.х = целое32(0);
    вкладка0.ширина = ширина_вкладки;
    Кнопка вкладка1 = вкладки_для_позиций.получить(1);
    вкладка1.х = ширина_вкладки;
    вкладка1.ширина = ширина_вкладки;
    Кнопка вкладка2 = вкладки_для_позиций.получить(2);
    вкладка2.х = ширина_вкладки * целое32(2);
    вкладка2.ширина = ширина_вкладки;
    Кнопка вкладка3 = вкладки_для_позиций.получить(3);
    вкладка3.х = ширина_вкладки * целое32(3);
    вкладка3.ширина = размер.ширина - вкладка3.х;
    кнопка_запуска.ширина = размер.ширина - целое32(100);

    текст вывод_запуска = "Нажмите кнопку выше: программа\nсоберётся и запустится на телефоне.";
    верно надо_запустить = нет;

    целое текущая_вкладка = 0;
    верно работает = да;

    пока (работает)
        целое32 итог_события = опросить_событие(буфер_события);
        пока (итог_события != целое32(0))
            целое32 тип_события = прочитать_целое32(буфер_события, 0);
            если (тип_события == целое32(1025))
                целое32 х_клика = прочитать_целое32(буфер_события, 20);
                целое32 у_клика = прочитать_целое32(буфер_события, 24);
                целое32 индекс_вкладки = панель_вкладок.кнопка_под_точкой(х_клика, у_клика);
                если (индекс_вкладки не меньше целое32(0))
                    текущая_вкладка = целое(индекс_вкладки);
                иначе
                    если (текущая_вкладка == 3 и кнопка_запуска.содержит_точку(х_клика, у_клика))
                        вывод_запуска = "Идёт сборка, подождите...";
                        надо_запустить = да;
                    конец
                конец
            конец
            если (тип_события == целое32(256))
                работает = нет;
            конец
            итог_события = опросить_событие(буфер_события);
        конец

        задать_цвет(рендерер, беззнак8(20), беззнак8(20), беззнак8(24), беззнак8(255));
        очистить_холст(рендерер);

        панель_вкладок.нарисовать(рендерер, шрифт);

        если (текущая_вкладка == 0)
            нарисовать_текст(рендерер, шрифт, "Версия: " + текущая_версия(), целое32(50), целое32(200), беззнак32(4294967295));
            нарисовать_многострочный_текст(рендерер, шрифт, описание_языка(), целое32(50), целое32(290), беззнак32(4294967295));
        иначе если (текущая_вкладка == 1)
            нарисовать_текст(рендерер, шрифт, "Пример синтаксиса:", целое32(50), целое32(200), беззнак32(4294967295));
            нарисовать_многострочный_текст(рендерер, шрифт, пример_синтаксиса(), целое32(50), целое32(290), беззнак32(4288716692));
        иначе если (текущая_вкладка == 2)
            нарисовать_многострочный_текст(рендерер, шрифт, заглушка_установки(), целое32(50), целое32(200), беззнак32(4294967295));
        иначе
            нарисовать_текст(рендерер, шрифт, "Запуск на телефоне", целое32(50), целое32(200), беззнак32(4294967295));
            кнопка_запуска.нарисовать(рендерер, шрифт);
            нарисовать_многострочный_текст(рендерер, шрифт, вывод_запуска, целое32(50), целое32(460), беззнак32(4288716692));
        конец

        показать_холст(рендерер);
        если (надо_запустить)
            надо_запустить = нет;
            вывод_запуска = собрать_и_запустить();
        конец
        подождать(беззнак32(30));
    конец

    закрыть_окно(окно);
    завершить();
    вернуть 0;
конец
