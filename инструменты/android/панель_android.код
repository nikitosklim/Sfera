функция разбить_строки(текст с): Список из текст
    Список из текст итог = Список из текст();
    целое н = длина(с);
    целое нач = 0;
    целое индекс = 0;
    пока (индекс меньше н)
        если (байт(с, индекс) == 10)
            итог.добавить(вырезать(с, нач, индекс));
            нач = индекс + 1;
        конец
        индекс = индекс + 1;
    конец
    если (нач меньше н)
        итог.добавить(вырезать(с, нач, н));
    конец
    вернуть итог;
конец

функция разбить_по(текст с, текст раздел): Список из текст
    Список из текст итог = Список из текст();
    целое н = длина(с);
    целое лр = длина(раздел);
    целое нач = 0;
    верно ещё = да;
    пока (ещё)
        результат из целое п = найти(вырезать(с, нач, н), раздел);
        если (п.успешно)
            итог.добавить(вырезать(с, нач, нач + п.значение));
            нач = нач + п.значение + лр;
        иначе
            итог.добавить(вырезать(с, нач, н));
            ещё = нет;
        конец
    конец
    вернуть итог;
конец

функция заменить_все(текст с, текст что, текст на): текст
    текст остаток = с;
    текст итог = "";
    верно ещё = да;
    пока (ещё)
        результат из целое п = найти(остаток, что);
        если (п.успешно)
            итог = итог + вырезать(остаток, 0, п.значение) + на;
            остаток = вырезать(остаток, п.значение + длина(что), длина(остаток));
        иначе
            итог = итог + остаток;
            ещё = нет;
        конец
    конец
    вернуть итог;
конец

функция обрезать_пробелы(текст с): текст
    целое н = длина(с);
    целое а = 0;
    пока (а меньше н и (байт(с, а) == 32 или байт(с, а) == 9 или байт(с, а) == 13))
        а = а + 1;
    конец
    целое б = н;
    пока (б больше а и (байт(с, б - 1) == 32 или байт(с, б - 1) == 9 или байт(с, б - 1) == 13 или байт(с, б - 1) == 10))
        б = б - 1;
    конец
    вернуть вырезать(с, а, б);
конец

// Делит строку на части не длиннее «максимум» символов (по пробелам).
функция перенести(текст с, целое максимум, Список из текст куда): целое
    если (длина_в_символах(с) не больше максимум)
        куда.добавить(с);
        вернуть 0;
    конец
    целое н = длина(с);
    целое нач = 0;
    пока (нач меньше н)
        целое предел = сдвиг_на_символы(с, нач, максимум, н);
        если (предел не меньше н)
            куда.добавить(вырезать(с, нач, н));
            нач = н;
        иначе
            целое п = предел;
            пока (п больше нач и байт(с, п) != 32)
                п = п - 1;
            конец
            если (п больше нач)
                куда.добавить(вырезать(с, нач, п));
                нач = п + 1;
            иначе
                куда.добавить(вырезать(с, нач, предел));
                нач = предел;
            конец
        конец
    конец
    вернуть 0;
конец

// Имя файла без опасных символов.
функция очистить_имя(текст с): текст
    текст итог = "";
    целое индекс = 0;
    целое н = длина(с);
    пока (индекс меньше н)
        целое следующий = вперёд_на_символ(с, индекс);
        целое б = байт(с, индекс);
        если (б != 47 и б != 39 и б != 34 и б != 36 и б != 96 и б != 92 и б != 32 и б != 10 и б != 42 и б != 63 и б != 59 и б != 38 и б != 124 и б != 60 и б != 62)
            итог = итог + вырезать(с, индекс, следующий);
        иначе если (б == 32)
            итог = итог + "_";
        конец
        индекс = следующий;
    конец
    вернуть итог;
конец

