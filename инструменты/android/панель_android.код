    пока (н меньше 1000)
        текст кандидат = "программа" + целое_в_текст(н);
        верно занято = нет;
        целое ин = 0;
        пока (ин меньше с.мои.размер())
            если (с.мои.получить(ин) == кандидат)
                занято = да;
            конец
            ин = ин + 1;
        конец
        если (не занято)
            вернуть кандидат;
        конец
        н = н + 1;
    конец
    вернуть "программа";
