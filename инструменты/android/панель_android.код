функция нажатие_редактора(Ср с, целое х, целое у): целое
    целое верх = 250;
    целое вид = видимых_строк(с);
    если (у не меньше верх и у меньше верх + вид * с.lh)
        целое строка = с.скр_у + (у - верх) / с.lh;
        целое кол = с.скр_х + (х - 90 + с.cw / 2) / с.cw;
        если (кол меньше 0)
            кол = 0;
        конец
        поставить_курсор(с, строка, кол);
        если (не с.клав)
            включить_клавиатуру(с, да);
        иначе
            следить_за_курсором(с);
        конец
        вернуть 0;
    конец
    целое ш = (с.W - 100) / 4;
    если (внутри(х, у, 20, 140, ш, 100))
        сохранить(с);
    иначе если (внутри(х, у, 40 + ш, 140, ш, 100))
        запустить_программу(с);
    иначе если (внутри(х, у, 60 + ш * 2, 140, ш, 100))
        включить_клавиатуру(с, не с.клав);
    иначе если (внутри(х, у, 80 + ш * 3, 140, ш, 100))
        текст б = из_буфера();
        если (длина(б) больше 0)
            вставить_в_курсор(с, б);
            следить_за_курсором(с);
        иначе
            сказать(с, "Буфер обмена пуст");
        конец
    иначе
        целое ту = верх + вид * с.lh + 10;
        если (у не меньше ту и у меньше ту + 120)
            целое тш = с.W / 8;
            целое ин = х / тш;
            Список из текст тк = токены();
            если (ин == 6)
                если (с.курсор больше 0)
                    с.курсор = назад_на_символ(с.код, с.курсор);
                конец
            иначе если (ин == 7)
                с.курсор = вперёд_на_символ(с.код, с.курсор);
            иначе если (ин меньше 6 и ин не меньше 0)
                вставить_в_курсор(с, тк.получить(ин));
            конец
            следить_за_курсором(с);
        конец
    конец
    вернуть 0;
конец

функция нажатие(Ср с, целое х, целое у): целое
    если (с.диалог_удаления)
        если (внутри(х, у, 120 + (с.W - 260) / 2, 900, (с.W - 260) / 2, 120))
            команда("rm -f " + путь_программ(с) + "/" + с.диалог_имя + ".код");
            если (с.имя == с.диалог_имя)
                с.имя = "";
                с.код = "";
                с.грязный = нет;
            конец
            обновить_списки(с);
            сказать(с, "Файл удалён");
        конец
        с.диалог_удаления = нет;
        вернуть 0;
    конец
    если (не (с.экран == 1 и с.клав) и у не меньше с.H - 140)
        целое н = х / (с.W / 5);
        если (н больше 4)
            н = 4;
        конец
        с.экран = н;
        если (н == 2)
            обновить_списки(с);
        конец
        вернуть 0;
    конец
    если (с.экран == 0)
        если (внутри(х, у, 30, 160, с.W - 60, 300))
            с.экран = 3;
            с.чит_открыт = нет;
        иначе если (внутри(х, у, 30, 490, (с.W - 80) / 2, 120))
            новая_программа(с);
        иначе если (внутри(х, у, 50 + (с.W - 80) / 2, 490, (с.W - 80) / 2, 120))
            если (длина(с.имя) больше 0)
                с.экран = 1;
            иначе
                новая_программа(с);
            конец
        иначе если (внутри(х, у, 30, 630, (с.W - 80) / 2, 120))
            с.экран = 2;
            с.режим_файлов = 1;
            с.файлы_скр = 0;
        иначе если (внутри(х, у, 50 + (с.W - 80) / 2, 630, (с.W - 80) / 2, 120))
            команда("am start -a android.intent.action.VIEW -d https://github.com/nikitosklim/Sfera > /dev/null 2>&1");
        иначе если (внутри(х, у, 30, 1170, с.W - 60, 160))
            с.совет = с.совет + 1;
        конец
    иначе если (с.экран == 1)
        нажатие_редактора(с, х, у);
    иначе если (с.экран == 2)
        целое ш = (с.W - 60) / 2;
        если (внутри(х, у, 20, 140, ш, 100))
            с.режим_файлов = 0;
            с.файлы_скр = 0;
        иначе если (внутри(х, у, 40 + ш, 140, ш, 100))
            с.режим_файлов = 1;
            с.файлы_скр = 0;
        иначе если (с.режим_файлов == 0 и внутри(х, у, 30, с.H - 270, с.W - 60, 110))
            новая_программа(с);
        иначе если (у не меньше 270 и у меньше с.H - 140)
            целое ин = (у - 270 + с.файлы_скр) / 160;
            Список из текст л = с.мои;
            если (с.режим_файлов == 1)
                л = с.примеры;
            конец
            если (ин не меньше 0 и ин меньше л.размер())
                текст имя = л.получить(ин);
                если (с.режим_файлов == 0 и х больше с.W - 200)
                    с.диалог_удаления = да;
                    с.диалог_имя = имя;
                иначе если (с.режим_файлов == 0)
                    если (с.грязный)
                        сохранить(с);
                    конец
                    открыть(с, путь_программ(с) + "/" + имя + ".код", имя);
                иначе
                    если (с.грязный)
                        сохранить(с);
                    конец
                    текст новое = имя;
                    открыть(с, с.корень + "/examples/" + имя + ".код", новое);
                    с.имя = "пример_" + имя;
                    с.грязный = да;
                    сохранить(с);
                    обновить_списки(с);
                конец
            конец
        конец
    иначе если (с.экран == 3)
        если (с.чит_открыт)
            если (внутри(х, у, 20, 15, 220, 100))
                с.чит_открыт = нет;
            конец
        иначе
            целое ш = (с.W - 60) / 2;
            если (внутри(х, у, 20, 140, ш, 100))
                с.режим_справки = 0;
                с.справка_скр = 0;
            иначе если (внутри(х, у, 40 + ш, 140, ш, 100))
                с.режим_справки = 1;
                с.справка_скр = 0;
            иначе если (у не меньше 270 и у меньше с.H - 140)
                целое ин = (у - 270 + с.справка_скр) / 160;
                если (с.режим_справки == 0 и ин не меньше 0 и ин меньше с.сп_имена.размер())
                    открыть_справку(с, с.корень + "/docs/" + с.сп_имена.получить(ин) + ".md", с.сп_названия.получить(ин));
                иначе если (с.режим_справки == 1 и ин не меньше 0 и ин меньше с.ур_имена.размер())
                    открыть_справку(с, с.корень + "/lessons/" + с.ур_имена.получить(ин) + ".md", с.ур_названия.получить(ин));
                конец
            конец
        конец
    иначе
        целое ш = (с.W - 100) / 3;
        если (внутри(х, у, 20, 140, ш, 100))
            текст все = "";
            целое ин = 0;
            пока (ин меньше с.вывод.размер())
                все = все + с.вывод.получить(ин) + "\n";
                ин = ин + 1;
            конец
            в_буфер(все);
            сказать(с, "Вывод скопирован");
        иначе если (внутри(х, у, 40 + ш, 140, ш, 100))
            с.вывод = Список из текст();
            с.итог_время = "";
        иначе если (внутри(х, у, 60 + ш * 2, 140, ш, 100))
            если (с.идёт)
                остановить(с);
            иначе
                запустить_программу(с);
            конец
        конец
    конец
    вернуть 0;
конец

// Прокрутка пальцем: dy — на сколько пикселей сдвинулся палец.
функция прокрутка(Ср с, целое дх, целое ду, целое х, целое у): целое
    если (с.экран == 1)
        с.нак_у = с.нак_у + ду;
        пока (с.нак_у не меньше с.lh)
            с.нак_у = с.нак_у - с.lh;
            если (с.скр_у больше 0)
                с.скр_у = с.скр_у - 1;
            конец
        конец
        пока (с.нак_у не больше 0 - с.lh)
            с.нак_у = с.нак_у + с.lh;
            если (с.скр_у меньше число_строк(с.код) - 1)
                с.скр_у = с.скр_у + 1;
            конец
        конец
        с.нак_х = с.нак_х + дх;
        пока (с.нак_х не меньше с.cw)
            с.нак_х = с.нак_х - с.cw;
            если (с.скр_х больше 0)
                с.скр_х = с.скр_х - 1;
            конец
        конец
        пока (с.нак_х не больше 0 - с.cw)
            с.нак_х = с.нак_х + с.cw;
            с.скр_х = с.скр_х + 1;
        конец
    иначе если (с.экран == 2)
        с.файлы_скр = с.файлы_скр - ду;
        целое л = с.мои.размер();
        если (с.режим_файлов == 1)
            л = с.примеры.размер();
        конец
        целое макс = л * 160 + 270 - (с.H - 140) + 140;
        если (с.файлы_скр больше макс)
            с.файлы_скр = макс;
        конец
        если (с.файлы_скр меньше 0)
            с.файлы_скр = 0;
        конец
    иначе если (с.экран == 3)
        если (с.чит_открыт)
            с.чит_скр = с.чит_скр - ду;
            если (с.чит_скр меньше 0)
                с.чит_скр = 0;
            конец
            целое общ = 0;
            целое ин = 0;
            пока (ин меньше с.чит_строки.размер())
                целое тп = с.чит_типы.получить(ин);
                если (тп == 1)
                    общ = общ + 70;
                иначе если (тп == 2)
                    общ = общ + с.lh;
                иначе если (тп == 3)
                    общ = общ + 22;
                иначе
                    общ = общ + 46;
                конец
                ин = ин + 1;
            конец
            целое мк = общ + 150 - (с.H - 140) + 100;
            если (с.чит_скр больше мк и мк больше 0)
                с.чит_скр = мк;
            конец
        иначе
            с.справка_скр = с.справка_скр - ду;
            целое л = с.сп_имена.размер();
            если (с.режим_справки == 1)
                л = с.ур_имена.размер();
            конец
            целое макс = л * 160 + 270 - (с.H - 140) + 140;
            если (с.справка_скр больше макс)
                с.справка_скр = макс;
            конец
            если (с.справка_скр меньше 0)
                с.справка_скр = 0;
            конец
        конец
    иначе если (с.экран == 4)
        с.вывод_скр = с.вывод_скр - ду;
        если (с.вывод_скр меньше 0)
            с.вывод_скр = 0;
        конец
    конец
    вернуть 0;
конец

функция главная(): целое
    инициализировать(беззнак32(32));
    инициализировать_шрифты();
    текст окно = создать_окно("Сфера", целое32(0), целое32(0), целое32(1080), целое32(1944), беззнак32(0));
    текст хол = создать_холст(окно, целое32(-1), беззнак32(2));
    текст буфер = выделить_память(56);
    РазмерЭкрана рэ = размер_окна(окно);
    журнал("окно " + целое_в_текст(целое(рэ.ширина)) + "x" + целое_в_текст(целое(рэ.высота)));
    текст ш_ui = открыть_шрифт("font.ttf", целое32(38));
    текст ш_мал = открыть_шрифт("font.ttf", целое32(32));
    текст ш_код = открыть_шрифт("mono.ttf", целое32(36));
    текст ш_заг = открыть_шрифт("font.ttf", целое32(44));
    текст ш_бол = открыть_шрифт("font.ttf", целое32(52));
    текст бш = выделить_память(4);
    текст бв = выделить_память(4);
    Ср с = Ср(0, "", 0, 0, 0, "", нет, 0, 0, нет, 0, 0, 0, 0, 0, 0, нет, нет,
        Список из текст(), Список из текст(), 0, 0, 0,
        Список из текст(), Список из текст(), Список из текст(),
        Список из текст(), Список из текст(), Список из текст(),
        0, Список из текст(), Список из целое(), 0, "", нет,
        Список из текст(), 0, нет, 0, "", "", 0,
        в_целое(хол), в_целое(ш_ui), в_целое(ш_мал), в_целое(ш_код), в_целое(ш_заг), в_целое(ш_бол), в_целое(бш), в_целое(бв), 22, 44, целое(рэ.ширина), целое(рэ.высота),
        корень_данных(), 0, нет, "", да, нет);
    размер_utf8(ш_код, "M", бш, бв);
    с.cw = целое(прочитать_целое32(бш, 0));
    с.lh = целое(прочитать_целое32(бв, 0)) + 6;
    журнал("шрифт кода " + целое_в_текст(с.cw) + "x" + целое_в_текст(с.lh));

    подготовить(с);
    разобрать_список(с.корень + "/docs/list.txt", с.сп_имена, с.сп_названия, с.сп_описания);
    разобрать_список(с.корень + "/lessons/list.txt", с.ур_имена, с.ур_названия, с.ур_описания);
    обновить_списки(с);
    результат из текста посл = прочитать_файл(с.корень + "/последняя.txt");
    если (посл.успешно)
        текст им = обрезать_пробелы(посл.значение);
        если (длина(им) больше 0)
            результат из текста код0 = прочитать_файл(путь_программ(с) + "/" + им + ".код");
            если (код0.успешно)
                с.имя = им;
                с.код = код0.значение;
            конец
        конец
    конец

    верно работает = да;
    пока (работает)
        целое32 итог = опросить_событие(буфер);
        пока (итог != целое32(0))
            целое32 тип = прочитать_целое32(буфер, 0);
            если (тип == целое32(256))
                работает = нет;
            конец
            если (тип == целое32(259) или тип == целое32(260))
                если (с.грязный)
                    сохранить(с);
                конец
            конец
            если (тип == целое32(1025))
                с.нажато = да;
                с.х0 = целое(прочитать_целое32(буфер, 20));
                с.у0 = целое(прочитать_целое32(буфер, 24));
                с.пх = с.х0;
                с.пу = с.у0;
                с.двигался = нет;
                с.нак_у = 0;
                с.нак_х = 0;
            конец
            если (тип == целое32(1024) и с.нажато)
                целое х = целое(прочитать_целое32(буфер, 20));
                целое у = целое(прочитать_целое32(буфер, 24));
                целое ддх = х - с.пх;
                целое ддy = у - с.пу;
                если (не с.двигался)
                    если (ддх * ддх + ддy * ддy больше 900 или (х - с.х0) * (х - с.х0) + (у - с.у0) * (у - с.у0) больше 900)
                        с.двигался = да;
                    конец
                конец
                если (с.двигался)
                    прокрутка(с, ддх, ддy, х, у);
                конец
                с.пх = х;
                с.пу = у;
            конец
            если (тип == целое32(1026))
                если (с.нажато и не с.двигался)
                    нажатие(с, с.х0, с.у0);
                конец
                с.нажато = нет;
            конец
            если (тип == целое32(771) и с.экран == 1 и с.клав)
                вставить_в_курсор(с, прочитать_текст_по_смещению(буфер, 12));
                следить_за_курсором(с);
            конец
            если (тип == целое32(768) и с.экран == 1 и с.клав)
                целое код = целое(прочитать_целое32(буфер, 20));
                если (код == 8)
                    удалить_перед(с);
                    следить_за_курсором(с);
                иначе если (код == 13)
                    перевод_строки(с);
                    следить_за_курсором(с);
                конец
            конец
            итог = опросить_событие(буфер);
        конец
        с.кадр = с.кадр + 1;
        если (с.идёт и с.кадр % 15 == 0)
            опросить_вывод(с);
        конец
        если (с.грязный и с.кадр - с.правка_кадр больше 150 и с.экран == 1)
            сохранить(с);
        конец
        отрисовать(с);
        подождать(беззнак32(16));
    конец
    если (с.грязный)
        сохранить(с);
    конец
    закрыть_окно(окно);
    завершить();
    вернуть 0;
конец
