// Тёмные серо-синие цвета интерфейса переводим в палитру «Синей стали» (как на сайте):
// меньше красного, чуть меньше зелёного, больше синего. Яркие и цветные не трогаем.
функция в_сталь(целое к, целое з, целое с): целое
    если (к больше 130 или з больше 130 или с больше 140)
        вернуть к * 65536 + з * 256 + с;
    конец
    если (с - к меньше 6)
        вернуть к * 65536 + з * 256 + с;
    конец
    целое нк = к * 50 / 100;
    целое нз = з * 80 / 100;
    целое нс = с * 120 / 100;
    вернуть нк * 65536 + нз * 256 + нс;
конец

