функция открыть_справку(Ср с, текст путь, текст название): целое
    результат из текста ч = прочитать_файл(путь);
    если (не ч.успешно)
        сказать(с, "Раздел не найден");
        вернуть 0;
    конец
    Список из текст строки = Список из текст();
    Список из целое типы = Список из целое();
    Список из текст сырые = разбить_строки(ч.значение);
    верно код = нет;
    текст абзац = "";
    целое ин = 0;
    целое колонок = (с.W - 80) / с.cw;
    пока (ин не больше сырые.размер())
        текст ст = "";
        верно конец_файла = ин == сырые.размер();
        если (не конец_файла)
            ст = сырые.получить(ин);
        конец
        текст ст2 = заменить_все(заменить_все(ст, "**", ""), "`", "");
        верно спец = начинается_с(ст, "```") или начинается_с(ст2, "#") или начинается_с(ст2, "- ") или начинается_с(ст2, "* ") или начинается_с(ст2, "|") или длина(обрезать_пробелы(ст)) == 0 или конец_файла;
        если (не код и спец и длина(абзац) больше 0)
            Список из текст чч = Список из текст();
            перенести(абзац, (с.W - 80) / 20, чч);
            целое кк = 0;
            пока (кк меньше чч.размер())
                строки.добавить(чч.получить(кк));
                типы.добавить(0);
                кк = кк + 1;
            конец
            строки.добавить("");
            типы.добавить(3);
            абзац = "";
        конец
        если (не конец_файла)
            если (начинается_с(ст, "```"))
                код = не код;
            иначе если (код)
                Список из текст части = Список из текст();
                перенести(ст, колонок, части);
                если (части.размер() == 0)
                    части.добавить("");
                конец
                целое кк2 = 0;
                пока (кк2 меньше части.размер())
                    строки.добавить(части.получить(кк2));
                    типы.добавить(2);
                    кк2 = кк2 + 1;
                конец
            иначе если (начинается_с(ст2, "#"))
                пока (длина(ст2) больше 0 и (байт(ст2, 0) == 35 или байт(ст2, 0) == 32))
                    ст2 = вырезать(ст2, 1, длина(ст2));
                конец
                строки.добавить(ст2);
                типы.добавить(1);
            иначе если (начинается_с(ст2, "- ") или начинается_с(ст2, "* "))
                Список из текст чб = Список из текст();
                перенести("• " + вырезать(ст2, 2, длина(ст2)), (с.W - 80) / 20, чб);
                целое кк3 = 0;
                пока (кк3 меньше чб.размер())
                    строки.добавить(чб.получить(кк3));
                    типы.добавить(0);
                    кк3 = кк3 + 1;
                конец
            иначе если (начинается_с(ст2, "|"))
                результат из целое разд = найти(ст2, "---");
                если (не разд.успешно)
                    Список из текст чт = Список из текст();
                    перенести(заменить_все(ст2, "|", " "), (с.W - 80) / 20, чт);
                    целое кт = 0;
                    пока (кт меньше чт.размер())
                        строки.добавить(чт.получить(кт));
                        типы.добавить(0);
                        кт = кт + 1;
                    конец
                конец
            иначе если (длина(обрезать_пробелы(ст)) больше 0)
                если (длина(абзац) больше 0)
                    абзац = абзац + " ";
                конец
                абзац = абзац + обрезать_пробелы(ст2);
            конец
        конец
        ин = ин + 1;
    конец
    с.чит_строки = строки;
    с.чит_типы = типы;
    с.чит_скр = 0;
    с.чит_заголовок = название;
    с.чит_открыт = да;
    вернуть 0;
конец

