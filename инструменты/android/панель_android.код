функция завершить_акк(Ср с, текст код): целое
    целое вид = с.акк_занят;
    с.акк_занят = 0;
    текст тело = сеть_тело(с, "acc");
    если (вид == 12)
        если (код == "200" и содержит(тело, "\"вошёл\":true"))
            запомнить_вход(с, тело);
        иначе
            с.вошёл = нет;
        конец
    иначе если (вид == 13)
        если (код == "200")
            с.мп_имена = Список из текст();
            с.мп_версии = Список из текст();
            с.мп_статусы = Список из текст();
            с.мп_описания = Список из текст();
            собрать_мои_пакеты(тело, с.мп_имена, с.мп_версии, с.мп_статусы, с.мп_описания);
        конец
    иначе если (вид == 14 или вид == 15)
        если ((код == "200" или код == "201") и содержит(тело, "\"ok\":true"))
            запомнить_вход(с, тело);
            с.фокус_формы = 0;
            клавиатура(с, нет);
            сказать(с, "Вы вошли как " + с.ник);
        иначе если (длина(json_поле(тело, "ошибка")) больше 0)
            с.ошибка_входа = json_поле(тело, "ошибка");
        иначе
            с.ошибка_входа = "Нет связи с сервером. Проверьте интернет.";
        конец
    иначе если (вид == 16)
        с.вошёл = нет;
        с.ник = "";
        с.роль = "";
        с.мп_имена = Список из текст();
        с.мп_версии = Список из текст();
        с.мп_статусы = Список из текст();
        с.мп_описания = Список из текст();
        команда("rm -f " + сеть_папка(с) + "/cookie.txt");
        сказать(с, "Вы вышли из аккаунта");
    конец
    вернуть 0;
конец

функция опросить_сеть(Ср с): целое
    если (с.жду_обн)
        текст к = сеть_код(с, "upd");
        если (длина(к) больше 0)
            с.жду_обн = нет;
            если (к == "200")
                текст ответ = сеть_тело(с, "upd");
                текст версия_сервера = поле_ответа(ответ, "версия");
                если (длина(версия_сервера) больше 0 и номер_версии(версия_сервера) больше номер_версии(версия_приложения()))
                    с.есть_обновление = да;
                    с.нов_версия = версия_сервера;
                    с.адр_обновления = адрес_сервера() + поле_ответа(ответ, "адрес");
                    с.опис_обновления = изменения_из_ответа(ответ);
                конец
            конец
        конец
    конец
    если (с.жду_рег)
        текст к2 = сеть_код(с, "reg");
        если (длина(к2) больше 0)
            с.жду_рег = нет;
            если (к2 == "200")
                с.пк_имена = Список из текст();
                с.пк_версии = Список из текст();
                с.пк_авторы = Список из текст();
                с.пк_описания = Список из текст();
                разобрать_реестр(сеть_тело(с, "reg"), с.пк_имена, с.пк_версии, с.пк_авторы, с.пк_описания);
                с.пк_загружены = да;
                с.пк_ошибка = нет;
            иначе
                с.пк_ошибка = да;
            конец
        конец
    конец
    если (с.акк_занят больше 0 и с.акк_занят != 99)
        текст к3 = сеть_код(с, "acc");
        если (длина(к3) больше 0)
            завершить_акк(с, к3);
        конец
    конец
    вернуть 0;
конец

// Вход и регистрация. Пароль превращается в тот же PBKDF2, что и в браузере (имя в нижнем регистре — соль).
функция отправить_форму(Ср с): целое
    если (с.акк_занят больше 0)
        вернуть 0;
    конец
    текст имя = обрезать_края(с.поле_ника);
    если (число_символов(имя) меньше 3)
        с.ошибка_входа = "Имя: не короче трёх знаков.";
        вернуть 0;
    конец
    если (число_символов(с.поле_пароля) меньше 8)
        с.ошибка_входа = "Пароль: не короче восьми знаков.";
        вернуть 0;
    конец
    если (с.режим_входа == 1 и с.поле_пароля != с.поле_повтора)
        с.ошибка_входа = "Пароли не совпадают.";
        вернуть 0;
    конец
    с.ошибка_входа = "";
    с.фокус_формы = 0;
    клавиатура(с, нет);
    // Подсчёт хеша занимает секунду-другую: сначала рисуем «Проверяю…», хеш считаем в следующем кадре.
    с.акк_занят = 99;
    с.хеш_кадр = с.кадр;
    вернуть 0;
конец

функция отправить_форму_теперь(Ср с): целое
    текст имя = обрезать_края(с.поле_ника);
    текст хеш = pbkdf2_sha256(с.поле_пароля, "sfera:" + в_нижний(имя), 150000);
    текст действие = "вход";
    целое вид = 14;
    если (с.режим_входа == 1)
        действие = "регистрация";
        вид = 15;
    конец
    с.поле_пароля = "";
    с.поле_повтора = "";
    запросить_аккаунт(с, вид, "POST", действие, "имя=" + кодировать_адрес(имя) + "&пароль=" + хеш);
    вернуть 0;
конец

функция клавиатура(Ср с, верно вкл): целое
    если (вкл и не с.клав)
        начать_ввод_текста();
    иначе если (не вкл и с.клав)
        закончить_ввод_текста();
    конец
    с.клав = вкл;
    вернуть 0;
конец

функция в_поле_добавить(Ср с, текст кусок): целое
    если (с.фокус_формы == 1 и длина(с.поле_ника) меньше 60)
        с.поле_ника = с.поле_ника + кусок;
    иначе если (с.фокус_формы == 2 и длина(с.поле_пароля) меньше 100)
        с.поле_пароля = с.поле_пароля + кусок;
    иначе если (с.фокус_формы == 3 и длина(с.поле_повтора) меньше 100)
        с.поле_повтора = с.поле_повтора + кусок;
    конец
    вернуть 0;
конец

функция без_последнего(текст т): текст
    если (длина(т) == 0)
        вернуть "";
    конец
    вернуть вырезать(т, 0, назад_на_символ(т, длина(т)));
конец

функция в_поле_стереть(Ср с): целое
    если (с.фокус_формы == 1)
        с.поле_ника = без_последнего(с.поле_ника);
    иначе если (с.фокус_формы == 2)
        с.поле_пароля = без_последнего(с.поле_пароля);
    иначе если (с.фокус_формы == 3)
        с.поле_повтора = без_последнего(с.поле_повтора);
    конец
    вернуть 0;
конец

// ============================ Экран «Пакеты» ============================

функция кратко(текст строка, целое макс): текст
    если (длина_в_символах(строка) больше макс)
        вернуть вырезать(строка, 0, сдвиг_на_символы(строка, 0, макс - 1, длина(строка))) + "…";
    конец
    вернуть строка;
конец

// Хвост строки, который помещается в ширину (для длинного текста в поле ввода).
функция хвост_по_ширине(Ср с, текст шрифт, текст строка, целое макс): текст
    текст р = строка;
    пока (длина(р) больше 0 и ширина_текста(с, шрифт, р) больше макс)
        р = вырезать(р, вперёд_на_символ(р, 0), длина(р));
    конец
    вернуть р;
конец

функция плашка(Ср с, текст статус, целое правый, целое у): целое
    текст надп = "не проверенный";
    целое р = 200;
    целое з = 140;
    целое б = 30;
    если (статус == "проверен")
        надп = "проверенный";
        р = 50;
        з = 160;
        б = 90;
    иначе если (статус == "нежелательный")
        надп = "отклонён";
        р = 190;
        з = 60;
        б = 60;
    конец
    целое тш = ширина_текста(с, п_ш_мал(с), надп);
    заливка(п_хол(с), р, з, б);
    скруглённый(п_хол(с), правый - тш - 40, у, тш + 40, 52, 26);
    т(с, п_ш_мал(с), надп, правый - тш - 20, у + 7, цвет(255, 255, 255));
    вернуть 0;
конец

функция затемнить(Ср с): целое
    задать_режим_смешивания(п_хол(с), целое32(1));
    заливка_а(п_хол(с), 0, 0, 0, 170);
    прямоугольник(п_хол(с), 0, 0, с.W, с.H);
    вернуть 0;
конец

функция каталог_пакетов(Ср с): целое
    если (не с.пк_загружены)
        если (с.пк_ошибка)
            т(с, п_ш_ui(с), "Нет связи с сервером.", 60, 330, цвет(230, 120, 120));
            т(с, п_ш_мал(с), "Проверьте интернет и нажмите «Обновить».", 60, 390, цвет(142, 164, 208));
        иначе
            т(с, п_ш_ui(с), "Загружаю каталог…", 60, 330, цвет(142, 164, 208));
        конец
        вернуть 0;
    конец
    если (с.пк_имена.размер() == 0)
        т(с, п_ш_ui(с), "В каталоге пока нет пакетов.", 60, 330, цвет(142, 164, 208));
        вернуть 0;
    конец
    целое ин = 0;
    пока (ин меньше с.пк_имена.размер())
        целое у = 270 + ин * 210 - с.пк_скр;
        если (у больше 100 и у меньше с.H - 140)
            заливка(п_хол(с), 36, 40, 56);
            скруглённый(п_хол(с), 30, у, с.W - 60, 190, 20);
            т(с, п_ш_ui(с), с.пк_имена.получить(ин), 60, у + 20, цвет(255, 255, 255));
            текст верс = "v" + с.пк_версии.получить(ин);
            т(с, п_ш_мал(с), верс, с.W - 60 - ширина_текста(с, п_ш_мал(с), верс), у + 24, цвет(127, 186, 255));
            т(с, п_ш_мал(с), кратко(с.пк_описания.получить(ин), 40), 60, у + 82, цвет(142, 164, 208));
            т(с, п_ш_мал(с), "автор: " + с.пк_авторы.получить(ин), 60, у + 130, цвет(120, 130, 155));
        конец
        ин = ин + 1;
    конец
    вернуть 0;
конец

функция лист_пакета(Ср с): целое
    затемнить(с);
    целое выс = 820;
    целое у0 = с.H - выс;
    заливка(п_хол(с), 44, 50, 70);
    скруглённый(п_хол(с), 0, у0, с.W, выс + 40, 40);
    заливка(п_хол(с), 90, 98, 124);
    скруглённый(п_хол(с), с.W / 2 - 50, у0 + 18, 100, 10, 5);
    текст имя = с.пк_имена.получить(с.пк_выбран);
    т(с, п_ш_бол(с), имя, 60, у0 + 50, цвет(255, 255, 255));
    т(с, п_ш_мал(с), "версия " + с.пк_версии.получить(с.пк_выбран) + "  ·  автор: " + с.пк_авторы.получить(с.пк_выбран), 60, у0 + 125, цвет(127, 186, 255));
    Список из текст строки = Список из текст();
    перенести(с.пк_описания.получить(с.пк_выбран), 42, строки);
    целое ин = 0;
    пока (ин меньше строки.размер() и ин меньше 4)
        т(с, п_ш_ui(с), строки.получить(ин), 60, у0 + 190 + ин * 52, цвет(220, 225, 240));
        ин = ин + 1;
    конец
    заливка(п_хол(с), 20, 22, 30);
    скруглённый(п_хол(с), 40, у0 + 430, с.W - 80, 100, 16);
    т(с, п_ш_код(с), кратко("сфера_пакеты установить " + имя, 44), 64, у0 + 458, цвет(150, 230, 170));
    кнопка(с, "Скопировать команду", 40, у0 + 560, с.W - 80, 100, 1);
    кнопка(с, "Страница пакета на сайте", 40, у0 + 680, с.W - 80, 100, 0);
    вернуть 0;
конец

функция поле_ввода(Ср с, целое номер, текст подпись, текст значение, верно скрыть, целое у): целое
    т(с, п_ш_мал(с), подпись, 50, у, цвет(142, 164, 208));
    если (с.фокус_формы == номер)
        заливка(п_хол(с), 60, 130, 230);
        скруглённый(п_хол(с), 30, у + 44, с.W - 60, 104, 20);
    конец
    заливка(п_хол(с), 20, 22, 30);
    скруглённый(п_хол(с), 34, у + 48, с.W - 68, 96, 18);
    текст показ = значение;
    если (скрыть)
        показ = точки_пароля(значение);
    конец
    показ = хвост_по_ширине(с, п_ш_ui(с), показ, с.W - 140);
    т(с, п_ш_ui(с), показ, 60, у + 72, цвет(255, 255, 255));
    вернуть 0;
конец

функция вход_в_аккаунт(Ср с): целое
    целое ш = (с.W - 60) / 2;
    если (с.режим_входа == 0)
        кнопка(с, "Вход", 20, 270, ш, 90, 1);
        кнопка(с, "Регистрация", 40 + ш, 270, ш, 90, 0);
    иначе
        кнопка(с, "Вход", 20, 270, ш, 90, 0);
        кнопка(с, "Регистрация", 40 + ш, 270, ш, 90, 1);
    конец
    поле_ввода(с, 1, "Имя", с.поле_ника, нет, 390);
    поле_ввода(с, 2, "Пароль", с.поле_пароля, да, 560);
    целое низ = 730;
    если (с.режим_входа == 1)
        поле_ввода(с, 3, "Пароль ещё раз", с.поле_повтора, да, 730);
        низ = 900;
    конец
    если (длина(с.ошибка_входа) больше 0)
        т(с, п_ш_мал(с), кратко(с.ошибка_входа, 44), 50, низ, цвет(240, 120, 120));
    конец
    текст надпись = "Войти";
    если (с.режим_входа == 1)
        надпись = "Создать аккаунт";
    конец
    если (с.акк_занят больше 0 и с.акк_занят != 13)
        надпись = "Проверяю…";
        кнопка(с, надпись, 30, низ + 60, с.W - 60, 120, 0);
    иначе
        кнопка(с, надпись, 30, низ + 60, с.W - 60, 120, 2);
    конец
    если (не с.клав)
        т(с, п_ш_мал(с), "Пароль на сервер уходит только в виде хеша.", 50, низ + 220, цвет(120, 130, 155));
        т(с, п_ш_мал(с), "Аккаунт нужен, чтобы публиковать пакеты.", 50, низ + 270, цвет(120, 130, 155));
    конец
    вернуть 0;
конец

функция мои_пакеты_экран(Ср с): целое
    // список рисуем первым, карточку профиля поверх — тогда прокрутка уходит «под неё»
    целое ин = 0;
    пока (ин меньше с.мп_имена.размер())
        целое у = 640 + ин * 190 - с.пк_скр;
        если (у больше 200 и у меньше с.H - 140)
            заливка(п_хол(с), 36, 40, 56);
            скруглённый(п_хол(с), 30, у, с.W - 60, 170, 20);
            т(с, п_ш_ui(с), с.мп_имена.получить(ин), 60, у + 20, цвет(255, 255, 255));
            плашка(с, с.мп_статусы.получить(ин), с.W - 60, у + 20);
            т(с, п_ш_мал(с), "v" + с.мп_версии.получить(ин) + "  ·  " + кратко(с.мп_описания.получить(ин), 30), 60, у + 100, цвет(150, 160, 185));
        конец
        ин = ин + 1;
    конец
    если (с.мп_имена.размер() == 0)
        т(с, п_ш_ui(с), "Своих пакетов пока нет.", 60, 700, цвет(142, 164, 208));
        т(с, п_ш_мал(с), "Опубликовать пакет можно командой", 60, 760, цвет(142, 164, 208));
        т(с, п_ш_код(с), "сфера_пакеты опубликовать", 60, 810, цвет(150, 230, 170));
    конец
    заливка(п_хол(с), 24, 26, 36);
    прямоугольник(п_хол(с), 0, 250, с.W, 380);
    заливка(п_хол(с), 36, 40, 56);
    скруглённый(п_хол(с), 30, 270, с.W - 60, 270, 24);
    заливка(п_хол(с), 60, 130, 230);
    скруглённый(п_хол(с), 60, 300, 110, 110, 55);
    текст первая = "?";
    если (длина(с.ник) больше 0)
        первая = вырезать(с.ник, 0, вперёд_на_символ(с.ник, 0));
    конец
    целое пш = ширина_текста(с, п_ш_бол(с), первая);
    т(с, п_ш_бол(с), первая, 115 - пш / 2 + 0, 328, цвет(255, 255, 255));
    т(с, п_ш_бол(с), кратко(с.ник, 16), 200, 304, цвет(255, 255, 255));
    текст роль = "Автор пакетов";
    если (с.роль == "админ" или с.роль == "admin")
        роль = "Администратор";
    конец
    т(с, п_ш_мал(с), роль, 200, 372, цвет(142, 164, 208));
    целое ш = (с.W - 100) / 2;
    кнопка(с, "Кабинет", 50, 430, ш, 90, 0);
    кнопка(с, "Выйти", 70 + ш, 430, ш, 90, 3);
    т(с, п_ш_ui(с), "Мои пакеты", 40, 560, цвет(255, 255, 255));
    вернуть 0;
конец

функция экран_пакеты(Ср с): целое
    если (с.пк_режим == 0)
        каталог_пакетов(с);
    иначе если (с.вошёл)
        мои_пакеты_экран(с);
    иначе
        вход_в_аккаунт(с);
    конец
    шапка(с, "Пакеты");
    если (с.пк_режим == 0)
        кнопка(с, "Обновить", с.W - 270, 20, 240, 90, 0);
    конец
    заливка(п_хол(с), 24, 26, 36);
    прямоугольник(п_хол(с), 0, 130, с.W, 130);
    целое ш = (с.W - 60) / 2;
    текст второй = "Аккаунт";
    если (с.вошёл)
        второй = кратко(с.ник, 14);
    конец
    если (с.пк_режим == 0)
        кнопка(с, "Каталог", 20, 140, ш, 100, 1);
        кнопка(с, второй, 40 + ш, 140, ш, 100, 0);
    иначе
        кнопка(с, "Каталог", 20, 140, ш, 100, 0);
        кнопка(с, второй, 40 + ш, 140, ш, 100, 1);
    конец
    если (с.пк_выбран больше 0 - 1 и с.пк_режим == 0)
        лист_пакета(с);
    конец
    вернуть 0;
конец

функция нажатие_пакетов(Ср с, целое х, целое у): целое
    если (с.пк_выбран больше 0 - 1)
        целое у0 = с.H - 820;
        если (у меньше у0)
            с.пк_выбран = 0 - 1;
        иначе если (внутри(х, у, 40, у0 + 560, с.W - 80, 100))
            в_буфер("сфера_пакеты установить " + с.пк_имена.получить(с.пк_выбран));
            сказать(с, "Команда скопирована");
        иначе если (внутри(х, у, 40, у0 + 680, с.W - 80, 100))
            команда("am start -a android.intent.action.VIEW -d '" + адрес_страницы_пакета(с.пк_имена.получить(с.пк_выбран)) + "' > /dev/null 2>&1");
        конец
        вернуть 0;
    конец
    целое ш = (с.W - 60) / 2;
    если (внутри(х, у, 20, 140, ш, 100))
        если (с.пк_режим != 0)
            клавиатура(с, нет);
            с.фокус_формы = 0;
        конец
        с.пк_режим = 0;
        с.пк_скр = 0;
        вернуть 0;
    конец
    если (внутри(х, у, 40 + ш, 140, ш, 100))
        с.пк_режим = 1;
        с.пк_скр = 0;
        вернуть 0;
    конец
    если (с.пк_режим == 0)
        если (внутри(х, у, с.W - 270, 20, 240, 90))
            с.пк_загружены = нет;
            запросить_каталог(с);
        иначе если (с.пк_загружены и у не меньше 270 и у меньше с.H - 140)
            целое ин = (у - 270 + с.пк_скр) / 210;
            если (ин не меньше 0 и ин меньше с.пк_имена.размер() и (у - 270 + с.пк_скр) % 210 меньше 190)
                с.пк_выбран = ин;
            конец
        конец
    иначе если (с.вошёл)
        если (внутри(х, у, 50, 430, (с.W - 100) / 2, 90))
            команда("am start -a android.intent.action.VIEW -d '" + адрес_сервера() + "/" + кодировать_адрес("кабинет") + "' > /dev/null 2>&1");
        иначе если (внутри(х, у, 70 + (с.W - 100) / 2, 430, (с.W - 100) / 2, 90))
            запросить_аккаунт(с, 16, "POST", "выход", "");
        конец
    иначе
        если (внутри(х, у, 20, 270, ш, 90))
            с.режим_входа = 0;
            с.ошибка_входа = "";
