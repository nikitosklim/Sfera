                с.пк_скр = макс;
            конец
            если (с.пк_скр меньше 0)
                с.пк_скр = 0;
            конец
        конец
    иначе если (с.экран == 4)
        с.вывод_скр = с.вывод_скр - ду;
        если (с.вывод_скр меньше 0)
            с.вывод_скр = 0;
        конец
    конец
    вернуть 0;
