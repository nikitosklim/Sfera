функция отрисовать(Ср с): целое
    заливка(п_хол(с), 24, 26, 36);
    очистить_холст(п_хол(с));
    если (с.экран == 0)
        экран_главная(с);
    иначе если (с.экран == 1)
        экран_код(с);
    иначе если (с.экран == 2)
        экран_файлы(с);
    иначе если (с.экран == 3)
        экран_справка(с);
    иначе
        экран_вывод(с);
    конец
    если (не (с.экран == 1 и с.клав))
        нижняя_панель(с);
    конец
    если (с.кадр - с.тост_кадр меньше 90 и длина(с.тост) больше 0)
        целое тш = ширина_текста(с, п_ш_ui(с), с.тост);
        задать_режим_смешивания(п_хол(с), целое32(1));
        заливка_а(п_хол(с), 20, 20, 28, 235);
        скруглённый(п_хол(с), (с.W - тш) / 2 - 40, с.H - 330, тш + 80, 100, 24);
        т(с, п_ш_ui(с), с.тост, (с.W - тш) / 2, с.H - 306, цвет(255, 255, 255));
    конец
    показать_холст(п_хол(с));
    вернуть 0;
конец

