            с.нак_у = с.нак_у - с.lh;
            если (с.скр_у больше 0)
                с.скр_у = с.скр_у - 1;
            конец
        конец
        пока (с.нак_у не больше 0 - с.lh)
            с.нак_у = с.нак_у + с.lh;
            если (с.скр_у меньше число_строк(с.код) - 1)
                с.скр_у = с.скр_у + 1;
            конец
        конец
        с.нак_х = с.нак_х + дх;
        пока (с.нак_х не меньше с.cw)
            с.нак_х = с.нак_х - с.cw;
            если (с.скр_х больше 0)
                с.скр_х = с.скр_х - 1;
            конец
        конец
        пока (с.нак_х не больше 0 - с.cw)
            с.нак_х = с.нак_х + с.cw;
            с.скр_х = с.скр_х + 1;
        конец
    иначе если (с.экран == 2)
        с.файлы_скр = с.файлы_скр - ду;
        целое л = с.мои.размер();
        если (с.режим_файлов == 1)
            л = с.примеры.размер();
        конец
        целое макс = л * 160 + 270 - (с.H - 140) + 140;
        если (с.файлы_скр больше макс)
            с.файлы_скр = макс;
        конец
        если (с.файлы_скр меньше 0)
            с.файлы_скр = 0;
        конец
    иначе если (с.экран == 3)
        если (с.чит_открыт)
            с.чит_скр = с.чит_скр - ду;
            если (с.чит_скр меньше 0)
                с.чит_скр = 0;
            конец
            целое общ = 0;
            целое ин = 0;
            пока (ин меньше с.чит_строки.размер())
                целое тп = с.чит_типы.получить(ин);
                если (тп == 1)
                    общ = общ + 70;
                иначе если (тп == 2)
                    общ = общ + с.lh;
                иначе если (тп == 3)
                    общ = общ + 22;
                иначе
                    общ = общ + 46;
                конец
                ин = ин + 1;
            конец
            целое мк = общ + 150 - (с.H - 140) + 100;
            если (с.чит_скр больше мк и мк больше 0)
                с.чит_скр = мк;
            конец
        иначе
            с.справка_скр = с.справка_скр - ду;
            целое л = с.сп_имена.размер();
            если (с.режим_справки == 1)
                л = с.ур_имена.размер();
            конец
            целое макс = л * 160 + 270 - (с.H - 140) + 140;
            если (с.справка_скр больше макс)
                с.справка_скр = макс;
            конец
            если (с.справка_скр меньше 0)
                с.справка_скр = 0;
            конец
        конец
    иначе если (с.экран == 5)
        если (с.пк_выбран меньше 0)
            с.пк_скр = с.пк_скр - ду;
            целое шаг = 210;
            целое число = с.пк_имена.размер();
            целое начало = 270;
            если (с.пк_режим == 1)
                шаг = 190;
                число = с.мп_имена.размер();
                начало = 640;
            конец
            целое макс = число * шаг + начало - (с.H - 140) + 20;
