функция буква(целое б): верно
    вернуть б не меньше 128 или (б не меньше 48 и б не больше 57) или (б не меньше 65 и б не больше 90) или (б не меньше 97 и б не больше 122) или б == 95;
конец

функция сегмент(Ср с, текст строка, целое кол, целое у, беззнак32 ц): целое
    целое х = 90 + (кол - с.скр_х) * с.cw;
    если (х больше с.W)
        вернуть 0;
    конец
    если (х + длина_в_символах(строка) * с.cw больше 90)
        т(с, п_ш_код(с), строка, х, у, ц);
    конец
    вернуть 0;
конец

функция строка_подсветка(Ср с, текст ln, целое у): целое
    целое н = длина(ln);
    целое ин = 0;
    целое кол = 0;
    пока (ин меньше н)
        целое б = байт(ln, ин);
        целое к = ин;
        беззнак32 ц = цвет(220, 224, 235);
        если (б == 47 и ин + 1 меньше н и байт(ln, ин + 1) == 47)
            к = н;
            ц = цвет(110, 125, 150);
        иначе если (б == 34)
            к = ин + 1;
            пока (к меньше н и байт(ln, к) != 34)
                к = к + 1;
            конец
            если (к меньше н)
                к = к + 1;
            конец
            ц = цвет(150, 200, 120);
        иначе если (б не меньше 48 и б не больше 57)
            пока (к меньше н и ((байт(ln, к) не меньше 48 и байт(ln, к) не больше 57) или байт(ln, к) == 46))
                к = к + 1;
            конец
            ц = цвет(225, 160, 100);
        иначе если (буква(б))
            пока (к меньше н и буква(байт(ln, к)))
                к = к + 1;
            конец
            текст слово = вырезать(ln, ин, к);
            если (ключевое(слово))
                ц = цвет(200, 125, 230);
            иначе если (тип_слово(слово))
                ц = цвет(90, 190, 205);
            конец
        иначе
            к = ин + 1;
            пока (к меньше н и не буква(байт(ln, к)) и байт(ln, к) != 34 и байт(ln, к) != 47 и байт(ln, к) != 32)
                к = к + 1;
            конец
            если (б == 32)
                к = ин + 1;
                пока (к меньше н и байт(ln, к) == 32)
                    к = к + 1;
                конец
            конец
        конец
        если (к не больше ин)
            к = ин + 1;
        конец
        текст кусок = вырезать(ln, ин, к);
        если (б != 32)
            сегмент(с, кусок, кол, у, ц);
        конец
        кол = кол + длина_в_символах(кусок);
        ин = к;
    конец
    вернуть 0;
конец

функция нарисовать_редактор(Ср с): целое
    целое верх = 130 + 120;
    целое вид = видимых_строк(с);
    заливка(п_хол(с), 22, 24, 32);
    прямоугольник(п_хол(с), 0, верх, с.W, вид * с.lh + 10);
    Список из текст строки = разбить_строки(с.код);
    если (с.код == "" или (длина(с.код) больше 0 и байт(с.код, длина(с.код) - 1) == 10))
        строки.добавить("");
    конец
    целое курс_строка = строка_курсора(с);
    целое i = 0;
    пока (i меньше вид)
        целое номер = с.скр_у + i;
        если (номер меньше строки.размер())
            целое у = верх + i * с.lh;
            если (номер == курс_строка)
                заливка(п_хол(с), 34, 38, 52);
                прямоугольник(п_хол(с), 0, у, с.W, с.lh);
            конец
            строка_подсветка(с, строки.получить(номер), у);
        конец
        i = i + 1;
    конец
    // поле номеров
    заливка(п_хол(с), 30, 33, 44);
    прямоугольник(п_хол(с), 0, верх, 82, вид * с.lh + 10);
    i = 0;
    пока (i меньше вид)
        целое номер2 = с.скр_у + i;
        если (номер2 меньше строки.размер())
            т(с, п_ш_мал(с), целое_в_текст(номер2 + 1), 8, верх + i * с.lh + 6, цвет(110, 120, 140));
        конец
        i = i + 1;
    конец
    // курсор
    целое кс = курс_строка - с.скр_у;
    если (кс не меньше 0 и кс меньше вид и (с.кадр / 20) % 2 == 0)
        целое кх = 90 + (столбец_курсора(с) - с.скр_х) * с.cw;
        если (кх не меньше 90)
            заливка(п_хол(с), 110, 160, 255);
            прямоугольник(п_хол(с), кх, верх + кс * с.lh + 2, 3, с.lh - 4);
        конец
    конец
    вернуть 0;
конец

