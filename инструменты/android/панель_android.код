функция вставить_в_курсор(Ср с, текст кусок): целое
    текст левая = вырезать(с.код, 0, с.курсор);
    текст правая = вырезать(с.код, с.курсор, длина(с.код));
    с.код = левая + кусок + правая;
    с.курсор = с.курсор + длина(кусок);
    с.грязный = да;
    с.правка_кадр = с.кадр;
    вернуть 0;
конец

функция удалить_перед(Ср с): целое
    если (с.курсор больше 0)
        целое н = назад_на_символ(с.код, с.курсор);
        с.код = вырезать(с.код, 0, н) + вырезать(с.код, с.курсор, длина(с.код));
        с.курсор = н;
        с.грязный = да;
        с.правка_кадр = с.кадр;
    конец
    вернуть 0;
