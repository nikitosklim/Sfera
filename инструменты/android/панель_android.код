конец

функция вырезать(текст с, целое от, целое до): текст
    если (до не больше от)
        вернуть "";
    конец
    результат из текст р = подстрока(с, от, до - от);
    если (р.успешно)
        вернуть р.значение;
    конец
    вернуть "";
конец

функция начинается_с(текст с, текст префикс): верно
    если (длина(с) меньше длина(префикс))
        вернуть нет;
    конец
    вернуть вырезать(с, 0, длина(префикс)) == префикс;
конец

функция вперёд_на_символ(текст с, целое п): целое
    целое н = длина(с);
    если (п не меньше н)
        вернуть н;
    конец
    целое индекс = п + 1;
    пока (индекс меньше н и продолжение(байт(с, индекс)))
        индекс = индекс + 1;
    конец
    вернуть индекс;
конец

функция назад_на_символ(текст с, целое п): целое
    если (п не больше 0)
        вернуть 0;
    конец
    целое индекс = п - 1;
    пока (индекс больше 0 и продолжение(байт(с, индекс)))
        индекс = индекс - 1;
    конец
    вернуть индекс;
конец

функция символов_между(текст с, целое от, целое до): целое
    целое счёт = 0;
    целое индекс = от;
    пока (индекс меньше до)
        если (не продолжение(байт(с, индекс)))
            счёт = счёт + 1;
        конец
        индекс = индекс + 1;
    конец
    вернуть счёт;
конец

функция длина_в_символах(текст с): целое
    вернуть символов_между(с, 0, длина(с));
конец

функция сдвиг_на_символы(текст с, целое от, целое сколько, целое предел): целое
    целое п = от;
    целое k = 0;
    пока (k меньше сколько и п меньше предел)
        п = вперёд_на_символ(с, п);
        k = k + 1;
    конец
    если (п больше предел)
        вернуть предел;
    конец
    вернуть п;
конец

функция начало_строки(текст с, целое п): целое
    целое индекс = п;
    пока (индекс больше 0 и байт(с, индекс - 1) != 10)
        индекс = индекс - 1;
    конец
    вернуть индекс;
конец

функция конец_строки(текст с, целое п): целое
    целое н = длина(с);
    целое индекс = п;
    пока (индекс меньше н и байт(с, индекс) != 10)
        индекс = индекс + 1;
    конец
    вернуть индекс;
конец

// Смещение начала строки с номером «номер» (с нуля); за концом — начало последней.
функция смещение_строки(текст с, целое номер): целое
    целое н = длина(с);
    целое индекс = 0;
    целое нач = 0;
    целое строка = 0;
    пока (индекс меньше н и строка меньше номер)
        если (байт(с, индекс) == 10)
            строка = строка + 1;
            нач = индекс + 1;
        конец
        индекс = индекс + 1;
    конец
    вернуть нач;
конец

функция номер_строки(текст с, целое п): целое
    целое строка = 0;
    целое индекс = 0;
    пока (индекс меньше п)
        если (байт(с, индекс) == 10)
            строка = строка + 1;
        конец
        индекс = индекс + 1;
    конец
    вернуть строка;
конец

функция число_строк(текст с): целое
