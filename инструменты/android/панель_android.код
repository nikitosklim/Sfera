функция список_из_файла(текст путь): Список из текст
    результат из текст ч = прочитать_файл(путь);
    если (ч.успешно)
        Список из текст сырой = разбить_строки(ч.значение);
        Список из текст итог = Список из текст();
        целое ин = 0;
        пока (ин меньше сырой.размер())
            текст ст = обрезать_пробелы(сырой.получить(ин));
            если (длина(ст) больше 0)
                итог.добавить(ст);
            конец
            ин = ин + 1;
        конец
        вернуть итог;
    конец
    вернуть Список из текст();
конец

функция обновить_списки(Ср с): целое
    команда("mkdir -p " + путь_программ(с));
    команда("ls -1t " + путь_программ(с) + " > " + с.корень + "/список.txt 2>/dev/null");
    Список из текст все = список_из_файла(с.корень + "/список.txt");
    Список из текст итог = Список из текст();
    целое ин = 0;
    пока (ин меньше все.размер())
        текст имя = все.получить(ин);
        если (длина(имя) больше 7 и вырезать(имя, длина(имя) - 7, длина(имя)) == ".код")
            итог.добавить(вырезать(имя, 0, длина(имя) - 7));
        конец
        ин = ин + 1;
    конец
    с.мои = итог;
    команда("ls -1 " + с.корень + "/examples > " + с.корень + "/примеры.txt 2>/dev/null");
    Список из текст пр = список_из_файла(с.корень + "/примеры.txt");
    Список из текст итог2 = Список из текст();
    ин = 0;
    пока (ин меньше пр.размер())
        текст имя2 = пр.получить(ин);
        если (длина(имя2) больше 7 и вырезать(имя2, длина(имя2) - 7, длина(имя2)) == ".код")
            итог2.добавить(вырезать(имя2, 0, длина(имя2) - 7));
        конец
        ин = ин + 1;
    конец
    с.примеры = итог2;
    вернуть 0;
конец

функция разобрать_список(текст путь, Список из текст имена, Список из текст названия, Список из текст описания): целое
    Список из текст строки = список_из_файла(путь);
    целое ин = 0;
    пока (ин меньше строки.размер())
        Список из текст ч = разбить_по(строки.получить(ин), " | ");
        если (ч.размер() не меньше 2)
            имена.добавить(обрезать_пробелы(ч.получить(0)));
            названия.добавить(обрезать_пробелы(ч.получить(1)));
            если (ч.размер() не меньше 3)
                описания.добавить(обрезать_пробелы(ч.получить(2)));
            иначе
                описания.добавить("");
            конец
        конец
        ин = ин + 1;
    конец
    вернуть 0;
конец

функция сохранить(Ср с): целое
