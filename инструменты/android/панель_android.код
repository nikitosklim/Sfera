        Список из текст итог = Список из текст();
        итог.добавить("Сборка и запуск: " + с.имя + ".код");
        Список из текст сырые = разбить_строки(ч.значение);
        целое ин = 0;
        пока (ин меньше сырые.размер())
            перенести(сырые.получить(ин), (с.W - 60) / с.cw, итог);
            ин = ин + 1;
        конец
        с.вывод = итог;
        целое макс = итог.размер() * с.lh - (с.H - 130 - 140 - 130);
        если (макс больше 0)
            с.вывод_скр = макс;
        конец
    конец
    результат из текста г = прочитать_файл(р + "/готово.txt");
    если (г.успешно)
        с.идёт = нет;
        целое мс = сейчас() - с.старт_тик;
        с.итог_время = целое_в_текст(мс / 1000) + "." + целое_в_текст((мс % 1000) / 100) + " с";
        журнал("готово за " + с.итог_время);
    конец
    вернуть 0;
конец

