подключить графика;

функция главная() -> целое {
    инициализировать(беззнак32(32));
    инициализировать_шрифты();

    текст окно = создать_окно("Переходы между экранами", целое32(0), целое32(0), целое32(400), целое32(700), беззнак32(0));
    текст рендерер = создать_холст(окно, целое32(-1), беззнак32(2));
    задать_режим_смешивания(рендерер, целое32(1));

    // НОВОЕ: раньше был один шрифт (18) на всё — заголовок, обычный
    // текст и кнопки выглядели одинаково мелко. Три отдельных размера:
    // заголовок заметно крупнее (~3x), обычный текст тоже крупнее
    // (~2.5x), текст на кнопках — свой, чуть меньше, чтобы помещаться
    // в увеличенные, но не бесконечно широкие кнопки.
    текст шрифт_заголовок = открыть_шрифт("шрифт.ttf", целое32(56));
    текст шрифт_обычный = открыть_шрифт("шрифт.ttf", целое32(44));
    текст шрифт_кнопок = открыть_шрифт("шрифт.ttf", целое32(30));

    текст буфер_события = выделить_память(56);

    РазмерЭкрана размер = размер_окна(окно);
    android_лог(целое32(4), "SferaTest", "реальный размер окна: " + целое_в_текст(целое(размер.ширина)) + "x" + целое_в_текст(целое(размер.высота)));

    // НОВОЕ: кнопки втрое выше (было 50, стало 150) и без зазоров между
    // собой — делят реальную ширину экрана поровну, а не фиксированные
    // "120 пикселей с отступом", которые на разных экранах либо не
    // доходили до края, либо вылезали за него.
    целое32 высота_кнопки = целое32(150);
    целое32 высота_навбара = целое32(170);

    целое32 ширина_верх = размер.ширина / целое32(2);
    Кнопка кнопка_главная = Кнопка(целое32(0), целое32(10), ширина_верх, высота_кнопки, беззнак8(70), беззнак8(130), беззнак8(230), "Главная");
    Кнопка кнопка_профиль = Кнопка(ширина_верх, целое32(10), размер.ширина - ширина_верх, высота_кнопки, беззнак8(70), беззнак8(130), беззнак8(230), "Профиль");
    Список<Кнопка> верхние_кнопки = Список<Кнопка>();
    верхние_кнопки.добавить(кнопка_главная);
    верхние_кнопки.добавить(кнопка_профиль);
    Панель верхний_навбар = Панель(целое32(0), целое32(0), размер.ширина, высота_навбара, беззнак8(40), беззнак8(45), беззнак8(60), верхние_кнопки);

    целое32 ширина_низ = размер.ширина / целое32(3);
    Кнопка кнопка_лента = Кнопка(целое32(0), целое32(10), ширина_низ, высота_кнопки, беззнак8(50), беззнак8(180), беззнак8(100), "Лента");
    Кнопка кнопка_поиск = Кнопка(ширина_низ, целое32(10), ширина_низ, высота_кнопки, беззнак8(50), беззнак8(180), беззнак8(100), "Поиск");
    Кнопка кнопка_ещё = Кнопка(ширина_низ + ширина_низ, целое32(10), размер.ширина - ширина_низ - ширина_низ, высота_кнопки, беззнак8(50), беззнак8(180), беззнак8(100), "Ещё");
    Список<Кнопка> нижние_кнопки = Список<Кнопка>();
    нижние_кнопки.добавить(кнопка_лента);
    нижние_кнопки.добавить(кнопка_поиск);
    нижние_кнопки.добавить(кнопка_ещё);
    Панель нижний_навбар = Панель(целое32(0), целое32(0), размер.ширина, высота_навбара, беззнак8(30), беззнак8(35), беззнак8(45), нижние_кнопки);
    нижний_навбар.закрепить_снизу(размер, целое32(0));
    нижний_навбар.растянуть_по_ширине(размер);

    // НОВОЕ: всплывающее окно — по клику на "Ещё". Кнопка "Закрыть"
    // создаётся один раз, координаты — по центру реального экрана.
    целое32 ширина_окна = размер.ширина - целое32(60);
    целое32 высота_окна = целое32(420);
    целое32 х_окна = целое32(30);
    целое32 у_окна = (размер.высота - высота_окна) / целое32(2);
    Кнопка кнопка_закрыть_окно = Кнопка(х_окна + целое32(30), у_окна + высота_окна - целое32(110), ширина_окна - целое32(60), целое32(80), беззнак8(200), беззнак8(70), беззнак8(70), "Закрыть");
    верно показать_окно = нет;

    android_лог(целое32(4), "SferaTest", "старт: всё создано, вхожу в цикл");

    целое текущий_экран = 0;
    целое выбранная_нижняя_кнопка = 0 - 1;
    верно работает = да;
    пока (работает) {
        целое32 итог_события = опросить_событие(буфер_события);
        пока (итог_события != целое32(0)) {
            целое32 тип_события = прочитать_целое32(буфер_события, 0);
            если (тип_события == целое32(1025)) {
                целое32 х_клика = прочитать_целое32(буфер_события, 20);
                целое32 у_клика = прочитать_целое32(буфер_события, 24);

                // НОВОЕ: пока открыто всплывающее окно, клики обрабатывает
                // ТОЛЬКО оно само (кнопка "Закрыть") — иначе нажатие
                // "сквозь" модальное окно случайно переключало бы экран
                // или нижний навбар под ним.
                если (показать_окно) {
                    если (кнопка_закрыть_окно.содержит_точку(х_клика, у_клика)) {
                        показать_окно = нет;
                    }
                } иначе {
                    целое32 индекс_верх = верхний_навбар.кнопка_под_точкой(х_клика, у_клика);
                    если (индекс_верх >= целое32(0)) {
                        текущий_экран = целое(индекс_верх);
                    }
                    целое32 индекс_низ = нижний_навбар.кнопка_под_точкой(х_клика, у_клика);
                    если (индекс_низ >= целое32(0)) {
                        выбранная_нижняя_кнопка = целое(индекс_низ);
                        если (индекс_низ == целое32(2)) {
                            показать_окно = да;
                        }
                    }
                }
            }
            если (тип_события == целое32(256)) {
                работает = нет;
            }
            итог_события = опросить_событие(буфер_события);
        }

        задать_цвет(рендерер, беззнак8(245), беззнак8(245), беззнак8(248), беззнак8(255));
        очистить_холст(рендерер);

        если (текущий_экран == 0) {
            нарисовать_текст(рендерер, шрифт_заголовок, "Главная", целое32(20), высота_навбара + целое32(30), беззнак32(4278190080));
            нарисовать_текст(рендерер, шрифт_обычный, "Добро пожаловать!", целое32(20), высота_навбара + целое32(110), беззнак32(4283519313));
        } иначе {
            нарисовать_текст(рендерер, шрифт_заголовок, "Профиль", целое32(20), высота_навбара + целое32(30), беззнак32(4278190080));
            нарисовать_текст(рендерер, шрифт_обычный, "Здесь настройки", целое32(20), высота_навбара + целое32(110), беззнак32(4283519313));
        }

        если (выбранная_нижняя_кнопка == 0) {
            нарисовать_текст(рендерер, шрифт_обычный, "Нажато: Лента", целое32(20), высота_навбара + целое32(190), беззнак32(4278190080));
        } иначе если (выбранная_нижняя_кнопка == 1) {
            нарисовать_текст(рендерер, шрифт_обычный, "Нажато: Поиск", целое32(20), высота_навбара + целое32(190), беззнак32(4278190080));
        }

        верхний_навбар.нарисовать(рендерер, шрифт_кнопок);
        нижний_навбар.нарисовать(рендерер, шрифт_кнопок);

        // НОВОЕ: всплывающее окно рисуется САМЫМ ПОСЛЕДНИМ, поверх всего
        // остального — полупрозрачное затемнение всего экрана, затем
        // сама, полностью непрозрачная панель окна с текстом и кнопкой.
        если (показать_окно) {
            задать_цвет(рендерер, беззнак8(0), беззнак8(0), беззнак8(0), беззнак8(160));
            нарисовать_прямоугольник(рендерер, целое32(0), целое32(0), размер.ширина, размер.высота);

            задать_цвет(рендерер, беззнак8(255), беззнак8(255), беззнак8(255), беззнак8(255));
            нарисовать_прямоугольник(рендерер, х_окна, у_окна, ширина_окна, высота_окна);

            нарисовать_текст(рендерер, шрифт_заголовок, "Ещё", х_окна + целое32(30), у_окна + целое32(30), беззнак32(4278190080));
            нарисовать_текст(рендерер, шрифт_обычный, "Всплывающее окно.", х_окна + целое32(30), у_окна + целое32(120), беззнак32(4283519313));
            нарисовать_текст(рендерер, шрифт_обычный, "Работает!", х_окна + целое32(30), у_окна + целое32(170), беззнак32(4283519313));
            кнопка_закрыть_окно.нарисовать(рендерер, шрифт_кнопок);
        }

        показать_холст(рендерер);
        подождать(беззнак32(30));
    }

    android_лог(целое32(4), "SferaTest", "цикл завершён");

    закрыть_окно(окно);
    завершить();
    вернуть 0;
}
