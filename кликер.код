// Кликер — текстовая игра на языке Сфера. Сохраняет прогресс между
// запусками в файл "кликер_сохранение.txt" — простой текстовый формат:
// "очки\nочков_за_клик" (два числа, разделённые переводом строки).

структура Улучшение {
    текст название;
    целое цена;
    целое бонус;
}

структура СостояниеИгры {
    целое очки;
    целое очков_за_клик;
}

функция сохранить_игру(целое очки, целое очков_за_клик) -> результат<верно> {
    текст данные = целое_в_текст(очки) + "\n" + целое_в_текст(очков_за_клик);
    вернуть записать_файл("кликер_сохранение.txt", данные);
}

функция загрузить_игру() -> результат<СостояниеИгры> {
    результат<текст> файл_результат = прочитать_файл("кликер_сохранение.txt");
    если (!файл_результат.успешно) {
        вернуть ошибка(файл_результат.сообщение);
    }
    текст данные = файл_результат.значение;

    результат<целое> позиция_результат = найти(данные, "\n");
    если (!позиция_результат.успешно) {
        вернуть ошибка("повреждённый файл сохранения (нет разделителя)");
    }
    целое инд = позиция_результат.значение;

    результат<текст> текст_очков = подстрока(данные, 0, инд);
    если (!текст_очков.успешно) {
        вернуть ошибка("повреждённый файл сохранения");
    }

    целое остаток_начало = инд + 1;
    целое остаток_длина = длина(данные) - остаток_начало;
    результат<текст> текст_бонуса = подстрока(данные, остаток_начало, остаток_длина);
    если (!текст_бонуса.успешно) {
        вернуть ошибка("повреждённый файл сохранения");
    }

    результат<целое> очки_результат = текст_в_целое(текст_очков.значение);
    если (!очки_результат.успешно) {
        вернуть ошибка("повреждённый файл сохранения (очки не число)");
    }
    результат<целое> бонус_результат = текст_в_целое(текст_бонуса.значение);
    если (!бонус_результат.успешно) {
        вернуть ошибка("повреждённый файл сохранения (бонус не число)");
    }

    вернуть успех(СостояниеИгры(очки_результат.значение, бонус_результат.значение));
}

функция главная() -> целое {
    целое очки = 0;
    целое очков_за_клик = 1;

    результат<СостояниеИгры> загрузка = загрузить_игру();
    если (загрузка.успешно) {
        очки = загрузка.значение.очки;
        очков_за_клик = загрузка.значение.очков_за_клик;
        вывести("Прогресс загружен. Очки:");
        вывести(очки);
    }

    Список<Улучшение> магазин = Список<Улучшение>();
    магазин.добавить(Улучшение("Быстрые пальцы", 10, 1));
    магазин.добавить(Улучшение("Механическая клавиатура", 50, 3));
    магазин.добавить(Улучшение("Автокликер", 200, 10));

    вывести("=== Кликер ===");
    вывести("Команды: к (клик), м (магазин), с (статистика), 1/2/3 (купить улучшение), сх (сохранить), в (выход)");

    верно продолжать = да;
    пока (продолжать) {
        результат<текст> ввод = прочитать_строку();
        если (!ввод.успешно) {
            продолжать = нет;
        } иначе {
            текст команда = ввод.значение;

            если (команда == "к") {
                очки = очки + очков_за_клик;
                вывести(очки);
            } иначе если (команда == "с") {
                вывести("Очки:");
                вывести(очки);
                вывести("Очков за клик:");
                вывести(очков_за_клик);
            } иначе если (команда == "м") {
                вывести("=== Магазин ===");
                целое индекс = 0;
                пока (индекс < магазин.размер()) {
                    Улучшение у = магазин.получить(индекс);
                    вывести(у.название);
                    вывести(у.цена);
                    индекс = индекс + 1;
                }
            } иначе если (команда == "1" || команда == "2" || команда == "3") {
                результат<целое> номер_результат = текст_в_целое(команда);
                если (номер_результат.успешно) {
                    целое номер = номер_результат.значение - 1;
                    если (номер >= 0 && номер < магазин.размер()) {
                        Улучшение выбранное = магазин.получить(номер);
                        если (очки >= выбранное.цена) {
                            очки = очки - выбранное.цена;
                            очков_за_клик = очков_за_клик + выбранное.бонус;
                            вывести("Куплено:");
                            вывести(выбранное.название);
                        } иначе {
                            вывести("Не хватает очков");
                        }
                    }
                }
            } иначе если (команда == "сх") {
                результат<верно> сохранение = сохранить_игру(очки, очков_за_клик);
                если (сохранение.успешно) {
                    вывести("Прогресс сохранён");
                } иначе {
                    вывести("Не удалось сохранить прогресс:");
                    вывести(сохранение.сообщение);
                }
            } иначе если (команда == "в") {
                сохранить_игру(очки, очков_за_клик);
                продолжать = нет;
            } иначе {
                вывести("Неизвестная команда");
            }
        }
    }

    вывести("Игра окончена. Итоговые очки:");
    вывести(очки);

    вернуть 0;
}
