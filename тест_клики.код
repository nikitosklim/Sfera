// Тест обработки кликов мыши через SDL2 — реально протестирован симуляцией
// внешнего ввода через xdotool (эквивалент настоящего аппаратного клика с
// точки зрения X11/SDL2). Открывает окно и печатает координаты каждого
// клика мыши, пока окно не закроют или не истечёт время ожидания.
подключить графика;

функция главная() -> целое {
    SDL_Init(32);
    текст окно = SDL_CreateWindow("Кликер — тест кликов", 0, 0, 400, 300, 0);
    текст рендерер = SDL_CreateRenderer(окно, -1, 0);
    SDL_SetRenderDrawColor(рендерер, 30, 30, 30, 255);
    SDL_RenderClear(рендерер);
    SDL_RenderPresent(рендерер);

    текст буфер_события = malloc(64);
    целое счётчик_кликов = 0;
    верно продолжать = да;
    целое итерация = 0;

    пока (продолжать && итерация < 500) {
        целое32 есть_событие = SDL_PollEvent(буфер_события);
        если (есть_событие != целое32(0)) {
            целое32 тип_события = прочитать_целое32(буфер_события, 0);

            если (тип_события == целое32(256)) {
                вывести("Получено событие: закрытие окна");
                продолжать = нет;
            } иначе если (тип_события == целое32(1025)) {
                целое32 х = прочитать_целое32(буфер_события, 20);
                целое32 у = прочитать_целое32(буфер_события, 24);
                счётчик_кликов = счётчик_кликов + 1;
                вывести("Клик! Координаты х:");
                вывести(целое(х));
                вывести("координаты у:");
                вывести(целое(у));
            }
        }
        итерация = итерация + 1;
        SDL_Delay(20);
    }

    вывести("Всего кликов зарегистрировано:");
    вывести(счётчик_кликов);

    SDL_DestroyWindow(окно);
    SDL_Quit();

    вернуть 0;
}
