// Рисует текст на холсте в позиции (х, у) заданным шрифтом и цветом.
// Собирает воедино весь путь: рендер в поверхность -> текстура -> копия
// на холст с нужным размером (запрошенным у самой текстуры).
функция нарисовать_текст(текст холст, текст шрифт, текст строка, целое32 х, целое32 у, беззнак32 цвет) -> целое32 {
    текст поверхность = отрисовать_текст(шрифт, строка, цвет);
    текст текстура = создать_текстуру(холст, поверхность);

    текст буфер_ширины = выделить_память(4);
    текст буфер_высоты = выделить_память(4);
    узнать_размер_текстуры(текстура, нулевой_указатель(), нулевой_указатель(), буфер_ширины, буфер_высоты);
    целое32 ширина = прочитать_целое32(буфер_ширины, 0);
    целое32 высота = прочитать_целое32(буфер_высоты, 0);

    текст область_назначения = выделить_память(16);
    записать_целое32(область_назначения, 0, х);
    записать_целое32(область_назначения, 4, у);
    записать_целое32(область_назначения, 8, ширина);
    записать_целое32(область_назначения, 12, высота);

    целое32 итог = показать_текстуру(холст, текстура, нулевой_указатель(), область_назначения);

    освободить_поверхность(поверхность);
    уничтожить_текстуру(текстура);

    вернуть итог;
}

// Коды типов событий и константы, нужные для их разбора (проверены через C):
//   закрытие_окна = 256, клик_мыши = 1025, ввод_текста = 771, нажатие_клавиши = 768
// Смещения полей внутри события о клике мыши (совпадающего по началу с
// общей структурой события): тип=0, кнопка=16, состояние=17, х=20, у=24.
// Смещения полей внутри события о вводе текста: тип=0, сам текст=12 (готовая
// null-terminated UTF-8 строка — читается через прочитать_текст_по_смещению,
// не прочитать_целое32, поскольку это текст, а не число).
// Смещения полей внутри события о нажатии клавиши: тип=0, код_клавиши=20
// (Sint32 — обычное число, читается через прочитать_целое32).
// Коды специальных клавиш (не порождающих событие ввода текста):
//   backspace = 8, enter = 13, escape = 27

// НОВОЕ: строгий, табличный стиль UI (по образцу Excel/1C) — вместо ярких
// скруглённых кнопок. Произвольное число колонок (ширины — Список<целое>),
// каждая строка получает тонкую серую границу, разделители между
// колонками и чередующийся (полосатый) фон для читаемости — тот же
// приём, что в любой настоящей таблице данных.
структура Таблица {
    целое32 х;
    целое32 у;
    Список<целое> ширины_колонок;
    целое32 высота_строки;

    // Суммарная ширина всех колонок вместе — используется и для заливки
    // фона строки/заголовка, и для верхней/боковой границы таблицы.
    функция общая_ширина() -> целое32 {
        // ⚠️ НАЙДЕНО ПРИ РЕАЛЬНОМ ТЕСТИРОВАНИИ: "это.поле.метод()" — цепочка
        // доступа к полю-списку с немедленным вызовом метода — компилятор
        // пока не поддерживает (требует, чтобы каждый промежуточный шаг
        // цепочки был структурой, а Список<T> устроен иначе). Обходной путь
        // без изменений компилятора — сначала прочитать поле в локальную
        // переменную, вызывать методы уже у неё.
        Список<целое> колонки = это.ширины_колонок;
        целое32 сумма = целое32(0);
        целое индекс = 0;
        пока (индекс < колонки.размер()) {
            сумма = сумма + целое32(колонки.получить(индекс));
            индекс = индекс + 1;
        }
        вернуть сумма;
    }

    // Рисует вертикальные разделители между соседними колонками (не
    // после последней — там уже общая правая граница) — общий, частный
    // метод, используемый и заголовком, и обычными строками.
    функция нарисовать_разделители_колонок(текст холст, целое32 у_строки) -> целое32 {
        Список<целое> колонки = это.ширины_колонок;
        задать_цвет(холст, 200, 200, 200, 255);
        целое32 смещение_x = это.х;
        целое индекс = 0;
        пока (индекс < колонки.размер()) {
            смещение_x = смещение_x + целое32(колонки.получить(индекс));
            если (индекс < колонки.размер() - 1) {
                нарисовать_линию(холст, смещение_x, у_строки, смещение_x, у_строки + это.высота_строки);
            }
            индекс = индекс + 1;
        }
        вернуть целое32(0);
    }

    // Рисует одну строку данных — "значения" должен содержать РОВНО
    // столько элементов, сколько колонок в таблице. "чётная" определяет
    // чередование фона — передавай (номер_строки % 2 == 0).
    функция нарисовать_строку(текст холст, текст шрифт, целое32 номер_строки, Список<текст> значения, верно чётная) -> целое32 {
        целое32 у_строки = это.у + номер_строки * это.высота_строки;
        целое32 ширина_всего = это.общая_ширина();

        если (чётная) {
            задать_цвет(холст, 245, 245, 245, 255);
        } иначе {
            задать_цвет(холст, 255, 255, 255, 255);
        }
        нарисовать_прямоугольник(холст, это.х, у_строки, ширина_всего, это.высота_строки);

        задать_цвет(холст, 200, 200, 200, 255);
        нарисовать_линию(холст, это.х, у_строки, это.х + ширина_всего, у_строки);
        это.нарисовать_разделители_колонок(холст, у_строки);

        // Текст каждой колонки — тёмно-серый, не чисто чёрный (мягче для
        // глаз, тот же выбор, что у большинства настоящих таблиц данных).
        Список<целое> колонки = это.ширины_колонок;
        целое32 смещение_x = это.х;
        целое индекс = 0;
        пока (индекс < колонки.размер()) {
            текст значение = значения.получить(индекс);
            нарисовать_текст(холст, шрифт, значение, смещение_x + целое32(8), у_строки + целое32(6), 4282729797);
            смещение_x = смещение_x + целое32(колонки.получить(индекс));
            индекс = индекс + 1;
        }

        вернуть целое32(0);
    }

    // Рисует строку заголовка — более тёмный фон, текст белым.
    функция нарисовать_заголовок(текст холст, текст шрифт, Список<текст> заголовки) -> целое32 {
        целое32 ширина_всего = это.общая_ширина();

        задать_цвет(холст, 60, 70, 90, 255);
        нарисовать_прямоугольник(холст, это.х, это.у, ширина_всего, это.высота_строки);
        это.нарисовать_разделители_колонок(холст, это.у);

        Список<целое> колонки = это.ширины_колонок;
        целое32 смещение_x = это.х;
        целое индекс = 0;
        пока (индекс < колонки.размер()) {
            текст значение = заголовки.получить(индекс);
            нарисовать_текст(холст, шрифт, значение, смещение_x + целое32(8), это.у + целое32(6), 4294967295);
            смещение_x = смещение_x + целое32(колонки.получить(индекс));
            индекс = индекс + 1;
        }

        вернуть целое32(0);
    }
}

// НОВОЕ: первый настоящий виджет UI — кнопка. Никаких новых привязок к
// SDL2 не понадобилось: кнопка — это просто прямоугольник (уже умеем
// рисовать) плюс логика "попадает ли точка в его границы" (обычная
// арифметика самого языка Сфера). Именно так и должны строиться более
// сложные элементы интерфейса поверх низкоуровневых примитивов библиотеки.
структура Кнопка {
    целое32 х;
    целое32 у;
    целое32 ширина;
    целое32 высота;
    беззнак8 цвет_к;
    беззнак8 цвет_з;
    беззнак8 цвет_с;

    // Проверяет, попадает ли точка (например, координаты клика мыши) в
    // границы кнопки — включая левый/верхний край, исключая правый/нижний
    // (тот же принцип, что и в большинстве графических библиотек).
    функция содержит_точку(целое32 точка_х, целое32 точка_у) -> верно {
        вернуть точка_х >= это.х && точка_х < это.х + это.ширина
            && точка_у >= это.у && точка_у < это.у + это.высота;
    }

    // Рисует кнопку на холсте — заливка её цветом со скруглёнными углами
    // (современный вид вместо резких прямых углов).
    функция нарисовать(текст холст) -> целое32 {
        задать_цвет(холст, это.цвет_к, это.цвет_з, это.цвет_с, 255);
        вернуть нарисовать_скруглённый_прямоугольник(холст, это.х, это.у, это.ширина, это.высота, целое32(10));
    }
}
