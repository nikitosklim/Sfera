функция выбрать_путь_шрифта() -> текст {
    текст macos_путь = "/System/Library/Fonts/Supplemental/Arial Unicode.ttf";
    результат<текст> проверка_macos = прочитать_файл(macos_путь);
    если (проверка_macos.успешно) {
        вернуть macos_путь;
    }

    текст linux_путь = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf";
    результат<текст> проверка_linux = прочитать_файл(linux_путь);
    если (проверка_linux.успешно) {
        вернуть linux_путь;
    }

    вернуть linux_путь;
}

