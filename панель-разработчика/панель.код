// НОВОЕ: захватывает список пакетов В ФАЙЛ (а не в невидимую консоль —
// пользователь, запустивший панель двойным кликом, эту консоль вообще
// не увидит) и возвращает его содержимое одной строкой, с переносами.
функция получить_список_пакетов() -> текст {
    текст лог = "/tmp/sfera_панель_пакеты.log";
    текст команда = "cd /tmp && " + путь_установленного_сфера_пакеты() + " список > " + лог + " 2>&1";
    выполнить_команду(команда);
    результат<текст> содержимое = прочитать_файл(лог);
    если (содержимое.успешно) {
        вернуть содержимое.значение;
    }
    вернуть "Не удалось получить список пакетов.";
}

// НОВОЕ: проверяет, начинается ли "строка" ровно с "префикс" (в самом
// начале, не где угодно — в отличие от "содержит").
функция начинается_с(текст строка, текст префикс) -> верно {
    если (длина(строка) < длина(префикс)) {
        вернуть нет;
    }
    результат<текст> начало = подстрока(строка, 0, длина(префикс));
    если (начало.успешно) {
        вернуть начало.значение == префикс;
    }
    вернуть нет;
}

// НОВОЕ: разбирает текстовый вывод "сфера_пакеты список" (см. точный
// формат в показать_список, src/bin/сфера_пакеты.rs) в три параллельных
// списка — по одной записи на пакет. Опирается на точные префиксы строк
// ("  " перед именем, "    источник: "/"    описание: " перед полями) —
// тот же формат, что мы сами и печатаем, поэтому не нужен более общий,
// терпимый к ошибкам разбор.
функция разобрать_пакеты(текст вывод, Список<текст> имена, Список<текст> источники, Список<текст> описания) -> целое {
    текст остаток = вывод;
    текст текущее_имя = "";
    текст текущий_источник = "—";
    текст текущее_описание = "—";
    верно есть_текущий = нет;

    пока (длина(остаток) > 0) {
        текст строка = остаток;
        текст следующий_остаток = "";
        результат<целое> позиция_переноса = найти(остаток, "\n");
        если (позиция_переноса.успешно) {
            результат<текст> часть = подстрока(остаток, 0, позиция_переноса.значение);
            если (часть.успешно) {
                строка = часть.значение;
            }
            целое после = позиция_переноса.значение + 1;
            результат<текст> хвост = подстрока(остаток, после, длина(остаток) - после);
            если (хвост.успешно) {
                следующий_остаток = хвост.значение;
            }
        }

        если (начинается_с(строка, "    источник: ")) {
            // ⚠️ НАЙДЕННЫЙ БАГ: раньше здесь стояло жёсткое число 15 —
            // неверное, поскольку "источник"/"описание" — кириллица,
            // каждая буква 2 байта в UTF-8, реальная длина префикса 22
            // байта. Исправлено на динамический расчёт от самого текста
            // префикса — больше никогда не собьётся, даже если сам текст
            // префикса потом изменится.
            целое длина_префикса = длина("    источник: ");
            результат<текст> значение = подстрока(строка, длина_префикса, длина(строка) - длина_префикса);
            если (значение.успешно) {
                текущий_источник = значение.значение;
            }
        } иначе если (начинается_с(строка, "    описание: ")) {
            целое длина_префикса = длина("    описание: ");
            результат<текст> значение = подстрока(строка, длина_префикса, длина(строка) - длина_префикса);
            если (значение.успешно) {
                текущее_описание = значение.значение;
            }
        } иначе если (начинается_с(строка, "  ") && !начинается_с(строка, "    ") && длина(строка) > 2) {
            // Начало новой записи о пакете — сохраняем предыдущую (если
            // была) и начинаем собирать следующую.
            если (есть_текущий) {
                имена.добавить(текущее_имя);
                источники.добавить(текущий_источник);
                описания.добавить(текущее_описание);
            }
            // Пробелы однобайтовые, "2" тут технически верно, но
            // динамический расчёт для единообразия с исправлением выше.
            целое длина_отступа = длина("  ");
            результат<текст> имя_без_отступа = подстрока(строка, длина_отступа, длина(строка) - длина_отступа);
            если (имя_без_отступа.успешно) {
                текущее_имя = имя_без_отступа.значение;
            }
            текущий_источник = "—";
            текущее_описание = "—";
            есть_текущий = да;
        }

        остаток = следующий_остаток;
        если (!позиция_переноса.успешно) {
            остаток = "";
        }
    }

    если (есть_текущий) {
        имена.добавить(текущее_имя);
        источники.добавить(текущий_источник);
        описания.добавить(текущее_описание);
    }

    вернуть 0;
}

// Выводит многострочный текст (с \n внутри) построчно, начиная с
// заданной Y-координаты — графическая библиотека умеет рисовать только
// одну строку за раз, эта функция разбивает текст сама.
функция нарисовать_многострочный_текст(текст холст, текст шрифт, текст содержимое, целое32 х, целое32 начальный_у) -> целое {
    текст остаток = содержимое;
    целое32 текущий_у = начальный_у;
    целое строк_нарисовано = 0;

    пока (строк_нарисовано < 20) {
        результат<целое> позиция_переноса = найти(остаток, "\n");
        если (позиция_переноса.успешно) {
            результат<текст> строка = подстрока(остаток, 0, позиция_переноса.значение);
            если (строка.успешно) {
                нарисовать_текст(холст, шрифт, строка.значение, х, текущий_у, 4294967295);
            }
            целое следующая_позиция = позиция_переноса.значение + 1;
            // ⚠️ НАЙДЕННАЯ ОШИБКА: третий аргумент "подстрока" — это ДЛИНА
            // подстроки, а не абсолютный индекс конца, как предполагалось
            // изначально. "длина(остаток) - следующая_позиция" —
            // правильная длина оставшейся части СТРОКИ.
            целое длина_остатка = длина(остаток) - следующая_позиция;
            результат<текст> остаток_после = подстрока(остаток, следующая_позиция, длина_остатка);
            если (остаток_после.успешно) {
                остаток = остаток_после.значение;
            } иначе {
                вернуть строк_нарисовано;
            }
        } иначе {
            если (длина(остаток) > 0) {
                нарисовать_текст(холст, шрифт, остаток, х, текущий_у, 4294967295);
                строк_нарисовано = строк_нарисовано + 1;
            }
            вернуть строк_нарисовано;
        }
        текущий_у = текущий_у + целое32(22);
        строк_нарисовано = строк_нарисовано + 1;
    }

    вернуть строк_нарисовано;
}

функция главная() -> целое {
    инициализировать(32);
    инициализировать_шрифты();

    текст окно = создать_окно("Сфера — среда разработки", 0, 0, 720, 480, 0);
    текст холст = создать_холст(окно, -1, 0);
    текст шрифт = открыть_шрифт(выбрать_путь_шрифта(), 17);

    // --- Боковая панель вкладок (слева, x = 0..150) ---
    Кнопка вкладка_обзор = Кнопка(0, 0, 150, 50, 45, 45, 50);
    Кнопка вкладка_пакеты = Кнопка(0, 50, 150, 50, 45, 45, 50);
    Кнопка вкладка_документация = Кнопка(0, 100, 150, 50, 45, 45, 50);

    // --- Кнопки вкладки "Обзор" ---
    Кнопка кнопка_установить = Кнопка(170, 200, 220, 50, 60, 160, 60);
    Кнопка кнопка_удалить = Кнопка(170, 260, 220, 50, 170, 60, 60);
    Кнопка кнопка_собрать = Кнопка(170, 320, 220, 50, 60, 120, 200);
    Кнопка кнопка_обновить = Кнопка(170, 380, 260, 50, 200, 140, 40);

    // --- Кнопки вкладки "Пакеты" ---
    Кнопка кнопка_список_пакетов = Кнопка(170, 60, 220, 45, 60, 100, 200);

    // НОВОЕ: настоящая, структурированная таблица (Имя | Источник |
    // Описание) вместо голого текстового вывода — заполняется разбором
    // вывода "сфера_пакеты список" через разобрать_пакеты.
    Список<целое> ширины_колонок_пакетов = Список<целое>();
    ширины_колонок_пакетов.добавить(150);
    ширины_колонок_пакетов.добавить(160);
    ширины_колонок_пакетов.добавить(240);
    Таблица таблица_пакетов = Таблица(170, 130, ширины_колонок_пакетов, 30);

    Список<текст> заголовки_пакетов = Список<текст>();
    заголовки_пакетов.добавить("Имя");
    заголовки_пакетов.добавить("Источник");
    заголовки_пакетов.добавить("Описание");

    Список<текст> имена_пакетов = Список<текст>();
    Список<текст> источники_пакетов = Список<текст>();
    Список<текст> описания_пакетов = Список<текст>();

    // --- Кнопки вкладки "Документация" ---
    Кнопка кнопка_открыть_документацию = Кнопка(170, 300, 260, 50, 60, 160, 60);

    целое текущая_вкладка = 0;
    текст статус = "";
    верно найдено_обновление = нет;
    текст новая_версия_текст = "";
    верно продолжать = да;
    текст буфер_события = выделить_память(64);
    целое итерация = 0;

    пока (продолжать && итерация < 6000) {
        целое32 есть_событие = опросить_событие(буфер_события);
        если (есть_событие != целое32(0)) {
            целое32 тип_события = прочитать_целое32(буфер_события, 0);

            если (тип_события == целое32(256)) {
                продолжать = нет;
            } иначе если (тип_события == целое32(1025)) {
                целое32 х = прочитать_целое32(буфер_события, 20);
                целое32 у = прочитать_целое32(буфер_события, 24);

                // --- Переключение вкладок — работает независимо от того,
                // какая вкладка сейчас открыта ---
                если (вкладка_обзор.содержит_точку(х, у)) {
                    текущая_вкладка = 0;
                    статус = "";
                } иначе если (вкладка_пакеты.содержит_точку(х, у)) {
                    текущая_вкладка = 1;
                    статус = "";
                } иначе если (вкладка_документация.содержит_точку(х, у)) {
                    текущая_вкладка = 2;
                    статус = "";
                } иначе если (текущая_вкладка == 0) {
                    если (!сфера_уже_установлена() && кнопка_установить.содержит_точку(х, у)) {
                        статус = "Устанавливаю...";
                        верно установлено_успешно = установить_сферу();
                        если (установлено_успешно) {
                            статус = "Готово — Сфера установлена.";
                        } иначе {
                            статус = "Не удалось установить.";
                        }
                    } иначе если (сфера_уже_установлена() && кнопка_удалить.содержит_точку(х, у)) {
                        статус = "Удаляю...";
                        верно удалено_успешно = удалить_сферу();
                        если (удалено_успешно) {
                            статус = "Сфера удалена.";
                        } иначе {
                            статус = "Не удалось удалить.";
                        }
                    } иначе если (сфера_уже_установлена() && кнопка_собрать.содержит_точку(х, у)) {
                        статус = "Идёт сборка...";
                        текст лог_ошибки = "/tmp/sfera_панель_ошибка.log";
                        текст команда_сборки = "cd /tmp && " + путь_установленного_sfera() + " " + путь_установленного_примера() + " -c 2> " + лог_ошибки;
                        результат<целое> итог = выполнить_команду(команда_сборки);
                        если (итог.успешно && итог.значение == 0) {
                            статус = "Сборка успешна!";
                        } иначе {
                            результат<текст> содержимое_ошибки = прочитать_файл(лог_ошибки);
                            если (содержимое_ошибки.успешно && длина(содержимое_ошибки.значение) > 0) {
                                целое показать_символов = 60;
                                если (длина(содержимое_ошибки.значение) < показать_символов) {
                                    показать_символов = длина(содержимое_ошибки.значение);
                                }
                                результат<текст> обрезанная_ошибка = подстрока(содержимое_ошибки.значение, 0, показать_символов);
                                если (обрезанная_ошибка.успешно) {
                                    статус = "Ошибка: " + обрезанная_ошибка.значение;
                                }
                            } иначе {
                                статус = "Ошибка сборки.";
                            }
                        }
                    } иначе если (кнопка_обновить.содержит_точку(х, у)) {
                        если (найдено_обновление) {
                            статус = "Скачиваю и устанавливаю обновление...";
                            выполнить_команду("curl -s file:///tmp/фейковый_сервер_обновлений/новая_версия.deb -o /tmp/новое_обновление.deb");
                            результат<целое> установка = выполнить_команду("dpkg -i /tmp/новое_обновление.deb");
                            если (установка.успешно && установка.значение == 0) {
                                статус = "Обновление установлено! Версия " + новая_версия_текст;
                                найдено_обновление = нет;
                            } иначе {
                                статус = "Не удалось установить обновление.";
                            }
                        } иначе {
                            статус = "Проверяю обновления...";
                            выполнить_команду("curl -s file:///tmp/фейковый_сервер_обновлений/версия.txt -o /tmp/проверка_версии.txt");
                            результат<текст> содержимое = прочитать_файл("/tmp/проверка_версии.txt");
                            если (содержимое.успешно) {
                                результат<целое> позиция_переноса = найти(содержимое.значение, "\n");
                                текст версия_с_сервера = содержимое.значение;
                                если (позиция_переноса.успешно) {
                                    результат<текст> обрезанная = подстрока(содержимое.значение, 0, позиция_переноса.значение);
                                    если (обрезанная.успешно) {
                                        версия_с_сервера = обрезанная.значение;
                                    }
                                }
                                если (содержит(версия_с_сервера, текущая_версия())) {
                                    статус = "У тебя последняя версия.";
                                } иначе {
                                    найдено_обновление = да;
                                    новая_версия_текст = версия_с_сервера;
                                    статус = "Доступно обновление " + версия_с_сервера + "!";
                                }
                            } иначе {
                                статус = "Не удалось проверить обновления.";
                            }
                        }
                    }
                } иначе если (текущая_вкладка == 1) {
                    если (кнопка_список_пакетов.содержит_точку(х, у)) {
                        статус = "Обновляю список...";
                        имена_пакетов = Список<текст>();
                        источники_пакетов = Список<текст>();
                        описания_пакетов = Список<текст>();
                        разобрать_пакеты(получить_список_пакетов(), имена_пакетов, источники_пакетов, описания_пакетов);
                        статус = "";
                    }
                } иначе если (текущая_вкладка == 2) {
                    если (кнопка_открыть_документацию.содержит_точку(х, у)) {
                        открыть_документацию();
                        статус = "Открываю README.md...";
                    }
                }
            }
        }

        // --- Отрисовка ---
        задать_цвет(холст, 20, 20, 20, 255);
        очистить_холст(холст);

        // Боковая панель — фон чуть светлее основного, для визуального
        // разделения (в духе таблицы с "шапкой"/колонкой заголовков).
        Кнопка фон_боковой_панели = Кнопка(0, 0, 150, 480, 30, 30, 35);
        фон_боковой_панели.нарисовать(холст);

        вкладка_обзор.нарисовать(холст);
        вкладка_пакеты.нарисовать(холст);
        вкладка_документация.нарисовать(холст);
        нарисовать_текст(холст, шрифт, "Обзор", 15, 18, 4294967295);
        нарисовать_текст(холст, шрифт, "Пакеты", 15, 68, 4294967295);
        нарисовать_текст(холст, шрифт, "Документация", 15, 118, 4294967295);

        если (текущая_вкладка == 0) {
            нарисовать_текст(холст, шрифт, "Обзор языка Сфера", 170, 20, 4294967295);
            нарисовать_текст(холст, шрифт, "Версия: " + текущая_версия(), 170, 50, 4294967295);

            если (сфера_уже_установлена()) {
                нарисовать_текст(холст, шрифт, "Статус: установлено", 170, 80, 4294967295);
                нарисовать_текст(холст, шрифт, "Расположение: ~/.sfera", 170, 105, 4294967295);
                кнопка_удалить.нарисовать(холст);
                нарисовать_текст(холст, шрифт, "Удалить", 185, 275, 4294967295);
                кнопка_собрать.нарисовать(холст);
                нарисовать_текст(холст, шрифт, "Собрать привет.код", 185, 335, 4294967295);
                кнопка_обновить.нарисовать(холст);
                если (найдено_обновление) {
                    нарисовать_текст(холст, шрифт, "Установить обновление", 185, 395, 4294967295);
                } иначе {
                    нарисовать_текст(холст, шрифт, "Проверить обновления", 185, 395, 4294967295);
                }
            } иначе {
                нарисовать_текст(холст, шрифт, "Статус: не установлено", 170, 80, 4294967295);
                кнопка_установить.нарисовать(холст);
                нарисовать_текст(холст, шрифт, "Установить Сферу", 185, 215, 4294967295);
            }
        } иначе если (текущая_вкладка == 1) {
            нарисовать_текст(холст, шрифт, "Установленные пакеты", 170, 20, 4294967295);
            кнопка_список_пакетов.нарисовать(холст);
            нарисовать_текст(холст, шрифт, "Обновить список", 185, 75, 4294967295);

            если (имена_пакетов.размер() > 0) {
                таблица_пакетов.нарисовать_заголовок(холст, шрифт, заголовки_пакетов);
                целое32 строка_индекс = целое32(0);
                пока (целое(строка_индекс) < имена_пакетов.размер()) {
                    Список<текст> строка_значений = Список<текст>();
                    строка_значений.добавить(имена_пакетов.получить(целое(строка_индекс)));
                    строка_значений.добавить(источники_пакетов.получить(целое(строка_индекс)));
                    строка_значений.добавить(описания_пакетов.получить(целое(строка_индекс)));
                    верно чётная_строка = целое(строка_индекс) % 2 == 0;
                    таблица_пакетов.нарисовать_строку(холст, шрифт, строка_индекс + целое32(1), строка_значений, чётная_строка);
                    строка_индекс = строка_индекс + целое32(1);
                }
            } иначе {
                нарисовать_текст(холст, шрифт, "Нажми «Обновить список», чтобы увидеть пакеты.", 170, 130, 4282729797);
            }
        } иначе если (текущая_вкладка == 2) {
            нарисовать_текст(холст, шрифт, "Документация", 170, 20, 4294967295);
            нарисовать_текст(холст, шрифт, "Язык программирования «Сфера» — полностью", 170, 55, 4294967295);
            нарисовать_текст(холст, шрифт, "кириллический синтаксис, компиляция в машинный", 170, 77, 4294967295);
            нарисовать_текст(холст, шрифт, "код через LLVM, автоматический подсчёт ссылок (ARC).", 170, 99, 4294967295);
            нарисовать_текст(холст, шрифт, "Полное описание возможностей — в файле README.md", 170, 130, 4294967295);
            нарисовать_текст(холст, шрифт, "в папке проекта.", 170, 152, 4294967295);
            кнопка_открыть_документацию.нарисовать(холст);
            нарисовать_текст(холст, шрифт, "Открыть README", 185, 315, 4294967295);
        }

        нарисовать_текст(холст, шрифт, статус, 170, 440, 4294967295);
        показать_холст(холст);

        итерация = итерация + 1;
        подождать(20);
    }

    закрыть_окно(окно);
    завершить();

    вернуть 0;
}
