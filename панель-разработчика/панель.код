функция установить_сферу() -> верно {
    текст папка_bin = домашняя_папка() + "/.sfera/bin";
    текст папка_share = домашняя_папка() + "/.sfera/share";
    текст встроенный_bin = путь_встроенного_бандла();

    текст команда = "mkdir -p '" + папка_bin + "' '" + папка_share + "' && "
        + "cp '" + встроенный_bin + "/sfera' '" + папка_bin + "/sfera' && "
        + "cp '" + встроенный_bin + "/сфера_lsp' '" + папка_bin + "/сфера_lsp' && "
        + "cp '" + встроенный_bin + "/сфера_пакеты' '" + папка_bin + "/сфера_пакеты' && "
        + "cp '" + встроенный_bin + "/привет.код' '" + папка_share + "/привет.код' && "
        + "chmod +x '" + папка_bin + "/sfera' '" + папка_bin + "/сфера_lsp' '" + папка_bin + "/сфера_пакеты'";

    результат<целое> итог = выполнить_команду(команда);
    вернуть итог.успешно && итог.значение == 0;
}

// НОВОЕ: удаление — обратная операция, полностью убирает папку установки.
функция удалить_сферу() -> верно {
    текст команда = "rm -rf '" + путь_папки_установки() + "'";
    результат<целое> итог = выполнить_команду(команда);
    вернуть итог.успешно && итог.значение == 0;
}

