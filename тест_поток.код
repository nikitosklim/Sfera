внешняя функция подождать_секунды(беззнак32 секунды) как "sleep";

функция сообщить_из_потока() -> целое {
    вывести("Привет из параллельного потока!");
    вернуть 0;
}

функция главная() -> целое {
    вывести("Начало главной функции");

    параллельно {
        сообщить_из_потока();
    }

    вывести("Главная функция продолжает работать сразу же");
    подождать_секунды(1);
    вывести("Главная функция завершается");

    вернуть 0;
}
