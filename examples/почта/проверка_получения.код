подключить почта_получение;

функция главная(): целое
    Ящик я = ящик_открыть("localhost", 9993, "/tmp/mail/c.pem", "pochta", "пароль_теста");
    если ( не я.открыт)
        вывести("ошибка: " + я.сбой);
        вернуть 1;
    конец
    вывести("писем в ящике: " + целое_в_текст(я.писем));
    Список из ПисьмоВСписке список = ящик_список(я, 0);
    для каждого п в список
        текст метка = "новое";
        если (п.прочитано)
            метка = "прочитано";
        конец
        вывести("#" + целое_в_текст(п.номер) + " код=" + целое_в_текст(п.код) + " [" + метка + "] " + п.от_кого + " | " + п.тема + " | " + п.дата + " | " + целое_в_текст(п.размер) + " байт");
    конец
    Письмо письмо = ящик_письмо(я, 3);
    вывести("письмо 3: " + письмо.тема + " — вложений " + целое_в_текст(письмо.вложения.размер()));
    вывести("тело: " + письмо.тело);
    освободить_письмо(письмо);
    ящик_прочитано(я, 1);
    ящик_закрыть(я);
    вернуть 0;
конец
