// Проверка папок на тестовом сервере (см. README): список, названия, создание, добавление, перенос, очистка.
подключить почта_папки;

функция главная(): целое
    вывести(папка_закодировать("Работа") + " | " + папка_раскодировать(папка_закодировать("Работа")));
    вывести(папка_закодировать("Мои & чужие") + " | " + папка_раскодировать(папка_закодировать("Мои & чужие")));
    вывести(папка_раскодировать("&BBAEQAQ4BDIEPgRC-"));
    Ящик я = ящик_открыть("localhost", 9993, "/tmp/mail/c.pem", "pochta", "пароль_теста");
    если ( не я.открыт)
        вывести("ошибка: " + я.сбой);
        вернуть 1;
    конец
    ящик_создать_папку(я, "Работа");
    Список из Папка папки = ящик_папки(я);
    для каждого п в папки
        вывести("папка: " + п.показ + " (" + п.имя + ", вид " + целое_в_текст(п.вид) + ", разделитель «" + п.разделитель + "»)");
    конец
    верно ок = ящик_добавить(я, "Sent", "From: a@b.c\r\nTo: Кому Угодно <komu@example.org>\r\nSubject: Проба\r\n\r\nтело\r\n");
    если (ок)
        вывести("добавлено в Sent");
    иначе
        вывести("не добавлено: " + я.сбой);
    конец
    Список из целых статус = ящик_статус(я, "INBOX");
    вывести("INBOX: всего " + целое_в_текст(статус.получить(0)) + ", непрочитанных " + целое_в_текст(статус.получить(1)));
    ящик_выбрать(я, "Sent");
    вывести("в Sent писем: " + целое_в_текст(я.писем));
    Список из ПисьмоВСписке л = ящик_список(я, 0);
    для каждого х в л
        вывести("  " + х.тема + " uid=" + целое_в_текст(х.код) + ", кому: " + х.кому);
        ящик_переместить(я, х.код, "Trash");
    конец
    ящик_выбрать(я, "Trash");
    вывести("в Trash писем: " + целое_в_текст(я.писем) + ", проверка: " + целое_в_текст(ящик_проверка(я)));
    ящик_очистить_папку(я);
    ящик_выбрать(я, "Trash");
    вывести("после очистки в Trash: " + целое_в_текст(я.писем));
    ящик_закрыть(я);
    вернуть 0;
конец
