подключить почта_письмо;

функция показать(текст путь)
    результат из текста с = прочитать_файл(путь)
    если ( не с.успешно)
        вывести("нет файла " + путь)
        вернуть
    конец
    Письмо п = разобрать_письмо(с.значение)
    вывести("--- " + путь)
    вывести("от: " + п.от_кого)
    вывести("кому: " + п.кому)
    вывести("тема: " + п.тема)
    вывести("дата: " + п.дата)
    вывести("тело: [" + п.тело + "]")
    для каждого вл в п.вложения
        вывести("вложение: " + вл.имя + " " + вл.тип + " " + целое_в_текст(вл.размер) + " байт")
    конец
    освободить_письмо(п)
конец

функция главная(): целое
    показать("образцы/1.eml")
    показать("образцы/2.eml")
    показать("образцы/3.eml")
    показать("образцы/4.eml")
    показать("образцы/5.eml")
    показать("образцы/6.eml")
    показать("образцы/7.eml")
    вернуть 0
конец
