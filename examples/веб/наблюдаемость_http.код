подключить сеть;
подключить метрики;
подключить трейсинг;

// Отдаёт снимки метрик и трейсинга по HTTP — естественный следующий шаг,
// о котором честно сказано и в метрики.код, и в трейсинг.код: локальный
// текстовый снимок сам по себе полезен, но настоящая ценность появляется,
// когда его можно СОБРАТЬ снаружи — например, настоящим Prometheus-
// сервером (для /metrics — тем же самым текстовым форматом, который он
// умеет читать без переделки) или просто открыв ссылку в браузере/curl
// (для /trace — человекочитаемый текст дерева спанов).
//
//   GET /         — простая HTML-страница со ссылками на /metrics и /trace
//   GET /metrics  — снимок метрики_снимок(...) в формате Prometheus
//                    (Content-Type: text/plain; version=0.0.4 — тот самый
//                    заголовок, по которому Prometheus узнаёт формат)
//   GET /trace    — снимок трейс_снимок(...), дерево уже завершённых
//                    спанов по всем обработанным до этого запросам
//
// ⚠️ Честное, сознательное упрощение по сравнению с examples/веб/
// http_сервер.код: ТАМ каждое подключение обрабатывается в своём потоке
// ("параллельно"), ЗДЕСЬ — строго ОДНО ЗА ДРУГИМ, без параллельности.
// Причина — не лень, а прямое следствие уже честно задокументированного
// ограничения в самих метрики.код/трейсинг.код: "Метрики"/"Трейсер", как
// и Список/Словарь, НЕ потокобезопасны — параллельная запись в общий
// Метрики/Трейсер из нескольких потоков была бы гонкой данных (могла бы
// незаметно портить счётчики или даже крашить программу). Сделать это
// безопасным можно (например, через один выделенный поток-владелец
// метрик и канал для запросов на обновление, как уже сделано для
// передачи номера сокета в http_сервер.код) — это отдельный, более
// сложный следующий шаг, сознательно не взятый здесь ради ясности
// примера.
функция главная() -> целое {
    целое32 слушающий_сокет = создать_сокет(целое32(2), целое32(1), целое32(0));
    если (слушающий_сокет < целое32(0)) {
        вывести("не удалось создать сокет");
        вернуть 1;
    }

    текст включено = выделить_память(4);
    записать_целое32(включено, 0, целое32(1));
    настроить_сокет(слушающий_сокет, целое32(1), целое32(2), включено, целое32(4));

    текст адрес = построить_адрес_сервера("0.0.0.0", целое32(9090));
    целое32 итог_привязки = привязать_сокет(слушающий_сокет, адрес, целое32(16));
    если (итог_привязки < целое32(0)) {
        вывести("не удалось занять порт 9090 — возможно, уже занят");
        вернуть 1;
    }

    слушать_сокет(слушающий_сокет, целое32(10));
    вывести("наблюдаемость: http://0.0.0.0:9090/metrics и http://0.0.0.0:9090/trace");

    Метрики м = создать_метрики();
    Трейсер т = создать_трейсер();

    целое кадр = 0;
    пока (кадр < 50) {
        целое32 клиент = принять_подключение(слушающий_сокет, нулевой_указатель_сети(), нулевой_указатель_сети());
        если (клиент >= целое32(0)) {
            обработать_подключение(м, т, клиент);
        }
        кадр = кадр + 1;
    }

    закрыть_сокет(слушающий_сокет);
    вернуть 0;
}

функция обработать_подключение(Метрики м, Трейсер т, целое32 клиент) {
    спан_начать(т, "http_запрос");

    текст буфер_запроса = выделить_память(2048);
    получить_данные(клиент, буфер_запроса, 2047, целое32(0));
    текст путь = извлечь_путь(буфер_запроса);
    вывести("запрос: " + путь);

    спан_начать(т, "маршрутизация");
    текст ответ = обработать_запрос(м, т, путь);
    спан_завершить(т);

    отправить_данные(клиент, ответ, длина(ответ), целое32(0));

    закрыть_сокет(клиент);
    освободить_память(буфер_запроса);

    спан_завершить(т);
}

функция обработать_запрос(Метрики м, Трейсер т, текст путь) -> текст {
    счётчик_увеличить_на_единицу(м, "http_запросов_всего");

    если (путь == "/") {
        счётчик_увеличить_на_единицу(м, "http_запросов_главная");
        вернуть сформировать_ответ(целое32(200), "OK", "text/html; charset=utf-8",
            "<html><body><h1>Наблюдаемость «Сферы»</h1>" +
            "<p><a href=\"/metrics\">/metrics</a> — снимок метрик (формат Prometheus)</p>" +
            "<p><a href=\"/trace\">/trace</a> — дерево трейсинга уже обработанных запросов</p>" +
            "</body></html>");
    }

    если (путь == "/metrics") {
        счётчик_увеличить_на_единицу(м, "http_запросов_metrics");
        // "version=0.0.4" — тот самый заголовок, по которому настоящий
        // Prometheus-сервер узнаёт формат тела ответа (Prometheus text
        // exposition format) и понимает, что можно скрейпить как есть,
        // без дополнительной настройки на его стороне.
        вернуть сформировать_ответ(целое32(200), "OK", "text/plain; version=0.0.4; charset=utf-8",
            метрики_снимок(м));
    }

    если (путь == "/trace") {
        счётчик_увеличить_на_единицу(м, "http_запросов_trace");
        текст снимок = трейс_снимок(т);
        если (длина(снимок) == 0) {
            снимок = "(пока нет ни одного завершённого запроса — снимок появится после первого)\n";
        }
        вернуть сформировать_ответ(целое32(200), "OK", "text/plain; charset=utf-8", снимок);
    }

    счётчик_увеличить_на_единицу(м, "http_запросов_404");
    вернуть сформировать_ответ(целое32(404), "Not Found", "text/html; charset=utf-8",
        "<html><body><h1>404</h1><p>Страница не найдена.</p></body></html>");
}

функция сформировать_ответ(целое32 код, текст статус, текст тип_содержимого, текст тело) -> текст {
    вернуть "HTTP/1.1 " + целое_в_текст(целое(код)) + " " + статус +
        "\r\nContent-Type: " + тип_содержимого + "\r\nContent-Length: " +
        целое_в_текст(длина(тело)) + "\r\nConnection: close\r\n\r\n" + тело;
}

// Та же самая логика, что и в examples/веб/http_сервер.код — продублирована
// здесь намеренно (не "подключить http_сервер;"): у него своя функция
// "главная", при подключении оба верхнеуровневых объявления попали бы в
// одно общее пространство имён и столкнулись бы — та же честная граница
// языка, что уже описана в ДОКУМЕНТАЦИЯ_ЯЗЫКА.md про "подключить".
функция извлечь_путь(текст запрос) -> текст {
    результат<целое> первый_пробел = найти(запрос, " ");
    если (!первый_пробел.успешно) {
        вернуть "/";
    }
    целое начало_пути = первый_пробел.значение + 1;

    результат<текст> остаток_результат = подстрока(запрос, начало_пути, длина(запрос) - начало_пути);
    если (!остаток_результат.успешно) {
        вернуть "/";
    }
    текст остаток = остаток_результат.значение;

    результат<целое> второй_пробел = найти(остаток, " ");
    если (!второй_пробел.успешно) {
        вернуть "/";
    }

    результат<текст> путь_результат = подстрока(остаток, 0, второй_пробел.значение);
    если (путь_результат.успешно) {
        вернуть путь_результат.значение;
    }
    вернуть "/";
}
