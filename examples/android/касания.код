// Игра «Поймай шар» для Android: шары падают сверху, нужно коснуться их пальцем.
// Собрать приложение для телефона:
//   сфера собрать-android examples/android/касания.код --имя "Поймай шар"
// На компьютере запускается в окне:  запустить касания.код --линковать SDL2 --линковать SDL2_ttf --линковать m

подключить приложение_android;

функция главная(): целое
    Приложение п = начать_приложение(40);
    целое шар_х = п.ширина / 2;
    целое шар_у = 0 - 60;
    целое скорость = 6;
    целое счёт = 0;
    целое промахи = 0;
    целое зерно = 12345;

    пока (п.работает)
        целое ев = ждать_событие(п);
        пока (ев != 0)
            если (ев == 1)
                целое dx = п.х - шар_х;
                целое dy = п.у - шар_у;
                если (dx * dx + dy * dy меньше 90 * 90)
                    счёт = счёт + 1;
                    скорость = 6 + счёт / 5;
                    шар_у = 0 - 60;
                    зерно = (зерно * 1103515245 + 12345) % 2147483648;
                    шар_х = 80 + зерно % (п.ширина - 160);
                конец
            конец
            ев = ждать_событие(п);
        конец

        шар_у = шар_у + скорость;
        если (шар_у больше п.высота + 60)
            промахи = промахи + 1;
            шар_у = 0 - 60;
            зерно = (зерно * 1103515245 + 12345) % 2147483648;
            шар_х = 80 + зерно % (п.ширина - 160);
        конец

        начать_кадр(п, 18, 22, 40);
        круг(п, шар_х, шар_у, 70, 255, 170, 40);
        круг(п, шар_х, шар_у, 40, 255, 220, 120);
        написать(п, "Поймано: " + целое_в_текст(счёт), 40, 60, 255, 255, 255);
        написать(п, "Упущено: " + целое_в_текст(промахи), 40, 120, 200, 200, 220);
        если (п.нажато)
            круг(п, п.х, п.у, 24, 80, 200, 255);
        конец
        показать_кадр(п);
    конец
    закончить_приложение(п);
    вернуть 0;
конец
