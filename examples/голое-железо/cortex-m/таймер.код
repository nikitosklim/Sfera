подключить голое_железо;
подключить плата_cortex_m_mps2;

// Обработчик прерывания системного таймера. Процессор сам сохраняет и
// восстанавливает регистры, поэтому это обычная функция Сферы.
// Счётчик живёт по фиксированному адресу в памяти.
функция sfera_systick()
    аппаратная_запись32(0x20700000, аппаратное_чтение32(0x20700000) + беззнак32(1));
конец

функция главная(): целое
    sfera_плата_старт();
    аппаратная_запись32(0x20700000, беззнак32(0));
    аппаратная_запись32(0xE000E014, беззнак32(99999));  // период: 100000 тактов
    аппаратная_запись32(0xE000E018, беззнак32(0));
    аппаратная_запись32(0xE000E010, беззнак32(7));      // включить таймер и его прерывания
    целое пройдено = 0;
    пока (пройдено < 5)
        пока (целое(аппаратное_чтение32(0x20700000)) <= пройдено)
            машинная_команда("wfi");
        конец
        пройдено = пройдено + 1;
        вывести("тик %пройдено%");
    конец
    вывести("таймер работает");
    вернуть 0;
конец
