// тест_автономно.код — первая программа на языке Сфера, работающая
// ПОЛНОСТЬЮ без операционной системы под собой в привычном смысле — без
// единого байта libc. Вывод текста идёт напрямую через системный вызов
// write (см. минимальный_рантайм.s), а точка входа — самостоятельно
// написанная "_start", а не привычная libc-цепочка.

внешняя функция вывести_напрямую(целое32 fd, текст буфер, целое количество_байт) -> целое как "sfera_write";

функция главная() -> целое {
    текст сообщение = "Привет из автономного режима — без единого байта libc!\n";
    вывести_напрямую(1, сообщение, длина(сообщение));
    вернуть 0;
}
