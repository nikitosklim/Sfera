// Вывод в последовательный порт COM1 и прямая запись в экран — без единого вызова libc.
подключить железо_х86;

функция послать_байт(беззнак8 б)
    порт_вывод8(0x3F8, б);
конец

функция послать_цифры(беззнак32 ч)
    беззнак32 делитель = беззнак32(1000000000);
    беззнак8 начато = беззнак8(0);
    пока (делитель > беззнак32(0))
        беззнак32 цифра = ч / делитель;
        ч = ч - цифра * делитель;
        делитель = делитель / беззнак32(10);
        если (цифра > беззнак32(0) или начато == беззнак8(1) или делитель == беззнак32(0))
            послать_байт(беззнак8(48) + беззнак8(цифра));
            начато = беззнак8(1);
        конец
    конец
конец

функция главная(): целое
    послать_байт(беззнак8(72));
    послать_байт(беззнак8(105));
    послать_байт(беззнак8(32));
    послать_цифры(беззнак32(4000000000));
    послать_байт(беззнак8(10));
    // экран: символ «S» (0x53) зелёным (0x0A) в левом верхнем углу
    аппаратная_запись16(0xB8000, 0x0A53);
    остановиться_навсегда();
    вернуть 0;
конец
