/* компоновка_ядра.ld — говорит линковщику, куда положить каждую секцию.
 * 1 МБ — стандартный, общепринятый адрес загрузки для multiboot-ядер
 * (ниже этого адреса на реальном железе часто занято BIOS/видеопамятью
 * и прочими зарезервированными областями).
 */
ENTRY(_start)

SECTIONS
{
    . = 1M;

    .multiboot : {
        *(.multiboot)
    }

    .text : {
        *(.text)
    }

    .bss : {
        *(.bss)
    }
}
