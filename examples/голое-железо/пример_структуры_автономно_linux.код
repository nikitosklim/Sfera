// тест_структуры_автономно.код — проверка того, что структуры (а значит
// и весь ARC) реально работают в автономном режиме, используя
// распределитель памяти, написанный полностью на самом языке Сфера.
// ⚠️ malloc/free находятся прямо здесь, не подключены отдельно — см.
// честное объяснение в арена_распределитель.код (манглирование имён при
// "подключить" не даёт ARC найти их по буквальному имени).
внешняя функция адрес_арены() -> текст как "sfera_адрес_арены";
внешняя функция вывести_напрямую(целое32 fd, текст буфер, целое количество_байт) -> целое как "sfera_write";

функция malloc(целое размер) -> текст {
    текст база = адрес_арены();
    целое32 смещение = прочитать_целое32(база, 0);
    текст итоговый_адрес = прочитать_текст_по_смещению(база, целое(смещение));
    целое32 новое_смещение = смещение + целое32(размер);
    записать_целое32(база, 0, новое_смещение);
    вернуть итоговый_адрес;
}

функция free(текст указатель) {
    // Намеренно пусто — bump allocator не освобождает по-настоящему.
}

структура Точка {
    целое х;
    целое у;
}

функция главная() -> целое {
    Точка точка = Точка(10, 20);

    текст сообщение = "Структура в автономном режиме реально работает!\n";
    вывести_напрямую(1, сообщение, длина(сообщение));

    вернуть точка.х + точка.у;
}
