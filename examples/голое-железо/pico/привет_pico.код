// Привет с Raspberry Pi Pico: текст в UART0 (GP0) и мигание светодиода на плате (GP25).
// НА НАСТОЯЩЕЙ ПЛАТЕ НЕ ПРОВЕРЯЛОСЬ.
подключить голое_железо;
подключить дробные_программно;
подключить плата_rp2040;

функция пауза(целое круги)
    целое i = 0;
    пока (i < круги)
        машинная_команда("nop");
        i = i + 1;
    конец
конец

функция главная(): целое
    sfera_плата_старт();
    вывести("Привет, Pico! Мы пишем на Сфере.");
    аппаратная_запись32(0x400140CC, беззнак32(5));    // GP25 → управление от SIO
    аппаратная_запись32(0xD0000024, беззнак32(33554432));  // GP25 — выход (бит 25)
    целое раз = 0;
    пока (да)
        аппаратная_запись32(0xD000001C, беззнак32(33554432));  // переключить светодиод
        раз = раз + 1;
        вывести("мигнули раз: %раз%");
        пауза(600000);
    конец
    вернуть 0;
конец
