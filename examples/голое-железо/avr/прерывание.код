// Таймер 1 вызывает прерывание каждые 0,1 с; обработчик переключает светодиод.
функция прерывание_таймер1_сравнение_а()
    аппаратная_запись8(0x25, переключить_биты(аппаратное_чтение8(0x25), беззнак8(32)))
конец

функция главная(): целое
    аппаратная_запись8(0x24, беззнак8(32))              // DDRB: PB5 — выход
    аппаратная_запись8(0x80, беззнак8(0))               // TCCR1A
    аппаратная_запись16(0x88, беззнак16(1561))          // OCR1A: 1562 такта при делителе 1024 = 0,1 с
    аппаратная_запись8(0x81, беззнак8(13))              // TCCR1B: режим CTC, делитель 1024
    аппаратная_запись8(0x6F, беззнак8(2))               // TIMSK1: прерывание по совпадению A
    машинная_команда("sei")
    пока (да)
        машинная_команда("nop")
    конец
    вернуть 0
конец
