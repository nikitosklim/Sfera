// Мигалка для Arduino Uno/Nano: светодиод на плате (вывод D13 = бит 5 порта B).
// Сборка:  запустить мигалка.код --только-собрать --без-ос --целевая-платформа avr

функция пауза(целое32 круги)
    целое32 i = целое32(0)
    пока (i < круги)
        машинная_команда("nop")
        i = i + целое32(1)
    конец
конец

функция главная(): целое
    аппаратная_запись8(0x24, беззнак8(32))        // DDRB: вывод PB5 — выход
    пока (да)
        аппаратная_запись8(0x25, беззнак8(32))    // PORTB: включить светодиод
        пауза(целое32(100000))
        аппаратная_запись8(0x25, беззнак8(0))     // выключить
        пауза(целое32(100000))
    конец
    вернуть 0
конец
