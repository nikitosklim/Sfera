// Стадии голоса: 0 свободен, 1 атака, 2 удержание, 3 затухание.
// Данные голосов (номер голоса — индекс). Их читает и прерывание, и основной цикл.
беззнак32(4) фаза = массив(0, 0, 0, 0)       // положение внутри периода волны
беззнак32(4) шаг = массив(0, 0, 0, 0)        // на сколько фаза сдвигается за отсчёт (высота ноты)
беззнак16(4) огибающая = массив(0, 0, 0, 0)  // громкость 0..65535
беззнак8(4) усиление = массив(0, 0, 0, 0)    // огибающая с учётом силы нажатия, 0..255
беззнак8(4) стадия = массив(0, 0, 0, 0)
беззнак8(4) нота = массив(0, 0, 0, 0)
беззнак8(4) сила = массив(0, 0, 0, 0)        // сила нажатия 0..127
беззнак8(4) возраст = массив(0, 0, 0, 0)     // для вытеснения самой старой ноты

беззнак8 форма = 0                  // 0 пила, 1 прямоугольник, 2 треугольник, 3 синус
беззнак8 яркость = 255              // 1..255: чем больше, тем ярче звук
беззнак16 шаг_атаки = 65535
беззнак16 шаг_затухания = 2048
целое16 память_фильтра = 0
беззнак8 такт = 0
беззнак16 время = 0                 // растёт 2500 раз в секунду
беззнак8 счётчик_возраста = 0

// MIDI
беззнак8 команда = 0
беззнак8(2) байты = массив(0, 0)
беззнак8 принято = 0

беззнак16(4) сглаженные = массив(512, 512, 512, 512)

// Умножение (целое16 * беззнак8) >> 8 без медленной 32-битной арифметики.
функция умножить_сдвинуть8(целое16 а, беззнак8 к): целое16
    целое8 старший = целое8(сдвинуть_вправо(а, 8))
    беззнак8 младший = беззнак8(а)
    вернуть целое16(старший) * целое16(к) + целое16(сдвинуть_вправо(беззнак16(младший) * беззнак16(к), 8))
конец

// Отсчёт одного голоса по восьми верхним битам фазы.
функция отсчёт(беззнак8 т): целое16
    если (форма == 0)
        вернуть целое16(целое8(т))
    конец
    если (форма == 1)
        если (т < 128)
            вернуть 127
        конец
        вернуть -127
    конец
    если (форма == 2)
        беззнак8 х = т
        если (наложить_маску(т, 128) != 0)
            х = инвертировать_биты(т)
        конец
        вернуть целое16(сдвинуть_влево(х, 1)) - 127
    конец
    вернуть целое16(синус[т])
конец

// Огибающая одного голоса (вызывается редко).
функция обновить_голос(беззнак8 инд)
    если (стадия[инд] == 1)
        если (огибающая[инд] > 65535 - шаг_атаки)
            огибающая[инд] = 65535
            стадия[инд] = 2
        иначе
            огибающая[инд] = огибающая[инд] + шаг_атаки
        конец
    конец
    если (стадия[инд] == 3)
        если (огибающая[инд] < шаг_затухания)
            огибающая[инд] = 0
            стадия[инд] = 0
        иначе
            огибающая[инд] = огибающая[инд] - шаг_затухания
        конец
    конец
    усиление[инд] = беззнак8(сдвинуть_вправо(беззнак16(сдвинуть_вправо(огибающая[инд], 8)) * беззнак16(сила[инд] + 1), 7))
конец

// Главный цикл звука: вызывается 20000 раз в секунду (таймер 2).
функция прерывание_таймер2_сравнение_а()
    целое16 сумма = 0
    беззнак8 инд = 0
    пока (инд < 4)
        если (стадия[инд] != 0)
            фаза[инд] = фаза[инд] + шаг[инд]
            беззнак8 т = беззнак8(сдвинуть_вправо(фаза[инд], 24))
            сумма = сумма + сдвинуть_вправо(отсчёт(т) * целое16(усиление[инд]), 8)
        конец
        инд = инд + 1
    конец
    // Фильтр низких частот (один полюс).
    целое16 разность = сдвинуть_влево(сумма, 5) - память_фильтра
    память_фильтра = память_фильтра + умножить_сдвинуть8(разность, яркость)
    аппаратная_запись8(0x88, беззнак8(сдвинуть_вправо(память_фильтра, 7) + 128))
    // Огибающие обновляем редко: каждый голос раз в 32 отсчёта.
    такт = такт + 1
    если (наложить_маску(такт, 7) == 0)
        время = время + 1
        обновить_голос(наложить_маску(сдвинуть_вправо(такт, 3), 3))
    конец
конец

// ---- Управление голосами (из основного цикла) ----
функция включить_ноту(беззнак8 н, беззнак8 громкость)
    если (н > 127)
        вернуть
    конец
    целое16 выбран = -1
    машинная_команда("cli")
    // 1) голос, на котором эта нота уже звучит; 2) свободный; 3) самый старый
    беззнак8 инд = 0
    пока (инд < 4)
        если (выбран < 0 и стадия[инд] != 0 и нота[инд] == н)
            выбран = целое16(инд)
        конец
        инд = инд + 1
    конец
    инд = 0
    пока (инд < 4)
        если (выбран < 0 и стадия[инд] == 0)
            выбран = целое16(инд)
        конец
        инд = инд + 1
    конец
    если (выбран < 0)
        беззнак8 лучший = 0
        беззнак8 наибольшая = 0
        инд = 0
        пока (инд < 4)
            беззнак8 разница = счётчик_возраста - возраст[инд]
            если (разница >= наибольшая)
                наибольшая = разница
                лучший = инд
            конец
            инд = инд + 1
        конец
        выбран = целое16(лучший)
    конец
    беззнак8 г = беззнак8(выбран)
    нота[г] = н
    сила[г] = громкость
    шаг[г] = шаги_нот[н]
    если (стадия[г] == 0)
        фаза[г] = 0
        огибающая[г] = 0
        усиление[г] = 0
    конец
    стадия[г] = 1
    счётчик_возраста = счётчик_возраста + 1
    возраст[г] = счётчик_возраста
    машинная_команда("sei")
конец

функция выключить_ноту(беззнак8 н)
    машинная_команда("cli")
    беззнак8 инд = 0
    пока (инд < 4)
        если (стадия[инд] != 0 и стадия[инд] != 3 и нота[инд] == н)
            стадия[инд] = 3
        конец
        инд = инд + 1
    конец
    машинная_команда("sei")
конец

функция выключить_все_ноты()
    машинная_команда("cli")
    беззнак8 инд = 0
    пока (инд < 4)
        если (стадия[инд] != 0)
            стадия[инд] = 3
        конец
        инд = инд + 1
    конец
    машинная_команда("sei")
конец

// ---- MIDI ----
функция разобрать_байт(беззнак8 б)
    если (б >= 248)
        вернуть
    конец
    если (наложить_маску(б, 128) != 0)
        если (б < 240)
            команда = б
        иначе
            команда = 0
        конец
        принято = 0
        вернуть
    конец
    если (команда == 0)
        вернуть
    конец
    байты[принято] = б
    принято = принято + 1
    беззнак8 вид = наложить_маску(команда, 240)
    беззнак8 нужно = 2
    если (вид == 192 или вид == 208)
        нужно = 1
    конец
    если (принято < нужно)
        вернуть
    конец
    принято = 0
    если (вид == 144)
        если (байты[1] == 0)
            выключить_ноту(байты[0])
        иначе
            включить_ноту(байты[0], байты[1])
        конец
    конец
    если (вид == 128)
        выключить_ноту(байты[0])
    конец
    если (вид == 176 и байты[0] == 123)
        выключить_все_ноты()
    конец
конец

// ---- Ручки ----
функция прочитать_ручку(беззнак8 н)
    аппаратная_запись8(0x7C, 64 + н)                   // ADMUX: опора 5 В, канал н
    аппаратная_запись8(0x7A, 199)                      // ADCSRA: включить, начать, делитель 128
    пока (наложить_маску(аппаратное_чтение8(0x7A), 64) != 0)
        машинная_команда("nop")
    конец
    беззнак16 свежее = беззнак16(аппаратное_чтение8(0x78)) + сдвинуть_влево(беззнак16(аппаратное_чтение8(0x79)), 8)
    сглаженные[н] = сдвинуть_вправо(сглаженные[н] * 3 + свежее, 2)
    беззнак16 р = сглаженные[н]
    машинная_команда("cli")
    если (н == 0)
        форма = беззнак8(сдвинуть_вправо(р, 8))
    конец
    если (н == 1)
        шаг_атаки = сдвинуть_вправо(беззнак16(65535), сдвинуть_вправо(р * 11, 10))
    конец
    если (н == 2)
        шаг_затухания = сдвинуть_вправо(беззнак16(65535), сдвинуть_вправо(р * 10, 10) + 1)
    конец
    если (н == 3)
        беззнак32 к = 1 + сдвинуть_вправо(беззнак32(р) * беззнак32(р), 12)
        если (к > 255)
            яркость = 255
        иначе
            яркость = беззнак8(к)
        конец
    конец
    машинная_команда("sei")
конец

функция главная(): целое
    аппаратная_запись8(0x24, 2)                        // DDRB: D9 (PB1) — выход звука
    // Последовательный порт 31250 бод, 8N1, приём.
    аппаратная_запись8(0xC5, 0)                        // UBRR0H
    аппаратная_запись8(0xC4, 31)                       // UBRR0L: 16 МГц / (16 * 31250) - 1
    аппаратная_запись8(0xC2, 6)                        // UCSR0C: 8 бит
    аппаратная_запись8(0xC1, 16)                       // UCSR0B: приём включён
    // Таймер 1: быстрый ШИМ, 8 бит, вывод D9, около 62,5 кГц («несущая» звука).
    аппаратная_запись8(0x80, 129)                      // TCCR1A: COM1A1 | WGM10
    аппаратная_запись8(0x81, 9)                        // TCCR1B: WGM12 | без делителя
    аппаратная_запись8(0x89, 0)
    аппаратная_запись8(0x88, 128)                      // OCR1A
    // Таймер 2: прерывание 20000 раз в секунду (16 МГц / 8 / 100).
    аппаратная_запись8(0xB0, 2)                        // TCCR2A: режим CTC
    аппаратная_запись8(0xB1, 2)                        // TCCR2B: делитель 8
    аппаратная_запись8(0xB3, 99)                       // OCR2A
    аппаратная_запись8(0x70, 2)                        // TIMSK2: прерывание по совпадению A
    машинная_команда("sei")
    беззнак8 п = 0
    пока (п < 12)
        прочитать_ручку(наложить_маску(п, 3))
        п = п + 1
    конец
    // Проверка звука: при включении звучит короткая нота «ля».
    включить_ноту(69, 100)
    беззнак16 начало = время
    пока (время - начало < 1000)
        машинная_команда("nop")
    конец
    выключить_ноту(69)
    беззнак8 ручка = 0
    пока (да)
        пока (наложить_маску(аппаратное_чтение8(0xC0), 128) != 0)
            разобрать_байт(аппаратное_чтение8(0xC6))
        конец
        прочитать_ручку(ручка)
        ручка = наложить_маску(ручка + 1, 3)
    конец
    вернуть 0
конец
