// Таблицы на AVR: «неизменно» кладёт массив во флэш-память (оперативной у Nano всего 2 КБ),
// обычный глобальный массив живёт в оперативной памяти. Светодиод PB5 включится, если всё посчиталось верно.
неизменно беззнак8(4) флэш = массив(10, 20, 30, 40)
целое16(3) оперативная = массив(100, 200, 300)
целое16 счётчик = 7

функция главная(): целое
    аппаратная_запись8(0x24, 32)                       // DDRB: PB5 — выход
    оперативная[1] = оперативная[1] + счётчик
    беззнак8 индекс = 3
    беззнак8 сумма = флэш[2] + флэш[индекс]
    если (сумма == 70 и оперативная[1] == 207 и оперативная[2] == 300)
        аппаратная_запись8(0x25, 32)
    иначе
        аппаратная_запись8(0x25, 0)
    конец
    пока (да)
        машинная_команда("nop")
    конец
    вернуть 0
конец
