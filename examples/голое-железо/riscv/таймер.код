подключить голое_железо;
подключить плата_riscv_virt;

// Обработчик прерывания. Регистры сохраняет и возвращает стартовый код
// (запуск_riscv64.s), поэтому здесь обычная функция Сферы.
// Счётчик тиков лежит по фиксированному адресу в памяти.
функция sfera_trap()
    аппаратная_запись32(0x87F00000, аппаратное_чтение32(0x87F00000) + беззнак32(1));
    // следующее прерывание через 10000 тактов (1 мс)
    аппаратная_запись64(0x02004000, аппаратное_чтение64(0x0200BFF8) + беззнак64(10000));
конец

функция главная(): целое
    sfera_плата_старт();
    аппаратная_запись32(0x87F00000, беззнак32(0));
    аппаратная_запись64(0x02004000, аппаратное_чтение64(0x0200BFF8) + беззнак64(10000));
    целое пройдено = 0;
    пока (пройдено < 5)
        пока (целое(аппаратное_чтение32(0x87F00000)) <= пройдено)
            машинная_команда("wfi");
        конец
        пройдено = пройдено + 1;
        вывести("тик %пройдено%");
    конец
    вывести("таймер работает");
    вернуть 0;
конец
