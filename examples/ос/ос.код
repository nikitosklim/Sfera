// ос.код — мини-ОС на Сфере: экран с кириллицей, прерывания, таймер, клавиатура (латиница и ЙЦУКЕН) и командная строка.
// Всё, кроме входа в прерывание (запуск_ос.s) и растрового шрифта (шрифт_8х16.s), написано на Сфере.
подключить железо_х86;
подключить голое_железо;
подключить экран_х86;
подключить плата_х86_ос;
подключить память_х86;
подключить задачи_х86;
подключить диск_х86;
подключить пользователь_х86;

// Общая память (адреса внутри первых 4 МБ):
//   0x300000 тики таймера, 0x300008 позиция записи в очередь клавиш, 0x300100 очередь кодов клавиш (256 байт)
//   0x300600 строка ввода (байты UTF-8), 0x300800 её длина, 0x300808 раскладка (0 — латиница, 1 — русская),
//   0x300810 нажата ли клавиша Shift

// Прерывание таймера: считаем тики и отдаём процессор следующей задаче (см. задачи_х86).
функция sfera_irq_timer(целое кадр): целое
    аппаратная_запись32(0x300000, аппаратное_чтение32(0x300000) + беззнак32(1));
    порт_вывод8(0x20, беззнак8(0x20));
    вернуть задачи_переключить(кадр);
конец

функция sfera_irq_kbd()
    целое код = целое(порт_ввод8(0x60));
    целое голова = целое(аппаратное_чтение32(0x300008));
    аппаратная_запись8(0x300100 + голова, беззнак8(код));
    аппаратная_запись32(0x300008, беззнак32((голова + 1) % 256));
    порт_вывод8(0x20, беззнак8(0x20));
конец

функция настроить_контроллер()
    порт_вывод8(0x20, беззнак8(0x11));
    порт_вывод8(0xA0, беззнак8(0x11));
    порт_вывод8(0x21, беззнак8(0x20));
    порт_вывод8(0xA1, беззнак8(0x28));
    порт_вывод8(0x21, беззнак8(0x04));
    порт_вывод8(0xA1, беззнак8(0x02));
    порт_вывод8(0x21, беззнак8(0x01));
    порт_вывод8(0xA1, беззнак8(0x01));
    порт_вывод8(0x21, беззнак8(0xFC));
    порт_вывод8(0xA1, беззнак8(0xFF));
конец

функция настроить_таймер()
    порт_вывод8(0x43, беззнак8(0x36));
    порт_вывод8(0x40, беззнак8(0x9C));
    порт_вывод8(0x40, беззнак8(0x2E));
конец

// ---------- вывод ----------

// Выводит один символ Юникода (в UTF-8).
функция вывести_символ(целое код)
    если (код < 128)
        sfera_вывод_символа(целое32(код));
    иначе
        sfera_вывод_символа(целое32(включить_биты(192, сдвинуть_вправо(код, 6))));
        sfera_вывод_символа(целое32(включить_биты(128, наложить_маску(код, 63))));
    конец
конец

функция приглашение()
    если (читать64(0x300808) == 1)
        вывести_текст("[рус] сфера> ");
    иначе
        вывести_текст("[лат] сфера> ");
    конец
конец

// ---------- клавиатура ----------

// Двухбайтная буква из строки русских букв по номеру.
функция буква_из(текст ряд, целое номер): целое
    целое а = целое(байт_текста(ряд, номер * 2));
    целое б = целое(байт_текста(ряд, номер * 2 + 1));
    вернуть включить_биты(сдвинуть_влево(наложить_маску(а, 31), 6), наложить_маску(б, 63));
конец

функция латинская_буква(целое код, целое шифт): целое
    если (код >= 58)
        вернуть 0;
    конец
    целое с = целое(байт_текста("??1234567890-=??qwertyuiop[]??asdfghjkl;????zxcvbnm,./??? ", код));
    если (с == 63)
        вернуть 0;
    конец
    если (шифт == 1)
        если (с >= 97 и с <= 122)
            вернуть с - 32;
        конец
        если (код >= 2 и код <= 13)
            вернуть целое(байт_текста("!@#$%^&*()_+", код - 2));
        конец
    конец
    вернуть с;
конец

// Код клавиши → символ Юникода (0 — у клавиши нет символа).
функция символ_клавиши(целое код, целое рус, целое шифт): целое
    если (рус == 1)
        целое р = 0;
        если (код >= 16 и код <= 27)
            р = буква_из("йцукенгшщзхъ", код - 16);
        конец
        если (код >= 30 и код <= 40)
            р = буква_из("фывапролджэ", код - 30);
        конец
        если (код == 41)
            р = 1105;
        конец
        если (код >= 44 и код <= 53)
            р = буква_из("ячсмитьбю.", код - 44);
        конец
        если (р != 0)
            если (шифт == 1)
                если (р == 1105)
                    вернуть 1025;
                конец
                если (р >= 1072 и р <= 1103)
                    вернуть р - 32;
                конец
            конец
            вернуть р;
        конец
    конец
    вернуть латинская_буква(код, шифт);
конец

// ---------- командная строка ----------

функция команда_равна(целое длина_ввода, текст имя): целое
    если (длина_ввода != длина(имя))
        вернуть 0;
    конец
    целое номер = 0;
    пока (номер < длина_ввода)
        если (целое(аппаратное_чтение8(0x300600 + номер)) != целое(байт_текста(имя, номер)))
            вернуть 0;
        конец
        номер = номер + 1;
    конец
    вернуть 1;
конец

// Показывает подкачку по требованию: страницы области 0x40000000… создаются при первом обращении.
функция страницы_демонстрация()
    целое до = память_состояние(8);
    вывести("пишем число 42 по виртуальному адресу 0x40000000, страницы там пока нет");
    аппаратная_запись32(0x40000000, беззнак32(42));
    вывести("и 7 по адресу 0x40001000");
    аппаратная_запись32(0x40001000, беззнак32(7));
    вывести("читаем обратно:");
    вывести(целое(аппаратное_чтение32(0x40000000)));
    вывести(целое(аппаратное_чтение32(0x40001000)));
    целое ошибок = память_состояние(24);
    вывести("обработано ошибок страниц: %ошибок%");
    целое кадров = до - память_состояние(8);
    вывести("взято кадров (две страницы и таблицы): %кадров%");
    освободить_кадр(снять_отображение(0x40000000));
    освободить_кадр(снять_отображение(0x40001000));
    вывести("страницы возвращены");
конец

// Две задачи считают сами по себе, пока основная ждёт секунду: покажем, что процессор делится между ними.
функция задача_а()
    пока (читать64(0x300F10) == 0)
        писать64(0x300F00, читать64(0x300F00) + 1);
    конец
    задача_завершить();
конец

функция задача_б()
    пока (читать64(0x300F10) == 0)
        писать64(0x300F08, читать64(0x300F08) + 1);
    конец
    задача_завершить();
конец

функция задачи_демонстрация()
    писать64(0x300F00, 0);
    писать64(0x300F08, 0);
    писать64(0x300F10, 0);
    целое а = задача_создать(адрес_функции(задача_а));
    целое б = задача_создать(адрес_функции(задача_б));
    вывести("запущены задачи %а% и %б%, основная ждёт секунду");
    целое конец_ожидания = целое(аппаратное_чтение32(0x300000)) + 100;
    пока (целое(аппаратное_чтение32(0x300000)) < конец_ожидания)
        ждать_прерывание();
    конец
    писать64(0x300F10, 1);
    пока (задача_состояние(а) != 2 или задача_состояние(б) != 2)
        ждать_прерывание();
    конец
    если (читать64(0x300F00) > 0)
        вывести("задача %а% работала");
    иначе
        вывести("задача %а% не работала");
    конец
    если (читать64(0x300F08) > 0)
        вывести("задача %б% работала");
    иначе
        вывести("задача %б% не работала");
    конец
    задача_убрать(а);
    задача_убрать(б);
    вывести("задачи завершены, память возвращена");
конец

// Начинается ли строка ввода с этого слова и пробела (дальше — параметр команды).
функция команда_начинается(целое длина_ввода, текст слово): целое
    целое n = длина(слово);
    если (длина_ввода <= n + 1 или целое(аппаратное_чтение8(0x300600 + n)) != 32)
        вернуть 0;
    конец
    целое номер = 0;
    пока (номер < n)
        если (целое(аппаратное_чтение8(0x300600 + номер)) != целое(байт_текста(слово, номер)))
            вернуть 0;
        конец
        номер = номер + 1;
    конец
    вернуть 1;
конец

функция файлы_показать()
    целое число = фс_открыть();
    если (число < 0)
        вывести("диск с файлами не найден");
        вернуть;
    конец
    вывести("файлов на диске: %число%");
    целое n = 0;
    пока (n < число)
        целое имя = фс_имя(n);
        целое i = 0;
        пока (аппаратное_чтение8(имя + i) != беззнак8(0))
            sfera_вывод_символа(целое32(аппаратное_чтение8(имя + i)));
            i = i + 1;
        конец
        целое размер = фс_размер(n);
        вывести(" — %размер% байт");
        n = n + 1;
    конец
конец

функция программа_с_диска(целое длина_ввода)
    целое начало = 19;   // «запустить » — девять русских букв и пробел
    целое n = фс_найти(0x300600 + начало, длина_ввода - начало);
    если (n < 0)
        вывести("такого файла нет (команда «файлы» покажет список)");
        вернуть;
    конец
    вывести("запускаем файл с диска в пользовательском режиме");
    целое код = пользователь_запустить_с_диска(фс_сектор(n), фс_размер(n), 0);
    вывести("программа завершилась с кодом %код%");
конец

// Выполняет введённую команду. Возвращает 1, если нужно выключиться.
функция выполнить(целое длина_ввода): целое
    если (длина_ввода == 0)
        вернуть 0;
    конец
    если (команда_равна(длина_ввода, "помощь") == 1)
        вывести("команды: помощь, время, память, страницы, задачи, программа, нарушение, файлы, запустить, сбой, очистить, стоп");
        вывести("F1 — переключить раскладку, Shift — заглавные");
        вернуть 0;
    конец
    если (команда_равна(длина_ввода, "время") == 1)
        целое секунд = целое(аппаратное_чтение32(0x300000)) / 100;
        вывести("работаем секунд: %секунд%");
        вернуть 0;
    конец
    если (команда_равна(длина_ввода, "память") == 1)
        целое мб = память_состояние(32) / 1048576;
        целое всего = память_состояние(0);
        целое свободно = память_состояние(8);
        целое объём = куча_размер();
        вывести("физическая память: %мб% МБ, кадров %всего%, свободно %свободно%");
        вывести("куча ядра: %объём% байт");
        вернуть 0;
    конец
    если (команда_равна(длина_ввода, "программа") == 1 или команда_равна(длина_ввода, "нарушение") == 1)
        целое режим = 0;
        если (команда_равна(длина_ввода, "нарушение") == 1)
            режим = 1;
        конец
        вывести("запускаем программу в пользовательском режиме (кольцо 3)");
        целое код = пользователь_запустить(режим);
        вывести("программа завершилась с кодом %код%");
        вернуть 0;
    конец
    если (команда_равна(длина_ввода, "файлы") == 1)
        файлы_показать();
        вернуть 0;
    конец
    если (команда_начинается(длина_ввода, "запустить") == 1)
        программа_с_диска(длина_ввода);
        вернуть 0;
    конец
    если (команда_равна(длина_ввода, "задачи") == 1)
        задачи_демонстрация();
        вернуть 0;
    конец
    если (команда_равна(длина_ввода, "страницы") == 1)
        страницы_демонстрация();
        вернуть 0;
    конец
    если (команда_равна(длина_ввода, "сбой") == 1)
        вывести("читаем память по адресу, которого нет в таблицах...");
        целое пропасть = целое(аппаратное_чтение32(0x80000000));
        вернуть 0;
    конец
    если (команда_равна(длина_ввода, "очистить") == 1)
        экран_очистить(0x101820);
        экран_задать(8, 0);
        экран_задать(16, 0);
        вернуть 0;
    конец
    если (команда_равна(длина_ввода, "стоп") == 1)
        вывести("выключаемся");
        вернуть 1;
    конец
    вывести("неизвестная команда, введите «помощь»");
    вернуть 0;
конец

// Обрабатывает один код клавиши. Возвращает 1, если нужно выключиться.
функция обработать_клавишу(целое код): целое
    если (код == 42 или код == 54)
        писать64(0x300810, 1);
        вернуть 0;
    конец
    если (код == 170 или код == 182)
        писать64(0x300810, 0);
        вернуть 0;
    конец
    если (код >= 128 или код == 224)
        вернуть 0;
    конец
    если (код == 59)
        писать64(0x300808, 1 - читать64(0x300808));
        вывести_текст("[раскладка]");
        вернуть 0;
    конец
    целое длина_ввода = читать64(0x300800);
    если (код == 28)
        sfera_вывод_символа(целое32(10));
        писать64(0x300800, 0);
        целое выход = выполнить(длина_ввода);
        если (выход == 1)
            вернуть 1;
        конец
        приглашение();
        вернуть 0;
    конец
    если (код == 14)
        если (длина_ввода > 0)
            // убираем последний символ целиком (у русской буквы два байта)
            длина_ввода = длина_ввода - 1;
            пока (длина_ввода > 0 и наложить_маску(целое(аппаратное_чтение8(0x300600 + длина_ввода)), 192) == 128)
                длина_ввода = длина_ввода - 1;
            конец
            писать64(0x300800, длина_ввода);
            sfera_вывод_символа(целое32(8));
        конец
        вернуть 0;
    конец
    целое символ = символ_клавиши(код, читать64(0x300808), читать64(0x300810));
    если (символ != 0 и длина_ввода < 60)
        если (символ < 128)
            аппаратная_запись8(0x300600 + длина_ввода, беззнак8(символ));
            длина_ввода = длина_ввода + 1;
        иначе
            аппаратная_запись8(0x300600 + длина_ввода, беззнак8(включить_биты(192, сдвинуть_вправо(символ, 6))));
            аппаратная_запись8(0x300600 + длина_ввода + 1, беззнак8(включить_биты(128, наложить_маску(символ, 63))));
            длина_ввода = длина_ввода + 2;
        конец
        писать64(0x300800, длина_ввода);
        вывести_символ(символ);
    конец
    вернуть 0;
конец

функция главная(): целое
    sfera_плата_старт();
    вывести("Сфера ОС 0.2");
    вывести("Это ядро написано на языке Сфера. Введите «помощь».");
    писать64(0x300800, 0);
    писать64(0x300808, 0);
    писать64(0x300810, 0);
    память_подготовить();
    настроить_контроллер();
    настроить_таймер();
    задачи_подготовить();
    разрешить_прерывания();
    приглашение();
    целое прочитано = 0;
    целое выключить = 0;
    пока (выключить == 0)
        пока (выключить == 0 и прочитано != целое(аппаратное_чтение32(0x300008)))
            целое код = целое(аппаратное_чтение8(0x300100 + прочитано));
            прочитано = (прочитано + 1) % 256;
            выключить = обработать_клавишу(код);
        конец
        если (выключить == 0)
            ждать_прерывание();
        конец
    конец
    порт_вывод8(0xF4, беззнак8(0));
    вернуть 0;
конец
