// считалка.код — вторая программа пользователя: печатает квадраты чисел от 1 до 5. Лежит на диске, а не в ядре.
подключить сис_пользователя;

функция главная(): целое
    писать_текст("квадраты чисел:\n");
    целое i = 1;
    пока (i <= 5)
        писать_число(i);
        писать_текст(" в квадрате ");
        писать_число(i * i);
        писать_символ(10);
        i = i + 1;
    конец
    вернуть 0;
конец
