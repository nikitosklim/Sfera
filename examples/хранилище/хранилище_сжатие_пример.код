// Пример компактификации хранилища — append-only лог со временем растёт
// даже для небольшого числа ключей (каждое сохранить()/обновление
// добавляет новую запись, не заменяет старую на месте). сжать_хранилище
// периодически возвращает файл к минимальному, актуальному размеру.

подключить хранилище;

функция главная() -> целое {
    результат<Хранилище> хр_результат = открыть_хранилище("пример_сжатия.db");
    если (!хр_результат.успешно) {
        вывести("не удалось открыть хранилище");
        вернуть 1;
    }
    Хранилище хр = хр_результат.значение;

    // Несколько обновлений одного и того же ключа плюс удаление — файл
    // растёт с каждой операцией, даже когда актуальных ключей всего два.
    хр.сохранить("имя", "Никита");
    хр.сохранить("город", "Москва");
    хр.сохранить("имя", "Пётр");
    хр.сохранить("имя", "Иван");
    хр.сохранить("возраст", "30");
    хр.удалить("город");
    хр.сохранить("имя", "Сергей");

    результат<целое> размер_до = размер_файла("пример_сжатия.db");
    если (размер_до.успешно) {
        текст строка1 = "размер до сжатия: " + целое_в_текст(размер_до.значение);
        вывести(строка1);
    }

    результат<Хранилище> хр_сжатое = сжать_хранилище(хр);
    если (!хр_сжатое.успешно) {
        текст строка_ошибки = "ошибка сжатия: " + хр_сжатое.сообщение;
        вывести(строка_ошибки);
        вернуть 1;
    }
    Хранилище хр2 = хр_сжатое.значение;

    результат<целое> размер_после = размер_файла("пример_сжатия.db");
    если (размер_после.успешно) {
        текст строка2 = "размер после сжатия: " + целое_в_текст(размер_после.значение);
        вывести(строка2);
    }

    // Данные остались корректными — сжатие сохранило только самые
    // свежие значения, выбросив устаревшие записи и tombstone.
    результат<текст> имя = хр2.получить("имя");
    если (имя.успешно) {
        вывести(имя.значение);
        освободить_память(имя.значение);
    }
    результат<текст> город = хр2.получить("город");
    если (!город.успешно) {
        вывести(город.сообщение);
    }
    результат<текст> возраст = хр2.получить("возраст");
    если (возраст.успешно) {
        вывести(возраст.значение);
        освободить_память(возраст.значение);
    }

    закрыть_хранилище(хр2);
    вернуть 0;
}
