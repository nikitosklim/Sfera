// Пример работы со структурой "Хранилище" — той же моделью данных, что и
// свободные функции сохранить/получить/удалить (хранилище_пример.код),
// но с индексом "ключ → позиция в файле", который живёт в памяти, пока
// хранилище открыто. Вместо сканирования всего файла при каждом запросе
// (как делают свободные функции), поиск становится мгновенным.

подключить хранилище;

функция главная(): целое
    результат из Хранилище хр_результат = открыть_хранилище("пример_с_индексом.db");
    если ( не хр_результат.успешно)
        вывести("не удалось открыть хранилище");
        вернуть 1;
    конец
    Хранилище хр = хр_результат.значение;

    хр.сохранить("имя", "Никита");
    хр.сохранить("город", "Москва");

    результат из текста имя = хр.получить("имя");
    если (имя.успешно)
        текст строка1 = "имя: " + имя.значение;
        вывести(строка1);
        освободить_память(имя.значение);
    конец

    результат из текста город = хр.получить("город");
    если (город.успешно)
        текст строка2 = "город: " + город.значение;
        вывести(строка2);
        освободить_память(город.значение);
    конец

    // Обновление — та же логика, что и у свободной функции: более
    // поздняя запись перекрывает более раннюю, а индекс в памяти сразу
    // обновляется, без повторного сканирования файла.
    хр.сохранить("имя", "Пётр");
    результат из текста имя_после = хр.получить("имя");
    если (имя_после.успешно)
        текст строка3 = "имя после обновления: " + имя_после.значение;
        вывести(строка3);
        освободить_память(имя_после.значение);
    конец

    хр.удалить("город");
    результат из текста город_после = хр.получить("город");
    если ( не город_после.успешно)
        текст строка4 = "город после удаления: " + город_после.сообщение;
        вывести(строка4);
    конец

    // Освобождает индексы в памяти — не обязательно перед завершением
    // самой программы (ОС и так заберёт всю память процесса), но нужно,
    // если хранилище закрывается, а программа продолжает работать дальше.
    закрыть_хранилище(хр);
    вернуть 0;
конец
