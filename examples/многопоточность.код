// Пример: запуск фонового потока (параллельно) и безопасная передача
// результата обратно через канал.
функция главная() -> целое {
    канал<целое> канал_результата = создать_канал();

    параллельно {
        целое вычислено = 2 + 2;
        канал_результата.отправить(вычислено);
    }

    // Ждёт, пока фоновый поток не отправит значение.
    целое значение = канал_результата.получить();
    вывести(целое_в_текст(значение));

    вернуть 0;
}
